+/// Ein's patch (F11): recovery is bounded by a count of search steps over the whole parse, not by
+/// the wall clock, so the same input reports the same errors on every machine and under any load.
+/// A step is one check of the budget, at each node the search expands and each node the repair
+/// collection and ranking visit, which are the places the clock was read.
+pub const RECOVERY_STEP_BUDGET: u64 = 30_000;
+
+/// The steps recovery may still take in this parse (Ein's patch, F11).
+pub(super) struct Budget {
+    left: std::cell::Cell<u64>,
+    /// Set once a step was asked for and none was left.
+    denied: std::cell::Cell<bool>,
+}
+
+impl Budget {
+    fn new() -> Self {
+        Budget {
+            left: std::cell::Cell::new(RECOVERY_STEP_BUDGET),
+            denied: std::cell::Cell::new(false),
+        }
+    }
+
+    /// Takes one step; true once none is left.
+    pub(super) fn spent(&self) -> bool {
+        let l = self.left.get();
+        if l == 0 {
+            self.denied.set(true);
+            return true;
+        }
+        self.left.set(l - 1);
+        false
+    }
+
+    /// The steps taken so far in this parse.
+    fn taken(&self) -> u64 {
+        RECOVERY_STEP_BUDGET - self.left.get()
+    }
+}
 
