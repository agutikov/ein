(config
  :enable-pre-branch-lookahead true
  :enable-lookahead-kill-cache true
  :enable-forced-positive true
  :enable-path-nogoods true
  :lattice-order lex
  :record-alternative-justifications false)

(import std.algebra :symbols (symmetric symmetric-negative-setup includes))

(import std.slots :symbols (slot-partition-setup slot-spatial-setup))

(hrule
  guess
  (?R ?T1 ?T2)
  :match (and (instance ?a ?T1) (instance ?b ?T2))
  :assert (?R ?a ?b)
  :why "guess: ({?R} {?a} {?b})?")

(relation type T T :why "{?1} is a subtype of {?2}")

(relation instance T T :why "{?1} is an instance of {?2}")

(relation
  co-located
  Attribute
  Attribute
  :why "{?1} and {?2} are in the same house")

(relation
  right-of
  Attribute
  Attribute
  :why "{?1}'s house is immediately right of {?2}'s")

(relation next-to Attribute Attribute :why "{?1}'s house is next to {?2}'s")

(symmetric co-located)

(symmetric next-to)

(includes right-of next-to)

(slot-partition co-located instance type Attribute House)

(slot-spatial co-located right-of instance House)

(slot-spatial co-located next-to instance House)

(type Attribute T)

(type House Attribute)

(type Color Attribute)

(type Nationality Attribute)

(type Pet Attribute)

(type Cigarette Attribute)

(type Drink Attribute)

(instance House-1 House)

(instance House-2 House)

(instance House-3 House)

(instance House-4 House)

(instance House-5 House)

(instance Red Color)

(instance Green Color)

(instance Ivory Color)

(instance Yellow Color)

(instance Blue Color)

(instance Englishman Nationality)

(instance Spaniard Nationality)

(instance Ukrainian Nationality)

(instance Norwegian Nationality)

(instance Japanese Nationality)

(instance Dog Pet)

(instance Snail Pet)

(instance Fox Pet)

(instance Horse Pet)

(instance Zebra Pet)

(instance Old_Gold Cigarette)

(instance Kools Cigarette)

(instance Chesterfields Cigarette)

(instance Lucky_Strike Cigarette)

(instance Parliament Cigarette)

(instance Coffee Drink)

(instance Tea Drink)

(instance Milk Drink)

(instance Juice Drink)

(instance Water Drink)

(right-of House-2 House-1 :source "condition (1)")

(right-of House-3 House-2 :source "condition (1)")

(right-of House-4 House-3 :source "condition (1)")

(right-of House-5 House-4 :source "condition (1)")

(co-located Englishman Red :source "condition (2)")

(co-located Spaniard Dog :source "condition (3)")

(co-located Coffee Green :source "condition (4)")

(co-located Ukrainian Tea :source "condition (5)")

(right-of Green Ivory :source "condition (6)")

(co-located Old_Gold Snail :source "condition (7)")

(co-located Kools Yellow :source "condition (8)")

(co-located Milk House-3 :source "condition (9)")

(co-located Norwegian House-1 :source "condition (10)")

(next-to Chesterfields Fox :source "condition (11)")

(next-to Kools Horse :source "condition (12)")

(co-located Lucky_Strike Juice :source "condition (13)")

(co-located Japanese Parliament :source "condition (14)")

(next-to Norwegian Blue :source "condition (15)")

(query
  :goal (and (co-located Water ?h_water) (instance ?h_water House) (co-located ?who_water ?h_water) (instance ?who_water Nationality) (co-located Zebra ?h_zebra) (instance ?h_zebra House) (co-located ?who_zebra ?h_zebra) (instance ?who_zebra Nationality))
  :goal-text "The {?who_water} drinks water in {?h_water}; the {?who_zebra} owns zebra in {?h_zebra}"
  :hrules (guess (co-located Color House) (co-located Nationality House) (co-located Drink House) (co-located Cigarette House) (co-located Pet House)))
