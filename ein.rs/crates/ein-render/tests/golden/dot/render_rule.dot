digraph rule_t_lhs_rhs {
  rankdir=TB;
  label="t"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "r_L" [label="r", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_r_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "h1_r_L" -> "r_L" [xlabel="1", color="#ff7f0e"];
    "h1_r_L" -> "?a_L" [xlabel="2", color="#ff7f0e"];
    "h1_r_L" -> "?b_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "r_R" [label="r", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "h2_r_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "h2_r_R" -> "r_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "h2_r_R" -> "?b_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "h2_r_R" -> "?a_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}