;;; A flagged program whose one minimal hole dies on a link several rules
;;; derive, every derivation recorded: `dead_link.ein`'s line of thirty towns,
;;; its two ends apart only where gate a is open and gate b is not. Three
;;; candidates, the cube within the limit: gate c pays what root owes, so R is
;;; {c}, {b, c} and {a, b, c}, and {a, c} is a hole, dead between two of its
;;; members. Root's saturation is the links'; each node adds a gate or two,
;;; and the hole's core search folds the link's environments over its rounds,
;;; far past what the cube's eight saturations cost. A description prints that
;;; core, and `--count`'s summary writes it; a line mode prints no hole. With
;;; (config :record-alternative-justifications false) the search is offered
;;; one derivation a fact, and every question answers at once.
(relation link T T :why "{?3} is linked to {?4}")
(relation road1 T T :why "road 1 joins {?3} to {?4}")
(relation road2 T T :why "road 2 joins {?3} to {?4}")
(relation apart T T :why "{?3} and {?4} are apart")
(relation gate G :why "gate {?3} is open")
(relation needs G :why "gate {?3} must be opened")
(relation opened G H :why "gate {?3} is opened by {?4}")
(rule road1-links ()
  :match (road1 ?a ?b)
  :assert (link ?a ?b)
  :why "road 1 joins {?a} to {?b}, so they are linked")
(rule road2-links ()
  :match (road2 ?a ?b)
  :assert (link ?a ?b)
  :why "road 2 joins {?a} to {?b}, so they are linked")
(rule mirror ()
  :match (link ?a ?b)
  :assert (link ?b ?a)
  :why "{?a} is linked to {?b}, so {?b} is linked to {?a}")
(rule chain ()
  :match (and (link ?a ?b) (link ?b ?c) (neq ?a ?c))
  :assert (link ?a ?c)
  :why "{?a} is linked to {?b} and {?b} to {?c}, so {?a} is linked to {?c}")
(rule clash ()
  :match (and (link ?a ?b) (apart ?a ?b))
  :assert (false)
  :why "{?a} and {?b} are linked and apart, which cannot be")
(rule ungated ()
  :match (and (gate a) (absent (gate b)))
  :assert (apart t1 t30)
  :why "gate a is open and gate b is not, so t1 and t30 are apart")
(rule owe ()
  :match (and (needs ?g) (absent (opened ?g ?h)))
  :assert (open opened)
  :why "gate {?g} is still shut")
(needs c)
(open (gate a))
(open (gate b))
(open (opened c hand))
(road1 t1 t2) (road2 t1 t2)
(road1 t2 t3) (road2 t2 t3)
(road1 t3 t4) (road2 t3 t4)
(road1 t4 t5) (road2 t4 t5)
(road1 t5 t6) (road2 t5 t6)
(road1 t6 t7) (road2 t6 t7)
(road1 t7 t8) (road2 t7 t8)
(road1 t8 t9) (road2 t8 t9)
(road1 t9 t10) (road2 t9 t10)
(road1 t10 t11) (road2 t10 t11)
(road1 t11 t12) (road2 t11 t12)
(road1 t12 t13) (road2 t12 t13)
(road1 t13 t14) (road2 t13 t14)
(road1 t14 t15) (road2 t14 t15)
(road1 t15 t16) (road2 t15 t16)
(road1 t16 t17) (road2 t16 t17)
(road1 t17 t18) (road2 t17 t18)
(road1 t18 t19) (road2 t18 t19)
(road1 t19 t20) (road2 t19 t20)
(road1 t20 t21) (road2 t20 t21)
(road1 t21 t22) (road2 t21 t22)
(road1 t22 t23) (road2 t22 t23)
