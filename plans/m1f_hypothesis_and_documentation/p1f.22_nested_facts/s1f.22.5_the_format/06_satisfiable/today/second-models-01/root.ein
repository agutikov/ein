  :why "(top {?R} {?isa} {?Dom} {?Ran}): {?a}∈{?Dom},{?b}∈{?Ran} → {?R}({?a},{?b}).")

(rule
  std.algebra.complement
  (?R1 ?R2 ?isa ?Dom ?Ran)
  :match (and (?isa ?a ?Dom) (?isa ?b ?Ran) (absent (?R1 ?a ?b)))
  :assert (?R2 ?a ?b)
  :why "(complement {?R1} {?R2}): {?a}∈{?Dom},{?b}∈{?Ran},¬{?R1}({?a},{?b}) → {?R2}({?a},{?b}).")

(rule
  std.algebra.functional
  (?R)
  :match (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why "{?R} not functional: {?a} has both {?b} and {?c}.")

(rule
  std.algebra.injective
  (?R)
  :match (and (?R ?a ?c) (?R ?b ?c) (neq ?a ?b))
  :assert (false)
  :why "{?R} not injective: {?c} reached from both {?a} and {?b}.")

(rule
  std.algebra.bijective-properties
  ()
  :match (bijective ?R)
  :assert (and (std.algebra.functional ?R) (std.algebra.injective ?R) (std.algebra.total ?R) (std.algebra.surjective ?R))
  :why "{?R} is bijective ⟹ functional ∧ injective ∧ total ∧ surjective.")

(rule
  std.algebra.total
  (?R ?isa)
  :match (and (relation ?R ?A ?B) (?isa ?a ?A) (std.macro.forall ?b (?isa ?b ?B) (not (?R ?a ?b))))
  :assert (false)
  :why "{?R} not total at {?a}: every {?B} is excluded.")

(rule
  std.algebra.surjective
  (?R ?isa)
  :match (and (relation ?R ?A ?B) (?isa ?b ?B) (std.macro.forall ?a (?isa ?a ?A) (not (?R ?a ?b))))
  :assert (false)
  :why "{?R} not surjective at {?b}: every {?A} is excluded.")

(rule
  std.algebra.total-owed
  (?R ?isa)
  :match (and (relation ?R ?A ?B) (?isa ?a ?A) (absent (and (?isa ?b ?B) (?R ?a ?b))))
  :assert (open ?R)
  :why "{?R} owes {?a} a {?B}.")

(rule
  std.algebra.surjective-owed
  (?R ?isa)
  :match (and (relation ?R ?A ?B) (?isa ?b ?B) (absent (and (?isa ?a ?A) (?R ?a ?b))))
  :assert (open ?R)
  :why "{?R} owes {?b} a preimage in {?A}.")

(rule
  std.algebra.irreflexive
  (?R)
  :match (?R ?a ?a)
  :assert (false)
  :why "(irreflexive {?R}) violated: self-loop {?R}({?a},{?a}).")

(rule
  std.algebra.antisymmetric
  (?R)
  :match (and (?R ?a ?b) (?R ?b ?a) (neq ?a ?b))
  :assert (false)
  :why "(antisymmetric {?R}) violated: {?R}({?a},{?b})∧{?R}({?b},{?a}), {?a}≠{?b}.")

(rule
  std.algebra.asymmetric
  (?R)
  :match (and (?R ?a ?b) (?R ?b ?a))
  :assert (false)
  :why "(asymmetric {?R}) violated: both {?R}({?a},{?b}) and {?R}({?b},{?a}).")

(rule
  std.algebra.connex
  (?R ?isa ?Dom)
  :match (and (?isa ?a ?Dom) (?isa ?b ?Dom) (neq ?a ?b) (absent (?R ?a ?b)) (absent (?R ?b ?a)))
  :assert (false)
  :why "(connex {?R}) violated: {?a},{?b}∈{?Dom} incomparable (neither {?R}({?a},{?b}) nor {?R}({?b},{?a})).")

(rule
  std.algebra.difunctional
  (?R)
  :match (and (?R ?a ?b) (?R ?c ?b) (?R ?c ?d))
  :assert (?R ?a ?d)
  :why "(difunctional {?R}): {?R}({?a},{?b})∧{?R}({?c},{?b})∧{?R}({?c},{?d}) → {?R}({?a},{?d}).")

(rule
  std.algebra.symmetric
  (?rel)
  :match (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why "{?rel} is symmetric: {?a} ↔ {?b}.")

(rule
  std.algebra.symmetric-negative-setup
  ()
  :match (std.algebra.symmetric ?rel)
  :assert (std.algebra.symmetric-negative ?rel)
  :why "{?rel} symmetric ⟹ activate its negative mirror.")

(rule
  std.algebra.symmetric-negative
  (?rel)
  :match (not (?rel ?a ?b))
  :assert (not (?rel ?b ?a))
  :why "{?rel} symmetric: ¬{?rel}({?a},{?b}) ⟹ ¬{?rel}({?b},{?a}).")

(rule
  std.algebra.transitive
  (?rel)
  :match (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why "{?rel} is transitive.")

(rule
  std.algebra.includes
  (?p ?q)
  :match (?p ?a ?b)
  :assert (?q ?a ?b)
  :why "{?q} includes {?p}: from {?a} →{?p}→ {?b}, derive {?a} →{?q}→ {?b}.")

(rule
  std.algebra.compose-negative-s
  (?R ?S ?T)
  :match (and (?R ?a ?b) (not (?T ?a ?c)))
  :assert (not (?S ?b ?c))
  :why "Schröder ({?R};{?S}={?T} closed): {?R}({?a},{?b})∧¬{?T}({?a},{?c}) → ¬{?S}({?b},{?c}).")

(rule
  std.algebra.compose-negative-r
  (?R ?S ?T)
  :match (and (?S ?b ?c) (not (?T ?a ?c)))
  :assert (not (?R ?a ?b))
  :why "Schröder ({?R};{?S}={?T} closed): {?S}({?b},{?c})∧¬{?T}({?a},{?c}) → ¬{?R}({?a},{?b}).")

(rule
  std.algebra.compose-contravariant
  ()
  :match (and (std.algebra.compose ?R ?S ?T) (std.algebra.converse ?R ?Rc) (std.algebra.converse ?S ?Sc) (std.algebra.converse ?T ?Tc))
  :assert (std.algebra.compose ?Sc ?Rc ?Tc)
  :why "B7 contravariance: ({?R};{?S}={?T}) ⟹ ({?Sc};{?Rc}={?Tc}) (converses).")

(rule
  std.algebra.join-converse
  ()
  :match (and (join ?R ?S ?U) (std.algebra.converse ?R ?Rc) (std.algebra.converse ?S ?Sc) (std.algebra.converse ?U ?Uc))
  :assert (join ?Rc ?Sc ?Uc)
  :why "B8: ({?R}∪{?S}={?U}) ⟹ ({?Rc}∪{?Sc}={?Uc}) (converses).")

