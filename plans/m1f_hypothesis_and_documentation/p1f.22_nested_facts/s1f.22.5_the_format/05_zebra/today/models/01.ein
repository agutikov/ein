(rule
  std.slots.slot-adjacent-bwd-neg
  (?R ?S ?isa ?PT)
  :match (and (?S ?a ?b) (not (?R ?b ?p1)) (?isa ?p1 ?PT) (?S ?p2 ?p1) (?isa ?p2 ?PT) (absent (and (?S ?p2 ?p_o) (?isa ?p_o ?PT) (neq ?p_o ?p1))))
  :assert (not (?R ?a ?p2))
  :why "{?b} cannot be at {?p1}, the only {?S}-target of {?p2} ⟹ {?a} cannot be at {?p2}.")

(rule
  std.slots.slot-prune-fwd
  (?R ?S ?isa ?PT)
  :match (and (?S ?a ?b) (?R ?b ?p1) (?isa ?p1 ?PT) (?isa ?p_o ?PT) (neq ?p_o ?p1) (absent (?S ?p_o ?p1)))
  :assert (not (?R ?a ?p_o))
  :why "{?b} is at {?p1}, so {?a} is at an {?S}-source of {?p1}; {?p_o} is not one.")

(rule
  std.slots.slot-prune-bwd
  (?R ?S ?isa ?PT)
  :match (and (?S ?a ?b) (?R ?a ?p2) (?isa ?p2 ?PT) (?isa ?p_o ?PT) (neq ?p_o ?p2) (absent (?S ?p2 ?p_o)))
  :assert (not (?R ?b ?p_o))
  :why "{?a} is at {?p2}, so {?b} is at an {?S}-target of {?p2}; {?p_o} is not one.")

(rule
  std.slots.slot-endpoint-fwd
  (?R ?S ?isa ?PT)
  :match (and (?S ?a ?b) (?isa ?p1 ?PT) (absent (and (?isa ?p2 ?PT) (?S ?p2 ?p1))))
  :assert (not (?R ?b ?p1))
  :why "{?p1} has no {?S}-source, and {?b} needs one ({?S}({?a},{?b})) ⟹ {?b} is not at {?p1}.")

(rule
  std.slots.slot-endpoint-bwd
  (?R ?S ?isa ?PT)
  :match (and (?S ?a ?b) (?isa ?p2 ?PT) (absent (and (?isa ?p1 ?PT) (?S ?p2 ?p1))))
  :assert (not (?R ?a ?p2))
  :why "{?p2} has no {?S}-target, and {?a} needs one ({?S}({?a},{?b})) ⟹ {?a} is not at {?p2}.")

(hrule
  guess
  (?R ?T1 ?T2)
  :match (and (instance ?a ?T1) (instance ?b ?T2))
  :assert (?R ?a ?b)
  :why "guess: ({?R} {?a} {?b})?")

(relation type T T :why "{?1} is a subtype of {?2}")

(relation instance T T :why "{?1} is an instance of {?2}")

(relation
  co-located
  Attribute
  Attribute
  :why "{?1} and {?2} are in the same house")

(relation
  right-of
  Attribute
  Attribute
  :why "{?1}'s house is immediately right of {?2}'s")

(relation next-to Attribute Attribute :why "{?1}'s house is next to {?2}'s")

(symmetric co-located)

(symmetric next-to)

(includes right-of next-to)

(slot-partition co-located instance type Attribute House)

(slot-spatial co-located right-of instance House)

(slot-spatial co-located next-to instance House)

