(__closed__ n) ; rule decimal: a numeral is written, and never guessed: every relation of the module is closed
(__closed__ std.math.arith.arith-module-rule) ; rule std.math.arith.arith: arithmetic is computed and never guessed: its flag is closed
(__closed__ std.math.arith.division-by-zero) ; rule std.math.arith.arith: arithmetic is computed and never guessed: its flag is closed
(__closed__ std.math.decimal.decimal-rule) ; rule decimal: a numeral is written, and never guessed: every relation of the module is closed
(__closed__ std.math.decimal.named) ; rule decimal: a numeral is written, and never guessed: every relation of the module is closed
(__closed__ std.math.decimal.not-decimal) ; rule decimal: a numeral is written, and never guessed: every relation of the module is closed
(__closed__ std.math.digits.adj)
