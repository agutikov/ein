(relation n Number Digit :why "the number written {?1}, then the digit {?2}")

(relation std.math.decimal.named Name :why "{?1} is a named constant")

(relation
  std.math.decimal.not-decimal
  Number
  Thing
  :why "{?1} is not a decimal number: {?2} stands where a digit or a number goes")

(rule
  std.math.decimal.numeral-digit
  ()
  :match (and (written (n ?p ?a)) (neq ?a 0) (neq ?a 1) (neq ?a 2) (neq ?a 3) (neq ?a 4) (neq ?a 5) (neq ?a 6) (neq ?a 7) (neq ?a 8) (neq ?a 9))
  :assert (std.math.decimal.not-decimal (n ?p ?a) ?a)
  :why "{?a} stands where a digit goes and is none of the ten")

(rule
  std.math.decimal.numeral-prefix-digit
  ()
  :match (and (written (n ?m ?a)) (std.math.digits.nz ?m))
  :assert (std.math.decimal.not-decimal (n ?m ?a) ?m)
  :why "the digit {?m} stands where a number goes: a number ends in z")

(rule
  std.math.decimal.numeral-prefix-zero
  ()
  :match (written (n 0 ?a))
  :assert (std.math.decimal.not-decimal (n 0 ?a) 0)
  :why "the digit 0 stands where a number goes: a number ends in z")

(rule
  std.math.decimal.numeral-prefix-named
  ()
  :match (and (written (n ?m ?a)) (neq ?m z) (std.math.decimal.named ?m))
  :assert (std.math.decimal.not-decimal (n ?m ?a) ?m)
  :why "the name {?m} stands where a number goes: a name stands for a number as an operand, not inside one")

(rule
  std.math.decimal.not-decimal-is-false
  ()
  :match (std.math.decimal.not-decimal ?x ?thing)
  :assert (false)
  :why "{?x} is not a decimal number: the program cannot hold it")

(relation
  std.math.decimal.decimal-rule
  Rule
  :why "{?1} is a rule of std.math.decimal")

(rule
  decimal
  ()
  :match ()
  :assert (and (__closed__ std.math.digits.nz) (__closed__ n) (__closed__ std.math.decimal.named) (__closed__ std.math.decimal.not-decimal) (__closed__ std.math.decimal.decimal-rule) (std.math.decimal.decimal-rule std.math.arith.arith) (std.math.decimal.decimal-rule std.math.decimal.numeral-digit) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-digit) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-zero) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-named) (std.math.decimal.decimal-rule std.math.decimal.not-decimal-is-false))
  :why "a numeral is written, and never guessed: every relation of the module is closed")

(digit-read x)

(rule
  assemble
  ()
  :match (digit-read ?d)
  :assert (reading (n z ?d))
  :why "the reading is the numeral of {?d}")

(query :goal (reading ?r))
