;;; A saved state of ein (ein-saved/1): the program as written, every module it
;;; imports as written, and the choices made. It reads no other file.
(program
;; Q-M1f.392's demo with the standard library's check (analysis.md's h2.ein):
;; a rule assembles a numeral from a letter, which std.math.decimal flags
;; only where a file writes it. The run has one state; today's saved file
;; writes the assembled numeral as typed text, so its reload is flagged and
;; dead.

(import std.math.decimal :symbols (decimal n))
(import std.math.arith :symbols (z))

(digit-read x)

(rule assemble ()
  :match  (digit-read ?d)
  :assert (reading (n z ?d))
  :why    "the reading is the numeral of {?d}")

(query :goal (reading ?r))

)
(module std.math.arith
;;; Ein stdlib — `std.math.arith`: arithmetic itself, what every base shares
;;; (Q-M1f.322, Q-M1f.269).
;;;
;;; Two things are true of a number in any base, and so are no base's own:
;;;
;;;   - **`z`, zero, the number with no digit.** Every numeral ends in it:
;;;     `(n (n z 4) 2)` is 42 in `std.math.decimal`, and a binary numeral ends
;;;     in the same `z`: one `z` serves every base, and a bare `z` is of no
;;;     base (Q-M1f.322). It is declared here, a relation of no argument
;;;     that no fact is ever of, so that it has one full name,
;;;     `std.math.arith.z`, and a file that writes it lists it, as it lists
;;;     any name a module declares (Q-M1f.231). A relation of no argument
;;;     adds no fact and no candidate (Q-M1f.283).
;;;   - **Division by zero is a contradiction** of arithmetic itself, in
;;;     every base, binary's as decimal's (Q-M1f.269), and so no base's own.
;;;     A module that divides derives the flag
;;;     `(division-by-zero REQUEST)`, the request or the call as it was
;;;     asserted, and `division-by-zero-is-false` derives `(false)` from it:
;;;     two steps, so that a trace shows the flag as a step of its own and the
;;;     contradiction as the next. A theory in which division by zero is
;;;     allowed, a wheel or a meadow, would be a module that does not import
;;;     this one; none exists.
;;;
;;; Both are here, below every base: each base's numeral module imports this.
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.math.arith :symbols (z))
;;;     (import std.math.decimal :symbols (n))
;;;
;;; A program imports a base, `std.math.decimal-arith` or a module over it,
;;; which brings this one whole (Q-M1f.247), and lists from here the names
;;; it writes: `z` in a numeral, and `division-by-zero` where a rule or a
;;; claim reads the flag. `arith` is the module's entry, the closing rule at
;;; the end of this file.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; `z`; the flag `division-by-zero` and its rule `division-by-zero-is-false`;
;;; `arith-module-rule`, and the entry `arith`. All of them are the interface.

;; ── Zero ────────────────────────────────────────────────────────────────────
(relation z
  :why "zero, the number with no digit")

;; ── Division by zero ────────────────────────────────────────────────────────
(relation division-by-zero Request
  :why "{?1} divides by zero")

(rule division-by-zero-is-false ()
  :match  (division-by-zero ?request)
  :assert (false)
  :why    "{?request} divides by zero: no number is the answer")

;; ── The closing rule, and the module's one entry ────────────────────────────
;; The flag is computed and never guessed, so it is closed; `z` is a relation
;; no fact is of, and declared with no argument type, so no search guesses
;; one. The rule names every rule of the module, as each module of the
;; calculator does. `ein-infer/tests/arith_theory.rs` holds that nothing is
;; missing here.
(relation arith-module-rule Rule
  :why "{?1} is a rule of std.math.arith")

(rule arith ()
  :match  ()
  :assert (and (__closed__ division-by-zero)
               (__closed__ arith-module-rule)
               (arith-module-rule division-by-zero-is-false))
  :why    "arithmetic is computed and never guessed: its flag is closed")

)
(module std.math.decimal
;;; Ein stdlib — `std.math.decimal`: the decimal numeral, and whether a written
;;; one is one (Q-M1f.273; Q-M1f.210, and Q-M1f.272 to
;;; Q-M1f.277).
;;;
;;; Ein has no numbers and no arithmetic (Q-M1e2.24).
;;; This module is the decimal **representation**: the constructor `n` and
;;; what a numeral written with it must be. It computes nothing;
;;; `std.math.decimal-arith` is the arithmetic over it, and imports it.
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.math.decimal-arith :symbols (decimal-arith add sum-of))
;;;     (import std.math.decimal :symbols (n))
;;;     (import std.math.arith :symbols (z))
;;;
;;; A program imports the arithmetic, which brings this module and
;;; `std.math.arith` whole (Q-M1f.247), and lists `n` from here and `z`
;;; from `std.math.arith`, since it writes them: nothing is re-exported.
;;; `decimal` is the module's entry, the closing rule at the end of this file.
;;;
;;; ── The numeral ────────────────────────────────────────────────────────────
;;;
;;; A natural number is `z`, zero, `std.math.arith`'s, or `(n PREFIX DIGIT)`:
;;; ten times the prefix, plus the digit. It reads in the order it is
;;; written:
;;;
;;;     7        (n z 7)
;;;     42       (n (n z 4) 2)
;;;     123078   (n (n (n (n (n (n z 1) 2) 3) 0) 7) 8)
;;;
;;; A digit is one of the ten names `0` to `9`, and a prefix is `z` or a
;;; numeral. Any length; high zeros are allowed in what a program writes,
;;; `(n (n z 0) 7)` is 7, and the arithmetic answers in normal form.
;;;
;;; ── A numeral is well-formed from the start ────────────────────────────────
;;;
;;; A malformed decimal number is a problem of this module (Q-M1f.210), and
;;; it is detected right away, without a calculation started with it. Think
;;; of it as a number written on paper: one that contains letters, signs,
;;; whitespace or hieroglyphs is not a decimal number from the beginning,
;;; whatever is later done with it, and no calculation has to start for that
;;; to be seen.
;;;
;;; So the check is this module's, of what was written, and of nothing a
;;; calculation does. The loader states every fact nested in a fact a file
;;; writes, and in a rule's conclusion where it holds no variable, as
;;; `(written T)` (the kernel relation `written`, Q-M1f.275,
;;; Q-M1f.272). Every place of a numeral is a nested fact
;;; of its own, so five rules over `(written (n P A))` see every place of
;;; every numeral a file writes, wherever it sits: a request's operand, a part
;;; of an integer or a rational, a `let`'s value nobody asks about, a fact of
;;; the program's own relation. A well-formed place costs no firing, its ten
;;; `neq` guards and two probes; a malformed one derives the flag on the
;;; smallest `n` term at fault, and the flag derives `(false)`:
;;;
;;;     (not-decimal NUMERAL THING)   THING stands in NUMERAL where a digit or
;;;                                   a prefix goes, and is neither:
;;;                                   - a digit's place holds a name that is
;;;                                     no digit, `(n (n z 1) x)`, a sign,
;;;                                     `(n z -)`, or a fact, `(n z (n z 1))`;
;;;                                   - the prefix is a digit, `(n 1 2)`,
;;;                                     `(n 0 2)`: a numeral ends in `z`;
;;;                                   - the prefix is a named constant,
;;;                                     `(n price 1)`
;;;
;;; Root is dead from its first layer, R is empty, every command exits 0, and
;;; `ein solve` names, in the unsat core, the fact the numeral was written in
;;; and, in `refuted by`, `not-decimal-is-false`. A numeral in a rule's
;;; conclusion that holds no variable rests on no fact: its core is ∅.
;;;
;;; **A flag means malformed; no flag does not mean well-formed.** Silent:
;;;
;;;   - a prefix that is a name neither `z`, a digit nor a named constant,
;;;     `(n end 1)`: saying *a name* costs a walk of the program's names
;;;     (Q-M1f.318);
;;;   - a prefix that is a fact of another relation, `(n (pair 1 2) 3)`: no
;;;     rule can say *not of this shape*;
;;;   - a numeral a rule assembles from a variable, `(n ?p x)`: it is no term
;;;     a file writes;
;;;   - a numeral written as a top-level fact of `n`, which is no term.
;;;
;;; A wrong count of arguments, `(n 1)` or `(n z 1 2)`, is refused when the
;;; program is loaded (Q-M1f.315), and a character that is no name character
;;; at the parse: neither is this module's to flag.
;;;
;;; **A named constant** is a name that stands for a number: `named` is
;;; declared here, and `std.math.decimal-arith`, which declares `let`, writes
;;; `(named NAME)` for every name a `let` states. So the module below `let`
;;; says *the prefix is a named constant* by a probe, and what makes a name
;;; one stays the module's above.
;;;
;;; What is not a numeral's fault is not this module's: a name no `let`
;;; states, a digit where a number goes, `(add 7 X)`, and a `let` that cannot
;;; be read are the faults of what reads the operand, `std.math.decimal-arith`,
;;; `std.math.int` and `std.math.rat`, each of which flags them
;;; (`(malformed REQUEST)`, `(undeclared NAME REQUEST)`).
;;;
;;; ── The rule of the calculator ─────────────────────────────────────────────
;;;
;;; No rule joins two facts on a number: each rule here has one premise that
;;; holds a numeral, `(written (n P A))`, and its others are guards, which
;;; compare and look nothing up, or a probe with every argument bound, `(nz
;;; ?m)` and `(named ?m)`. `ein-infer/tests/arith_theory.rs` holds it.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; `n`, `named`, the flag `not-decimal`, its rules `numeral-digit`,
;;; `numeral-prefix-digit`, `numeral-prefix-zero`, `numeral-prefix-named` and
;;; `not-decimal-is-false`, `decimal-rule`, and the entry `decimal`. The
;;; interface is `n`, `named` and the flag.

(import std.math.arith :symbols (arith z))
(import std.math.digits :symbols (nz))

;; ── The numeral ─────────────────────────────────────────────────────────────
(relation n Number Digit
  :why "the number written {?1}, then the digit {?2}")

;; ── A named constant, which the module that declares `let` writes ──────────
(relation named Name
  :why "{?1} is a named constant")

;; ── The check: every place of every numeral a file writes ───────────────────
(relation not-decimal Number Thing
  :why "{?1} is not a decimal number: {?2} stands where a digit or a number goes")

;; None of the ten digits: `neq` holds of every other name, and of a fact.
(rule numeral-digit ()
  :match  (and (written (n ?p ?a))
               (neq ?a 0) (neq ?a 1) (neq ?a 2) (neq ?a 3) (neq ?a 4)
               (neq ?a 5) (neq ?a 6) (neq ?a 7) (neq ?a 8) (neq ?a 9))
  :assert (not-decimal (n ?p ?a) ?a)
  :why    "{?a} stands where a digit goes and is none of the ten")

;; A numeral ends in `z`. One whose prefix is a digit, `(n 1 2)`, or a named
;; constant, `(n price 1)`, is flagged; one whose prefix is any other name is
;; not, since saying *a name* costs a walk of the program's names.
(rule numeral-prefix-digit ()
  :match  (and (written (n ?m ?a)) (nz ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why    "the digit {?m} stands where a number goes: a number ends in z")

(rule numeral-prefix-zero ()
  :match  (written (n 0 ?a))
  :assert (not-decimal (n 0 ?a) 0)
  :why    "the digit 0 stands where a number goes: a number ends in z")

;; `(neq ?m z)`: a program that names `z` with a `let` is flagged for the
;; `let`, and its numerals, which end in `z`, are not.
(rule numeral-prefix-named ()
  :match  (and (written (n ?m ?a)) (neq ?m z) (named ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why    "the name {?m} stands where a number goes: a name stands for a number as an operand, not inside one")

(rule not-decimal-is-false ()
  :match  (not-decimal ?x ?thing)
  :assert (false)
  :why    "{?x} is not a decimal number: the program cannot hold it")

;; ── The closing rule, and the module's one entry ────────────────────────────
;; Every relation of the module is closed, and the table it reads; every rule
;; is named, and `arith`, the entry of the module below. `ein-infer/tests/
;; arith_theory.rs` holds that nothing is missing here.
(relation decimal-rule Rule
  :why "{?1} is a rule of std.math.decimal")

(rule decimal ()
  :match  ()
  :assert (and (__closed__ nz)
               (__closed__ n) (__closed__ named) (__closed__ not-decimal)
               (__closed__ decimal-rule)
               (decimal-rule arith)
               (decimal-rule numeral-digit) (decimal-rule numeral-prefix-digit)
               (decimal-rule numeral-prefix-zero)
               (decimal-rule numeral-prefix-named)
               (decimal-rule not-decimal-is-false))
  :why    "a numeral is written, and never guessed: every relation of the module is closed")

)
(module std.math.digits
;;; Ein stdlib — `std.math.digits`: the digit tables of the calculator.
;;;
;;; GENERATED: an edit by hand is lost the next time the file is written.
;;; Every row is computed where it is generated, and again from Rust's
;;; integers by `ein-ir/tests/digit_tables.rs`, which holds the file to them,
;;; none missing and none twice (Q-M1f.366).
;;;
;;; A library of **facts**, the stdlib's first: no rule, no macro. Ein has no
;;; numbers and no arithmetic (Q-M1e2.24), and the ten
;;; digits `0` to `9` are plain names. What school arithmetic knows about them
;;; is written here once, the way hardware holds it: as tables, one fact a
;;; row. `std.math.decimal-arith` and `std.math.num9` are the wiring; every step of theirs is a
;;; lookup in one of these tables, so nothing is ever guessed.
;;;
;;;   table  reads                               gives                      rows
;;;   fa     a, b, carry in (0 or 1)             sum digit, carry out        200
;;;   fs     a, b, borrow in (0 or 1)            difference digit, borrow    200
;;;   md     a, b, carry in (0 to 8)             product digit, carry out    900
;;;   cl     the order below (lt eq gt), a, b    the order                   300
;;;   nz     a digit                             it is not zero                9
;;;   mid    two bounds, 0 to 10, two apart      the digit to try             45
;;;   adj    two bounds                          nothing lies between them    10
;;;
;;; A row's arguments are digits, except `cl`'s orders, the names `lt`, `eq`
;;; and `gt`, and the bound `10` of `mid` and `adj`, a name like any digit.
;;;
;;; Importing. An import brings every table and its rows (Q-M1f.247); a
;;; program lists the tables it writes, and the others print by their full
;;; names, `std.math.digits.fs`:
;;;
;;;     (import std.math.digits :symbols (fa nz __closed__))
;;;
;;; **Closed.** Each table is closed by a written `(__closed__ R)` fact below:
;;; a table is complete, and a row is never a hypothesis. Those facts come
;;; with every import of the module, as its rows do, whether or not the
;;; import lists `__closed__` (Q-M1f.146). A theory that
;;; reads the tables closes the ones it reads in its own closing rule too, as
;;; `std.math.decimal-arith` does.

(relation fa Digit Digit Digit Digit Digit :why "{?1} + {?2} + carry {?3} is digit {?4}, carry {?5}")
(relation fs Digit Digit Digit Digit Digit :why "{?1} - {?2} - borrow {?3} is digit {?4}, borrow {?5}")
(relation md Digit Digit Digit Digit Digit :why "{?1} x {?2} + carry {?3} is digit {?4}, carry {?5}")
(relation cl Order Digit Digit Order :why "the order below is {?1}; {?2} against {?3} above it makes it {?4}")
(relation nz Digit :why "{?1} is not zero")
(relation mid Bound Bound Digit :why "between {?1} and {?2}, try {?3}")
(relation adj Bound Bound :why "nothing lies between {?1} and {?2}")

;; Every table is complete: no row is ever a hypothesis.
(__closed__ fa) (__closed__ fs) (__closed__ md) (__closed__ cl) (__closed__ nz) (__closed__ mid) (__closed__ adj)

;; ── fa: 200 rows ──
;; The full adder. a + b + carry in (0 or 1) = 10 x carry out + digit.
(fa 0 0 0 0 0) (fa 0 1 0 1 0) (fa 0 2 0 2 0) (fa 0 3 0 3 0) (fa 0 4 0 4 0) (fa 0 5 0 5 0) (fa 0 6 0 6 0) (fa 0 7 0 7 0) (fa 0 8 0 8 0) (fa 0 9 0 9 0)
(fa 0 0 1 1 0) (fa 0 1 1 2 0) (fa 0 2 1 3 0) (fa 0 3 1 4 0) (fa 0 4 1 5 0) (fa 0 5 1 6 0) (fa 0 6 1 7 0) (fa 0 7 1 8 0) (fa 0 8 1 9 0) (fa 0 9 1 0 1)
(fa 1 0 0 1 0) (fa 1 1 0 2 0) (fa 1 2 0 3 0) (fa 1 3 0 4 0) (fa 1 4 0 5 0) (fa 1 5 0 6 0) (fa 1 6 0 7 0) (fa 1 7 0 8 0) (fa 1 8 0 9 0) (fa 1 9 0 0 1)
(fa 1 0 1 2 0) (fa 1 1 1 3 0) (fa 1 2 1 4 0) (fa 1 3 1 5 0) (fa 1 4 1 6 0) (fa 1 5 1 7 0) (fa 1 6 1 8 0) (fa 1 7 1 9 0) (fa 1 8 1 0 1) (fa 1 9 1 1 1)
(fa 2 0 0 2 0) (fa 2 1 0 3 0) (fa 2 2 0 4 0) (fa 2 3 0 5 0) (fa 2 4 0 6 0) (fa 2 5 0 7 0) (fa 2 6 0 8 0) (fa 2 7 0 9 0) (fa 2 8 0 0 1) (fa 2 9 0 1 1)
(fa 2 0 1 3 0) (fa 2 1 1 4 0) (fa 2 2 1 5 0) (fa 2 3 1 6 0) (fa 2 4 1 7 0) (fa 2 5 1 8 0) (fa 2 6 1 9 0) (fa 2 7 1 0 1) (fa 2 8 1 1 1) (fa 2 9 1 2 1)
(fa 3 0 0 3 0) (fa 3 1 0 4 0) (fa 3 2 0 5 0) (fa 3 3 0 6 0) (fa 3 4 0 7 0) (fa 3 5 0 8 0) (fa 3 6 0 9 0) (fa 3 7 0 0 1) (fa 3 8 0 1 1) (fa 3 9 0 2 1)
(fa 3 0 1 4 0) (fa 3 1 1 5 0) (fa 3 2 1 6 0) (fa 3 3 1 7 0) (fa 3 4 1 8 0) (fa 3 5 1 9 0) (fa 3 6 1 0 1) (fa 3 7 1 1 1) (fa 3 8 1 2 1) (fa 3 9 1 3 1)
(fa 4 0 0 4 0) (fa 4 1 0 5 0) (fa 4 2 0 6 0) (fa 4 3 0 7 0) (fa 4 4 0 8 0) (fa 4 5 0 9 0) (fa 4 6 0 0 1) (fa 4 7 0 1 1) (fa 4 8 0 2 1) (fa 4 9 0 3 1)
(fa 4 0 1 5 0) (fa 4 1 1 6 0) (fa 4 2 1 7 0) (fa 4 3 1 8 0) (fa 4 4 1 9 0) (fa 4 5 1 0 1) (fa 4 6 1 1 1) (fa 4 7 1 2 1) (fa 4 8 1 3 1) (fa 4 9 1 4 1)
(fa 5 0 0 5 0) (fa 5 1 0 6 0) (fa 5 2 0 7 0) (fa 5 3 0 8 0) (fa 5 4 0 9 0) (fa 5 5 0 0 1) (fa 5 6 0 1 1) (fa 5 7 0 2 1) (fa 5 8 0 3 1) (fa 5 9 0 4 1)
(fa 5 0 1 6 0) (fa 5 1 1 7 0) (fa 5 2 1 8 0) (fa 5 3 1 9 0) (fa 5 4 1 0 1) (fa 5 5 1 1 1) (fa 5 6 1 2 1) (fa 5 7 1 3 1) (fa 5 8 1 4 1) (fa 5 9 1 5 1)
(fa 6 0 0 6 0) (fa 6 1 0 7 0) (fa 6 2 0 8 0) (fa 6 3 0 9 0) (fa 6 4 0 0 1) (fa 6 5 0 1 1) (fa 6 6 0 2 1) (fa 6 7 0 3 1) (fa 6 8 0 4 1) (fa 6 9 0 5 1)
(fa 6 0 1 7 0) (fa 6 1 1 8 0) (fa 6 2 1 9 0) (fa 6 3 1 0 1) (fa 6 4 1 1 1) (fa 6 5 1 2 1) (fa 6 6 1 3 1) (fa 6 7 1 4 1) (fa 6 8 1 5 1) (fa 6 9 1 6 1)
(fa 7 0 0 7 0) (fa 7 1 0 8 0) (fa 7 2 0 9 0) (fa 7 3 0 0 1) (fa 7 4 0 1 1) (fa 7 5 0 2 1) (fa 7 6 0 3 1) (fa 7 7 0 4 1) (fa 7 8 0 5 1) (fa 7 9 0 6 1)
(fa 7 0 1 8 0) (fa 7 1 1 9 0) (fa 7 2 1 0 1) (fa 7 3 1 1 1) (fa 7 4 1 2 1) (fa 7 5 1 3 1) (fa 7 6 1 4 1) (fa 7 7 1 5 1) (fa 7 8 1 6 1) (fa 7 9 1 7 1)
(fa 8 0 0 8 0) (fa 8 1 0 9 0) (fa 8 2 0 0 1) (fa 8 3 0 1 1) (fa 8 4 0 2 1) (fa 8 5 0 3 1) (fa 8 6 0 4 1) (fa 8 7 0 5 1) (fa 8 8 0 6 1) (fa 8 9 0 7 1)
(fa 8 0 1 9 0) (fa 8 1 1 0 1) (fa 8 2 1 1 1) (fa 8 3 1 2 1) (fa 8 4 1 3 1) (fa 8 5 1 4 1) (fa 8 6 1 5 1) (fa 8 7 1 6 1) (fa 8 8 1 7 1) (fa 8 9 1 8 1)
(fa 9 0 0 9 0) (fa 9 1 0 0 1) (fa 9 2 0 1 1) (fa 9 3 0 2 1) (fa 9 4 0 3 1) (fa 9 5 0 4 1) (fa 9 6 0 5 1) (fa 9 7 0 6 1) (fa 9 8 0 7 1) (fa 9 9 0 8 1)
(fa 9 0 1 0 1) (fa 9 1 1 1 1) (fa 9 2 1 2 1) (fa 9 3 1 3 1) (fa 9 4 1 4 1) (fa 9 5 1 5 1) (fa 9 6 1 6 1) (fa 9 7 1 7 1) (fa 9 8 1 8 1) (fa 9 9 1 9 1)

;; ── fs: 200 rows ──
;; The full subtractor. a - b - borrow in (0 or 1) = digit - 10 x borrow out.
(fs 0 0 0 0 0) (fs 0 1 0 9 1) (fs 0 2 0 8 1) (fs 0 3 0 7 1) (fs 0 4 0 6 1) (fs 0 5 0 5 1) (fs 0 6 0 4 1) (fs 0 7 0 3 1) (fs 0 8 0 2 1) (fs 0 9 0 1 1)
(fs 0 0 1 9 1) (fs 0 1 1 8 1) (fs 0 2 1 7 1) (fs 0 3 1 6 1) (fs 0 4 1 5 1) (fs 0 5 1 4 1) (fs 0 6 1 3 1) (fs 0 7 1 2 1) (fs 0 8 1 1 1) (fs 0 9 1 0 1)
(fs 1 0 0 1 0) (fs 1 1 0 0 0) (fs 1 2 0 9 1) (fs 1 3 0 8 1) (fs 1 4 0 7 1) (fs 1 5 0 6 1) (fs 1 6 0 5 1) (fs 1 7 0 4 1) (fs 1 8 0 3 1) (fs 1 9 0 2 1)
(fs 1 0 1 0 0) (fs 1 1 1 9 1) (fs 1 2 1 8 1) (fs 1 3 1 7 1) (fs 1 4 1 6 1) (fs 1 5 1 5 1) (fs 1 6 1 4 1) (fs 1 7 1 3 1) (fs 1 8 1 2 1) (fs 1 9 1 1 1)
(fs 2 0 0 2 0) (fs 2 1 0 1 0) (fs 2 2 0 0 0) (fs 2 3 0 9 1) (fs 2 4 0 8 1) (fs 2 5 0 7 1) (fs 2 6 0 6 1) (fs 2 7 0 5 1) (fs 2 8 0 4 1) (fs 2 9 0 3 1)
(fs 2 0 1 1 0) (fs 2 1 1 0 0) (fs 2 2 1 9 1) (fs 2 3 1 8 1) (fs 2 4 1 7 1) (fs 2 5 1 6 1) (fs 2 6 1 5 1) (fs 2 7 1 4 1) (fs 2 8 1 3 1) (fs 2 9 1 2 1)
(fs 3 0 0 3 0) (fs 3 1 0 2 0) (fs 3 2 0 1 0) (fs 3 3 0 0 0) (fs 3 4 0 9 1) (fs 3 5 0 8 1) (fs 3 6 0 7 1) (fs 3 7 0 6 1) (fs 3 8 0 5 1) (fs 3 9 0 4 1)
(fs 3 0 1 2 0) (fs 3 1 1 1 0) (fs 3 2 1 0 0) (fs 3 3 1 9 1) (fs 3 4 1 8 1) (fs 3 5 1 7 1) (fs 3 6 1 6 1) (fs 3 7 1 5 1) (fs 3 8 1 4 1) (fs 3 9 1 3 1)
(fs 4 0 0 4 0) (fs 4 1 0 3 0) (fs 4 2 0 2 0) (fs 4 3 0 1 0) (fs 4 4 0 0 0) (fs 4 5 0 9 1) (fs 4 6 0 8 1) (fs 4 7 0 7 1) (fs 4 8 0 6 1) (fs 4 9 0 5 1)
(fs 4 0 1 3 0) (fs 4 1 1 2 0) (fs 4 2 1 1 0) (fs 4 3 1 0 0) (fs 4 4 1 9 1) (fs 4 5 1 8 1) (fs 4 6 1 7 1) (fs 4 7 1 6 1) (fs 4 8 1 5 1) (fs 4 9 1 4 1)
