(relation z :why "zero, the number with no digit")

(relation std.math.arith.division-by-zero Request :why "{?1} divides by zero")

(rule
  std.math.arith.division-by-zero-is-false
  ()
  :match (std.math.arith.division-by-zero ?request)
  :assert (false)
  :why "{?request} divides by zero: no number is the answer")

(relation
  std.math.arith.arith-module-rule
  Rule
  :why "{?1} is a rule of std.math.arith")

(rule
  std.math.arith.arith
  ()
  :match ()
  :assert (and (__closed__ std.math.arith.division-by-zero) (__closed__ std.math.arith.arith-module-rule) (std.math.arith.arith-module-rule std.math.arith.division-by-zero-is-false))
  :why "arithmetic is computed and never guessed: its flag is closed")

(relation n Number Digit :why "the number written {?1}, then the digit {?2}")

(relation std.math.decimal.named Name :why "{?1} is a named constant")

(relation
  not-decimal
  Number
  Thing
  :why "{?1} is not a decimal number: {?2} stands where a digit or a number goes")

(rule
  std.math.decimal.numeral-digit
  ()
  :match (and (written (n ?p ?a)) (neq ?a 0) (neq ?a 1) (neq ?a 2) (neq ?a 3) (neq ?a 4) (neq ?a 5) (neq ?a 6) (neq ?a 7) (neq ?a 8) (neq ?a 9))
  :assert (not-decimal (n ?p ?a) ?a)
  :why "{?a} stands where a digit goes and is none of the ten")

(rule
  std.math.decimal.numeral-prefix-digit
  ()
  :match (and (written (n ?m ?a)) (std.math.digits.nz ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why "the digit {?m} stands where a number goes: a number ends in z")

(rule
  std.math.decimal.numeral-prefix-zero
  ()
  :match (written (n 0 ?a))
  :assert (not-decimal (n 0 ?a) 0)
  :why "the digit 0 stands where a number goes: a number ends in z")

(rule
  std.math.decimal.numeral-prefix-named
  ()
  :match (and (written (n ?m ?a)) (neq ?m z) (std.math.decimal.named ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why "the name {?m} stands where a number goes: a name stands for a number as an operand, not inside one")

(rule
  std.math.decimal.not-decimal-is-false
  ()
  :match (not-decimal ?x ?thing)
  :assert (false)
  :why "{?x} is not a decimal number: the program cannot hold it")

(relation
  std.math.decimal.decimal-rule
  Rule
  :why "{?1} is a rule of std.math.decimal")

(rule
  std.math.decimal.decimal
  ()
  :match ()
  :assert (and (__closed__ std.math.digits.nz) (__closed__ n) (__closed__ std.math.decimal.named) (__closed__ not-decimal) (__closed__ std.math.decimal.decimal-rule) (std.math.decimal.decimal-rule std.math.arith.arith) (std.math.decimal.decimal-rule std.math.decimal.numeral-digit) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-digit) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-zero) (std.math.decimal.decimal-rule std.math.decimal.numeral-prefix-named) (std.math.decimal.decimal-rule std.math.decimal.not-decimal-is-false))
  :why "a numeral is written, and never guessed: every relation of the module is closed")

(rule
  std.math.positional.operand-zero
  (?OPERAND ?OPERAND-IS)
  :match (?OPERAND ?k z)
  :assert (?OPERAND-IS ?k z)
  :why "zero stands for itself")

(rule
  std.math.positional.operand-number
  (?OPERAND ?N ?OPERAND-IS)
  :match (?OPERAND ?k (?N ?p ?a))
  :assert (?OPERAND-IS ?k (?N ?p ?a))
  :why "a number stands for itself")

(rule
  std.math.positional.let-named
  (?LET ?NAMED)
  :match (?LET ?x ?v)
  :assert (?NAMED ?x)
  :why "{?x} is the name of a number")

(rule
  std.math.positional.operand-name
  (?OPERAND ?NAMED ?LET ?OPERAND-IS)
  :match (and (?OPERAND ?k ?x) (?NAMED ?x) (?LET ?x ?v))
  :assert (?OPERAND-IS ?k ?v)
  :why "{?x} names {?v}")

(rule
  std.math.positional.add-column
  (?ADD-WALK ?N ?FA ?B)
  :match (and (?ADD-WALK ?k (?N ?p ?a) (?N ?q ?c) ?e ?acc) (?FA ?a ?c ?e ?s ?f))
  :assert (?ADD-WALK ?k ?p ?q ?f (?B ?s ?acc))
  :why "{?a} + {?c} + carry {?e} is {?s}, carry {?f}: {?s} goes in front of the digits so far")

(rule
  std.math.positional.add-column-first
  (?ADD-WALK ?N ?FA ?B)
  :match (and (?ADD-WALK ?k (?N ?p ?a) z ?e ?acc) (?FA ?a 0 ?e ?s ?f))
  :assert (?ADD-WALK ?k ?p z ?f (?B ?s ?acc))
  :why "the second number has run out: {?a} + carry {?e} is {?s}, carry {?f}")

(rule
  std.math.positional.add-column-second
  (?ADD-WALK ?N ?FA ?B)
  :match (and (?ADD-WALK ?k z (?N ?q ?c) ?e ?acc) (?FA 0 ?c ?e ?s ?f))
  :assert (?ADD-WALK ?k z ?q ?f (?B ?s ?acc))
  :why "the first number has run out: {?c} + carry {?e} is {?s}, carry {?f}")

(rule
  std.math.positional.add-end
  (?ADD-WALK ?STRIP)
  :match (?ADD-WALK ?k z z 0 ?acc)
  :assert (?STRIP ?k ?acc)
  :why "no column is left and no carry: the digits are {?acc}")

(rule
  std.math.positional.add-carry-out
  (?ADD-WALK ?TURN ?B)
  :match (?ADD-WALK ?k z z 1 ?acc)
  :assert (?TURN ?k (?B 1 ?acc) z)
  :why "no column is left: the carry is the top digit, in front of {?acc}")

(rule
  std.math.positional.strip-zero
  (?STRIP ?B)
  :match (?STRIP ?k (?B 0 ?r))
  :assert (?STRIP ?k ?r)
  :why "a high zero is dropped")

(rule
  std.math.positional.strip-top
  (?STRIP ?B ?NZ ?TURN)
  :match (and (?STRIP ?k (?B ?a ?r)) (?NZ ?a))
  :assert (?TURN ?k (?B ?a ?r) z)
  :why "the top digit {?a} is not zero: no high zero is left")

(rule
  std.math.positional.strip-none
  (?STRIP ?DONE)
  :match (?STRIP ?k z)
  :assert (?DONE ?k z)
  :why "no digit is left: the answer is zero")

(rule
  std.math.positional.turn-step
  (?TURN ?B ?N)
  :match (?TURN ?k (?B ?a ?r) ?acc)
  :assert (?TURN ?k ?r (?N ?acc ?a))
  :why "the digit {?a} goes after {?acc}")

(rule
  std.math.positional.turn-end
  (?TURN ?DONE)
  :match (?TURN ?k z ?acc)
  :assert (?DONE ?k ?acc)
  :why "turned round: the answer is {?acc}")

(rule
  std.math.positional.add-ask
  (?ADD ?OPERAND ?ADD-FIRST)
  :match (?ADD ?x ?y)
  :assert (?OPERAND (?ADD-FIRST ?x ?y) ?x)
  :why "{?x} + {?y} is asked: first, the number {?x} stands for")

(rule
  std.math.positional.add-ask-second
  (?OPERAND-IS ?ADD-FIRST ?OPERAND ?ADD-SECOND)
  :match (?OPERAND-IS (?ADD-FIRST ?x ?y) ?u)
  :assert (?OPERAND (?ADD-SECOND ?x ?y ?u) ?y)
  :why "the first operand is {?u}: now the number {?y} stands for")

(rule
  std.math.positional.add-start
  (?OPERAND-IS ?ADD-SECOND ?ADD-WALK ?SUM)
  :match (?OPERAND-IS (?ADD-SECOND ?x ?y ?u) ?v)
  :assert (?ADD-WALK (?SUM ?x ?y) ?u ?v 0 z)
  :why "add {?u} and {?v} from the units, with no carry in")

(rule
  std.math.positional.add-answer
  (?DONE ?SUM ?SUM-OF)
  :match (?DONE (?SUM ?x ?y) ?s)
  :assert (?SUM-OF ?x ?y ?s)
  :why "{?x} + {?y} = {?s}")

(rule
  std.math.positional.sub-column
  (?SUB-WALK ?N ?FS ?B)
  :match (and (?SUB-WALK ?k (?N ?p ?a) (?N ?q ?c) ?e ?acc) (?FS ?a ?c ?e ?s ?f))
  :assert (?SUB-WALK ?k ?p ?q ?f (?B ?s ?acc))
  :why "{?a} - {?c} - borrow {?e} is {?s}, borrow {?f}: {?s} goes in front of the digits so far")

(rule
  std.math.positional.sub-column-first
  (?SUB-WALK ?N ?FS ?B)
  :match (and (?SUB-WALK ?k (?N ?p ?a) z ?e ?acc) (?FS ?a 0 ?e ?s ?f))
  :assert (?SUB-WALK ?k ?p z ?f (?B ?s ?acc))
  :why "the number taken away has run out: {?a} - borrow {?e} is {?s}, borrow {?f}")

(rule
  std.math.positional.sub-column-second
  (?SUB-WALK ?N ?FS ?B)
  :match (and (?SUB-WALK ?k z (?N ?q ?c) ?e ?acc) (?FS 0 ?c ?e ?s ?f))
  :assert (?SUB-WALK ?k z ?q ?f (?B ?s ?acc))
  :why "the number taken from has run out: 0 - {?c} - borrow {?e} is {?s}, borrow {?f}")

(rule
  std.math.positional.sub-end
  (?SUB-WALK ?STRIP)
  :match (?SUB-WALK ?k z z 0 ?acc)
  :assert (?STRIP ?k ?acc)
  :why "no column is left and no borrow: the digits are {?acc}")

(rule
  std.math.positional.sub-borrow-out
  (?SUB-WALK ?SHORT)
  :match (?SUB-WALK ?k z z 1 ?acc)
  :assert (?SHORT ?k)
  :why "no column is left and a borrow is: the number taken from is the smaller")

(rule
  std.math.positional.sub-ask
  (?SUB ?OPERAND ?SUB-FIRST)
  :match (?SUB ?x ?y)
  :assert (?OPERAND (?SUB-FIRST ?x ?y) ?x)
  :why "{?x} - {?y} is asked: first, the number {?x} stands for")

(rule
  std.math.positional.sub-ask-second
  (?OPERAND-IS ?SUB-FIRST ?OPERAND ?SUB-SECOND)
  :match (?OPERAND-IS (?SUB-FIRST ?x ?y) ?u)
  :assert (?OPERAND (?SUB-SECOND ?x ?y ?u) ?y)
  :why "the first operand is {?u}: now the number {?y} stands for")

(rule
  std.math.positional.sub-start
  (?OPERAND-IS ?SUB-SECOND ?SUB-WALK ?DIFFERENCE ?SHORTFALL)
  :match (?OPERAND-IS (?SUB-SECOND ?x ?y ?u) ?v)
  :assert (and (?SUB-WALK (?DIFFERENCE ?x ?y) ?u ?v 0 z) (?SUB-WALK (?SHORTFALL ?x ?y) ?v ?u 0 z))
  :why "take {?v} from {?u}, and {?u} from {?v}, from the units, with no borrow in: one of the two has an answer")

(rule
  std.math.positional.sub-answer
  (?DONE ?DIFFERENCE ?DIFF-OF)
  :match (?DONE (?DIFFERENCE ?x ?y) ?d)
  :assert (?DIFF-OF ?x ?y ?d z)
  :why "{?x} - {?y} = {?d}, and nothing is short")

(rule
  std.math.positional.sub-answer-short
  (?DONE ?SHORTFALL ?DIFF-OF)
  :match (?DONE (?SHORTFALL ?x ?y) ?r)
  :assert (?DIFF-OF ?x ?y z ?r)
  :why "{?x} is short of {?y} by {?r}: the difference is zero")

(rule
  std.math.positional.cmp-column
  (?CMP-WALK ?N ?CL)
  :match (and (?CMP-WALK ?k (?N ?p ?a) (?N ?q ?c) ?o) (?CL ?o ?a ?c ?t))
  :assert (?CMP-WALK ?k ?p ?q ?t)
  :why "the order below is {?o}; {?a} against {?c} above it makes it {?t}")

(rule
  std.math.positional.cmp-column-first
  (?CMP-WALK ?N ?CL)
  :match (and (?CMP-WALK ?k (?N ?p ?a) z ?o) (?CL ?o ?a 0 ?t))
  :assert (?CMP-WALK ?k ?p z ?t)
  :why "the second number has run out: the order below is {?o}, and {?a} against nothing makes it {?t}")

(rule
  std.math.positional.cmp-column-second
  (?CMP-WALK ?N ?CL)
  :match (and (?CMP-WALK ?k z (?N ?q ?c) ?o) (?CL ?o 0 ?c ?t))
  :assert (?CMP-WALK ?k z ?q ?t)
  :why "the first number has run out: the order below is {?o}, and nothing against {?c} makes it {?t}")

(rule
  std.math.positional.cmp-end
  (?CMP-WALK ?ORDER-IS)
  :match (?CMP-WALK ?k z z ?o)
  :assert (?ORDER-IS ?k ?o)
  :why "no column is left: the order is {?o}")

(rule
  std.math.positional.cmp-ask
  (?CMP ?OPERAND ?CMP-FIRST)
  :match (?CMP ?x ?y)
  :assert (?OPERAND (?CMP-FIRST ?x ?y) ?x)
  :why "{?x} compared with {?y} is asked: first, the number {?x} stands for")

(rule
  std.math.positional.cmp-ask-second
  (?OPERAND-IS ?CMP-FIRST ?OPERAND ?CMP-SECOND)
  :match (?OPERAND-IS (?CMP-FIRST ?x ?y) ?u)
  :assert (?OPERAND (?CMP-SECOND ?x ?y ?u) ?y)
  :why "the first operand is {?u}: now the number {?y} stands for")

(rule
  std.math.positional.cmp-start
  (?OPERAND-IS ?CMP-SECOND ?CMP-WALK ?ORDER)
  :match (?OPERAND-IS (?CMP-SECOND ?x ?y ?u) ?v)
  :assert (?CMP-WALK (?ORDER ?x ?y) ?u ?v eq)
  :why "compare {?u} with {?v} from the units: equal so far")

(rule
  std.math.positional.cmp-answer
  (?ORDER-IS ?ORDER ?CMP-OF)
  :match (?ORDER-IS (?ORDER ?x ?y) ?o)
  :assert (?CMP-OF ?x ?y ?o)
  :why "{?x} against {?y}: {?o}")

(rule
  std.math.positional.top-first-step
  (?TOP-FIRST ?N ?B)
  :match (?TOP-FIRST ?k (?N ?p ?a) ?acc)
  :assert (?TOP-FIRST ?k ?p (?B ?a ?acc))
  :why "the digit {?a} goes in front of {?acc}")

(rule
  std.math.positional.top-first-end
  (?TOP-FIRST ?TOP-FIRST-IS)
  :match (?TOP-FIRST ?k z ?acc)
  :assert (?TOP-FIRST-IS ?k ?acc)
  :why "turned round: the digits, the top one first, are {?acc}")

(rule
  std.math.positional.mul-turn
  (?MUL-CALL ?TOP-FIRST ?MUL-DIGITS)
  :match (?MUL-CALL ?k ?u ?v)
  :assert (?TOP-FIRST (?MUL-DIGITS ?k ?u) ?v z)
  :why "to multiply {?u} by {?v}: first {?v}'s digits, the top one first")

(rule
  std.math.positional.mul-begin
  (?TOP-FIRST-IS ?MUL-DIGITS ?MUL-STEP)
  :match (?TOP-FIRST-IS (?MUL-DIGITS ?k ?u) ?t)
  :assert (?MUL-STEP ?k ?u ?t z)
  :why "nothing is summed yet")

(rule
  std.math.positional.mul-next
  (?DONE ?MUL-SUM ?MUL-STEP)
  :match (?DONE (?MUL-SUM ?k ?u ?rest) ?s)
  :assert (?MUL-STEP ?k ?u ?rest ?s)
  :why "the sum so far is {?s}")

(rule
  std.math.positional.mul-end
  (?MUL-STEP ?DONE)
  :match (?MUL-STEP ?k ?u z ?acc)
  :assert (?DONE ?k ?acc)
  :why "no digit of the multiplier is left: the product is {?acc}")

(rule
  std.math.positional.mul-ask
  (?MUL ?OPERAND ?MUL-FIRST)
  :match (?MUL ?x ?y)
  :assert (?OPERAND (?MUL-FIRST ?x ?y) ?x)
  :why "{?x} x {?y} is asked: first, the number {?x} stands for")

(rule
  std.math.positional.mul-ask-second
  (?OPERAND-IS ?MUL-FIRST ?OPERAND ?MUL-SECOND)
  :match (?OPERAND-IS (?MUL-FIRST ?x ?y) ?u)
  :assert (?OPERAND (?MUL-SECOND ?x ?y ?u) ?y)
  :why "the first operand is {?u}: now the number {?y} stands for")

(rule
  std.math.positional.mul-start
  (?OPERAND-IS ?MUL-SECOND ?MUL-CALL ?PRODUCT)
  :match (?OPERAND-IS (?MUL-SECOND ?x ?y ?u) ?v)
  :assert (?MUL-CALL (?PRODUCT ?x ?y) ?u ?v)
  :why "multiply {?u} by {?v}")

(rule
  std.math.positional.mul-answer
  (?DONE ?PRODUCT ?PRODUCT-OF)
  :match (?DONE (?PRODUCT ?x ?y) ?p)
  :assert (?PRODUCT-OF ?x ?y ?p)
  :why "{?x} x {?y} = {?p}")

(rule
  std.math.positional.div-begin
  (?TOP-FIRST-IS ?DIV-DIGITS ?DIV-STEP)
  :match (?TOP-FIRST-IS (?DIV-DIGITS ?k ?ms) ?t)
  :assert (?DIV-STEP ?k ?ms ?t z z)
  :why "start at the top digit: nothing is left over yet, and the quotient is zero")

(rule
  std.math.positional.div-end
  (?DIV-STEP ?DIV-DONE)
  :match (?DIV-STEP ?k ?ms z ?t ?w)
  :assert (?DIV-DONE ?k ?w ?t)
  :why "no digit is left: the quotient is {?w} and the remainder {?t}")

(rule
  std.math.positional.div-ask
  (?DIV ?OPERAND ?DIV-FIRST)
  :match (?DIV ?x ?y)
  :assert (?OPERAND (?DIV-FIRST ?x ?y) ?x)
  :why "{?x} divided by {?y} is asked: first, the number {?x} stands for")

(rule
  std.math.positional.div-ask-second
  (?OPERAND-IS ?DIV-FIRST ?OPERAND ?DIV-SECOND)
  :match (?OPERAND-IS (?DIV-FIRST ?x ?y) ?u)
  :assert (?OPERAND (?DIV-SECOND ?x ?y ?u) ?y)
  :why "the first operand is {?u}: now the number {?y} stands for")

(rule
  std.math.positional.div-start
  (?OPERAND-IS ?DIV-SECOND ?DIV-CALL ?QUOTIENT)
  :match (?OPERAND-IS (?DIV-SECOND ?x ?y ?u) ?v)
  :assert (?DIV-CALL (?QUOTIENT ?x ?y) ?u ?v)
  :why "divide {?u} by {?v}")

(rule
  std.math.positional.div-answer
  (?DIV-DONE ?QUOTIENT ?QUOT-OF)
  :match (?DIV-DONE (?QUOTIENT ?x ?y) ?q ?r)
  :assert (?QUOT-OF ?x ?y ?q ?r)
  :why "{?x} divided by {?y} = {?q}, remainder {?r}")

(rule
  std.math.positional.div-by-zero
  (?DONE ?DIV-M1 ?QUOTIENT ?DIV)
  :match (?DONE (?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v) z)
  :assert (std.math.arith.division-by-zero (?DIV ?x ?y))
  :why "the divisor of {?x} divided by {?y} is zero")

(rule
  std.math.positional.div-call-by-zero
  (?DONE ?DIV-M1 ?DIV-CALL)
  :match (?DONE (?DIV-M1 ?k ?u ?v) z)
  :assert (std.math.arith.division-by-zero (?DIV-CALL ?k ?u ?v))
  :why "the divisor of {?u} divided by {?v}, wanted for {?k}, is zero")

(rule
  std.math.positional.operand-digit
  (?OPERAND ?NZ ?BAD-OPERAND ?NOT-A-NUMBER ?N)
  :match (and (?OPERAND ?k ?x) (?NZ ?x))
  :assert (?BAD-OPERAND ?k (?NOT-A-NUMBER ?x))
  :why "the digit {?x} is not a number: the number is ({?N} z {?x})")

(rule
  std.math.positional.operand-digit-zero
  (?OPERAND ?BAD-OPERAND ?NOT-A-NUMBER)
  :match (?OPERAND ?k 0)
  :assert (?BAD-OPERAND ?k (?NOT-A-NUMBER 0))
  :why "the digit 0 is not a number: zero is z")

(rule
  std.math.positional.let-twice
  (?LET ?MALFORMED)
  :match (and (?LET ?x ?v) (?LET ?x ?w) (neq ?v ?w))
  :assert (?MALFORMED (?LET ?x ?v))
  :why "{?x} is named twice: {?v}, and {?w}")

(rule
  std.math.positional.let-zero
  (?LET ?MALFORMED)
  :match (?LET z ?v)
  :assert (?MALFORMED (?LET z ?v))
  :why "z is zero, and cannot name another number")

(rule
  std.math.positional.let-digit
  (?LET ?NZ ?MALFORMED)
  :match (and (?LET ?x ?v) (?NZ ?x))
  :assert (?MALFORMED (?LET ?x ?v))
  :why "{?x} is a digit, and cannot name a number")

(rule
  std.math.positional.let-digit-zero
  (?LET ?MALFORMED)
  :match (?LET 0 ?v)
  :assert (?MALFORMED (?LET 0 ?v))
  :why "0 is a digit, and cannot name a number")

(rule
  std.math.positional.let-to-name
  (?LET ?NAMED ?MALFORMED)
  :match (and (?LET ?x ?v) (?NAMED ?v))
  :assert (?MALFORMED (?LET ?x ?v))
  :why "{?v} is a named constant: a let names a number, not another name")

(rule
  std.math.positional.let-to-digit
  (?LET ?NZ ?MALFORMED ?N)
  :match (and (?LET ?x ?v) (?NZ ?v))
  :assert (?MALFORMED (?LET ?x ?v))
  :why "{?v} is a digit, not a number: the number is ({?N} z {?v})")

(rule
  std.math.positional.let-to-digit-zero
  (?LET ?MALFORMED)
  :match (?LET ?x 0)
  :assert (?MALFORMED (?LET ?x 0))
  :why "0 is a digit, not a number: zero is z")

(rule
  std.math.positional.bad-add-first
  (?BAD-OPERAND ?ADD-FIRST ?BAD-REQUEST ?ADD)
  :match (?BAD-OPERAND (?ADD-FIRST ?x ?y) ?f)
  :assert (?BAD-REQUEST (?ADD ?x ?y) ?f)
  :why "the first operand of {?x} + {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-add-second
  (?BAD-OPERAND ?ADD-SECOND ?BAD-REQUEST ?ADD)
  :match (?BAD-OPERAND (?ADD-SECOND ?x ?y ?u) ?f)
  :assert (?BAD-REQUEST (?ADD ?x ?y) ?f)
  :why "the second operand of {?x} + {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-sub-first
  (?BAD-OPERAND ?SUB-FIRST ?BAD-REQUEST ?SUB)
  :match (?BAD-OPERAND (?SUB-FIRST ?x ?y) ?f)
  :assert (?BAD-REQUEST (?SUB ?x ?y) ?f)
  :why "the first operand of {?x} - {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-sub-second
  (?BAD-OPERAND ?SUB-SECOND ?BAD-REQUEST ?SUB)
  :match (?BAD-OPERAND (?SUB-SECOND ?x ?y ?u) ?f)
  :assert (?BAD-REQUEST (?SUB ?x ?y) ?f)
  :why "the second operand of {?x} - {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-cmp-first
  (?BAD-OPERAND ?CMP-FIRST ?BAD-REQUEST ?CMP)
  :match (?BAD-OPERAND (?CMP-FIRST ?x ?y) ?f)
  :assert (?BAD-REQUEST (?CMP ?x ?y) ?f)
  :why "the first operand of {?x} compared with {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-cmp-second
  (?BAD-OPERAND ?CMP-SECOND ?BAD-REQUEST ?CMP)
  :match (?BAD-OPERAND (?CMP-SECOND ?x ?y ?u) ?f)
  :assert (?BAD-REQUEST (?CMP ?x ?y) ?f)
  :why "the second operand of {?x} compared with {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-mul-first
  (?BAD-OPERAND ?MUL-FIRST ?BAD-REQUEST ?MUL)
  :match (?BAD-OPERAND (?MUL-FIRST ?x ?y) ?f)
  :assert (?BAD-REQUEST (?MUL ?x ?y) ?f)
  :why "the first operand of {?x} x {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-mul-second
  (?BAD-OPERAND ?MUL-SECOND ?BAD-REQUEST ?MUL)
  :match (?BAD-OPERAND (?MUL-SECOND ?x ?y ?u) ?f)
  :assert (?BAD-REQUEST (?MUL ?x ?y) ?f)
  :why "the second operand of {?x} x {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-div-first
  (?BAD-OPERAND ?DIV-FIRST ?BAD-REQUEST ?DIV)
  :match (?BAD-OPERAND (?DIV-FIRST ?x ?y) ?f)
  :assert (?BAD-REQUEST (?DIV ?x ?y) ?f)
  :why "the first operand of {?x} divided by {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-div-second
  (?BAD-OPERAND ?DIV-SECOND ?BAD-REQUEST ?DIV)
  :match (?BAD-OPERAND (?DIV-SECOND ?x ?y ?u) ?f)
  :assert (?BAD-REQUEST (?DIV ?x ?y) ?f)
  :why "the second operand of {?x} divided by {?y} is at fault: {?f}")

(rule
  std.math.positional.bad-request-malformed
  (?BAD-REQUEST ?NOT-A-NUMBER ?MALFORMED)
  :match (?BAD-REQUEST ?request (?NOT-A-NUMBER ?thing))
  :assert (?MALFORMED ?request)
  :why "an operand of {?request} is not a number: it holds {?thing}")

(rule
  std.math.positional.bad-request-undeclared
  (?BAD-REQUEST ?NO-LET ?UNDECLARED)
  :match (?BAD-REQUEST ?request (?NO-LET ?x))
  :assert (?UNDECLARED ?x ?request)
  :why "{?request} uses the name {?x}, and no let states it")

(rule
  std.math.positional.malformed-is-false
  (?MALFORMED)
  :match (?MALFORMED ?request)
  :assert (false)
  :why "{?request} holds something that is not a number: the theory cannot read it")

(rule
  std.math.positional.undeclared-is-false
  (?UNDECLARED)
  :match (?UNDECLARED ?x ?request)
  :assert (false)
  :why "{?request} uses the name {?x}, which names no number")

(macro
  std.math.positional.positional
  (
    ?OPERAND
    ?OPERAND-IS
    ?N
    ?LET
    ?NAMED
    ?ADD-WALK
    ?FA
    ?B
    ?STRIP
    ?TURN
    ?NZ
    ?DONE
    ?ADD
    ?ADD-FIRST
    ?ADD-SECOND
    ?SUM
    ?SUM-OF
    ?SUB-WALK
    ?FS
    ?SHORT
    ?SUB
    ?SUB-FIRST
    ?SUB-SECOND
    ?DIFFERENCE
    ?SHORTFALL
    ?DIFF-OF
    ?CMP-WALK
    ?CL
    ?ORDER-IS
    ?CMP
    ?CMP-FIRST
    ?CMP-SECOND
    ?ORDER
    ?CMP-OF
    ?TOP-FIRST
    ?TOP-FIRST-IS
