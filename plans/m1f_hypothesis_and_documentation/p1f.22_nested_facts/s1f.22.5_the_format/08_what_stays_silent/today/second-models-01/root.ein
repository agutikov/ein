  std.math.decimal-arith.div-try-5
  ()
  :match (and (std.math.decimal-arith.div-choose ?k (std.math.decimal-arith.multiples ?m1 ?m2 ?m3 ?m4 ?m5 ?m6 ?m7 ?m8 ?m9) ?rest ?w ?u ?lo ?hi ?left) (std.math.digits.mid ?lo ?hi 5))
  :assert (std.math.decimal-arith.sub-walk (std.math.decimal-arith.div-trial ?k (std.math.decimal-arith.multiples ?m1 ?m2 ?m3 ?m4 ?m5 ?m6 ?m7 ?m8 ?m9) ?rest ?w ?u ?lo ?hi ?left 5) ?u ?m5 0 z)
