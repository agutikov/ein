    ?DIV-DONE
    ?DIV
    ?DIV-FIRST
    ?DIV-SECOND
    ?DIV-CALL
    ?QUOTIENT
    ?QUOT-OF
    ?DIV-M1
    ?BAD-OPERAND
    ?NOT-A-NUMBER
    ?MALFORMED
    ?BAD-REQUEST
    ?NO-LET
    ?UNDECLARED)
  (and
    (std.math.positional.operand-zero ?OPERAND ?OPERAND-IS)
    (std.math.positional.operand-number ?OPERAND ?N ?OPERAND-IS)
    (std.math.positional.let-named ?LET ?NAMED)
    (std.math.positional.operand-name ?OPERAND ?NAMED ?LET ?OPERAND-IS)
    (std.math.positional.add-column ?ADD-WALK ?N ?FA ?B)
    (std.math.positional.add-column-first ?ADD-WALK ?N ?FA ?B)
    (std.math.positional.add-column-second ?ADD-WALK ?N ?FA ?B)
    (std.math.positional.add-end ?ADD-WALK ?STRIP)
    (std.math.positional.add-carry-out ?ADD-WALK ?TURN ?B)
    (std.math.positional.strip-zero ?STRIP ?B)
    (std.math.positional.strip-top ?STRIP ?B ?NZ ?TURN)
    (std.math.positional.strip-none ?STRIP ?DONE)
    (std.math.positional.turn-step ?TURN ?B ?N)
    (std.math.positional.turn-end ?TURN ?DONE)
    (std.math.positional.add-ask ?ADD ?OPERAND ?ADD-FIRST)
    (std.math.positional.add-ask-second
      ?OPERAND-IS
      ?ADD-FIRST
      ?OPERAND
      ?ADD-SECOND)
    (std.math.positional.add-start ?OPERAND-IS ?ADD-SECOND ?ADD-WALK ?SUM)
    (std.math.positional.add-answer ?DONE ?SUM ?SUM-OF)
    (std.math.positional.sub-column ?SUB-WALK ?N ?FS ?B)
    (std.math.positional.sub-column-first ?SUB-WALK ?N ?FS ?B)
    (std.math.positional.sub-column-second ?SUB-WALK ?N ?FS ?B)
    (std.math.positional.sub-end ?SUB-WALK ?STRIP)
    (std.math.positional.sub-borrow-out ?SUB-WALK ?SHORT)
    (std.math.positional.sub-ask ?SUB ?OPERAND ?SUB-FIRST)
    (std.math.positional.sub-ask-second
      ?OPERAND-IS
      ?SUB-FIRST
      ?OPERAND
      ?SUB-SECOND)
    (std.math.positional.sub-start
      ?OPERAND-IS
      ?SUB-SECOND
      ?SUB-WALK
      ?DIFFERENCE
      ?SHORTFALL)
    (std.math.positional.sub-answer ?DONE ?DIFFERENCE ?DIFF-OF)
    (std.math.positional.sub-answer-short ?DONE ?SHORTFALL ?DIFF-OF)
    (std.math.positional.cmp-column ?CMP-WALK ?N ?CL)
    (std.math.positional.cmp-column-first ?CMP-WALK ?N ?CL)
    (std.math.positional.cmp-column-second ?CMP-WALK ?N ?CL)
    (std.math.positional.cmp-end ?CMP-WALK ?ORDER-IS)
    (std.math.positional.cmp-ask ?CMP ?OPERAND ?CMP-FIRST)
    (std.math.positional.cmp-ask-second
      ?OPERAND-IS
      ?CMP-FIRST
      ?OPERAND
      ?CMP-SECOND)
    (std.math.positional.cmp-start ?OPERAND-IS ?CMP-SECOND ?CMP-WALK ?ORDER)
    (std.math.positional.cmp-answer ?ORDER-IS ?ORDER ?CMP-OF)
    (std.math.positional.top-first-step ?TOP-FIRST ?N ?B)
    (std.math.positional.top-first-end ?TOP-FIRST ?TOP-FIRST-IS)
    (std.math.positional.mul-turn ?MUL-CALL ?TOP-FIRST ?MUL-DIGITS)
    (std.math.positional.mul-begin ?TOP-FIRST-IS ?MUL-DIGITS ?MUL-STEP)
    (std.math.positional.mul-next ?DONE ?MUL-SUM ?MUL-STEP)
    (std.math.positional.mul-end ?MUL-STEP ?DONE)
    (std.math.positional.mul-ask ?MUL ?OPERAND ?MUL-FIRST)
    (std.math.positional.mul-ask-second
      ?OPERAND-IS
      ?MUL-FIRST
      ?OPERAND
      ?MUL-SECOND)
    (std.math.positional.mul-start ?OPERAND-IS ?MUL-SECOND ?MUL-CALL ?PRODUCT)
    (std.math.positional.mul-answer ?DONE ?PRODUCT ?PRODUCT-OF)
    (std.math.positional.div-begin ?TOP-FIRST-IS ?DIV-DIGITS ?DIV-STEP)
    (std.math.positional.div-end ?DIV-STEP ?DIV-DONE)
    (std.math.positional.div-ask ?DIV ?OPERAND ?DIV-FIRST)
    (std.math.positional.div-ask-second
      ?OPERAND-IS
      ?DIV-FIRST
      ?OPERAND
      ?DIV-SECOND)
    (std.math.positional.div-start ?OPERAND-IS ?DIV-SECOND ?DIV-CALL ?QUOTIENT)
    (std.math.positional.div-answer ?DIV-DONE ?QUOTIENT ?QUOT-OF)
    (std.math.positional.div-by-zero ?DONE ?DIV-M1 ?QUOTIENT ?DIV)
    (std.math.positional.div-call-by-zero ?DONE ?DIV-M1 ?DIV-CALL)
    (std.math.positional.operand-digit
      ?OPERAND
      ?NZ
      ?BAD-OPERAND
      ?NOT-A-NUMBER
      ?N)
    (std.math.positional.operand-digit-zero ?OPERAND ?BAD-OPERAND ?NOT-A-NUMBER)
    (std.math.positional.let-twice ?LET ?MALFORMED)
    (std.math.positional.let-zero ?LET ?MALFORMED)
    (std.math.positional.let-digit ?LET ?NZ ?MALFORMED)
    (std.math.positional.let-digit-zero ?LET ?MALFORMED)
    (std.math.positional.let-to-name ?LET ?NAMED ?MALFORMED)
    (std.math.positional.let-to-digit ?LET ?NZ ?MALFORMED ?N)
    (std.math.positional.let-to-digit-zero ?LET ?MALFORMED)
    (std.math.positional.bad-add-first
      ?BAD-OPERAND
      ?ADD-FIRST
      ?BAD-REQUEST
      ?ADD)
    (std.math.positional.bad-add-second
      ?BAD-OPERAND
      ?ADD-SECOND
      ?BAD-REQUEST
      ?ADD)
    (std.math.positional.bad-sub-first
      ?BAD-OPERAND
      ?SUB-FIRST
      ?BAD-REQUEST
      ?SUB)
    (std.math.positional.bad-sub-second
      ?BAD-OPERAND
      ?SUB-SECOND
      ?BAD-REQUEST
      ?SUB)
    (std.math.positional.bad-cmp-first
      ?BAD-OPERAND
      ?CMP-FIRST
      ?BAD-REQUEST
      ?CMP)
    (std.math.positional.bad-cmp-second
      ?BAD-OPERAND
      ?CMP-SECOND
      ?BAD-REQUEST
      ?CMP)
    (std.math.positional.bad-mul-first
      ?BAD-OPERAND
      ?MUL-FIRST
      ?BAD-REQUEST
      ?MUL)
    (std.math.positional.bad-mul-second
      ?BAD-OPERAND
      ?MUL-SECOND
      ?BAD-REQUEST
      ?MUL)
    (std.math.positional.bad-div-first
      ?BAD-OPERAND
      ?DIV-FIRST
      ?BAD-REQUEST
      ?DIV)
    (std.math.positional.bad-div-second
