(rule
  bijective-properties
  ()
  :match (bijective ?R)
  :assert (and (functional ?R) (injective ?R) (total ?R) (surjective ?R))
  :why "{?R} is bijective ⟹ functional ∧ injective ∧ total ∧ surjective.")

(rule
  functional
  (?R)
  :match (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why "{?R} not functional: {?a} has both {?b} and {?c}.")

(rule
  injective
  (?R)
  :match (and (?R ?a ?c) (?R ?b ?c) (neq ?a ?b))
  :assert (false)
  :why "{?R} not injective: {?c} from both {?a} and {?b}.")

(rule
  injective-negative
  (?R)
  :match (and (?R ?a ?b) (relation ?R ?A ?B) (is-a ?a_other ?A) (neq ?a_other ?a))
  :assert (not (?R ?a_other ?b))
  :why "{?R} injective: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a_other} {?b})).")

(hrule
  guess
  (?R ?T1 ?T2)
  :match (and (is-a ?a ?T1) (is-a ?b ?T2))
  :assert (?R ?a ?b)
  :why "guess: ({?R} {?a} {?b})?")

(relation is-a T T :why "{?1} is a {?2}")

(relation color-loc Color House :why "{?2} is painted {?1}")

(bijective color-loc)

(is-a Color T)

(is-a House T)

(is-a Red Color)

(is-a Green Color)

(is-a Blue Color)

(is-a H1 House)

(is-a H2 House)

(is-a H3 House)

(color-loc Red H2 :source "(1) Red is in house 2")

(color-loc Green H3 :source "(2) Green is in house 3")

(solve :hrules (guess (color-loc Color House)))

(query :goal (color-loc Blue ?h))

(bijective color-loc)

(color-loc Blue H1)

(color-loc Green H3)

(color-loc Red H2)

(functional color-loc)

(injective color-loc)

(is-a Blue Color)

(is-a Color T)

(is-a Green Color)

(is-a H1 House)

(is-a H2 House)

(is-a H3 House)

(is-a House T)

(is-a Red Color)

(surjective color-loc)

(total color-loc)
;; ── the state ──────────────────────────────────────────────────────────

(bijective color-loc)
(color-loc Blue H1) ; H1 is painted Blue
(color-loc Green H3) ; source "(2) Green is in house 3" — H3 is painted Green
(color-loc Red H2) ; source "(1) Red is in house 2" — H2 is painted Red
(functional color-loc)
(injective color-loc)
(is-a Blue Color) ; Blue is a Color
(is-a Color T) ; Color is a T
(is-a Green Color) ; Green is a Color
(is-a H1 House) ; H1 is a House
(is-a H2 House) ; H2 is a House
(is-a H3 House) ; H3 is a House
(is-a House T) ; House is a T
(is-a Red Color) ; Red is a Color
(surjective color-loc)
(total color-loc)
