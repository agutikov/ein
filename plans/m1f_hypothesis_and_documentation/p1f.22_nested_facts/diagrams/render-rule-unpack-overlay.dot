digraph rule_trust_equalities_overlay {
  label="trust-equalities"; labelloc=t;
  ranksep=0.55;
  "?p" [label="?p", shape=diamond];
  "?a" [label="?a", shape=diamond];
  "?b" [label="?b", shape=diamond];
  subgraph cluster_ctx_o_0 {
    label="think ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
    "(= ?a ?b)" [shape=octagon, label="=", color="#2ca02c", fontcolor="#2ca02c", style="filled,dashed", fillcolor="#d9d9d9"];
  }
  "h1_reliable" [shape=octagon, label="reliable", color="#2ca02c", fontcolor="#2ca02c"];
  "h1_reliable" -> "?p" [label="1", color="#2ca02c"];
  "?p" -> "(= ?a ?b)" [label="think", color="#17becf", fontcolor="#17becf"];
  "(= ?a ?b)" -> "?a" [label="1", color="#2ca02c"];
  "(= ?a ?b)" -> "?b" [label="2", color="#2ca02c"];
}
