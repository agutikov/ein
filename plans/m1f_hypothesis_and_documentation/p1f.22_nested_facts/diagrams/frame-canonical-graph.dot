digraph frame_canonical_graph {
  rankdir=TB; forcelabels=true; nodesep=0.35; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  "owns"; "lives-in"; "left-of";
  subgraph cluster_K { label="K"; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#555555"; style=rounded; color="#555555";
    node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
    f1 [xlabel="f1"]; f2 [xlabel="f2"]; f3 [xlabel="f3"]; f4 [xlabel="f4"];
  }
  "owns" -> f1 [label="1", dir=back]; f1 -> "Norwegian" [label="2"]; f1 -> "Dog" [label="3"];
  "lives-in" -> f2 [label="1", dir=back]; f2 -> "Norwegian" [label="2"]; f2 -> "House-1" [label="3"];
  "left-of" -> f3 [label="1", dir=back]; f3 -> "House-1" [label="2"]; f3 -> "House-2" [label="3"];
  "left-of" -> f4 [label="1", dir=back]; f4 -> "House-2" [label="2"]; f4 -> "House-3" [label="3"];
}
