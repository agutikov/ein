digraph rule_ctx_contradiction_lhs_rhs {
  rankdir=TB;
  label="ctx-contradiction"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?C ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(not (?R ?a ?b))_L" [shape=octagon, label="not", color="#d62728", fontcolor="#d62728"];
    }
    subgraph cluster_ctx_L_1 {
      label="?C, not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?b)_L" [shape=octagon, label="?R", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "?p_L" -> "(?R ?a ?b)_L" [label="?C", color="#8c564b", fontcolor="#8c564b"];
    "?p_L" -> "(not (?R ?a ?b))_L" [label="?C", color="#8c564b", fontcolor="#8c564b"];
    "(?R ?a ?b)_L" -> "?a_L" [label="1", color="#1f77b4"];
    "(?R ?a ?b)_L" -> "?b_L" [label="2", color="#1f77b4"];
    "(not (?R ?a ?b))_L" -> "(?R ?a ?b)_L" [label="1", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "?p_R" [label="?p", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?C ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(false)_R" [shape=octagon, label="false", color="#2ca02c", fontcolor="#2ca02c"];
    }
    "?p_R" -> "(false)_R" [label="?C", color="#8c564b", fontcolor="#8c564b", style=dashed];
  }
}
