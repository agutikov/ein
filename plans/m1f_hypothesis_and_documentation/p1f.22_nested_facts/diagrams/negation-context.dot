digraph negation_context {
  rankdir=TB; nodesep=0.45; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "think"; "not"; "="; "+"; }
  { rank=max; "Alice"; "5"; "2"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  t [xlabel="t"];
  n [xlabel="n"];
  e [xlabel="e", style=solid];
  s [xlabel="s", style=solid];
  { rank=same; t; n; }
  t -> "think" [label="1"];
  t -> "Alice" [label="2"];
  t -> e [label="3"];
  n -> "not" [label="1"];
  n -> e [label="2"];
  e -> "=" [label="1"];
  e -> "5" [label="2"];
  e -> s [label="3"];
  s -> "+" [label="1"];
  s -> "2" [label="2"];
  s -> "2" [label="3"];
}
