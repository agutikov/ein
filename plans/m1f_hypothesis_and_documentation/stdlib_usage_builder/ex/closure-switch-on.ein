(import std.algebra :symbols (functional))
(import std.closure)

(relation is-a  T T          :why "{?1} is a {?2}")
(relation wears Agent Colour :why "{?1} wears {?2}")

(is-a Ann Agent)  (is-a Bob Agent)
(is-a Red Colour) (is-a Green Colour)

(bijective wears)
(wears Ann Red)

(query :goal (wears ?who ?colour))
