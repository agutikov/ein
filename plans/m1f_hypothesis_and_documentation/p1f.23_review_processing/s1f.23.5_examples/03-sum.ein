;; S1f.23.5, task 1, program 3: a calculator program, the second request of
;; examples/arith/add.ein alone, 17 + 5 under two names. Every relation the trace
;; reads a statement from is declared by the standard library
;; (std.math.decimal, std.math.decimal-arith); the program declares none.

(import std.math.decimal-arith :symbols (decimal-arith add let sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let apples (n (n z 1) 7))
(let pears  (n z 5))
(add apples pears)

(query :goal (sum-of apples pears ?fruit)
       :goal-text "there are {?fruit} pieces of fruit"
       :expect (model (sum-of apples pears (n (n z 2) 2))))
