;;; S1f.23.7 task 1 — the user's slice by a rule: a parameter names the fact's relation, an
;;; activator a relation the slice reads, one rule per count and place of the relation.
;;; The slice is the relation in-slice; the activators are facts about relations too.

(relation lives    Person House :why "{?3} lives in {?4}")
(relation next-to  House House  :why "{?3} is next to {?4}")
(relation right-of House House  :why "{?3} is right of {?4}")
(relation includes Rel Rel      :why "every {?3} fact is a {?4} fact")

(symmetric next-to)
(includes right-of next-to)
(co-located lives Ann lives Bob :source "condition (2)")
(lives Ann H1) (right-of H2 H1)

;; one argument, the relation in it
(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of the relation {?r}")
;; two arguments, a relation in either (an or is a whole :match)
(rule about-2 (?F)
  :match  (or (and (?F ?x ?y) (relation ?x)) (and (?F ?x ?y) (relation ?y)))
  :assert (in-slice-2 ?F ?x ?y)
  :why    "{?F} says something of {?x} or {?y}")
;; four arguments, a relation first or third
(rule about-4 (?F)
  :match  (or (and (?F ?a ?b ?c ?d) (relation ?a)) (and (?F ?a ?b ?c ?d) (relation ?c)))
  :assert (in-slice-4 ?F ?a ?b ?c ?d)
  :why    "{?F} says something of {?a} or {?c}")

(about-1 symmetric)
(about-2 includes)
(about-4 co-located)

(solve :no-search)

(query :goal (in-slice-1 ?f ?r))
(query :goal (in-slice-2 ?f ?x ?y))
(query :goal (in-slice-4 ?f ?a ?b ?c ?d))
(query :goal (about-1 ?f))
