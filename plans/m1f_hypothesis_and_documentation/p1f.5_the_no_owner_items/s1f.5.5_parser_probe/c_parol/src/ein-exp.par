%start Program
%title "Ein by position"
%line_comment ";"
%block_comment "#\|" "\|#"

%%

/*   0 */ Program: ProgramList /* Vec */;
/*   1 */ ProgramList /* Vec<T>::Push */: Form ProgramList;
/*   2 */ ProgramList /* Vec<T>::New */: ;
/*   3 */ Form: Lp FormBody Rp;
/*   4 */ FormBody: Relation;
/*   5 */ FormBody: Rule;
/*   6 */ FormBody: Hrule;
/*   7 */ FormBody: Query;
/*   8 */ FormBody: Solve;
/*   9 */ FormBody: Config;
/*  10 */ FormBody: Trace;
/*  11 */ FormBody: Macro;
/*  12 */ FormBody: Import;
/*  13 */ FormBody: NotFact;
/*  14 */ FormBody: Fact;
/*  15 */ FormBody: Refused;
/*  16 */ Refused: Underscore;
/*  17 */ Refused: Bad;
/*  18 */ Refused: BadText;
/*  19 */ Lp: '(';
/*  20 */ Rp: ')';
/*  21 */ WRelation: 'relation';
/*  22 */ WRule: 'rule';
/*  23 */ WHrule: 'hrule';
/*  24 */ WQuery: 'query';
/*  25 */ WSolve: 'solve';
/*  26 */ WConfig: 'config';
/*  27 */ WTrace: 'trace';
/*  28 */ WMacro: 'macro';
/*  29 */ WImport: 'import';
/*  30 */ WNot: 'not';
/*  31 */ WAnd: 'and';
/*  32 */ WOr: 'or';
/*  33 */ WNeq: 'neq';
/*  34 */ WStep: 'step';
/*  35 */ KWhy: ':why';
/*  36 */ KSource: ':source';
/*  37 */ KGoalText: ':goal-text';
/*  38 */ KMatch: ':match';
/*  39 */ KAssert: ':assert';
/*  40 */ KPriority: ':priority';
/*  41 */ KGoal: ':goal';
/*  42 */ KExpect: ':expect';
/*  43 */ KOver: ':over';
/*  44 */ KNoHyp: ':no-hypothesis';
/*  45 */ KHrules: ':hrules';
/*  46 */ KHypRels: ':hypothesis-relations';
/*  47 */ KSymbols: ':symbols';
/*  48 */ KAs: ':as';
/*  49 */ KRule: ':rule';
/*  50 */ KUsing: ':using';
/*  51 */ KDerives: ':derives';
/*  52 */ Underscore: '_';
/*  53 */ Digits: /[0-9]+/;
/*  54 */ Word: /[!$%&'*+,\-.\/0-9<=>@A-Z\[\\\]^_`a-z{}~]+/;
/*  55 */ Var: /\?[!$%&'*+,\-.\/0-9<=>@A-Z\[\\\]^_`a-z{}~]+/;
/*  56 */ Keyword: /:[!$%&'*+,\-.\/0-9<=>@A-Z\[\\\]^_`a-z{}~]+/;
/*  57 */ Text: /"(\\[^\n]|[^"\\])*"/;
/*  58 */ Bad: /[^\s();\x{1c}-\x{1f}]+/;
/*  59 */ BadText: /"(\\[^\n]|[^"\\])*"[^\s();\x{1c}-\x{1f}]+/;
/*  60 */ Name: Word;
/*  61 */ Name: Digits;
/*  62 */ Name: WRelation;
/*  63 */ Name: WStep;
/*  64 */ Head: Word;
/*  65 */ Head: Digits;
/*  66 */ Head: WStep;
/*  67 */ Names: Lp NamesList /* Vec */ Rp;
/*  68 */ NamesList /* Vec<T>::Push */: Name NamesList;
/*  69 */ NamesList /* Vec<T>::New */: ;
/*  70 */ Params: Lp ParamsList /* Vec */ Rp;
/*  71 */ ParamsList /* Vec<T>::Push */: Var ParamsList;
/*  72 */ ParamsList /* Vec<T>::New */: ;
/*  73 */ Params1: Lp Var Params1List /* Vec */ Rp;
/*  74 */ Params1List /* Vec<T>::Push */: Var Params1List;
/*  75 */ Params1List /* Vec<T>::New */: ;
/*  76 */ HruleItem: Name;
/*  77 */ HruleItem: Names;
/*  78 */ Hrules: Lp HrulesList /* Vec */ Rp;
/*  79 */ HrulesList /* Vec<T>::Push */: HruleItem HrulesList;
/*  80 */ HrulesList /* Vec<T>::New */: ;
/*  81 */ Using: Lp UsingBody Rp;
/*  82 */ UsingBody: UsingBodyList /* Vec */;
/*  83 */ UsingBodyList /* Vec<T>::Push */: Name UsingBodyList;
/*  84 */ UsingBodyList /* Vec<T>::New */: ;
/*  85 */ UsingBody: WAnd Name UsingBodyList0 /* Vec */;
/*  86 */ UsingBodyList0 /* Vec<T>::Push */: Name UsingBodyList0;
/*  87 */ UsingBodyList0 /* Vec<T>::New */: ;
/*  88 */ TArg: Var;
/*  89 */ TArg: Term;
/*  90 */ Relation: WRelation Name RelationList /* Vec */ RelationList0 /* Vec */;
/*  91 */ RelationList0 /* Vec<T>::Push */: KWhy Text RelationList0;
/*  92 */ RelationList0 /* Vec<T>::New */: ;
/*  93 */ RelationList /* Vec<T>::Push */: Name RelationList;
/*  94 */ RelationList /* Vec<T>::New */: ;
/*  95 */ RuleClause: KMatch Term;
/*  96 */ RuleClause: KAssert Term;
/*  97 */ RuleClause: KWhy Text;
/*  98 */ RuleClause: KPriority Digits;
/*  99 */ Rule: WRule Name Params RuleList /* Vec */;
/* 100 */ RuleList /* Vec<T>::Push */: RuleClause RuleList;
/* 101 */ RuleList /* Vec<T>::New */: ;
/* 102 */ Hrule: WHrule Name Params HruleList /* Vec */;
/* 103 */ HruleList /* Vec<T>::Push */: RuleClause HruleList;
/* 104 */ HruleList /* Vec<T>::New */: ;
/* 105 */ QueryClause: KGoal Term;
/* 106 */ QueryClause: KGoalText Text;
/* 107 */ QueryClause: KExpect Term;
/* 108 */ QueryClause: KOver Name;
/* 109 */ QueryClause: KNoHyp Names;
/* 110 */ Query: WQuery QueryClause QueryList /* Vec */;
/* 111 */ QueryList /* Vec<T>::Push */: QueryClause QueryList;
/* 112 */ QueryList /* Vec<T>::New */: ;
/* 113 */ SolveClause: KExpect Term;
/* 114 */ SolveClause: KNoHyp Names;
/* 115 */ SolveClause: KHrules Hrules;
/* 116 */ SolveClause: KHypRels Names;
/* 117 */ Solve: WSolve SolveList /* Vec */;
/* 118 */ SolveList /* Vec<T>::Push */: SolveClause SolveList;
/* 119 */ SolveList /* Vec<T>::New */: ;
/* 120 */ Config: WConfig ConfigList /* Vec */;
/* 121 */ ConfigList /* Vec<T>::Push */: Keyword Name ConfigList;
/* 122 */ ConfigList /* Vec<T>::New */: ;
/* 123 */ StepClause: KRule Name;
/* 124 */ StepClause: KUsing Using;
/* 125 */ StepClause: KDerives FactTerm;
/* 126 */ Step: Lp WStep Name StepList /* Vec */ Rp;
/* 127 */ StepList /* Vec<T>::Push */: StepClause StepList;
/* 128 */ StepList /* Vec<T>::New */: ;
/* 129 */ Trace: WTrace TraceList /* Vec */;
/* 130 */ TraceList /* Vec<T>::Push */: Step TraceList;
/* 131 */ TraceList /* Vec<T>::New */: ;
/* 132 */ Macro: WMacro Name Params1 Term;
/* 133 */ ImportClause: KSymbols Names;
/* 134 */ ImportClause: KAs Name;
/* 135 */ Import: WImport Name ImportList /* Vec */;
/* 136 */ ImportList /* Vec<T>::Push */: ImportClause ImportList;
/* 137 */ ImportList /* Vec<T>::New */: ;
/* 138 */ FactClause: KSource Text;
/* 139 */ FactClause: KRule Name;
/* 140 */ FactClause: KUsing Using;
/* 141 */ NotFact: WNot FactTerm NotFactList /* Vec */;
/* 142 */ NotFactList /* Vec<T>::Push */: FactClause NotFactList;
/* 143 */ NotFactList /* Vec<T>::New */: ;
/* 144 */ Fact: Head FactList /* Vec */ FactList0 /* Vec */;
/* 145 */ FactList0 /* Vec<T>::Push */: FactClause FactList0;
/* 146 */ FactList0 /* Vec<T>::New */: ;
/* 147 */ FactList /* Vec<T>::Push */: FactArg FactList;
/* 148 */ FactList /* Vec<T>::New */: ;
/* 149 */ FactArg: Name;
/* 150 */ FactArg: FactTerm;
/* 151 */ FactTerm: Lp Name FactTermList /* Vec */ Rp;
/* 152 */ FactTermList /* Vec<T>::Push */: FactArg FactTermList;
/* 153 */ FactTermList /* Vec<T>::New */: ;
/* 154 */ Term: Lp TermBody Rp;
/* 155 */ TermBody: WAnd TArg TermBodyList /* Vec */;
/* 156 */ TermBodyList /* Vec<T>::Push */: TArg TermBodyList;
/* 157 */ TermBodyList /* Vec<T>::New */: ;
/* 158 */ TermBody: WOr TArg TermBodyList0 /* Vec */;
/* 159 */ TermBodyList0 /* Vec<T>::Push */: TArg TermBodyList0;
/* 160 */ TermBodyList0 /* Vec<T>::New */: ;
/* 161 */ TermBody: WNot TArg;
/* 162 */ TermBody: WNeq Item Item;
/* 163 */ TermBody: PHead TermBodyList1 /* Vec */;
/* 164 */ TermBodyList1 /* Vec<T>::Push */: Item TermBodyList1;
/* 165 */ TermBodyList1 /* Vec<T>::New */: ;
/* 166 */ PHead: Name;
/* 167 */ PHead: Var;
/* 168 */ Item: Name;
/* 169 */ Item: Var;
/* 170 */ Item: Term;
