Program ::= Form*
Form ::= Relation | Rule | Hrule | Query | Solve | Config | Trace | Macro | Import | NotFact | Fact
Name ::= WORD | DIGITS | 'relation' | 'step'
Head ::= WORD | DIGITS | 'step'
Var ::= VAR
Text ::= TEXT
Count ::= DIGITS
W[K,T] ::= K
Cl[K,V] ::= K V
Names ::= '(' Name* ')'
HruleItem ::= Name | Names
Hrules ::= '(' HruleItem* ')'
Using ::= Names | '(' W[and,()] Name+ ')'
TArg ::= Var | Term
Params ::= '(' Var* ')'
Params1 ::= '(' Var+ ')'
Relation ::= '(' W[relation,()] Name Name* Cl[:why,Text]* ')'
RuleClause ::= Cl[:match,Term] | Cl[:assert,Term] | Cl[:why,Text] | Cl[:priority,Count]
Rule ::= '(' W[rule,()] Name Params RuleClause* ')'
Hrule ::= '(' W[hrule,()] Name Params RuleClause* ')'
QueryClause ::= Cl[:goal,Term] | Cl[:goal-text,Text] | Cl[:expect,Term] | Cl[:over,Name] | Cl[:no-hypothesis,Names]
Query ::= '(' W[query,()] QueryClause+ ')'
SolveClause ::= Cl[:expect,Term] | Cl[:no-hypothesis,Names] | Cl[:hrules,Hrules] | Cl[:hypothesis-relations,Names]
Solve ::= '(' W[solve,()] SolveClause* ')'
ConfigPair ::= KEYWORD Name
Config ::= '(' W[config,()] ConfigPair* ')'
StepClause ::= Cl[:rule,Name] | Cl[:using,Using] | Cl[:derives,FactTerm]
Step ::= '(' W[step,()] Name StepClause* ')'
Trace ::= '(' W[trace,()] Step* ')'
Macro ::= '(' W[macro,()] Name Params1 Term ')'
ImportClause ::= Cl[:symbols,Names] | Cl[:as,Name]
Import ::= '(' W[import,()] Name ImportClause* ')'
FactClause ::= Cl[:source,Text] | Cl[:rule,Name] | Cl[:using,Using]
NotFact ::= '(' W[not,()] FactTerm FactClause* ')'
Fact ::= '(' Head FactArg* FactClause* ')'
FactArg ::= Name | FactTerm
FactTerm ::= '(' Name FactArg* ')'
Term ::= '(' W[and,()] TArg+ ')' | '(' W[or,()] TArg+ ')' | '(' W[not,()] TArg ')' | '(' W[neq,()] Item Item ')' | '(' PHead Item* ')'
PHead ::= Name | Var
Item ::= Name | Var | Term
