+/// Ein's patch (F11): recovery is bounded by a count of search steps over the whole parse, not by
+/// the wall clock, so the same input reports the same errors on every machine.
+pub const RECOVERY_STEP_BUDGET: u64 = 1_000_000;
+
+/// The steps recovery may still take in this parse.
+pub(super) struct Budget { left: std::cell::Cell<u64> }
+impl Budget {
+    /// Takes one step; true once none is left.
+    pub(super) fn spent(&self) -> bool {
+        let l = self.left.get();
+        if l == 0 { return true; }
+        self.left.set(l - 1);
+        false
+    }
+}
+// Probe only: report the steps one parse's recovery took.
+impl Drop for Budget {
+    fn drop(&mut self) {
+        if std::env::var_os("EIN_PROBE_STEPS").is_some() && self.left.get() < RECOVERY_STEP_BUDGET {
+            eprintln!("recovery steps {}", RECOVERY_STEP_BUDGET - self.left.get());
+        }
+    }
+}
 
