;;; Q-M1f.406 (c)'s case, written for this review: 5 - 5 is zero, `z`, which
;;; the subtraction hands over by `strip-none` (no digit left) and not by a
;;; turn, so `turn-end` does not label it. Today `(valid z)` is held anyway,
;;; by `std.math.decimal`'s closing rule, in every program that imports the
;;; module; under (c), `z` would be labelled only where a walk makes it, as
;;; here, or a check reaches it. The claims are the answer under both engines.

(import std.math.decimal-arith :symbols (decimal-arith sub diff-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(sub (n z 5) (n z 5))

(solve :expect (region (model)))

(query :goal (diff-of ?x ?y ?d ?r)
       :goal-text "{?x} - {?y} = {?d}, short by {?r}"
       :expect (model (diff-of (n z 5) (n z 5) z z)))
