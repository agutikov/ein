;;; Q-M1f.409 (c)'s case, written for this review: an integer whose positive
;;; part is the digit 7 where a natural number, `(n z 7)`, goes. Today the
;;; shape rule `int-p-digit` reads `(int-check (int 7 z))` and flags it; under
;;; (c) the shapes would be left unchecked and the request answered by silence.
;;; The claim is today's answer. It is also finding L-101's witness
;;; (`../29-L-101/`).

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (int 7 z) (int (n z 1) z))

(solve :expect (false))
