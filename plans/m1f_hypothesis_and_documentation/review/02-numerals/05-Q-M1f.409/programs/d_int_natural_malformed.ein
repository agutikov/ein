;;; Q-M1f.409 (d)'s twin, written for this review: where an integer goes, a
;;; malformed natural number is flagged, `(int-add (n z x) I)`, because
;;; `std.math.decimal-arith`'s look-up finds the number and `operand-check`
;;; asks its check. Dead before and today. The claim is today's answer.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (n z x) (int (n z 1) z))

(solve :expect (false))
