;;; `std.math.decimal` — a malformed numeral written whole in a rule's conclusion that never fires.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A numeral is checked where an operation takes it (Q-M1f.404). Here the
;;; request that would take it is the conclusion of a rule that never fires,
;;; nothing being a seed: `(n 0 3)` ends in the digit `0` where `z` goes, and
;;; since no request holds it, nothing asks whether it is a number, and
;;; `numeral-prefix-zero` does not fire. The sum beside it is answered. The
;;; rule's twin that fires is `07_in_a_rules_conclusion_that_fires.ein`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (region (model)))`: R is {∅}, root alive and owing
;;; nothing, the sum is answered, and `not-decimal`'s extent is empty.

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n not-decimal))
(import std.math.arith :symbols (z))

(relation seed Thing :why "{?1} is a seed")
(__closed__ seed)
(rule ask ()
  :match  (seed ?s)
  :assert (add (n 0 3) (n z 5))
  :why    "{?s} asks for 3 + 5, the 3 written with a zero where z goes")
(add (n z 4) (n z 3))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 4) (n z 3) (n z 7))))

(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))
