;;; Q-M1f.410, written for this review: the smallest made number handed on.
;;; 4 + 3 is asked; the program's rule `again` reads the sum and asks for it
;;; plus 5. The sum 7 is labelled `(valid (n z 7))` by `turn-end` as it is
;;; made; as the second request's operand it is asked of the check again and
;;; walked again (`operand-check`, `numeral-step`, `numeral-valid`), deriving
;;; the label it has. No name `valid` is written here, so the program loads
;;; under the engine before Q-M1f.404 too. The claims are the answer under
;;; both.

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(add (n z 4) (n z 3))

(rule again ()
  :match  (sum-of (n z 4) (n z 3) ?s)
  :assert (add ?s (n z 5))
  :why    "the sum {?s} is asked again, plus 5")

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 4) (n z 3) (n z 7))
                      (sum-of (n z 7) (n z 5) (n (n z 1) 2))))
