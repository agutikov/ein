;;; Finding L-101's witness, as the ledger states it: an integer whose
;;; positive part is the digit 7 where a natural number goes. `int-check-parts`
;;; asks `std.math.decimal`'s check of each part whatever it is, so the
;;; knowledge base holds `(check 7 7)`, a check that walks nothing, and
;;; `(check z z)`, whose walk ends at once and derives `(valid z)` a second
;;; time. The shape rule `int-p-digit` flags the 7, and the program is dead.
;;; The claim is the answer.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (int 7 z) (int (n z 1) z))

(solve :expect (false))
