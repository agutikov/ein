;;; L-101, written for this review: a well-formed integer sum, 7 + (-3). Each
;;; integer has a part `z`, and `int-check-parts` asks `(check z z)`, whose
;;; walk is at its end at once: `numeral-valid` derives `(valid z)`, which the
;;; closing rule of `std.math.decimal` holds already. No answer moves. The
;;; claims are the answer.

(import std.math.int :symbols (int-arith int int-add int-sum-of))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (int (n z 7) z) (int z (n z 3)))

(solve :expect (region (model)))

(query :goal (int-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (int-sum-of (int (n z 7) z) (int z (n z 3)) (int (n z 4) z))))
