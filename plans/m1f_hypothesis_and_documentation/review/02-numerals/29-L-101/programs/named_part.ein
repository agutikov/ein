;;; L-101, written for this review: a named constant where an integer's part
;;; goes, `(int price z)`. `int-check-parts` asks `(check price price)`, which
;;; walks nothing; `int-p-named` flags it. The claim is the answer.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let price (n z 5))
(int-add (int price z) (int (n z 1) z))

(solve :expect (false))
