;;; L-101, written for this review: a rational whose numerator is a natural
;;; number, 3, where an integer goes. `rat-check-parts` asks `std.math.int`'s
;;; check of it, `(int-check (n z 3))`, which no rule reads (every rule over
;;; `int-check` reads an `(int P N)`). The operation answers by silence
;;; (Q-M1f.277). The claims are the answer.

(import std.math.rat :symbols (rat-arith rat rat-add rat-sum-of))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(rat-add (rat (n z 3) (n z 2)) (rat (int (n z 1) z) (n z 2)))

(solve :expect (region (model)))

(query :goal (rat-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model))
