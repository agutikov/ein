;;; Q-M1f.405 (a)'s and (d)'s case, written for this review: one numeral, 12,
;;; taken by three requests, written as an operand, as a `let`'s value, and in
;;; a request a rule of the program's own derives. Under (a) the ask
;;; `(check 12 12)`, the walk and the label `(valid 12)` are facts of the
;;; numeral, so 12 is walked once; under (d) it would be walked once a request.
;;; The claims are today's answer (the build at b5fb8d70).

(import std.math.decimal-arith :symbols (decimal-arith let add sum-of))
(import std.math.decimal :symbols (n not-decimal))
(import std.math.arith :symbols (z))

(relation seed Thing :why "{?1} is a seed")
(__closed__ seed)
(seed go)

(let price (n (n z 1) 2))
(add price (n z 3))
(add (n (n z 1) 2) (n z 5))

(rule ask ()
  :match  (seed ?s)
  :assert (add (n z 3) (n (n z 1) 2))
  :why    "{?s} asks for 3 + 12")

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of price (n z 3) (n (n z 1) 5))
                      (sum-of (n (n z 1) 2) (n z 5) (n (n z 1) 7))
                      (sum-of (n z 3) (n (n z 1) 2) (n (n z 1) 5))))
(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))
