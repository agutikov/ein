;;; Q-M1f.405 (e)'s case, written for this review from the S1f.22.6 record:
;;; a program's own theory hands a malformed numeral straight to a tagged
;;; call, `(add-walk TAG X Y C z)`, the interface `std.math.decimal-arith`
;;; offers a theory built on it. `(n z x)` holds `x` where a digit goes.
;;; A call looks nothing up, so no operand is found and no check is asked.
;;; The claims are today's answer (the build at b5fb8d70): root alive, R = {∅},
;;; no answer and no flag. The engine before Q-M1f.404 flagged the numeral
;;; where it was written, and these claims fail under it.

(import std.math.decimal-arith :symbols (decimal-arith add-walk done))
(import std.math.decimal :symbols (n not-decimal))
(import std.math.arith :symbols (z))

(relation mine Thing :why "a sum of {?1}'s own")
(__closed__ mine)

(add-walk (mine a) (n z x) (n z 1) 0 z)

(solve :expect (region (model)))

(query :goal (done ?tag ?s)
       :goal-text "{?tag} is answered {?s}"
       :expect (model))
(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))
