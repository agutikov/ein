;;; One rule a pattern kind, for the drawing of a rule's patterns: a plain pattern, a relation that is a
;;; variable, a stored negation in the match, an absent, a guard, and a pattern under a pattern's arrow.

(relation owns   Person Pet    :why "{?1} owns {?2}")
(relation likes  Person Pet    :why "{?1} likes {?2}")
(relation keeper Person        :why "{?1} keeps a pet")
(relation cool   Person Pet    :why "{?1} is cool about {?2}")

;; a plain pattern: three arrows in the match, two in the conclusion
(rule keeps ()
  :match  (owns ?p ?x)
  :assert (keeper ?p)
  :why    "{?p} owns {?x}, so {?p} keeps a pet.")

;; the relation a variable: the pattern's arrow 1 at the diamond ?rel
(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} and {?b}.")

;; a stored negation in the match, and a guard
(rule owns-unloved ()
  :match  (and (owns ?p ?x) (owns ?q ?y) (neq ?x ?y) (not (likes ?p ?x)))
  :assert (likes ?q ?x)
  :why    "{?p} does not like {?x}, so {?q} likes it.")

;; an absent
(rule cool-owner ()
  :match  (and (owns ?p ?x) (absent (likes ?p ?x)))
  :assert (cool ?p ?x)
  :why    "nothing says {?p} likes {?x}, the pet {?p} owns, so {?p} is cool about it.")

;; a pattern under a pattern's arrow
(rule believed ()
  :match  (claims ?c (owns ?p ?x))
  :assert (likes ?c ?x)
  :why    "{?c} claims {?p} owns {?x}, so {?c} likes {?x}.")

(owns Bob Dog) (owns Carol Cat)
(not (likes Carol Cat))
(claims Dan (owns Eve Fish))

(solve :no-search)
