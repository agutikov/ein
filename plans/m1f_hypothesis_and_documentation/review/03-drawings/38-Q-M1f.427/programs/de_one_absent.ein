;;; std.bijection's domain-elimination written out with ONE absent: (absent (and G (not B))), where the macro's
;;; expansion is (absent (and G (absent (not B)))) (de_expanded.ein). It means something else; it draws the same.
;;; A copy for the drawing only.
(rule de-one-absent (?R ?isa)
  :match  (and (functional ?R) (total ?R)
               (relation ?R ?A ?B)
               (?isa ?a ?A)
               (?isa ?b ?B)
               (absent (and (and (?isa ?b_other ?B) (neq ?b_other ?b))
                            (not (?R ?a ?b_other)))))
  :assert (?R ?a ?b)
  :why    "every {?B} except {?b} excluded for {?a}, so ({?R} {?a} {?b}).")

(solve :no-search)
