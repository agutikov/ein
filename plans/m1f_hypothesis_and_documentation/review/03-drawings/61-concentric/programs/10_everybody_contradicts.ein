;;; 10_everybody_contradicts — a rule carries the contexts' contradictions to
;;; the state.
;;;
;;; `09_false_in_a_context.ein` with one more fact: Cy, too, thinks that four
;;; is two plus two and that it is not. Each person's contradiction is still
;;; only `(false)` in a context, `(think Cy (false))`, and no state is dead
;;; for that. What makes this one dead is the rule `everybody-muddled`, which
;;; concludes the state's own `(false)` where every person contradicts
;;; themself: **a `(false)` in a context reaches the global context by a rule
;;; that says so, and by nothing else**. R is empty.

(import std.macro :symbols (forall))

(relation person  Person       :why "{?3} is a person")
(relation think   Person Claim :why "{?3} thinks that {?4}")
(relation says    Person Claim :why "{?3} says that {?4}")
(relation muddled Person       :why "{?3} contradicts themself")

(person Ann)
(person Bob)
(person Cy)
(__closed__ person)   ; the people are exactly these three

(think Ann (= 5 (+ 2 2)))
(think Ann (not (= 5 (+ 2 2))))
(says Bob (likes Bob Carol))
(says Bob (not (likes Bob Carol)))
(think Cy (= 4 (+ 2 2)))
(think Cy (not (= 4 (+ 2 2))))

(rule contradicts (?C ?R)
  :match  (and (?C ?p (?R ?a ?b)) (?C ?p (not (?R ?a ?b))))
  :assert (?C ?p (false))
  :why    "{?p}: both that {?a} {?R} {?b} and that it is not so")
(contradicts think =)
(contradicts says likes)

(rule muddled-in (?C)
  :match  (?C ?p (false))
  :assert (muddled ?p)
  :why    "what {?p} holds is contradictory")
(muddled-in think)
(muddled-in says)

(rule everybody-muddled ()
  :match  (forall ?p (person ?p) (muddled ?p))
  :assert (false)
  :why    "every person contradicts themself")

(solve :no-search :expect (false))
