;;; A chain of facts of three arrows, for a derivation's drawing folded: right-of is transitive, and
;;; every fact a step reads or concludes is a fact of three arrows that nothing points at.

(relation right-of House House :why "{?1} is right of {?2}")
(relation next-to  House House :why "{?1} is next to {?2}")

(rule transitive ()
  :match  (and (right-of ?a ?b) (right-of ?b ?c))
  :assert (right-of ?a ?c)
  :why    "{?a} is right of {?b}, which is right of {?c}, so {?a} is right of {?c}.")

(rule neighbours ()
  :match  (right-of ?a ?b)
  :assert (next-to ?a ?b)
  :why    "{?a} is right of {?b}, so they are next to each other.")

(right-of H2 H1 :source "clue (1)")
(right-of H3 H2 :source "clue (1)")
(claims Ann (right-of H1 H3))

(solve :no-search)
