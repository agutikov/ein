;;; Every form the program view has a part for, or leaves out: an import and a config (they draw nothing), two
;;; declarations, facts (one with a :source, one written twice, one claimed), two written checks (no fact), a macro
;;; called in an hrule's :match, a rule, an hrule, two queries with :expect, and a (solve …) clause with a list.

(import std.algebra :symbols (symmetric))
(config :record-alternative-justifications false)

(relation owns  Person Pet :why "{?1} owns {?2}")
(relation likes Person Pet :why "{?1} likes {?2}")

(macro claimed (?p ?F) (claims ?p ?F)
  :why "{?p} claims that {?F}")

(owns Bob Dog :source "clue (1)")
(owns Bob Dog)
(claims Carol (owns Carol Cat))
(eq Bob Bob)
(not (eq Bob Carol))

(rule owner-likes ()
  :match  (owns ?p ?x)
  :assert (likes ?p ?x)
  :why    "{?p} owns {?x}, so {?p} likes {?x}")

(hrule guess-owns ()
  :match  (claimed ?p (owns ?p ?x))
  :assert (owns ?p ?x)
  :why    "is the claim true: does {?p} own {?x}?")

(query :goal (likes ?p ?x)
       :goal-text "{?p} likes {?x}"
       :expect (or (model (likes Bob Dog))
                   (model (likes Bob Dog) (likes Carol Cat))))
(query :goal (owns Carol ?x)
       :expect (or (model) (model (owns Carol Cat))))

(solve :hrules (guess-owns))
