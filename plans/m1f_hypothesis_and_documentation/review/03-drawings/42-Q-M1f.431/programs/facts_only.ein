;;; A program with no rule, no import and no macro: the program view's kb digraph is what `ein render kb` draws of
;;; it, but for the fact (relation r) the loader adds beside each declaration with labels.

(relation owns Person Pet :why "{?1} owns {?2}")

(owns Bob Dog :source "clue (1)")
(owns Carol Cat)
(claims Dan (owns Dan Fish))
(not (owns Eve Dog))

(solve :no-search)
