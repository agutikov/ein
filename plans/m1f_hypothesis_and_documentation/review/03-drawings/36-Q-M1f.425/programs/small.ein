;;; A small program for the drawings' review: one of each thing a drawing of facts shows.
;;;   two declarations, a fact of each with a :source, a fact of one argument (two arrows),
;;;   a fact in a context only and a fact both held and claimed, a stored negation,
;;;   a fact that applies a rule, and a fact a rule derives.

(relation owns Person Pet :why "{?1} owns {?2}")
(relation friends Person Person :why "{?1} and {?2} are friends")

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} and {?b}.")

(rule pet-owner ()
  :match  (owns ?p ?x)
  :assert (pet-owner ?p)
  :why    "{?p} owns a pet, so {?p} is a pet owner.")

(owns Bob Dog :source "clue (1)")
(owns Carol Cat)
(friends Bob Carol :source "clue (2)")
(symmetric friends)
(claims Carol (owns Bob Dog))
(claims Dan (owns Dan Fish))
(not (owns Eve Dog))

(solve :no-search)
