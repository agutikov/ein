;;; F21 § "Met again by P1f.22" (finding N-15): *everybody's thoughts are false*,
;;; written as two rules over `absent`, copied from the ledger as written there.
;;; Ann thinks (false); Bob thinks nothing, so Bob is not confused and
;;; `someone-sane` should derive (some-sane), and `all-confused`'s guard
;;; (absent (some-sane)) should then fail.

(person Ann)
(person Bob)
(think Ann (false))
(rule confused () :match (think ?p (false)) :assert (confused ?p) :why "c")
(rule someone-sane () :match (and (person ?p) (absent (think ?p (false)))) :assert (some-sane) :why "s")
(rule all-confused () :match (absent (some-sane)) :assert (false) :why "a")
