;;; F21 § "Met again by P1f.22" (finding N-15): the same sentence written with
;;; `forall`, one rule with one nested absence, copied from the ledger.

(import std.macro :symbols (forall))
(person Ann)
(person Bob)
(think Ann (false))
(rule all-confused ()
  :match  (forall ?p (person ?p) (think ?p (false)))
  :assert (false)
  :why    "everybody's thoughts are false")
