;;; Written for this review: x2b.ein with all-confused concluding a fact,
;;; (all-mad), instead of (false), and nothing else; someone-sane written first.
;;; Neither rule now leads to (false), so both wait in the agenda's second half,
;;; admitted in written order. A query asks whether root holds (all-mad).

(person Ann)
(person Bob)
(think Ann (false))
(rule confused () :match (think ?p (false)) :assert (confused ?p) :why "c")
(rule someone-sane () :match (and (person ?p) (absent (think ?p (false)))) :assert (some-sane) :why "s")
(rule all-confused () :match (absent (some-sane)) :assert (all-mad) :why "a")

(query :goal (all-mad))
