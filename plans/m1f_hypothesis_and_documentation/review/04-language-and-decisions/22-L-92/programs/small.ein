;;; L-92 in small: the three joins the fact index serves differently.
;;;   shares - a join on a name: ?x, an atom, keyed directly.
;;;   trust  - a join one level inside a nested fact: (says ?a (owns ?p ?x)) with ?p and ?x bound,
;;;            keyed at the nested fact's positions.
;;;   agree  - a join on a whole nested fact: ?f bound to (owns Ann Dog); no key has a fact as its
;;;            value, so the second premise walks the held extent of `believes`.

(relation owns P T :why "a {?3} owns a {?4}")
(relation says P F :why "a {?3} says a {?4}")
(relation believes P F :why "a {?3} believes a {?4}")
(relation shares P P :why "a {?3} shares a pet with a {?4}")
(relation trusts P P :why "a {?3} trusts what a {?4} is said to own")
(relation agrees P P :why "a {?3} and a {?4} hold the same fact")

(owns Ann Dog)
(owns Eve Dog)
(says Bob (owns Ann Dog))
(believes Carol (owns Ann Dog))
(says Dan (owns Ann Cat))

(rule shares ()
  :match  (and (owns ?p ?x) (owns ?q ?x) (neq ?p ?q))
  :assert (shares ?p ?q)
  :why    "{?p} and {?q} both own {?x}")

(rule trust ()
  :match  (and (owns ?p ?x) (says ?a (owns ?p ?x)))
  :assert (trusts ?a ?p)
  :why    "{?a} says what {?p} does own")

(rule agree ()
  :match  (and (says ?a ?f) (believes ?b ?f))
  :assert (agrees ?a ?b)
  :why    "{?a} says and {?b} believes the same fact")

(solve :no-search)
