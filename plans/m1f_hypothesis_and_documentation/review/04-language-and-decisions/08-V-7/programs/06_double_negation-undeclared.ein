;;; Written for this review: examples/beliefs/06_double_negation.ein with its
;;; declaration of `=` deleted and nothing else (as the program was first written).

;;; 06_double_negation — the elimination of a double negation, as a rule.
;;;
;;; The negation of a negation is a fact, and it says only that a denial does
;;; not hold. That the fact itself then holds, *not not g, so g*, is a step
;;; of classical logic and **a rule a program states**, not something the
;;; language does by itself. This program states it:
;;;
;;; - **`eliminate`** is one rule for facts of two arguments, the relation a
;;;   parameter: a rule concludes a fact with its relation and its count
;;;   written, so "any fact" is one rule a count, and an activator a relation.
;;;   `(eliminate =)` turns it on for `=` and nothing turns it on for `likes`.
;;; - **`eliminate-in`** is the same rule for what somebody thinks: the same
;;;   patterns, each under `(think ?p …)`. It concludes a fact Bob thinks, and
;;;   nothing about the world.
;;;
;;; So `(= 5 (+ 2 2))` is concluded; `(likes Dan Soup)` is not, though its
;;; double negation is held just the same; and Bob thinks `(= 7 (+ 3 4))`,
;;; which the state does not hold.

(relation likes Person Food  :why "{?1} likes {?2}")
(relation think Person Claim :why "{?1} thinks that {?2}")

(not (not (= 5 (+ 2 2))))
(not (not (likes Dan Soup)))
(think Bob (not (not (= 7 (+ 3 4)))))

(rule eliminate (?R)
  :match  (not (not (?R ?a ?b)))
  :assert (?R ?a ?b)
  :why    "it is not so that {?a} {?R} {?b} is not so")
(eliminate =)

(rule eliminate-in (?R)
  :match  (think ?p (not (not (?R ?a ?b))))
  :assert (think ?p (?R ?a ?b))
  :why    "{?p} thinks it is not so that {?a} {?R} {?b} is not so")
(eliminate-in =)

(solve :no-search)

(query :goal (= ?a ?b)
  :expect (model (= 5 (+ 2 2))))
(query :goal (likes ?p ?f)
  :expect (model))
(query :goal (think Bob (= ?a ?b))
  :expect (model (think Bob (= 7 (+ 3 4)))))
