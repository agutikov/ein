;;; Written for this review: v7_unpack.ein with `=` declared, and nothing else:
;;; the program as option (b) would make its author write it.

(relation = A B :why "{?1} is {?2}")

(think Bob (= 7 (+ 3 4)))

(rule unpack (?R)
  :match  (think ?p (?R ?a ?b))
  :assert (?R ?a ?b)
  :why    "what {?p} thinks of {?R} holds")

(unpack =)
