;;; Written for this review: v7_blind.ein with one fact added, (happy Ann), and
;;; nothing else. A fact a file writes puts its relation in the registry (it is
;;; "auto-vivified"), so this program is v7_blind.ein as the registry would hold
;;; it under option (a). Root's fixpoint holds the same facts: the rule tag
;;; derives (happy Ann) in v7_blind.ein anyway.

(relation person P   :why "{?1} is a person")
(relation likes  P X :why "{?1} likes {?2}")

(person Ann)
(happy Ann)

(rule tag (?R)
  :match  (person ?x)
  :assert (?R ?x)
  :why    "every person is {?R}")

(tag happy)
