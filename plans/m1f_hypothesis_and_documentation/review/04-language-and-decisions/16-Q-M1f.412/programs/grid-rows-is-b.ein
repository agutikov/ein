;;; Written for this review: --models grid takes its rows from the anchor
;;; type's `is-b` members as well as from the facts a state holds. Three people,
;;; one of whom owns a pet: the grid has a row for each person written as
;;; (is-b … Person). grid-rows-is-b.ein spells is-b is-b and nothing else.

(import std.algebra :symbols (functional))

(relation is-b T T           :why "{?1} is a {?2}")
(relation owns Person Pet    :why "{?1} owns the {?2}")

(is-b Ann Person)
(is-b Bob Person)
(is-b Cy Person)
(is-b Dog Pet)
(is-b Cat Pet)

(owns Ann Dog)
(functional owns)

(solve :no-search)
