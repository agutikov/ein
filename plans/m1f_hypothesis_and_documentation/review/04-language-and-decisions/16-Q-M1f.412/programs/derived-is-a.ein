;;; Written for this review: one is-a fact written, (is-a Rex Dog), and one a
;;; rule derives, (is-a Rex Pet); and the same two of `likes`, to compare how
;;; the KB view draws a derived fact of each.

(relation is-a  T T :why "{?1} is a {?2}")
(relation likes T T :why "{?1} likes {?2}")

(is-a Rex Dog)
(likes Rex Bone)

(rule dogs-are-pets ()
  :match  (is-a ?x Dog)
  :assert (and (is-a ?x Pet) (likes ?x Ball))
  :why    "{?x} is a dog, so a pet that likes balls")

(solve :no-search)
