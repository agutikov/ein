;;; Written for this review: --models grid takes its rows from the anchor
;;; type's `is-a` members as well as from the facts a state holds. Three people,
;;; one of whom owns a pet: the grid has a row for each person written as
;;; (is-a … Person). grid-rows-is-b.ein spells is-a is-b and nothing else.

(import std.algebra :symbols (functional))

(relation is-a T T           :why "{?1} is a {?2}")
(relation owns Person Pet    :why "{?1} owns the {?2}")

(is-a Ann Person)
(is-a Bob Person)
(is-a Cy Person)
(is-a Dog Pet)
(is-a Cat Pet)

(owns Ann Dog)
(functional owns)

(solve :no-search)
