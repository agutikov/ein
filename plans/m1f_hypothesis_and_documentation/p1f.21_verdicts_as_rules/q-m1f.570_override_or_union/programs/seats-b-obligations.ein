;;; Item 48, B: examples/lattice/14_seats_nothing_proposes.ein with its hypothesis rules and its :hrules clause deleted,
;;; and its :expect, which is A's. The obligation proposes.

;;; 14_seats_nothing_proposes — a debt some of whose witnesses nothing can hold.
;;;
;;; 06_friends_tables_everyone_sits.ein made small enough for `ein oracle`: the pair (Ann, Bob)
;;; fits both tables, the duo (Cat, Dan) only the big one, each table has two seats, and everyone
;;; owes a seat (`total-owed`). The hrule proposes a friend only the seats of a table their group
;;; fits, 12 candidates, so the facts that can pay Cat's debt are four, `(sits Cat S1)` and
;;; `(sits Cat S2)` among them, and nothing proposes those two. No rule of the program concludes
;;; `sits` and the program marks no relation symmetric, so no state holds either: Cat's debt is
;;; paid by `(sits Cat B1)` or `(sits Cat B2)` or not at all, and so is Dan's.
;;;
;;; What it is the witness of: the obligation tree may branch a state that owes Cat a seat on the
;;; two candidates alone. Root's fixpoint holds no such fact and no commitment writes one, and
;;; what saturation adds to a node is what a rule concludes or what the kernel mirrors, so a
;;; witness that is no candidate, that root does not hold, and of a relation nothing writes is in
;;; no node at all. Ann's and Bob's debts are paid by candidates alone.
;;;
;;; R: the pair at the small table and the duo at the big one, each in either order, 4 states.
;;; The pair at the big table leaves the duo no seat, and four at two seats is dead.

(import std.algebra :symbols (functional injective total-owed))

(relation is-a   T T          :why "{?3} is a {?4}")
(relation member Friend Group :why "{?3} is a member of {?4}")
(relation at     Seat Table   :why "seat {?3} is at table {?4}")
(relation fits   Group Table  :why "group {?3} fits at table {?4}")
(relation sits   Friend Seat  :why "{?3} sits in seat {?4}")

(is-a Ann Friend) (is-a Bob Friend) (is-a Cat Friend) (is-a Dan Friend)
(is-a S1 Seat) (is-a S2 Seat) (is-a B1 Seat) (is-a B2 Seat)
(is-a Pair Group) (is-a Duo Group)
(is-a Small Table) (is-a Big Table)

(member Ann Pair) (member Bob Pair)
(member Cat Duo)  (member Dan Duo)
(at S1 Small) (at S2 Small)
(at B1 Big)   (at B2 Big)
(fits Pair Small) (fits Pair Big) (fits Duo Big)

(functional sits)
(injective  sits)
(total-owed sits is-a)

(rule together ()
  :match  (and (sits ?a ?s) (sits ?b ?t)
               (member ?a ?g) (member ?b ?g)
               (at ?s ?x) (at ?t ?y) (neq ?x ?y))
  :assert (false)
  :why    "{?a} and {?b} are friends and sit at different tables")





(query :goal (sits ?who ?where))
