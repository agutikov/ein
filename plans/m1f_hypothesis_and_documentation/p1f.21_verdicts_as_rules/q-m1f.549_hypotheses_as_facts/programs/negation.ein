;; a stored negation: where is the denied fact?
(relation p Thing :why "p holds of {?3}")
(relation q Thing :why "q holds of {?3}")
(q one)
(not (p two))
(rule q-denies-p ()
  :match  (q ?x)
  :assert (not (p ?x))
  :why    "{?x} is q, so not p.")
(rule seen-held ()
  :match  (p ?x)
  :assert (held-p ?x)
  :why    "p of {?x} is held")
(rule seen-denied ()
  :match  (not (p ?x))
  :assert (denied-p ?x)
  :why    "p of {?x} is denied")
(solve :no-search)
