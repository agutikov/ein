;;; Item 47: the *may* held as a fact, and a rule that reads it.
;;; `(question F)` stands for `(open F)`, concluded by an ordinary rule from
;;; facts no commitment changes. `asked` reads it.

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation served D   :why "{?3} is served")

(is-a Tea Drink) (is-a Milk Drink)

(rule one-choice ()
  :match  (and (chosen ?a) (chosen ?b) (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are both chosen.")

(rule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (question (?R ?x))
  :why    "guess: is {?x} {?R}?")
(guess chosen Drink) (guess served Drink)

(hrule ask (?R)
  :match  (question (?R ?x))
  :assert (?R ?x)
  :why    "suppose ({?R} {?x}): it is asked")
(solve :hrules (ask (chosen) (served)))

(rule asked ()
  :match  (question (chosen ?x))
  :assert (asked ?x)
  :why    "whether {?x} is chosen is asked.")
