;;; Item 47: the *must* held as a fact, and a rule that reads it.
;;; `(unfinished seats)` stands for `(open seats)`: it is concluded where a
;;; requirement of std.debts has no payment. `noted` is a rule that reads it.
;;; The seats program, examples/lattice/05_owed_seats_bounded.ein.

(import std.algebra :symbols (total-owed surjective-owed functional injective))

(relation is-a   T T         :why "{?3} is a {?4}")
(relation seats  Guest Chair :why "{?3} is seated at {?4}")

(is-a Ann Guest) (is-a Bob Guest)
(is-a C1 Chair)  (is-a C2 Chair)

(total-owed      seats is-a)
(surjective-owed seats is-a)
(functional seats)
(injective  seats)

(import std.debts)
(debts-of-owed)

(rule unfinished ()
  :match  (and (debt-due ?R ?j) (absent (debt-paid ?R ?j)))
  :assert (unfinished ?R)
  :why    "{?R} still owes.")
(rule noted ()
  :match  (unfinished ?R)
  :assert (noted ?R)
  :why    "a rule read that {?R} still owes.")

(query :goal (seats ?g ?c))
