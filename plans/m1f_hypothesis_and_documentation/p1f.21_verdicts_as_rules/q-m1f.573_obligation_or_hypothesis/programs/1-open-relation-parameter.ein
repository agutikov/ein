;;; Item 51, question 1: `(open ?R)` where ?R is the rule's parameter and
;;; names a relation. Today's obligation: it loads.

(relation is-a  T T         :why "{?3} is a {?4}")
(relation seats Guest Chair :why "{?3} is seated at {?4}")
(is-a Ann Guest) (is-a C1 Chair) (is-a C2 Chair)
(rule each-seated (?R)
  :match  (and (is-a ?a Guest) (absent (and (is-a ?b Chair) (?R ?a ?b))))
  :assert (open ?R)
  :why    "{?a} has no chair by {?R}.")
(each-seated seats)
