;;; Item 56: a hypothesis rule proposes `knows`, an obligation owes `likes`,
;;; and a list takes `likes` out. Today the rule overrides the obligation as a
;;; source of candidates, so nothing proposes `likes`.

(relation person T   :why "{?3} is a person")
(relation food   T   :why "{?3} is a food")
(relation likes  T T :why "{?3} likes {?4}")
(relation knows  T T :why "{?3} knows {?4}")

(person Ann)
(food Soup)

(rule owes-food ()
  :match  (and (person ?a) (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} is owed a food to like.")
(hrule meet ()
  :match  (and (person ?p) (food ?f))
  :assert (knows ?p ?f)
  :why    "does {?p} know {?f}?")
(solve :hrules (meet) :no-hypothesis (likes))
