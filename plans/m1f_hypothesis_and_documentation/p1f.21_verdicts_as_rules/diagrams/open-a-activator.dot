digraph open_a_activator {
  rankdir=TB; nodesep=0.4; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "open"; "total-owed"; }
  { rank=max; "seats"; "is-a"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  v [xlabel="v  ×2", style="dotted", penwidth=2];
  act [xlabel="act"];
  v -> "open" [label="1", style=dotted];
  v -> "seats" [label="2", style=dotted];
  v -> act [label="3", style=dotted];
  act -> "total-owed" [label="1"];
  act -> "seats" [label="2"];
  act -> "is-a" [label="3"];
}
