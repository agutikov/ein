digraph open_today {
  rankdir=TB; nodesep=0.4; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "open"; "total-owed"; "relation"; }
  { rank=same; "seats"; "is-a"; }
  { rank=max; "Ann"; "Bob"; "Guest"; "Chair"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  act [xlabel="act"]; d [xlabel="d"]; m1 [xlabel="m1"]; m2 [xlabel="m2"];
  v [xlabel="v  ×2", style="dotted", penwidth=2];
  { rank=same; act; d; v; }
  { rank=same; m1; m2; }
  act -> "total-owed" [label="1"];
  act -> "seats" [label="2"];
  act -> "is-a" [label="3"];
  d -> "relation" [label="1"];
  d -> "seats" [label="2"];
  d -> "Guest" [label="3"];
  d -> "Chair" [label="4"];
  "is-a" -> m1 [label="1", dir=back];
  m1 -> "Ann" [label="2"];
  m1 -> "Guest" [label="3"];
  "is-a" -> m2 [label="1", dir=back];
  m2 -> "Bob" [label="2"];
  m2 -> "Guest" [label="3"];
  v -> "open" [label="1", style=dotted];
  v -> "seats" [label="2", style=dotted];
}
