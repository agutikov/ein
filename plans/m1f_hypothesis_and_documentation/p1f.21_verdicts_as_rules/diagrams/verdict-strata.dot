digraph verdict_strata {
  rankdir=LR; nodesep=0.35; ranksep=0.7;
  node [fontname="Helvetica", fontsize=11, shape=ellipse];
  edge [fontname="Helvetica", fontsize=10];
  subgraph cluster_0 { label="the fixpoint: what a fork inherits"; style="rounded"; color="#888888"; fontname="Helvetica"; fontsize=10;
    r [label="the program's\nrelations"];
    bot [label="false"];
  }
  subgraph cluster_1 { label="read once, on the fixpoint"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10;
    open [label="open"];
    alive [label="alive"];
    dead [label="dead"];
  }
  subgraph cluster_2 { label="read on those"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10;
    discharged [label="discharged"];
  }
  subgraph cluster_3 { label="the answer"; style="rounded,dashed"; color="#888888"; fontname="Helvetica"; fontsize=10;
    inR [label="in R"];
  }
  r -> bot [label="a restriction;\nf beside ¬f"];
  r -> open [label="trigger"];
  r -> open [label="¬ witness", color="#d62728", fontcolor="#d62728", style=dashed];
  bot -> dead;
  bot -> alive [label="¬", color="#d62728", fontcolor="#d62728", style=dashed];
  open -> discharged [label="¬", color="#d62728", fontcolor="#d62728", style=dashed];
  alive -> inR;
  discharged -> inR;
}
