digraph contradiction_rule_per_count {
  rankdir=TB; nodesep=0.5; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "clash-2"; "not"; "false"; }
  node [shape=diamond];
  "?R";
  { rank=max; "?a"; "?b"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  act [xlabel="act"]; q [xlabel="q"]; n [xlabel="n"];
  bot [xlabel="⊥", style="filled,dashed"];
  { rank=same; act; n; bot; }
  act -> "clash-2" [label="1"];
  act -> "?R" [label="2"];
  n -> "not" [label="1"];
  n -> q [label="2"];
  "?R" -> q [label="1", dir=back];
  q -> "?a" [label="2"];
  q -> "?b" [label="3"];
  bot -> "false" [label="1", style=dashed];
}
