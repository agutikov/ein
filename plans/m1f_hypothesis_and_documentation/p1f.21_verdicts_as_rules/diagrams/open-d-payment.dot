digraph open_d_payment {
  rankdir=TB; nodesep=0.4; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "open"; }
  { rank=same; "seats"; }
  { rank=max; "Ann"; "Bob"; "C1"; "C2"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  v1 [xlabel="v1", style="dotted", penwidth=2];
  v2 [xlabel="v2", style="dotted", penwidth=2];
  v3 [xlabel="v3", style="dotted", penwidth=2];
  v4 [xlabel="v4", style="dotted", penwidth=2];
  subgraph cluster_extent { style="rounded,dashed"; color="#888888";
    h1 [xlabel="h1", style=solid];
    h2 [xlabel="h2", style=solid];
    h3 [xlabel="h3", style=solid];
    h4 [xlabel="h4", style=solid];
  }
  { rank=same; v1; v2; v3; v4; }
  v1 -> "open" [label="1", style=dotted];
  v2 -> "open" [label="1", style=dotted];
  v3 -> "open" [label="1", style=dotted];
  v4 -> "open" [label="1", style=dotted];
  v1 -> "seats" [label="2", style=dotted];
  v2 -> "seats" [label="2", style=dotted];
  v3 -> "seats" [label="2", style=dotted];
  v4 -> "seats" [label="2", style=dotted];
  v1 -> h1 [label="3", style=dotted];
  v2 -> h2 [label="3", style=dotted];
  v3 -> h3 [label="3", style=dotted];
  v4 -> h4 [label="3", style=dotted];
  "seats" -> h1 [label="1", dir=back];
  "seats" -> h2 [label="1", dir=back];
  "seats" -> h3 [label="1", dir=back];
  "seats" -> h4 [label="1", dir=back];
  h1 -> "Ann" [label="2"]; h1 -> "C1" [label="3"];
  h2 -> "Ann" [label="2"]; h2 -> "C2" [label="3"];
  h3 -> "Bob" [label="2"]; h3 -> "C1" [label="3"];
  h4 -> "Bob" [label="2"]; h4 -> "C2" [label="3"];
}
