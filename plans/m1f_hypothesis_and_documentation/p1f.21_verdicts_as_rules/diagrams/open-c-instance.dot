digraph open_c_instance {
  rankdir=TB; nodesep=0.4; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "open"; }
  { rank=same; "total-owed"; }
  { rank=max; "seats"; "is-a"; "Guest"; "Chair"; "Ann"; "Bob"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9"];
  v1 [xlabel="v1", style="dotted", penwidth=2];
  v2 [xlabel="v2", style="dotted", penwidth=2];
  j1 [xlabel="j1", style=solid];
  j2 [xlabel="j2", style=solid];
  { rank=same; v1; v2; }
  { rank=same; j1; j2; }
  v1 -> "open" [label="1", style=dotted];
  v1 -> "seats" [label="2", style=dotted];
  v1 -> j1 [label="3", style=dotted];
  v2 -> "open" [label="1", style=dotted];
  v2 -> "seats" [label="2", style=dotted];
  v2 -> j2 [label="3", style=dotted];
  "total-owed" -> j1 [label="1", dir=back];
  j1 -> "seats" [label="2"];
  j1 -> "is-a" [label="3"];
  j1 -> "Guest" [label="4"];
  j1 -> "Chair" [label="5"];
  j1 -> "Ann" [label="6"];
  "total-owed" -> j2 [label="1", dir=back];
  j2 -> "seats" [label="2"];
  j2 -> "is-a" [label="3"];
  j2 -> "Guest" [label="4"];
  j2 -> "Chair" [label="5"];
  j2 -> "Bob" [label="6"];
}
