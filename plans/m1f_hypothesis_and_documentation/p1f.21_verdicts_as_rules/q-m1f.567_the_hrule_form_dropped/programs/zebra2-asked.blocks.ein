;; Not a program: the two blocks that replace zebra2's `(hrule guess …)` and its
;; `(solve :hrules (guess …))` clause. tools/run.sh writes runs/zebra2-asked.ein from
;; examples/zebra2.ein with them.

;; in place of the hrule: the candidates as ordinary facts, concluded by a rule
(rule propose (?R ?T1 ?T2)
  :match  (and (is-a ?a ?T1) (is-a ?b ?T2))
  :assert (question (?R ?a ?b))
  :why    "ask: ({?R} {?a} {?b})?")
(propose color-loc  Color       House)
(propose nation-loc Nationality House)
(propose drink-loc  Drink       House)
(propose smoke-loc  Cigarette   House)
(propose pet-loc    Pet         House)
;; one generic hrule: suppose what is asked
(hrule ask (?R)
  :match  (question (?R ?a ?b))
  :assert (?R ?a ?b)
  :why    "suppose ({?R} {?a} {?b}): it is asked")

;; in place of the clause
;;   (solve :hrules (ask (color-loc) (nation-loc) (drink-loc) (smoke-loc) (pet-loc)))
