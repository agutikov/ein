;;; (b) of Q-M1f.567 as it would be written. Refused today, at the parse.
;;; The form `hrule` is gone: `guess` is a rule whose conclusion stands under
;;; `open`. Its activators stay in the clause, listed whole (Q-M1f.565).

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation served D   :why "{?3} is served")

(is-a Tea Drink) (is-a Milk Drink)

(rule one-choice ()
  :match  (and (chosen ?a) (chosen ?b) (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are both chosen.")

(rule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (open (?R ?x))
  :why    "guess: is {?x} {?R}?")
(solve :hrules ((guess chosen Drink) (guess served Drink)))
