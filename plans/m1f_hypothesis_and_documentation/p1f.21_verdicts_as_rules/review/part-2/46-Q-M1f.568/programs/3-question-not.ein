;;; Cell 3 of Q-M1f.568 with today's engine, `question` standing for `open`:
;;; what is asked is a negation, and the candidate is the stored negation
;;; (not (p A)).

(question (not (p A)))
(hrule ask-not-p ()
  :match  (question (not (p ?x)))
  :assert (not (p ?x))
  :why    "suppose (p {?x}) does not hold: it is asked")
(solve :hrules (ask-not-p))
