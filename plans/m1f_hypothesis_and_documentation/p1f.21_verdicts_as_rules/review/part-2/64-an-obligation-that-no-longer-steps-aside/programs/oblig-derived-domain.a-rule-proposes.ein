;;; Item 64, the stand-in for oblig-derived-domain.a-rule-proposes.target.ein, which today's parse refuses. Two
;;; hypothesis rules stand for the two writers of `(open F)` at root: `guard-at-root`, what the obligation's guard
;;; gives at root (Q-M1f.579), and `may-like`, the rule. A hypothesis rule overrides the obligations rung today, so
;;; H is exactly their candidates together, identical ones one: the union (Q-M1f.570).

(relation person T :why "{?3} is a person")
(relation food   T :why "{?3} is a food")
(relation dish   T :why "{?3} is a dish")
(relation likes  T T :why "{?3} likes {?4}")

(person Ann)
(food Soup)
(dish Pie)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (and (likes ?p ?f) (dish ?d))
  :assert (food ?d)
  :why    "once {?p} likes {?f}, the dish {?d} is on the menu")

(hrule guard-at-root ()
  :match  (and (person ?a)
               (absent (and (food ?c) (likes ?a ?c)))
               (food ?b))
  :assert (likes ?a ?b)
  :why    "what owes-food's guard gives at root: {?a} may like the food {?b}")

(hrule may-like ()
  :match  (and (person ?a) (dish ?d))
  :assert (likes ?a ?d)
  :why    "{?a} may like the dish {?d}")

(solve
  :no-hypothesis (person food dish)
  :expect (region
            (model (likes Ann Pie))))

(query
  :goal   (likes ?p ?f))
