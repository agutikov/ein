;;; Item 64, the stand-in for examples/ein-bugs/wrong-answers/oblig-derived-domain.ein: the program whole, with one hypothesis rule more,
;;; `guard-at-root`, which proposes what the obligation's guard gives at root. A hypothesis rule overrides
;;; the obligations rung today, so H is those candidates: what the obligation writes once it no longer steps
;;; aside (Q-M1f.579). Its :expect is the original's. Written by tools/gen.py.

;;; The obligations rung never proposed a domain value a commitment derives,
;;; **with no rule constant at all** — regression
;;; `oblig-derived-domain` (`corpus/regressions.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `oblig-fresh-name.ein`'s defect where the value that joins the guard's
;;; domain inside a fork is named by a **fact**, `(dish Pie)`, so it is a
;;; name of the program and a candidate object, and nothing about names is
;;; at stake. `special` derives `(food ?d)` for every dish once anyone likes
;;; anything. A rung that reads root's `(food ?b)` scan finds Soup alone, and
;;; Ann may not like Soup: its H is `(likes Ann Soup)`, dead alone.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(likes Ann Pie)}` saturates to `(food Pie)`, which witnesses Ann's debt:
;;; R is that one state. With `(food Pie)` declared at root
;;; (`oblig-derived-domain-declared.ein`) the rung finds it; with the rung
;;; declined, the blind enumerator does (six `likes` candidates over Ann, Soup
;;; and Pie, five dead alone).
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; At `338b5892` (`ein solve FILE`), H was 1 candidate, dead alone, and R was
;;; empty, every alive node owing. The rung declines on a guard that scans a
;;; relation in D (`food`; Q-M1e2.10), and this file answers its control's R,
;;; which the `:expect` below states. The regression
;;; `oblig-derived-domain` is fixed.
;;;
;;;
;;;

(relation person T :why "{?3} is a person")
(relation food   T :why "{?3} is a food")
(relation dish   T :why "{?3} is a dish")
(relation likes  T T :why "{?3} likes {?4}")

(person Ann)
(food Soup)
(dish Pie)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (and (likes ?p ?f) (dish ?d))
  :assert (food ?d)
  :why    "once {?p} likes {?f}, the dish {?d} is on the menu")

;; ── the stand-in (item 64): owes-food's guard, read at root ──
(hrule guard-at-root ()
  :match  (and (person ?a)
               (absent (and (food ?c) (likes ?a ?c)))
               (food ?b))
  :assert (likes ?a ?b)
  :why    "what owes-food's guard gives at root: {?a} may like the food {?b}")

(solve
  :no-hypothesis (person food dish)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts —
  ;; the -declared control's R, which this file answers too.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Pie)}
            (model (likes Ann Pie))))

(query
  :goal   (likes ?p ?f))
