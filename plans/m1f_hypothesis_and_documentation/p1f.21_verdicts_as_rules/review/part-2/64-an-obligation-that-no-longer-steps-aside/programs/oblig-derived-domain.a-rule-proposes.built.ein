;;; Item 64, the stand-in oblig-derived-domain.a-rule-proposes.ein in the spelling the built engine reads. Of its two
;;; hypothesis rules, `guard-at-root` stood for the obligation, which writes its guard's candidates at root once built
;;; (Q-M1f.579), so it is left to the obligation, as each `*.guard-at-root.ein` is; `may-like` is a rule that concludes
;;; `(open F)` (Q-M1f.567). It is oblig-derived-domain.a-rule-proposes.target.ein with the stand-in's `:expect`, so
;;; `ein test` has a claim to read. The program is flagged, and nothing is claimed of its answer (Q-M1f.564).

(relation person T :why "{?3} is a person")
(relation food   T :why "{?3} is a food")
(relation dish   T :why "{?3} is a dish")
(relation likes  T T :why "{?3} likes {?4}")

(person Ann)
(food Soup)
(dish Pie)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (and (likes ?p ?f) (dish ?d))
  :assert (food ?d)
  :why    "once {?p} likes {?f}, the dish {?d} is on the menu")

(rule may-like ()
  :match  (and (person ?a) (dish ?d))
  :assert (open (likes ?a ?d))
  :why    "{?a} may like the dish {?d}")

(solve
  :no-hypothesis (person food dish)
  :expect (region
            (model (likes Ann Pie))))

(query
  :goal   (likes ?p ?f))
