;;; Item 77: the program docs/ein/ein.rs/08-reasoning-in-code/02-saturation-and-negation.md writes out at its
;;; lines 81 to 94, copied as it is, the rule `neighbour` among it. Its `ein render kb --fold` (that page's line 99)
;;; is the picture 01-after-firing of docs/ein/reasoning/02-kb-evolution/01-firing.md (line 118), cut by hand as
;;; that page's line 102 says: without the four declarations' own facts.

(relation is-a T T :why "{?3} is a {?4}")
(relation lives-in Person House :why "{?3} lives in {?4}")
(relation next-to House House :why "{?3} is next to {?4}")
(relation near Person House :why "{?3} lives near {?4}")

(is-a Norwegian Person) (is-a House-1 House) (is-a House-2 House)

(rule neighbour ()
  :match  (and (lives-in ?p ?h) (next-to ?h ?g))
  :assert (near ?p ?g)
  :why    "{?p} lives in {?h}, which is next to {?g}, so {?p} lives near {?g}")

(lives-in Norwegian House-1)
(next-to House-1 House-2)
