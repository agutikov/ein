;;; Item 77: the program docs/ein/ein.rs/08-reasoning-in-code/04-rule-evolution.md writes out at its lines 46
;;; to 55, `kinds.ein` on that page, copied as it is. Its `ein render kb --fold` (that page's line 60) is the
;;; picture 01-instance-of-instance of docs/ein/reasoning/03-rule-evolution/01-rules-as-data.md (line 91).

(import std.algebra :symbols (includes transitive))
(relation is-a T T :why "{?3} is a {?4}")
(relation is-a* T T :why "{?3} is, at some remove, a {?4}")
(is-a Object   T)
(is-a Relation Object)     ;; a relation is an object
(is-a Fact     Object)     ;; a fact is an object
(is-a Rule     Object)     ;; a rule is an object
(is-a is-a Relation)       ;; the membership relation classifies itself
(includes is-a is-a*)
(transitive is-a*)
