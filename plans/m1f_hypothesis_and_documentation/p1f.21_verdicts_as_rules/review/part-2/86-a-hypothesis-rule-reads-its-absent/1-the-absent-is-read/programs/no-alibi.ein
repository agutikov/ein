;;; Review item 86, part 1 (Q-M1f.685). Not a corpus file.
;;;
;;; Anyone present with no alibi is a suspect: `suspect` concludes the hypothesis `(culprit ?x)`
;;; where `(present ?x)` holds and `(alibi ?x)` does not. Ann has an alibi, Bob has none. Read as
;;; every rule's `:match` is, the match holds of Bob alone, so H is `(culprit Bob)` and R two
;;; states. Before the fix the rule's `absent` was not read: H was both culprits, R four states,
;;; Ann among the suspects. The program is monotone: no commitment changes `alibi`.

(relation present Person :why "{?3} was there")
(relation alibi   Person :why "{?3} has an alibi")
(relation culprit Person :why "{?3} did it")
(present Ann) (present Bob)
(alibi Ann)
(rule suspect ()
  :match  (and (present ?x) (absent (alibi ?x)))
  :assert (open (culprit ?x))
  :why    "suppose {?x} did it: {?x} was there and has no alibi")
(query :goal (culprit ?who))
