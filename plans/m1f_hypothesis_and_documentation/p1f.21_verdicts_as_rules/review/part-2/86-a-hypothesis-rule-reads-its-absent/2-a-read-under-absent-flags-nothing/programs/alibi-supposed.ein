;;; Review item 86, part 2 (Q-M1f.686). Not a corpus file.
;;;
;;; The alibis are suppositions too: `maybe-alibi` proposes one for each person present, and
;;; `suspect` reads them under `absent`. At root nobody has an alibi, so H is two alibis and two
;;; culprits. Above root a commitment can add an alibi, and the state's own pass then proposes
;;; fewer culprits: committing `(alibi Ann)` takes `(culprit Ann)` away there and adds nothing.
;;; The default: such a read is no site of the static check, the program is called monotone, and
;;; R, over root's H, holds `{(alibi Ann), (culprit Ann)}` among its 16 states.

(relation present Person :why "{?3} was there")
(relation alibi   Person :why "{?3} has an alibi")
(relation culprit Person :why "{?3} did it")
(present Ann) (present Bob)
(rule maybe-alibi ()
  :match  (present ?x)
  :assert (open (alibi ?x))
  :why    "suppose {?x} has an alibi")
(rule suspect ()
  :match  (and (present ?x) (absent (alibi ?x)))
  :assert (open (culprit ?x))
  :why    "suppose {?x} did it: {?x} was there and has no alibi")
(query :goal (culprit ?who))
