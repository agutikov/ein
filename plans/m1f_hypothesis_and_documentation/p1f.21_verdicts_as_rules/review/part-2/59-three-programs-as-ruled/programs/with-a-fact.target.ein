;;; Item 59, the spelling ruled of Q-M1f.575 (a): one rule concludes a hypothesis and a fact in one :assert. `(open F)`
;;; stands in a conjunction like any fact; `(open R)` alone stays a rule's whole :assert. Refused at the parse
;;; today: `open` over a fact. Its stand-in is with-a-fact.asked.ein.

(relation thing T :why "{?3} is a thing")
(relation seen  T :why "{?3} is seen")
(relation p     T :why "{?3} is a p")

(thing A) (thing B)

(rule propose ()
  :match  (thing ?x)
  :assert (and (open (p ?x)) (seen ?x))
  :why    "{?x} is seen, and may be a p.")

(query :goal (p ?x))
