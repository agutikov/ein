;;; Item 85: the program written right. A hypothesis rule, `guess`, with three parameters, concludes `(open (?R ?a ?b))`,
;;; and its one activator, `(guess at Color House)`, has the rule's name and three arguments: the rule proposes the
;;; four facts `(at C H)`, C one of two colours and H one of two houses. Written for this item, on the shape of the probe
;;; the finding was taken on (the-findings-probe.ein beside it), with a second colour, a second house and one rule
;;; that refutes two colours in one house.

(relation at Color House :why "{?3} is at {?4}")

(is-a Red Color) (is-a Green Color)
(is-a H1 House)  (is-a H2 House)

(rule guess (?R ?T1 ?T2)
  :match  (and (is-a ?a ?T1) (is-a ?b ?T2))
  :assert (open (?R ?a ?b))
  :why    "suppose {?R} holds of {?a} and {?b}")

(rule one-colour-a-house ()
  :match  (and (at ?a ?h) (at ?b ?h) (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are both at {?h}")

(guess at Color House)
