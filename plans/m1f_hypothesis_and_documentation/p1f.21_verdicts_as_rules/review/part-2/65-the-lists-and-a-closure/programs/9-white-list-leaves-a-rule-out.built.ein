;;; Item 65: `9-white-list-leaves-a-rule-out.ein`, kept beside it unchanged, in the spelling the built engine reads.
;;; What changed: the two `hrule`s, `guess` and `meet`, are rules that conclude `(open (likes ?p ?f))` and
;;; `(open (knows ?p ?f))`, active with no activator since they have no parameter, and `(solve :hrules (guess meet)
;;; …)` loses its `:hrules`, which no form takes. Nothing else.
;;;
;;; Item 65, the white list's other direction: a rule proposes `likes` and `knows`, and `:hypothesis-relations`
;;; lists `likes` alone. Every relation the list names has an `open` fact, which is the direction ruled; an `open`
;;; fact of `knows`, which the list leaves out, is the direction not named (Q-M1f.595).

(relation person T   :why "{?3} is a person")
(relation food   T   :why "{?3} is a food")
(relation likes  T T :why "{?3} likes {?4}")
(relation knows  T T :why "{?3} knows {?4}")

(person Ann)
(food Soup)

(rule guess ()
  :match  (and (person ?p) (food ?f))
  :assert (open (likes ?p ?f))
  :why    "does {?p} like {?f}?")
(rule meet ()
  :match  (and (person ?p) (food ?f))
  :assert (open (knows ?p ?f))
  :why    "does {?p} know {?f}?")
(solve :hypothesis-relations (likes))
