;;; Item 65: `10-white-list-names-more.ein`, kept beside it unchanged, in the spelling the built engine reads. What
;;; changed: the `(hrule guess () … :assert (likes ?p ?f))` is a rule that concludes `(open (likes ?p ?f))`, active
;;; with no activator since it has no parameter, and `(solve :hrules (guess) …)` loses its `:hrules`, which no form
;;; takes. Nothing else.
;;;
;;; Item 65, the white list's ruled direction: a rule proposes `likes`, and `:hypothesis-relations` lists `likes`
;;; and `knows`; no `open` fact is of `knows` (Q-M1f.578: "lists relations that are not in open facts - also error").

(relation person T   :why "{?3} is a person")
(relation food   T   :why "{?3} is a food")
(relation likes  T T :why "{?3} likes {?4}")
(relation knows  T T :why "{?3} knows {?4}")

(person Ann)
(food Soup)

(rule guess ()
  :match  (and (person ?p) (food ?f))
  :assert (open (likes ?p ?f))
  :why    "does {?p} like {?f}?")
(solve :hypothesis-relations (likes knows))
