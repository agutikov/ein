;;;
;;; The lines, decided locally and globally: A and B come
;;; together or not at all, as lattice/06_friends_tables' groups do. Either
;;; alone owes the other, so ∅ and {A,B} are in R with a hole on each side.
;;; Every edge out of ∅ and out of {A,B} leaves R, so the one-fact test calls
;;; ∅ maximal and {A,B} minimal, and the cube says neither is.
;;;
;;; The cube is over 2 candidates (h A B), 4 nodes. The target:
;;;   R           2 nodes in 2 component(s): 1 nodes from ∅; 1 nodes from {A,B}
;;;   minimal     ∅
;;;   maximal     {A,B}
;;;   holes       {A}, {B}
;;;   owing       2 nodes; dead 0
;;;   monotone    no — a dead node revived or a debt added by growth needs an `absent` or an obligation trigger, so the static check should flag it
;;;
;;; 0 dead rule(s), 2 obligation rule(s), from the target's prime implicants.
;;;
;;; region-spec: {"name":"local_not_global","about":"The lines, decided locally and globally: A and B come\ntogether or not at all, as lattice/06_friends_tables' groups do. Either\nalone owes the other, so ∅ and {A,B} are in R with a hole on each side.\nEvery edge out of ∅ and out of {A,B} leaves R, so the one-fact test calls\n∅ maximal and {A,B} minimal, and the cube says neither is.","candidates":"AB","R":[["",""],["AB","AB"]],"owing":[["A","A"],["B","B"]]}
;;; region-status: RooR

(relation h T :why "h holds of {?3}")
(relation slot T :why "{?3} is a slot, a candidate for h")
(relation world T :why "{?3} is the world")
(relation need T T :why "h holding of {?4} pays debt {?3}")

(world W)
(slot A) (slot B)

(need K1 B) (need K2 A)

(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess: (h {?x})?")

(rule owe-1 ()
  :match  (and (h A) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "with A: one of B is required")

(rule owe-2 ()
  :match  (and (h B) (absent (and (need K2 ?x) (h ?x))))
  :assert (open h)
  :why    "with B: one of A is required")

(query :goal (h ?x))

;; ── (b) of Q-M1f.566: the requirement as the question it asks, and what answers it
(rule need-1 ()
  :match  (h A)
  :assert (owe h K1)
  :why    "with A: one of what pays K1 is required.")
(rule answer-1 ()
  :match  (and (h A) (need K1 ?x) (h ?x))
  :assert (answered h K1)
  :why    "{?x} pays K1.")
(rule need-2 ()
  :match  (h B)
  :assert (owe h K2)
  :why    "with B: one of what pays K2 is required.")
(rule answer-2 ()
  :match  (and (h B) (need K2 ?x) (h ?x))
  :assert (answered h K2)
  :why    "{?x} pays K2.")

;; ── (c) of Q-M1f.566: the requirement as the rule's instance, and what pays it
(rule due-1 ()
  :match  (h A)
  :assert (debt-due h (owe-1-of A))
  :why    "with A: one of what pays K1 is required.")
(rule paid-1 ()
  :match  (and (h A) (need K1 ?x) (h ?x))
  :assert (debt-paid h (owe-1-of A))
  :why    "{?x} pays K1.")
(rule due-2 ()
  :match  (h B)
  :assert (debt-due h (owe-2-of B))
  :why    "with B: one of what pays K2 is required.")
(rule paid-2 ()
  :match  (and (h B) (need K2 ?x) (h ?x))
  :assert (debt-paid h (owe-2-of B))
  :why    "{?x} pays K2.")
