;; The object program, as the engine's search reads it: two candidates, a clash, a requirement.
(relation s Thing :why "s holds of {?3}")
(thing a) (thing b)
(hrule guess ()
  :match  (thing ?x)
  :assert (s ?x)
  :why    "suppose s of {?x}")
(rule clash ()
  :match  (and (s a) (s b))
  :assert (false)
  :why    "s of a and of b")
(rule some-s (?R)
  :match  (absent (?R ?x))
  :assert (open ?R)
  :why    "{?R} of something is owed")
(some-s s)
(solve :hrules (guess))
(query :goal (s ?x))
