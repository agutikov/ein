;;; Item 60, drinks.ein in the spelling the built engine reads (Q-M1f.566, Q-M1f.567): `guess` is a rule whose :assert
;;; is (open (?R ?x)), activated by two facts; the hrule form and the (solve :hrules …) clause are gone. It is also
;;; drinks-asked.ein built: `question` becomes `open`, and the stand-in's hypothesis rule `ask`, which only supposed
;;; what `question` asked, goes, since the kernel supposes each `(open F)` root holds itself. Nothing else differs.

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation served D   :why "{?3} is served")

(is-a Tea Drink) (is-a Milk Drink)

(rule one-choice ()
  :match  (and (chosen ?a) (chosen ?b) (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are both chosen.")

(rule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (open (?R ?x))
  :why    "guess: is {?x} {?R}?")
(guess chosen Drink) (guess served Drink)
