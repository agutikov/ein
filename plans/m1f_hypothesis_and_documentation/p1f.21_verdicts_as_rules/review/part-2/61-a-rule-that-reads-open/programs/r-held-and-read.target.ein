;;; Item 61: the *must* held as a fact, and a rule that reads it, in the spelling ruled (Q-M1f.566, Q-M1f.569). The
;;; seats program, examples/lattice/05_owed_seats_bounded.ein; the kernel holds `(open seats)` where a state owes, and
;;; `noted` reads it. Refused at the parse today: `open` in a :match. The page of Q-M1f.569 ran its stand-in,
;;; r-held-and-read.ein, where std.debts states the requirement and its payment and `(unfinished seats)` stands for
;;; `(open seats)`.

(import std.algebra :symbols (total-owed surjective-owed functional injective))

(relation is-a   T T         :why "{?3} is a {?4}")
(relation seats  Guest Chair :why "{?3} is seated at {?4}")

(is-a Ann Guest) (is-a Bob Guest)
(is-a C1 Chair)  (is-a C2 Chair)

(total-owed      seats is-a)
(surjective-owed seats is-a)
(functional seats)
(injective  seats)

(rule noted ()
  :match  (open ?R)
  :assert (noted ?R)
  :why    "a rule read that {?R} still owes.")

(query :goal (seats ?g ?c))
