;;; Item 61: a rule that reads the absence of a *may*, in the spelling ruled: only `chosen` is asked, and
;;; `not-asked` holds of each drink of which `served` is not, `(absent (open (served ?x)))` (Q-M1f.568: legal).
;;; Refused at the parse today. The page of Q-M1f.569 ran its stand-in, f-absent-read.ein, with `question` for `open`.

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation served D   :why "{?3} is served")

(is-a Tea Drink) (is-a Milk Drink)

(rule one-choice ()
  :match  (and (chosen ?a) (chosen ?b) (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are both chosen.")

(rule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (open (?R ?x))
  :why    "guess: is {?x} {?R}?")
(guess chosen Drink)

(rule not-asked ()
  :match  (and (is-a ?x Drink) (absent (open (served ?x))))
  :assert (not-asked ?x)
  :why    "whether {?x} is served is not asked.")
