;;; The same two rules as ordinary rules that conclude what is asked, held
;;; under `question` (which stands for `open`). `ask-extra` fires in saturation
;;; at every node: a state that holds (chosen Tea) holds
;;; (question (with Tea Sugar)) too. H is read at root, so that fact is held
;;; and not proposed: a hypothesis that depends on another.

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation with   D E :why "{?3} comes with {?4}")

(is-a Tea Drink) (is-a Milk Drink) (is-a Sugar Extra)

(rule ask-drink ()
  :match  (is-a ?d Drink)
  :assert (question (chosen ?d))
  :why    "is {?d} chosen?")
(rule ask-extra ()
  :match  (and (chosen ?d) (is-a ?e Extra))
  :assert (question (with ?d ?e))
  :why    "{?d} is chosen: does it come with {?e}?")

(hrule ask-chosen ()
  :match  (question (chosen ?x))
  :assert (chosen ?x)
  :why    "suppose (chosen {?x}): it is asked")
(hrule ask-with ()
  :match  (question (with ?x ?y))
  :assert (with ?x ?y)
  :why    "suppose (with {?x} {?y}): it is asked")
(solve :hrules (ask-chosen ask-with))
