;;; Review item 83, piece 2: a-seat-nothing-proposes.ein with a rule that could write a `sits`
;;; fact, `honour`, which never fires: nothing says Ann is a guest of honour. Not a corpus file.
;;;
;;; L9's premise is read off the rules, not the run: `sits` is a relation a rule concludes, so on
;;; the engine before the union L9 declined and the search fell back to the state route. Under the
;;; union nothing here asks for L9.

(import std.algebra :symbols (functional total-owed))
(relation is-a   T T        :why "{?3} is a {?4}")
(relation sits   Guest Seat :why "{?3} sits in seat {?4}")
(relation window Seat       :why "seat {?3} is by the window")
(is-a Ann Guest)
(is-a S1 Seat)
(is-a S2 Seat)
(window S1)
(functional sits)
(total-owed sits is-a)
(rule seat ()
  :match  (and (is-a ?g Guest) (window ?s))
  :assert (open (sits ?g ?s))
  :why    "suppose {?g} sits by the window, in {?s}")
(relation vip Guest :why "{?3} is a guest of honour")
(rule honour ()
  :match  (vip Ann)
  :assert (sits Ann S2)
  :why    "a guest of honour sits in S2")
(query :goal (sits ?who ?where))
