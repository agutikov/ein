;;; Review item 83, piece 1: one-way-to-eat.ein in the spelling of the engine before the union
;;; (`ddf09492`: `hrule` and `(solve :hrules …)`), to run on that engine. Not a corpus file.

(import std.algebra :symbols (total-owed))
(relation is-a   T T        :why "{?3} is a {?4}")
(relation fed    Guest Dish :why "{?3} is fed {?4}")
(relation orders Guest      :why "{?3} orders a takeaway")
(is-a Ann Guest)
(is-a Soup Dish)
(total-owed fed is-a)
(rule takeaway ()
  :match  (orders Ann)
  :assert (fed Ann Soup)
  :why    "Ann orders a takeaway, so she is fed soup")
(hrule order ()
  :match  (is-a ?g Guest)
  :assert (orders ?g)
  :why    "suppose {?g} orders a takeaway")
(query :goal (fed ?who ?what))
(solve :hrules (order))
