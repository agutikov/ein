;; The same, with the one fact that is not meant denied by a rule: root settles it, so it is no candidate.
(relation s Thing :why "s holds of {?3}")
(thing a) (thing b)
(other c)
(rule s-is-of-things-only ()
  :match  (other ?x)
  :assert (not (s ?x))
  :why    "{?x} is no thing, so s does not hold of it")
(solve :hypothesis-relations (s))
(query :goal (s ?x))
