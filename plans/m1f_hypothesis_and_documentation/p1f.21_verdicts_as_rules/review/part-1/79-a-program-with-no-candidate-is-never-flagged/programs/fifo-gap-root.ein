;;; Review item 79: a copy of plans/wrong_answers/witnesses/fifo-gap-root.ein, unchanged below this header.

;;; Rule order decides root's fixpoint on a program the static check calls
;;; monotone — register row `W8/fifo-gap-root`
;;; (`plans/wrong_answers/register.toml`), open, F21's. Its twins are
;;; `fifo-gap-root-r1-first.ein`, the same program with `r1` written first,
;;; and `fifo-gap-root-negation.ein`, this order with `r1` also concluding a
;;; stored negation, which the agenda fires first.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `examples/lattice/10_fifo_gap.ein` with `a` and `b` both given, so that
;;; nothing is a candidate and the race is root's own. Two rules, each waiting
;;; on an `absent`: `r2` reads `q` under one, and `r1` derives `q`. The program
;;; is stratified: `r1`'s stratum comes before `r2`'s, and nothing derives `z`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `r1` derives `(q one)`, and `r2`'s guard `(absent (q one))` then fails: the
;;; perfect model is `(thing one) (a one) (b one) (q one)`, with no `p`, and the
;;; query has no row.
;;;
;;; ── What the engine answers ────────────────────────────────────────────
;;;
;;; The boundary admits the two waiting rules in the order they are written:
;;; `r2` derives `(p one)` under `(absent (q one))` before `r1` derives
;;; `(q one)`, and root holds a fact its own fixpoint's guard refutes. The
;;; query answers `?x = one`. The read-out says `lattice monotone (the static
;;; check)` and nothing else: the check is of what a commitment can change, and
;;; takes root as given.

(relation thing T :why "{?1} is a thing")
(relation a T :why "a holds of {?1}")
(relation b T :why "b holds of {?1}")
(relation p T :why "p holds of {?1}")
(relation q T :why "q holds of {?1}")
(relation z T :why "z holds of {?1}")

(thing one)
(a one)
(b one)

(rule r2 ()
  :match  (and (a ?x) (b ?x) (absent (q ?x)))
  :assert (p ?x)
  :why    "{?x} has a and b and no q")

(rule r1 ()
  :match  (and (a ?x) (absent (z ?x)))
  :assert (q ?x)
  :why    "{?x} has a and no z")

(solve :no-search)
(query :goal (p ?x))
