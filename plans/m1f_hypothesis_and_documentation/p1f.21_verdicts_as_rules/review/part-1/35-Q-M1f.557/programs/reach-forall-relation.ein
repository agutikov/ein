;; The same under std.macro's forall: for every declared relation, no fact of it is held beside its negation.
(import std.macro :symbols (forall))
(relation p Thing :why "p holds of {?3}")
(p a)
(not (p a))
(rule no-clash ()
  :match  (forall ?R (relation ?R ?l) (absent (and (?R ?a) (not (?R ?a)))))
  :assert (consistent)
  :why    "no declared relation holds a fact beside its negation")
(solve :no-search)
