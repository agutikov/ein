;;; Review item 82, step 3 of 6: step 2, and a rule shaped as `std.algebra`'s
;;; `imply1`, whose conclusion `(?R2 ?a)` has a parameter for its relation. Not a
;;; corpus file.
;;;
;;; Nothing activates `imply1`: no `(imply1 … …)` fact is written or derived, so
;;; it never fires. The program loads under ONE warning all the same, read off
;;; the text (Q-M1f.1): `(about-1 symmetric)` writes the rule name `symmetric` as
;;; an argument, so `imply1`'s `(?R2 ?a)` is read as able to write
;;; `(symmetric ?a)` (Q-M1f.42), and `?a`, the argument of `(?R1 ?a)`, as able to
;;; be a fact (Q-M1f.41). This is zebra2's warning in nine forms.
(relation next-to House House :why "{?3} is next to {?4}")
(next-to H1 H2)
(symmetric next-to)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}")

(rule imply1 (?R1 ?R2)
  :match  (?R1 ?a)
  :assert (?R2 ?a)
  :why    "(imply1 {?R1} {?R2}): {?R1}({?a}) → {?R2}({?a})")

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")
(about-1 symmetric)

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
