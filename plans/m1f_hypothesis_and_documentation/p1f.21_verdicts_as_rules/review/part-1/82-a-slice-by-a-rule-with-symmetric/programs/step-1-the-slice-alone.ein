;;; Review item 82, step 1 of 6: the slice by a rule, with nothing else. Not a corpus file.
;;;
;;; `about-1` takes a relation's name as its parameter `?F` and reads every fact
;;; `(?F ?r)` whose one argument `?r` is a declared relation: a fact *about* a
;;; relation. Its activator `(about-1 symmetric)` binds `?F` to the name
;;; `symmetric`, so it reads `(symmetric next-to)` and concludes
;;; `(in-slice-1 symmetric next-to)`. Here `symmetric` is a plain marker: no rule
;;; has that name. Loads with no warning.
(relation next-to House House :why "{?3} is next to {?4}")
(next-to H1 H2)
(symmetric next-to)

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")
(about-1 symmetric)

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
