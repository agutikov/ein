;;; Review item 82, step 5 of 6: step 3 with the slice asked of `bijective`, a
;;; marker no rule is named, in place of `symmetric`. Not a corpus file.
;;;
;;; No warning: `(about-1 bijective)` writes `bijective` as an argument, but no
;;; rule is named `bijective`, so `imply1`'s `(?R2 ?a)` reaches no rule's
;;; parameter through it. This is the twin `zebra2-about-1-bijective.ein`, whose
;;; `bijective` is a marker `std.bijection` reads (its rule is
;;; `bijective-setup`). The slice is `(in-slice-1 bijective next-to)`.
(relation next-to House House :why "{?3} is next to {?4}")
(next-to H1 H2)
(symmetric next-to)
(bijective next-to)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}")

(rule imply1 (?R1 ?R2)
  :match  (?R1 ?a)
  :assert (?R2 ?a)
  :why    "(imply1 {?R1} {?R2}): {?R1}({?a}) → {?R2}({?a})")

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")
(about-1 bijective)

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
