;;; Review item 82, step 6 of 6: step 3, and what the warning is about made to
;;; happen. Not a corpus file.
;;;
;;; `(imply1 item symmetric)` activates `imply1` with `?R1 = item`,
;;; `?R2 = symmetric`, and `(item (H1 H2))` gives it a fact as `?a`: root derives
;;; `(symmetric (H1 H2))`. That fact is an activator of the rule `symmetric`
;;; binding `?rel`, which names a relation, to the fact `(H1 H2)`. A relation is
;;; named by a symbol, so it activates nothing (Q-M1f.1): no plan of `symmetric`
;;; is compiled for it, its pattern would be `((H1 H2) ?a ?b)`, a fact in a
;;; relation's place. The state holds it as a fact, and a SECOND warning, placed
;;; at the rule, names the activator. The slice is unchanged: `(H1 H2)` is no
;;; declared relation, so `(relation ?r)` does not hold of it.
(relation next-to House House :why "{?3} is next to {?4}")
(relation item Thing :why "{?3} is an item")
(next-to H1 H2)
(symmetric next-to)
(item (H1 H2))

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}")

(rule imply1 (?R1 ?R2)
  :match  (?R1 ?a)
  :assert (?R2 ?a)
  :why    "(imply1 {?R1} {?R2}): {?R1}({?a}) → {?R2}({?a})")
(imply1 item symmetric)

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")
(about-1 symmetric)

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
