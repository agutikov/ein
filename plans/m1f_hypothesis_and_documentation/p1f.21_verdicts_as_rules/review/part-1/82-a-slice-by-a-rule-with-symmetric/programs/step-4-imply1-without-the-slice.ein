;;; Review item 82, step 4 of 6: step 3 without the activator
;;; `(about-1 symmetric)`, the rule `about-1` kept. Not a corpus file.
;;;
;;; No warning: nothing writes the rule name `symmetric` as an argument now (in
;;; `(symmetric next-to)` it is the relation, under the first arrow), so
;;; `imply1`'s `(?R2 ?a)` is read as able to reach no rule. This is
;;; `examples/zebra2.ein` as it is: it imports `std.algebra`, `imply1` among its
;;; rules, writes `(symmetric next-to)`, and loads with no warning. The slice is
;;; empty: nothing activates `about-1`.
(relation next-to House House :why "{?3} is next to {?4}")
(next-to H1 H2)
(symmetric next-to)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}")

(rule imply1 (?R1 ?R2)
  :match  (?R1 ?a)
  :assert (?R2 ?a)
  :why    "(imply1 {?R1} {?R2}): {?R1}({?a}) → {?R2}({?a})")

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
