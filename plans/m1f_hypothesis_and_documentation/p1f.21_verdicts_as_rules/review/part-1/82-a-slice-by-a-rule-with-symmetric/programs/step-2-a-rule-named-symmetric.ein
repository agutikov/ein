;;; Review item 82, step 2 of 6: step 1, and a rule named `symmetric`, as
;;; `std.algebra` has. Not a corpus file.
;;;
;;; `(symmetric next-to)` is now two things at once: a fact about `next-to`,
;;; which the slice reads, and the activator of the rule `symmetric`, which binds
;;; its parameter `?rel` to the name `next-to` and mirrors every `next-to` fact.
;;; Root derives `(next-to H2 H1)`. Still no warning: no rule concludes a fact
;;; whose relation is a parameter at the count of `symmetric`'s activator.
(relation next-to House House :why "{?3} is next to {?4}")
(next-to H1 H2)
(symmetric next-to)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}")

(rule about-1 (?F)
  :match  (and (?F ?r) (relation ?r))
  :assert (in-slice-1 ?F ?r)
  :why    "{?F} says something of {?r}")
(about-1 symmetric)

(query :goal (in-slice-1 ?f ?r))
(solve :no-search)
