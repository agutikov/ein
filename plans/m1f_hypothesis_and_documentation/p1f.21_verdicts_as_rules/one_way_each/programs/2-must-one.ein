;; MUST, said by an obligation: s of some thing is owed. One debt, and each thing a way to pay it.
(relation s Thing :why "s holds of {?3}")
(thing a) (thing b)
(other c)
(rule some-s-owed (?R)
  :match  (and (relation ?R ?T)
               (absent (and (thing ?x) (?R ?x))))
  :assert (open ?R)
  :why    "{?R} of some thing is owed.")
(some-s-owed s)
(query :goal (s ?x))
