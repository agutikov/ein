;; MAY written as a MUST: each thing owes a decision, yes or no, and yes means s.
(relation decide Thing Verdict :why "{?3} is decided {?4}")
(thing a) (thing b)
(other c)
(verdict yes) (verdict no)
(rule decision-owed (?R)
  :match  (and (relation ?R ?T ?V)
               (thing ?x)
               (absent (and (verdict ?v) (?R ?x ?v))))
  :assert (open ?R)
  :why    "{?R} owes {?x} a verdict.")
(decision-owed decide)
(rule one-verdict ()
  :match  (and (decide ?x yes) (decide ?x no))
  :assert (false)
  :why    "{?x} is decided both ways")
(rule yes-is-s ()
  :match  (decide ?x yes)
  :assert (s ?x)
  :why    "{?x} is decided yes")
(query :goal (s ?x))
