;;; Cell 1 of Q-M1f.568, the form that stays under either answer: a conjunction
;;; between the two, which is the universal. "Every q is a p" holds of the
;;; group whose members all are, and not of the other.

(q-of G1 A) (q-of G1 B) (p A) (p B)
(q-of G2 C) (q-of G2 D) (p C)
(group G1) (group G2)
(rule all-p ()
  :match  (and (group ?g) (absent (and (q-of ?g ?x) (absent (p ?x)))))
  :assert (all-p ?g)
  :why    "every member of {?g} is a p")
