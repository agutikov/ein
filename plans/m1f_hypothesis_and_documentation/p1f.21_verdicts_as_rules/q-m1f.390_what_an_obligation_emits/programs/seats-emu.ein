;;; `owed-seats` with both upper bounds — the sixth of the seven programs
;;; whose regions `ein-infer/tests/region.rs` pins (Q-M1e2.7).
;;;
;;; `examples/ein-bugs/wrong-answers/owed-seats.ein` states only the lower
;;; bounds (`total-owed`, `surjective-owed`), so its region is every set that
;;; covers both guests and both chairs: 7 nodes, the two matchings at the
;;; bottom and all four seatings at the top. Adding `functional` and
;;; `injective` kills every node with a clash, and what is left is the two
;;; matchings, each a component of its own and a point:
;;;
;;;   |R| = 2   minimal = maximal = {(seats Ann C1), (seats Bob C2)},
;;;                                 {(seats Ann C2), (seats Bob C1)}
;;;
;;; It is also the witness for the oracle's *saturation alone*: the commitment
;;; `{(seats Ann C1)}` owes 2 (Bob unseated, C2 empty). Read through a solve,
;;; the forced-positive cascade had already written `(seats Bob C2)` at root
;;; and the same commitment owed nothing.

(import std.algebra :symbols (total-owed surjective-owed functional injective))

(relation is-a   T T         :why "{?1} is a {?2}")
(relation seats  Guest Chair :why "{?1} is seated at {?2}")

(is-a Ann Guest) (is-a Bob Guest)
(is-a C1 Chair)  (is-a C2 Chair)

(total-owed      seats is-a)
(surjective-owed seats is-a)
(functional seats)
(injective  seats)

;; ── option (c) emulated, for this review: design.md Appendix A.2's rules for
;; std.algebra's two obligations, the requirement `due` from each trigger and the
;; payment `paid` from each trigger with its witness, activated as the program's
;; obligations are, beside the kernel's own obligations (kept, so both are read
;; on the same states). The instance is written under `total-owed-of` /
;; `surjective-owed-of`, heads of the emulation's own. Nothing here reads an
;; absence but `discharged-from-nothing-unpaid`, whose absence is nested.
(relation due  R J :why "{?1} is required to have {?2}")
(relation paid R J :why "{?1} has {?2}")
(relation discharged :why "the state owes nothing")
(rule total-due (?R ?isa)
  :match  (and (relation ?R ?A ?B) (?isa ?a ?A))
  :assert (due ?R (total-owed-of ?R ?isa ?A ?B ?a))
  :why    "{?R} is required to give {?a} a {?B}.")
(rule total-paid (?R ?isa)
  :match  (and (relation ?R ?A ?B) (?isa ?a ?A) (?isa ?b ?B) (?R ?a ?b))
  :assert (paid ?R (total-owed-of ?R ?isa ?A ?B ?a))
  :why    "{?R} gives {?a} the {?B} {?b}.")
(rule surjective-due (?R ?isa)
  :match  (and (relation ?R ?A ?B) (?isa ?b ?B))
  :assert (due ?R (surjective-owed-of ?R ?isa ?A ?B ?b))
  :why    "{?R} is required to give {?b} a preimage in {?A}.")
(rule surjective-paid (?R ?isa)
  :match  (and (relation ?R ?A ?B) (?isa ?b ?B) (?isa ?a ?A) (?R ?a ?b))
  :assert (paid ?R (surjective-owed-of ?R ?isa ?A ?B ?b))
  :why    "{?R} gives {?b} the preimage {?a}.")
(total-due seats is-a) (total-paid seats is-a)
(surjective-due seats is-a) (surjective-paid seats is-a)
(rule discharged-from-nothing-unpaid ()
  :match  (absent (and (due ?R ?j) (absent (paid ?R ?j))))
  :assert (discharged)
  :why    "every requirement is paid.")

(query :goal (seats ?g ?c))
