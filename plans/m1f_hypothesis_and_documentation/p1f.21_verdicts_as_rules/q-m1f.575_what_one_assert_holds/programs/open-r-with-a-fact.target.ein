;;; Item 53: an obligation's verdict in a conjunction with a fact.
;;; Refused today: `(open R)` is a rule's whole :assert.

(relation is-a  T T         :why "{?3} is a {?4}")
(relation seats Guest Chair :why "{?3} is seated at {?4}")
(is-a Ann Guest) (is-a C1 Chair)
(rule each-seated ()
  :match  (and (is-a ?a Guest) (absent (and (is-a ?b Chair) (seats ?a ?b))))
  :assert (and (open seats) (waiting ?a))
  :why    "{?a} has no chair.")
