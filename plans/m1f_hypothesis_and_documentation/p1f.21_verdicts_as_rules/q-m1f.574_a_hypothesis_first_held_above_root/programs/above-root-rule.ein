;;; Item 52: a rule with no `absent` that concludes a hypothesis from a fact
;;; only a commitment brings. `question` stands for `open`. A state that holds
;;; (chosen Tea) holds (question (with Tea Sugar)), which root does not.

(relation is-a   X T :why "{?3} is a {?4}")
(relation chosen D   :why "{?3} is chosen")
(relation with   D E :why "{?3} comes with {?4}")

(is-a Tea Drink) (is-a Milk Drink) (is-a Sugar Extra)

(rule ask-drink ()
  :match  (is-a ?d Drink)
  :assert (question (chosen ?d))
  :why    "is {?d} chosen?")
(rule ask-extra ()
  :match  (and (chosen ?d) (is-a ?e Extra))
  :assert (question (with ?d ?e))
  :why    "{?d} is chosen: does it come with {?e}?")

(hrule ask-chosen ()
  :match  (question (chosen ?x))
  :assert (chosen ?x)
  :why    "suppose (chosen {?x}): it is asked")
(hrule ask-with ()
  :match  (question (with ?x ?y))
  :assert (with ?x ?y)
  :why    "suppose (with {?x} {?y}): it is asked")
(solve :hrules (ask-chosen ask-with))
