  "Locked" -> "Unlocked" [label="coin", color="#e377c2", fontcolor="#e377c2", style=solid];
  "Locked" -> "Locked" [label="push", color="#17becf", fontcolor="#17becf", style=solid];
  "Unlocked" -> "Locked" [label="push", color="#17becf", fontcolor="#17becf", style=solid];
  "Unlocked" -> "Unlocked" [label="coin", color="#e377c2", fontcolor="#e377c2", style=solid];
}
