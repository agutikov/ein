;;; S1e2.4.1 probe — W3's `bad` rewritten monotone: q becomes a decision.
;;;
;;; `naf-upward-closure.ein` says "p requires q" as a refutation over an
;;; absence, `(and (p ?x) (absent (q ?x))) ⟹ (false)`, which judges a state
;;; that has not yet decided q as if q were false. Here q is a yes/no attribute
;;; the search must decide (`functional` + `total-owed`), and the refutation
;;; reads the decided "no". A state that has not decided q owes the decision;
;;; it is not dead. Every obligation is triggered by given facts and every
;;; refutation reads decided values only, so the program is monotone and route
;;; 1's licence (L1, dead is upward-closed) holds.
;;;
;;; R is W3's, one to one: {(q-val A no)} ↔ ∅, {(q-val A yes)} ↔ {(q A)},
;;; {(p A), (q-val A yes)} ↔ {(p A), (q A)}. The rewrite is mechanical for a
;;; relation the search guesses; a derived relation needs its negative derived
;;; (completion), which this file does not show.
;;;
;;;   ein solve  plans/m1e2_correctness/p1e2.4_what_the_switch_left/s1e2.4.1_probes/dual_rail.ein
;;;   ein oracle plans/m1e2_correctness/p1e2.4_what_the_switch_left/s1e2.4.1_probes/dual_rail.ein
;;;
;;; Taken 2026-11-02: 3 states, "monotone (the static check) — R is convex: no
;;; hole", `solve` by "route 1, the alive down-set — L1 dead is upward-closed";
;;; the oracle's cube agrees ("0 dead nodes with an alive superset").

(import std.algebra :symbols (functional total-owed))

(relation is-a  T T)
(relation p     T)
(relation q-val T Bool)

(is-a A T)
(is-a yes Bool) (is-a no Bool)

(functional q-val)            ; q is decided at most one way
(total-owed q-val is-a)       ; and it must be decided

(hrule guess-p () :match (is-a ?x T) :assert (p ?x))
(hrule guess-q () :match (and (is-a ?x T) (is-a ?v Bool)) :assert (q-val ?x ?v))

(rule bad ()
  :match  (and (p ?x) (q-val ?x no))
  :assert (false)
  :why    "{?x} has p and q decided no"
  :priority 200)

(solve
  :no-hypothesis (is-a)
  :expect (region
            (model (q-val A no))
            (model (q-val A yes))
            (model (p A) (q-val A yes))))

(query :goal (is-a ?x T))
