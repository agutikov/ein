;;; S1e2.1b.7 probe — option (E)'s rewrite of `examples/lattice/10_fifo_gap.ein`:
;;; the reader deleted.
;;;
;;; Under F21's D1 (E), r2's `(absent (q ?x))` is refused: `q` is derived from
;;; `a`, a candidate, so a commitment can extend it. In the program's perfect
;;; model r2 never fires (q ← a, so a ∧ b ∧ ¬q never holds), and deleting it
;;; leaves what the stratified reading derives. The program has no site and
;;; route 1 answers it.
;;;
;;; **It keeps R as `ein solve` prints the original's**, naming `a` and `b`:
;;; all four nodes. What moves is `{a, b}`'s state: today's holds the stale
;;; `(p one)` the FIFO gap leaves, and here it does not, as under admission in
;;; stratum order (node_census.md § 12.4). The query `(p ?x)` has one class
;;; here where the original has two.
;;;
;;; Re-take (2026-11-02):
;;;   ein test plans/m1e2_correctness/p1e2.1b_non_monotone_programs/s1e2.1b.7_probes/fifo_gap_without_r2.ein
(relation thing T)
(relation a T)
(relation b T)
(relation p T)
(relation q T)
(relation z T)

(thing one)

(hrule guess-a () :match (thing ?x) :assert (a ?x) :why "guess: (a {?x})?")
(hrule guess-b () :match (thing ?x) :assert (b ?x) :why "guess: (b {?x})?")

(rule r1 ()
  :match  (and (a ?x) (absent (z ?x)))
  :assert (q ?x)
  :why    "{?x} has a and no z"
  :priority 200)

(solve
  :expect (region
            (model)
            (model (a one))
            (model (b one))
            (model (a one) (b one))))

(query :goal (p ?x))
