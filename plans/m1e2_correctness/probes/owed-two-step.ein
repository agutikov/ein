;; probe: an owed instance whose two alternatives each die in TWO firings
(import std.algebra :symbols (total-owed))
(relation is-a  T T)
(relation likes Person Food)
(relation bad   Person)
(is-a Ann Person)
(is-a Soup Food)  (is-a Stew Food)
(total-owed likes is-a)
(rule taint () :match (likes ?p ?f) :assert (bad ?p) :priority 200)
(rule kill  () :match (bad ?p)      :assert (false)  :priority 300)
(query :goal (likes ?who ?what) :no-hypothesis (is-a bad))
