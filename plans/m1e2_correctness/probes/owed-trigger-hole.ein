;;; A hole with no `absent` in any saturation rule — P1e2.1b § What non-monotone means.
;;; `python3 plans/m1e2_correctness/probes/region.py plans/m1e2_correctness/probes/owed-trigger-hole.ein '(seats Ann C1)' '(meal Ann Soup)'`
;;; gives {(seats Ann C1)} owing 1 between ∅ and both facts, which are in R.
;;; Seating Ann derives (is-a Ann Diner), a debt total-owed did not have at ∅.
;;; The two hrules make the generator's root list exactly those two facts.

(import std.algebra :symbols (total-owed))
(relation is-a  T T)
(relation seats Guest Chair)
(relation meal  Diner Food)
(is-a Ann Guest) (is-a C1 Chair) (is-a Soup Food)
(rule seated-dines () :match (seats ?g ?c) :assert (is-a ?g Diner) :priority 200)
(total-owed meal is-a)
(hrule seat () :match (and (is-a ?g Guest) (is-a ?c Chair)) :assert (seats ?g ?c))
(hrule dine () :match (and (is-a ?g Guest) (is-a ?f Food))  :assert (meal ?g ?f))
(query :goal (meal ?g ?f))
