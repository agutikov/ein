(config :warn-derived-naf true)
(relation thing Thing)
(relation p Thing)
(relation q Thing)

(rule derive-p ()
  :match  (and (thing ?x) (absent (q ?x)))
  :assert (p ?x)
  :priority 200
  :why    "no q for {?x}, so p")

(rule derive-q ()
  :match  (and (thing ?x) (absent (p ?x)))
  :assert (q ?x)
  :priority 200
  :why    "no p for {?x}, so q")

(thing one :source "the only object")
