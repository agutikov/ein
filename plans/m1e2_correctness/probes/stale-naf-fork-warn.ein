(config :warn-derived-naf true)
;; probe: a root fact derived under (absent (q one)) survives into a world that commits (q one)
(relation thing T)
(relation p T)
(relation q T)
(thing one)
(rule derive-p ()
  :match  (and (thing ?x) (absent (q ?x)))
  :assert (p ?x)
  :priority 200)
(rule p-and-q-clash ()
  :match  (and (p ?x) (q ?x))
  :assert (false)
  :priority 300)
(query :goal (q ?x))
