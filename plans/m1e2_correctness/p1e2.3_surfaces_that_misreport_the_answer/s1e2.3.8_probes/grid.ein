;;; S1e2.3.8 probe: examples/branching/12_typed_blind_solve.ein with three
;;; names that are no SYMBOL ("x y", "1", "H 2") and a :source with a quote
;;; and a newline, for the grid, the classes, the claim and the DOT labels.
;;; The claim holds before the printer change and after it.
(import std.macro :symbols (forall unknown))
(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional: {?a} has both {?b} and {?c}."
  :priority 250)
(rule injective (?R)
  :match  (and (?R ?a ?c) (?R ?b ?c) (neq ?a ?b))
  :assert (false)
  :why    "{?R} not injective: {?c} reached from both {?a} and {?b}."
  :priority 250)
(rule functional-negative (?R)
  :match  (and (?R ?a ?b)
               (relation ?R ?A ?B)
               (is-a ?b_other ?B)
               (neq ?b_other ?b))
  :assert (not (?R ?a ?b_other))
  :why    "{?R} functional: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a} {?b_other}))."
  :priority 240)
(rule injective-negative (?R)
  :match  (and (?R ?a ?b)
               (relation ?R ?A ?B)
               (is-a ?a_other ?A)
               (neq ?a_other ?a))
  :assert (not (?R ?a_other ?b))
  :why    "{?R} injective: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a_other} {?b}))."
  :priority 240)
(rule derive-functional-negative ()
  :match  (functional ?R)
  :assert (functional-negative ?R)
  :why    "{?R} functional ⟹ functional-negative active."
  :priority 100)
(rule derive-injective-negative ()
  :match  (injective ?R)
  :assert (injective-negative ?R)
  :why    "{?R} injective ⟹ injective-negative active."
  :priority 100)
(rule domain-elimination (?R ?OT ?VT)
  :match  (and (functional ?R 0 1)
               (total      ?R 0)
               (is-a ?a ?OT)
               (is-a ?v ?VT)
               (forall ?v_other
                 (and (is-a ?v_other ?VT) (neq ?v_other ?v))
                 (not (?R ?a ?v_other))))
  :assert (?R ?a ?v)
  :priority 400
  :why    "every {?VT} except {?v} excluded for {?a} → ({?R} {?a} {?v})")
(rule no-room-left (?R ?OT ?VT)
  :match  (and (functional ?R 0 1)
               (total      ?R 0)
               (is-a ?a ?OT)
               (forall ?v
                 (is-a ?v ?VT)
                 (not (?R ?a ?v))))
  :assert (false)
  :priority 110
  :why    "{?a} has every {?VT} excluded — no value left")
(rule typecheck-arg-0 (?R ?Dom)
  :match  (and (?R ?a ?b) (absent (is-a ?a ?Dom)))
  :assert (false)
  :priority 110
  :why    "{?R} arg 0 expects {?Dom}; {?a} is not a {?Dom}")
(rule typecheck-arg-1 (?R ?Ran)
  :match  (and (?R ?a ?b) (absent (is-a ?b ?Ran)))
  :assert (false)
  :priority 110
  :why    "{?R} arg 1 expects {?Ran}; {?b} is not a {?Ran}")
(relation color-of House Color)
(relation is-a     T T)
(functional color-of)          ; violation-rule activator (2-arg)
(injective  color-of)
(functional color-of 0 1)       ; positional projection (domain-elim)
(total      color-of 0)
(domain-elimination color-of House Color)
(no-room-left       color-of House Color)
(typecheck-arg-0    color-of House)
(typecheck-arg-1    color-of Color)
(__closed__ is-a)
(is-a House T) (is-a Color T)
(is-a H1 House) (is-a "H 2" House) (is-a H3 House)
(is-a "x y" Color) (is-a Green Color) (is-a "1" Color)
(color-of H1 "x y" :source "(1) H1 is \"x y\"\nnext line")
(query :expect (or (model (color-of H1 "x y")) (model (color-of H1 "x y") (color-of "H 2" "1") (color-of H3 Green)) (model (color-of H1 "x y") (color-of "H 2" Green) (color-of H3 "1")))
  :goal (color-of ?h ?c))
