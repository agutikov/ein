;;; S1e2.3.8 probe: every kind of value a fact can hold, given, derived,
;;; committed and in a core. `pick` is the one candidate relation; a pick of
;;; anything but A or B is dead alone, its core naming the value.
(relation pick Node)
(is-a A Node) (is-a B Node)
(rule bad () :match (and (pick ?x) (weird ?x)) :assert (false))
(rule r () :match (pick A)
  :assert (and (holds 1) (holds "1") (holds -1) (holds "-1") (holds 007) (holds "007")
               (holds "x y") (holds "") (holds "a\"b") (holds "back\\slash")
               (holds "line\nbreak") (holds "tab\there") (holds "Åsa") (holds "(paren")
               (holds ";semi") (holds "?x") (holds "_") (holds "_x") (holds ":kw")
               (holds "1..5") (holds "1..*") (holds "=")
               (holds "not") (holds "and") (holds "or") (holds "neq") (holds "rule")
               (holds "hrule") (holds "query") (holds "solve") (holds "config")
               (holds "trace") (holds "macro") (holds "import")
               (holds "relation") (holds "open") (holds "false") (holds "model")
               (holds neqw) (holds "not-red") (holds "rule.x") (holds "neq-1")
               (holds a.b) (holds "#|") (holds "x|#") (holds __dunder__)))
(rule n () :match (pick B)
  :assert (and (nest (inner "x y" 1)) (nest (inner "1" -1)) (nest (not (pick "not")))))
(weird "1") (weird "-1") (weird "007") (weird "x y") (weird "") (weird "a\"b")
(weird "back\\slash") (weird "line\nbreak") (weird "tab\there") (weird "Åsa")
(weird "(paren") (weird ";semi") (weird "?x") (weird "_") (weird "_x") (weird ":kw")
(weird "1..5") (weird "1..*") (weird "=")
(weird "not") (weird "and") (weird "or") (weird "neq") (weird "rule") (weird "hrule")
(weird "query") (weird "solve") (weird "config") (weird "trace") (weird "macro")
(weird "import") (weird "relation") (weird "open") (weird "false") (weird "model")
(weird neqw) (weird "not-red") (weird "rule.x") (weird "neq-1") (weird a.b)
(weird "#|") (weird "x|#") (weird __dunder__)
(given 1 "1" ?v 1..5 1..* _ (inner "x y" 1))
