;;; S1e2.3.10 probe: a dead node whose core, its commitment, derives (false)
;;; through two rules; root is alive. `b-first` fires first (priority 100).
(relation is-a T T)
(relation p T :why "{?1} has p")
(relation q T :why "{?1} has q")
(is-a A Thing)
(rule a-second ()
  :match (and (p ?x) (q ?x))
  :assert (false)
  :priority 200)
(rule b-first ()
  :match (and (q ?x) (p ?x))
  :assert (false)
  :priority 100)
(hrule guess-p ()
  :match (is-a ?x Thing)
  :assert (p ?x))
(hrule guess-q ()
  :match (is-a ?x Thing)
  :assert (q ?x))
(solve :hrules (guess-p guess-q))
(query :goal (p ?x))
