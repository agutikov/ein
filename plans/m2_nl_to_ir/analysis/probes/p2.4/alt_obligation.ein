;;; a sentence with two readings, each a hypothesis; one is refuted; no reading is owed
(relation reading Sentence Reading :why "{?3} is read as {?4}")
(relation at Thing Place :why "{?3} is at {?4}")
(at fox h2 :source "the fox is in the second house")
(reading s7 left  :source "s7 may mean left of")
(reading s7 right :source "s7 may mean right of")
(relation reads Sentence Reading :why "{?3} is taken as {?4}")
(rule read-s7 ()
  :match  (reading s7 ?m)
  :assert (open (reads s7 ?m))
  :why    "suppose s7 is read as {?m}")
(rule one-reading ()
  :match  (and (reads ?s ?a) (reads ?s ?b) (neq ?a ?b))
  :assert (false)
  :why    "{?s} is read one way: not both {?a} and {?b}")
(rule left-impossible ()
  :match  (and (reads s7 left) (at fox h2))
  :assert (false)
  :why    "read as left, s7 puts the fox elsewhere than h2")
(query :goal (reads s7 ?m) :goal-text "s7 is read as {?m}")
(rule reading-owed ()
  :match  (and (reading s7 ?any) (absent (and (reading s7 ?m) (reads s7 ?m))))
  :assert (open reads)
  :why    "a reading of s7 is owed")
