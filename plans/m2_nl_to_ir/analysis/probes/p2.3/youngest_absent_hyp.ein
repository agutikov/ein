;; Probe: the same minimum beside hypotheses over `older` (the ambiguous sibling: one clue deleted).
(import std.algebra :symbols (transitive irreflexive))
(relation is-a T T :why "{?3} is a {?4}")
(relation older Person Person :why "{?3} is older than {?4}")
(relation youngest Person :why "{?3} is the youngest")
(transitive older)
(irreflexive older)
(is-a Ann Person) (is-a Bob Person) (is-a Carol Person)
(older Ann Bob :source "Ann is older than Bob.")
(rule guess-older ()
  :match (and (is-a ?x Person) (is-a ?y Person) (neq ?x ?y))
  :assert (open (older ?x ?y))
  :why "suppose {?x} is older than {?y}")
(rule youngest-is-older-than-nobody ()
  :match (and (is-a ?x Person) (absent (older ?x ?y)))
  :assert (youngest ?x)
  :why "{?x} is older than nobody, so {?x} is the youngest")
(query :goal (youngest ?who) :goal-text "{?who} is the youngest" :over maximal)
