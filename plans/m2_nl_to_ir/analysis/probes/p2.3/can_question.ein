;; Probe: "Every A is B. No B is C. x is A. Can x be C?" as a hypothesis the theory refutes.
(import std.algebra :symbols (transitive))
(relation is-a T T :why "{?3} is a {?4}")
(relation subclass Class Class :why "every {?3} is a {?4}")
(relation disjoint Class Class :why "no {?3} is a {?4}")
(subclass A B :source "Every A is B.")
(disjoint B C :source "No B is C.")
(is-a x A :source "x is A.")
(rule up ()
  :match (and (is-a ?x ?c) (subclass ?c ?d))
  :assert (is-a ?x ?d)
  :why "{?x} is a {?c} and every {?c} is a {?d}")
(rule clash ()
  :match (and (is-a ?x ?c) (is-a ?x ?d) (disjoint ?c ?d))
  :assert (false)
  :why "{?x} cannot be both a {?c} and a {?d}")
(open (is-a x C))
(query :goal (is-a x C) :goal-text "x can be C" :over maximal
       :expect (model))
