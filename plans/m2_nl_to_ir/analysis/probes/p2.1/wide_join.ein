;;; a wide join that never fires: a cycle of five edges asked of a complete
;;; bipartite graph, which has no cycle of odd length, so the join walks every
;;; path of four edges and the rule concludes nothing
(relation left N :why "{?3} is on the left")
(relation right N :why "{?3} is on the right")
(relation edge N N :why "{?3} is joined to {?4}")
(relation five-cycle N N N N N :why "{?3} to {?7} close a cycle of five")
(rule join ()
  :match (and (left ?a) (right ?b))
  :assert (and (edge ?a ?b) (edge ?b ?a))
  :why "every left node is joined to every right one")
(rule cycle ()
  :match (and (edge ?a ?b) (edge ?b ?c) (edge ?c ?d) (edge ?d ?e) (edge ?e ?a))
  :assert (five-cycle ?a ?b ?c ?d ?e)
  :why "{?a} {?b} {?c} {?d} {?e} close a cycle of five")
(solve :no-search)
