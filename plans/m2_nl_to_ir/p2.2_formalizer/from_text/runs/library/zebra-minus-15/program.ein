;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.

(instance House1 House :source "There are five houses.")
(instance House2 House :source "There are five houses.")
(instance House3 House :source "There are five houses.")
(instance House4 House :source "There are five houses.")
(instance House5 House :source "There are five houses.")

(lives-in Englishman RedHouse :source "The Englishman lives in the red house.")
(owns Spaniard Dog :source "The Spaniard owns the dog.")
(drinks Coffee GreenHouse :source "Coffee is drunk in the green house.")
(drinks Ukrainian Tea :source "The Ukrainian drinks tea.")
(is-immediately-to-the-right-of GreenHouse IvoryHouse
  :source "The green house is immediately to the right of the ivory house.")
(owns OldGold Snails :source "The Old Gold smoker owns snails.")
(smokes Kools YellowHouse :source "Kools are smoked in the yellow house.")
(drinks Milk MiddleHouse :source "Milk is drunk in the middle house.")
(lives-in Norwegian House1 :source "The Norwegian lives in the first house.")
(lives-in ChesterfieldsHouse FoxOwner :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(smokes Kools HorseKeeperHouse :source "Kools are smoked in the house next to the house where the horse is kept.")
(drinks LuckyStrike OrangeJuice :source "The Lucky Strike smoker drinks orange juice.")
(smokes Japanese Parliaments :source "The Japanese smokes Parliaments.")

;; Who drinks water? Who owns the zebra?
(query
  :goal (and (drinks ?who Water) (owns ?who Zebra))
  :goal-text "{?who} drinks water. {?who} owns the zebra.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's declarations, completed with relations the theory reads.
(relation instance T T :why "{?3} is a {?4}")
(relation type T T :why "{?3} is a kind of {?4}")
(relation lives-in Person House :why "a {?3} lives in a {?4}")
(relation owns Person Thing :why "a {?3} owns a {?4}")
(relation drinks Person Thing :why "a {?3} drinks a {?4}")
(relation is-immediately-to-the-right-of House House :why "a {?3} is immediately to the right of a {?4}")
(relation smokes Person Thing :why "a {?3} smokes a {?4}")
(relation has Person Thing :why "a {?3} has a {?4}")
(relation house-and-color House Color :why "a {?3} and a {?4}")
(relation house-and-thing House Thing :why "a {?3} and a {?4}")
(relation house-and-person House Person :why "a {?3} and a {?4}")
(relation house-and-smoke House Thing :why "a {?3} and a {?4}")
(relation house-and-drink House Thing :why "a {?3} and a {?4}")
(relation house-and-owner House Person :why "a {?3} and a {?4}")
(relation house-and-neighbor House House :why "a {?3} and a {?4}")

;; The kinds, and their place.
(type Attribute T)
(type House Attribute)
(type Person Attribute)
(type Thing Attribute)
(type Color Attribute)
(type Drink Attribute)
(type Smoke Attribute)
(type Owner Attribute)

;; What kind of thing each name is: step 1's memberships.
(instance House1 House :source "There are five houses.")
(instance House2 House :source "There are five houses.")
(instance House3 House :source "There are five houses.")
(instance House4 House :source "There are five houses.")
(instance House5 House :source "There are five houses.")
(instance Englishman Person :source "The Englishman lives in the red house.")
(instance RedHouse House :source "The Englishman lives in the red house.")
(instance Spaniard Person :source "The Spaniard owns the dog.")
(instance Dog Thing :source "The Spaniard owns the dog.")
(instance Coffee Drink :source "Coffee is drunk in the green house.")
(instance GreenHouse House :source "Coffee is drunk in the green house.")
(instance Ukrainian Person :source "The Ukrainian drinks tea.")
(instance Tea Drink :source "The Ukrainian drinks tea.")
(instance IvoryHouse House :source "The green house is immediately to the right of the ivory house.")
(instance OldGold Smoke :source "The Old Gold smoker owns snails.")
(instance Snails Thing :source "The Old Gold smoker owns snails.")
(instance Kools Smoke :source "Kools are smoked in the yellow house.")
(instance YellowHouse House :source "Kools are smoked in the yellow house.")
(instance Milk Drink :source "Milk is drunk in the middle house.")
(instance MiddleHouse House :source "Milk is drunk in the middle house.")
(instance Norwegian Person :source "The Norwegian lives in the first house.")
(instance House1 House :source "The Norwegian lives in the first house.")
(instance ChesterfieldsSmoke Smoke :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(instance FoxOwner Person :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(instance HorseThing Thing :source "Kools are smoked in the house next to the house where the horse is kept.")
(instance HorseKeeperHouse House :source "Kools are smoked in the house next to the house where the horse is kept.")
(instance LuckyStrike Smoke :source "The Lucky Strike smoker drinks orange juice.")
(instance OrangeJuice Drink :source "The Lucky Strike smoker drinks orange juice.")
(instance Japanese Person :source "The Japanese smokes Parliaments.")
(instance Parliaments Smoke :source "The Japanese smokes Parliaments.")
(instance Water Drink :source "Who drinks water?")
(instance Zebra Thing :source "Who owns the zebra?")

;; The row the text speaks of and never states.
(is-immediately-to-the-right-of House1 House2)
(is-immediately-to-the-right-of House2 House3)
(is-immediately-to-the-right-of House3 House4)
(is-immediately-to-the-right-of House4 House5)

;; The theory: algebra and slots.
(import std.algebra :symbols (symmetric includes converse top meet))
(import std.slots)

;; Relations are parts of same-house or neighbor relations.
(includes lives-in same-house)
(includes owns same-house)
(includes drinks same-house)
(includes smokes same-house)
(includes is-immediately-to-the-right-of house-and-neighbor)
(includes house-and-color same-house)
(includes house-and-thing same-house)
(includes house-and-person same-house)
(includes house-and-smoke same-house)
(includes house-and-drink same-house)
(includes house-and-owner same-house)

(symmetric same-house)

;; The classes of same-house are the houses, each holding one value of every kind.
(slot-partition same-house instance type Attribute House)

;; ---- step 3: the rest of the theory and the hypothesis mechanism

;; The read-back that makes the answer query answerable. Where a value is,
;; in the verb of its kind: a person lives in the house it shares, drinks
;; what is drunk in it, smokes what is smoked in it, owns what it owns,
;; and a house has the colour it shares, the thing it owns, the person it
;; lives with, the smoke it smokes, the drink it has, the owner it has,
;; and the neighbor it has.
(top  house-and-color instance House Color)
(meet same-house house-and-color house-and-drink)
(meet same-house house-and-color house-and-smoke)
(meet same-house house-and-color house-and-thing)
(meet same-house house-and-color house-and-owner)
(meet same-house house-and-color house-and-neighbor)

(top  house-and-thing instance House Thing)
(meet same-house house-and-thing house-and-owner)

(top  house-and-person instance House Person)
(meet same-house house-and-person house-and-neighbor)

(top  house-and-smoke instance House Smoke)
(meet same-house house-and-smoke house-and-neighbor)

(top  house-and-drink instance House Drink)
(meet same-house house-and-drink house-and-neighbor)

(top  house-and-owner instance House Owner)
(meet same-house house-and-owner house-and-neighbor)

;; A neighbor relation is symmetric.
(symmetric house-and-neighbor)

;; The hypothesis mechanism: the obligations of the theory step 2 selected.
