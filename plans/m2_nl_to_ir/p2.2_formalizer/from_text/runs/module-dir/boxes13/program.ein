;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(has Bob (n z 5) Apple :source "Bob has 5 apples, Alice has 8.")
(has Alice (n z 8) :source "Bob has 5 apples, Alice has 8.")
(holds Box (n z 3) :source "A box holds 3.")

;; How many boxes do they need?
(query :goal (need-boxes Bob Alice ?n) :goal-text "They need {?n} boxes.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's declarations, completed with the theory's
;; relations and kinds.

(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation holds Thing Number :why "a {?3} holds a {?4}")
(relation need-boxes Person Person Number :why "a {?3} and a {?4} need {?5} boxes")
(relation capacity Thing Number :why "a {?3} has a capacity of {?4}")

;; The kinds, and their place.
(type Thing T)
(type Number T)

;; The theory: the calculator, which gives the numerals their meaning.
(import std.math.decimal-arith :symbols (add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; The sum of apples is the total need.
;; (has Bob ?a Apple) (has Alice ?b)
;; (add ?a ?b ?total)
;; (need-boxes Bob Alice ?n)
;; (capacity Box ?c)
;; (div ?total ?c ?n)
