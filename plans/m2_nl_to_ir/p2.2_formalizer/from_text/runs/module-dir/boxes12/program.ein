;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(has Bob (n z 5) Apple :source "Bob has 5 apples, Alice has 7.")
(has Alice (n z 7) :source "Bob has 5 apples, Alice has 7.")
(holds Box (n z 3) :source "A box holds 3.")

;; How many boxes do they need?
(query :goal (need-boxes Bob Alice ?n) :goal-text "They need {?n} boxes.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's declarations, and what the theory reads the
;; verbs into, and the kinds.

(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation holds Thing Number :why "a {?3} holds a {?4}")
(relation need-boxes Person Person Number :why "a {?3} and a {?4} need a {?5} boxes")
(relation total Person Number :why "a {?3} has a {?4} of {?3}s")
(relation sum-of Number Number Number :why "{?3} plus {?4} is {?5}")
(relation div Number Number Number Number :why "{?3} divided by {?4} is {?5} with {?6} left")
(relation cmp-of Number Number Number :why "{?3} compared to {?4} is {?5}")

;; The kinds, and their place.
(type Number T)
(type Thing T)
(type Person T)

;; What kind of thing each name is: step 1's memberships.
(instance Bob Person :source "Bob has 5 apples, Alice has 7.")
(instance Alice Person :source "Bob has 5 apples, Alice has 7.")
(instance Apple Thing :source "Bob has 5 apples, Alice has 7.")
(instance Box Thing :source "A box holds 3.")

;; The theory: the calculator, which gives the numerals their meaning.
(import std.math.decimal-arith :symbols (add sum-of div quot-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; Total apples needed is the sum of what Bob has and what Alice has.
(total-owed has sum-of)

;; ---- step 3: the rest of the theory and the hypothesis mechanism

;; missing: the total needed is the sum of what they have, asked of the calculator
(rule total-asks-the-sum ()
  :match  (and (has ?p1 ?n1 ?t1) (has ?p2 ?n2 ?t2))
  :assert (add ?n1 ?n2)
  :why    "{?p1} has {?n1} and {?p2} has {?n2}: ask {?n1} plus {?n2}")

;; missing: the quotient of the total and the capacity is the number of boxes, read back as the answer
(rule total-is-the-quotient ()
  :match  (and (has ?p1 ?n1 ?t1) (has ?p2 ?n2 ?t2) (sum-of ?n1 ?n2 ?s) (div ?s ?c ?q ?r))
  :assert (need-boxes ?p1 ?p2 ?q)
  :why    "{?n1} and {?n2} make {?s}; {?s} divided by {?c} is {?q} with {?r} left, so {?p1} and {?p2} need {?q} boxes")

;; The hypothesis mechanism: none; the text states every fact there is.
(solve :no-search)
