;; The statements, in the text's own words.
(has Bob (n z 5) Apple :source "Bob has 5 apples.")
(has Alice (n z 7) Apple :source "Alice has 7 apples.")
(has Carol (n z 9) Apple :source "Carol has 9 apples and a box that holds 3.")
(has Carol (n z 3) Box :source "Carol has 9 apples and a box that holds 3.")
(gave Bob (n z 2) Apple Alice :source "Bob gave 2 apples to Alice.")

;; How many apples does Bob have?
(query :goal (has Bob ?n Apple) :goal-text "Bob has {?n} apples.")

;; The ontology, partial.
(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation has Person Number Box :why "a {?3} has a {?4} of {?5}s")
(relation gave Person Number Thing Person :why "a {?3} gave a {?4} of {?5}s to a {?6}")
