;; ---- the whole program, in one call

;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(has Bob (n z 5) Apple :source "Bob has 5 apples.")
(has Alice (n z 7) Apple :source "Alice has 7 apples.")
(has Carol (n z 9) Apple :source "Carol has 9 apples.")
(has Carol (n z 3) Box :source "Carol has a box that holds 3.")
(gave Bob (n z 2) Alice Apple :source "Bob gave 2 apples to Alice.")

;; How many apples does Bob have?
(query :goal (has Bob ?n Apple) :goal-text "Bob has {?n} apples.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's declarations, and what the theory reads the
;; verbs into, and the kinds.

(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation gave Person Number Person Thing :why "a {?3} gave a {?4} of {?5}s to a {?6}")
(relation instance T T :why "{?3} is a {?4}")
(relation type T T :why "{?3} is a kind of {?4}")

;; The kinds, and their place.
(type Apple T)
(type Box T)
(type Person T)
(type Number T)

;; What kind of thing each name is: step 1's memberships.
(instance Bob Person :source "Bob has 5 apples.")
(instance Alice Person :source "Alice has 7 apples.")
(instance Carol Person :source "Carol has 9 apples.")
(instance Apple T :source "Bob has 5 apples.")
(instance Box T :source "Carol has a box that holds 3.")

;; The theory: the calculator, which gives the numerals their meaning.
(import std.math.decimal-arith :symbols (sub diff-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; ---- step 3: the rest of the theory and the hypothesis mechanism

;; missing: the number of apples Bob has is the initial amount minus the given amount,
;; asked of the calculator.
(rule bob-apples-asks-the-difference ()
  :match  (and (has Bob ?a Apple) (gave Bob ?b Alice Apple))
  :assert (sub ?a ?b)
  :why    "Bob has {?a} apples and gave {?b} apples: ask {?a} less {?b}")

;; missing: the difference, read back as the remaining amount Bob has.
(rule bob-apples-is-the-difference ()
  :match  (and (has Bob ?a Apple) (gave Bob ?b Alice Apple) (diff-of ?a ?b ?d z))
  :assert (has Bob ?d Apple)
  :why    "{?a} less {?b} is {?d}, so Bob has {?d} apples")

;; The hypothesis mechanism: none; the text states every fact there is.
(solve :no-search)
