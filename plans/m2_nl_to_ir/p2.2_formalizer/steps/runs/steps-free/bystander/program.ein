;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(has Bob (n z 5) Apple :source "Bob has 5 apples.")
(has Carol (n z 9) Apple :source "Carol has 9 apples.")
(gave Bob (n z 2) Apple Alice :source "Bob gave 2 apples to Alice.")

;; How many apples does Carol have?
(query :goal (has Carol ?n Apple) :goal-text "Carol has {?n} apples.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's, complete as it stands.
(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation gave Person Number Thing Person :why "a {?3} gave a {?4} of {?5}s to a {?6}")

;; The theory: the calculator, which gives the numerals their meaning.
(import std.math.decimal-arith :symbols (sub diff-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; ---- step 3: the rest of the theory and the hypothesis mechanism

;; missing: the number of apples Carol has is the number she started with minus the number Bob gave her, asked of the calculator
(rule carol-has-asks-the-difference ()
  :match  (and (has Carol ?c ?t) (gave Bob ?g ?t ?a) (neq ?c ?a))
  :assert (sub ?c ?g)
  :why    "Carol has {?c} and Bob gave {?g}: ask {?c} less {?g}")
;; missing: the difference, read back as Carol's new count
(rule carol-has-is-the-difference ()
  :match  (and (has Carol ?c ?t) (gave Bob ?g ?t ?a) (diff-of ?c ?g ?d z))
  :assert (has Carol ?d ?t)
  :why    "{?c} less {?g} is {?d}, so Carol has {?d} now")

;; The hypothesis mechanism: none; the text states every fact there is.
(solve :no-search)
