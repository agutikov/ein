;; The statements, in the text's own words.
(has  School (n z 12) Box :source "A school has 12 boxes of pencils, 144 pencils in each.")
(has  Box (n z 144) Pencil :source "A school has 12 boxes of pencils, 144 pencils in each.")
(go-to-office Pencil (n z 250) :source "250 pencils go to the office.")
(shared Pencil Class :source "The rest is shared equally among 31 classes.")
(count Classes 31 :source "The rest is shared equally among 31 classes.")

;; How many pencils does each class get, and how many are left over?
(query
  :goal (and (count ?penc-per-class Class) (count ?left-over Class))
  :goal-text "{?penc-per-class} pencils per class, {?left-over} left over.")

;; The ontology, partial.
(relation has  Thing Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation go-to-office Thing Number :why "a {?3} goes to the office")
(relation shared Thing Class :why "a {?3} is shared among a {?4}")
(relation count Thing Number :why "there are {?3} of a {?4}")
