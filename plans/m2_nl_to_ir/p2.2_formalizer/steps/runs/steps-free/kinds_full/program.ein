;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(has Bob (n z 5) Apple)
(has Bob (n z 2) Pear)
(has Alice (n z 3) Apple)
(has Alice (n z 4) Pear)

;; How many apples do they have together?
(query :goal (sum-of-apples Bob Alice ?n) :goal-text "They have {?n} apples together.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's, complete as it stands.
(relation has Person Number Thing :why "a {?3} has a {?4} of {?5}s")
(relation sum-of-apples Person Person Number :why "a {?3} and a {?4} have a {?5} apples together")

;; The theory: the calculator, which gives the numerals their meaning.
(import std.math.decimal-arith :symbols (add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; ---- step 3: the rest of the theory and the hypothesis mechanism

;; missing: the sum of apples, asked of the calculator
(rule apples-asks-the-sum ()
  :match  (and (has ?p1 ?n1 Apple) (has ?p2 ?n2 Apple))
  :assert (add ?n1 ?n2)
  :why    "{?p1} has {?n1} and {?p2} has {?n2}: ask {?n1} plus {?n2}")

;; missing: the sum, read back as the total apples
(rule apples-is-the-sum ()
  :match  (and (has ?p1 ?n1 Apple) (has ?p2 ?n2 Apple) (sum-of-apples ?p1 ?p2 ?s))
  :assert (sum-of ?n1 ?n2 ?s)
  :why    "{?n1} plus {?n2} is {?s}, so {?p1} and {?p2} have {?s} apples together")

;; The hypothesis mechanism: none; the text states every fact there is.
(solve :no-search)
