;; ---- step 1: the statements and the answer query

;; The statements, in the text's own words.
(instance House-1 House)
(instance House-2 House)
(instance House-3 House)
(instance House-4 House)
(instance House-5 House)
(source "There are five houses.")

(instance Englishman Person)
(instance Spaniard Person)
(instance Ukrainian Person)
(instance Norwegian Person)
(instance Japanese Person)
(instance OldGold Smoker)
(instance Kools Smoker)
(instance LuckyStrike Smoker)
(instance Chesterfields Smoker)
(instance Parliaments Smoker)
(instance Red Color)
(instance Green Color)
(instance Ivory Color)
(instance Yellow Color)
(instance Blue Color)
(instance Milk Drink)
(instance Coffee Drink)
(instance Tea Drink)
(instance OrangeJuice Drink)
(instance Water Drink)
(instance Dog Animal)
(instance Snail Animal)
(instance Fox Animal)
(instance Horse Animal)
(instance Zebra Animal)
(source "The Englishman lives in the red house.")
(source "The Spaniard owns the dog.")
(source "Coffee is drunk in the green house.")
(source "The Ukrainian drinks tea.")
(source "The green house is immediately to the right of the ivory house.")
(source "The Old Gold smoker owns snails.")
(source "Kools are smoked in the yellow house.")
(source "Milk is drunk in the middle house.")
(source "The Norwegian lives in the first house.")
(source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(source "Kools are smoked in the house next to the house where the horse is kept.")
(source "The Lucky Strike smoker drinks orange juice.")
(source "The Japanese smokes Parliaments.")
(source "The Norwegian lives next to the blue house.")

;; Who drinks water? Who owns the zebra?
(query
  :goal (and (drinks ?who Water) (owns ?who Zebra))
  :goal-text "{?who} drinks water. {?who} owns the zebra.")

;; ---- step 2: the ontology whole, the imports and the selection

;; The ontology, whole: step 1's declarations, and what the theory reads the
;; verbs into, and the kinds.

(relation instance T T :why "{?3} is a {?4}")
(relation type T T :why "{?3} is a kind of {?4}")
(relation person-and-person Person Person :why "a {?3} and a {?4}")
(relation house-and-house House House :why "a {?3} and a {?4}")
(relation color-and-color Color Color :why "a {?3} and a {?4}")
(relation drink-and-drink Drink Drink :why "a {?3} and a {?4}")
(relation animal-and-animal Animal Animal :why "a {?3} and a {?4}")
(relation smoker-and-smoker Smoker Smoker :why "a {?3} and a {?4}")
(relation owns Person Animal :why "a {?3} owns a {?4}")
(relation drinks Person Drink :why "a {?3} drinks a {?4}")
(relation smokes Person Smoker :why "a {?3} smokes a {?4}")
(relation lives Person House :why "a {?3} lives in a {?4}")
(relation is-immediately-to-the-right-of House House :why "a {?3} is immediately to the right of a {?4}")
(relation is-immediately-to-the-left-of House House :why "a {?3} is immediately to the left of a {?4}")
(relation next-to House House :why "a {?3} is next to a {?4}")
(relation smokes-with Person Smoker :why "a {?3} smokes with a {?4}")
(relation smokes-with Smoker Person :why "a {?3} smokes with a {?4}")
