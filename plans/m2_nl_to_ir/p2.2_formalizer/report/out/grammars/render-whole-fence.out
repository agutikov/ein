m-claim-5 ::= m-gap m-model m-claim-5 |
            m-gap ")"

# ein.y: Model
m-model ::= "(" m-model-1

m-model-1 ::= m-gap "model" m-model-2

m-model-2 ::= m-gap m-claim-fact m-model-3 |
            m-gap ")"

m-model-3 ::= m-gap m-claim-fact m-model-3 |
            m-gap ")"

# ein.y: ClaimFact
m-claim-fact ::= m-claim-nested |
               m-eq-fact |
               m-neg-fact |
               "(" m-claim-fact-1 |
               "(" m-claim-fact-2 |
               "(" m-claim-fact-3

m-claim-fact-1 ::= m-gap "not" m-claim-fact-4

m-claim-fact-2 ::= m-gap "absent" m-claim-fact-5

m-claim-fact-3 ::= m-gap "neq" m-claim-fact-6

m-claim-fact-4 ::= m-gap m-eq-fact m-claim-fact-7

m-claim-fact-5 ::= m-gap m-claim-atom m-claim-fact-7

m-claim-fact-6 ::= m-gap-word m-name m-claim-fact-8 |
                 m-gap m-nested-fact m-claim-fact-9 |
                 m-gap m-neg-fact m-claim-fact-9

m-claim-fact-7 ::= m-gap ")"

m-claim-fact-8 ::= m-gap-word m-name m-claim-fact-10 |
                 m-gap m-nested-fact m-claim-fact-7 |
                 m-gap m-neg-fact m-claim-fact-7

m-claim-fact-9 ::= m-gap m-name m-claim-fact-10 |
                 m-gap m-nested-fact m-claim-fact-7 |
                 m-gap m-neg-fact m-claim-fact-7

m-claim-fact-10 ::= m-gap ")"

# ein.y: ClaimAtom
m-claim-atom ::= m-claim-nested |
               m-eq-fact |
               m-neg-fact |
               "(" m-claim-atom-1

m-claim-atom-1 ::= m-gap "not" m-claim-atom-2

m-claim-atom-2 ::= m-gap m-eq-fact m-claim-atom-3

m-claim-atom-3 ::= m-gap ")"

# ein.y: ClaimNested
m-claim-nested ::= "(" m-claim-nested-1 |
                 "(" m-claim-nested-2

m-claim-nested-1 ::= m-gap m-ordinary-head m-claim-nested-3

m-claim-nested-2 ::= m-gap "false" m-claim-nested-4

m-claim-nested-3 ::= m-gap-word m-name m-claim-nested-3 |
                   m-gap m-nested-fact m-claim-nested-5 |
                   m-gap m-neg-fact m-claim-nested-5 |
                   m-gap ")"

m-claim-nested-4 ::= m-gap ")"

m-claim-nested-5 ::= m-gap m-name m-claim-nested-3 |
                   m-gap m-nested-fact m-claim-nested-5 |
                   m-gap m-neg-fact m-claim-nested-5 |
                   m-gap ")"

# ein.y: Solve
m-solve ::= "(" m-solve-1

m-solve-1 ::= m-gap "solve" m-solve-2

m-solve-2 ::= m-gap-word ":hypothesis-relations" m-solve-3 |
            m-gap-word ":no-hypothesis" m-solve-3 |
            m-gap-word ":no-search" m-solve-2 |
            m-gap-word ":expect" m-solve-4 |
            m-gap ")"

m-solve-3 ::= m-gap m-name-list m-solve-5

m-solve-4 ::= m-gap m-region-claim m-solve-5

m-solve-5 ::= m-gap ":hypothesis-relations" m-solve-3 |
            m-gap ":no-hypothesis" m-solve-3 |
            m-gap ":no-search" m-solve-2 |
            m-gap ":expect" m-solve-4 |
            m-gap ")"

# ein.y: RegionClaim
m-region-claim ::= "(" m-region-claim-1 |
                 "(" m-region-claim-2

m-region-claim-1 ::= m-gap "region" m-region-claim-3

m-region-claim-2 ::= m-gap "false" m-region-claim-4

m-region-claim-3 ::= m-gap m-region-item m-region-claim-5 |
                   m-gap ")"

m-region-claim-4 ::= m-gap ")"

m-region-claim-5 ::= m-gap m-region-item m-region-claim-5 |
                   m-gap ")"

# ein.y: RegionItem
m-region-item ::= m-model |
                "(" m-region-item-1 |
                "(" m-region-item-2

m-region-item-1 ::= m-gap "merged" m-region-item-3

m-region-item-2 ::= m-gap "owing" m-region-item-4

m-region-item-3 ::= m-gap m-model m-region-item-5

m-region-item-4 ::= m-gap m-model m-region-item-6

m-region-item-5 ::= m-gap m-merged-from m-region-item-7

m-region-item-6 ::= m-gap m-model m-region-item-6 |
                  m-gap ")"

m-region-item-7 ::= m-gap ")"

# ein.y: MergedFrom
m-merged-from ::= m-model |
                "(" m-merged-from-1

m-merged-from-1 ::= m-gap "or" m-merged-from-2

m-merged-from-2 ::= m-gap m-model m-merged-from-3

m-merged-from-3 ::= m-gap m-model m-merged-from-3 |
                  m-gap ")"

# ein.y: Import
m-import ::= "(" m-import-1

m-import-1 ::= m-gap "import" m-import-2

m-import-2 ::= m-gap-word m-name m-import-3

m-import-3 ::= m-gap-word ":symbols" m-import-4 |
             m-gap-word ":as" m-import-5 |
             m-gap ")"

m-import-4 ::= m-gap m-name-list-plus m-import-6

m-import-5 ::= m-gap-word m-decl-name m-import-3

m-import-6 ::= m-gap ":symbols" m-import-4 |
             m-gap ":as" m-import-5 |
             m-gap ")"

