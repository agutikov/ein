# The grammar of step 2 of the formalization, rendered by EinAf for one request.
# Its forms are Ein's grammar's, restricted to the step's; its layout is the model's.

# the step's forms, comment lines before and after them
root ::= ( comment nl )* body ( nl comment )*

# step 2: the ontology whole, then the imports, then the selection; no rule
body ::= ontology ( nl imports )? ( nl selection )? |
       imports ( nl selection )? |
       selection

ontology ::= onto-form ( nl onto-form )*

onto-form ::= decl |
            onto-fact

onto-fact ::= "(" m-name args ( sp ":source" sp source )? ")"

imports ::= import ( nl import )*

selection ::= select ( nl select )*

select ::= activator

# an activating fact of the catalogue, at its count, over any names
activator ::= "(add-answer" sp m-name sp m-name sp m-name ")" |
            "(add-ask" sp m-name sp m-name sp m-name ")" |
            "(add-ask-second" sp m-name sp m-name sp m-name sp m-name ")" |
