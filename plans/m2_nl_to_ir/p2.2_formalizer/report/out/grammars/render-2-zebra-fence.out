# an import of a module of the catalogue, listing names it declares
import ::= "(import" sp ( "std.algebra" ( sp ":symbols" sp "(" symbol-1 ( sp symbol-1 )* ")" )? | "std.bijection" ( sp ":symbols" sp "(" symbol-2 ( sp symbol-2 )* ")" )? | "std.bool.circuit" ( sp ":symbols" sp "(" symbol-3 ( sp symbol-3 )* ")" )? | "std.bool.gates" ( sp ":symbols" sp "(" symbol-4 ( sp symbol-4 )* ")" )? | "std.bool.inputs" ( sp ":symbols" sp "(" symbol-5 ( sp symbol-5 )* ")" )? | "std.bool.props" ( sp ":symbols" sp "(" symbol-6 ( sp symbol-6 )* ")" )? | "std.closure" ( sp ":symbols" sp "(" symbol-7 ( sp symbol-7 )* ")" )? | "std.contradiction" ( sp ":symbols" sp "(" symbol-8 ( sp symbol-8 )* ")" )? | "std.debts" ( sp ":symbols" sp "(" symbol-9 ( sp symbol-9 )* ")" )? | "std.elim" ( sp ":symbols" sp "(" symbol-10 ( sp symbol-10 )* ")" )? | "std.macro" ( sp ":symbols" sp "(" symbol-11 ( sp symbol-11 )* ")" )? | "std.math.arith" ( sp ":symbols" sp "(" symbol-12 ( sp symbol-12 )* ")" )? | "std.math.binary" ( sp ":symbols" sp "(" symbol-13 ( sp symbol-13 )* ")" )? | "std.math.binary-arith" ( sp ":symbols" sp "(" symbol-14 ( sp symbol-14 )* ")" )? | "std.math.bits" ( sp ":symbols" sp "(" symbol-15 ( sp symbol-15 )* ")" )? | "std.math.convert" ( sp ":symbols" sp "(" symbol-16 ( sp symbol-16 )* ")" )? | "std.math.decimal" ( sp ":symbols" sp "(" symbol-17 ( sp symbol-17 )* ")" )? | "std.math.decimal-arith" ( sp ":symbols" sp "(" symbol-18 ( sp symbol-18 )* ")" )? | "std.math.digits" ( sp ":symbols" sp "(" symbol-19 ( sp symbol-19 )* ")" )? | "std.math.gcd" ( sp ":symbols" sp "(" symbol-20 ( sp symbol-20 )* ")" )? | "std.math.int" ( sp ":symbols" sp "(" symbol-21 ( sp symbol-21 )* ")" )? | "std.math.num9" ( sp ":symbols" sp "(" symbol-22 ( sp symbol-22 )* ")" )? | "std.math.positional" ( sp ":symbols" sp "(" symbol-23 ( sp symbol-23 )* ")" )? | "std.math.rat" ( sp ":symbols" sp "(" symbol-24 ( sp symbol-24 )* ")" )? | "std.negation" ( sp ":symbols" sp "(" symbol-25 ( sp symbol-25 )* ")" )? | "std.slots" ( sp ":symbols" sp "(" symbol-26 ( sp symbol-26 )* ")" )? | "std.typing" ( sp ":symbols" sp "(" symbol-27 ( sp symbol-27 )* ")" )? ) ")"

args ::= ( sp arg )*

arg ::= m-name |
      "(" m-name args ")"

source ::= "\"" [^\n\"<>\\`|]* "\""

# a `relation` form: the name, its labels, and a `:why` that reads its arrows
decl ::= "(relation" sp m-name decl-0

decl-0 ::= sp ":why" sp why-0 ")" |
         sp m-name decl-1

decl-1 ::= sp ":why" sp why-1 ")" |
         sp m-name decl-2

decl-2 ::= sp ":why" sp why-2 ")" |
         sp m-name decl-3

decl-3 ::= sp ":why" sp why-3 ")" |
         sp m-name decl-4

decl-4 ::= sp ":why" sp why-4 ")" |
         sp m-name decl-5

decl-5 ::= sp ":why" sp why-5 ")" |
         sp m-name decl-6

decl-6 ::= sp ":why" sp why-6 ")" |
         sp m-name decl-7

decl-7 ::= sp ":why" sp why-7 ")" |
         sp m-name decl-8

