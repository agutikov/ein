(relation a T :why "{?3} is a")
(relation b T :why "{?3} is b")
(relation p T :why "{?3} is p")
(relation q T :why "{?3} is q")
(relation z T :why "{?3} is z")
(rule reader () :match (and (a ?x) (b ?x) (absent (q ?x))) :assert (p ?x) :why "{?x} is p where no q")
(rule producer () :match (and (a ?x) (absent (z ?x))) :assert (q ?x) :why "{?x} is q where no z")
(a k)
(b k)
(query :goal (p ?x))
(solve :no-search)
