digraph lattice {
  rankdir=BT;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  label="examples/lattice/03_state_hash_collision.ein — 7 of 7 nodes visited by the state route, every alive state once: R and where it stops";
  labelloc=t;
  n0 [label="∅", color="#2ca02c", fillcolor="#e8f6e8"];
  n1 [label="(h1 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  n2 [label="(h2 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  n3 [label="(h3 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  n4 [label="(h1 X)\n(h2 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  n5 [label="(h1 X)\n(h3 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  n6 [label="(h2 X)\n(h3 X)", color="#2ca02c", fillcolor="#e8f6e8"];
  { rank=same; n1; n2; n3; }
  { rank=same; n4; n5; n6; }
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
  n2 -> n4;
  n1 -> n4;
  n3 -> n5;
  n1 -> n5;
  n3 -> n6;
  n2 -> n6;
}

