;;; ein-saved/1 — the program and every module it imports, each as written, and the choices made: this file reads no other.
(program
;;; Lattice fixture — commitments that saturate to one state.
;;;
;;; Demonstrates: distinct commitments saturating to identical
;;; states. R is a set of states, so commitments that saturate alike
;;; are one state of R, which `ein solve` lists once, as `merged`, with
;;; the commitments that reach it; `k_c` exceeds `k_s` by the
;;; commitments a merged state absorbs past its first.
;;; `examples/zebra2-hints.ein` shows the same at scale, four states
;;; each reached by more than one commitment; this fixture shows it on
;;; three candidates,
;;; and saturates in microseconds.
;;;
;;; Three hypothesis candidates from three unary relations:
;;;
;;;   (h1 X)    candidate 1
;;;   (h2 X)    candidate 2
;;;   (h3 X)    candidate 3
;;;
;;; Two implication rules form a bidirectional bridge through h2:
;;;
;;;   (rule h2-derives-h1 ()
;;;     :match (h2 ?x) :assert (h1 ?x))
;;;   (rule h2-derives-h3 ()
;;;     :match (h2 ?x) :assert (h3 ?x))
;;;
;;; Saturation outcomes:
;;;
;;;   Layer 1 — commit {(h1 X)}: fork has h1 only; no rules fire
;;;             (no h2). Kb = {h1}. State_key = A.
;;;   Layer 1 — commit {(h2 X)}: fork has h2; both rules fire,
;;;             derive h1 and h3. Kb = {h1, h2, h3}. State_key = B.
;;;   Layer 1 — commit {(h3 X)}: fork has h3 only; no rules fire.
;;;             Kb = {h3}. State_key = C.
;;;
;;;   Layer 2 — commit {(h1 X), (h2 X)}: fork has h1, h2; rules
;;;             derive h3. Kb = {h1, h2, h3}. State_key = B (!)
;;;             → the same state as {(h2 X)}'s: one state, merged.
;;;   Layer 2 — commit {(h1 X), (h3 X)}: no h2 → no rules.
;;;             Kb = {h1, h3}. State_key = D.
;;;   Layer 2 — commit {(h2 X), (h3 X)}: rules derive h1.
;;;             Kb = {h1, h2, h3}. State_key = B (!)
;;;             → the same state as {(h2 X)}'s: one state, merged.
;;;
;;; What `ein solve` reports:
;;;
;;;   states (k_s)      5: ∅, {h1}, {h3}, {h1, h3} and {h1, h2, h3}
;;;   commitments (k_c) 8, every node of the cube: nothing dies
;;;   merged            1 state reached by more than one commitment,
;;;                     with 1 minimal: {h1, h2, h3}, reached by {h2},
;;;                     {h1, h2}, {h2, h3} and {h1, h2, h3}, the least
;;;                     of them {h2}
;;;   maximal line      ⊤, the trivial line: no restriction bites
;;;
;;; Layer 3, all three committed, is the merged state as well. No
;;; commitment dies: the fixture's point is the merge, not a death.
;;;
;;;

(rule h2-derives-h1 ()
  :match  (h2 ?x)
  :assert (h1 ?x)
  :why    "h2({?x}) → h1({?x})")

(rule h2-derives-h3 ()
  :match  (h2 ?x)
  :assert (h3 ?x)
  :why    "h2({?x}) → h3({?x})")

(rule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (open (?R ?x))
  :why    "guess: is {?x} {?R}?")

(relation is-a T T :why "{?3} is a {?4}")
(relation h1   T   :why "h1 holds of {?3}")
(relation h2   T   :why "h2 holds of {?3}")
(relation h3   T   :why "h3 holds of {?3}")

(is-a Item T)
(is-a X    Item)

(guess h1 Item)
(guess h2 Item)
(guess h3 Item)

(query
  :goal (h1 ?x))

)
(module std.core
;;; Ein stdlib — `std.core`: the rules every program gets.
;;;
;;; Every program gets this module with no import line: the loader brings it
;;; into every program, whole, after the program's own forms and those of
;;; the modules it imports (Q-M1f.551). A file may import it as it imports
;;; any module, which binds its names and brings no second copy, and a
;;; library `$EIN_STDLIB` names brings its own. Its rule is then a rule of
;;; the program as any other is: `ein saturate --dump` lists it under its
;;; full name, `std.core.inconsistent`, and a trace shows its firing.
;;;
;;; ── `(false)` is a proposition ──────────────────────────────────────────────
;;; `(false)` is a fact: a rule concludes it, a program states it, another
;;; fact holds it under an arrow, `(think Ann (false))`. What makes a state
;;; that holds it dead is no reading of its name. It is the rule below, which
;;; matches a held `(false)` and states `:ein inconsistent`, a word to the
;;; engine and no fact (Q-M1f.399, Q-M1f.550): where a rule that states it
;;; fires, the saturation of the state ends and the state is dead. The firing
;;; writes no fact.
;;;
;;; ── what an explanation says of it ──────────────────────────────────────────
;;; A dead state's core is the frontier of what the firing matched, the
;;; `(false)`, and `refuted by` names the rule that concluded that `(false)`:
;;; an explanation names the rules a program wrote or imported, and reads
;;; through a rule of this module to what its firing rests on.

(rule inconsistent ()
  :match (false)
  :ein   inconsistent
  :why   "a state that derives a contradiction is inconsistent")

)
(commit
  (h1 X)
  (h3 X))
