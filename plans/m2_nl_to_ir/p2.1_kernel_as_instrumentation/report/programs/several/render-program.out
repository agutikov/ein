    "h2_h1_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h1_R" -> "h2_h1_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_h1_R" -> "?x_R" [xlabel="2", color="#d62728", style=dashed];
  }
}

