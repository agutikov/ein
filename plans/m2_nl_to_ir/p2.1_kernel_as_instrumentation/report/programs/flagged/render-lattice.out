digraph lattice {
  rankdir=BT;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  label="examples/lattice/04_obligation_trigger_hole.ein — 4 of 4 nodes visited by route 2, the cube: R and where it stops";
  labelloc=t;
  n0 [label="∅", color="#2ca02c", fillcolor="#e8f6e8"];
  n1 [label="(meal Ann Soup)", color="#2ca02c", fillcolor="#e8f6e8"];
  n2 [label="(seats Ann C1)", color="#ff7f0e", fillcolor="#fff2e5"];
  n3 [label="(meal Ann Soup)\n(seats Ann C1)", color="#2ca02c", fillcolor="#e8f6e8"];
  { rank=same; n1; n2; }
  n0 -> n1;
  n0 -> n2;
  n2 -> n3;
  n1 -> n3;
}

