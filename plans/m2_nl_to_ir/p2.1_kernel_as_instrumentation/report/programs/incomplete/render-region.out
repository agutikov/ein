digraph region {
  // ein render region — view full
  graph [rankdir=TB, labelloc=t, fontsize=12, nodesep=0.25, ranksep=0.6, newrank=true, label="region · tests/region/04_owing.ein\nn = 0 · |R| = 0 of 1 · monotone\nrun: all of R — R empty, 1 owing frontier node, exhausted · view full (1 of 1 nodes)"];
  node [fontsize=10, fontname="Helvetica"];
  edge [arrowsize=0.6];
  L0 [shape=plaintext, fontsize=9, label="L0 · 1"];
  m0 [label="∅\nowing 1\nfrontier 1, owes 1", shape=octagon, style="filled", fillcolor="#fee391", color="#525252", penwidth=1, tooltip="∅ — owing\nowes: likes owes Ann a Food.\nrun: frontier 1, owes 1"];
  { rank=same; L0; m0 }
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD ALIGN="LEFT"><B>legend</B> — fill: the cube · shape: the run · border: the lines and the defects</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#a1d99b"> </TD><TD ALIGN="LEFT">R: alive and discharged (one colour per component)</TD></TR><TR><TD BGCOLOR="#fee391"> </TD><TD ALIGN="LEFT">owing: alive, an obligation unwitnessed</TD></TR><TR><TD BGCOLOR="#fcbba1"> </TD><TD ALIGN="LEFT">dead: holds a contradiction; dead+owing is both</TD></TR><TR><TD ALIGN="LEFT"><I>dashed outline</I></TD><TD ALIGN="LEFT">transient: saturation moves it (its sat arrow); it is the state it lands on</TD></TR><TR><TD ALIGN="LEFT"><I>octagon</I></TD><TD ALIGN="LEFT">a state the run reported, or a node of an empty R's owing frontier</TD></TR><TR><TD ALIGN="LEFT"><I>rounded box</I></TD><TD ALIGN="LEFT">a node the run visited</TD></TR><TR><TD ALIGN="LEFT"><I>ellipse</I></TD><TD ALIGN="LEFT">a node the run did not visit; why is under the facts</TD></TR><TR><TD ALIGN="LEFT"><I>double border</I></TD><TD ALIGN="LEFT">R's minimal line</TD></TR><TR><TD ALIGN="LEFT"><I>heavy green border</I></TD><TD ALIGN="LEFT">R's maximal line</TD></TR><TR><TD ALIGN="LEFT"><I>purple border</I></TD><TD ALIGN="LEFT">a hole: outside R, between two members</TD></TR><TR><TD ALIGN="LEFT"><I>red border</I></TD><TD ALIGN="LEFT">MISSING: in the part of R the run asked, no reported state is its state, and the run says it is complete</TD></TR><TR><TD ALIGN="LEFT"><I>orange border</I></TD><TD ALIGN="LEFT">not reached: the same, on a run that stopped (a bound, not a defect)</TD></TR><TR><TD ALIGN="LEFT"><I>magenta border</I></TD><TD ALIGN="LEFT">SPURIOUS (a reported state outside the part asked), the run's reading against the cube's, or an unsound exclusion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#238b45"><B>━━</B></FONT> R → R <I>solid</I></TD><TD ALIGN="LEFT">inside R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fd8d3c"><B>━━</B></FONT> R → owing <I>dashed</I></TD><TD ALIGN="LEFT">adding the fact adds a debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> R → dead <I>solid</I></TD><TD ALIGN="LEFT">adding the fact kills</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2171b5"><B>━━</B></FONT> owing → R <I>solid</I></TD><TD ALIGN="LEFT">adding the fact pays the last debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fdae6b"><B>━━</B></FONT> owing → owing <I>solid</I></TD><TD ALIGN="LEFT">still owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> owing → dead <I>dashed</I></TD><TD ALIGN="LEFT">kills an owing node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → R <I>bold</I></TD><TD ALIGN="LEFT">revives a dead node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → owing <I>dashed</I></TD><TD ALIGN="LEFT">revives a dead node, owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bdbdbd"><B>━━</B></FONT> dead → dead <I>solid</I></TD><TD ALIGN="LEFT">dead to dead</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>┈┈</B></FONT> absorbed <I>dotted</I></TD><TD ALIGN="LEFT">adds a fact saturation already derived: no move</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#08519c"><B>━▶</B></FONT> sat</TD><TD ALIGN="LEFT">C ⇒ cl(C): the candidates sat(root + C) holds</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">compared with R, by state — ruling (a): the answer is R, and a run answers the part of it its question asked<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">missing none; spurious none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal line (0): none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maximal line (0): none<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  { rank=sink; legend; }
  L0 -> legend [style=invis];
}
