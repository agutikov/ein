      "h4_S_L" -> "?h1_L" [xlabel="3", color="#2ca02c"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R2_R" [label="?R2", shape=diamond];
    "?V2_R" [label="?V2", shape=diamond];
    "?h2_R" [label="?h2", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R2 ?V2 ?h2)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h5_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "not_R" -> "h5_not_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h5_not_R" -> "(?R2 ?V2 ?h2)_R" [xlabel="2", color="#d62728", style=dashed];
    "?R2_R" -> "(?R2 ?V2 ?h2)_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "(?R2 ?V2 ?h2)_R" -> "?V2_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(?R2 ?V2 ?h2)_R" -> "?h2_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}

digraph rule_guess_lhs_rhs {
