  subgraph cluster_c0 {
    label="component 0: grid 0: a bijection: every group owed";
    fontsize=10;
    g0 [shape=box, label="g0 (color-loc Green *)\n2 open of 2\nowed by std.algebra.total-owed", peripheries=2];
    g1 [shape=box, label="g1 (color-loc * House-4)\n2 open of 3\nowed by std.algebra.surjective-owed", peripheries=2];
