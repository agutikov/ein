    n0 [label="(color-loc Green House-4)"];
    g0 -- n0;
    n0 -- g1;
    n1 [label="(color-loc Green House-5)"];
    g0 -- n1;
    n1 -- g2;
    n2 [label="(color-loc Ivory House-3)"];
    g3 -- n2;
    n2 -- g4;
    n3 [label="(color-loc Ivory House-4)"];
