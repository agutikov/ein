# Python: `utils/` and `examples/gen_zebra2_variants.py`.
*.pyc
__pycache__/

# Build / dist
build/
dist/

# Engine dump trees (`--dump-states DIR`). **Anchored** to the repo root: the
# bare `dump` / `dumps` these replace matched any path component, and silently
# excluded `ein.rs/crates/ein-render/src/dump/` — a source module, ignored
# because it shares a name with a scratch directory.
/dump/
/dumps/

# Machine-specific bench artifact (the tables in docs/kernel/inference/
# features.md are the committed record; regenerate with utils/feature_matrix.py)
utils/feature_matrix_results.json

# ── M1a (the Rust engine) ─────────────────────────────────────────
# Cargo's build tree — and the others, one per instrument feature, each kept
# in its own target dir so a feature build does not thrash the shipping one:
# `target-fd` is S1a.6.9's `fork-delta` (read by `utils/fork_delta_verify.py`)
# and `target-sa` is S1a.7.0's `spec-audit` (read by `utils/spec_audit.py`).
# The `ein.rs/target-*` glob below is what actually covers them.
ein.rs/target/
ein.rs/target-fd/
# A fuzz session's scratch corpus: every run wipes and rewrites it.
# Everything in `fuzz_findings/` is checked in on purpose — a violated
# property, with a note — and a settled one becomes a `regression` entry with
# a name.
corpus/out/
# Bench and profile artefacts (S1a.6.1): raw JSON + perf data, machine-specific
# and per-run. The committed record is the tables in
# docs/history/m1a_rust/measurements/baseline.md — the same split
# utils/feature_matrix_results.json uses. NOT wiped between runs: the next
# re-measure wants a diff, not a fresh start.
ein.rs/bench-out/
ein.rs/target-*
