;;; Two activators of one rule share a binding key and a derivation is lost —
;;; M1e2 W7, Q-M1e.16. Register row `W7/binding-key-layout`
;;; (`corpus/wrong_answers.toml`); the note is `binding-key-layout.md`.
;;;
;;; Release: `(noted 1 3)` is never derived. Debug: `check_layout` aborts.
(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge 1)
(note edge (src Y))

;; M1f S1f.5.5's swap: a run of digits is a name, so `1`, `2` and `3` are candidate
;; objects; scoped as the promoted witnesses are (S1f.5.4's proposal A), so that
;; the seed costs what it did. H is `(holds 2)` and `(holds Y)`, R four states.
(solve :no-hypothesis (edge noted))
