;;; `activator-text-key.ein` with its two activator lines swapped, and
;;; nothing else. Regression `string-then-int`; the note is
;;; `activator-text-key.md`. Refused at the parse as its twin is: a
;;; string is no value.
(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds "1")

(note edge "1")
(note edge 1)
