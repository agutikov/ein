;;; `activator-text-key.ein` with its two activator lines swapped, and
;;; nothing else. Register row `W16/string-then-int`; the note is
;;; `activator-text-key.md`. Release loses the int's two `noted` facts
;;; instead; debug builds abort here too.
(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds "1")

(note edge "1")
(note edge 1)
