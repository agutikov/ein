;;; `binding-key-layout.ein` with its two activator lines swapped, and nothing
;;; else: the twin, which derives the same two `noted` facts.
;;; Regression `binding-key-both/binding-key-layout`, as a twin; the note is
;;; `binding-key-layout.md`.
(relation edge  Node Node :why "there is an edge from {?3} to {?4}")
(relation holds Node      :why "{?3} holds")
(relation noted Node Node :why "{?3} is noted with {?4}")

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f) :why "{?R} runs from {?a} to some node and {?f} holds, so {?a} is noted with {?f}")

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))
(note edge 1)

;; A run of digits is a name (Q-M1e2.24), so `1`, `2` and `3` are candidate
;; objects; the search is scoped as the fixtures in `examples/ein-bugs/` are.
;; H is `(holds 2)` and `(holds Y)`, R four states.
(solve :no-hypothesis (edge noted))
