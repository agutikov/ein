;;; `binding-key-layout.ein` with its two activator lines swapped, and nothing
;;; else — the twin that answers right in release (four `noted` facts).
;;; Register row `W7/binding-key-layout`, as a twin; the note is
;;; `binding-key-layout.md`. Debug builds abort here too.
(relation edge  Node Node :why "there is an edge from {?1} to {?2}")
(relation holds Node      :why "{?1} holds")
(relation noted Node Node :why "{?1} is noted with {?2}")

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f) :why "{?R} runs from {?a} to some node and {?f} holds, so {?a} is noted with {?f}")

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))
(note edge 1)

;; M1f S1f.5.5's swap: a run of digits is a name, so `1`, `2` and `3` are candidate
;; objects; scoped as the promoted witnesses are (S1f.5.4's proposal A), so that
;; the seed costs what it did. H is `(holds 2)` and `(holds Y)`, R four states.
(solve :no-hypothesis (edge noted))
