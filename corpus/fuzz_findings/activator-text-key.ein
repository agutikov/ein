;;; An activator `1` and one `"1"`, whose text is one: a string is
;;; natural-language text and never a value (Q-M1e2.23), so the program is
;;; refused at the parse. Regression `int-and-string`
;;; (`corpus/regressions.toml`); the note is `activator-text-key.md`.
;;;
;;; A compile plan is keyed by the activator's values, never by their text.
(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds "1")

(note edge 1)
(note edge "1")
