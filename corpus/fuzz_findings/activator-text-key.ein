;;; An int and a string with the same text share a compile key, and a
;;; derivation is lost — M1e2 W16. Register row `W16/int-and-string`
;;; (`corpus/wrong_answers.toml`); the note is `activator-text-key.md`.
;;;
;;; Release: the string's two `noted` facts are never derived. Debug:
;;; `Engine::compile_all`'s shortcut check aborts.
(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds "1")

(note edge 1)
(note edge "1")
