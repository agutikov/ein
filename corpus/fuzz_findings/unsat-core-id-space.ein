(relation r1 T T :why "r1 holds of {?1} and {?2}")
(is-a o1 T)
(r1 o4 o5)
(rule fire-2 ()
  :match  (or (and (r1 ?v0 ?v1) (r1 ?v4 ?v0)) (and (r1 ?v0 ?v1) (r1 ?v0 ?v1) (not (r1 ?v2 ?v3))))
  :assert (false) :why "r1 holds of {?v0} and {?v1} beside an r1 step into {?v0} or a stored r1 negative, which cannot be")
