;;; Ein stdlib — `std.math.binary`: the binary numeral, and the check of one an
;;; operation takes, on `std.math.decimal`'s pattern: a malformed binary
;;; numeral is this module's fault, flagged where an operation takes it
;;; (Q-M1f.295, Q-M1f.210, Q-M1f.404).
;;;
;;; Ein has no numbers and no arithmetic (Q-M1e2.24).
;;; This module is the binary **representation**: the constructor `b2`, what
;;; a numeral written with it must be, and the label `bin-valid` of one that
;;; is. It computes nothing; `std.math.binary-arith` is the arithmetic over
;;; it, imports it, and asks it to check what the arithmetic takes.
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.math.binary-arith :symbols (binary-arith bin-add bin-sum-of))
;;;     (import std.math.binary :symbols (b2))
;;;     (import std.math.arith :symbols (z))
;;;
;;; A program imports the arithmetic, which brings this module and
;;; `std.math.arith` whole (Q-M1f.247), and lists `b2` from here and `z`
;;; from `std.math.arith`, since it writes them: nothing is re-exported.
;;; `binary` is the module's entry, the closing rule at the end of this file.
;;;
;;; ── The numeral ────────────────────────────────────────────────────────────
;;;
;;; A natural number is `z`, zero, `std.math.arith`'s, which both bases share
;;; (Q-M1f.322), or `(b2 PREFIX BIT)`: twice the prefix, plus the
;;; bit. It reads in the order it is written:
;;;
;;;     1        (b2 z 1)
;;;     5, 101   (b2 (b2 (b2 z 1) 0) 1)
;;;     12, 1100 (b2 (b2 (b2 (b2 z 1) 1) 0) 0)
;;;
;;; A bit is one of the two names `0` and `1`, which are decimal's digits too,
;;; and a prefix is `z` or a numeral. Any length; high zeros are allowed in
;;; what a program writes, `(b2 (b2 z 0) 1)` is 1, and the arithmetic answers
;;; in normal form. The shape is its own, `b2` and not decimal's `n`, so a
;;; number says which base it is in and the two bases stand in one program,
;;; as binary's names carry `bin-` where decimal's carry none
;;; (Q-M1f.267).
;;;
;;; ── A numeral is checked where an operation takes it ──────────────────────
;;;
;;; As `std.math.decimal`'s check (Q-M1f.404): a number an operation makes
;;; from valid numbers is valid as it is made, and every other numeral is
;;; checked, whatever its source: the operand found for a request of
;;; `std.math.binary-arith`, a number handed to one of its tagged calls, or a
;;; number `std.math.convert` is asked to convert, by one fact,
;;; `(bin-check N N)`. The check walks N a place a firing, as
;;; `(bin-check N REST)`, by `std.math.positional`'s `numeral-step`,
;;; `numeral-step-zero` and `numeral-valid`, which `std.math.binary-arith`
;;; activates with this module's relations and `bin-nz`. The walk that reaches
;;; `z` labels the numeral `(bin-valid N)`: it is a binary number, and `z` is
;;; valid by the closing rule below. The ask and the label are facts of the
;;; numeral, so a numeral is checked once whatever reads it. A number the
;;; arithmetic makes is labelled as it is made, by the walk that makes it, and
;;; is not walked again; one a program's own rule hands to another request or
;;; to a tagged call is checked as any. A numeral no operation takes is not
;;; checked.
;;;
;;; A malformed place stops the walk and derives the flag on the smallest `b2`
;;; term at fault, and the flag derives `(false)`:
;;;
;;;     (not-binary NUMERAL THING)    THING stands in NUMERAL where a bit or a
;;;                                   prefix goes, and is neither:
;;;                                   - a bit's place holds a name that is no
;;;                                     bit, `(b2 (b2 z 1) 2)`, a letter, or a
;;;                                     fact, `(b2 z (b2 z 1))`;
;;;                                   - the prefix is a bit, `(b2 1 0)`,
;;;                                     `(b2 0 1)`: a numeral ends in `z`;
;;;                                   - the prefix is a named constant,
;;;                                     `(b2 mask 1)`
;;;
;;; Root is dead, R is empty, every command exits 0, and `ein solve` names, in
;;; the unsat core, the request that took the numeral and, in `refuted by`,
;;; `not-binary-is-false`.
;;;
;;; **A flag means malformed; no flag does not mean well-formed.** Silent, as
;;; `std.math.decimal` is silent on their like, and with no label:
;;;
;;;   - a prefix that is a name neither `z`, a bit nor a named constant,
;;;     `(b2 end 1)`, and so a decimal digit as a prefix, `(b2 7 1)`, which
;;;     is a name in binary's eyes: saying *a name* costs a walk of the
;;;     program's names (Q-M1f.318);
;;;   - a prefix that is a fact of another relation, `(b2 (pair 1 0) 1)`.
;;;
;;; A wrong count of arguments, `(b2 1)`, is refused when the program is loaded
;;; (Q-M1f.315). What is not a numeral's fault is not this module's: a name no
;;; `bin-let` states, a bit where a number goes, `(bin-add 1 X)`, and a
;;; `bin-let` that cannot be read are `std.math.binary-arith`'s, flagged on the
;;; request (`(bin-malformed REQUEST)`, `(bin-undeclared NAME REQUEST)`).
;;;
;;; **A named constant** is a name that stands for a number: `bin-named` is
;;; declared here, and `std.math.binary-arith`, which declares `bin-let`,
;;; writes `(bin-named NAME)` for every name a `bin-let` states.
;;;
;;; ── The rule of the calculator ─────────────────────────────────────────────
;;;
;;; No rule joins two facts on a number: each rule here has one premise that
;;; holds a numeral, `(bin-check N REST)`, and its others are guards, a row of
;;; the table `bin-nz`, or a probe with every argument bound, `(bin-named
;;; ?m)`. `ein-infer/tests/arith_theory.rs` holds it.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; `b2`, `bin-named`, the check `bin-check` and its label `bin-valid`, the
;;; flag `not-binary`, the rules `bin-numeral-bit`, `bin-numeral-prefix-bit`,
;;; `bin-numeral-prefix-zero`, `bin-numeral-prefix-named` and
;;; `not-binary-is-false`, `binary-rule`, and the entry `binary`. The
;;; interface is `b2`, `bin-named`, `bin-check`, `bin-valid` and the flag.

(import std.math.arith :symbols (arith z))
(import std.math.bits :symbols (bin-nz))

;; ── The numeral ─────────────────────────────────────────────────────────────
(relation b2 Number Bit
  :why "the number written {?3}, then the bit {?4}")

;; ── A named constant, which the module that declares `bin-let` writes ───────
(relation bin-named Name
  :why "{?3} is a named constant")

;; ── The check, which an operation asks for, and its label ───────────────────
;; `(bin-check N N)` asks whether N is a binary number; `(bin-check N REST)`
;; is the walk, REST what is still to check, `std.math.positional`'s
;; `numeral-step`, `numeral-step-zero` and `numeral-valid` (Q-M1f.404). The
;; flags below read the walk, and stop it where a place is at fault.
(relation bin-check Number Number
  :why "checking {?3}: {?4} is still to check")
(relation bin-valid Number
  :why "{?3} is a binary number")
(relation not-binary Number Thing
  :why "{?3} is not a binary number: {?4} stands where a bit or a number goes")

;; Neither of the two bits: `neq` holds of every other name, and of a fact.
(rule bin-numeral-bit ()
  :match  (and (bin-check ?w (b2 ?p ?a)) (neq ?a 0) (neq ?a 1))
  :assert (not-binary (b2 ?p ?a) ?a)
  :why    "{?a} stands where a bit goes and is neither of the two")

;; A numeral ends in `z`. One whose prefix is a bit, `(b2 1 0)`, or a named
;; constant, `(b2 mask 1)`, is flagged; one whose prefix is any other name is
;; not, since saying *a name* costs a walk of the program's names.
(rule bin-numeral-prefix-bit ()
  :match  (and (bin-check ?w (b2 ?m ?a)) (bin-nz ?m))
  :assert (not-binary (b2 ?m ?a) ?m)
  :why    "the bit {?m} stands where a number goes: a number ends in z")

(rule bin-numeral-prefix-zero ()
  :match  (bin-check ?w (b2 0 ?a))
  :assert (not-binary (b2 0 ?a) 0)
  :why    "the bit 0 stands where a number goes: a number ends in z")

;; `(neq ?m z)`: a program that names `z` with a `bin-let` is flagged for the
;; `bin-let`, and its numerals, which end in `z`, are not.
(rule bin-numeral-prefix-named ()
  :match  (and (bin-check ?w (b2 ?m ?a)) (neq ?m z) (bin-named ?m))
  :assert (not-binary (b2 ?m ?a) ?m)
  :why    "the name {?m} stands where a number goes: a name stands for a number as an operand, not inside one")

(rule not-binary-is-false ()
  :match  (not-binary ?x ?thing)
  :assert (false)
  :why    "{?x} is not a binary number: the program cannot hold it")

;; ── The closing rule, and the module's one entry ────────────────────────────
;; Every relation of the module is closed, and the table it reads; every rule
;; is named, and `arith`, the entry of the module below. `ein-infer/tests/
;; arith_theory.rs` holds that nothing is missing here. The walk's rules are
;; `std.math.positional`'s, named by the activators `std.math.binary-arith`
;; derives.
(relation binary-rule Rule
  :why "{?3} is a rule of std.math.binary")

(rule binary ()
  :match  ()
  :assert (and (__closed__ bin-nz)
               (__closed__ b2) (__closed__ bin-named) (__closed__ bin-check)
               (__closed__ bin-valid) (__closed__ not-binary)
               (__closed__ binary-rule)
               (bin-valid z)
               (binary-rule arith)
               (binary-rule bin-numeral-bit) (binary-rule bin-numeral-prefix-bit)
               (binary-rule bin-numeral-prefix-zero)
               (binary-rule bin-numeral-prefix-named)
               (binary-rule not-binary-is-false))
  :why    "a numeral is written, and never guessed: every relation of the module is closed")
