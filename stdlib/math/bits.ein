;;; Ein stdlib — `std.math.bits`: the bit tables of binary arithmetic (M1f
;;; P1f.6, S1f.6.16).
;;;
;;; GENERATED by `utils/gen_arith_tables.py`. Do not edit: edit the script,
;;; run it, then `python3 utils/stdlib_manifest.py --write`. The script's
;;; `--check` is in the gate (`ein-ir/tests/digit_tables.rs`), and the same
;;; test holds every row to Rust's integers.
;;;
;;; A library of **facts**, as `std.math.digits` is: binary's tables, one fact
;;; a row, which `std.math.binary-arith` and `std.math.positional`'s rules
;;; activated for binary look up. The two bits are the names `0` and `1`,
;;; which are decimal's digits too.
;;;
;;;   table   reads                               gives                   rows
;;;   bin-fa  a, b, carry in                      sum bit, carry out         8
;;;   bin-fs  a, b, borrow in                     difference bit, borrow     8
;;;   bin-cl  the order below (lt eq gt), a, b    the order                 12
;;;   bin-nz  a bit                               it is not zero             1
;;;
;;; 29 rows, where decimal's seven tables have 1 664: binary needs no digit
;;; multiplier, since a row of a product is nothing or the multiplicand, and
;;; no bisection, since one subtraction decides a bit of a quotient.
;;;
;;; Importing. An import brings every table and its rows (M1f S1f.6.35); a
;;; program lists the tables it writes, and the others print by their full
;;; names, `std.math.bits.bin-fs`:
;;;
;;;     (import std.math.bits :symbols (bin-fa))
;;;
;;; **Closed.** Each table is closed by a written `(__closed__ R)` fact below:
;;; a table is complete, and a row is never a hypothesis. A theory that reads
;;; the tables closes the ones it reads in its own closing rule too, as
;;; `std.math.binary-arith` does.

(relation bin-fa Bit Bit Bit Bit Bit :why "{?1} + {?2} + carry {?3} is bit {?4}, carry {?5}")
(relation bin-fs Bit Bit Bit Bit Bit :why "{?1} - {?2} - borrow {?3} is bit {?4}, borrow {?5}")
(relation bin-cl Order Bit Bit Order :why "the order below is {?1}; {?2} against {?3} above it makes it {?4}")
(relation bin-nz Bit :why "{?1} is not zero")

;; Every table is complete: no row is ever a hypothesis.
(__closed__ bin-fa) (__closed__ bin-fs) (__closed__ bin-cl) (__closed__ bin-nz)

;; ── bin-fa: 8 rows ──
;; The full adder. a + b + carry in = 2 x carry out + bit.
(bin-fa 0 0 0 0 0) (bin-fa 0 1 0 1 0)
(bin-fa 0 0 1 1 0) (bin-fa 0 1 1 0 1)
(bin-fa 1 0 0 1 0) (bin-fa 1 1 0 0 1)
(bin-fa 1 0 1 0 1) (bin-fa 1 1 1 1 1)

;; ── bin-fs: 8 rows ──
;; The full subtractor. a - b - borrow in = bit - 2 x borrow out.
(bin-fs 0 0 0 0 0) (bin-fs 0 1 0 1 1)
(bin-fs 0 0 1 1 1) (bin-fs 0 1 1 0 1)
(bin-fs 1 0 0 1 0) (bin-fs 1 1 0 0 0)
(bin-fs 1 0 1 0 0) (bin-fs 1 1 1 1 1)

;; ── bin-cl: 12 rows ──
;; The bit comparator, a column at a time from the units: a differing bit
;; overrules the order below it, equal bits keep it.
(bin-cl lt 0 0 lt) (bin-cl lt 0 1 lt)
(bin-cl lt 1 0 gt) (bin-cl lt 1 1 lt)
(bin-cl eq 0 0 eq) (bin-cl eq 0 1 lt)
(bin-cl eq 1 0 gt) (bin-cl eq 1 1 eq)
(bin-cl gt 0 0 gt) (bin-cl gt 0 1 lt)
(bin-cl gt 1 0 gt) (bin-cl gt 1 1 gt)

;; ── bin-nz: 1 row ──
;; The bit that is not zero.
(bin-nz 1)
