;;; Ein stdlib — `std.math.decimal`: the decimal numeral, and the check of one
;;; an operation takes (Q-M1f.273, Q-M1f.210, Q-M1f.404).
;;;
;;; Ein has no numbers and no arithmetic (Q-M1e2.24).
;;; This module is the decimal **representation**: the constructor `n`, what
;;; a numeral written with it must be, and the label `valid` of one that is.
;;; It computes nothing; `std.math.decimal-arith` is the arithmetic over it,
;;; imports it, and asks it to check what the arithmetic takes.
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.math.decimal-arith :symbols (decimal-arith add sum-of))
;;;     (import std.math.decimal :symbols (n))
;;;     (import std.math.arith :symbols (z))
;;;
;;; A program imports the arithmetic, which brings this module and
;;; `std.math.arith` whole (Q-M1f.247), and lists `n` from here and `z`
;;; from `std.math.arith`, since it writes them: nothing is re-exported.
;;; `decimal` is the module's entry, the closing rule at the end of this file.
;;;
;;; ── The numeral ────────────────────────────────────────────────────────────
;;;
;;; A natural number is `z`, zero, `std.math.arith`'s, or `(n PREFIX DIGIT)`:
;;; ten times the prefix, plus the digit. It reads in the order it is
;;; written:
;;;
;;;     7        (n z 7)
;;;     42       (n (n z 4) 2)
;;;     123078   (n (n (n (n (n (n z 1) 2) 3) 0) 7) 8)
;;;
;;; A digit is one of the ten names `0` to `9`, and a prefix is `z` or a
;;; numeral. Any length; high zeros are allowed in what a program writes,
;;; `(n (n z 0) 7)` is 7, and the arithmetic answers in normal form.
;;;
;;; ── A numeral is checked where an operation takes it ──────────────────────
;;;
;;; A malformed decimal number is a problem of this module (Q-M1f.210): a
;;; number that contains letters, signs, whitespace or hieroglyphs is not a
;;; decimal number. The check is this module's, and an operation asks for it
;;; where it takes a numeral from the program (Q-M1f.404): the operand found
;;; for a request of `std.math.decimal-arith`, a part of an integer or of a
;;; rational an operation takes, a number `std.math.convert` or
;;; `std.math.num9` is asked to convert. The ask is one fact, `(check N N)`,
;;; and the check walks N a place a firing, from the units, as
;;; `(check N REST)`, REST what is still to check:
;;;
;;;     (check (n (n z 4) 2) (n (n z 4) 2))   asked
;;;     (check (n (n z 4) 2) (n z 4))         the digit 2 is one
;;;     (check (n (n z 4) 2) z)               the digit 4 is one
;;;     (valid (n (n z 4) 2))                 the walk reached z
;;;
;;; **Once.** The ask and the label are facts of the numeral, so a numeral is
;;; checked once whatever reads it, however many requests name it. **The
;;; label `(valid N)`** is the walk's end: N is a decimal number. `z` is
;;; valid by the closing rule below. **A number the arithmetic makes is
;;; labelled as it is made**, by the walk that makes it
;;; (`std.math.positional`'s turn and division's end), so every number an
;;; operation answers with, `(sum-of X Y S)`'s S, is valid already, and no
;;; operation checks it. One a program's own rule hands to another request is
;;; that request's operand, and is walked as any operand is: nothing tells it
;;; from a numeral the program wrote but its label, and reading the label
;;; beside the operand would join two facts on a number. No rule of the
;;; calculator waits for a label: a malformed numeral is a contradiction, and
;;; a well-formed one is computed with as it is found.
;;;
;;; **A numeral no operation takes is not checked**: a `let`'s value nobody
;;; asks about, a numeral in a fact of the program's own relation, one in a
;;; rule's conclusion that never fires.
;;;
;;; A malformed place stops the walk and derives the flag on the smallest
;;; `n` term at fault, and the flag derives `(false)`:
;;;
;;;     (not-decimal NUMERAL THING)   THING stands in NUMERAL where a digit or
;;;                                   a prefix goes, and is neither:
;;;                                   - a digit's place holds a name that is
;;;                                     no digit, `(n (n z 1) x)`, a sign,
;;;                                     `(n z -)`, or a fact, `(n z (n z 1))`;
;;;                                   - the prefix is a digit, `(n 1 2)`,
;;;                                     `(n 0 2)`: a numeral ends in `z`;
;;;                                   - the prefix is a named constant,
;;;                                     `(n price 1)`
;;;
;;; Root is dead, R is empty, every command exits 0, and `ein solve` names,
;;; in the unsat core, the request that took the numeral, with the `let` that
;;; named it where an operand is a name, and, in `refuted by`,
;;; `not-decimal-is-false`.
;;;
;;; **A flag means malformed; no flag does not mean well-formed.** Silent, and
;;; with no label:
;;;
;;;   - a prefix that is a name neither `z`, a digit nor a named constant,
;;;     `(n end 1)`: saying *a name* costs a walk of the program's names
;;;     (Q-M1f.318);
;;;   - a prefix that is a fact of another relation, `(n (pair 1 2) 3)`: no
;;;     rule can say *not of this shape*.
;;;
;;; A wrong count of arguments, `(n 1)` or `(n z 1 2)`, is refused when the
;;; program is loaded (Q-M1f.315), and a character that is no name character
;;; at the parse: neither is this module's to flag.
;;;
;;; **A named constant** is a name that stands for a number: `named` is
;;; declared here, and `std.math.decimal-arith`, which declares `let`, writes
;;; `(named NAME)` for every name a `let` states. So the module below `let`
;;; says *the prefix is a named constant* by a probe, and what makes a name
;;; one stays the module's above.
;;;
;;; What is not a numeral's fault is not this module's: a name no `let`
;;; states, a digit where a number goes, `(add 7 X)`, and a `let` that cannot
;;; be read are the faults of what reads the operand, `std.math.decimal-arith`,
;;; `std.math.int` and `std.math.rat`, each of which flags them
;;; (`(malformed REQUEST)`, `(undeclared NAME REQUEST)`).
;;;
;;; ── The rule of the calculator ─────────────────────────────────────────────
;;;
;;; No rule joins two facts on a number: each rule here has one premise that
;;; holds a numeral, `(check N REST)`, and its others are guards, which
;;; compare and look nothing up, a row of the table `nz`, or a probe with every
;;; argument bound, `(named ?m)`. The walk carries the numeral it checks, so
;;; its end labels it with no second premise. `ein-infer/tests/arith_theory.rs`
;;; holds it.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; `n`, `named`, the check `check` and its label `valid`, the flag
;;; `not-decimal`, the rules `numeral-step`, `numeral-step-zero`,
;;; `numeral-valid`, `numeral-digit`, `numeral-prefix-digit`,
;;; `numeral-prefix-zero`, `numeral-prefix-named` and `not-decimal-is-false`,
;;; `decimal-rule`, and the entry `decimal`. The interface is `n`, `named`,
;;; `check`, `valid` and the flag.

(import std.math.arith :symbols (arith z))
(import std.math.digits :symbols (nz))

;; ── The numeral ─────────────────────────────────────────────────────────────
(relation n Number Digit
  :why "the number written {?1}, then the digit {?2}")

;; ── A named constant, which the module that declares `let` writes ──────────
(relation named Name
  :why "{?1} is a named constant")

;; ── The check, which an operation asks for, and its label ───────────────────
;; `(check N N)` asks whether N is a decimal number; `(check N REST)` is the
;; walk, REST what is still to check. An operation that takes a numeral from
;; the program writes the ask, and one that answers with a number writes the
;; label.
(relation check Number Number
  :why "checking {?1}: {?2} is still to check")
(relation valid Number
  :why "{?1} is a decimal number")
(relation not-decimal Number Thing
  :why "{?1} is not a decimal number: {?2} stands where a digit or a number goes")

;; A place whose digit is one of the ten: the walk goes on to the prefix.
(rule numeral-step ()
  :match  (and (check ?w (n ?p ?a)) (nz ?a))
  :assert (check ?w ?p)
  :why    "the digit {?a} is one: {?p} is still to check")

(rule numeral-step-zero ()
  :match  (check ?w (n ?p 0))
  :assert (check ?w ?p)
  :why    "the digit 0 is one: {?p} is still to check")

;; The walk reached `z`: every place held a digit, and the numeral ends in
;; `z`.
(rule numeral-valid ()
  :match  (check ?w z)
  :assert (valid ?w)
  :why    "every place of {?w} holds a digit, and it ends in z: it is a decimal number")

;; None of the ten digits: `neq` holds of every other name, and of a fact.
(rule numeral-digit ()
  :match  (and (check ?w (n ?p ?a))
               (neq ?a 0) (neq ?a 1) (neq ?a 2) (neq ?a 3) (neq ?a 4)
               (neq ?a 5) (neq ?a 6) (neq ?a 7) (neq ?a 8) (neq ?a 9))
  :assert (not-decimal (n ?p ?a) ?a)
  :why    "{?a} stands where a digit goes and is none of the ten")

;; A numeral ends in `z`. One whose prefix is a digit, `(n 1 2)`, or a named
;; constant, `(n price 1)`, is flagged; one whose prefix is any other name is
;; not, since saying *a name* costs a walk of the program's names.
(rule numeral-prefix-digit ()
  :match  (and (check ?w (n ?m ?a)) (nz ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why    "the digit {?m} stands where a number goes: a number ends in z")

(rule numeral-prefix-zero ()
  :match  (check ?w (n 0 ?a))
  :assert (not-decimal (n 0 ?a) 0)
  :why    "the digit 0 stands where a number goes: a number ends in z")

;; `(neq ?m z)`: a program that names `z` with a `let` is flagged for the
;; `let`, and its numerals, which end in `z`, are not.
(rule numeral-prefix-named ()
  :match  (and (check ?w (n ?m ?a)) (neq ?m z) (named ?m))
  :assert (not-decimal (n ?m ?a) ?m)
  :why    "the name {?m} stands where a number goes: a name stands for a number as an operand, not inside one")

(rule not-decimal-is-false ()
  :match  (not-decimal ?x ?thing)
  :assert (false)
  :why    "{?x} is not a decimal number: the program cannot hold it")

;; ── The closing rule, and the module's one entry ────────────────────────────
;; Every relation of the module is closed, and the table it reads; every rule
;; is named, and `arith`, the entry of the module below. `ein-infer/tests/
;; arith_theory.rs` holds that nothing is missing here.
(relation decimal-rule Rule
  :why "{?1} is a rule of std.math.decimal")

(rule decimal ()
  :match  ()
  :assert (and (__closed__ nz)
               (__closed__ n) (__closed__ named) (__closed__ check)
               (__closed__ valid) (__closed__ not-decimal)
               (__closed__ decimal-rule)
               (valid z)
               (decimal-rule arith)
               (decimal-rule numeral-step) (decimal-rule numeral-step-zero)
               (decimal-rule numeral-valid)
               (decimal-rule numeral-digit) (decimal-rule numeral-prefix-digit)
               (decimal-rule numeral-prefix-zero)
               (decimal-rule numeral-prefix-named)
               (decimal-rule not-decimal-is-false))
  :why    "a numeral is written, and never guessed: every relation of the module is closed")
