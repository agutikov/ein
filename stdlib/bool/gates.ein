;;; Ein stdlib — `std.bool.gates`: the sixteen Boolean functions of two
;;; inputs, as one table and as a relation each (M1f P1f.6, S1f.6.17).
;;;
;;; A function of two bits is its column of four outputs, at a b = 00, 01, 10
;;; and 11, and there are sixteen columns; every one has a name here, exactly
;;; once. Ein has no numbers and no truth values of its own (the user's ruling
;;; of 2026-11-06): the two bits are the names `0` and `1`, which are
;;; decimal's digits too, and what is known of them is written here as tables
;;; of facts, as `std.math.digits` writes the digits'. Nothing is guessed: on a
;;; program that imports the module and writes nothing else, R is {∅}.
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.bool.gates :symbols (gate2 Xor And))
;;;
;;; An import brings the module whole (M1f S1f.6.35); a program lists the
;;; names it writes. `gates` is the module's entry, the closing rule at the
;;; end of this file: it closes every relation and names every rule.
;;;
;;; ── Two layouts (the user's reply 19 (c), 2026-11-12) ──────────────────────
;;;
;;;     (gate2 NAME A B OUT)    one table, 64 rows: NAME of A and B is OUT
;;;     (NAME A B OUT)          a relation a function, its four rows, derived
;;;                             from the table by sixteen rules
;;;
;;; In the table a function is a value, so a rule about any function matches
;;; (gate2 ?f …) with no parameter, and a search can make the function a
;;; hypothesis (`examples/binary_logic/synthesis.ein`). In the second layout a
;;; function is a relation, (Xor ?a ?b ?o), for a rule that names the one it
;;; means. Every program that imports the module derives the second layout,
;;; 64 firings at root: an import brings every rule (S1f.6.35), so no program
;;; selects the sixteen rules apart from the table (Q-M1f.263).
;;;
;;; ── A function's name is the module's ──────────────────────────────────────
;;;
;;; Each of the sixteen names is declared here, as the relation of the second
;;; layout, so it has one full name, `std.bool.gates.Xor`, in both of its
;;; places: the relation, and the value in the table. A program that writes a
;;; function's name, as a value too, `(gate g1 Xor a b o)`, lists it, or
;;; writes it in full or by an alias. A name it writes and does not list is its
;;; own, as every short name is (S1f.6.35): a name no row of the table has, so
;;; a gate of that function computes nothing, and nothing says so (E-62).
;;;
;;; ── The sixteen ────────────────────────────────────────────────────────────
;;;
;;;     name   column  the output                 the connective
;;;     Zero   f0000   0                          contradiction
;;;     And    f0001   a and b                    conjunction
;;;     Andn   f0010   a and not b                nonimplication
;;;     Fst    f0011   a                          projection on the first
;;;     Randn  f0100   not a and b                converse nonimplication
;;;     Snd    f0101   b                          projection on the second
;;;     Xor    f0110   a xor b                    exclusive disjunction
;;;     Or     f0111   a or b                     disjunction
;;;     Nor    f1000   not (a or b)               joint denial, Peirce's arrow
;;;     Xnor   f1001   not (a xor b)              biconditional
;;;     Nsnd   f1010   not b                      negation of the second
;;;     Orn    f1011   a or not b                 converse implication
;;;     Nfst   f1100   not a                      negation of the first
;;;     Rorn   f1101   not a or b                 implication, a then b
;;;     Nand   f1110   not (a and b)              alternative denial, Sheffer's stroke
;;;     One    f1111   1                          tautology
;;;
;;; The names are capitalised because `and`, `or` and `not` are Ein's own
;;; words and are never a value. `Randn` and `Rorn` are `Andn` and `Orn` with
;;; the inputs exchanged. The column, `f0110` for `Xor`, is each function's
;;; second name, held in `(column-name Xor f0110)`: a value and no relation,
;;; so it is not the module's, and any program may write it.
;;;
;;; Beside the table, three small ones the property rules of `std.bool.props`
;;; read: `(inv A B)`, not A is B; `(le A B)`, the order of the bits; and
;;; `(bit A)`, the two bits.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; The tables `gate2`, `column-name`, `inv`, `le` and `bit`; the sixteen
;;; functions, each a relation and a value of `gate2`; the sixteen rules
;;; `Zero-rows` to `One-rows`, one a function; `gates-rule`, and the entry
;;; `gates`.
;;;
;;; The table's rows are GENERATED by `utils/gen_gates.py`, between the two
;;; lines that say so below: edit the script and run it, never the rows, then
;;; `python3 utils/stdlib_manifest.py --write`. The script's `--check` is in
;;; the gate, and `ein-infer/tests/bool_theory.rs` holds every row, and every
;;; fact the rules derive, to an enumeration of the columns in Rust. The rest
;;; of this file is written by hand.

;; ── The tables ──────────────────────────────────────────────────────────────
(relation gate2 Function Bit Bit Bit
  :why "{?1} of {?2} and {?3} is {?4}")
(relation column-name Function Column
  :why "{?1} is the function whose outputs at 00, 01, 10 and 11 spell {?2}")
(relation inv Bit Bit
  :why "not {?1} is {?2}")
(relation le Bit Bit
  :why "{?1} is at most {?2}")
(relation bit Bit
  :why "{?1} is a bit")

;; BEGIN GENERATED by utils/gen_gates.py: edit the script, never the rows
(bit 0) (bit 1)
(inv 0 1) (inv 1 0)
(le 0 0) (le 0 1) (le 1 1)
(gate2 Zero 0 0 0) (gate2 Zero 0 1 0) (gate2 Zero 1 0 0) (gate2 Zero 1 1 0)   (column-name Zero f0000)
(gate2 And 0 0 0) (gate2 And 0 1 0) (gate2 And 1 0 0) (gate2 And 1 1 1)   (column-name And f0001)
(gate2 Andn 0 0 0) (gate2 Andn 0 1 0) (gate2 Andn 1 0 1) (gate2 Andn 1 1 0)   (column-name Andn f0010)
(gate2 Fst 0 0 0) (gate2 Fst 0 1 0) (gate2 Fst 1 0 1) (gate2 Fst 1 1 1)   (column-name Fst f0011)
(gate2 Randn 0 0 0) (gate2 Randn 0 1 1) (gate2 Randn 1 0 0) (gate2 Randn 1 1 0)   (column-name Randn f0100)
(gate2 Snd 0 0 0) (gate2 Snd 0 1 1) (gate2 Snd 1 0 0) (gate2 Snd 1 1 1)   (column-name Snd f0101)
(gate2 Xor 0 0 0) (gate2 Xor 0 1 1) (gate2 Xor 1 0 1) (gate2 Xor 1 1 0)   (column-name Xor f0110)
(gate2 Or 0 0 0) (gate2 Or 0 1 1) (gate2 Or 1 0 1) (gate2 Or 1 1 1)   (column-name Or f0111)
(gate2 Nor 0 0 1) (gate2 Nor 0 1 0) (gate2 Nor 1 0 0) (gate2 Nor 1 1 0)   (column-name Nor f1000)
(gate2 Xnor 0 0 1) (gate2 Xnor 0 1 0) (gate2 Xnor 1 0 0) (gate2 Xnor 1 1 1)   (column-name Xnor f1001)
(gate2 Nsnd 0 0 1) (gate2 Nsnd 0 1 0) (gate2 Nsnd 1 0 1) (gate2 Nsnd 1 1 0)   (column-name Nsnd f1010)
(gate2 Orn 0 0 1) (gate2 Orn 0 1 0) (gate2 Orn 1 0 1) (gate2 Orn 1 1 1)   (column-name Orn f1011)
(gate2 Nfst 0 0 1) (gate2 Nfst 0 1 1) (gate2 Nfst 1 0 0) (gate2 Nfst 1 1 0)   (column-name Nfst f1100)
(gate2 Rorn 0 0 1) (gate2 Rorn 0 1 1) (gate2 Rorn 1 0 0) (gate2 Rorn 1 1 1)   (column-name Rorn f1101)
(gate2 Nand 0 0 1) (gate2 Nand 0 1 1) (gate2 Nand 1 0 1) (gate2 Nand 1 1 0)   (column-name Nand f1110)
(gate2 One 0 0 1) (gate2 One 0 1 1) (gate2 One 1 0 1) (gate2 One 1 1 1)   (column-name One f1111)
;; END GENERATED

;; ── A relation a function: the second layout ────────────────────────────────
(relation Zero Bit Bit Bit
  :why "the constant 0 of {?1} and {?2} is {?3}")
(relation And Bit Bit Bit
  :why "{?1} and {?2} is {?3}")
(relation Andn Bit Bit Bit
  :why "{?1} and not {?2} is {?3}")
(relation Fst Bit Bit Bit
  :why "the first of {?1} and {?2} is {?3}")
(relation Randn Bit Bit Bit
  :why "not {?1} and {?2} is {?3}")
(relation Snd Bit Bit Bit
  :why "the second of {?1} and {?2} is {?3}")
(relation Xor Bit Bit Bit
  :why "{?1} xor {?2} is {?3}")
(relation Or Bit Bit Bit
  :why "{?1} or {?2} is {?3}")
(relation Nor Bit Bit Bit
  :why "neither {?1} nor {?2} is {?3}")
(relation Xnor Bit Bit Bit
  :why "{?1} xnor {?2} is {?3}")
(relation Nsnd Bit Bit Bit
  :why "the negation of the second of {?1} and {?2} is {?3}")
(relation Orn Bit Bit Bit
  :why "{?1} or not {?2} is {?3}")
(relation Nfst Bit Bit Bit
  :why "the negation of the first of {?1} and {?2} is {?3}")
(relation Rorn Bit Bit Bit
  :why "not {?1} or {?2} is {?3}")
(relation Nand Bit Bit Bit
  :why "{?1} nand {?2} is {?3}")
(relation One Bit Bit Bit
  :why "the constant 1 of {?1} and {?2} is {?3}")

(rule Zero-rows ()
  :match  (gate2 Zero ?a ?b ?o)
  :assert (Zero ?a ?b ?o)
  :why    "the table's row: Zero of {?a} and {?b} is {?o}")
(rule And-rows ()
  :match  (gate2 And ?a ?b ?o)
  :assert (And ?a ?b ?o)
  :why    "the table's row: And of {?a} and {?b} is {?o}")
(rule Andn-rows ()
  :match  (gate2 Andn ?a ?b ?o)
  :assert (Andn ?a ?b ?o)
  :why    "the table's row: Andn of {?a} and {?b} is {?o}")
(rule Fst-rows ()
  :match  (gate2 Fst ?a ?b ?o)
  :assert (Fst ?a ?b ?o)
  :why    "the table's row: Fst of {?a} and {?b} is {?o}")
(rule Randn-rows ()
  :match  (gate2 Randn ?a ?b ?o)
  :assert (Randn ?a ?b ?o)
  :why    "the table's row: Randn of {?a} and {?b} is {?o}")
(rule Snd-rows ()
  :match  (gate2 Snd ?a ?b ?o)
  :assert (Snd ?a ?b ?o)
  :why    "the table's row: Snd of {?a} and {?b} is {?o}")
(rule Xor-rows ()
  :match  (gate2 Xor ?a ?b ?o)
  :assert (Xor ?a ?b ?o)
  :why    "the table's row: Xor of {?a} and {?b} is {?o}")
(rule Or-rows ()
  :match  (gate2 Or ?a ?b ?o)
  :assert (Or ?a ?b ?o)
  :why    "the table's row: Or of {?a} and {?b} is {?o}")
(rule Nor-rows ()
  :match  (gate2 Nor ?a ?b ?o)
  :assert (Nor ?a ?b ?o)
  :why    "the table's row: Nor of {?a} and {?b} is {?o}")
(rule Xnor-rows ()
  :match  (gate2 Xnor ?a ?b ?o)
  :assert (Xnor ?a ?b ?o)
  :why    "the table's row: Xnor of {?a} and {?b} is {?o}")
(rule Nsnd-rows ()
  :match  (gate2 Nsnd ?a ?b ?o)
  :assert (Nsnd ?a ?b ?o)
  :why    "the table's row: Nsnd of {?a} and {?b} is {?o}")
(rule Orn-rows ()
  :match  (gate2 Orn ?a ?b ?o)
  :assert (Orn ?a ?b ?o)
  :why    "the table's row: Orn of {?a} and {?b} is {?o}")
(rule Nfst-rows ()
  :match  (gate2 Nfst ?a ?b ?o)
  :assert (Nfst ?a ?b ?o)
  :why    "the table's row: Nfst of {?a} and {?b} is {?o}")
(rule Rorn-rows ()
  :match  (gate2 Rorn ?a ?b ?o)
  :assert (Rorn ?a ?b ?o)
  :why    "the table's row: Rorn of {?a} and {?b} is {?o}")
(rule Nand-rows ()
  :match  (gate2 Nand ?a ?b ?o)
  :assert (Nand ?a ?b ?o)
  :why    "the table's row: Nand of {?a} and {?b} is {?o}")
(rule One-rows ()
  :match  (gate2 One ?a ?b ?o)
  :assert (One ?a ?b ?o)
  :why    "the table's row: One of {?a} and {?b} is {?o}")

;; ── The closing rule, the module's entry ────────────────────────────────────
(relation gates-rule Rule
  :why "{?1} is a rule of the gates module")
(gates-rule gates)
(rule gates ()
  :match  ()
  :assert (and (__closed__ gate2) (__closed__ column-name) (__closed__ inv) (__closed__ le)
               (__closed__ bit) (__closed__ gates-rule)
               (__closed__ Zero) (__closed__ And) (__closed__ Andn) (__closed__ Fst)
               (__closed__ Randn) (__closed__ Snd) (__closed__ Xor) (__closed__ Or)
               (__closed__ Nor) (__closed__ Xnor) (__closed__ Nsnd) (__closed__ Orn)
               (__closed__ Nfst) (__closed__ Rorn) (__closed__ Nand) (__closed__ One)
               (gates-rule Zero-rows) (gates-rule And-rows) (gates-rule Andn-rows)
               (gates-rule Fst-rows) (gates-rule Randn-rows) (gates-rule Snd-rows)
               (gates-rule Xor-rows) (gates-rule Or-rows) (gates-rule Nor-rows)
               (gates-rule Xnor-rows) (gates-rule Nsnd-rows) (gates-rule Orn-rows)
               (gates-rule Nfst-rows) (gates-rule Rorn-rows) (gates-rule Nand-rows)
               (gates-rule One-rows))
  :why    "the sixteen functions are written and derived, and never guessed: every relation of the module is closed")
