;;; Ein stdlib — `std.bool.props`: what is known of the sixteen functions of
;;; `std.bool.gates`, derived from the table's 64 rows by rules (M1f P1f.6,
;;; S1f.6.17).
;;;
;;; Thirty relations, every fact of them derived and none written: each
;;; function's column, five relations between two functions, and twenty-four
;;; properties of one. The user ruled them rules in a module of their own
;;; (reply 20 (b), 2026-11-12: "I think we want to have those rules in
;;; separate reusable file"), so they can never disagree with the rows, a
;;; program that does not import this module pays nothing for them, and one
;;; that does pays 405 firings at root, beside `std.bool.gates`' 65 (`ein
;;; saturate` on a program that imports it and writes nothing else,
;;; 2026-11-14).
;;;
;;; ── Import ─────────────────────────────────────────────────────────────────
;;;
;;;     (import std.bool.props :symbols (commutative identity-of))
;;;     (import std.bool.gates :symbols (Xor And))
;;;
;;; An import brings the module whole, `std.bool.gates` with it (M1f
;;; S1f.6.35); a program lists the names it writes from the module that
;;; declares each: a relation below from this one, a function's name from
;;; `std.bool.gates` (its header says why a function's name is listed). `props`
;;; is the entry, the closing rule at the end of this file: it closes every
;;; relation of the module and names every rule, and `gates`, the entry of
;;; `std.bool.gates`.
;;;
;;; ── What is derived ────────────────────────────────────────────────────────
;;;
;;;     (column F A B C D)        F gives A, B, C and D at 00, 01, 10 and 11
;;;
;;; Between two functions, every function once on the left of each:
;;;
;;;     (swap-of F G)             G is F with its inputs exchanged
;;;     (complement-of F G)       G is F with its output negated
;;;     (dual-of F G)             G is De Morgan's dual of F: not F(not a, not b)
;;;     (left-negated F G)        G is F with its first input negated
;;;     (right-negated F G)       G is F with its second input negated
;;;
;;; Of one function:
;;;
;;;     (commutative F)           F(a, b) = F(b, a)
;;;     (associative F)           F(F(a, b), c) = F(a, F(b, c)), at all eight
;;;                               points (assoc-at F A B C)
;;;     (idempotent F)            F(a, a) = a
;;;     (reads-first F)           the output depends on the first input;
;;;     (reads-second F)          on the second
;;;     (ignores-first F)         it does not;
;;;     (ignores-second F)        nor on the second
;;;     (right-identity-of F E)   F(a, E) = a       (left-identity-of F E)    F(E, a) = a
;;;     (identity-of F E)         both sides
;;;     (right-absorbing-of F E)  F(a, E) = E       (left-absorbing-of F E)   F(E, a) = E
;;;     (absorbing-of F E)        both sides
;;;
;;; and Post's five classes, from inside and from outside:
;;;
;;;     (preserves-zero F)        F(0, 0) = 0       (escapes-zero F)          F(0, 0) = 1
;;;     (preserves-one F)         F(1, 1) = 1       (escapes-one F)           F(1, 1) = 0
;;;     (monotone F)              raising an input never lowers the output;
;;;                               (escapes-monotone F) one row does
;;;     (affine F)                a sum modulo 2 of inputs and a constant: an
;;;                               even number of ones; (escapes-affine F) odd
;;;     (self-dual F)             F is its own dual; (escapes-self-dual F) a
;;;                               row and its opposite give the same
;;;     (complete-alone F)        outside all five, so every function can be
;;;                               built from F alone: Nand and Nor
;;;
;;; How many facts each holds is the rows' to say, not this page's: each
;;; relation's whole extent is claimed by a program under
;;; `tests/stdlib/bool/props/`, which `utils/gen_gates.py` writes from the
;;; columns, and `ein-infer/tests/bool_theory.rs` holds every fact to an
;;; enumeration in Rust, the three counts the user confirmed (reply 22 (a))
;;; among them: four swap pairs and eight functions their own swap; the duals
;;; `Andn`/`Orn` and `Randn`/`Rorn`; twelve functions up to the order of the
;;; inputs. `python3 utils/gen_gates.py --count` prints them.
;;;
;;; ── How ────────────────────────────────────────────────────────────────────
;;;
;;; 31 rules and the closing rule, all monotone: no `absent` and no `not`. A
;;; function has four rows and all four are written, so *for every input* is a
;;; conjunction of premises, and *not in a class* is one witness row or pair
;;; of rows. `affine-r` reads Xor's own rows: the table states a property of
;;; the table.
;;;
;;; ── The names this module occupies ─────────────────────────────────────────
;;;
;;; The thirty relations above; the step `assoc-at`; the 31 rules,
;;; `column-of` to `complete-alone-r`; `props-rule`, and the entry `props`.
;;; Everything of `std.bool.gates` comes with it.

(import std.bool.gates :symbols (gates gate2 inv le Xor))

;; ── What is derived ─────────────────────────────────────────────────────────
(relation column Function Bit Bit Bit Bit
  :why "{?1} gives {?2}, {?3}, {?4} and {?5} at 00, 01, 10 and 11")
(relation swap-of Function Function
  :why "{?2} is {?1} with its inputs exchanged")
(relation complement-of Function Function
  :why "{?2} is {?1} with its output negated")
(relation dual-of Function Function
  :why "{?2} is De Morgan's dual of {?1}")
(relation left-negated Function Function
  :why "{?2} is {?1} with its first input negated")
(relation right-negated Function Function
  :why "{?2} is {?1} with its second input negated")
(relation commutative Function
  :why "{?1} is commutative")
(relation associative Function
  :why "{?1} is associative")
(relation idempotent Function
  :why "{?1} of a bit and itself is that bit")
(relation reads-first Function
  :why "{?1} depends on its first input")
(relation reads-second Function
  :why "{?1} depends on its second input")
(relation ignores-first Function
  :why "{?1} does not depend on its first input")
(relation ignores-second Function
  :why "{?1} does not depend on its second input")
(relation right-identity-of Function Bit
  :why "{?2} as the second input of {?1} gives the first")
(relation left-identity-of Function Bit
  :why "{?2} as the first input of {?1} gives the second")
(relation identity-of Function Bit
  :why "{?2} is neutral for {?1}")
(relation right-absorbing-of Function Bit
  :why "{?2} as the second input of {?1} gives {?2}")
(relation left-absorbing-of Function Bit
  :why "{?2} as the first input of {?1} gives {?2}")
(relation absorbing-of Function Bit
  :why "{?2} decides {?1}")
(relation preserves-zero Function
  :why "{?1} of 0 and 0 is 0")
(relation preserves-one Function
  :why "{?1} of 1 and 1 is 1")
(relation monotone Function
  :why "raising an input of {?1} never lowers its output")
(relation affine Function
  :why "{?1} is a sum modulo 2 of inputs and a constant")
(relation self-dual Function
  :why "{?1} is its own dual")
(relation escapes-zero Function
  :why "{?1} of 0 and 0 is 1")
(relation escapes-one Function
  :why "{?1} of 1 and 1 is 0")
(relation escapes-monotone Function
  :why "{?1} is not monotone")
(relation escapes-affine Function
  :why "{?1} is not affine")
(relation escapes-self-dual Function
  :why "{?1} is not its own dual")
(relation complete-alone Function
  :why "every function can be built from {?1} alone")
;; ── A step of the rules, and their names ────────────────────────────────────
(relation assoc-at Function Bit Bit Bit
  :why "{?1} associates at {?2}, {?3}, {?4}")
(relation props-rule Rule
  :why "{?1} is a rule that derives what is known of the sixteen")
(props-rule props)

;; ── The rules ───────────────────────────────────────────────────────────────
(rule column-of ()
  :match  (and (gate2 ?f 0 0 ?a) (gate2 ?f 0 1 ?b) (gate2 ?f 1 0 ?c) (gate2 ?f 1 1 ?d))
  :assert (column ?f ?a ?b ?c ?d)
  :why    "the four rows of {?f}")
(rule swap ()
  :match  (and (column ?f ?a ?b ?c ?d) (column ?g ?a ?c ?b ?d))
  :assert (swap-of ?f ?g)
  :why    "{?g}'s rows at 01 and 10 are {?f}'s at 10 and 01")
(rule complement ()
  :match  (and (column ?f ?a ?b ?c ?d) (inv ?a ?a1) (inv ?b ?b1) (inv ?c ?c1) (inv ?d ?d1)
               (column ?g ?a1 ?b1 ?c1 ?d1))
  :assert (complement-of ?f ?g)
  :why    "every output of {?g} is the negation of {?f}'s")
(rule dual ()
  :match  (and (column ?f ?a ?b ?c ?d) (inv ?a ?a1) (inv ?b ?b1) (inv ?c ?c1) (inv ?d ?d1)
               (column ?g ?d1 ?c1 ?b1 ?a1))
  :assert (dual-of ?f ?g)
  :why    "{?g} is {?f} with both inputs and the output negated")
(rule left-neg ()
  :match  (and (column ?f ?a ?b ?c ?d) (column ?g ?c ?d ?a ?b))
  :assert (left-negated ?f ?g)
  :why    "{?g} is {?f} with its first input negated")
(rule right-neg ()
  :match  (and (column ?f ?a ?b ?c ?d) (column ?g ?b ?a ?d ?c))
  :assert (right-negated ?f ?g)
  :why    "{?g} is {?f} with its second input negated")
(rule commutative-r ()
  :match  (column ?f ?a ?b ?b ?d)
  :assert (commutative ?f)
  :why    "{?f} gives the same at 01 and at 10")
(rule assoc-point ()
  :match  (and (gate2 ?f ?a ?b ?x) (gate2 ?f ?x ?c ?l) (gate2 ?f ?b ?c ?y) (gate2 ?f ?a ?y ?l))
  :assert (assoc-at ?f ?a ?b ?c)
  :why    "({?a} {?f} {?b}) {?f} {?c} and {?a} {?f} ({?b} {?f} {?c}) are both {?l}")
(rule associative-r ()
  :match  (and (assoc-at ?f 0 0 0) (assoc-at ?f 0 0 1) (assoc-at ?f 0 1 0) (assoc-at ?f 0 1 1)
               (assoc-at ?f 1 0 0) (assoc-at ?f 1 0 1) (assoc-at ?f 1 1 0) (assoc-at ?f 1 1 1))
  :assert (associative ?f)
  :why    "{?f} associates at all eight inputs")
(rule idempotent-r ()
  :match  (and (gate2 ?f 0 0 0) (gate2 ?f 1 1 1))
  :assert (idempotent ?f)
  :why    "{?f} of 0 and 0 is 0, and of 1 and 1 is 1")
(rule reads-first-r ()
  :match  (and (gate2 ?f 0 ?b ?x) (gate2 ?f 1 ?b ?y) (inv ?x ?y))
  :assert (reads-first ?f)
  :why    "with the second input {?b}, changing the first changes {?f}")
(rule reads-second-r ()
  :match  (and (gate2 ?f ?a 0 ?x) (gate2 ?f ?a 1 ?y) (inv ?x ?y))
  :assert (reads-second ?f)
  :why    "with the first input {?a}, changing the second changes {?f}")
(rule ignores-first-r ()
  :match  (column ?f ?a ?b ?a ?b)
  :assert (ignores-first ?f)
  :why    "{?f}'s rows do not change with the first input")
(rule ignores-second-r ()
  :match  (column ?f ?a ?a ?c ?c)
  :assert (ignores-second ?f)
  :why    "{?f}'s rows do not change with the second input")
(rule right-identity ()
  :match  (and (gate2 ?f 0 ?e 0) (gate2 ?f 1 ?e 1))
  :assert (right-identity-of ?f ?e)
  :why    "{?f} of a bit and {?e} is that bit")
(rule left-identity ()
  :match  (and (gate2 ?f ?e 0 0) (gate2 ?f ?e 1 1))
  :assert (left-identity-of ?f ?e)
  :why    "{?f} of {?e} and a bit is that bit")
(rule identity ()
  :match  (and (right-identity-of ?f ?e) (left-identity-of ?f ?e))
  :assert (identity-of ?f ?e)
  :why    "{?e} is neutral for {?f} on both sides")
(rule right-absorbing ()
  :match  (and (gate2 ?f 0 ?e ?e) (gate2 ?f 1 ?e ?e))
  :assert (right-absorbing-of ?f ?e)
  :why    "{?f} of any bit and {?e} is {?e}")
(rule left-absorbing ()
  :match  (and (gate2 ?f ?e 0 ?e) (gate2 ?f ?e 1 ?e))
  :assert (left-absorbing-of ?f ?e)
  :why    "{?f} of {?e} and any bit is {?e}")
(rule absorbing ()
  :match  (and (right-absorbing-of ?f ?e) (left-absorbing-of ?f ?e))
  :assert (absorbing-of ?f ?e)
  :why    "{?e} decides {?f} on both sides")
(rule preserves-zero-r ()
  :match  (gate2 ?f 0 0 0)
  :assert (preserves-zero ?f)
  :why    "{?f} of 0 and 0 is 0")
(rule preserves-one-r ()
  :match  (gate2 ?f 1 1 1)
  :assert (preserves-one ?f)
  :why    "{?f} of 1 and 1 is 1")
(rule monotone-r ()
  :match  (and (column ?f ?a ?b ?c ?d) (le ?a ?b) (le ?a ?c) (le ?b ?d) (le ?c ?d))
  :assert (monotone ?f)
  :why    "{?f}'s outputs never fall as an input rises")
(rule affine-r ()
  :match  (and (column ?f ?a ?b ?c ?d) (gate2 Xor ?a ?b ?x) (gate2 Xor ?c ?d ?x))
  :assert (affine ?f)
  :why    "{?f}'s four outputs have an even number of ones")
(rule self-dual-r ()
  :match  (dual-of ?f ?f)
  :assert (self-dual ?f)
  :why    "{?f} is its own dual")
;; Post's five classes from outside: each *is not in the class* is one witness row or pair of rows
(rule escapes-zero-r ()
  :match  (gate2 ?f 0 0 1)
  :assert (escapes-zero ?f)
  :why    "{?f} of 0 and 0 is 1")
(rule escapes-one-r ()
  :match  (gate2 ?f 1 1 0)
  :assert (escapes-one ?f)
  :why    "{?f} of 1 and 1 is 0")
(rule escapes-monotone-r ()
  :match  (and (gate2 ?f ?a ?b 1) (le ?a ?c) (le ?b ?d) (gate2 ?f ?c ?d 0))
  :assert (escapes-monotone ?f)
  :why    "{?f} is 1 at {?a}{?b} and 0 at {?c}{?d}, which is not lower")
(rule escapes-affine-r ()
  :match  (and (column ?f ?a ?b ?c ?d) (gate2 Xor ?a ?b ?x) (gate2 Xor ?c ?d ?y) (inv ?x ?y))
  :assert (escapes-affine ?f)
  :why    "{?f}'s four outputs have an odd number of ones")
(rule escapes-self-dual-r ()
  :match  (and (gate2 ?f ?a ?b ?x) (inv ?a ?a1) (inv ?b ?b1) (gate2 ?f ?a1 ?b1 ?x))
  :assert (escapes-self-dual ?f)
  :why    "{?f} gives {?x} at {?a}{?b} and at its opposite")
(rule complete-alone-r ()
  :match  (and (escapes-zero ?f) (escapes-one ?f) (escapes-monotone ?f) (escapes-affine ?f) (escapes-self-dual ?f))
  :assert (complete-alone ?f)
  :why    "{?f} is outside each of Post's five classes")

;; ── The closing rule, the module's entry ────────────────────────────────────
(rule props ()
  :match  ()
  :assert (and (__closed__ column) (__closed__ swap-of) (__closed__ complement-of)
               (__closed__ dual-of) (__closed__ left-negated) (__closed__ right-negated)
               (__closed__ commutative) (__closed__ associative) (__closed__ idempotent)
               (__closed__ reads-first) (__closed__ reads-second) (__closed__ ignores-first)
               (__closed__ ignores-second) (__closed__ right-identity-of)
               (__closed__ left-identity-of) (__closed__ identity-of)
               (__closed__ right-absorbing-of) (__closed__ left-absorbing-of)
               (__closed__ absorbing-of) (__closed__ preserves-zero) (__closed__ preserves-one)
               (__closed__ monotone) (__closed__ affine) (__closed__ self-dual)
               (__closed__ escapes-zero) (__closed__ escapes-one) (__closed__ escapes-monotone)
               (__closed__ escapes-affine) (__closed__ escapes-self-dual)
               (__closed__ complete-alone) (__closed__ assoc-at) (__closed__ props-rule)
               (props-rule column-of) (props-rule swap) (props-rule complement) (props-rule dual)
               (props-rule left-neg) (props-rule right-neg) (props-rule commutative-r)
               (props-rule assoc-point) (props-rule associative-r) (props-rule idempotent-r)
               (props-rule reads-first-r) (props-rule reads-second-r)
               (props-rule ignores-first-r) (props-rule ignores-second-r)
               (props-rule right-identity) (props-rule left-identity) (props-rule identity)
               (props-rule right-absorbing) (props-rule left-absorbing) (props-rule absorbing)
               (props-rule preserves-zero-r) (props-rule preserves-one-r) (props-rule monotone-r)
               (props-rule affine-r) (props-rule self-dual-r) (props-rule escapes-zero-r)
               (props-rule escapes-one-r) (props-rule escapes-monotone-r)
               (props-rule escapes-affine-r) (props-rule escapes-self-dual-r)
               (props-rule complete-alone-r) (props-rule gates))
  :why    "what is known of the sixteen is derived from the rows and never guessed: every relation of the module is closed")
