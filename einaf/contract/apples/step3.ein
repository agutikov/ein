;;; Bob has 5 apples. He gave 2 to Alice. How many apples does Bob have?
;;;
;;; Step 3, the complete program: step 2's program, the rules the library
;;; does not have, each saying what it asks the calculator and what it reads
;;; back, and the hypothesis mechanism.


;; ──── The statements ───────────────────────────────────────────

;; *He* is Bob; *2* is 2 apples. The sentences' order is their time: Bob has
;; 5 at the start, and the giving takes the start to the moment after.
(has  Bob (n z 5) Apple Start             :source "Bob has 5 apples.")
(gave Bob (n z 2) Apple Alice Start After :source "He gave 2 to Alice.")

;; *How many apples does Bob have?*, after the giving.
(query :goal (has Bob ?n Apple After) :goal-text "Bob has {?n} apples.")


;; ──── The ontology ─────────────────────────────────────────────

(relation has  Person Number Kind Moment
  :why "a {?3} has a {?4} of {?5}s at a {?6}")
(relation gave Person Number Kind Person Moment Moment
  :why "a {?3} gave a {?4} of {?5}s to a {?6}, from a {?7} to a {?8}")


;; ──── The theory ───────────────────────────────────────────────

(import std.math.decimal-arith :symbols (sub diff-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

;; Synthesised: what a giver has after giving is what the giver had less what
;; was given, asked of the calculator and read back.
(rule giving-asks-the-difference ()
  :match  (and (gave ?who ?k ?kind ?whom ?t0 ?t1) (has ?who ?m ?kind ?t0))
  :assert (sub ?m ?k)
  :why    "{?who} had {?m} {?kind}s and gave {?k}: ask {?m} less {?k}")
(rule giving-leaves-the-difference ()
  :match  (and (gave ?who ?k ?kind ?whom ?t0 ?t1) (has ?who ?m ?kind ?t0)
               (diff-of ?m ?k ?d z))
  :assert (has ?who ?d ?kind ?t1)
  :why    "{?who} had {?m} {?kind}s and gave {?k}, so {?who} has {?d}")

;; The hypothesis mechanism: none; the text states every fact there is.
(solve :no-search)
