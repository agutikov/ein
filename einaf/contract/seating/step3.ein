;;; Ann, Bob and Cy sit in a row of three chairs. Ann sits next to Bob. Cy
;;; does not sit in the first chair. Bob does not sit in the middle chair. Who
;;; sits in the first chair?
;;;
;;; Step 3, the complete program: step 2's program, the read-back that makes
;;; the answer query answerable, and the one rule the library does not have.
;;; The hypothesis mechanism is the obligations of the theory step 2 selected.


;; ──── The statements ───────────────────────────────────────────

(instance Ann    Person :source "Ann, Bob and Cy sit in a row of three chairs.")
(instance Bob    Person :source "Ann, Bob and Cy sit in a row of three chairs.")
(instance Cy     Person :source "Ann, Bob and Cy sit in a row of three chairs.")
(instance First  Chair  :source "Ann, Bob and Cy sit in a row of three chairs.")
(instance Middle Chair  :source "Ann, Bob and Cy sit in a row of three chairs.")
(instance Third  Chair  :source "Ann, Bob and Cy sit in a row of three chairs.")
(sits-next-to Ann Bob        :source "Ann sits next to Bob.")
(not (sits-in Cy First)      :source "Cy does not sit in the first chair.")
(not (sits-in Bob Middle)    :source "Bob does not sit in the middle chair.")

;; *Who sits in the first chair?*
(query :goal (sits-in ?who First) :goal-text "{?who} sits in the first chair.")


;; ──── The ontology ─────────────────────────────────────────────

(relation sits-in      Person Chair  :why "a {?3} sits in a {?4}")
(relation sits-next-to Person Person :why "a {?3} sits next to a {?4}")
(relation instance     T T           :why "{?3} is a {?4}")

;; What the theory reads the verbs into, and the kinds.
(relation same-chair       Attribute Attribute :why "a {?3} and a {?4} are at the same chair")
(relation next-to          Attribute Attribute :why "a {?3}'s chair is next to a {?4}'s")
(relation person-and-chair Person Chair        :why "a {?3} and a {?4}")
(relation type             T T                 :why "{?3} is a kind of {?4}")
(type Attribute T)
(type Person    Attribute)
(type Chair     Attribute)

;; The row the first sentence speaks of: the middle chair is next to the
;; other two.
(next-to First Middle)
(next-to Middle Third)


;; ──── The theory ───────────────────────────────────────────────

(import std.algebra :symbols (symmetric includes top meet))
(import std.slots)

;; A verb of a shared chair is a part of `same-chair`, a verb of a neighbour
;; a part of `next-to`.
(includes sits-in       same-chair)
(includes sits-next-to  next-to)
(symmetric same-chair)
(symmetric next-to)

;; `same-chair`'s classes are the chairs, each holding one person, and a chair
;; names its class; `next-to` holds between people exactly where it holds
;; between their chairs. Its obligations write the hypotheses: each person
;; owes a chair, each chair a person.
(slot-partition same-chair instance type Attribute Chair)
(slot-spatial   same-chair next-to instance Chair)

;; Where a person is, in the verb of the kind: a person sits in the chair the
;; person shares.
(top  person-and-chair instance Person Chair)
(meet same-chair person-and-chair sits-in)

;; Synthesised: a person who does not sit in a chair does not share it. The
;; library reads a verb into the link (`includes`) and the link back into the
;; verb (`meet`), and carries no negation of the verb to the link.
;; missing: a stored negation of the verb read into the link
(rule not-sitting-is-not-sharing ()
  :match  (not (sits-in ?p ?c))
  :assert (not (same-chair ?p ?c))
  :why    "{?p} does not sit in {?c}, so {?p} is not at {?c}")
