;;; The Zebra puzzle (its text beside, text.txt), step 1: the statements in
;;; the text's own words, one relation a verb in the sentence's voice; the
;;; two questions as the answer query, in the statements' own relations; and
;;; a partial ontology: the relations the statements and the query use, and
;;; what kind of thing each name the text names is, each membership quoting
;;; the first sentence that names the thing.
;;;
;;; What step 1 decided: which words name the same object (*the Old Gold
;;; smoker* is `Old_Gold`, the man of the brand; *the man who smokes
;;; Chesterfields* is `Chesterfields`; *the man with the fox* and *the house
;;; where the horse is kept* are `Fox` and `Horse`; *the green house* is
;;; `Green`; *snails* is `Snail`, *Parliaments* `Parliament`, *orange juice*
;;; `Juice`); what is an object (the houses, named by their places, and the
;;; values) and what a relation (a verb); one fact a sentence, five for
;;; *There are five houses*; and that the objects are of six kinds.


;; ──── The statements ───────────────────────────────────────────

;; *There are five houses* names five things of one kind, and no more.
(instance First  House :source "There are five houses.")
(instance Second House :source "There are five houses.")
(instance Middle House :source "There are five houses.")
(instance Fourth House :source "There are five houses.")
(instance Fifth  House :source "There are five houses.")

(lives-in    Englishman Red         :source "The Englishman lives in the red house.")
(owns        Spaniard   Dog         :source "The Spaniard owns the dog.")
(is-drunk-in Coffee     Green       :source "Coffee is drunk in the green house.")
(drinks      Ukrainian  Tea         :source "The Ukrainian drinks tea.")
(is-immediately-to-the-right-of Green Ivory
  :source "The green house is immediately to the right of the ivory house.")
(owns        Old_Gold   Snail       :source "The Old Gold smoker owns snails.")
(are-smoked-in Kools    Yellow      :source "Kools are smoked in the yellow house.")
(is-drunk-in Milk       Middle      :source "Milk is drunk in the middle house.")
(lives-in    Norwegian  First       :source "The Norwegian lives in the first house.")
(lives-next-to Chesterfields Fox
  :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(are-smoked-next-to Kools Horse
  :source "Kools are smoked in the house next to the house where the horse is kept.")
(drinks      Lucky_Strike Juice     :source "The Lucky Strike smoker drinks orange juice.")
(smokes      Japanese   Parliament  :source "The Japanese smokes Parliaments.")
(lives-next-to Norwegian Blue       :source "The Norwegian lives next to the blue house.")

;; *Who drinks water? Who owns the zebra?*
(query
  :goal (and (drinks ?who_water Water) (owns ?who_zebra Zebra))
  :goal-text "The {?who_water} drinks water. The {?who_zebra} owns the zebra.")


;; ──── The ontology ─────────────────────────────────────────────

;; The verbs, each with the words its sentences put in its places.
(relation lives-in       Man House       :why "a {?3} lives in a {?4}")
(relation owns           Man Pet         :why "a {?3} owns a {?4}")
(relation is-drunk-in    Drink House     :why "a {?3} is drunk in a {?4}")
(relation drinks         Man Drink       :why "a {?3} drinks a {?4}")
(relation are-smoked-in  Cigarette House :why "{?3}s are smoked in a {?4}")
(relation smokes         Man Cigarette   :why "a {?3} smokes {?4}s")
(relation is-immediately-to-the-right-of House House
  :why "a {?3} is immediately to the right of a {?4}")
(relation lives-next-to  Man Man         :why "a {?3} lives in the house next to a {?4}")
(relation are-smoked-next-to Cigarette House
  :why "{?3}s are smoked in the house next to a {?4}")

;; What kind of thing a name is.
(relation instance       T T                 :why "{?3} is a {?4}")

;; What kind of thing each name is, quoting the first sentence that names it.
(instance Red           Color       :source "The Englishman lives in the red house.")
(instance Green         Color       :source "Coffee is drunk in the green house.")
(instance Ivory         Color       :source "The green house is immediately to the right of the ivory house.")
(instance Yellow        Color       :source "Kools are smoked in the yellow house.")
(instance Blue          Color       :source "The Norwegian lives next to the blue house.")
(instance Englishman    Nationality :source "The Englishman lives in the red house.")
(instance Spaniard      Nationality :source "The Spaniard owns the dog.")
(instance Ukrainian     Nationality :source "The Ukrainian drinks tea.")
(instance Norwegian     Nationality :source "The Norwegian lives in the first house.")
(instance Japanese      Nationality :source "The Japanese smokes Parliaments.")
(instance Coffee        Drink       :source "Coffee is drunk in the green house.")
(instance Tea           Drink       :source "The Ukrainian drinks tea.")
(instance Milk          Drink       :source "Milk is drunk in the middle house.")
(instance Juice         Drink       :source "The Lucky Strike smoker drinks orange juice.")
(instance Water         Drink       :source "Who drinks water?")
(instance Old_Gold      Cigarette   :source "The Old Gold smoker owns snails.")
(instance Kools         Cigarette   :source "Kools are smoked in the yellow house.")
(instance Chesterfields Cigarette   :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(instance Lucky_Strike  Cigarette   :source "The Lucky Strike smoker drinks orange juice.")
(instance Parliament    Cigarette   :source "The Japanese smokes Parliaments.")
(instance Dog           Pet         :source "The Spaniard owns the dog.")
(instance Snail         Pet         :source "The Old Gold smoker owns snails.")
(instance Fox           Pet         :source "The man who smokes Chesterfields lives in the house next to the man with the fox.")
(instance Horse         Pet         :source "Kools are smoked in the house next to the house where the horse is kept.")
(instance Zebra         Pet         :source "Who owns the zebra?")
