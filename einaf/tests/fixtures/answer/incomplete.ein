;;; Ann owes a food she likes and none is proposed: R is empty, root owing.
(import std.algebra :symbols (total-owed))
(relation is-a T T :why "{?3} is a {?4}")
(relation likes Person Food :why "{?3} likes {?4}")
(is-a Ann Person :source "Ann eats.")
(is-a Soup Food :source "There is soup.")
(total-owed likes is-a)
(solve :no-search)
(query :goal (likes Ann ?f) :goal-text "Ann likes {?f}.")
