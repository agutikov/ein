;;; Catalogue entry: the calculator's sub, std.math.decimal-arith.

(import std.math.decimal-arith :symbols (sub diff-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation has      Person Number :why "a {?3} has a {?4} of apples")
(relation has-more Person Number :why "a {?3} has a {?4} more")
(has Ann (n (n z 1) 2))
(has Bob (n z 5))

;; (sub X Y) is answered by (diff-of X Y D R): D is X less Y where X is not
;; the smaller, else z; R is Y less X where X is the smaller, else z.
(rule more-asks-the-difference ()
  :match  (and (has Ann ?a) (has Bob ?b))
  :assert (sub ?a ?b)
  :why    "Ann has {?a} and Bob {?b}: ask {?a} less {?b}")
(rule more-is-the-difference ()
  :match  (and (has Ann ?a) (has Bob ?b) (diff-of ?a ?b ?d z))
  :assert (has-more Ann ?d)
  :why    "{?a} less {?b} is {?d}")

(query :goal (has-more Ann ?d) :goal-text "Ann has {?d} more apples.")
(solve :no-search)
