;;; Catalogue entry: the calculator's div, std.math.decimal-arith.

(import std.math.decimal-arith :symbols (div quot-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation has      Person Number :why "a {?3} has {?4} sweets")
(relation shared-among Person Number :why "a {?3} shares among {?4} friends")
(relation each-gets Number Number  :why "each friend gets {?3} and {?4} are left")
(has Ann (n (n z 1) 7))
(shared-among Ann (n z 5))

;; (div X Y) is answered by (quot-of X Y Q R): Q the quotient, R the rest.
(rule sharing-asks-the-quotient ()
  :match  (and (has Ann ?a) (shared-among Ann ?k))
  :assert (div ?a ?k)
  :why    "Ann shares {?a} among {?k}: ask {?a} divided by {?k}")
(rule sharing-is-the-quotient ()
  :match  (and (has Ann ?a) (shared-among Ann ?k) (quot-of ?a ?k ?q ?r))
  :assert (each-gets ?q ?r)
  :why    "{?a} among {?k} is {?q} each and {?r} left")

(query :goal (each-gets ?q ?r) :goal-text "Each friend gets {?q} sweets and {?r} are left.")
(solve :no-search)
