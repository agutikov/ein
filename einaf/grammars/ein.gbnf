                 [*+\-.0-9=A-Z_a-ln-z] m-tok-name-rest

# after `region`
m-tok-name-101 ::= [*+\-.0-9=A-Z_a-z] m-tok-name-rest

# after `relati`
m-tok-name-102 ::= "" |
                 "o" m-tok-name-104 |
                 [*+\-.0-9=A-Z_a-np-z] m-tok-name-rest

# after `program`
m-tok-name-103 ::= [*+\-.0-9=A-Z_a-z] m-tok-name-rest

# after `relatio`
m-tok-name-104 ::= "" |
                 "n" m-tok-name-105 |
                 [*+\-.0-9=A-Z_a-mo-z] m-tok-name-rest

# after `relation`
m-tok-name-105 ::= [*+\-.0-9=A-Z_a-z] m-tok-name-rest

m-tok-name-rest ::= [*+\-.0-9=A-Z_a-z]*

# hand-written: ?a run of the name characters less `?_`
m-tok-var ::= "?" ( "_" m-tok-var-1 | [*+\-.0-9=A-Za-z] m-tok-var-rest )

# after `?_`
m-tok-var-1 ::= [*+\-.0-9=A-Z_a-z] m-tok-var-rest

m-tok-var-rest ::= [*+\-.0-9=A-Z_a-z]*

# ein.l: TEXT, node for node, less `<`, `>`, `|` and the backtick
m-tok-text ::= "\"" ( [^\"<>\\`|] | "\\" [\"\\nrt] | "\\u{" ( "0"{0,5} [0-9A-Fa-f] | "0"{0,4} [1-9A-Fa-f] [0-9A-Fa-f] | "0"{0,3} [1-9A-Fa-f] [0-9A-Fa-f]{2} | "0"{0,2} ( [1-9A-CEFa-cef] [0-9A-Fa-f]{3} | [Dd] [0-7] [0-9A-Fa-f]{2} ) | "0"? [1-9A-Fa-f] [0-9A-Fa-f]{4} | "10" [0-9A-Fa-f]{4} ) "}" )* "\""

# ein.l: the skip rule's line comment, node for node, less `<`, `>`, `|` and the backtick
m-comment-line ::= ";" [^\n<>`|]*

# hand-written: a line comment runs to the end of its line
m-comment-line-ended ::= m-comment-line "\n"

# hand-written: any separator of white space and line comments, none too: after a paren, or before one
m-gap ::= ( space | m-comment-line-ended )*

# hand-written: between two tokens that are no paren, a separator is required
m-gap-word ::= ( space | m-comment-line-ended )+

# hand-written: the text's last separator, which may end in a line comment with no line break
m-gap-end ::= m-gap m-comment-line?

# hand-written: a text of every form ein.y's Program takes, between separators
program ::= gap-end |
          gap program-forms gap-end

program-forms ::= top-form program-forms-1

program-forms-1 ::= gap top-form program-forms-1 |
                  ""

