                gap neg-fact nested-fact-5 |
                gap ")"

# ein.y: EqFact
eq-fact ::= "(" eq-fact-1

eq-fact-1 ::= gap "eq" eq-fact-2

eq-fact-2 ::= gap-word name eq-fact-2 |
            gap nested-fact eq-fact-3 |
            gap neg-fact eq-fact-3 |
            gap ")"

eq-fact-3 ::= gap name eq-fact-2 |
            gap nested-fact eq-fact-3 |
            gap neg-fact eq-fact-3 |
            gap ")"

# ein.y: Relation
relation ::= "(" relation-1

relation-1 ::= gap "relation" relation-2

relation-2 ::= gap-word decl-name relation-3

relation-3 ::= gap-word name relation-3 |
             gap-word ":why" relation-4 |
             gap ")"

relation-4 ::= gap-word text relation-5

relation-5 ::= gap-text ":why" relation-4 |
             gap-after-text ")"

# ein.y: Rule
rule ::= "(" rule-1

