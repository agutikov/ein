# ein.l: TEXT, node for node
tok-text ::= "\"" ( [^\"\\] | "\\" [\"\\nrt] | "\\u{" ( "0"{0,5} [0-9A-Fa-f] | "0"{0,4} [1-9A-Fa-f] [0-9A-Fa-f] | "0"{0,3} [1-9A-Fa-f] [0-9A-Fa-f]{2} | "0"{0,2} ( [1-9A-CEFa-cef] [0-9A-Fa-f]{3} | [Dd] [0-7] [0-9A-Fa-f]{2} ) | "0"? [1-9A-Fa-f] [0-9A-Fa-f]{4} | "10" [0-9A-Fa-f]{4} ) "}" )* "\""

# ein.l: the skip rule's white space, node for node
space ::= [\t-\r\x1C- ]

# ein.l: the skip rule's line comment, node for node
comment-line ::= ";" [^\n]*

# ein.l: the skip rule's block comment, node for node
comment-block ::= "#|" ( [^|] | "|"+ [^#|] )* "|"+ "#"

# hand-written: a line comment runs to the end of its line
comment-line-ended ::= comment-line "\n"

# hand-written: any separator, none too: after a paren, or before one
gap ::= ( space | comment-line-ended | comment-block )*

# hand-written: after a word and before a word or a string, a separator is required
gap-word ::= ( space | comment-line-ended | comment-block )+

# hand-written: after a string, a separator is required before a word or a string, and does not begin with `#`
gap-text ::= ( space | comment-line-ended ) gap

# hand-written: after a string and before a paren, none, or a separator that does not begin with `#`
gap-after-text ::= gap-text |
                 ""

# hand-written: the text's last separator, which may end in a line comment with no line break
gap-end ::= gap comment-line?
