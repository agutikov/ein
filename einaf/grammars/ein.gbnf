template-p-7 ::= gap template-p template-p-12 |
               gap-word template-w template-p-13

template-p-8 ::= gap-word name template-p-14 |
               gap template-p template-p-15 |
               gap-word template-w template-p-14

template-p-9 ::= gap-word name template-p-9 |
               gap template-p template-p-16 |
               gap-word template-w template-p-9 |
               gap ")"

template-p-10 ::= gap template-p template-p-10 |
                gap template-w template-p-11 |
                gap ")"

template-p-11 ::= gap template-p template-p-10 |
                gap-word template-w template-p-11 |
                gap ")"

template-p-12 ::= gap ")"

template-p-13 ::= gap ")"

template-p-14 ::= gap-word name template-p-13 |
                gap template-p template-p-12 |
                gap-word template-w template-p-13

template-p-15 ::= gap name template-p-13 |
                gap template-p template-p-12 |
                gap template-w template-p-13

template-p-16 ::= gap name template-p-9 |
                gap template-p template-p-16 |
                gap template-w template-p-9 |
                gap ")"

# ein.y: Template, its alternatives that begin with a word and end with a word
template-w ::= var

# ein.y: Import
import ::= "(" import-1

import-1 ::= gap "import" import-2

import-2 ::= gap-word name import-3

import-3 ::= gap-word ":symbols" import-4 |
           gap-word ":as" import-5 |
           gap ")"

import-4 ::= gap name-list-plus import-6

import-5 ::= gap-word decl-name import-3

import-6 ::= gap ":symbols" import-4 |
           gap ":as" import-5 |
           gap ")"

# ein.y: Trace
trace ::= "(" trace-1

trace-1 ::= gap "trace" trace-2

trace-2 ::= gap step trace-3 |
          gap ")"

trace-3 ::= gap step trace-3 |
          gap ")"

# ein.y: Step
step ::= "(" step-1

step-1 ::= gap "step" step-2

step-2 ::= gap-word name step-3

step-3 ::= gap-word ":rule" step-2 |
         gap-word ":using" step-4 |
         gap-word ":derives" step-5 |
         gap-word ":source" step-6 |
         gap-word ":assumes" step-5 |
         gap ")"

step-4 ::= gap step-using step-7

step-5 ::= gap derived step-7

step-6 ::= gap-word text step-8

step-7 ::= gap ":rule" step-2 |
         gap ":using" step-4 |
         gap ":derives" step-5 |
         gap ":source" step-6 |
         gap ":assumes" step-5 |
         gap ")"

step-8 ::= gap-text ":rule" step-2 |
         gap-text ":using" step-4 |
         gap-text ":derives" step-5 |
         gap-text ":source" step-6 |
         gap-text ":assumes" step-5 |
         gap-after-text ")"

# ein.y: StepUsing
step-using ::= name-list-plus |
             "(" step-using-1

step-using-1 ::= gap "and" step-using-2

step-using-2 ::= gap-word name step-using-3

step-using-3 ::= gap-word name step-using-3 |
               gap ")"

# ein.y: Derived
derived ::= nested-fact |
          neg-fact

# ein.y: Saved
saved ::= "(" saved-1 |
        "(" saved-2 |
        "(" saved-3

saved-1 ::= gap "program" saved-4

saved-2 ::= gap "module" saved-5

saved-3 ::= gap "commit" saved-6

saved-4 ::= gap form saved-7 |
          gap ")"

saved-5 ::= gap-word module-name saved-4

saved-6 ::= gap commit-fact saved-8

saved-7 ::= gap form saved-7 |
          gap ")"

saved-8 ::= gap commit-fact saved-8 |
          gap ")"

# ein.y: ModuleName
module-name ::= name

# ein.y: CommitFact
commit-fact ::= nested-fact |
              neg-fact

