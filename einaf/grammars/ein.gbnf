# Ein's grammar as GBNF: generated from ein.l and ein.y, and the hand-written rules
# that stand for what Ein's lexer does beside them. Do not edit: regenerate.
#
# Two roots: `root`, the forms a program the formalization contract admits is written
# from, and `program`, every form ein.y's Program takes.

# hand-written: a text of the forms the contract admits, between separators
root ::= gap-end |
       gap root-forms gap-end

# hand-written: a text of every form ein.y's Program takes, between separators
program ::= gap-end |
          gap program-forms gap-end

root-forms ::= relation root-forms-1 |
             rule root-forms-1 |
             query root-forms-1 |
             solve root-forms-1 |
             import root-forms-1 |
             not-fact root-forms-1 |
             fact root-forms-1 |
             open-fact root-forms-1

root-forms-1 ::= gap relation root-forms-1 |
               gap rule root-forms-1 |
               gap query root-forms-1 |
               gap solve root-forms-1 |
               gap import root-forms-1 |
               gap not-fact root-forms-1 |
               gap fact root-forms-1 |
               gap open-fact root-forms-1 |
               ""

program-forms ::= top-form program-forms-1

program-forms-1 ::= gap top-form program-forms-1 |
                  ""

# ein.y: TopForm
top-form ::= form |
           saved

# ein.y: Form
form ::= relation |
       rule |
       query |
       solve |
       config |
       trace |
       macro |
       import |
       not-fact |
       fact |
       open-fact

# ein.y: Name
name ::= head-name |
       "not"

# ein.y: HeadName
head-name ::= tok-name |
            "relation" |
            "step" |
            "eq" |
            "absent" |
            "false" |
            "true" |
            "open" |
            "model" |
            "region" |
            "merged" |
            "owing" |
            "program" |
            "module" |
            "commit"

# ein.y: DeclName
decl-name ::= tok-name |
            "false" |
            "not" |
            "step" |
            "true" |
            "model" |
            "region" |
            "merged" |
            "owing" |
            "program" |
            "module" |
            "commit"

# ein.y: FactHead
fact-head ::= tok-name |
            "step" |
            "eq" |
            "true" |
            "model"

# ein.y: ValueHead
value-head ::= open-head |
             "absent"

# ein.y: OpenHead
open-head ::= ordinary-head |
            "open"

# ein.y: OrdinaryHead
ordinary-head ::= tok-name |
                "relation" |
                "step" |
                "true" |
                "model" |
                "region" |
                "merged" |
                "owing" |
                "program" |
                "module" |
                "commit"

# ein.y: PremiseHead
premise-head ::= open-head |
               var

# ein.y: ConclusionHead
conclusion-head ::= ordinary-head |
                  var

# ein.y: Var
var ::= tok-var

# ein.y: Text
text ::= tok-text

# ein.y: Bool
bool ::= "true" |
       "false"

# ein.y: NameList
name-list ::= "(" name-list-1 |
            "(" name-list-2

name-list-1 ::= gap ")"

name-list-2 ::= gap name name-list-3

name-list-3 ::= gap-word name name-list-3 |
              gap ")"

# ein.y: NameListPlus
name-list-plus ::= "(" name-list-plus-1

name-list-plus-1 ::= gap name name-list-plus-2

name-list-plus-2 ::= gap-word name name-list-plus-2 |
                   gap ")"

# ein.y: Fact
fact ::= "(" fact-1 |
       "(" fact-2

fact-1 ::= gap fact-head fact-3

fact-2 ::= gap "false" fact-4

fact-3 ::= gap-word name fact-3 |
         gap nested-fact fact-5 |
         gap neg-fact fact-5 |
         gap-word ":source" fact-6 |
         gap-word ":rule" fact-7 |
         gap-word ":using" fact-8 |
         gap ")"

fact-4 ::= gap-word ":source" fact-6 |
         gap-word ":rule" fact-7 |
         gap-word ":using" fact-8 |
         gap ")"

fact-5 ::= gap name fact-3 |
         gap nested-fact fact-5 |
         gap neg-fact fact-5 |
         gap ":source" fact-6 |
         gap ":rule" fact-7 |
         gap ":using" fact-8 |
         gap ")"

fact-6 ::= gap-word text fact-9

fact-7 ::= gap-word name fact-4

fact-8 ::= gap "(" fact-10

fact-9 ::= gap-text ":source" fact-6 |
         gap-text ":rule" fact-7 |
         gap-text ":using" fact-8 |
         gap-after-text ")"

fact-10 ::= gap nested-fact fact-11

fact-11 ::= gap nested-fact fact-11 |
          gap ")" fact-12

fact-12 ::= gap ":source" fact-6 |
          gap ":rule" fact-7 |
          gap ":using" fact-8 |
          gap ")"

# ein.y: OpenFact
open-fact ::= "(" open-fact-1

open-fact-1 ::= gap "open" open-fact-2

open-fact-2 ::= gap-word name open-fact-3 |
              gap opened-fact open-fact-4 |
              gap neg-fact open-fact-4

open-fact-3 ::= gap-word ":source" open-fact-5 |
              gap-word ":rule" open-fact-6 |
              gap-word ":using" open-fact-7 |
              gap ")"

open-fact-4 ::= gap ":source" open-fact-5 |
              gap ":rule" open-fact-6 |
              gap ":using" open-fact-7 |
              gap ")"

open-fact-5 ::= gap-word text open-fact-8

open-fact-6 ::= gap-word name open-fact-3

open-fact-7 ::= gap "(" open-fact-9

open-fact-8 ::= gap-text ":source" open-fact-5 |
              gap-text ":rule" open-fact-6 |
              gap-text ":using" open-fact-7 |
              gap-after-text ")"

open-fact-9 ::= gap nested-fact open-fact-10

open-fact-10 ::= gap nested-fact open-fact-10 |
               gap ")" open-fact-4

# ein.y: OpenedFact
opened-fact ::= "(" opened-fact-1 |
              "(" opened-fact-2

opened-fact-1 ::= gap ordinary-head opened-fact-3

opened-fact-2 ::= gap "false" opened-fact-4

opened-fact-3 ::= gap-word name opened-fact-3 |
                gap nested-fact opened-fact-5 |
                gap neg-fact opened-fact-5 |
                gap ")"

opened-fact-4 ::= gap ")"

opened-fact-5 ::= gap name opened-fact-3 |
                gap nested-fact opened-fact-5 |
                gap neg-fact opened-fact-5 |
                gap ")"

# ein.y: NotFact
not-fact ::= "(" not-fact-1 |
           "(" not-fact-2 |
           "(" not-fact-3

not-fact-1 ::= gap "not" not-fact-4

not-fact-2 ::= gap "not" not-fact-5

not-fact-3 ::= gap "not" not-fact-6

not-fact-4 ::= gap nested-fact not-fact-7

not-fact-5 ::= gap neg-fact not-fact-7

not-fact-6 ::= gap eq-fact not-fact-7

not-fact-7 ::= gap ":source" not-fact-8 |
             gap ":rule" not-fact-9 |
             gap ":using" not-fact-10 |
             gap ")"

not-fact-8 ::= gap-word text not-fact-11

not-fact-9 ::= gap-word name not-fact-12

not-fact-10 ::= gap "(" not-fact-13

not-fact-11 ::= gap-text ":source" not-fact-8 |
