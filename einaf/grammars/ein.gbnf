rule-2 ::= gap-word decl-name rule-3

rule-3 ::= gap params rule-4

rule-4 ::= gap ":match" rule-5 |
         gap ":assert" rule-6 |
         gap ":ein" rule-7 |
         gap ":why" rule-8 |
         gap ")"

rule-5 ::= gap match rule-4

rule-6 ::= gap assert rule-4

rule-7 ::= gap-word name rule-9

rule-8 ::= gap-word text rule-10

rule-9 ::= gap-word ":match" rule-5 |
         gap-word ":assert" rule-6 |
         gap-word ":ein" rule-7 |
         gap-word ":why" rule-8 |
         gap ")"

rule-10 ::= gap-text ":match" rule-5 |
