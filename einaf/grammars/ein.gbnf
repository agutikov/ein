# Ein's grammar as GBNF: generated from ein.l and ein.y, and the hand-written rules
# that stand for what Ein's lexer does beside them. Do not edit: regenerate.
#
# Two roots. `root`: the forms a program the formalization contract admits, in the
# characters a model writes: a name or a variable of letters, digits and `_ . * + = -`,
# no block comment, and no `<`, `>`, `|` or backtick in a string or a comment; the rules
# it alone reaches are named `m-…`. `program`: every form ein.y's Program takes, as
# Ein's lexer and parser read it.

# hand-written: a text of the forms the contract admits, between separators, in the characters a model writes
root ::= m-gap-end |
       m-gap root-forms m-gap-end

root-forms ::= m-relation root-forms-1 |
             m-rule root-forms-1 |
             m-query root-forms-1 |
             m-solve root-forms-1 |
             m-import root-forms-1 |
             m-not-fact root-forms-1 |
             m-fact root-forms-1 |
             m-open-fact root-forms-1

root-forms-1 ::= m-gap m-relation root-forms-1 |
               m-gap m-rule root-forms-1 |
               m-gap m-query root-forms-1 |
               m-gap m-solve root-forms-1 |
               m-gap m-import root-forms-1 |
               m-gap m-not-fact root-forms-1 |
               m-gap m-fact root-forms-1 |
               m-gap m-open-fact root-forms-1 |
               ""

# ein.y: Name
m-name ::= m-head-name |
         "not"

# ein.y: HeadName
m-head-name ::= m-tok-name |
              "relation" |
              "step" |
              "eq" |
              "absent" |
              "false" |
              "true" |
              "open" |
              "model" |
              "region" |
              "merged" |
              "owing" |
              "program" |
              "module" |
              "commit"

# ein.y: DeclName
m-decl-name ::= m-tok-name |
              "false" |
              "not" |
              "step" |
              "true" |
              "model" |
              "region" |
              "merged" |
              "owing" |
              "program" |
              "module" |
              "commit"

# ein.y: FactHead
m-fact-head ::= m-tok-name |
              "step" |
              "eq" |
              "true" |
              "model"

# ein.y: ValueHead
m-value-head ::= m-open-head |
               "absent"

# ein.y: OpenHead
m-open-head ::= m-ordinary-head |
              "open"

# ein.y: OrdinaryHead
m-ordinary-head ::= m-tok-name |
                  "relation" |
                  "step" |
                  "true" |
                  "model" |
                  "region" |
                  "merged" |
                  "owing" |
                  "program" |
                  "module" |
                  "commit"

# ein.y: PremiseHead
m-premise-head ::= m-open-head |
                 m-var

# ein.y: ConclusionHead
m-conclusion-head ::= m-ordinary-head |
                    m-var

# ein.y: Var
m-var ::= m-tok-var

# ein.y: Text
m-text ::= m-tok-text

# ein.y: NameList
m-name-list ::= "(" m-name-list-1 |
              "(" m-name-list-2

m-name-list-1 ::= m-gap ")"

m-name-list-2 ::= m-gap m-name m-name-list-3

m-name-list-3 ::= m-gap-word m-name m-name-list-3 |
                m-gap ")"

# ein.y: NameListPlus
m-name-list-plus ::= "(" m-name-list-plus-1

m-name-list-plus-1 ::= m-gap m-name m-name-list-plus-2

m-name-list-plus-2 ::= m-gap-word m-name m-name-list-plus-2 |
                     m-gap ")"

# ein.y: Fact
m-fact ::= "(" m-fact-1 |
         "(" m-fact-2

m-fact-1 ::= m-gap m-fact-head m-fact-3

m-fact-2 ::= m-gap "false" m-fact-4

m-fact-3 ::= m-gap-word m-name m-fact-3 |
           m-gap m-nested-fact m-fact-5 |
           m-gap m-neg-fact m-fact-5 |
           m-gap-word ":source" m-fact-6 |
           m-gap-word ":rule" m-fact-7 |
           m-gap-word ":using" m-fact-8 |
           m-gap ")"

m-fact-4 ::= m-gap-word ":source" m-fact-6 |
           m-gap-word ":rule" m-fact-7 |
           m-gap-word ":using" m-fact-8 |
           m-gap ")"

m-fact-5 ::= m-gap m-name m-fact-3 |
           m-gap m-nested-fact m-fact-5 |
           m-gap m-neg-fact m-fact-5 |
           m-gap ":source" m-fact-6 |
           m-gap ":rule" m-fact-7 |
           m-gap ":using" m-fact-8 |
           m-gap ")"

m-fact-6 ::= m-gap-word m-text m-fact-9

m-fact-7 ::= m-gap-word m-name m-fact-4

m-fact-8 ::= m-gap "(" m-fact-10

m-fact-9 ::= m-gap-word ":source" m-fact-6 |
           m-gap-word ":rule" m-fact-7 |
           m-gap-word ":using" m-fact-8 |
           m-gap ")"

m-fact-10 ::= m-gap m-nested-fact m-fact-11

m-fact-11 ::= m-gap m-nested-fact m-fact-11 |
            m-gap ")" m-fact-12

m-fact-12 ::= m-gap ":source" m-fact-6 |
            m-gap ":rule" m-fact-7 |
            m-gap ":using" m-fact-8 |
            m-gap ")"

