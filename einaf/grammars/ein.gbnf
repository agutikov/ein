              gap ")"

not-fact-13 ::= gap nested-fact not-fact-14

not-fact-14 ::= gap nested-fact not-fact-14 |
              gap ")" not-fact-7

# ein.y: NegFact
neg-fact ::= "(" neg-fact-1 |
           "(" neg-fact-2

neg-fact-1 ::= gap "not" neg-fact-3

neg-fact-2 ::= gap "not" neg-fact-4

neg-fact-3 ::= gap nested-fact neg-fact-5

neg-fact-4 ::= gap neg-fact neg-fact-5

neg-fact-5 ::= gap ")"

# ein.y: NestedFact
nested-fact ::= "(" nested-fact-1 |
              "(" nested-fact-2

nested-fact-1 ::= gap value-head nested-fact-3

nested-fact-2 ::= gap "false" nested-fact-4

nested-fact-3 ::= gap-word name nested-fact-3 |
                gap nested-fact nested-fact-5 |
                gap neg-fact nested-fact-5 |
