;;; A theory built on a theory, imported by its entry: both come whole
;;; (Q-M1f.247), the twin of
;;; `02_nested_import_left_behind.ein`.
;;;
;;; `upper`'s entry names `lower`, the lower theory's entry, and the import
;;; brings every rule of both, as it would without that name. The request is
;;; answered, and the loader prints nothing.

(import upper :symbols (upper wanted got))

(wanted a)

(solve :expect (region (model)))
(query :goal (got ?x ?y)
       :goal-text "{?x}'s double is {?y}"
       :expect (model (got a aa)))
