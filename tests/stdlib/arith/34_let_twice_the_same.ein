;;; `std.arith` — a name stated twice with one number is one fact. M1f
;;; S1f.6.12.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A fact stated twice is one fact, so `(let price …)` written twice with
;;; the same number is one `let`, and `let-twice` does not fire: its guard
;;; asks for two different numbers. High zeros make two numbers of one value,
;;; and those are two `let`s: the comparison is by what is written.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}, the sum is 6, and `malformed` has no fact.

(import std.arith :symbols (arith let n add sum-of malformed))

(let price (n z 5))
(let price (n z 5))
(add price (n z 1))

(solve :expect (region (model)))

(query :goal (sum-of price ?y ?s)
       :goal-text "price + {?y} = {?s}"
       :expect (model (sum-of price (n z 1) (n z 6))))

(query :goal (malformed ?request)
       :goal-text "{?request} holds something that is not a number"
       :expect (model))
