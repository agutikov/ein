;;; `std.arith` — multiplication: zero on either side, zeros inside the
;;; multiplier, high zeros, one, and a carry out of every row. M1f S1f.6.5.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The product is in normal form whatever the operands are written with, and
;;; a zero digit of the multiplier is a row of zeros like any other row: the
;;; sum so far is multiplied by ten and nothing is added.
;;;
;;;   0 x 7          = 0          no column at all: the row is zero
;;;   7 x 0          = 0          the multiplier has no digit: nothing is summed
;;;   305 x 1002     = 305610     two rows of zeros in the middle
;;;   007 x 05       = 35         high zeros on both sides: a row of zeros
;;;                               first, and high zeros dropped from a row
;;;   999 x 999      = 998001     a carry out of the top of every row
;;;   1 x 4567       = 4567
;;;   4567 x 1       = 4567       one row, with no carry anywhere
;;;   25 x 4         = 100        a product that ends in zeros
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `product-of`'s whole extent, the operands as written, each product in
;;; normal form: an answer `(n (n (n z 0) 3) 5)` for 007 x 05, or `(n z 0)`
;;; for 0 x 7, fails the file.

(import std.arith :symbols (arith mul n product-of))

(mul z (n z 7))
(mul (n z 7) z)
(mul (n (n (n z 3) 0) 5) (n (n (n (n z 1) 0) 0) 2))
(mul (n (n (n z 0) 0) 7) (n (n z 0) 5))
(mul (n (n (n z 9) 9) 9) (n (n (n z 9) 9) 9))
(mul (n z 1) (n (n (n (n z 4) 5) 6) 7))
(mul (n (n (n (n z 4) 5) 6) 7) (n z 1))
(mul (n (n z 2) 5) (n z 4))

(solve :expect (region (model)))

(query :goal (product-of ?x ?y ?p)
       :goal-text "{?x} x {?y} = {?p}"
       :expect (model (product-of z (n z 7) z)
                      (product-of (n z 7) z z)
                      (product-of (n (n (n z 3) 0) 5) (n (n (n (n z 1) 0) 0) 2)
                                  (n (n (n (n (n (n z 3) 0) 5) 6) 1) 0))
                      (product-of (n (n (n z 0) 0) 7) (n (n z 0) 5) (n (n z 3) 5))
                      (product-of (n (n (n z 9) 9) 9) (n (n (n z 9) 9) 9)
                                  (n (n (n (n (n (n z 9) 9) 8) 0) 0) 1))
                      (product-of (n z 1) (n (n (n (n z 4) 5) 6) 7) (n (n (n (n z 4) 5) 6) 7))
                      (product-of (n (n (n (n z 4) 5) 6) 7) (n z 1) (n (n (n (n z 4) 5) 6) 7))
                      (product-of (n (n z 2) 5) (n z 4) (n (n (n z 1) 0) 0))))
