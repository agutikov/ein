;;; `std.arith` — comparison by value: numbers of different lengths, high
;;; zeros, zero, and named operands. M1f S1f.6.4.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A number that has run out counts as zeros (`cmp-column-first`,
;;; `cmp-column-second`), so the comparison is by value: a longer number is
;;; the greater only where its extra digits are not all zero, and 5 and 005
;;; are equal. A request may name its operands, and the answer repeats the
;;; names.
;;;
;;;   1000 against 999     gt: the fourth digit, 1 against nothing
;;;   999 against 1000     lt
;;;   5 against 005        eq, and 005 against 5 too
;;;   07 against 5         gt: the high zero changes nothing
;;;   0 against 0          eq, with no column at all
;;;   0 against 3          lt
;;;   small against large  lt, by the numbers the names stand for
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `cmp-of`'s whole extent, the operands as written. The second claim reads
;;; one answer as a program would, the names in the goal.

(import std.arith :symbols (arith))

(let small (n (n z 9) 9))
(let large (n (n (n z 1) 0) 0))

(cmp (n (n (n (n z 1) 0) 0) 0) (n (n (n z 9) 9) 9))
(cmp (n (n (n z 9) 9) 9) (n (n (n (n z 1) 0) 0) 0))
(cmp (n z 5) (n (n (n z 0) 0) 5))
(cmp (n (n (n z 0) 0) 5) (n z 5))
(cmp (n (n z 0) 7) (n z 5))
(cmp z z)
(cmp z (n z 3))
(cmp small large)

(solve :expect (region (model)))

(query :goal (cmp-of ?x ?y ?o)
       :goal-text "{?x} against {?y}: {?o}"
       :expect (model (cmp-of (n (n (n (n z 1) 0) 0) 0) (n (n (n z 9) 9) 9) gt)
                      (cmp-of (n (n (n z 9) 9) 9) (n (n (n (n z 1) 0) 0) 0) lt)
                      (cmp-of (n z 5) (n (n (n z 0) 0) 5) eq)
                      (cmp-of (n (n (n z 0) 0) 5) (n z 5) eq)
                      (cmp-of (n (n z 0) 7) (n z 5) gt)
                      (cmp-of z z eq)
                      (cmp-of z (n z 3) lt)
                      (cmp-of small large lt)))

(query :goal (cmp-of small large ?o)
       :goal-text "small against large: {?o}"
       :expect (model (cmp-of small large lt)))
