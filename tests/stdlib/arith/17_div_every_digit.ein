;;; `std.arith` — division: a quotient that has every digit, so every trial
;;; of the bisection is made. M1f S1f.6.6.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The quotient's digit is at least 0 and less than 10, and the range is
;;; halved until nothing lies between its bounds. Which multiples are tried
;;; depends on the digit:
;;;
;;;   digit 0 or 1     5, 2, 1            digit 5 or 6     5, 7, 6
;;;   digit 2          5, 2, 3            digit 7          5, 7, 8
;;;   digit 3 or 4     5, 2, 3, 4         digit 8 or 9     5, 7, 8, 9
;;;
;;; Each of the nine multiples has a rule of its own, `div-try-1` to
;;; `div-try-9`, alike but for the digit: 8641975233 divided by 7 is
;;; 1234567890, remainder 3, and its ten digits make all nine trials. The
;;; second request divides by a divisor of three digits, 987654321 by 123,
;;; which is 8029709, remainder 114.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `quot-of`'s whole extent. A trial rule that reads the wrong multiple
;;; gives a wrong digit or a remainder that is not less than the divisor,
;;; and fails the file.

(import std.arith :symbols (arith div n quot-of))

(div (n (n (n (n (n (n (n (n (n (n z 8) 6) 4) 1) 9) 7) 5) 2) 3) 3) (n z 7))
(div (n (n (n (n (n (n (n (n (n z 9) 8) 7) 6) 5) 4) 3) 2) 1) (n (n (n z 1) 2) 3))

(solve :expect (region (model)))

(query :goal (quot-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot-of (n (n (n (n (n (n (n (n (n (n z 8) 6) 4) 1) 9) 7) 5) 2) 3) 3)
                               (n z 7)
                               (n (n (n (n (n (n (n (n (n (n z 1) 2) 3) 4) 5) 6) 7) 8) 9) 0)
                               (n z 3))
                      (quot-of (n (n (n (n (n (n (n (n (n z 9) 8) 7) 6) 5) 4) 3) 2) 1)
                               (n (n (n z 1) 2) 3)
                               (n (n (n (n (n (n (n z 8) 0) 2) 9) 7) 0) 9)
                               (n (n (n z 1) 1) 4))))
