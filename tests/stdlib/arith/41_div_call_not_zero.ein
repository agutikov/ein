;;; `std.arith` — a tagged call whose divisor is not zero: the flag's rule
;;; loaded and silent. M1f S1f.6.24.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The programs `39` and `40` with no zero: a rule of the program's own
;;; calls the division under its own tag, and every divisor is a number that
;;; is not zero, one of them written with a high zero, 04. `div-call-by-zero`
;;; matches nothing, no flag is derived, and each call is answered. A
;;; dividend of zero is no division by zero.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (region (model)))`: R is {∅}, root alive, nothing owed
;;; and nothing guessed. The query names the three shares, so no other
;;; exists.

(import std.arith :symbols (arith))

(relation share Number Number
  :why "asked: {?1} shared among {?2}")
(relation mine Number Number
  :why "this program's division of {?1} by {?2}")
(relation share-of Number Number Number
  :why "{?1} shared among {?2} is {?3} each")
(__closed__ share) (__closed__ mine) (__closed__ share-of)

(rule share-ask ()
  :match  (share ?a ?b)
  :assert (div-call (mine ?a ?b) ?a ?b)
  :why    "to share {?a} among {?b}: divide, and ask for the answer under this program's tag")

(rule share-answer ()
  :match  (div-done (mine ?a ?b) ?q ?r)
  :assert (share-of ?a ?b ?q)
  :why    "{?a} shared among {?b} is {?q} each")

(share (n (n z 1) 2) (n z 4))
(share (n z 7) (n (n z 0) 4))
(share z (n z 3))

(solve :expect (region (model)))

(query :goal (share-of ?a ?b ?q)
       :goal-text "{?a} among {?b} is {?q} each"
       :expect (model (share-of (n (n z 1) 2) (n z 4) (n z 3))
                      (share-of (n z 7) (n (n z 0) 4) (n z 1))
                      (share-of z (n z 3) z)))
