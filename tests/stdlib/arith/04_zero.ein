;;; `std.arith` — zero is `z`: asked, added and answered. M1f S1f.6.3.
;;;
;;; Zero is the number with no digit, `z`, and never `(n z 0)`.
;;;
;;;   0 + 0 = 0     no column at all: `add-end` hands over no digit, and
;;;                 `strip-none` answers `z`
;;;   0 + 5 = 5     `operand-zero` for the first operand; one column,
;;;   5 + 0 = 5     the other number having run out before it began
;;;
;;; The claim is `sum-of`'s whole extent. An answer `(n z 0)` for the first
;;; sum, a zero that is not in normal form, fails the file.

(import std.arith :symbols (arith))

(add z z)
(add z (n z 5))
(add (n z 5) z)

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of z z z)
                      (sum-of z (n z 5) (n z 5))
                      (sum-of (n z 5) z (n z 5))))
