;;; `std.arith` — nothing is computed that was not asked for. M1f S1f.6.3.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The theory is demand-driven: a rule answers a request, and the requests
;;; the circuit makes itself. Nothing enumerates the numbers, and a `let`
;;; alone asks for nothing.
;;;
;;; This program names three numbers and asks for one sum of two of them.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(done TAG ANSWER)` is how a finished call hands its answer over, and the
;;; tag says whose it is. The claim is `done`'s whole extent: **one** call
;;; finished, the sum of `a` and `b`. No sum was computed for `c`, which is
;;; named and never used. The second claim is `sum-of`'s whole extent, one
;;; row.
;;;
;;; Until S1f.6.12 the program also asked for `a + rebate`, a name no `let`
;;; states, which was neither refused nor answered. It is flagged since, and
;;; is `29_undeclared_name.ein`.

(import std.arith :symbols (arith let n b add done sum sum-of))

(let a (n (n z 1) 9))
(let b (n (n z 2) 3))
(let c (n z 7))

(add a b)

(solve :expect (region (model)))

(query :goal (done ?tag ?answer)
       :expect (model (done (sum a b) (n (n z 4) 2))))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of a b (n (n z 4) 2))))
