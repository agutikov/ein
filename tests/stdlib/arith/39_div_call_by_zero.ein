;;; `std.arith` — a division by zero made by a rule of the program's own,
;;; through the tagged call: flagged at the call. M1f S1f.6.24.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A division by zero is flagged wherever it is called (the user's ruling
;;; of 2026-11-12). This program states no `(div X Y)`. Its own rule,
;;; `share-ask`, calls the theory's division under a tag of its own,
;;; `(div-call (mine A B) A B)`, and one of its two shares is among nobody.
;;; `div-call-by-zero` derives the flag, naming the call as it was asserted:
;;;
;;;     (division-by-zero (div-call (mine (n z 7) z) (n z 7) z))
;;;
;;; and `division-by-zero-is-false` derives `(false)` from it. Until S1f.6.24
;;; this call derived nothing: the program was alive, the share among nobody
;;; had no answer, and nothing said so.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty. `ein solve` names
;;; the fact the call came from, `(share (n z 7) z)`, as the unsat core: the
;;; program's fact, not the theory's. `40_div_call_by_zero_spelt.ein` is the
;;; zero written with digits, and `41_div_call_not_zero.ein` the same rules
;;; with no zero, alive and answered.

(import std.arith :symbols (arith div-call div-done n))

(relation share Number Number
  :why "asked: {?1} shared among {?2}")
(relation mine Number Number
  :why "this program's division of {?1} by {?2}")
(relation share-of Number Number Number
  :why "{?1} shared among {?2} is {?3} each")
(__closed__ share) (__closed__ mine) (__closed__ share-of)

(rule share-ask ()
  :match  (share ?a ?b)
  :assert (div-call (mine ?a ?b) ?a ?b)
  :why    "to share {?a} among {?b}: divide, and ask for the answer under this program's tag")

(rule share-answer ()
  :match  (div-done (mine ?a ?b) ?q ?r)
  :assert (share-of ?a ?b ?q)
  :why    "{?a} shared among {?b} is {?q} each")

(share (n (n z 1) 2) (n z 4))
(share (n z 7) z)

(solve :expect (false))
