;;; `std.arith` — division by zero, the zero written with digits and given a
;;; name. M1f S1f.6.6.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A divisor is read by value: `(n (n z 0) 0)`, written 00, is zero, and so
;;; is a name whose `let` states zero. The divisor is first put in normal
;;; form, which is how the theory sees that it is zero; the flag names the
;;; request as written, `(division-by-zero (div (n z 7) none))`.
;;;
;;; `20_div_by_zero.ein` is the divisor `z`; the programs `16` to `19` are
;;; the same two rules loaded and silent, on divisors that are not zero.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead. `ein solve` names three facts
;;; as the reason, where `20` names the request alone: the request, the `let`
;;; that says what `none` is, and `(md 0 1 0 0 0)`, the row of the digit
;;; multiplier's table that the zero written 00 was put into normal form by.
;;; A table row is a premise like any other fact.

(import std.arith :symbols (arith))

(let none (n (n z 0) 0))

(div (n z 7) none)

(solve :expect (false))
