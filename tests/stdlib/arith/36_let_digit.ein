;;; `std.arith` — a digit as a constant's name. M1f S1f.6.12.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A `let` the theory cannot read is flagged as the `let`, `(malformed (let
;;; NAME NUMBER))`, whether or not a request uses the name, and `malformed-
;;; is-false` derives `(false)`. `let-digit`: 7 is a digit, by one probe of
;;; the table `nz`. The program asks nothing of the name, and the `let` is
;;; flagged all the same.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty; the unsat core is
;;; the `let` and the row `(nz 7)`.

(import std.arith :symbols (arith))

(let 7 (n z 5))
(add (n z 2) (n z 2))

(solve :expect (false))
