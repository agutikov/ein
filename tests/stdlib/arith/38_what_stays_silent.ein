;;; `std.arith` — what the theory does not flag: a flag means malformed, and
;;; no flag does not mean well-formed. M1f S1f.6.12.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; Three malformations are answered by silence, as every one was until
;;; S1f.6.12, because saying them needs a negation or a walk of the program's
;;; names (the user's reply of 2026-11-12: no general report of unanswered
;;; requests). A number that ends in a name that is neither a digit nor a
;;; constant, `(n end 1)`. A fact of another relation where a number goes,
;;; `(pair 1 2)`, as an operand or inside a number. And the theory's own
;;; second shape, `(b 1 z)`, as an operand.
;;;
;;; Beside them, three things that look odd and are fine: an operand written
;;; with high zeros, a fact of `n` that no request asks about, and `z` in a
;;; relation of the program's own.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root is alive. `sum-of`'s whole extent is the one sum the
;;; theory could read, and neither flag has a fact. The four other requests
;;; are in root's state, not refused and not answered.

(import std.arith :symbols (arith))

(relation likes Who Whom :why "{?1} likes {?2}")
     (relation pair Thing Thing :why "the pair of {?1} and {?2}")
     (rule the-program-guesses-nothing ()
       :match  ()
       :assert (and (__closed__ likes) (__closed__ pair))
       :why    "the program's own relations are closed, as the theory's are")
     (likes z alice)
     (n alice bob)

     (add (n (n z 0) 2) (n z 2))
     (add (n end 1) (n z 5))
     (add (pair 1 2) (n z 5))
     (add (n (pair 1 2) 3) (n z 5))
     (add (b 1 z) (n z 5))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n (n z 0) 2) (n z 2) (n z 4))))

(query :goal (malformed ?request)
       :goal-text "{?request} holds something that is not a number"
       :expect (model))

(query :goal (undeclared ?name ?request)
       :goal-text "{?request} uses {?name}, which no let states"
       :expect (model))
