;;; `std.math.decimal` — `z` named by the program itself, beside a numeral that ends in it.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `numeral-prefix-named` flags a numeral whose prefix is a named constant,
;;; and its `(neq ?m z)` keeps `z` out: every numeral ends in `z`, and a
;;; program that names `z` is flagged for the naming, not for its numerals.
;;; Through the protocol `(named z)` comes only from a `(let z …)`, which
;;; `let-zero` flags already, so that program is dead with the guard or
;;; without it. A program may also list `named` from `std.math.decimal` and
;;; write `(named z)` itself. Then nothing flags the naming, and the guard is
;;; what keeps `(price apple (n z 3))`, a well-formed numeral, from being
;;; flagged as `(not-decimal (n z 3) z)`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (region (model)))`: R is {∅}, root alive and owing
;;; nothing, so no flag has a fact, and the sum beside the numeral is
;;; answered. Without the guard root is dead and R is empty, which is how
;;; this program fails on a version of the rule that drops it, and why it is
;;; in the suite.

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n named))
(import std.math.arith :symbols (z))

(relation price Item Amount :why "{?1} costs {?2}")
(__closed__ price)
(price apple (n z 3))
(named z)
(add (n z 3) (n z 4))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 3) (n z 4) (n z 7))))
