;;; `std.math.decimal` — what the check does not flag: a flag means malformed, and no flag does not mean well-formed.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; Two numerals a request takes are checked, and neither is flagged nor
;;; labelled. One whose prefix is a name that is neither a digit nor a named
;;; constant, `(n end 1)`, behind the name `far`: saying *a name* costs a walk
;;; of the program's names. One whose prefix is a fact of another relation,
;;; `(n (pair 1 2) 3)`: no rule can say *not of this shape*. The walk of each
;;; stops at what is no numeral, so neither reaches `z` and neither is
;;; labelled valid, and neither request is answered. A numeral no operation
;;; takes is not checked at all (`02` to `04` of this directory).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root is alive, the sum beside them is answered, no flag has a
;;; fact, and `valid`'s extent is the numerals the walk reached `z` from, the
;;; sum, and `z`.

(import std.math.decimal-arith :symbols (decimal-arith let add sum-of))
(import std.math.decimal :symbols (n not-decimal valid))
(import std.math.arith :symbols (z))

(relation pair Thing Thing :why "the pair of {?1} and {?2}")
(__closed__ pair)

(let far (n end 1))
(add far (n z 1))
(add (n (pair 1 2) 3) (n z 1))
(add (n z 4) (n z 3))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 4) (n z 3) (n z 7))))

(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))

(query :goal (valid ?numeral)
       :goal-text "{?numeral} is a decimal number"
       :expect (model (valid z) (valid (n z 1)) (valid (n z 3)) (valid (n z 4)) (valid (n z 7))))
