;;; `std.math.decimal` — a malformed numeral in a fact of the program's own relation.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The numeral is not the calculator's operand at all: `(price apple (n 1
;;; 2))` is a fact of the program's own relation, and `(n 1 2)` ends in a
;;; digit where `z` goes. No operation takes it, so it is not checked
;;; (Q-M1f.404): `numeral-prefix-digit` does not fire, and no flag is
;;; derived. The sum beside it is answered.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (region (model)))`: R is {∅}, root alive and owing
;;; nothing, the sum is answered, and `not-decimal`'s extent is empty.

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n not-decimal))
(import std.math.arith :symbols (z))

(relation price Item Amount :why "{?3} costs {?4}")
(__closed__ price)
(price apple (n 1 2))
(add (n z 4) (n z 3))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 4) (n z 3) (n z 7))))

(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))
