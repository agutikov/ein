;;; `std.math.decimal` — a well-formed numeral, wherever it is written, is flagged nowhere.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A numeral is checked where an operation takes it (Q-M1f.404): the sum's
;;; two operands are walked to `z`, by `numeral-step` and, past the 0 of 107,
;;; `numeral-step-zero`, and `numeral-valid` labels each `(valid N)`. The sum
;;; is labelled as it is made, by `std.math.positional`'s `turn-end`, and `z`
;;; by the closing rule. Here a
;;; numeral is also written in each place no operation takes it from: a
;;; `let` nobody asks about, a fact of the program's own relation, a part of
;;; an integer and of a rational, and a rule's conclusion. Those are neither
;;; checked nor labelled. Each numeral is a decimal number, so no rule of the
;;; check flags one: `(not-decimal …)` has no fact, and the sum is answered.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root is alive, and the program's own relations are closed. The
;;; sum is answered, the flag's extent is empty, and `valid`'s is the two
;;; operands, the sum and `z`, and no numeral nobody takes.

(import std.math.rat :symbols (rat-arith rat))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (decimal-arith add let sum-of))
(import std.math.decimal :symbols (n not-decimal valid))
(import std.math.arith :symbols (z))

(relation price Item Amount :why "{?3} costs {?4}")
(relation seed Thing :why "{?3} is a seed")
(rule the-program-guesses-nothing ()
  :match  ()
  :assert (and (__closed__ price) (__closed__ seed))
  :why    "the program's own relations are closed, as the theory's are")

(seed z)
(add (n (n (n z 1) 0) 7) (n z 5))
(let unused (n (n z 4) 2))
(price apple (n (n z 1) 0))
(price half (rat (int (n z 1) z) (n z 2)))
(rule ask-price ()
  :match  (seed ?s)
  :assert (price pear (n (n z 2) 0))
  :why    "a pear costs 20: a numeral written in a rule's conclusion")

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n (n (n z 1) 0) 7) (n z 5) (n (n (n z 1) 1) 2))))

(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))

(query :goal (valid ?numeral)
       :goal-text "{?numeral} is a decimal number"
       :expect (model (valid z) (valid (n (n (n z 1) 0) 7)) (valid (n z 5)) (valid (n (n (n z 1) 1) 2))))
