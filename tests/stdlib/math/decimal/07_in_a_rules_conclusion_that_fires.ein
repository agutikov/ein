;;; `std.math.decimal` — a malformed numeral a rule assembles and hands to a request.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A numeral an operation takes is checked, whoever wrote the request
;;; (Q-M1f.404): the program's own rule `ask` fires for the seed `z` and
;;; asks for `(add (n ?s 0) (n z 5))`, which builds `(n z 0)`, and the rule
;;; `assemble` writes `(n (n z 1) x)` in a request of its own. The first is a
;;; decimal number, high zero and all, and is labelled valid; the second
;;; holds `x` where a digit goes, and `numeral-digit` flags it as the
;;; request's operand is looked up, and `not-decimal-is-false` derives
;;; `(false)`. `04_in_a_rules_conclusion.ein` is the twin whose rule never
;;; fires.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.decimal-arith :symbols (decimal-arith add))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation seed Thing :why "{?3} is a seed")
(__closed__ seed)
(seed z)
(rule ask ()
  :match  (seed ?s)
  :assert (add (n ?s 0) (n z 5))
  :why    "{?s} asks for 0 + 5, the 0 written with a high zero")
(rule assemble ()
  :match  (seed ?s)
  :assert (add (n (n ?s 1) x) (n z 5))
  :why    "{?s} asks for a sum, one operand assembled with a letter in it")

(solve :expect (false))
