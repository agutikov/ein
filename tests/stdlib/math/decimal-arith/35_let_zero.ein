;;; `std.math.decimal-arith` — `z` as a constant's name.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A `let` the theory cannot read is flagged as the `let`, `(malformed (let
;;; NAME NUMBER))`, whether or not a request uses the name, and `malformed-
;;; is-false` derives `(false)`. `let-zero`: `z` is zero. Unflagged,
;;; `(add z (n z 5))` beside this `let` would have two answers, 5 and 10: `z`
;;; would stand for itself and for 5. The program asks nothing: with `z` a
;;; named constant every number ends in one, so a request beside this `let`
;;; is flagged too, and answered.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty; the unsat core is
;;; the `let`.

(import std.math.decimal-arith :symbols (decimal-arith let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let z (n z 5))

(solve :expect (false))
