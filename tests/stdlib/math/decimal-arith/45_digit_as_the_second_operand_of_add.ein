;;; `std.math.decimal-arith` — a digit as the second operand of `add`.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A digit stands where a number goes: seven is `(n z 7)`. `operand-digit`
;;; says `(bad-operand TAG (not-a-number 7))` under the operand's tag, `bad-
;;; add-second` turns the tag into the request, and `bad-request-malformed`
;;; derives `(malformed (add (n z 5) 7))`, the request as written; `malformed-
;;; is-false` derives `(false)`. The operand's fault, `std.math.decimal-
;;; arith`'s: no numeral is malformed. One program a rule of the ten from a
;;; tag to its request: the malformed numerals of `22` to `32` reach none of
;;; them, a numeral's check being `std.math.decimal`'s (Q-M1f.210).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.decimal-arith :symbols (decimal-arith add))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(add (n z 5) 7)

(solve :expect (false))
