;;; `std.math.decimal-arith` — the five tagged calls a program's own rule
;;; makes, each checking the numerals it is handed.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A number an operation makes from valid numbers is valid as it is made, and
;;; every other numeral is checked, whatever its source (Q-M1f.404): one a
;;; rule of a program's own hands to a tagged call among them. Each call,
;;; `(add-walk TAG X Y 0 z)`, `(sub-walk TAG X Y 0 z)`, `(cmp-walk TAG X Y
;;; eq)`, `(mul-call TAG X Y)` and `(div-call TAG X Y)`, asks the check of a
;;; numeral in either place (`add-walk-check-x`, `add-walk-check-y` and the
;;; rest, `std.math.positional`'s) and is handed on to the calculator's own
;;; walk (`add-walk-runs` and the rest), which answers under the program's
;;; tag. Here 47 and 38 are handed to all five.
;;;
;;; What the calculator hands itself is not checked again: 47 x 38 adds its
;;; rows, 1410 and 376, by its own walk, and the division takes 38's
;;; multiples from what is left; none of those numbers is asked.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}. The answers are the five calls', each under its tag. The asks,
;;; `(check N N)`, are exactly the two numerals the calls were handed: a
;;; number the calculator made and handed itself, asked again, would be a
;;; line more.

(import std.math.decimal-arith :symbols (decimal-arith add-walk sub-walk cmp-walk mul-call div-call
                                         done order-is div-done))
(import std.math.decimal :symbols (n check))
(import std.math.arith :symbols (z))

(relation pair Number Number
  :why "{?3} and {?4}, handed to every call")
(relation mine Operation Number Number
  :why "this program's {?3} of {?4} and {?5}")
(__closed__ pair) (__closed__ mine)

(rule every-call ()
  :match  (pair ?x ?y)
  :assert (and (add-walk (mine plus ?x ?y) ?x ?y 0 z)
               (sub-walk (mine minus ?x ?y) ?x ?y 0 z)
               (cmp-walk (mine against ?x ?y) ?x ?y eq)
               (mul-call (mine times ?x ?y) ?x ?y)
               (div-call (mine over ?x ?y) ?x ?y))
  :why    "{?x} and {?y} are handed to each of the five calls")

(pair (n (n z 4) 7) (n (n z 3) 8))

(solve :expect (region (model)))

(query :goal (done (mine ?what ?x ?y) ?s)
       :goal-text "{?x} {?what} {?y} is {?s}"
       :expect (model (done (mine plus (n (n z 4) 7) (n (n z 3) 8)) (n (n z 8) 5))
                      (done (mine minus (n (n z 4) 7) (n (n z 3) 8)) (n z 9))
                      (done (mine times (n (n z 4) 7) (n (n z 3) 8)) (n (n (n (n z 1) 7) 8) 6))))
(query :goal (order-is (mine against ?x ?y) ?o)
       :goal-text "{?x} against {?y} is {?o}"
       :expect (model (order-is (mine against (n (n z 4) 7) (n (n z 3) 8)) gt)))
(query :goal (div-done (mine over ?x ?y) ?q ?r)
       :goal-text "{?x} divided by {?y} is {?q}, remainder {?r}"
       :expect (model (div-done (mine over (n (n z 4) 7) (n (n z 3) 8)) (n z 1) (n z 9))))
(query :goal (check ?w ?w)
       :goal-text "{?w} is asked for its check"
       :expect (model (check (n (n z 4) 7) (n (n z 4) 7))
                      (check (n (n z 3) 8) (n (n z 3) 8))))
