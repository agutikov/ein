;;; `std.math.decimal-arith` — division by name, and a request a rule of the program
;;; makes from another answer. M1f S1f.6.6.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A `div` request may name its operands with `(let NAME NUMBER)`. And a
;;; request is a fact like any other, so a rule of the program may derive
;;; one: here `share-out` matches the product of `price` and `qty` and asks
;;; for it to be divided by `people`. The theory answers a derived request as
;;; it answers a written one.
;;;
;;;   price = 125, qty = 12, people = 7
;;;   price x qty             = 1500
;;;   1500 / people           = 214, remainder 2
;;;   qty / people            = 1, remainder 5
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `quot-of`'s whole extent: the derived request is answered under the
;;; number the product gave, `(quot-of 1500 people 214 2)`, and the written
;;; one under its names.

(import std.math.decimal-arith :symbols (decimal-arith let n mul div product-of quot-of))

(let price  (n (n (n z 1) 2) 5))
(let qty    (n (n z 1) 2))
(let people (n z 7))

(mul price qty)
(div qty people)

(rule share-out ()
  :match  (product-of price qty ?total)
  :assert (div ?total people)
  :why    "the total {?total} is shared out among the people")

(solve :expect (region (model)))

(query :goal (quot-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot-of (n (n (n (n z 1) 5) 0) 0) people
                               (n (n (n z 2) 1) 4) (n z 2))
                      (quot-of qty people (n z 1) (n z 5))))
