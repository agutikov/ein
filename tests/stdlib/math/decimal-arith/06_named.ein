;;; `std.math.decimal-arith` — named constants: `(let NAME NUMBER)`, and a request that
;;; names its operands. M1f S1f.6.3.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(let price N)` names a number (`let-named`). A request may name an
;;; operand, and its answer repeats the names as written, so a goal can ask
;;; for `(sum-of price qty ?s)` (`operand-name`). A request may mix a name and
;;; a number. The same sum written with the numbers is another request, with
;;; an answer of its own.
;;;
;;;   price = 250, shipping = 49
;;;   price + shipping        = 299
;;;   price + 1               = 251
;;;   250 + 49                = 299, asked and answered apart
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; The first claim is `sum-of`'s whole extent: three requests, three answers.
;;; The request by name is **not** answered a second time under the numbers
;;; its names stand for, and the request by number not under the names.
;;;
;;; The second claim reads one answer the way a program would, with the names
;;; in the goal and a variable in the result's place.

(import std.math.decimal-arith :symbols (decimal-arith let add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let price    (n (n (n z 2) 5) 0))
(let shipping (n (n z 4) 9))

(add price shipping)
(add price (n z 1))
(add (n (n (n z 2) 5) 0) (n (n z 4) 9))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of price shipping (n (n (n z 2) 9) 9))
                      (sum-of price (n z 1) (n (n (n z 2) 5) 1))
                      (sum-of (n (n (n z 2) 5) 0) (n (n z 4) 9) (n (n (n z 2) 9) 9))))

(query :goal (sum-of price shipping ?total)
       :goal-text "the total is {?total}"
       :expect (model (sum-of price shipping (n (n (n z 2) 9) 9))))
