;;; `std.math.decimal-arith` — division: a dividend smaller than the divisor, equal
;;; numbers, a divisor of one, zero divided, high zeros, and zeros inside the
;;; quotient. M1f S1f.6.6.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The quotient and the remainder are in normal form, and the operands are
;;; read by value.
;;;
;;;   3 / 7            = 0, remainder 3       the dividend is the smaller
;;;   42 / 42          = 1, remainder 0
;;;   4567 / 1         = 4567, remainder 0
;;;   0 / 5            = 0, remainder 0       no digit to bring down
;;;   0100 / 05        = 20, remainder 0      high zeros on both sides: the
;;;                                           divisor is first put in normal
;;;                                           form, and a 0 brought down
;;;                                           beside nothing is a digit 0
;;;                                           (`div-bring-zero`)
;;;   1000000 / 999    = 1001, remainder 1    zeros inside the quotient
;;;   1000 / 8         = 125, remainder 0
;;;   99 / 100         = 0, remainder 99
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `quot-of`'s whole extent, the operands as written. A quotient written
;;; `(n (n (n z 0) 2) 0)`, a remainder `(n z 0)`, or a second answer fails
;;; the file.

(import std.math.decimal-arith :symbols (decimal-arith div quot-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(div (n z 3) (n z 7))
(div (n (n z 4) 2) (n (n z 4) 2))
(div (n (n (n (n z 4) 5) 6) 7) (n z 1))
(div z (n z 5))
(div (n (n (n (n z 0) 1) 0) 0) (n (n z 0) 5))
(div (n (n (n (n (n (n (n z 1) 0) 0) 0) 0) 0) 0) (n (n (n z 9) 9) 9))
(div (n (n (n (n z 1) 0) 0) 0) (n z 8))
(div (n (n z 9) 9) (n (n (n z 1) 0) 0))

(solve :expect (region (model)))

(query :goal (quot-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot-of (n z 3) (n z 7) z (n z 3))
                      (quot-of (n (n z 4) 2) (n (n z 4) 2) (n z 1) z)
                      (quot-of (n (n (n (n z 4) 5) 6) 7) (n z 1) (n (n (n (n z 4) 5) 6) 7) z)
                      (quot-of z (n z 5) z z)
                      (quot-of (n (n (n (n z 0) 1) 0) 0) (n (n z 0) 5) (n (n z 2) 0) z)
                      (quot-of (n (n (n (n (n (n (n z 1) 0) 0) 0) 0) 0) 0)
                               (n (n (n z 9) 9) 9)
                               (n (n (n (n z 1) 0) 0) 1) (n z 1))
                      (quot-of (n (n (n (n z 1) 0) 0) 0) (n z 8) (n (n (n z 1) 2) 5) z)
                      (quot-of (n (n z 9) 9) (n (n (n z 1) 0) 0) z (n (n z 9) 9))))
