;;; `std.math.decimal-arith` — the digit 0 where a number goes. M1f S1f.6.12.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A request the theory cannot read is flagged, `(malformed REQUEST)`, the
;;; request as written, and `malformed-is-false` derives `(false)` from the
;;; flag, as for a division by zero (the user's rulings of 2026-11-11 and
;;; 2026-11-12). The rule that finds an operand's fault says `(bad-operand
;;; TAG FAULT)` (until S1f.6.38 a found operand was also checked a place a
;;; firing, `check-step`, for a malformed numeral, which is
;;; `std.math.decimal`'s since, where it is written); the operand's tag is turned into the request by
;;; one of ten rules, here `bad-mul-first`, and `bad-request-malformed`
;;; derives the flag.
;;;
;;; `operand-digit-zero`: the digit 0 is not the number zero, which is `z`.
;;; `nz` holds no row for 0, so it has a rule of its own.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty, the one claim
;;; such a program can make. The sum beside it was computed and is in root's
;;; state, but a dead state is no answer. `ein solve` names the request in
;;; the unsat core, and `--trace` shows the flag and the contradiction as two
;;; steps.

(import std.math.decimal-arith :symbols (decimal-arith add mul))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(add (n z 2) (n z 2))
(mul 0 (n z 5))

(solve :expect (false))
