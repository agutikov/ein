;;; `std.math.decimal-arith` — operands of different lengths, either way round.
;;; M1f S1f.6.3.
;;;
;;; A number that has run out counts as zeros, and the carry goes on through
;;; the columns the longer number still has. Which rule takes those columns
;;; depends on which number is the longer, and a sum is not told which, so
;;; each pair is asked both ways round:
;;;
;;;   7 + 123  = 130     the first runs out: `add-column-second`, with a carry
;;;   123 + 7  = 130     the second runs out: `add-column-first`
;;;   8 + 995  = 1003    the carry runs through every column the longer has,
;;;   995 + 8  = 1003    and out of the top
;;;
;;; The two orders are two requests with two answers: `sum-of` repeats its
;;; operands as asked, and nothing in the theory says that addition commutes.
;;; Exchanging the two operand positions in either of the two column rules
;;; moves a digit of one of these four sums.

(import std.math.decimal-arith :symbols (decimal-arith add n sum-of))

(add (n z 7) (n (n (n z 1) 2) 3))
(add (n (n (n z 1) 2) 3) (n z 7))
(add (n z 8) (n (n (n z 9) 9) 5))
(add (n (n (n z 9) 9) 5) (n z 8))

(solve :expect (region (model)))

(query :goal (sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of (n z 7) (n (n (n z 1) 2) 3) (n (n (n z 1) 3) 0))
                      (sum-of (n (n (n z 1) 2) 3) (n z 7) (n (n (n z 1) 3) 0))
                      (sum-of (n z 8) (n (n (n z 9) 9) 5) (n (n (n (n z 1) 0) 0) 3))
                      (sum-of (n (n (n z 9) 9) 5) (n z 8) (n (n (n (n z 1) 0) 0) 3))))
