;;; `std.math.decimal-arith` — subtraction: a borrow through every column, high zeros in
;;; the answer, equal numbers, and zero on either side. M1f S1f.6.4.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The answer is in normal form whatever the borrow leaves at the top, an
;;; operand is read by value whatever high zeros it is written with, and equal
;;; numbers have the one answer `(diff-of X Y z z)`: both walks end with no
;;; borrow, and both say the same fact.
;;;
;;;   1000 - 1     = 999      the borrow runs through three zeros, and the
;;;                           top digit it leaves, a 0, is dropped
;;;   1000 - 999   = 1        three high zeros dropped
;;;   1 - 1000     short by 999
;;;   42 - 42      = 0, short by 0
;;;   5 - 005      = 0, short by 0: equal by value, the operands repeated as
;;;                           written
;;;   0 - 0        = 0, short by 0
;;;   7 - 0        = 7
;;;   0 - 7        short by 7
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `diff-of`'s whole extent: eight requests, eight answers, each in normal
;;; form. An answer with a high zero, `(n (n (n (n z 0) 9) 9) 9)`, or a second
;;; answer for an equal pair, fails the file.

(import std.math.decimal-arith :symbols (decimal-arith sub n diff-of))

(sub (n (n (n (n z 1) 0) 0) 0) (n z 1))
(sub (n (n (n (n z 1) 0) 0) 0) (n (n (n z 9) 9) 9))
(sub (n z 1) (n (n (n (n z 1) 0) 0) 0))
(sub (n (n z 4) 2) (n (n z 4) 2))
(sub (n z 5) (n (n (n z 0) 0) 5))
(sub z z)
(sub (n z 7) z)
(sub z (n z 7))

(solve :expect (region (model)))

(query :goal (diff-of ?x ?y ?d ?r)
       :goal-text "{?x} - {?y} = {?d}, short by {?r}"
       :expect (model (diff-of (n (n (n (n z 1) 0) 0) 0) (n z 1) (n (n (n z 9) 9) 9) z)
                      (diff-of (n (n (n (n z 1) 0) 0) 0) (n (n (n z 9) 9) 9) (n z 1) z)
                      (diff-of (n z 1) (n (n (n (n z 1) 0) 0) 0) z (n (n (n z 9) 9) 9))
                      (diff-of (n (n z 4) 2) (n (n z 4) 2) z z)
                      (diff-of (n z 5) (n (n (n z 0) 0) 5) z z)
                      (diff-of z z z z)
                      (diff-of (n z 7) z (n z 7) z)
                      (diff-of z (n z 7) z (n z 7))))
