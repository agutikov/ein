;;; `std.math.decimal-arith` — a division by zero at a tagged call, the zero written with
;;; digits. M1f S1f.6.24.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A call's divisor is read by value, as a request's is: `(n (n z 0) 0)`,
;;; written 00, is zero. The divisor is first put in normal form, which is
;;; how the theory sees that it is zero, and the flag names the call as it
;;; was asserted, the divisor as the caller wrote it:
;;;
;;;     (division-by-zero (div-call (mine (n z 7) (n (n z 0) 0))
;;;                                 (n z 7) (n (n z 0) 0)))
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead. `ein solve` names two facts as
;;; the reason: the program's `(share …)` fact, and `(md 0 1 0 0 0)`, the
;;; row of the digit multiplier's table the zero written 00 was put into
;;; normal form by.

(import std.math.decimal-arith :symbols (decimal-arith div-call div-done n))

(relation share Number Number
  :why "asked: {?1} shared among {?2}")
(relation mine Number Number
  :why "this program's division of {?1} by {?2}")
(relation share-of Number Number Number
  :why "{?1} shared among {?2} is {?3} each")
(__closed__ share) (__closed__ mine) (__closed__ share-of)

(rule share-ask ()
  :match  (share ?a ?b)
  :assert (div-call (mine ?a ?b) ?a ?b)
  :why    "to share {?a} among {?b}: divide, and ask for the answer under this program's tag")

(rule share-answer ()
  :match  (div-done (mine ?a ?b) ?q ?r)
  :assert (share-of ?a ?b ?q)
  :why    "{?a} shared among {?b} is {?q} each")

(share (n z 7) (n (n z 0) 0))

(solve :expect (false))
