;;; `std.math.convert` — a round trip: decimal to binary and back is the number. M1f S1f.6.16.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A rule of the program asks, for every `(bin-of X B)`, the conversion of B
;;; back to decimal, `(to-dec B)`: a theory over the calculator's answers, as
;;; a program's own rules are. Each answer back is the number the program
;;; wrote.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: the theory closes its own relations, so nothing is guessed and
;;; the answer is root's fixpoint. Each claim names its result relation, so it
;;; is the relation's whole extent: one answer a request, and a second answer,
;;; a wrong bit or a high zero, fails the file. The second claim is the round
;;; trip: every `dec-of` names, as its decimal, the number `to-bin` was asked
;;; of.

(import std.math.convert :symbols (convert to-bin to-dec bin-of dec-of))
(import std.math.decimal :symbols (n))
(import std.math.binary :symbols (b2))
(import std.math.arith :symbols (z))

(rule back ()
  :match  (bin-of ?x ?b)
  :assert (to-dec ?b)
  :why    "{?x} is {?b} in binary: ask {?b} back")

(to-bin (n z 7))
(to-bin (n (n z 4) 2))
(to-bin (n (n (n (n z 1) 0) 0) 0))

(solve :expect (region (model)))

(query :goal (bin-of ?x ?b)
       :goal-text "{?x} is {?b} in binary"
       :expect (model (bin-of (n z 7) (b2 (b2 (b2 z 1) 1) 1))
                      (bin-of (n (n z 4) 2) (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 1) 0) 1) 0))
                      (bin-of (n (n (n (n z 1) 0) 0) 0) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 0) 1) 0) 0) 0))))

(query :goal (dec-of ?b ?x)
       :goal-text "{?b} in binary is {?x}"
       :expect (model (dec-of (b2 (b2 (b2 z 1) 1) 1) (n z 7))
                      (dec-of (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 1) 0) 1) 0) (n (n z 4) 2))
                      (dec-of (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 0) 1) 0) 0) 0) (n (n (n (n z 1) 0) 0) 0))))
