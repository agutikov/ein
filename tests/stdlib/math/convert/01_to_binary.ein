;;; `std.math.convert` — decimal to binary: 0, 1, 2, 10 and 255. M1f S1f.6.16.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(to-bin X)` is answered by `(bin-of X B)`, B binary's normal form. X is
;;; halved by decimal's tagged division until nothing is left (`to-bin-ask`,
;;; `to-bin-halve`); each remainder is a bit, put in front of the bits so far
;;; (`to-bin-bit-0`, `to-bin-bit-1`); binary's strip and turn make the number
;;; (`to-bin-end`, `to-bin-answer`). Zero is no halving: `(bin-of z z)`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: the theory closes its own relations, so nothing is guessed and
;;; the answer is root's fixpoint. Each claim names its result relation, so it
;;; is the relation's whole extent: one answer a request, and a second answer,
;;; a wrong bit or a high zero, fails the file.

(import std.math.convert :symbols (convert to-bin bin-of))
(import std.math.decimal :symbols (n))
(import std.math.binary :symbols (b2))
(import std.math.arith :symbols (z))

(to-bin z)
(to-bin (n z 1))
(to-bin (n z 2))
(to-bin (n (n z 1) 0))
(to-bin (n (n (n z 2) 5) 5))

(solve :expect (region (model)))

(query :goal (bin-of ?x ?b)
       :goal-text "{?x} is {?b} in binary"
       :expect (model (bin-of z z)
                      (bin-of (n z 1) (b2 z 1))
                      (bin-of (n z 2) (b2 (b2 z 1) 0))
                      (bin-of (n (n z 1) 0) (b2 (b2 (b2 (b2 z 1) 0) 1) 0))
                      (bin-of (n (n (n z 2) 5) 5) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 1) 1) 1))))
