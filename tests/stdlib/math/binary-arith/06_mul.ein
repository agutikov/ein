;;; `std.math.binary-arith` — products: a row is nothing or the multiplicand. M1f S1f.6.16.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(bin-mul X Y)` is answered by `(bin-product-of X Y P)`. The multiplier is
;;; turned round (`top-first-step`, `top-first-end`, `mul-turn`, `mul-begin`),
;;; and each of its bits from the top doubles the sum so far, one constructor:
;;; a bit of 1 adds the multiplicand by one addition walk (`bin-mul-one`, and
;;; `bin-mul-one-first` where nothing is summed yet), and a bit of 0 adds
;;; nothing (`bin-mul-zero`, `bin-mul-zero-first`). No digit multiplier:
;;; binary's own four rules are what decimal's table and walk are. `mul-next`
;;; and `mul-end` hand the product over.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: the theory closes its own relations, so nothing is guessed and
;;; the answer is root's fixpoint. Each claim names its result relation, so it
;;; is the relation's whole extent: one answer a request, and a second answer,
;;; a wrong bit or a high zero, fails the file.

(import std.math.binary-arith :symbols (binary-arith bin-mul bin-product-of))
(import std.math.binary :symbols (b2))
(import std.math.arith :symbols (z))

(bin-mul (b2 (b2 (b2 z 1) 0) 1) (b2 (b2 (b2 z 1) 1) 1))
(bin-mul (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 0) 1) 1) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 0) 0) 1) 0) 0) 0))
(bin-mul (b2 (b2 (b2 z 1) 1) 0) z)
(bin-mul z (b2 (b2 (b2 z 1) 1) 0))
(bin-mul (b2 z 1) (b2 z 1))
(bin-mul (b2 (b2 (b2 z 1) 0) 0) (b2 (b2 (b2 (b2 z 1) 0) 0) 0))

(solve :expect (region (model)))

(query :goal (bin-product-of ?x ?y ?p)
       :goal-text "{?x} x {?y} = {?p}"
       :expect (model (bin-product-of (b2 (b2 (b2 z 1) 0) 1) (b2 (b2 (b2 z 1) 1) 1) (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 0) 0) 1) 1))
                      (bin-product-of (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 0) 1) 1) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 0) 0) 1) 0) 0) 0) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 0) 1) 1) 0) 1) 1) 0) 0) 0) 1) 1) 0) 0) 0))
                      (bin-product-of (b2 (b2 (b2 z 1) 1) 0) z z)
                      (bin-product-of z (b2 (b2 (b2 z 1) 1) 0) z)
                      (bin-product-of (b2 z 1) (b2 z 1) (b2 z 1))
                      (bin-product-of (b2 (b2 (b2 z 1) 0) 0) (b2 (b2 (b2 (b2 z 1) 0) 0) 0) (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 0) 0) 0) 0))))
