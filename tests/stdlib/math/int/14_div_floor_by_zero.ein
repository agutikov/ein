;;; `std.math.int` — a division by zero, floored: the divisor a name, its zero
;;; written with digits. M1f S1f.6.22.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A division whose divisor is zero has no answer, under any convention. Both
;;; operands are simplified, the divisor's normal form is `(int z z)`, and
;;; `int-div-by-zero` derives the flag `(division-by-zero (int-div-floor X
;;; Y))`, the request as written; `std.math.decimal-arith`'s `division-by-zero-is-false`
;;; derives `(false)` from the flag. The divisor is a name, looked up through
;;; `std.math.decimal-arith`'s `let`, and the integer it names is zero written with digits;
;;; the flag repeats the name.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make. The sum beside
;;; the request is computed in root's state all the same, and no query of the
;;; program has an answer. Here: 7 by a name for 0 less 00.

(import std.math.int :symbols (int-arith int int-add int-div-floor))
(import std.math.decimal-arith :symbols (let n))

(let nothing (int (n z 0) (n (n z 0) 0)))
(int-add (int (n z 2) z) (int z (n z 5)))
(int-div-floor (int (n z 7) z) nothing)

(solve :expect (false))
