;;; `std.math.int` — division, Euclidean, every combination of signs with a
;;; remainder and without. M1f S1f.6.22.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(int-div-euclid X Y)` is answered by `(int-quot-euclid-of X Y Q R)` with
;;; X = Q x Y + R and 0 <= R < |Y|: Q an integer in normal form, and R a
;;; **natural number** of `std.math.decimal-arith`, never an integer, since it is never
;;; negative.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; Both operands are simplified and the sizes divided by `std.math.decimal-arith`
;;; (`int-div-euclid-ask`, then the shared `int-div-start`, `int-div-divisor`
;;; and one of `int-div-pp`, `-pn`, `-np`, `-nn`). Where the dividend is not
;;; negative the sizes' quotient q and remainder r are the answer, the
;;; quotient negated for a negative divisor (`int-div-euclid-pp`, `-pn`).
;;; Where it is negative and nothing is left, the quotient takes the sign and
;;; the remainder is `z` (`-np-exact`, `-nn-exact`). Where it is negative and
;;; a remainder is left, the quotient's size is q + 1 and the remainder is
;;; |Y| - r (`-np-more`, `-nn-more`, the shared `int-div-rest`, and `-neg` or
;;; `-pos`).
;;;
;;; X / Y = Q, R:
;;;
;;;   7 / 2 = 3, 1                      -7 / 2 = -4, 1
;;;   7 / -2 = -3, 1                    -7 / -2 = 4, 1
;;;   6 / 3 = 2, 0                      -6 / 3 = -2, 0
;;;   6 / -3 = -2, 0                    -6 / -3 = 2, 0
;;;   0 / 5 = 0, 0                      0 / -5 = 0, 0
;;;   1 / 4 = 0, 1                      -1 / 4 = -1, 3
;;;   1 / -4 = 0, 1                     -1 / -4 = 1, 3
;;;   127645 / -25 = -5105, 20          -127645 / 25 = -5106, 5
;;;   (5 less 12) / (3 less 1) = -7 / 2 = -4, 1
;;;   (2 less 8) / (1 less 4) = -6 / -3 = 2, 0
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `int-quot-euclid-of`'s whole extent, 18 requests: the four combinations
;;; of signs with a remainder left and with none, a dividend of zero, a
;;; dividend smaller than the divisor, six digits by two, and two requests
;;; whose operands are written with both parts and read by value.

(import std.math.int :symbols (int-arith int-div-euclid int int-quot-euclid-of))
(import std.math.decimal-arith)
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-div-euclid (int (n z 7) z) (int (n z 2) z))
(int-div-euclid (int z (n z 7)) (int (n z 2) z))
(int-div-euclid (int (n z 7) z) (int z (n z 2)))
(int-div-euclid (int z (n z 7)) (int z (n z 2)))
(int-div-euclid (int (n z 6) z) (int (n z 3) z))
(int-div-euclid (int z (n z 6)) (int (n z 3) z))
(int-div-euclid (int (n z 6) z) (int z (n z 3)))
(int-div-euclid (int z (n z 6)) (int z (n z 3)))
(int-div-euclid (int z z) (int (n z 5) z))
(int-div-euclid (int z z) (int z (n z 5)))
(int-div-euclid (int (n z 1) z) (int (n z 4) z))
(int-div-euclid (int z (n z 1)) (int (n z 4) z))
(int-div-euclid (int (n z 1) z) (int z (n z 4)))
(int-div-euclid (int z (n z 1)) (int z (n z 4)))
(int-div-euclid (int (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) z) (int z (n (n z 2) 5)))
(int-div-euclid (int z (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5)) (int (n (n z 2) 5) z))
(int-div-euclid (int (n z 5) (n (n z 1) 2)) (int (n z 3) (n z 1)))
(int-div-euclid (int (n z 2) (n z 8)) (int (n z 1) (n z 4)))

(solve :expect (region (model)))

(query :goal (int-quot-euclid-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (int-quot-euclid-of (int (n z 7) z) (int (n z 2) z) (int (n z 3) z) (n z 1))
                      (int-quot-euclid-of (int z (n z 7)) (int (n z 2) z) (int z (n z 4)) (n z 1))
                      (int-quot-euclid-of (int (n z 7) z) (int z (n z 2)) (int z (n z 3)) (n z 1))
                      (int-quot-euclid-of (int z (n z 7)) (int z (n z 2)) (int (n z 4) z) (n z 1))
                      (int-quot-euclid-of (int (n z 6) z) (int (n z 3) z) (int (n z 2) z) z)
                      (int-quot-euclid-of (int z (n z 6)) (int (n z 3) z) (int z (n z 2)) z)
                      (int-quot-euclid-of (int (n z 6) z) (int z (n z 3)) (int z (n z 2)) z)
                      (int-quot-euclid-of (int z (n z 6)) (int z (n z 3)) (int (n z 2) z) z)
                      (int-quot-euclid-of (int z z) (int (n z 5) z) (int z z) z)
                      (int-quot-euclid-of (int z z) (int z (n z 5)) (int z z) z)
                      (int-quot-euclid-of (int (n z 1) z) (int (n z 4) z) (int z z) (n z 1))
                      (int-quot-euclid-of (int z (n z 1)) (int (n z 4) z) (int z (n z 1)) (n z 3))
                      (int-quot-euclid-of (int (n z 1) z) (int z (n z 4)) (int z z) (n z 1))
                      (int-quot-euclid-of (int z (n z 1)) (int z (n z 4)) (int (n z 1) z) (n z 3))
                      (int-quot-euclid-of (int (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) z) (int z (n (n z 2) 5)) (int z (n (n (n (n z 5) 1) 0) 5)) (n (n z 2) 0))
                      (int-quot-euclid-of (int z (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5)) (int (n (n z 2) 5) z) (int z (n (n (n (n z 5) 1) 0) 6)) (n z 5))
                      (int-quot-euclid-of (int (n z 5) (n (n z 1) 2)) (int (n z 3) (n z 1)) (int z (n z 4)) (n z 1))
                      (int-quot-euclid-of (int (n z 2) (n z 8)) (int (n z 1) (n z 4)) (int (n z 2) z) z)))
