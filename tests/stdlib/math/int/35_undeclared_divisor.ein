;;; `std.math.int` — a division's operand that is a name no `let` states. M1f S1f.6.38.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A division's operand is looked up under `(int-first (int-div-of REQUEST)
;;; Y)`, the tag the three conventions share: `int-bad-first` takes it to
;;; `(bad-request (int-div-of REQUEST) …)`, and `int-bad-div` to the request
;;; as written, so the request holds two flags, its tag's and its own.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-div-trunc))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-div-trunc foo (int (n z 2) z))

(solve :expect (false))
