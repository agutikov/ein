;;; `std.math.int` — a letter in a part of an integer.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A malformed numeral is `std.math.decimal`'s, flagged where an operation
;;; takes it: here inside an integer, a request's operand. `int-operand-check`
;;; asks the integer's check, `int-check-parts` asks `std.math.decimal`'s of
;;; each part, and `numeral-digit` flags `(n z x)`, which holds `x` where a
;;; digit goes: an integer's parts are numerals like any other (Q-M1f.210,
;;; Q-M1f.404).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (int (n z x) z) (int (n z 1) z))

(solve :expect (false))
