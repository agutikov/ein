;;; `std.math.int` — an operand that is a name no `let` states. M1f S1f.6.38.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; An operand is looked up through `std.math.decimal-arith`'s `operand`,
;;; whose `operand-undeclared` says `(bad-operand (int-first REQUEST Y) (no-
;;; let foo))` under this module's tag; `int-bad-first` turns the tag into the
;;; request, `(bad-request (int-add foo Y) (no-let foo))`, and
;;; `std.math.decimal-arith`'s rules derive `(undeclared foo (int-add foo Y))`
;;; and `(false)`. Until S1f.6.38 no rule turned the tag into a request, and
;;; the fault was silent (E-38).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add foo (int (n z 1) z))

(solve :expect (false))
