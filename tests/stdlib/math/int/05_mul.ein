;;; `std.math.int` — multiplication, every combination of signs. M1f S1f.6.7.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(int-mul X Y)` is answered by `(int-product-of X Y S)`, S in normal form.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; (P1 less N1) times (P2 less N2) is P1 x P2 + N1 x N2, less P1 x N2 + N1 x
;;; P2. The operands (`int-mul-ask`, `int-mul-start`); the two products that
;;; make the positive part and their sum (`int-mul-first`, `int-mul-second`,
;;; `int-mul-plus`); the two across and their sum (`int-mul-third`,
;;; `int-mul-fourth`, `int-mul-minus`); and the pair simplified
;;; (`int-mul-norm`). Each product is `std.math.decimal-arith`'s, and where a part is zero
;;; its product is zero in a few firings. No rule looks at a sign.
;;;
;;;    12 x  34 = 408      -12 x 35 = -420      13 x -34 = -442
;;;   -13 x -35 = 455        0 x -7 = 0         -7 x 0 = 0
;;;     1 x  -9 = -9        -1 x -1 = 1
;;;   (5 less 3) x (1 less 4) = 2 x -3 = -6     123 x -456 = -56088
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `int-product-of`'s whole extent, ten requests, no pair both ways round. A
;;; product whose sign is negative and whose size is zero is `(int z z)`, as
;;; every zero is.

(import std.math.int :symbols (int-arith int-mul int int-product-of))
(import std.math.decimal-arith :symbols (n))

(int-mul (int (n (n z 1) 2) z) (int (n (n z 3) 4) z))
(int-mul (int z (n (n z 1) 2)) (int (n (n z 3) 5) z))
(int-mul (int (n (n z 1) 3) z) (int z (n (n z 3) 4)))
(int-mul (int z (n (n z 1) 3)) (int z (n (n z 3) 5)))
(int-mul (int z z) (int z (n z 7)))
(int-mul (int z (n z 7)) (int z z))
(int-mul (int (n z 1) z) (int z (n z 9)))
(int-mul (int z (n z 1)) (int z (n z 1)))
(int-mul (int (n z 5) (n z 3)) (int (n z 1) (n z 4)))
(int-mul (int (n (n (n z 1) 2) 3) z) (int z (n (n (n z 4) 5) 6)))

(solve :expect (region (model)))

(query :goal (int-product-of ?x ?y ?s)
       :goal-text "{?x} x {?y} = {?s}"
       :expect (model (int-product-of (int (n (n z 1) 2) z) (int (n (n z 3) 4) z) (int (n (n (n z 4) 0) 8) z))
                      (int-product-of (int z (n (n z 1) 2)) (int (n (n z 3) 5) z) (int z (n (n (n z 4) 2) 0)))
                      (int-product-of (int (n (n z 1) 3) z) (int z (n (n z 3) 4)) (int z (n (n (n z 4) 4) 2)))
                      (int-product-of (int z (n (n z 1) 3)) (int z (n (n z 3) 5)) (int (n (n (n z 4) 5) 5) z))
                      (int-product-of (int z z) (int z (n z 7)) (int z z))
                      (int-product-of (int z (n z 7)) (int z z) (int z z))
                      (int-product-of (int (n z 1) z) (int z (n z 9)) (int z (n z 9)))
                      (int-product-of (int z (n z 1)) (int z (n z 1)) (int (n z 1) z))
                      (int-product-of (int (n z 5) (n z 3)) (int (n z 1) (n z 4)) (int z (n z 6)))
                      (int-product-of (int (n (n (n z 1) 2) 3) z) (int z (n (n (n z 4) 5) 6)) (int z (n (n (n (n (n z 5) 6) 0) 8) 8)))))
