;;; `std.math.int` — `z` as the name a `let` states. M1f S1f.6.38.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `z` is zero, and names no other number: `let-zero` flags the `let`, as
;;; before S1f.6.38. The numerals end in `z`, and `std.math.decimal` flags
;;; none of them for it; `std.math.int`, which reads no guard, flags an
;;; integer with a part `z` beside the `let`, `(not-integer (int (n z 1) z)
;;; z)`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let z (int (n z 1) z))

(solve :expect (false))
