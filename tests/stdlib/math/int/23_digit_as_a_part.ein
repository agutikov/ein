;;; `std.math.int` — a digit where a part of an integer goes.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; Each part of `(int P N)` is a natural number, and `7` is none. The
;;; request's operand is looked up, and `int-operand-check` asks the
;;; integer's check, `(int-check (int 7 z))`: `int-p-digit` reads it and
;;; derives `(not-integer (int 7 z) 7)`, the integer's own fault, and
;;; `not-integer-is-false` derives `(false)` (Q-M1f.276 (a), Q-M1f.404).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(int-add (int 7 z) (int (n z 1) z))

(solve :expect (false))
