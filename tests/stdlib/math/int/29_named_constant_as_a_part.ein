;;; `std.math.int` — a named constant where a part of an integer goes. M1f S1f.6.38.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A name stands for a number as an operand, not inside an integer: `int-p-
;;; named` reads `(written (int price z))` and `(named price)`, and derives
;;; `(not-integer (int price z) price)` (Q-M1f.276 (a)).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.int :symbols (int-arith int int-add))
(import std.math.decimal-arith :symbols (decimal-arith let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(let price (n z 5))
(int-add (int price z) (int (n z 1) z))

(solve :expect (false))
