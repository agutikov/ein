;;; `std.math.num9` — a product that does not fit, three ways. M1f S1f.6.13.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A product overflows where a digit falls off the top, and a step has three
;;; places for that, each with its rule; each derives `(overflow (mul9 X Y))`
;;; and no rule derives a number for the request.
;;;
;;;   123078 x 123078      mul9-overflows-shift   the sum so far has a top
;;;                                               digit and must still shift
;;;   500000000 x 2        mul9-overflows-row     the multiplicand times one
;;;                                               digit carries out of the top
;;;   31623 x 31623        mul9-overflows-add     adding the row carries out
;;;                                               of the top: 1000014129
;;;
;;; Root stays alive: 2 x 3 = 6 beside them is answered.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `overflow`'s whole extent, three flags, each naming its request as
;;; written, and `product9-of`'s, the one product that fits.

(import std.math.num9 :symbols (arith9 mul9 num9 overflow product9-of))

(mul9 (num9 0 0 0 1 2 3 0 7 8) (num9 0 0 0 1 2 3 0 7 8))
(mul9 (num9 5 0 0 0 0 0 0 0 0) (num9 0 0 0 0 0 0 0 0 2))
(mul9 (num9 0 0 0 0 3 1 6 2 3) (num9 0 0 0 0 3 1 6 2 3))
(mul9 (num9 0 0 0 0 0 0 0 0 2) (num9 0 0 0 0 0 0 0 0 3))

(solve :expect (region (model)))

(query :goal (overflow ?request)
       :goal-text "{?request} does not fit nine digits"
       :expect (model (overflow (mul9 (num9 0 0 0 1 2 3 0 7 8) (num9 0 0 0 1 2 3 0 7 8)))
                      (overflow (mul9 (num9 5 0 0 0 0 0 0 0 0) (num9 0 0 0 0 0 0 0 0 2)))
                      (overflow (mul9 (num9 0 0 0 0 3 1 6 2 3) (num9 0 0 0 0 3 1 6 2 3)))))

(query :goal (product9-of ?x ?y ?p)
       :goal-text "{?x} x {?y} = {?p}"
       :expect (model (product9-of (num9 0 0 0 0 0 0 0 0 2) (num9 0 0 0 0 0 0 0 0 3) (num9 0 0 0 0 0 0 0 0 6))))
