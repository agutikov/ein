;;; `std.math.rat` — a second operand with a denominator of zero, the zero written with digits and the operand named. M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The denominator is compared by value, so a zero written `(n (n z 0) 0)`
;;; is zero, and a named operand is looked up before it is compared.
;;; `rat-zero-second` derives `(division-by-zero (rat-mul X Y))`, the request
;;; as written, the name and all.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make. The sum beside
;;; the request is computed in root's state all the same, and no query of the
;;; program has an answer.

(import std.math.rat :symbols (rat-arith rat rat-add rat-mul))
(import std.math.decimal-arith :symbols (let n))
(import std.math.int :symbols (int))

(let nothing (rat (int (n z 1) z) (n (n z 0) 0)))
(rat-add (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-mul (rat (int (n z 3) z) (n z 4)) nothing)

(solve :expect (false))
