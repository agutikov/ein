;;; `std.math.rat` — comparison, by value: the cross products of the difference,
;;; and no division. M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(rat-cmp X Y)` is answered by `(rat-cmp-of X Y O)`: O is `lt`, `eq` or
;;; `gt`, the order of the two values, so 2/4 and 1/2 compare `eq`.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; The operands (`rat-cmp-ask`, `rat-cmp-start`). The numerator of X - Y is
;;; computed and no more, the seven rules of the cross products: its positive
;;; part is compared with its negative part by `std.math.decimal-arith`'s walk
;;; (`rat-cmp-sides`). The denominators are positive, so that order is the
;;; order of X and Y (`rat-cmp-answer`). It builds no rational, finds no
;;; common divisor and divides nothing.
;;;
;;;   1/2 against 1/3:   1 x 3 = 3 against 1 x 2 = 2:  gt
;;;
;;;    1/2 against 1/3   gt     1/4 against 2/7    lt    -1/2 against 1/3   lt
;;;    2/5 against -7/3  gt    -1/2 against -1/3   lt    -3/4 against -2/3  lt
;;;    2/4 against 1/2   eq    -3/9 against (0 less 2)/6   eq
;;;    0/3 against 0/8   eq    22/7 against 355/113   gt
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `rat-cmp-of`'s whole extent, ten requests, no pair both ways round.

(import std.math.rat :symbols (rat-arith rat-cmp rat rat-cmp-of))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (n))

(rat-cmp (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-cmp (rat (int (n z 1) z) (n z 4)) (rat (int (n z 2) z) (n z 7)))
(rat-cmp (rat (int z (n z 1)) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-cmp (rat (int (n z 2) z) (n z 5)) (rat (int z (n z 7)) (n z 3)))
(rat-cmp (rat (int z (n z 1)) (n z 2)) (rat (int z (n z 1)) (n z 3)))
(rat-cmp (rat (int z (n z 3)) (n z 4)) (rat (int z (n z 2)) (n z 3)))
(rat-cmp (rat (int (n z 2) z) (n z 4)) (rat (int (n z 1) z) (n z 2)))
(rat-cmp (rat (int z (n z 3)) (n z 9)) (rat (int z (n z 2)) (n z 6)))
(rat-cmp (rat (int z z) (n z 3)) (rat (int z z) (n z 8)))
(rat-cmp (rat (int (n (n z 2) 2) z) (n z 7)) (rat (int (n (n (n z 3) 5) 5) z) (n (n (n z 1) 1) 3)))

(solve :expect (region (model)))

(query :goal (rat-cmp-of ?x ?y ?o)
       :goal-text "{?x} against {?y}: {?o}"
       :expect (model (rat-cmp-of (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)) gt)
                      (rat-cmp-of (rat (int (n z 1) z) (n z 4)) (rat (int (n z 2) z) (n z 7)) lt)
                      (rat-cmp-of (rat (int z (n z 1)) (n z 2)) (rat (int (n z 1) z) (n z 3)) lt)
                      (rat-cmp-of (rat (int (n z 2) z) (n z 5)) (rat (int z (n z 7)) (n z 3)) gt)
                      (rat-cmp-of (rat (int z (n z 1)) (n z 2)) (rat (int z (n z 1)) (n z 3)) lt)
                      (rat-cmp-of (rat (int z (n z 3)) (n z 4)) (rat (int z (n z 2)) (n z 3)) lt)
                      (rat-cmp-of (rat (int (n z 2) z) (n z 4)) (rat (int (n z 1) z) (n z 2)) eq)
                      (rat-cmp-of (rat (int z (n z 3)) (n z 9)) (rat (int z (n z 2)) (n z 6)) eq)
                      (rat-cmp-of (rat (int z z) (n z 3)) (rat (int z z) (n z 8)) eq)
                      (rat-cmp-of (rat (int (n (n z 2) 2) z) (n z 7)) (rat (int (n (n (n z 3) 5) 5) z) (n (n (n z 1) 1) 3)) gt)))
