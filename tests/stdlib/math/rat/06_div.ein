;;; `std.math.rat` — division: exact, one rational, and no remainder.
;;; M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(rat-div X Y)` is answered by `(rat-quot-of X Y S)`, S in lowest terms,
;;; where Y is not zero. Where `std.math.decimal-arith`'s division answers a quotient and
;;; a remainder, a quotient of rationals is one rational.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; To divide by a rational is to multiply by it turned over (`rat-div-ask`,
;;; `rat-div-start`). The divisor's numerator is simplified first, since its
;;; size becomes a denominator: a positive divisor P over E turns into E over
;;; P (`rat-div-pos`), a negative one, of size N, into E negated over N
;;; (`rat-div-neg`). Then multiplication's rules, and `rat-div-answer`.
;;;
;;;    1/2 /  3/4 = 2/3       1/2 / -3/4 = -2/3     -5/6 / 2/3 = -5/4
;;;   -3/8 / -9/4 = 1/6       0/5 / -2/3 = 0/1
;;;    7/9 / ((5 less 2)/6) = 7/9 / 1/2 = 14/9
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `rat-quot-of`'s whole extent, six requests. The divisor that is zero is
;;; `10_div_by_zero_rational.ein`'s.

(import std.math.rat :symbols (rat-arith rat-div rat rat-quot-of))
(import std.math.int :symbols (int))
(import std.math.decimal-arith)
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(rat-div (rat (int (n z 1) z) (n z 2)) (rat (int (n z 3) z) (n z 4)))
(rat-div (rat (int (n z 1) z) (n z 2)) (rat (int z (n z 3)) (n z 4)))
(rat-div (rat (int z (n z 5)) (n z 6)) (rat (int (n z 2) z) (n z 3)))
(rat-div (rat (int z (n z 3)) (n z 8)) (rat (int z (n z 9)) (n z 4)))
(rat-div (rat (int z z) (n z 5)) (rat (int z (n z 2)) (n z 3)))
(rat-div (rat (int (n z 7) z) (n z 9)) (rat (int (n z 5) (n z 2)) (n z 6)))

(solve :expect (region (model)))

(query :goal (rat-quot-of ?x ?y ?s)
       :goal-text "{?x} divided by {?y} = {?s}"
       :expect (model (rat-quot-of (rat (int (n z 1) z) (n z 2)) (rat (int (n z 3) z) (n z 4)) (rat (int (n z 2) z) (n z 3)))
                      (rat-quot-of (rat (int (n z 1) z) (n z 2)) (rat (int z (n z 3)) (n z 4)) (rat (int z (n z 2)) (n z 3)))
                      (rat-quot-of (rat (int z (n z 5)) (n z 6)) (rat (int (n z 2) z) (n z 3)) (rat (int z (n z 5)) (n z 4)))
                      (rat-quot-of (rat (int z (n z 3)) (n z 8)) (rat (int z (n z 9)) (n z 4)) (rat (int (n z 1) z) (n z 6)))
                      (rat-quot-of (rat (int z z) (n z 5)) (rat (int z (n z 2)) (n z 3)) (rat (int z z) (n z 1)))
                      (rat-quot-of (rat (int (n z 7) z) (n z 9)) (rat (int (n z 5) (n z 2)) (n z 6)) (rat (int (n (n z 1) 4) z) (n z 9)))))
