;;; `std.math.rat` — operands by name, and a rule of the program that asks for more.
;;; M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(let NAME (rat (int P N) D))` names a rational: `let` is `std.math.decimal-arith`'s,
;;; and a request of this module may name its operands. The answer repeats the
;;; names. An answer is a fact like any other, so a rule of the program may
;;; match it and state the next request.
;;;
;;;   half = 1/2, third = 1/3, share = 3/4
;;;   half + third          = 5/6
;;;   share of that         = 5/6 x 3/4 = 5/8      (the program's rule asks)
;;;   5/8 against half      : gt                    (and asks again)
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; The sum by name; the product the program's rule `take-a-share` asked for,
;;; whose first operand is a rational the theory computed; and the comparison
;;; its rule `more-than-half` asked for.

(import std.math.rat :symbols (rat-arith rat rat-add rat-sum-of rat-mul rat-product-of rat-cmp
                          rat-cmp-of))
(import std.math.decimal-arith :symbols (let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))
(import std.math.int :symbols (int))

(let half  (rat (int (n z 1) z) (n z 2)))
(let third (rat (int (n z 1) z) (n z 3)))
(let share (rat (int (n z 3) z) (n z 4)))

(rat-add half third)

(rule take-a-share ()
  :match  (rat-sum-of half third ?total)
  :assert (rat-mul ?total share)
  :why    "the total is {?total}: a share of it")

(rule more-than-half ()
  :match  (rat-product-of ?total share ?part)
  :assert (rat-cmp ?part half)
  :why    "the share is {?part}: is it more than a half?")

(solve :expect (region (model)))

(query :goal (rat-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (rat-sum-of half third (rat (int (n z 5) z) (n z 6)))))

(query :goal (rat-product-of ?x ?y ?s)
       :goal-text "{?x} x {?y} = {?s}"
       :expect (model (rat-product-of (rat (int (n z 5) z) (n z 6)) share (rat (int (n z 5) z) (n z 8)))))

(query :goal (rat-cmp-of ?x ?y ?o)
       :goal-text "{?x} against {?y}: {?o}"
       :expect (model (rat-cmp-of (rat (int (n z 5) z) (n z 8)) half gt)))
