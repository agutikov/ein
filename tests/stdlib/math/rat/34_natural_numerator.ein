;;; `std.math.rat` — a rational whose numerator is a natural number: the
;;; numeral verified, the request silent.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A rational is built from integers; one built from something else verifies
;;; it as an operation verifies its operands (Q-M1f.404). A numerator that is
;;; a natural number, `(rat (n z 3) (n z 2))`, is asked `std.math.decimal`'s
;;; check (`rat-check-z-natural`), and labelled valid. The operation computes
;;; nothing with a numerator that is no integer (Q-M1f.277): the request is
;;; neither answered nor flagged, and its second operand is never looked up.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: no sum for it, no flag, and the numerals asked are its first
;;; operand's two and the well-formed request's beside it, which is answered,
;;; 1/2 + 1/2 = 4/4. `35_natural_numerator_malformed.ein` is the numerator
;;; malformed.

(import std.math.rat :symbols (rat-arith rat rat-add rat-sum-of))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n check valid not-decimal))
(import std.math.arith :symbols (z))

(rat-add (rat (n z 3) (n z 2)) (rat (int (n z 1) z) (n z 2)))
(rat-add (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 2)))

(solve :expect (region (model)))

(query :goal (rat-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (rat-sum-of (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 2))
                                  (rat (int (n z 4) z) (n z 4)))))
(query :goal (check ?w ?w)
       :goal-text "{?w} is asked for its check"
       :expect (model (check (n z 3) (n z 3)) (check (n z 2) (n z 2)) (check (n z 1) (n z 1))))
(query :goal (valid (n z 3))
       :goal-text "the numerator is a decimal number"
       :expect (model (valid (n z 3))))
(query :goal (not-decimal ?numeral ?thing)
       :goal-text "{?numeral} is not a decimal number"
       :expect (model))
