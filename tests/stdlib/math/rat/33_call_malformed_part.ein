;;; `std.math.rat` — a malformed numeral handed to a tagged call as a
;;; denominator: checked, flagged, dead.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A part a call is handed is checked as an operand's is (Q-M1f.404):
;;; `rat-norm-runs` asks `(rat-check (rat (int P N) D))`, the rational's check
;;; asks `std.math.decimal`'s of its denominator (`rat-check-d`), and
;;; `numeral-digit` flags `(n z x)`, `x` where a digit goes;
;;; `not-decimal-is-false` derives `(false)`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty.

(import std.math.rat :symbols (rat-arith rat-norm))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation mine Thing
  :why "{?3}, a rational of this program's own")
(__closed__ mine)

(rat-norm (mine a) (n z 1) z (n z x))

(solve :expect (false))
