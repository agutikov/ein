;;; `std.math.rat` — a letter in a rational's numerator. M1f S1f.6.38.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A malformed numeral is `std.math.decimal`'s, wherever it is written: here
;;; in the integer that is a rational's numerator. `numeral-digit` flags `(n z
;;; x)` as it is written (E-38).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make.

(import std.math.rat :symbols (rat-arith rat rat-add))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (decimal-arith))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(rat-add (rat (int (n z x) z) (n z 2)) (rat (int (n z 1) z) (n z 2)))

(solve :expect (false))
