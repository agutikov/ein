;;; `std.math.binary` — a malformed numeral: ends in a bit. M1f S1f.6.16.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A malformed numeral is `std.math.binary`'s, flagged as it is written,
;;; wherever it sits, with no request reading it, on `std.math.decimal`'s
;;; pattern (S1f.6.38). The flag is `(not-binary NUMERAL THING)`, on the
;;; smallest numeral at fault, and `not-binary-is-false` derives `(false)`.
;;;
;;; `bin-numeral-prefix-bit`: the prefix of `(b2 1 1)` is the bit `1`, where
;;; `z` or a numeral goes: a numeral ends in `z`. The probe `(bin-nz ?m)`
;;; finds it. The flag is `(not-binary (b2 1 1) 1)`, the smallest numeral at
;;; fault.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty, the one claim such
;;; a program can make. The request beside it is computed in root's state, but
;;; a dead state is no answer; `ein solve` names the fact the numeral was
;;; written in in the unsat core.

(import std.math.binary-arith :symbols (binary-arith bin-add))
(import std.math.binary :symbols (b2))
(import std.math.arith :symbols (z))

(bin-add (b2 z 1) (b2 z 1))
(bin-add (b2 (b2 1 1) 0) (b2 z 1))

(solve :expect (false))
