;;; `std.math.binary` — a malformed numeral: ends in zero.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A malformed numeral is `std.math.binary`'s, flagged where an operation
;;; takes it, on `std.math.decimal`'s pattern (Q-M1f.295, Q-M1f.404): the
;;; request's operand is looked up and walked a place a firing. The flag is
;;; `(not-binary NUMERAL THING)`, on the smallest numeral at fault, and
;;; `not-binary-is-false` derives `(false)`.
;;;
;;; `bin-numeral-prefix-zero`: the prefix of `(b2 0 1)`, the second place of
;;; `(b2 (b2 0 1) 1)`, is the bit `0`: zero is `z`, and the bit is no number.
;;; The flag is `(not-binary (b2 0 1) 0)`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root is dead and R is empty, the one claim such
;;; a program can make. The request beside it is computed in root's state, but
;;; a dead state is no answer; `ein solve` names the request that took the
;;; numeral in the unsat core.

(import std.math.binary-arith :symbols (binary-arith bin-add))
(import std.math.binary :symbols (b2))
(import std.math.arith :symbols (z))

(bin-add (b2 z 1) (b2 z 1))
(bin-add (b2 (b2 0 1) 1) (b2 z 1))

(solve :expect (false))
