;;; `std.math.binary` — what the check does not flag: a flag means malformed, and no flag does not mean well-formed.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; Three numerals a request takes are checked, and none is flagged or
;;; labelled, as their like are not in decimal. One whose prefix is a name
;;; that is neither a bit nor a named constant, `(b2 end 1)`, and so one
;;; whose prefix is a decimal digit, `(b2 7 1)`, a name in binary's eyes:
;;; saying *a name* costs a walk of the program's names. One whose prefix is
;;; a fact of another relation, `(b2 (pair 1 0) 1)`: no rule can say *not of
;;; this shape*. The walk of each stops at what is no numeral, so none
;;; reaches `z`, none is labelled valid, and no request of theirs is
;;; answered. A numeral no operation takes is not checked at all
;;; (Q-M1f.404).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root is alive, the sum beside them is answered, no flag has a
;;; fact, and `bin-valid`'s extent is the numerals the walk reached `z` from,
;;; the sum, and `z`.

(import std.math.binary-arith :symbols (binary-arith bin-let bin-add bin-sum-of))
(import std.math.binary :symbols (b2 not-binary bin-valid))
(import std.math.arith :symbols (z))

(relation pair Thing Thing :why "the pair of {?3} and {?4}")
(__closed__ pair)

(bin-let far (b2 end 1))
(bin-let seven (b2 7 1))
(bin-add far (b2 z 1))
(bin-add seven (b2 z 1))
(bin-add (b2 (pair 1 0) 1) (b2 z 1))
(bin-add (b2 z 1) (b2 (b2 z 1) 1))

(solve :expect (region (model)))

(query :goal (bin-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (bin-sum-of (b2 z 1) (b2 (b2 z 1) 1) (b2 (b2 (b2 z 1) 0) 0))))

(query :goal (not-binary ?numeral ?thing)
       :goal-text "{?numeral} is not a binary number"
       :expect (model))

(query :goal (bin-valid ?numeral)
       :goal-text "{?numeral} is a binary number"
       :expect (model (bin-valid z) (bin-valid (b2 z 1)) (bin-valid (b2 (b2 z 1) 1))
                      (bin-valid (b2 (b2 (b2 z 1) 0) 0))))
