;;; `std.int` — addition, every combination of signs. M1f S1f.6.7.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(int-add X Y)` is answered by `(int-sum-of X Y S)`, S in normal form.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; The operands, one after the other (`int-add-ask`, `int-operand-second`,
;;; `int-add-start`). Then the positive parts are added (`int-add-plus`), the
;;; negative parts (`int-add-minus`), and the pair is simplified
;;; (`int-add-norm`, and `int-norm-walks` onward): no rule looks at a sign.
;;;
;;;    7 +  5 = 12        7 + -5 = 2        -7 + 5 = -2       -7 + -5 = -12
;;;    5 + -7 = -2       12 + -12 = 0        0 + -3 = -3       0 + 0 = 0
;;;  999 +  1 = 1000   -999 + -1 = -1000  1000 + -1 = 999
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `int-sum-of`'s whole extent, eleven requests. No pair is asked both ways
;;; round: a rule that read `(int-add X Y)` as `(int-add Y X)` would answer
;;; each such request with the other's fact, and the claim would hold.

(import std.int :symbols (int-arith))

(int-add (int (n z 7) z) (int (n z 5) z))
(int-add (int (n z 7) z) (int z (n z 5)))
(int-add (int z (n z 7)) (int (n z 5) z))
(int-add (int z (n z 7)) (int z (n z 5)))
(int-add (int (n z 5) z) (int z (n z 7)))
(int-add (int (n (n z 1) 2) z) (int z (n (n z 1) 2)))
(int-add (int z z) (int z (n z 3)))
(int-add (int z z) (int z z))
(int-add (int (n (n (n z 9) 9) 9) z) (int (n z 1) z))
(int-add (int z (n (n (n z 9) 9) 9)) (int z (n z 1)))
(int-add (int (n (n (n (n z 1) 0) 0) 0) z) (int z (n z 1)))

(solve :expect (region (model)))

(query :goal (int-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (int-sum-of (int (n z 7) z) (int (n z 5) z) (int (n (n z 1) 2) z))
                      (int-sum-of (int (n z 7) z) (int z (n z 5)) (int (n z 2) z))
                      (int-sum-of (int z (n z 7)) (int (n z 5) z) (int z (n z 2)))
                      (int-sum-of (int z (n z 7)) (int z (n z 5)) (int z (n (n z 1) 2)))
                      (int-sum-of (int (n z 5) z) (int z (n z 7)) (int z (n z 2)))
                      (int-sum-of (int (n (n z 1) 2) z) (int z (n (n z 1) 2)) (int z z))
                      (int-sum-of (int z z) (int z (n z 3)) (int z (n z 3)))
                      (int-sum-of (int z z) (int z z) (int z z))
                      (int-sum-of (int (n (n (n z 9) 9) 9) z) (int (n z 1) z) (int (n (n (n (n z 1) 0) 0) 0) z))
                      (int-sum-of (int z (n (n (n z 9) 9) 9)) (int z (n z 1)) (int z (n (n (n (n z 1) 0) 0) 0)))
                      (int-sum-of (int (n (n (n (n z 1) 0) 0) 0) z) (int z (n z 1)) (int (n (n (n z 9) 9) 9) z))))
