;;; `std.int` — division, floored, every combination of signs with a
;;; remainder and without. M1f S1f.6.22.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(int-div-floor X Y)` is answered by `(int-quot-floor-of X Y Q R)` with
;;; X = Q x Y + R, Q rounded down and R with the divisor's sign, both integers in
;;; normal form.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; Both operands are simplified and the sizes divided by `std.arith`
;;; (`int-div-floor-ask`, then the shared `int-div-start`, `int-div-divisor`
;;; and one of `int-div-pp`, `-pn`, `-np`, `-nn`). Where the signs agree the
;;; sizes' quotient q and remainder r are the answer, the remainder negated
;;; where both are negative (`int-div-floor-pp`, `-nn`). Where they differ
;;; and nothing is left, the quotient is -q and the remainder zero
;;; (`-pn-exact`, `-np-exact`). Where they differ and a remainder is left,
;;; the quotient is -(q + 1) and the remainder's size |Y| - r, with the
;;; divisor's sign (`-pn-more`, `-np-more`, the shared `int-div-rest`, and
;;; `-neg` or `-pos`).
;;;
;;; X / Y = Q, R:
;;;
;;;   7 / 2 = 3, 1                      -7 / 2 = -4, 1
;;;   7 / -2 = -4, -1                   -7 / -2 = 3, -1
;;;   6 / 3 = 2, 0                      -6 / 3 = -2, 0
;;;   6 / -3 = -2, 0                    -6 / -3 = 2, 0
;;;   0 / 5 = 0, 0                      0 / -5 = 0, 0
;;;   1 / 4 = 0, 1                      -1 / 4 = -1, 3
;;;   1 / -4 = -1, -3                   -1 / -4 = 0, -1
;;;   127645 / -25 = -5106, -5          -127645 / 25 = -5106, 5
;;;   (5 less 12) / (3 less 1) = -7 / 2 = -4, 1
;;;   (2 less 8) / (1 less 4) = -6 / -3 = 2, 0
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `int-quot-floor-of`'s whole extent, 18 requests: the four combinations
;;; of signs with a remainder left and with none, a dividend of zero, a
;;; dividend smaller than the divisor, six digits by two, and two requests
;;; whose operands are written with both parts and read by value.

(import std.int :symbols (int-arith))

(int-div-floor (int (n z 7) z) (int (n z 2) z))
(int-div-floor (int z (n z 7)) (int (n z 2) z))
(int-div-floor (int (n z 7) z) (int z (n z 2)))
(int-div-floor (int z (n z 7)) (int z (n z 2)))
(int-div-floor (int (n z 6) z) (int (n z 3) z))
(int-div-floor (int z (n z 6)) (int (n z 3) z))
(int-div-floor (int (n z 6) z) (int z (n z 3)))
(int-div-floor (int z (n z 6)) (int z (n z 3)))
(int-div-floor (int z z) (int (n z 5) z))
(int-div-floor (int z z) (int z (n z 5)))
(int-div-floor (int (n z 1) z) (int (n z 4) z))
(int-div-floor (int z (n z 1)) (int (n z 4) z))
(int-div-floor (int (n z 1) z) (int z (n z 4)))
(int-div-floor (int z (n z 1)) (int z (n z 4)))
(int-div-floor (int (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) z) (int z (n (n z 2) 5)))
(int-div-floor (int z (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5)) (int (n (n z 2) 5) z))
(int-div-floor (int (n z 5) (n (n z 1) 2)) (int (n z 3) (n z 1)))
(int-div-floor (int (n z 2) (n z 8)) (int (n z 1) (n z 4)))

(solve :expect (region (model)))

(query :goal (int-quot-floor-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (int-quot-floor-of (int (n z 7) z) (int (n z 2) z) (int (n z 3) z) (int (n z 1) z))
                      (int-quot-floor-of (int z (n z 7)) (int (n z 2) z) (int z (n z 4)) (int (n z 1) z))
                      (int-quot-floor-of (int (n z 7) z) (int z (n z 2)) (int z (n z 4)) (int z (n z 1)))
                      (int-quot-floor-of (int z (n z 7)) (int z (n z 2)) (int (n z 3) z) (int z (n z 1)))
                      (int-quot-floor-of (int (n z 6) z) (int (n z 3) z) (int (n z 2) z) (int z z))
                      (int-quot-floor-of (int z (n z 6)) (int (n z 3) z) (int z (n z 2)) (int z z))
                      (int-quot-floor-of (int (n z 6) z) (int z (n z 3)) (int z (n z 2)) (int z z))
                      (int-quot-floor-of (int z (n z 6)) (int z (n z 3)) (int (n z 2) z) (int z z))
                      (int-quot-floor-of (int z z) (int (n z 5) z) (int z z) (int z z))
                      (int-quot-floor-of (int z z) (int z (n z 5)) (int z z) (int z z))
                      (int-quot-floor-of (int (n z 1) z) (int (n z 4) z) (int z z) (int (n z 1) z))
                      (int-quot-floor-of (int z (n z 1)) (int (n z 4) z) (int z (n z 1)) (int (n z 3) z))
                      (int-quot-floor-of (int (n z 1) z) (int z (n z 4)) (int z (n z 1)) (int z (n z 3)))
                      (int-quot-floor-of (int z (n z 1)) (int z (n z 4)) (int z z) (int z (n z 1)))
                      (int-quot-floor-of (int (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) z) (int z (n (n z 2) 5)) (int z (n (n (n (n z 5) 1) 0) 6)) (int z (n z 5)))
                      (int-quot-floor-of (int z (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5)) (int (n (n z 2) 5) z) (int z (n (n (n (n z 5) 1) 0) 6)) (int (n z 5) z))
                      (int-quot-floor-of (int (n z 5) (n (n z 1) 2)) (int (n z 3) (n z 1)) (int z (n z 4)) (int (n z 1) z))
                      (int-quot-floor-of (int (n z 2) (n z 8)) (int (n z 1) (n z 4)) (int (n z 2) z) (int z z))))
