;;; `std.int` — a division by zero, Euclidean: the divisor written `(int z z)`. M1f S1f.6.22.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; A division whose divisor is zero has no answer, under any convention. Both
;;; operands are simplified, the divisor's normal form is `(int z z)`, and
;;; `int-div-by-zero` derives the flag `(division-by-zero (int-div-euclid X
;;; Y))`, the request as written; `std.arith`'s `division-by-zero-is-false`
;;; derives `(false)` from the flag. The divisor is zero as written.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `(solve :expect (false))`: root's own fixpoint derives `(false)`, R is
;;; empty, and it is the one claim such a program can make. The sum beside
;;; the request is computed in root's state all the same, and no query of the
;;; program has an answer. Here: -7 by zero.

(import std.int :symbols (int-arith int-add int int-div-euclid))
(import std.arith :symbols (n))

(int-add (int (n z 2) z) (int z (n z 5)))
(int-div-euclid (int z (n z 7)) (int z z))

(solve :expect (false))
