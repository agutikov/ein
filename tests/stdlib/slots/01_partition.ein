;;; `std.slots` — the partition half: `slot-partition-setup`, `slot-locate`,
;;; `slot-exclusive`, `slot-occupied`, `slot-negative`, `slot-elimination`,
;;; `slot-fill`.
;;;
;;; ── Why this file exists ───────────────────────────────────────────────────
;;;
;;; `std.slots` is the one module at 100 % rule coverage and the most fragile
;;; thing in the census's table: all eighteen of its rules are activated by
;;; `examples/zebra.ein` and by **nothing else**. Change that puzzle's encoding
;;; — which is exactly what a second Zebra formulation is for — and eighteen
;;; rules become untested silently. This file and its three siblings are the
;;; second activator, and they are 2×2×2 rather than 5×5×5.
;;;
;;; ── What the declaration says ──────────────────────────────────────────────
;;;
;;;   (slot-partition R isa sub Super Index)
;;;
;;; reads: *R is an equivalence relation; its classes are slots; each slot
;;; holds exactly one `isa`-member of every type that is a direct `sub`-child
;;; of `Super`; and the `Index` member of a slot is its name.* One fact, and
;;; `slot-partition-setup` fans it into eight activators.
;;;
;;; ── What this program does to them ─────────────────────────────────────────
;;;
;;; Two seats, two people, two pets, and two authored facts — one
;;; cross-attribute clue with no seat named, and one placement:
;;;
;;;   (co-loc Ann Cat)     "Ann's pet is the cat" — the clue shape the whole
;;;                        module exists for, since it names no slot at all
;;;   (co-loc Ann S1)      Ann is in seat 1
;;;
;;; and the chain is the module's own summary, one rule per step:
;;;
;;;   slot-locate       Cat shares a slot with Ann, Ann is at S1 ⟹ Cat is at S1
;;;   slot-exclusive    Ann ≠ Bob, Cat ≠ Dog, S1 ≠ S2 — same-type pairs never
;;;                     share a slot, derived from the membership facts and
;;;                     never authored pairwise
;;;   slot-occupied     S1's Who seat holds Ann, so it does not hold Bob; its
;;;                     Pet seat holds Cat, so not Dog
;;;   slot-negative     the contrapositive of transitivity: what Ann cannot be,
;;;                     Cat cannot be either
;;;   slot-elimination  Bob has every seat but S2 excluded ⟹ Bob is at S2,
;;;                     and Dog likewise
;;;
;;; Both survivors arrive by **elimination** here, and that is worth saying
;;; because the module insists `slot-elimination` and `slot-fill` are not each
;;; other's mirror. With two members per type the two rules see the same single
;;; exclusion and whichever is scheduled first is the productive one; it takes
;;; a *third* member to make a seat run out of candidates while no value has
;;; run out of seats. `03_fill.ein` and `04_elimination.ein` are that pair —
;;; one file per rule, each the smallest state in which only that rule can
;;; fire — and `slot-fill` is correctly redundant here.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; Closing `co-loc` is the whole test, and the interesting part is what is
;;; **not** in it: `(co-loc Bob Dog)` never appears, though Bob and Dog are in
;;; the same slot and the relation is an equivalence. That is the module's
;;; materialisation policy — every derived edge is anchored at the slot's
;;; index, so the derived facts stay on the value×index rectangle instead of
;;; enumerating every pair inside a class. Transitivity still *holds*; it is
;;; simply not written down, and the authored clue `(co-loc Ann Cat)` is the
;;; one off-rectangle edge in the model because the program put it there.
;;; Measured on the real Zebra, enumerating the closure costs ~4.3 s per
;;; hypothesis against ~0.09 s.
;;;
;;; A closed extent can say the edge is missing; it cannot say the *exclusion*
;;; is missing too, since stored negatives are not closed. The `undecided`
;;; probe says that half: `(co-loc Bob Dog)` is in neither store, which is the
;;; third state, and is the difference between "not enumerated" and "denied".
;;;
;;; `(transitive co-loc)` is therefore **not** declared, and must not be. What
;;; is required of the caller is the symmetric closure, positive and negative,
;;; which is `std.algebra`'s job.

(import std.algebra :symbols (symmetric symmetric-negative-setup))
(import std.slots   :symbols (slot-partition-setup))

(relation type     T T :why "{?1} is a subtype of {?2}")
(relation instance T T :why "{?1} is an instance of {?2}")
(relation co-loc    Attribute Attribute :why "{?1} and {?2} are in the same seat")
(relation undecided Attribute Attribute :why "{?1} and {?2}: seat still open")

(symmetric co-loc)
(slot-partition co-loc instance type Attribute Seat)

(type Attribute T)
(type Seat Attribute) (type Who Attribute) (type Pet Attribute)

(instance S1 Seat) (instance S2 Seat)
(instance Ann Who) (instance Bob Who)
(instance Cat Pet) (instance Dog Pet)

(co-loc Ann Cat)
(co-loc Ann S1)

(import std.macro :symbols (open))
(rule probe-undecided ()
  :match  (open (co-loc Bob Dog))
  :assert (undecided Bob Dog)
  :priority 500
  :why    "Bob and Dog share seat S2, and the anchored closure says so neither way")

(query
  :goal (co-loc ?a ?b)
  :no-hypothesis (type instance co-loc undecided)
  :expect (model (co-loc Ann Cat) (co-loc Cat Ann)
                 (co-loc Ann S1)  (co-loc S1 Ann)
                 (co-loc Cat S1)  (co-loc S1 Cat)
                 (co-loc Bob S2)  (co-loc S2 Bob)
                 (co-loc Dog S2)  (co-loc S2 Dog)
                 (undecided Bob Dog)))
