;;; `std.slots` — `slot-endpoint-fwd` and `slot-endpoint-bwd` activated alone:
;;; what the ends of a row exclude, with nothing placed.
;;;
;;; ── What the rules promise ─────────────────────────────────────────────────
;;;
;;;   slot-endpoint-fwd  a position with no S-source holds no lower end of a clue
;;;   slot-endpoint-bwd  a position with no S-target holds no upper end of one
;;;
;;; `07_spatial_prune.ein` shows the two beside the rest of the family, where
;;; the pruning rules and occupancy reach the same four exclusions. Here they
;;; are activated by themselves, so every exclusion the claim lists is theirs.
;;;
;;; ── What this program does ─────────────────────────────────────────────────
;;;
;;;   right-of:  S1 ← S2 ← S3      (right-of S2 S1) (right-of S3 S2)
;;;   the clue:  (right-of Ann Cat), Ann's seat immediately right of Cat's
;;;
;;; S3 has no S-source, so `slot-endpoint-fwd` excludes Cat from it; S1 has no
;;; S-target, so `slot-endpoint-bwd` excludes Ann from it. The row's own two
;;; facts are clues to the rules as well, between seats, and give four
;;; exclusions between seats, which no state of the partition could hold
;;; either.
;;;
;;; ── How the expectation sees a negative ────────────────────────────────────
;;;
;;; `probe-excluded` turns every exclusion into an `excluded` fact, which the
;;; claim closes (`13_adjacent_bwd_neg_direction.ein`'s idiom): a rule that
;;; stopped firing, or concluded the pair the other way round, refutes it.

(import std.slots :symbols (slot-endpoint-fwd slot-endpoint-bwd))

(relation instance T T :why "{?3} is an instance of {?4}")
(relation co-loc   Attribute Attribute :why "{?3} and {?4} are in the same seat")
(relation right-of Attribute Attribute :why "{?3}'s seat is immediately right of {?4}'s")
(relation excluded Attribute Attribute :why "{?3} was ruled out of {?4}")

(slot-endpoint-fwd co-loc right-of instance Seat)
(slot-endpoint-bwd co-loc right-of instance Seat)

(instance S1 Seat) (instance S2 Seat) (instance S3 Seat)

;; Three seats in a row.
(right-of S2 S1) (right-of S3 S2)

;; The clue, neither end placed.
(right-of Ann Cat)

(rule probe-excluded ()
  :match  (not (co-loc ?x ?s))
  :assert (excluded ?x ?s)
  :why    "an endpoint rule ruled {?x} out of {?s}")

;; Root alone (Q-M1f.254): the question is root's saturation, so nothing is
;; guessed; no obligation is activated, and root is R's one state.
(solve
  :no-search
  :expect (region (model (excluded Cat S3)      ; slot-endpoint-fwd: S3 has no source
                         (excluded Ann S1)      ; slot-endpoint-bwd: S1 has no target
                         (excluded S1 S3) (excluded S2 S3)    ; the row's facts, fwd
                         (excluded S2 S1) (excluded S3 S1))))  ; the row's facts, bwd

(query
  :goal (excluded ?x ?s))
