;;; `std.num9` — multiplication: 123 x 456 = 56088, eleven firings. M1f S1f.6.13.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(mul9 X Y)` is answered by `(product9-of X Y P)`, the school method from
;;; the multiplier's top digit. `mul9-start` states the first state: nine
;;; digits to go, the whole multiplier left, nothing summed. Then a step a
;;; digit. `mul9-step` is one rule with eighteen table premises: the
;;; multiplicand times the multiplier's top digit, a column at a time over
;;; the digit multiplier's table, and that row added to the sum so far
;;; shifted one place, a column at a time over the full adder's. Where the
;;; digit is 0, `mul9-step-zero` shifts the sum and reads no table.
;;; `mul9-done` reads the product when no digit is left.
;;;
;;;   digit    the rule           the row      the sum so far
;;;   0, six   mul9-step-zero                               0
;;;   4        mul9-step              492                 492
;;;   5        mul9-step              615                5535      4920 + 615
;;;   6        mul9-step              738               56088      55350 + 738
;;;
;;; The second product is the largest square that fits: 31622 x 31622 =
;;; 999950884. The third has a zero inside its multiplier, 203 x 407 = 82621,
;;; a shift between two rows.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `product9-of`'s whole extent, three products, and no overflow at all.

(import std.num9 :symbols (arith9 mul9 num9 product9-of overflow))

(mul9 (num9 0 0 0 0 0 0 1 2 3) (num9 0 0 0 0 0 0 4 5 6))
(mul9 (num9 0 0 0 0 3 1 6 2 2) (num9 0 0 0 0 3 1 6 2 2))
(mul9 (num9 0 0 0 0 0 0 2 0 3) (num9 0 0 0 0 0 0 4 0 7))

(solve :expect (region (model)))

(query :goal (product9-of ?x ?y ?p)
       :goal-text "{?x} x {?y} = {?p}"
       :expect (model (product9-of (num9 0 0 0 0 0 0 1 2 3) (num9 0 0 0 0 0 0 4 5 6) (num9 0 0 0 0 5 6 0 8 8))
                      (product9-of (num9 0 0 0 0 3 1 6 2 2) (num9 0 0 0 0 3 1 6 2 2) (num9 9 9 9 9 5 0 8 8 4))
                      (product9-of (num9 0 0 0 0 0 0 2 0 3) (num9 0 0 0 0 0 0 4 0 7) (num9 0 0 0 0 8 2 6 2 1))))

(query :goal (overflow ?request)
       :goal-text "{?request} does not fit nine digits"
       :expect (model))
