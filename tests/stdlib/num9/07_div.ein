;;; `std.num9` — long division: 127645 divided by 25 is 5105, remainder 20,
;;; eleven firings. M1f S1f.6.13.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(div9 X Y)` is answered by `(quot9-of X Y Q R)`: X = Q x Y + R, and R
;;; less than Y. `div9-start` computes the divisor's multiples by 2 to 9 in
;;; one firing, 72 rows of the digit multiplier's table, and puts the nine
;;; multiples into the state, `(multiples9 …)`, each a `(row9 …)` of ten
;;; digits. Then a step a digit of the dividend, from the top: the digit is
;;; brought down beside what is left over, and of ten rules, `div9-step-0` to
;;; `div9-step-9`, exactly one fires, the one whose multiple subtracts with no
;;; borrow and leaves less than the divisor. `div9-done` reads the answer.
;;;
;;;   bring down    number    the rule that fires    left
;;;   0, 0, 0            0    div9-step-0               0
;;;   1                  1    div9-step-0               1
;;;   2                 12    div9-step-0              12
;;;   7                127    div9-step-5               2
;;;   6                 26    div9-step-1               1
;;;   4                 14    div9-step-0              14
;;;   5                145    div9-step-5              20
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `quot9-of`'s whole extent: one request, one answer, nothing guessed.

(import std.num9 :symbols (arith9))

(div9 (num9 0 0 0 1 2 7 6 4 5) (num9 0 0 0 0 0 0 0 2 5))

(solve :expect (region (model)))

(query :goal (quot9-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot9-of (num9 0 0 0 1 2 7 6 4 5) (num9 0 0 0 0 0 0 0 2 5) (num9 0 0 0 0 0 5 1 0 5) (num9 0 0 0 0 0 0 0 2 0))))
