;;; `std.num9` — a quotient with every digit: 864197523 divided by 7 is
;;; 123456789; and a long divisor. M1f S1f.6.13.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; The ten step rules are one rule written ten times, alike but for the
;;; multiple each reads from the state and the digit it writes. A quotient of
;;; 123456789 fires `div9-step-1` to `div9-step-9`, once each; the second
;;; request, 999999999 divided by 123456789, is 8 remainder 12345687, by
;;; eight steps of `div9-step-0` and one of `div9-step-8`, against a divisor
;;; of nine digits whose multiples by 9 has ten.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `quot9-of`'s whole extent, two answers.

(import std.num9 :symbols (arith9))

(div9 (num9 8 6 4 1 9 7 5 2 3) (num9 0 0 0 0 0 0 0 0 7))
(div9 (num9 9 9 9 9 9 9 9 9 9) (num9 1 2 3 4 5 6 7 8 9))

(solve :expect (region (model)))

(query :goal (quot9-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot9-of (num9 8 6 4 1 9 7 5 2 3) (num9 0 0 0 0 0 0 0 0 7) (num9 1 2 3 4 5 6 7 8 9) (num9 0 0 0 0 0 0 0 0 0))
                      (quot9-of (num9 9 9 9 9 9 9 9 9 9) (num9 1 2 3 4 5 6 7 8 9) (num9 0 0 0 0 0 0 0 0 8) (num9 0 1 2 3 4 5 6 8 7))))
