;;; `std.num9` — subtraction, two numbers: 123078 - 4567, and the other way
;;; round, and a number from itself. M1f S1f.6.13.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(sub9 X Y)` is answered by `(diff9-of X Y D R)`: D is X - Y where X is
;;; not the smaller and zero otherwise; R is what X is short by, Y - X, where
;;; X is the smaller and zero otherwise. Two rules, each a subtractor with a
;;; premise a column over the full subtractor's table: `sub9-fits` takes Y
;;; from X, `sub9-short` takes X from Y, and the one whose top column does not
;;; borrow answers. The borrow is the comparison, as in hardware; nothing is
;;; compared first and nothing is guessed.
;;;
;;;   123078 - 4567      sub9-fits     D = 118511, R = 0
;;;   250 - 4567         sub9-short    D = 0,      R = 4317
;;;   25 - 25            both rules, and they conclude the same fact
;;;
;;; No request here is another the other way round, on purpose: a rule that
;;; read its request's operands exchanged would answer each of such a pair
;;; with the other's fact, and the two facts together would look right.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `diff9-of`'s whole extent: three requests, three answers, exactly one
;;; each, the equal operands too.

(import std.num9 :symbols (arith9 sub9 num9 diff9-of))

(sub9 (num9 0 0 0 1 2 3 0 7 8) (num9 0 0 0 0 0 4 5 6 7))
(sub9 (num9 0 0 0 0 0 0 2 5 0) (num9 0 0 0 0 0 4 5 6 7))
(sub9 (num9 0 0 0 0 0 0 0 2 5) (num9 0 0 0 0 0 0 0 2 5))

(solve :expect (region (model)))

(query :goal (diff9-of ?x ?y ?d ?r)
       :goal-text "{?x} - {?y} = {?d}, short by {?r}"
       :expect (model (diff9-of (num9 0 0 0 1 2 3 0 7 8) (num9 0 0 0 0 0 4 5 6 7) (num9 0 0 0 1 1 8 5 1 1) (num9 0 0 0 0 0 0 0 0 0))
                      (diff9-of (num9 0 0 0 0 0 0 2 5 0) (num9 0 0 0 0 0 4 5 6 7) (num9 0 0 0 0 0 0 0 0 0) (num9 0 0 0 0 0 4 3 1 7))
                      (diff9-of (num9 0 0 0 0 0 0 0 2 5) (num9 0 0 0 0 0 0 0 2 5) (num9 0 0 0 0 0 0 0 0 0) (num9 0 0 0 0 0 0 0 0 0))))
