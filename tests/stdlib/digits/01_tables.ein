;;; `std.digits` — the digit tables, imported flat, a row of each claimed.
;;; M1f S1f.6.2.
;;;
;;; ── What the module promises ───────────────────────────────────────────────
;;;
;;; `std.digits` is a library of **facts** and holds no rule: seven tables,
;;; one fact a row, which the arithmetic theories look up. Its rows are held
;;; to Rust's integers, every one, by `ein-ir/tests/digit_tables.rs`; this
;;; program is the other half, the module seen from a program:
;;;
;;;   - a flat import brings a listed table's declaration **and its rows**
;;;     (M1f S1f.6.11's fix, W88, seen from the stdlib);
;;;   - with `__closed__` listed, the import brings the module's written
;;;     `(__closed__ R)` facts too, so no row is a hypothesis: the universe
;;;     has no candidate, and R is {∅}, which the `(solve …)` form claims.
;;;     Without it `nz` and `adj`, of one and two arguments, would be
;;;     relations the search guesses rows of.
;;;
;;; ── The claims ─────────────────────────────────────────────────────────────
;;;
;;; A goal with constants in the places a table *reads* and variables where it
;;; *gives* is a lookup, and its claim closes the goal: exactly one row
;;; answers, so a table that held a second answer for the same reading fails
;;; the file. Each is the far corner of its table, where a wrong carry shows:
;;;
;;;   fa   9 + 9 + carry 1 = 19          digit 9, carry 1
;;;   fs   0 - 9 - borrow 1 = -10        digit 0, borrow 1
;;;   md   9 x 9 + carry 8 = 89          digit 9, carry 8
;;;   cl   equal below, then 3 against 7 lt: a differing digit overrules
;;;   cl   gt below, then 5 against 5    gt: equal digits keep the order
;;;   mid  between 0 and 10              try 5
;;;
;;; `nz` and `adj` are claimed whole: nine digits are not zero and `0` is not
;;; among them; ten pairs of bounds have nothing between them.

(import std.digits :symbols (fa fs md cl nz mid adj __closed__))

(solve :expect (region (model)))

(query :goal (fa 9 9 1 ?digit ?carry)
       :expect (model (fa 9 9 1 9 1)))

(query :goal (fs 0 9 1 ?digit ?borrow)
       :expect (model (fs 0 9 1 0 1)))

(query :goal (md 9 9 8 ?digit ?carry)
       :expect (model (md 9 9 8 9 8)))

(query :goal (cl eq 3 7 ?order)
       :expect (model (cl eq 3 7 lt)))

(query :goal (cl gt 5 5 ?order)
       :expect (model (cl gt 5 5 gt)))

(query :goal (mid 0 10 ?try)
       :expect (model (mid 0 10 5)))

(query :goal (nz ?digit)
       :expect (model (nz 1) (nz 2) (nz 3) (nz 4) (nz 5) (nz 6) (nz 7) (nz 8) (nz 9)))

(query :goal (adj ?lo ?hi)
       :expect (model (adj 0 1) (adj 1 2) (adj 2 3) (adj 3 4) (adj 4 5)
                      (adj 5 6) (adj 6 7) (adj 7 8) (adj 8 9) (adj 9 10)))
