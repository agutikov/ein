;;; `std.debts` — `fill-due` and `fill-paid`: what `std.slots`'
;;; `slot-owed-fill` requires, and what pays it, as facts.
;;;
;;; `03_room_due_paid.ein` read from the slot's side, on
;;; `slots/11_owed_fill.ein`'s world. Every seat is required to have a member
;;; of every kind under `Attribute`, the kind of the seats apart:
;;;
;;;   S1, Who              `(co-loc S1 Ann)`: required, and paid
;;;   S1, Pet              required, and S1 has no pet
;;;   S2, Who and S2, Pet  required, and S2 is empty
;;;   S1, Seat and S2, Seat   required nothing: a seat owes itself no seat,
;;;                        which is the rule's `(neq ?Tv ?index)`
;;;
;;; So four requirements and one payment, and the difference is the three
;;; `slot-owed-fill` owes in `11`. The arrow is read slot first,
;;; `(co-loc S1 Ann)`, where `room-paid` reads it member first: the two pairs
;;; are the two directions, and a file activates one.
;;;
;;; `(co-loc S1 S2)`, a seat linked to a seat, is here to tempt the payment
;;; rule's guard, as in `03`: no seat is required a seat, so it pays nothing,
;;; and a payment rule without the guard would conclude a payment of a
;;; requirement nobody stated.
;;;
;;; The claims close the two relations' held extents. The instance names the
;;; activator's five arguments, the slot and the kind it is to hold.

(import std.debts :symbols (fill-due fill-paid))

(relation type     T T :why "{?3} is a subtype of {?4}")
(relation instance T T :why "{?3} is an instance of {?4}")
(relation co-loc   Attribute Attribute :why "{?3} and {?4} are in the same seat")

(fill-due  co-loc instance type Attribute Seat)
(fill-paid co-loc instance type Attribute Seat)

(type Attribute T)
(type Seat Attribute) (type Who Attribute) (type Pet Attribute)

(instance S1 Seat) (instance S2 Seat)
(instance Ann Who) (instance Bob Who)
(instance Cat Pet) (instance Dog Pet)

(co-loc S1 Ann)              ; S1 has no pet; S2 has nobody
(co-loc S1 S2)               ; a seat beside a seat: pays nothing

;; Root alone (Q-M1f.254): the question is what root's saturation concludes.
(solve :no-search)

(query :goal (debt-due ?R ?j)
  :expect (model (debt-due co-loc (slot-owed-fill-of co-loc instance type Attribute Seat S1 Who))
                 (debt-due co-loc (slot-owed-fill-of co-loc instance type Attribute Seat S1 Pet))
                 (debt-due co-loc (slot-owed-fill-of co-loc instance type Attribute Seat S2 Who))
                 (debt-due co-loc (slot-owed-fill-of co-loc instance type Attribute Seat S2 Pet))))
(query :goal (debt-paid ?R ?j)
  :expect (model (debt-paid co-loc (slot-owed-fill-of co-loc instance type Attribute Seat S1 Who))))
(query :goal (debts-discharged)
  :expect (model))
