;;; `std.contradiction/clash-5` — a fact of five arguments beside its
;;; negation: the rule concludes `(false)`.
;;;
;;; One rule a file: the one relation is declared at this count, so of the
;;; module's rules only `clash-5` can fire. The claim, `(false)`, holds by the
;;; rule: with no rule over the pair, root would be alive. `01_clash_0.ein`
;;; says where its firing is asserted.

(import std.contradiction :symbols (clash-5))

(relation route From To By Day Driver :why "{?7} drives from {?3} to {?4} by {?5} on {?6}")

(clash-5 route)

(route Inn Mill Cart Monday Ann)
(not (route Inn Mill Cart Monday Ann))          ; ⊥ — the fact and its denial

;; Root alone (Q-M1f.254): the question is root's verdict.
(solve
  :no-search
  :expect (false))

(query
  :goal (route ?a ?b ?c ?d ?e))
