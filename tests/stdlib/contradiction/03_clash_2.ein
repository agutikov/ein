;;; `std.contradiction/clash-2` — a fact of two arguments beside its
;;; negation: the rule concludes `(false)`.
;;;
;;; One rule a file: the one relation is declared at this count, so of the
;;; module's rules only `clash-2` can fire. The claim, `(false)`, holds by the
;;; rule: with no rule over the pair, root would be alive. `01_clash_0.ein`
;;; says where its firing is asserted.

(import std.contradiction :symbols (clash-2))

(relation seats Guest Chair :why "{?3} is seated at {?4}")

(clash-2 seats)

(seats Ann C1)
(not (seats Ann C1))          ; ⊥ — the fact and its denial

;; Root alone (Q-M1f.254): the question is root's verdict.
(solve
  :no-search
  :expect (false))

(query
  :goal (seats ?a ?b))
