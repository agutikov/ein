;;; `std.contradiction/clash-1` — a fact of one argument beside its
;;; negation: the rule concludes `(false)`.
;;;
;;; One rule a file: the one relation is declared at this count, so of the
;;; module's rules only `clash-1` can fire. The claim, `(false)`, holds by the
;;; rule: with no rule over the pair, root would be alive. `01_clash_0.ein`
;;; says where its firing is asserted.

(import std.contradiction :symbols (clash-1))

(relation wet Thing :why "{?3} is wet")

(clash-1 wet)

(wet Lawn)
(not (wet Lawn))          ; ⊥ — the fact and its denial

;; Root alone (Q-M1f.254): the question is root's verdict.
(solve
  :no-search
  :expect (false))

(query
  :goal (wet ?a))
