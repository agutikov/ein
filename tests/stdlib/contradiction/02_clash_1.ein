;;; `std.contradiction/clash-1` — a fact of one argument beside its
;;; negation: the rule concludes `(false)`.
;;;
;;; One rule a file: `clash-1` is activated for the one relation, and no
;;; other rule of the module is. The claim, `(false)`, holds of this program
;;; with the rule and without it, since the kernel calls the pair dead by
;;; itself; `01_clash_0.ein` says what the file gives the rule all the same,
;;; and where its firing is asserted.

(import std.contradiction :symbols (clash-1))

(relation wet Thing :why "{?3} is wet")

(clash-1 wet)

(wet Lawn)
(not (wet Lawn))          ; ⊥ — the fact and its denial

;; Root alone (Q-M1f.254): the question is root's verdict.
(solve
  :no-search
  :expect (false))

(query
  :goal (wet ?a))
