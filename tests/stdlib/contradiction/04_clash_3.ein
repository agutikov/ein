;;; `std.contradiction/clash-3` — a fact of three arguments beside its
;;; negation: the rule concludes `(false)`.
;;;
;;; One rule a file: the one relation is declared at this count, so of the
;;; module's rules only `clash-3` can fire. The claim, `(false)`, holds by the
;;; rule: with no rule over the pair, root would be alive. `01_clash_0.ein`
;;; says where its firing is asserted.

(import std.contradiction :symbols (clash-3))

(relation between Place Place Place :why "{?3} is between {?4} and {?5}")

(clash-3 between)

(between Inn Mill Ford)
(not (between Inn Mill Ford))          ; ⊥ — the fact and its denial

;; Root alone (Q-M1f.254): the question is root's verdict.
(solve
  :no-search
  :expect (false))

(query
  :goal (between ?a ?b ?c))
