(query :goal (swap-of ?a ?b)
       :expect (model (swap-of And And) (swap-of Andn Randn) (swap-of Fst Snd) (swap-of Nand Nand)
                      (swap-of Nfst Nsnd) (swap-of Nor Nor) (swap-of Nsnd Nfst) (swap-of One One)
