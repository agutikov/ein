;;; `std.bool.props` — the relations between two functions. M1f S1f.6.17.
;;;
;;; GENERATED by `utils/gen_gates.py` from the sixteen functions' columns:
;;; edit the script and run it, never this file. Its `--check` is in the
;;; gate, through `ein-infer/tests/bool_theory.rs`, which also holds every
;;; fact to an enumeration in Rust.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; Each is a function of the sixteen to the sixteen, so it holds sixteen facts,
;;; every function once on the left:
;;;
;;;   (swap-of F G)        G(a, b) = F(b, a); four pairs, and eight functions
;;;                        their own swap (reply 22 (a))
;;;   (complement-of F G)  G(a, b) = not F(a, b)
;;;   (dual-of F G)        G(a, b) = not F(not a, not b); `Andn`/`Orn` and
;;;                        `Randn`/`Rorn` among them (reply 22 (a)), and four
;;;                        functions their own dual
;;;   (left-negated F G)   G(a, b) = F(not a, b)
;;;   (right-negated F G)  G(a, b) = F(a, not b)
;;;
;;; Each is an involution, so each relation is its own converse: a fact and its
;;; mirror are both here, and a rule that wrote its conclusion the other way
;;; round would write the same facts (`tests/README.md`, the survivors).
;;;
;;; The rules: `swap`, `complement`, `dual`, `left-neg`, `right-neg`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; Each query claims one relation's whole extent, computed in Python from the
;;; columns. A claim that names a relation closes it, so it holds only if the
;;; rules derive every listed fact and no other: that is the negative case of
;;; a library with no refutation rule. Every relation is closed, so there is
;;; no candidate: R is {∅}, root's fixpoint, one saturation.
;;;
;;; The facts a relation: `swap-of` 16, `complement-of` 16, `dual-of` 16,
;;; `left-negated` 16, `right-negated` 16.

(import std.bool.props :symbols (props swap-of complement-of dual-of left-negated right-negated))
(import std.bool.gates :symbols (Zero And Andn Fst Randn Snd Xor Or Nor Xnor Nsnd Orn Nfst Rorn
                                 Nand One))

