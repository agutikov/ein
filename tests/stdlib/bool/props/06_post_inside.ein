                      (preserves-one Or) (preserves-one Orn) (preserves-one Rorn)
                      (preserves-one Snd) (preserves-one Xnor)))
(query :goal (monotone ?a)
       :expect (model (monotone And) (monotone Fst) (monotone One) (monotone Or) (monotone Snd)
                      (monotone Zero)))
(query :goal (affine ?a)
       :expect (model (affine Fst) (affine Nfst) (affine Nsnd) (affine One) (affine Snd)
                      (affine Xnor) (affine Xor) (affine Zero)))
(query :goal (self-dual ?a)
