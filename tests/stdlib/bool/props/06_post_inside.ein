;;; fact to an enumeration in Rust.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;;   (preserves-zero F)  F(0, 0) = 0
;;;   (preserves-one F)   F(1, 1) = 1
;;;   (monotone F)        raising an input never lowers the output
;;;   (affine F)          F is a sum modulo 2 of inputs and a constant: its
;;;                       column has an even number of ones, which `affine-r`
;;;                       reads off `Xor`'s own rows
;;;   (self-dual F)       F is its own dual
;;;
;;; A set of functions builds every function exactly when it has a member
;;; outside each of the five (Post's theorem); `examples/binary_logic/post.ein`
;;; asks it of seven sets.
;;;
;;; The rules: `preserves-zero-r`, `preserves-one-r`, `monotone-r`, `affine-r`, `self-dual-r`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; Each query claims one relation's whole extent, computed in Python from the
;;; columns. A claim that names a relation closes it, so it holds only if the
;;; rules derive every listed fact and no other: that is the negative case of
;;; a library with no refutation rule. Every relation is closed, so there is
;;; no candidate: R is {∅}, root's fixpoint, one saturation.
;;;
;;; The facts a relation: `preserves-zero` 8, `preserves-one` 8, `monotone` 6,
;;; `affine` 8, `self-dual` 4.

(import std.bool.props :symbols (props preserves-zero preserves-one monotone affine self-dual))
(import std.bool.gates :symbols (Zero And Andn Fst Randn Snd Xor Or Xnor Nsnd Orn Nfst Rorn One))

(solve :expect (region (model)))

(query :goal (preserves-zero ?a)
       :expect (model (preserves-zero And) (preserves-zero Andn) (preserves-zero Fst)
                      (preserves-zero Or) (preserves-zero Randn) (preserves-zero Snd)
                      (preserves-zero Xor) (preserves-zero Zero)))
