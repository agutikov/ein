;;; `std.bool.props` — which inputs a function reads. M1f S1f.6.17.
;;;
;;; GENERATED by `utils/gen_gates.py` from the sixteen functions' columns:
;;; edit the script and run it, never this file. Its `--check` is in the
;;; gate, through `ein-infer/tests/bool_theory.rs`, which also holds every
;;; fact to an enumeration in Rust.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;;   (reads-first F)     with the second input held, changing the first changes F
;;;   (reads-second F)    and the other way round
;;;   (ignores-first F)   F's rows do not change with the first input
;;;   (ignores-second F)  nor with the second
;;;
;;; Ten functions read both; `Fst` and `Nfst` the first only, `Snd` and `Nsnd`
;;; the second only, `Zero` and `One` neither. *Reads* is one witness pair of
;;; rows and *ignores* a shape of the column, so neither is the other's negation
;;; and both are monotone rules.
;;;
;;; The rules: `reads-first-r`, `reads-second-r`, `ignores-first-r`, `ignores-second-r`.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; Each query claims one relation's whole extent, computed in Python from the
;;; columns. A claim that names a relation closes it, so it holds only if the
;;; rules derive every listed fact and no other: that is the negative case of
;;; a library with no refutation rule. Every relation is closed, so there is
;;; no candidate: R is {∅}, root's fixpoint, one saturation.
;;;
;;; The facts a relation: `reads-first` 12, `reads-second` 12, `ignores-first`
;;; 4, `ignores-second` 4.

(import std.bool.props :symbols (props reads-first reads-second ignores-first ignores-second))
(import std.bool.gates :symbols (Zero And Andn Fst Randn Snd Xor Or Nor Xnor Nsnd Orn Nfst Rorn
                                 Nand One))

(solve :expect (region (model)))

(query :goal (reads-first ?a)
       :expect (model (reads-first And) (reads-first Andn) (reads-first Fst) (reads-first Nand)
                      (reads-first Nfst) (reads-first Nor) (reads-first Or) (reads-first Orn)
                      (reads-first Randn) (reads-first Rorn) (reads-first Xnor) (reads-first Xor)))
(query :goal (reads-second ?a)
       :expect (model (reads-second And) (reads-second Andn) (reads-second Nand) (reads-second Nor)
                      (reads-second Nsnd) (reads-second Or) (reads-second Orn) (reads-second Randn)
                      (reads-second Rorn) (reads-second Snd) (reads-second Xnor) (reads-second Xor)))
(query :goal (ignores-first ?a)
       :expect (model (ignores-first Nsnd) (ignores-first One) (ignores-first Snd)
                      (ignores-first Zero)))
(query :goal (ignores-second ?a)
       :expect (model (ignores-second Fst) (ignores-second Nfst) (ignores-second One)
                      (ignores-second Zero)))
