;;; `std.rat` — a rational is an integer over a natural number, and its normal
;;; form is in lowest terms. M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(rat Z D)` is Z over D: Z an integer of `std.int`, `(int P N)`, and D a
;;; number of `std.arith` that is not zero. A request fact `(rat-simplify X)`
;;; is answered by `(rat-simple-of X S)`: S is X's one normal form, the
;;; numerator simplified, the two with no common divisor but 1, the
;;; denominator with no high zero, and zero written 0 over 1.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; The operand stands for itself (`rat-simplify-ask`, `rat-operand`), and its
;;; denominator is compared with zero (`rat-operand-check`,
;;; `rat-operand-found`, `rat-simplify-start`). The numerator is simplified by
;;; `std.int` (`rat-norm-numerator`, `rat-norm-reduce`) and its sign taken off
;;; (`rat-reduce-pos`, `rat-reduce-neg`). Then Euclid's chain, each step a
;;; division of `std.arith` (`rat-gcd-step`, `rat-gcd-next`, `rat-gcd-end`):
;;;
;;;   gcd(1071, 462):  1071 = 2 x 462 + 147;  462 = 3 x 147 + 21;
;;;                    147 = 7 x 21 + 0;  so 21, and 1071/462 is 51/22
;;;
;;; and both are divided by what it finds (`rat-lowest-numerator`,
;;; `rat-lowest-denominator`; `rat-lowest-pos` or `rat-lowest-neg`;
;;; `rat-simplify-answer`).
;;;
;;;   2/4 = 1/2       -6/8 = -3/4      0/7 = 0/1       5/1 = 5/1
;;;   (5 less 3)/4 = 1/2               12/18 = 2/3     17/5 = 17/5
;;;   -21/7 = -3/1    1071/462 = 51/22  (3 less 3)/9 = 0/1   3/006 = 1/2
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `rat-simple-of`'s whole extent: eleven requests, eleven answers, each
;;; operand repeated as written and each answer in lowest terms. The
;;; `(solve …)` form claims R = {∅}: nothing is guessed.

(import std.rat :symbols (rat-arith rat-simplify rat rat-simple-of))
(import std.int :symbols (int))
(import std.arith :symbols (n))

(rat-simplify (rat (int (n z 2) z) (n z 4)))
(rat-simplify (rat (int z (n z 6)) (n z 8)))
(rat-simplify (rat (int z z) (n z 7)))
(rat-simplify (rat (int (n z 5) z) (n z 1)))
(rat-simplify (rat (int (n z 5) (n z 3)) (n z 4)))
(rat-simplify (rat (int (n (n z 1) 2) z) (n (n z 1) 8)))
(rat-simplify (rat (int (n (n z 1) 7) z) (n z 5)))
(rat-simplify (rat (int z (n (n z 2) 1)) (n z 7)))
(rat-simplify (rat (int (n (n (n (n z 1) 0) 7) 1) z) (n (n (n z 4) 6) 2)))
(rat-simplify (rat (int (n z 3) (n z 3)) (n z 9)))
(rat-simplify (rat (int (n z 3) z) (n (n (n z 0) 0) 6)))

(solve :expect (region (model)))

(query :goal (rat-simple-of ?x ?s)
       :goal-text "{?x} is {?s}"
       :expect (model (rat-simple-of (rat (int (n z 2) z) (n z 4)) (rat (int (n z 1) z) (n z 2)))
                      (rat-simple-of (rat (int z (n z 6)) (n z 8)) (rat (int z (n z 3)) (n z 4)))
                      (rat-simple-of (rat (int z z) (n z 7)) (rat (int z z) (n z 1)))
                      (rat-simple-of (rat (int (n z 5) z) (n z 1)) (rat (int (n z 5) z) (n z 1)))
                      (rat-simple-of (rat (int (n z 5) (n z 3)) (n z 4)) (rat (int (n z 1) z) (n z 2)))
                      (rat-simple-of (rat (int (n (n z 1) 2) z) (n (n z 1) 8)) (rat (int (n z 2) z) (n z 3)))
                      (rat-simple-of (rat (int (n (n z 1) 7) z) (n z 5)) (rat (int (n (n z 1) 7) z) (n z 5)))
                      (rat-simple-of (rat (int z (n (n z 2) 1)) (n z 7)) (rat (int z (n z 3)) (n z 1)))
                      (rat-simple-of (rat (int (n (n (n (n z 1) 0) 7) 1) z) (n (n (n z 4) 6) 2)) (rat (int (n (n z 5) 1) z) (n (n z 2) 2)))
                      (rat-simple-of (rat (int (n z 3) (n z 3)) (n z 9)) (rat (int z z) (n z 1)))
                      (rat-simple-of (rat (int (n z 3) z) (n (n (n z 0) 0) 6)) (rat (int (n z 1) z) (n z 2)))))
