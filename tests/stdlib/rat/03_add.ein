;;; `std.rat` — addition: the cross products over the product of the
;;; denominators, in lowest terms. M1f S1f.6.8.
;;;
;;; ── What the theory promises ───────────────────────────────────────────────
;;;
;;; `(rat-add X Y)` is answered by `(rat-sum-of X Y S)`, S in lowest terms.
;;;
;;; ── By hand ────────────────────────────────────────────────────────────────
;;;
;;; The operands, one after the other, each denominator compared with zero
;;; (`rat-add-ask`, `rat-operand-second`, `rat-add-start`). For P1 less N1
;;; over D1 and P2 less N2 over D2 the numerator is the cross products, P1 x
;;; D2 + P2 x D1 less N1 x D2 + N2 x D1: four products and two sums of natural
;;; numbers (`rat-cross-first`, `-second`, `-plus`, `-third`, `-fourth`,
;;; `-minus`, `-end`). The denominator is D1 x D2 (`rat-sum-denominator`), and
;;; the whole is put in lowest terms (`rat-sum-norm`, and the chain of
;;; `01_simplify.ein`; `rat-add-answer`).
;;;
;;;   1/2 + 1/3:   1 x 3 + 1 x 2 = 5, over 2 x 3 = 6: 5/6
;;;   1/6 + 1/3:   1 x 3 + 1 x 6 = 9, over 18: 1/2
;;;
;;;    1/2 +  1/3 = 5/6       1/6 + 1/3 = 1/2       -1/2 + 1/3 = -1/6
;;;    1/4 + -3/4 = -1/2     -2/3 + -1/6 = -5/6      5/7 + -5/7 = 0/1
;;;    0/1 +  3/8 = 3/8      7/10 + 13/15 = 47/30
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; `rat-sum-of`'s whole extent, eight requests. No pair is asked both ways
;;; round: a rule that read `(rat-add X Y)` as `(rat-add Y X)` would answer
;;; each such request with the other's fact, and the claim would hold.

(import std.rat :symbols (rat-arith))

(rat-add (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-add (rat (int (n z 1) z) (n z 6)) (rat (int (n z 1) z) (n z 3)))
(rat-add (rat (int z (n z 1)) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-add (rat (int (n z 1) z) (n z 4)) (rat (int z (n z 3)) (n z 4)))
(rat-add (rat (int z (n z 2)) (n z 3)) (rat (int z (n z 1)) (n z 6)))
(rat-add (rat (int (n z 5) z) (n z 7)) (rat (int z (n z 5)) (n z 7)))
(rat-add (rat (int z z) (n z 1)) (rat (int (n z 3) z) (n z 8)))
(rat-add (rat (int (n z 7) z) (n (n z 1) 0)) (rat (int (n (n z 1) 3) z) (n (n z 1) 5)))

(solve :expect (region (model)))

(query :goal (rat-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (rat-sum-of (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)) (rat (int (n z 5) z) (n z 6)))
                      (rat-sum-of (rat (int (n z 1) z) (n z 6)) (rat (int (n z 1) z) (n z 3)) (rat (int (n z 1) z) (n z 2)))
                      (rat-sum-of (rat (int z (n z 1)) (n z 2)) (rat (int (n z 1) z) (n z 3)) (rat (int z (n z 1)) (n z 6)))
                      (rat-sum-of (rat (int (n z 1) z) (n z 4)) (rat (int z (n z 3)) (n z 4)) (rat (int z (n z 1)) (n z 2)))
                      (rat-sum-of (rat (int z (n z 2)) (n z 3)) (rat (int z (n z 1)) (n z 6)) (rat (int z (n z 5)) (n z 6)))
                      (rat-sum-of (rat (int (n z 5) z) (n z 7)) (rat (int z (n z 5)) (n z 7)) (rat (int z z) (n z 1)))
                      (rat-sum-of (rat (int z z) (n z 1)) (rat (int (n z 3) z) (n z 8)) (rat (int (n z 3) z) (n z 8)))
                      (rat-sum-of (rat (int (n z 7) z) (n (n z 1) 0)) (rat (int (n (n z 1) 3) z) (n (n z 1) 5)) (rat (int (n (n z 4) 7) z) (n (n z 3) 0)))))
