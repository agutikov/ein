;;; `std.algebra/converse-illtyped-dom` — a `(converse R1 R2)` whose
;;; `range(R1)` is neither `domain(R2)` nor a subtype of it is ⊥.
;;;
;;; ── What the rule promises ─────────────────────────────────────────────────
;;;
;;; A converse pair is type-valid exactly when R2's signature is R1's reversed:
;;;
;;;     range(R1) = domain(R2)      ← this rule
;;;     domain(R1) = range(R2)      ← `17_converse_illtyped_ran.ein`
;;;
;;; up to the subtype relation handed in as `?isR*`. The signatures are read
;;; straight off the `(relation …)` declarations, which are ordinary facts.
;;;
;;; ── What this program does to it ───────────────────────────────────────────
;;;
;;; `owns : Person → Pet` and `owned-by : Place → Person`. The **range** side
;;; is wrong — `Pet` is not `Place` and is not a subtype of it — and the
;;; **domain** side is right, `Person` on both. So both checks are activated
;;; and exactly one of them can fire, which is what makes the ⊥ attributable.
;;; `17` is the same file with the two errors exchanged.
;;;
;;; `is-a*` is declared and empty on purpose: the `(absent (?isR* Pet Place))`
;;; guard is what a subtype declaration would defeat, so a fixture that wants
;;; the rule to fire must leave the hierarchy with no path between the two
;;; types. This is also why the query names it in `:no-hypothesis` — a
;;; speculated `(is-a* Pet Place)` would make the pair well-typed and the
;;; verdict a model.

(import std.algebra :symbols (converse-illtyped-dom converse-illtyped-ran))

(relation is-a*    T T :why "{?1} is a subtype of {?2}")
(relation owns     Person Pet   :why "{?1} owns {?2}")
(relation owned-by Place  Person)

(converse owns owned-by)
(converse-illtyped-dom owns owned-by is-a*)
(converse-illtyped-ran owns owned-by is-a*)   ; well-typed on its side: silent

(query
  :goal (owns ?who ?what)
  :no-hypothesis (is-a* owns owned-by)
  :expect (false))
