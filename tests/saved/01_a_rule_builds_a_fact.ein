;;; A saved state loads as itself: a rule builds a fact with a fact inside it.
;;;
;;; ── What the program says ──────────────────────────────────────────────────
;;;
;;; One fact, `(item a)`, and a rule that writes a note about every item,
;;; `(note (bad a))`: a fact whose argument is a fact no file writes, put
;;; together by the rule from `?x`. The program states no hypothesis, so R is
;;; root alone.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root, alive, holding the note as `make` derived it. Saved by
;;; `ein solve --dump-answer`, the state is this program and no choice;
;;; loaded, it is root again, the note derived by `make`, one solution, the
;;; same facts with the same origins (Q-M1f.392).

(relation item Thing :why "{?1} is an item")
(relation bad Thing :why "{?1} is bad")
(relation note Fact :why "a note says {?1}")

(item a)

(rule make ()
  :match  (item ?x)
  :assert (note (bad ?x))
  :why    "a note about {?x}")

(solve :no-search :expect (region (model)))

(query :goal (note ?n)
       :goal-text "a note says {?n}"
       :expect (model (note (bad a))))
