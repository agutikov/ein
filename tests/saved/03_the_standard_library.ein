;;; A saved state loads as itself: a rule builds a numeral of the standard
;;; library, and the state carries the modules the program imports.
;;;
;;; ── What the program says ──────────────────────────────────────────────────
;;;
;;; A rule assembles the numeral `(n z x)` from a letter, `x`, which is no
;;; digit, and a request adds two numerals. `std.math.decimal` checks a
;;; numeral where an operation takes it, so the assembled one, which no
;;; operation takes, is not flagged (Q-M1f.404).
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is {∅}: root, alive, holding the reading and the sum. Saved by
;;; `ein solve --dump-answer`, the state is this program and the three modules
;;; its imports read, each as written, and no choice; loaded, it reads no
;;; other file, and is root again, the reading derived by `assemble` and the
;;; sum by the module's rules (Q-M1f.392, Q-M1f.401).

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation digit-read Thing :why "the digit read is {?3}")
(relation reading Thing :why "the reading is {?3}")

(digit-read x)
(add (n z 4) (n z 3))

(rule assemble ()
  :match  (digit-read ?d)
  :assert (reading (n z ?d))
  :why    "the reading is the numeral of {?d}")

(solve :no-search :expect (region (model)))

(query :goal (reading ?r)
       :goal-text "the reading is {?r}"
       :expect (model (reading (n z x))))

(query :goal (sum-of (n z 4) (n z 3) ?s)
       :goal-text "4 + 3 = {?s}"
       :expect (model (sum-of (n z 4) (n z 3) (n z 7))))
