;;; ein-saved/1 — the program and every module it imports, each as written, and the choices made: this file reads no other.
(program
;;; A saved state loads as itself: the state rests on a choice, and the
;;; choice has a fact inside it.
;;;
;;; ── What the program says ──────────────────────────────────────────────────
;;;
;;; `01_a_rule_builds_a_fact.ein` with the note supposed instead of made: an
;;; hrule proposes `(note (bad a))`, so the state that holds it rests on a
;;; commitment of one candidate, and a rule reads the note it holds.
;;;
;;; ── What the expectation means ─────────────────────────────────────────────
;;;
;;; R is two states: root, and `{(note (bad a))}`, where `flag` derives
;;; `(flagged a)` from the note. Saved by `ein solve --dump-answer`, the second
;;; is this program and `(commit (note (bad a)))`; loaded, the choice is
;;; committed after root's fixpoint as the run committed it, and `(flagged a)`
;;; derived again by `flag` (Q-M1f.392, Q-M1f.400).

(relation item Thing :why "{?3} is an item")
(relation bad Thing :why "{?3} is bad")
(relation note Fact :why "a note says {?3}")
(relation flagged Thing :why "{?3} is flagged")

(item a)

(hrule guess ()
  :match  (item ?x)
  :assert (note (bad ?x))
  :why    "suppose a note about {?x}")

(rule flag ()
  :match  (note (bad ?x))
  :assert (flagged ?x)
  :why    "a note says {?x} is bad, so {?x} is flagged")

(solve :expect (region (model) (model (note (bad a)))))

(query :goal (flagged ?x)
       :goal-text "{?x} is flagged"
       :expect (or (model) (model (flagged a))))

)
(commit
  (note (bad a)))
