;;; REGION CLAIM — (merged …) with one minimal commitment per state.
;;; M1e2 S1e2.1a.4.
;;;
;;; A brings B and C brings D; an obligation needs one of A or C, and A with C
;;; is dead, so ∅ is not in R. Every state is reached by exactly two
;;; commitments, its minimal one and that one plus the fact it brings, so every
;;; state carries a (merged …) whose <from> is a single (model …). With every
;;; (merged …) listed, the claim pins k_c = 16 as well as k_s = 8.
;;; The program is examples/lattice/synth/merged_states.ein's.

(relation h T :why "h holds of {?1}")
(relation slot T :why "{?1} is a slot")
(relation world T :why "{?1} is the world")
(relation need T T :why "h of {?2} would meet the need {?1}")
(world W)
(slot A) (slot B) (slot C) (slot D) (slot E)
(need K1 A) (need K1 C)
(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess that h holds of the slot {?x}")
(rule imp-A-B () :match (h A) :assert (h B) :why "h holds of A, so h holds of B")
(rule imp-C-D () :match (h C) :assert (h D) :why "h holds of C, so h holds of D")
(rule dead-1 () :match (and (h A) (h C)) :assert (false) :why "h holds of both A and C, which cannot be")
(rule owe-1 ()
  :match  (and (world ?w) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "h holds of nothing that meets the need K1 — one is still owed")

(solve
  :expect (region
            ;; state 1 — on the minimal line
            (model (h A) (h B))
            ;; state 2 — on the minimal line
            (model (h C) (h D))
            ;; state 3
            (model (h B) (h C) (h D))
            ;; state 4
            (model (h A) (h B) (h D))
            ;; state 5
            (model (h A) (h B) (h E))
            ;; state 6
            (model (h C) (h D) (h E))
            ;; state 7 — on the maximal line
            (model (h B) (h C) (h D) (h E))
            ;; state 8 — on the maximal line
            (model (h A) (h B) (h D) (h E))
            ;; state 1 is reached by 2 commitments; its minimal one
            (merged (model (h A) (h B))
                    (model (h A)))
            ;; state 2 is reached by 2 commitments; its minimal one
            (merged (model (h C) (h D))
                    (model (h C)))
            ;; state 3 is reached by 2 commitments; its minimal one
            (merged (model (h B) (h C) (h D))
                    (model (h B) (h C)))
            ;; state 4 is reached by 2 commitments; its minimal one
            (merged (model (h A) (h B) (h D))
                    (model (h A) (h D)))
            ;; state 5 is reached by 2 commitments; its minimal one
            (merged (model (h A) (h B) (h E))
                    (model (h A) (h E)))
            ;; state 6 is reached by 2 commitments; its minimal one
            (merged (model (h C) (h D) (h E))
                    (model (h C) (h E)))
            ;; state 7 is reached by 2 commitments; its minimal one
            (merged (model (h B) (h C) (h D) (h E))
                    (model (h B) (h C) (h E)))
            ;; state 8 is reached by 2 commitments; its minimal one
            (merged (model (h A) (h B) (h D) (h E))
                    (model (h A) (h D) (h E)))))

(query :goal (h ?x))
