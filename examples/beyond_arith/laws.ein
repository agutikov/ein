;;; The laws of arithmetic, checked on every instance over the numbers 0 to 3:
;;; commutativity of + and times (16 pairs each), associativity of each and
;;; distributivity (64 triples each), and the division identity, x = q times
;;; y + r with r less than y, for the 16 dividends written with two of the
;;; digits and the divisors 1, 2 and 3. Saturation alone, no hypothesis.
;;;
;;; For each instance `std.math.decimal-arith` computes both sides; `holds2` and `holds3`
;;; say they agree, `fails2` and `fails3` that they do not, and the two
;;; claims are that nothing fails. It is a proof for this domain and no
;;; further: Ein has no way to say "for every number".
;;;
;;; The checks are written the way the theory itself is: each is a chain of
;;; the theory's tagged calls, `(add-walk TAG X Y 0 z)` and `(mul-call TAG X
;;; Y)` answered by `(done TAG ANSWER)`, `(div-call TAG X Y)` by `(div-done
;;; TAG Q R)`, `(cmp-walk TAG X Y eq)` by `(order-is TAG ORDER)`. A rule has
;;; one premise and reads what it needs out of the tag, so no rule joins two
;;; facts on a number.
;;;
;;; M1f P1f.6 (S1f.6.10): `plans/…/p1f.6_calculator/beyond_arithmetic.md` has
;;; the probe this program was banked from, its cost and what it shows.
(import std.math.decimal-arith :symbols (decimal-arith n add-walk mul-call done div-call div-done cmp-walk order-is))
(import std.math.digits :symbols (nz))

(relation digit Digit :why "{?1} is a digit")
(relation d Number :why "{?1} is in the domain")
(relation dd Number :why "{?1} is a dividend of the domain")
(relation dv Number :why "{?1} is a divisor of the domain")
(relation holds2 Law Number Number :why "{?1} holds of {?2} and {?3}")
(relation holds3 Law Number Number Number :why "{?1} holds of {?2}, {?3} and {?4}")
(relation fails2 Law Number Number :why "{?1} FAILS of {?2} and {?3}")
(relation fails3 Law Number Number Number :why "{?1} FAILS of {?2}, {?3} and {?4}")
(relation same Number Number :why "the quotient times {?2} plus the remainder is {?1} again")
(relation less Number Number :why "the remainder of {?1} by {?2} is less than {?2}")
;; The tags of this program's calls: what an answer is for.
(relation ca Number Number :why "{?1} + {?2}")
(relation cb Number Number Number :why "{?2} + {?1}, to set against {?3}")
(relation ma Number Number :why "{?1} times {?2}")
(relation mb Number Number Number :why "{?2} times {?1}, to set against {?3}")
(relation aa1 Number Number Number :why "{?1} + {?2}, before {?3} is added")
(relation aa2 Number Number Number :why "({?1} + {?2}) + {?3}")
(relation aa3 Number Number Number Number :why "{?2} + {?3}, before it is added to {?1}")
(relation aa4 Number Number Number Number :why "{?1} + ({?2} + {?3}), to set against {?4}")
(relation am1 Number Number Number :why "{?1} times {?2}, before {?3}")
(relation am2 Number Number Number :why "({?1} times {?2}) times {?3}")
(relation am3 Number Number Number Number :why "{?2} times {?3}, before {?1}")
(relation am4 Number Number Number Number :why "{?1} times ({?2} times {?3}), to set against {?4}")
(relation di1 Number Number Number :why "{?2} + {?3}, before {?1} multiplies it")
(relation di2 Number Number Number :why "{?1} times ({?2} + {?3})")
(relation di3 Number Number Number Number :why "{?1} times {?2}")
(relation di4 Number Number Number Number Number :why "{?1} times {?3}")
(relation di5 Number Number Number Number :why "{?1} times {?2} + {?1} times {?3}, to set against {?4}")
(relation id Number Number :why "{?1} divided by {?2}")
(relation id-back Number Number Number :why "the quotient of {?1} by {?2}, times {?2}")
(relation id-sum Number Number :why "that product plus the remainder")
(relation id-same Number Number :why "is it {?1} again?")
(relation id-less Number Number :why "is the remainder less than {?2}?")
(__closed__ digit) (__closed__ d) (__closed__ dd) (__closed__ dv) (__closed__ same) (__closed__ less)
(__closed__ holds2) (__closed__ holds3) (__closed__ fails2) (__closed__ fails3)
(__closed__ ca) (__closed__ cb) (__closed__ ma) (__closed__ mb) (__closed__ aa1) (__closed__ aa2) (__closed__ aa3)
(__closed__ aa4) (__closed__ am1) (__closed__ am2) (__closed__ am3) (__closed__ am4) (__closed__ di1) (__closed__ di2)
(__closed__ di3) (__closed__ di4) (__closed__ di5) (__closed__ id) (__closed__ id-back) (__closed__ id-sum)
(__closed__ id-same) (__closed__ id-less)
(digit 0) (digit 1) (digit 2) (digit 3)

(rule domain ()
  :match  (and (digit ?a0))
  :assert (d (n z ?a0))
  :why    "(n z ?a0) is a number of the domain")

;; ── commutativity: x + y = y + x, and x times y = y times x ──
(rule commute-ask ()
  :match  (and (d ?x) (d ?y))
  :assert (and (add-walk (ca ?x ?y) ?x ?y 0 z) (mul-call (ma ?x ?y) ?x ?y))
  :why    "ask {?x} + {?y} and {?x} times {?y}")
(rule commute-add-back ()
  :match  (done (ca ?x ?y) ?s)
  :assert (add-walk (cb ?x ?y ?s) ?y ?x 0 z)
  :why    "{?x} + {?y} is {?s}: now ask {?y} + {?x}")
(rule add-commutes ()
  :match  (done (cb ?x ?y ?s) ?s)
  :assert (holds2 add-commutes ?x ?y)
  :why    "{?x} + {?y} and {?y} + {?x} are both {?s}")
(rule add-commutes-not ()
  :match  (and (done (cb ?x ?y ?s) ?t) (neq ?s ?t))
  :assert (fails2 add-commutes ?x ?y)
  :why    "{?x} + {?y} is {?s} and {?y} + {?x} is {?t}")
(rule commute-mul-back ()
  :match  (done (ma ?x ?y) ?p)
  :assert (mul-call (mb ?x ?y ?p) ?y ?x)
  :why    "{?x} times {?y} is {?p}: now ask {?y} times {?x}")
(rule mul-commutes ()
  :match  (done (mb ?x ?y ?p) ?p)
  :assert (holds2 mul-commutes ?x ?y)
  :why    "{?x} times {?y} and {?y} times {?x} are both {?p}")
(rule mul-commutes-not ()
  :match  (and (done (mb ?x ?y ?p) ?q) (neq ?p ?q))
  :assert (fails2 mul-commutes ?x ?y)
  :why    "{?x} times {?y} is {?p} and {?y} times {?x} is {?q}")

;; ── associativity: (x + y) + w = x + (y + w) ──
(rule add-associates-ask ()
  :match  (and (d ?x) (d ?y) (d ?w))
  :assert (add-walk (aa1 ?x ?y ?w) ?x ?y 0 z)
  :why    "ask {?x} + {?y}")
(rule add-associates-left ()
  :match  (done (aa1 ?x ?y ?w) ?s)
  :assert (add-walk (aa2 ?x ?y ?w) ?s ?w 0 z)
  :why    "{?x} + {?y} is {?s}: ask {?s} + {?w}")
(rule add-associates-inner ()
  :match  (done (aa2 ?x ?y ?w) ?u)
  :assert (add-walk (aa3 ?x ?y ?w ?u) ?y ?w 0 z)
  :why    "the left side is {?u}: ask {?y} + {?w}")
(rule add-associates-right ()
  :match  (done (aa3 ?x ?y ?w ?u) ?v)
  :assert (add-walk (aa4 ?x ?y ?w ?u) ?x ?v 0 z)
  :why    "{?y} + {?w} is {?v}: ask {?x} + {?v}")
(rule add-associates ()
  :match  (done (aa4 ?x ?y ?w ?u) ?u)
  :assert (holds3 add-associates ?x ?y ?w)
  :why    "({?x} + {?y}) + {?w} and {?x} + ({?y} + {?w}) are both {?u}")
(rule add-associates-not ()
  :match  (and (done (aa4 ?x ?y ?w ?u) ?v) (neq ?u ?v))
  :assert (fails3 add-associates ?x ?y ?w)
  :why    "({?x} + {?y}) + {?w} is {?u} and {?x} + ({?y} + {?w}) is {?v}")

;; ── associativity: (x times y) times w = x times (y times w) ──
(rule mul-associates-ask ()
  :match  (and (d ?x) (d ?y) (d ?w))
  :assert (mul-call (am1 ?x ?y ?w) ?x ?y)
  :why    "ask {?x} times {?y}")
(rule mul-associates-left ()
  :match  (done (am1 ?x ?y ?w) ?s)
  :assert (mul-call (am2 ?x ?y ?w) ?s ?w)
  :why    "{?x} times {?y} is {?s}: ask {?s} times {?w}")
(rule mul-associates-inner ()
  :match  (done (am2 ?x ?y ?w) ?u)
  :assert (mul-call (am3 ?x ?y ?w ?u) ?y ?w)
  :why    "the left side is {?u}: ask {?y} times {?w}")
(rule mul-associates-right ()
  :match  (done (am3 ?x ?y ?w ?u) ?v)
  :assert (mul-call (am4 ?x ?y ?w ?u) ?x ?v)
  :why    "{?y} times {?w} is {?v}: ask {?x} times {?v}")
(rule mul-associates ()
  :match  (done (am4 ?x ?y ?w ?u) ?u)
  :assert (holds3 mul-associates ?x ?y ?w)
  :why    "({?x} times {?y}) times {?w} and {?x} times ({?y} times {?w}) are both {?u}")
(rule mul-associates-not ()
  :match  (and (done (am4 ?x ?y ?w ?u) ?v) (neq ?u ?v))
  :assert (fails3 mul-associates ?x ?y ?w)
  :why    "({?x} times {?y}) times {?w} is {?u} and {?x} times ({?y} times {?w}) is {?v}")

;; ── distributivity: x times (y + w) = x times y + x times w ──
(rule distributes-ask ()
  :match  (and (d ?x) (d ?y) (d ?w))
  :assert (add-walk (di1 ?x ?y ?w) ?y ?w 0 z)
  :why    "ask {?y} + {?w}")
(rule distributes-left ()
  :match  (done (di1 ?x ?y ?w) ?t)
  :assert (mul-call (di2 ?x ?y ?w) ?x ?t)
  :why    "{?y} + {?w} is {?t}: ask {?x} times {?t}")
(rule distributes-first ()
  :match  (done (di2 ?x ?y ?w) ?u)
  :assert (mul-call (di3 ?x ?y ?w ?u) ?x ?y)
  :why    "the left side is {?u}: ask {?x} times {?y}")
(rule distributes-second ()
  :match  (done (di3 ?x ?y ?w ?u) ?p)
  :assert (mul-call (di4 ?x ?y ?w ?u ?p) ?x ?w)
  :why    "{?x} times {?y} is {?p}: ask {?x} times {?w}")
(rule distributes-right ()
  :match  (done (di4 ?x ?y ?w ?u ?p) ?q)
  :assert (add-walk (di5 ?x ?y ?w ?u) ?p ?q 0 z)
  :why    "{?x} times {?w} is {?q}: ask {?p} + {?q}")
(rule distributes ()
  :match  (done (di5 ?x ?y ?w ?u) ?u)
  :assert (holds3 distributes ?x ?y ?w)
  :why    "{?x} times ({?y} + {?w}) and {?x} times {?y} + {?x} times {?w} are both {?u}")
(rule distributes-not ()
  :match  (and (done (di5 ?x ?y ?w ?u) ?v) (neq ?u ?v))
  :assert (fails3 distributes ?x ?y ?w)
  :why    "{?x} times ({?y} + {?w}) is {?u} and {?x} times {?y} + {?x} times {?w} is {?v}")

;; ── the division identity: x = q times y + r, and r is less than y ──
(rule dividends ()
  :match  (and (digit ?a0) (digit ?a1))
  :assert (dd (n (n z ?a0) ?a1))
  :why    "(n (n z ?a0) ?a1) is a dividend")
(rule divisors ()
  :match  (and (digit ?a0) (nz ?a0))
  :assert (dv (n z ?a0))
  :why    "(n z ?a0) does not begin with zero: a divisor")
(rule divide-ask ()
  :match  (and (dd ?x) (dv ?y))
  :assert (div-call (id ?x ?y) ?x ?y)
  :why    "ask {?x} divided by {?y}")
(rule divide-back ()
  :match  (div-done (id ?x ?y) ?q ?r)
  :assert (and (mul-call (id-back ?x ?y ?r) ?q ?y) (cmp-walk (id-less ?x ?y) ?r ?y eq))
  :why    "{?x} divided by {?y} is {?q}, remainder {?r}: ask {?q} times {?y}, and {?r} against {?y}")
(rule divide-back-sum ()
  :match  (done (id-back ?x ?y ?r) ?p)
  :assert (add-walk (id-sum ?x ?y) ?p ?r 0 z)
  :why    "the quotient times {?y} is {?p}: ask {?p} + {?r}")
(rule divide-back-same ()
  :match  (done (id-sum ?x ?y) ?s)
  :assert (cmp-walk (id-same ?x ?y) ?s ?x eq)
  :why    "that is {?s}: is it {?x}?")
(rule divide-same ()
  :match  (order-is (id-same ?x ?y) eq)
  :assert (same ?x ?y)
  :why    "the quotient times {?y} plus the remainder is {?x}")
(rule divide-less ()
  :match  (order-is (id-less ?x ?y) lt)
  :assert (less ?x ?y)
  :why    "the remainder is less than {?y}")
(rule division-identity ()
  :match  (and (same ?x ?y) (less ?x ?y))
  :assert (holds2 division-identity ?x ?y)
  :why    "{?x} is its quotient by {?y} times {?y} plus a remainder less than {?y}")
(rule division-identity-not-same ()
  :match  (and (order-is (id-same ?x ?y) ?o) (neq ?o eq))
  :assert (fails2 division-identity ?x ?y)
  :why    "the quotient of {?x} by {?y} times {?y} plus the remainder is not {?x}")
(rule division-identity-not-less ()
  :match  (and (order-is (id-less ?x ?y) ?o) (neq ?o lt))
  :assert (fails2 division-identity ?x ?y)
  :why    "the remainder of {?x} by {?y} is not less than {?y}")

(query :goal (fails2 ?law ?x ?y)
       :goal-text "{?law} fails of {?x} and {?y}"
       :expect (model))
(query :goal (fails3 ?law ?x ?y ?w)
       :goal-text "{?law} fails of {?x}, {?y} and {?w}"
       :expect (model))
