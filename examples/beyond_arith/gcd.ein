;;; The greatest common divisor by Euclid's chain, and the least common
;;; multiple from it: gcd(a, b) is gcd(b, a mod b), and gcd(a, 0) is a; the
;;; lcm is a x b divided by the gcd. Saturation alone.
;;; M1f P1f.6 (S1f.6.10): `plans/…/p1f.6_calculator/beyond_arithmetic.md` has
;;; the probe this program was banked from, its cost and what it shows.
;;;
;;; Since S1f.6.32 the six rules this program wrote over `std.math.decimal-arith`'s
;;; tagged division are `std.math.gcd`'s (P1f.6's question 38, the user's
;;; *"(a) but not into std.arith"*): `(gcd X Y)` answered by `(gcd-of X Y G)`,
;;; `(lcm X Y)` by `(lcm-of X Y L)`. The claims are the ones the six rules
;;; held, each pair now asked for both.
(import std.math.gcd :symbols (gcd lcm gcd-of lcm-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(gcd (n (n (n (n z 1) 0) 7) 1) (n (n (n z 4) 6) 2))
(gcd (n (n z 4) 8) (n (n z 1) 8))
(gcd (n (n z 1) 7) (n z 5))
(lcm (n (n (n (n z 1) 0) 7) 1) (n (n (n z 4) 6) 2))
(lcm (n (n z 4) 8) (n (n z 1) 8))
(lcm (n (n z 1) 7) (n z 5))

(query :goal (gcd-of ?a ?b ?g) :goal-text "gcd({?a}, {?b}) = {?g}"
       :expect (model (gcd-of (n (n (n (n z 1) 0) 7) 1) (n (n (n z 4) 6) 2) (n (n z 2) 1))
                      (gcd-of (n (n z 1) 7) (n z 5) (n z 1))
                      (gcd-of (n (n z 4) 8) (n (n z 1) 8) (n z 6))))
(query :goal (lcm-of ?a ?b ?l) :goal-text "lcm({?a}, {?b}) = {?l}"
       :expect (model (lcm-of (n (n (n (n z 1) 0) 7) 1)
                              (n (n (n z 4) 6) 2)
                              (n (n (n (n (n z 2) 3) 5) 6) 2))
                      (lcm-of (n (n z 1) 7) (n z 5) (n (n z 8) 5))
                      (lcm-of (n (n z 4) 8) (n (n z 1) 8) (n (n (n z 1) 4) 4))))
