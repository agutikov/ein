;;; Perfect numbers from 1 to 12: a number that is the sum of its proper
;;; divisors. For each n every k below n is tried, one division each, and
;;; the divisors are added up as they are found; the sum is then set against
;;; n: `eq` perfect, `lt` deficient, `gt` abundant. Saturation alone.
;;; M1f P1f.6 (S1f.6.10): `plans/…/p1f.6_calculator/beyond_arithmetic.md` has
;;; the probe this program was banked from, its cost and what it shows.
(import std.math.decimal-arith :symbols (decimal-arith cmp-walk order-is add-walk done div-call div-done))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation count Number Number :why "counting: {?1}, on the way to {?2}")
(relation cnt Number Number :why "is {?1} below {?2}?")
(relation cnt-next Number :why "the number after, on the way to {?1}")
(relation sg Number Number Number :why "the proper divisors of {?1} below {?2} add up to {?3}")
(relation sg-at Number Number Number :why "is {?2} below {?1}? (sum so far {?3})")
(relation sg-div Number Number Number :why "{?1} divided by {?2} (sum so far {?3})")
(relation sg-add Number Number :why "the divisor {?2} of {?1} added to the sum")
(relation sg-next Number Number :why "the next number to try on {?1} (sum so far {?2})")
(relation sg-verdict Number Number :why "{?2}, the sum of {?1}'s proper divisors, against {?1}")
(relation aliquot Number Number Order :why "the proper divisors of {?1} add up to {?2}, which is {?3} it")
(__closed__ count) (__closed__ cnt) (__closed__ cnt-next) (__closed__ sg) (__closed__ sg-at) (__closed__ sg-div)
(__closed__ sg-add) (__closed__ sg-next) (__closed__ sg-verdict) (__closed__ aliquot)

(count (n z 1) (n (n z 1) 2))

;; Counting: (count K M) for K from the first to M, a comparison and an addition a step.
(rule count-ask ()
  :match  (count ?k ?m)
  :assert (cmp-walk (cnt ?k ?m) ?k ?m eq)
  :why    "is {?k} below {?m}?")
(rule count-on ()
  :match  (order-is (cnt ?k ?m) lt)
  :assert (add-walk (cnt-next ?m) ?k (n z 1) 0 z)
  :why    "{?k} is below {?m}: ask {?k} + 1")
(rule count-next ()
  :match  (done (cnt-next ?m) ?k)
  :assert (count ?k ?m)
  :why    "the next number is {?k}")

(rule sigma-start ()
  :match  (count ?n ?m)
  :assert (sg ?n (n z 1) z)
  :why    "add up the proper divisors of {?n}, from 1")
(rule sigma-ask ()
  :match  (sg ?n ?k ?s)
  :assert (cmp-walk (sg-at ?n ?k ?s) ?k ?n eq)
  :why    "is {?k} below {?n}?")
(rule sigma-divide ()
  :match  (order-is (sg-at ?n ?k ?s) lt)
  :assert (div-call (sg-div ?n ?k ?s) ?n ?k)
  :why    "it is: ask {?n} divided by {?k}")
(rule sigma-divisor ()
  :match  (div-done (sg-div ?n ?k ?s) ?q z)
  :assert (add-walk (sg-add ?n ?k) ?s ?k 0 z)
  :why    "{?k} divides {?n}: add it to {?s}")
(rule sigma-added ()
  :match  (done (sg-add ?n ?k) ?s)
  :assert (add-walk (sg-next ?n ?s) ?k (n z 1) 0 z)
  :why    "the sum is now {?s}")
(rule sigma-no-divisor ()
  :match  (div-done (sg-div ?n ?k ?s) ?q (n ?p ?a))
  :assert (add-walk (sg-next ?n ?s) ?k (n z 1) 0 z)
  :why    "{?k} does not divide {?n}")
(rule sigma-next ()
  :match  (done (sg-next ?n ?s) ?k)
  :assert (sg ?n ?k ?s)
  :why    "now try {?k}")
(rule sigma-end ()
  :match  (order-is (sg-at ?n ?k ?s) eq)
  :assert (cmp-walk (sg-verdict ?n ?s) ?s ?n eq)
  :why    "every number below {?n} is tried: set the sum {?s} against {?n}")
(rule sigma-verdict ()
  :match  (order-is (sg-verdict ?n ?s) ?o)
  :assert (aliquot ?n ?s ?o)
  :why    "the proper divisors of {?n} add up to {?s}")

(query :goal (aliquot ?n ?s eq) :goal-text "{?n} is perfect"
       :expect (model (aliquot (n z 6) (n z 6) eq)))
