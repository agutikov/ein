;;; The 3n + 1 trajectory, stopped after 20 steps: halve an even number,
;;; triple an odd one and add 1, until 1 is reached. Whether every number
;;; reaches 1 is an open problem, so the request carries a bound on the
;;; steps: saturation must end, and a rule set that might not is given a
;;; bound it can count to. Saturation alone.
;;; M1f P1f.6 (S1f.6.10): `plans/…/p1f.6_calculator/beyond_arithmetic.md` has
;;; the probe this program was banked from, its cost and what it shows.
(import std.arith :symbols (arith))

(relation collatz Number Number :why "asked: the trajectory of {?1}, at most {?2} steps")
(relation cz Tag Number Number :why "for {?1}: at {?2} after {?3} steps")
(relation cz-at Tag Number Number :why "is {?2} above 1? ({?3} steps so far)")
(relation cz-fuel Tag Number Number :why "are {?3} steps below the bound?")
(relation cz-half Tag Number Number :why "{?2} divided by 2")
(relation cz-triple Tag Number :why "three times an odd number, after {?2} steps")
(relation cz-plus Tag Number :why "and one more, after {?2} steps")
(relation cz-count Tag Number :why "one more step, arriving at {?2}")
(relation collatz-of Number Number Number :why "{?1} reaches 1 after {?3} steps (bound {?2})")
(relation collatz-stopped Number Number Number :why "{?1} had not reached 1 after {?2} steps: it was at {?3}")
(__closed__ collatz) (__closed__ cz) (__closed__ cz-at) (__closed__ cz-fuel) (__closed__ cz-half) (__closed__ cz-triple)
(__closed__ cz-plus) (__closed__ cz-count) (__closed__ collatz-of) (__closed__ collatz-stopped)

(collatz (n z 7) (n (n z 2) 0))
(collatz (n (n z 2) 7) (n (n z 2) 0))

(rule collatz-start ()
  :match  (collatz ?n ?b)
  :assert (cz (collatz ?n ?b) ?n z)
  :why    "start at {?n}")
(rule collatz-look ()
  :match  (cz ?t ?m ?s)
  :assert (cmp-walk (cz-at ?t ?m ?s) ?m (n z 1) eq)
  :why    "is {?m} above 1?")
(rule collatz-arrived ()
  :match  (order-is (cz-at (collatz ?n ?b) ?m ?s) eq)
  :assert (collatz-of ?n ?b ?s)
  :why    "{?n} has reached 1 after {?s} steps")
(rule collatz-bound ()
  :match  (order-is (cz-at (collatz ?n ?b) ?m ?s) gt)
  :assert (cmp-walk (cz-fuel (collatz ?n ?b) ?m ?s) ?s ?b eq)
  :why    "{?m} is above 1: are {?s} steps still below the bound {?b}?")
(rule collatz-stop ()
  :match  (order-is (cz-fuel (collatz ?n ?b) ?m ?s) eq)
  :assert (collatz-stopped ?n ?b ?m)
  :why    "the bound is reached at {?m}")
(rule collatz-halve ()
  :match  (order-is (cz-fuel ?t ?m ?s) lt)
  :assert (div-call (cz-half ?t ?m ?s) ?m (n z 2))
  :why    "ask {?m} divided by 2")
(rule collatz-even ()
  :match  (div-done (cz-half ?t ?m ?s) ?q z)
  :assert (add-walk (cz-count ?t ?q) ?s (n z 1) 0 z)
  :why    "{?m} is even: go to its half, {?q}")
(rule collatz-odd ()
  :match  (div-done (cz-half ?t ?m ?s) ?q (n z 1))
  :assert (mul-call (cz-triple ?t ?s) ?m (n z 3))
  :why    "{?m} is odd: ask three times {?m}")
(rule collatz-odd-plus ()
  :match  (done (cz-triple ?t ?s) ?p)
  :assert (add-walk (cz-plus ?t ?s) ?p (n z 1) 0 z)
  :why    "three times is {?p}: add 1")
(rule collatz-odd-go ()
  :match  (done (cz-plus ?t ?s) ?m)
  :assert (add-walk (cz-count ?t ?m) ?s (n z 1) 0 z)
  :why    "go to {?m}")
(rule collatz-step ()
  :match  (done (cz-count ?t ?m) ?s)
  :assert (cz ?t ?m ?s)
  :why    "step {?s}: at {?m}")

(query :goal (collatz-of ?n ?b ?s) :goal-text "{?n} reaches 1 after {?s} steps"
       :expect (model (collatz-of (n z 7) (n (n z 2) 0) (n (n z 1) 6))))
(query :goal (collatz-stopped ?n ?b ?m) :goal-text "{?n} had not reached 1 after {?b} steps: it was at {?m}"
       :expect (model (collatz-stopped (n (n z 2) 7) (n (n z 2) 0) (n (n (n z 2) 7) 4))))
