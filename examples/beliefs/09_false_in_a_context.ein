;;; 09_false_in_a_context — a contradiction inside a context stays there.
;;;
;;; Ann thinks that five is two plus two, and thinks that it is not. Bob says
;;; that he likes Carol, and says that he does not. Neither contradicts
;;; anything the state holds: a fact held with its negation is a
;;; contradiction, and these four stand only under the arrows of `think` and
;;; `says`.
;;;
;;; What a contradiction inside a context means is a rule's to say.
;;; `contradicts` says it for any context of two arguments and any fact of
;;; two, both relations parameters, an activator a pair: where the context
;;; speaks of a fact and of its negation, it concludes `(false)` **in that
;;; context**, `(think Ann (false))`. That is a fact of `think` which points
;;; at `(false)`; the state does not hold `(false)` and is alive.
;;;
;;; A rule reads such a fact as it reads any: `muddled` names who contradicts
;;; themself, in thought or in speech. And `everybody-muddled` would conclude
;;; the state's own `(false)` if every person did, a `forall` over `person`,
;;; whose people `(__closed__ person)` says are these three. Cy thinks one
;;; thing and says nothing, so it does not fire.
;;; `10_everybody_contradicts.ein` is this program with Cy muddled too.

(import std.macro :symbols (forall))

(relation person  Person       :why "{?1} is a person")
(relation think   Person Claim :why "{?1} thinks that {?2}")
(relation says    Person Claim :why "{?1} says that {?2}")
(relation muddled Person       :why "{?1} contradicts themself")

(person Ann)
(person Bob)
(person Cy)
(__closed__ person)   ; the people are exactly these three

(think Ann (= 5 (+ 2 2)))
(think Ann (not (= 5 (+ 2 2))))
(says Bob (likes Bob Carol))
(says Bob (not (likes Bob Carol)))
(think Cy (= 4 (+ 2 2)))

(rule contradicts (?C ?R)
  :match  (and (?C ?p (?R ?a ?b)) (?C ?p (not (?R ?a ?b))))
  :assert (?C ?p (false))
  :why    "{?p}: both that {?a} {?R} {?b} and that it is not so")
(contradicts think =)
(contradicts says likes)

(rule muddled-in (?C)
  :match  (?C ?p (false))
  :assert (muddled ?p)
  :why    "what {?p} holds is contradictory")
(muddled-in think)
(muddled-in says)

(rule everybody-muddled ()
  :match  (forall ?p (person ?p) (muddled ?p))
  :assert (false)
  :why    "every person contradicts themself")

(solve :no-search)

(query :goal (think ?p (false))
  :expect (model (think Ann (false))))
(query :goal (says ?p (false))
  :expect (model (says Bob (false))))
(query :goal (muddled ?p)
  :expect (model (muddled Ann) (muddled Bob)))
