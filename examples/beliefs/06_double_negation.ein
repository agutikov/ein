;;; 06_double_negation — the elimination of a double negation, as a rule.
;;;
;;; The negation of a negation is a fact, and it says only that a denial does
;;; not hold. That the fact itself then holds, *not not g, so g*, is a step
;;; of classical logic and **a rule a program asks for**, not something the
;;; language does by itself. This program asks for it:
;;;
;;; - **`eliminate-2`** is the standard library's rule for facts of two
;;;   arguments, `std.negation`'s, the relation a parameter: a rule concludes
;;;   a fact with its relation and its count written, so "any fact" is one
;;;   rule a count, and an activator a relation. `(eliminate-2 =)` turns it
;;;   on for `=` and nothing turns it on for `likes`.
;;; - **`eliminate-in`** is the same rule for what somebody thinks, written
;;;   here: the same patterns, each under `(think ?p …)`. It concludes a fact
;;;   Bob thinks, and nothing about the world. The library's rule reads a
;;;   double negation the state holds, and a context is a program's own.
;;;
;;; So `(= 5 (+ 2 2))` is concluded; `(likes Dan Soup)` is not, though its
;;; double negation is held just the same; and Bob thinks `(= 7 (+ 3 4))`,
;;; which the state does not hold.

(import std.negation :symbols (eliminate-2))

(relation =     Thing Thing  :why "{?3} is {?4}")
(relation likes Person Food  :why "{?3} likes {?4}")
(relation think Person Claim :why "{?3} thinks that {?4}")

(not (not (= 5 (+ 2 2))))
(not (not (likes Dan Soup)))
(think Bob (not (not (= 7 (+ 3 4)))))

(eliminate-2 =)

(rule eliminate-in (?R)
  :match  (think ?p (not (not (?R ?a ?b))))
  :assert (think ?p (?R ?a ?b))
  :why    "{?p} thinks it is not so that {?a} {?R} {?b} is not so")
(eliminate-in =)

(solve :no-search)

(query :goal (= ?a ?b)
  :expect (model (= 5 (+ 2 2))))
(query :goal (likes ?p ?f)
  :expect (model))
(query :goal (think Bob (= ?a ?b))
  :expect (model (think Bob (= 7 (+ 3 4)))))
