;;; S1.5b.32 fixture — hypothesis exploration ONLY (pathway B isolated).
;;; The "B-only" measurement row: the domain/range-elimination rules
;;; (and their derive-* activators) are removed, so no positive is
;;; ever asserted by saturation. The survivor must be found by
;;; forking on each candidate and refuting the rest.
;;;
;;; Identical to ab.ein minus pathway A. Goal: (color-loc Blue ?h),
;;; answer ?h = H1.

;; ── Bijection property expansion: (bijective R) ⟹ the four markers.
(rule bijective-properties ()
  :match  (bijective ?R)
  :assert (and (functional ?R) (injective ?R) (total ?R) (surjective ?R))
  :why    "{?R} is bijective ⟹ functional ∧ injective ∧ total ∧ surjective.")

;; ── Violation rules: fire (false) when uniqueness breaks.
;;    These are what refute the wrong branches under pathway B.
(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why "{?R} not functional: {?a} has both {?b} and {?c}.")
(rule injective (?R)
  :match  (and (?R ?a ?c) (?R ?b ?c) (neq ?a ?b))
  :assert (false)
  :why "{?R} not injective: {?c} from both {?a} and {?b}.")

;; ── d=0 negative completion (S1.5a.19 shape). Kept so the two
;;    variants share an identical negative-derivation surface; with
;;    no elimination rule consuming them, these negatives do not by
;;    themselves assert any positive.
(rule functional-negative (?R)
  :match  (and (?R ?a ?b) (relation ?R ?A ?B)
               (is-a ?b_other ?B) (neq ?b_other ?b))
  :assert (not (?R ?a ?b_other))
  :why "{?R} functional: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a} {?b_other})).")
(rule injective-negative (?R)
  :match  (and (?R ?a ?b) (relation ?R ?A ?B)
               (is-a ?a_other ?A) (neq ?a_other ?a))
  :assert (not (?R ?a_other ?b))
  :why "{?R} injective: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a_other} {?b})).")

;; Activators for the parameterised negative-completion rules:
;; functional ⟹ functional-negative active, injective ⟹ injective-negative.
(rule derive-functional-negative ()
  :match (functional ?R) :assert (functional-negative ?R)
  :why "{?R} functional ⟹ functional-negative active.")
(rule derive-injective-negative ()
  :match (injective ?R) :assert (injective-negative ?R)
  :why "{?R} injective ⟹ injective-negative active.")

;; ── Pathway B: hypothesis generator.
(hrule guess (?R ?T1 ?T2)
  :match  (and (is-a ?a ?T1) (is-a ?b ?T2))
  :assert (?R ?a ?b)
  :why "guess: ({?R} {?a} {?b})?")

(relation is-a      T T         :why "{?1} is a {?2}")
(relation color-loc Color House :why "{?2} is painted {?1}")

(bijective color-loc)

(is-a Color T) (is-a House T)
(is-a Red Color) (is-a Green Color) (is-a Blue Color)
(is-a H1 House)  (is-a H2 House)    (is-a H3 House)

(color-loc Red   H2 :source "(1) Red is in house 2")
(color-loc Green H3 :source "(2) Green is in house 3")

(solve
  :hrules (guess (color-loc Color House)))

(query
  :goal (color-loc Blue ?h))
