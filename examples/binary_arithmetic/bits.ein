;;; The tables of binary arithmetic: 28 rows, where decimal's `std.math.digits` has
;;; 1 664. GENERATED by `examples/binary_arithmetic/gen_binary.py`: edit the
;;; script and run it, never the rows.
;;;
;;;   (fa2 A B CARRY-IN DIGIT CARRY-OUT)     the full adder, 8 rows
;;;   (fs2 A B BORROW-IN DIGIT BORROW-OUT)   the full subtractor, 8 rows
;;;   (cl2 BELOW A B ORDER)                  comparison, a column at a time, 12 rows
;;;
;;; The two bits are the names `0` and `1`, which decimal's digits already
;;; are. The module holds facts and no rule; `bin.ein` beside it imports the
;;; three tables and closes them in its closing rule. A program that reads a
;;; table without that theory closes it itself, `(__closed__ fa2)`.
;;;
;;; M1f P1f.6 (S1f.6.16): `plans/…/p1f.6_calculator/binary_arithmetic.md`.
(relation fa2 Bit Bit Bit Bit Bit
  :why "{?1} + {?2} + carry {?3} is digit {?4}, carry {?5}")
(relation fs2 Bit Bit Bit Bit Bit
  :why "{?1} - {?2} - borrow {?3} is digit {?4}, borrow {?5}")
(relation cl2 Order Bit Bit Order
  :why "the order below is {?1}; {?2} against {?3} above it makes it {?4}")
;; fa2: 8 rows
(fa2 0 0 0 0 0) (fa2 0 1 0 1 0) (fa2 0 0 1 1 0) (fa2 0 1 1 0 1)
(fa2 1 0 0 1 0) (fa2 1 1 0 0 1) (fa2 1 0 1 0 1) (fa2 1 1 1 1 1)
;; fs2: 8 rows
(fs2 0 0 0 0 0) (fs2 0 1 0 1 1) (fs2 0 0 1 1 1) (fs2 0 1 1 0 1)
(fs2 1 0 0 1 0) (fs2 1 1 0 0 0) (fs2 1 0 1 0 0) (fs2 1 1 1 1 1)
;; cl2: 12 rows
(cl2 lt 0 0 lt) (cl2 lt 0 1 lt) (cl2 lt 1 0 gt) (cl2 lt 1 1 lt)
(cl2 eq 0 0 eq) (cl2 eq 0 1 lt) (cl2 eq 1 0 gt) (cl2 eq 1 1 eq)
(cl2 gt 0 0 gt) (cl2 gt 0 1 lt) (cl2 gt 1 0 gt) (cl2 gt 1 1 gt)
