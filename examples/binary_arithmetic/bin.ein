;;; Binary arithmetic, a theory of its own, computed by saturation alone.
;;; GENERATED by `examples/binary_arithmetic/gen_binary.py` from the shipped
;;; `stdlib/arith.ein`: edit the script and run it, never this file.
;;;
;;;   (b2 PREFIX BIT)        a binary number, in reading order: twice the
;;;                          prefix, plus the bit; `z` is zero. Five, 101, is
;;;                          (b2 (b2 (b2 z 1) 0) 1)
;;;   (add2 X Y)             a request, answered by (sum-of2 X Y S)
;;;   (sub2 X Y)             answered by (diff-of2 X Y D R): D is X - Y where X
;;;                          is not the smaller, R what X is short by otherwise
;;;   (cmp2 X Y)             answered by (cmp-of2 X Y O), O one of lt, eq, gt
;;;   (mul2 X Y)             answered by (product-of2 X Y P)
;;;   (div2 X Y)             answered by (quot-of2 X Y Q R); a divisor that is
;;;                          zero derives (division-by-zero2 (div2 X Y)) and
;;;                          then (false)
;;;   (let2 NAME NUMBER)     a named constant; a request may name its operands
;;;
;;; One name brings the theory: (import bin :symbols (bin)). `bin` is the
;;; closing rule, which closes every relation and names every rule, so no fact
;;; is ever guessed: R is {∅}, or empty for a division by zero.
;;;
;;; This is way (b) of the plan page: `std.arith`'s rules of the operands, of
;;; addition, subtraction and comparison, the same up to their names (nothing
;;; in them says ten); a multiplication with no digit multiplier, since a row
;;; is nothing or the multiplicand; and a division in which one subtraction
;;; decides a quotient bit, where decimal bisects nine multiples. 68 rules
;;; where decimal has 89 beside its check of what a program wrote, three
;;; tables where it has seven. A division by zero is flagged at the tagged
;;; call, whoever made it, as decimal's is (M1f S1f.6.24): the request's flag
;;; and its call's.
;;;
;;; The names are placeholders, the shipped ones with a `2`; the shape, the
;;; names and whether binary arithmetic ships at all are the plan page's
;;; questions, open. This is an example, not a stdlib module.
;;;
;;; M1f P1f.6 (S1f.6.16): `plans/…/p1f.6_calculator/binary_arithmetic.md`.
(import bits :symbols (fa2 fs2 cl2))
(relation b2 Number Digit
  :why "the number written {?1}, then the digit {?2}")
(relation a2 Digit Digits
  :why "the digit {?1} in front of the digits {?2}")
(relation let2 Name Number
  :why "{?1} names the number {?2}")
(relation add2 Operand Operand
  :why "asked: {?1} + {?2}")
(relation sum-of2 Operand Operand Number
  :why "{?1} + {?2} = {?3}")
(relation sub2 Operand Operand
  :why "asked: {?1} - {?2}")
(relation diff-of2 Operand Operand Number Number
  :why "{?1} - {?2} = {?3}, short by {?4}")
(relation cmp2 Operand Operand
  :why "asked: {?1} compared with {?2}")
(relation cmp-of2 Operand Operand Order
  :why "{?1} against {?2}: {?3}")
(relation mul2 Operand Operand
  :why "asked: {?1} x {?2}")
(relation product-of2 Operand Operand Number
  :why "{?1} x {?2} = {?3}")
(relation div2 Operand Operand
  :why "asked: {?1} divided by {?2}")
(relation quot-of2 Operand Operand Number Number
  :why "{?1} divided by {?2} = {?3}, remainder {?4}")
(relation division-by-zero2 Request
  :why "{?1} divides by zero")
(relation named2 Name
  :why "{?1} is a named constant")
(relation operand2 Tag Operand
  :why "wanted, for {?1}: the number {?2} stands for")
(relation operand-is2 Tag Number
  :why "found, for {?1}: the number {?2}")
(relation add-walk2 Tag Number Number Digit Digits
  :why "adding, for {?1}: {?2} and {?3} are still to add, the carry is {?4}, and the digits so far are {?5}")
(relation strip2 Tag Digits
  :why "for {?1}: the digits {?2}, high zeros not yet dropped")
(relation turn2 Tag Digits Number
  :why "for {?1}: the digits {?2} are still to turn round, and {?3} is turned")
(relation done2 Tag Number
  :why "the answer for {?1} is {?2}")
(relation sub-walk2 Tag Number Number Digit Digits
  :why "subtracting, for {?1}: {?3} is still to take from {?2}, the borrow is {?4}, and the digits so far are {?5}")
(relation short2 Tag
  :why "{?1} has no answer: the number taken from is the smaller")
(relation cmp-walk2 Tag Number Number Order
  :why "comparing, for {?1}: {?2} and {?3} are still to compare, and the order of the digits below is {?4}")
(relation order-is2 Tag Order
  :why "the answer for {?1} is {?2}")
(relation top-first2 Tag Number Digits
  :why "for {?1}: {?2} is still to turn round, and the digits turned are {?3}")
(relation top-first-is2 Tag Digits
  :why "for {?1}: the digits, the top one first, are {?2}")
(relation mul-call2 Tag Number Number
  :why "wanted, for {?1}: {?2} x {?3}")
(relation mul-step2 Tag Number Digits Number
  :why "multiplying, for {?1}: {?2} by the digits {?3} still to come, and the sum so far is {?4}")
(relation div-call2 Tag Number Number
  :why "wanted, for {?1}: {?2} divided by {?3}")
(relation div-done2 Tag Number Number
  :why "the answer for {?1} is {?2}, remainder {?3}")
(relation sum2 Operand Operand
  :why "the sum of {?1} and {?2}")
(relation add-first2 Operand Operand
  :why "the first operand of {?1} + {?2}")
(relation add-second2 Operand Operand Number
  :why "the second operand of {?1} + {?2}, whose first is {?3}")
(relation difference2 Operand Operand
  :why "{?1} - {?2}")
(relation shortfall2 Operand Operand
  :why "what {?1} is short of {?2} by")
(relation sub-first2 Operand Operand
  :why "the first operand of {?1} - {?2}")
(relation sub-second2 Operand Operand Number
  :why "the second operand of {?1} - {?2}, whose first is {?3}")
(relation order2 Operand Operand
  :why "the order of {?1} and {?2}")
(relation cmp-first2 Operand Operand
  :why "the first operand of {?1} compared with {?2}")
(relation cmp-second2 Operand Operand Number
  :why "the second operand of {?1} compared with {?2}, whose first is {?3}")
(relation product2 Operand Operand
  :why "the product of {?1} and {?2}")
(relation mul-first2 Operand Operand
  :why "the first operand of {?1} x {?2}")
(relation mul-second2 Operand Operand Number
  :why "the second operand of {?1} x {?2}, whose first is {?3}")
(relation mul-digits2 Tag Number
  :why "the digits of the multiplier, for {?1}, which multiplies {?2}")
(relation mul-sum2 Tag Number Digits
  :why "the sum so far, for {?1}, which multiplies {?2}, with the digits {?3} still to come")
(relation quotient2 Operand Operand
  :why "{?1} divided by {?2}")
(relation div-first2 Operand Operand
  :why "the first operand of {?1} divided by {?2}")
(relation div-second2 Operand Operand Number
  :why "the second operand of {?1} divided by {?2}, whose first is {?3}")
(relation div-m12 Tag Number Number
  :why "1 times the divisor, for {?1}, which divides {?2} by {?3} as the call wrote it")
(rule operand-zero2 ()
  :match  (operand2 ?k z)
  :assert (operand-is2 ?k z)
  :why    "zero stands for itself")
(rule operand-number2 ()
  :match  (operand2 ?k (b2 ?p ?a))
  :assert (operand-is2 ?k (b2 ?p ?a))
  :why    "a number stands for itself")
(rule let-named2 ()
  :match  (let2 ?x ?v)
  :assert (named2 ?x)
  :why    "{?x} is the name of a number")
(rule operand-name2 ()
  :match  (and (operand2 ?k ?x) (named2 ?x) (let2 ?x ?v))
  :assert (operand-is2 ?k ?v)
  :why    "{?x} names {?v}")
(rule add-column2 ()
  :match  (and (add-walk2 ?k (b2 ?p ?a) (b2 ?q ?c) ?e ?acc) (fa2 ?a ?c ?e ?s ?f))
  :assert (add-walk2 ?k ?p ?q ?f (a2 ?s ?acc))
  :why    "{?a} + {?c} + carry {?e} is {?s}, carry {?f}: {?s} goes in front of the digits so far")
(rule add-column-first2 ()
  :match  (and (add-walk2 ?k (b2 ?p ?a) z ?e ?acc) (fa2 ?a 0 ?e ?s ?f))
  :assert (add-walk2 ?k ?p z ?f (a2 ?s ?acc))
  :why    "the second number has run out: {?a} + carry {?e} is {?s}, carry {?f}")
(rule add-column-second2 ()
  :match  (and (add-walk2 ?k z (b2 ?q ?c) ?e ?acc) (fa2 0 ?c ?e ?s ?f))
  :assert (add-walk2 ?k z ?q ?f (a2 ?s ?acc))
  :why    "the first number has run out: {?c} + carry {?e} is {?s}, carry {?f}")
(rule add-end2 ()
  :match  (add-walk2 ?k z z 0 ?acc)
  :assert (strip2 ?k ?acc)
  :why    "no column is left and no carry: the digits are {?acc}")
(rule add-carry-out2 ()
  :match  (add-walk2 ?k z z 1 ?acc)
  :assert (turn2 ?k (a2 1 ?acc) z)
  :why    "no column is left: the carry is the top digit, in front of {?acc}")
(rule strip-zero2 ()
  :match  (strip2 ?k (a2 0 ?r))
  :assert (strip2 ?k ?r)
  :why    "a high zero is dropped")
(rule strip-none2 ()
  :match  (strip2 ?k z)
  :assert (done2 ?k z)
  :why    "no digit is left: the answer is zero")
(rule turn-step2 ()
  :match  (turn2 ?k (a2 ?a ?r) ?acc)
  :assert (turn2 ?k ?r (b2 ?acc ?a))
  :why    "the digit {?a} goes after {?acc}")
(rule turn-end2 ()
  :match  (turn2 ?k z ?acc)
  :assert (done2 ?k ?acc)
  :why    "turned round: the answer is {?acc}")
(rule add-ask2 ()
  :match  (add2 ?x ?y)
  :assert (operand2 (add-first2 ?x ?y) ?x)
  :why    "{?x} + {?y} is asked: first, the number {?x} stands for")
(rule add-ask-second2 ()
  :match  (operand-is2 (add-first2 ?x ?y) ?u)
  :assert (operand2 (add-second2 ?x ?y ?u) ?y)
  :why    "the first operand is {?u}: now the number {?y} stands for")
(rule add-start2 ()
  :match  (operand-is2 (add-second2 ?x ?y ?u) ?v)
  :assert (add-walk2 (sum2 ?x ?y) ?u ?v 0 z)
  :why    "add {?u} and {?v} from the units, with no carry in")
(rule add-answer2 ()
  :match  (done2 (sum2 ?x ?y) ?s)
  :assert (sum-of2 ?x ?y ?s)
  :why    "{?x} + {?y} = {?s}")
(rule sub-column2 ()
  :match  (and (sub-walk2 ?k (b2 ?p ?a) (b2 ?q ?c) ?e ?acc) (fs2 ?a ?c ?e ?s ?f))
  :assert (sub-walk2 ?k ?p ?q ?f (a2 ?s ?acc))
  :why    "{?a} - {?c} - borrow {?e} is {?s}, borrow {?f}: {?s} goes in front of the digits so far")
(rule sub-column-first2 ()
  :match  (and (sub-walk2 ?k (b2 ?p ?a) z ?e ?acc) (fs2 ?a 0 ?e ?s ?f))
  :assert (sub-walk2 ?k ?p z ?f (a2 ?s ?acc))
  :why    "the number taken away has run out: {?a} - borrow {?e} is {?s}, borrow {?f}")
(rule sub-column-second2 ()
  :match  (and (sub-walk2 ?k z (b2 ?q ?c) ?e ?acc) (fs2 0 ?c ?e ?s ?f))
  :assert (sub-walk2 ?k z ?q ?f (a2 ?s ?acc))
  :why    "the number taken from has run out: 0 - {?c} - borrow {?e} is {?s}, borrow {?f}")
(rule sub-end2 ()
  :match  (sub-walk2 ?k z z 0 ?acc)
  :assert (strip2 ?k ?acc)
  :why    "no column is left and no borrow: the digits are {?acc}")
(rule sub-borrow-out2 ()
  :match  (sub-walk2 ?k z z 1 ?acc)
  :assert (short2 ?k)
  :why    "no column is left and a borrow is: the number taken from is the smaller")
(rule sub-ask2 ()
  :match  (sub2 ?x ?y)
  :assert (operand2 (sub-first2 ?x ?y) ?x)
  :why    "{?x} - {?y} is asked: first, the number {?x} stands for")
(rule sub-ask-second2 ()
  :match  (operand-is2 (sub-first2 ?x ?y) ?u)
  :assert (operand2 (sub-second2 ?x ?y ?u) ?y)
  :why    "the first operand is {?u}: now the number {?y} stands for")
(rule sub-start2 ()
  :match  (operand-is2 (sub-second2 ?x ?y ?u) ?v)
  :assert (and (sub-walk2 (difference2 ?x ?y) ?u ?v 0 z) (sub-walk2 (shortfall2 ?x ?y) ?v ?u 0 z))
  :why    "take {?v} from {?u}, and {?u} from {?v}, from the units, with no borrow in: one of the two has an answer")
(rule sub-answer2 ()
  :match  (done2 (difference2 ?x ?y) ?d)
  :assert (diff-of2 ?x ?y ?d z)
  :why    "{?x} - {?y} = {?d}, and nothing is short")
(rule sub-answer-short2 ()
  :match  (done2 (shortfall2 ?x ?y) ?r)
  :assert (diff-of2 ?x ?y z ?r)
  :why    "{?x} is short of {?y} by {?r}: the difference is zero")
(rule cmp-column2 ()
  :match  (and (cmp-walk2 ?k (b2 ?p ?a) (b2 ?q ?c) ?o) (cl2 ?o ?a ?c ?t))
  :assert (cmp-walk2 ?k ?p ?q ?t)
  :why    "the order below is {?o}; {?a} against {?c} above it makes it {?t}")
(rule cmp-column-first2 ()
  :match  (and (cmp-walk2 ?k (b2 ?p ?a) z ?o) (cl2 ?o ?a 0 ?t))
  :assert (cmp-walk2 ?k ?p z ?t)
  :why    "the second number has run out: the order below is {?o}, and {?a} against nothing makes it {?t}")
(rule cmp-column-second2 ()
  :match  (and (cmp-walk2 ?k z (b2 ?q ?c) ?o) (cl2 ?o 0 ?c ?t))
  :assert (cmp-walk2 ?k z ?q ?t)
  :why    "the first number has run out: the order below is {?o}, and nothing against {?c} makes it {?t}")
(rule cmp-end2 ()
  :match  (cmp-walk2 ?k z z ?o)
  :assert (order-is2 ?k ?o)
  :why    "no column is left: the order is {?o}")
(rule cmp-ask2 ()
  :match  (cmp2 ?x ?y)
  :assert (operand2 (cmp-first2 ?x ?y) ?x)
  :why    "{?x} compared with {?y} is asked: first, the number {?x} stands for")
(rule cmp-ask-second2 ()
  :match  (operand-is2 (cmp-first2 ?x ?y) ?u)
  :assert (operand2 (cmp-second2 ?x ?y ?u) ?y)
  :why    "the first operand is {?u}: now the number {?y} stands for")
(rule cmp-start2 ()
  :match  (operand-is2 (cmp-second2 ?x ?y ?u) ?v)
  :assert (cmp-walk2 (order2 ?x ?y) ?u ?v eq)
  :why    "compare {?u} with {?v} from the units: equal so far")
(rule cmp-answer2 ()
  :match  (order-is2 (order2 ?x ?y) ?o)
  :assert (cmp-of2 ?x ?y ?o)
  :why    "{?x} against {?y}: {?o}")
(rule top-first-step2 ()
  :match  (top-first2 ?k (b2 ?p ?a) ?acc)
  :assert (top-first2 ?k ?p (a2 ?a ?acc))
  :why    "the digit {?a} goes in front of {?acc}")
(rule top-first-end2 ()
  :match  (top-first2 ?k z ?acc)
  :assert (top-first-is2 ?k ?acc)
  :why    "turned round: the digits, the top one first, are {?acc}")
(rule mul-ask2 ()
  :match  (mul2 ?x ?y)
  :assert (operand2 (mul-first2 ?x ?y) ?x)
  :why    "{?x} x {?y} is asked: first, the number {?x} stands for")
(rule mul-ask-second2 ()
  :match  (operand-is2 (mul-first2 ?x ?y) ?u)
  :assert (operand2 (mul-second2 ?x ?y ?u) ?y)
  :why    "the first operand is {?u}: now the number {?y} stands for")
(rule mul-start2 ()
  :match  (operand-is2 (mul-second2 ?x ?y ?u) ?v)
  :assert (mul-call2 (product2 ?x ?y) ?u ?v)
  :why    "multiply {?u} by {?v}")
(rule mul-answer2 ()
  :match  (done2 (product2 ?x ?y) ?p)
  :assert (product-of2 ?x ?y ?p)
  :why    "{?x} x {?y} = {?p}")
(rule div-ask2 ()
  :match  (div2 ?x ?y)
  :assert (operand2 (div-first2 ?x ?y) ?x)
  :why    "{?x} divided by {?y} is asked: first, the number {?x} stands for")
(rule div-ask-second2 ()
  :match  (operand-is2 (div-first2 ?x ?y) ?u)
  :assert (operand2 (div-second2 ?x ?y ?u) ?y)
  :why    "the first operand is {?u}: now the number {?y} stands for")
(rule div-start2 ()
  :match  (operand-is2 (div-second2 ?x ?y ?u) ?v)
  :assert (div-call2 (quotient2 ?x ?y) ?u ?v)
  :why    "divide {?u} by {?v}")
(rule div-answer2 ()
  :match  (div-done2 (quotient2 ?x ?y) ?q ?r)
  :assert (quot-of2 ?x ?y ?q ?r)
  :why    "{?x} divided by {?y} = {?q}, remainder {?r}")
(rule div-by-zero2 ()
  :match  (done2 (div-m12 (quotient2 ?x ?y) ?u ?v) z)
  :assert (division-by-zero2 (div2 ?x ?y))
  :why    "the divisor of {?x} divided by {?y} is zero")
(rule div-call-by-zero2 ()
  :match  (done2 (div-m12 ?k ?u ?v) z)
  :assert (division-by-zero2 (div-call2 ?k ?u ?v))
  :why    "the divisor of {?u} divided by {?v}, wanted for {?k}, is zero")
(rule division-by-zero-is-false2 ()
  :match  (division-by-zero2 ?request)
  :assert (false)
  :why    "{?request} divides by zero: no number is the answer")
(rule mul-turn2 ()
  :match  (mul-call2 ?k ?u ?v)
  :assert (top-first2 (mul-digits2 ?k ?u) ?v z)
  :why    "to multiply {?u} by {?v}: first {?v}'s digits, the top one first")
(rule mul-begin2 ()
  :match  (top-first-is2 (mul-digits2 ?k ?u) ?t)
  :assert (mul-step2 ?k ?u ?t z)
  :why    "nothing is summed yet")
(rule mul-one2 ()
  :match  (mul-step2 ?k ?u (a2 1 ?rest) (b2 ?p ?a))
  :assert (add-walk2 (mul-sum2 ?k ?u ?rest) (b2 (b2 ?p ?a) 0) ?u 0 z)
  :why    "the next digit of the multiplier is 1: twice the sum so far, plus {?u}")
(rule mul-one-first2 ()
  :match  (mul-step2 ?k ?u (a2 1 ?rest) z)
  :assert (add-walk2 (mul-sum2 ?k ?u ?rest) z ?u 0 z)
  :why    "the next digit of the multiplier is 1 and nothing is summed yet: the sum is {?u}, in normal form")
(rule mul-zero2 ()
  :match  (mul-step2 ?k ?u (a2 0 ?rest) (b2 ?p ?a))
  :assert (mul-step2 ?k ?u ?rest (b2 (b2 ?p ?a) 0))
  :why    "the next digit of the multiplier is 0: twice the sum so far")
(rule mul-zero-first2 ()
  :match  (mul-step2 ?k ?u (a2 0 ?rest) z)
  :assert (mul-step2 ?k ?u ?rest z)
  :why    "the next digit of the multiplier is 0 and nothing is summed yet")
(rule mul-next2 ()
  :match  (done2 (mul-sum2 ?k ?u ?rest) ?s)
  :assert (mul-step2 ?k ?u ?rest ?s)
  :why    "the sum so far is {?s}")
(rule mul-end2 ()
  :match  (mul-step2 ?k ?u z ?acc)
  :assert (done2 ?k ?acc)
  :why    "no digit of the multiplier is left: the product is {?acc}")
(rule div-multiples2 ()
  :match  (div-call2 ?k ?u ?v)
  :assert (add-walk2 (div-m12 ?k ?u ?v) z ?v 0 z)
  :why    "to divide {?u} by {?v}: first the divisor in normal form, zero plus {?v}")
(rule strip-top2 ()
  :match  (strip2 ?k (a2 1 ?r))
  :assert (turn2 ?k (a2 1 ?r) z)
  :why    "the top digit is 1: no high zero is left")
(relation div-digits2 Tag Number
  :why "the digits of the dividend, for {?1}, which is divided by {?2}")
(relation div-step2 Tag Number Digits Number Number
  :why "dividing, for {?1}, by {?2}: the digits {?3} are still to bring down, {?4} is left over, and the quotient so far is {?5}")
(relation div-trial2 Tag Number Digits Number Number
  :why "a trial, for {?1}: the divisor {?2} taken from {?5}")
(rule div-turn2 ()
  :match  (done2 (div-m12 ?k ?u ?v) (b2 ?p ?a))
  :assert (top-first2 (div-digits2 ?k (b2 ?p ?a)) ?u z)
  :why    "the divisor is not zero. Now the digits of {?u}, the top one first")
(rule div-begin2 ()
  :match  (top-first-is2 (div-digits2 ?k ?d) ?t)
  :assert (div-step2 ?k ?d ?t z z)
  :why    "start at the top digit: nothing is left over yet, and the quotient is zero")
(rule div-bring2 ()
  :match  (div-step2 ?k ?d (a2 ?a ?rest) (b2 ?p ?c) ?w)
  :assert (sub-walk2 (div-trial2 ?k ?d ?rest ?w (b2 (b2 ?p ?c) ?a)) (b2 (b2 ?p ?c) ?a) ?d 0 z)
  :why    "bring down {?a} beside what is left over, and try to take the divisor from it")
(rule div-bring-first2 ()
  :match  (div-step2 ?k ?d (a2 1 ?rest) z ?w)
  :assert (sub-walk2 (div-trial2 ?k ?d ?rest ?w (b2 z 1)) (b2 z 1) ?d 0 z)
  :why    "nothing was left over: bring down 1, and try to take the divisor from it")
(rule div-bring-zero2 ()
  :match  (div-step2 ?k ?d (a2 0 ?rest) z (b2 ?p ?c))
  :assert (div-step2 ?k ?d ?rest z (b2 (b2 ?p ?c) 0))
  :why    "nothing was left over and the digit brought down is 0: the next digit of the quotient is 0")
(rule div-bring-zero-none2 ()
  :match  (div-step2 ?k ?d (a2 0 ?rest) z z)
  :assert (div-step2 ?k ?d ?rest z z)
  :why    "nothing was left over, the digit brought down is 0 and the quotient so far is zero: no high zero is written")
(rule div-fits2 ()
  :match  (done2 (div-trial2 ?k ?d ?rest ?w ?u) ?t)
  :assert (div-step2 ?k ?d ?rest ?t (b2 ?w 1))
  :why    "the divisor fits, and leaves {?t}: the next digit of the quotient is 1")
(rule div-too-big2 ()
  :match  (short2 (div-trial2 ?k ?d ?rest (b2 ?p ?c) ?u))
  :assert (div-step2 ?k ?d ?rest ?u (b2 (b2 ?p ?c) 0))
  :why    "the divisor does not fit: the next digit of the quotient is 0")
(rule div-too-big-none2 ()
  :match  (short2 (div-trial2 ?k ?d ?rest z ?u))
  :assert (div-step2 ?k ?d ?rest ?u z)
  :why    "the divisor does not fit and the quotient so far is zero: no high zero is written")
(rule div-end2 ()
  :match  (div-step2 ?k ?d z ?t ?w)
  :assert (div-done2 ?k ?w ?t)
  :why    "no digit is left: the quotient is {?w} and the remainder {?t}")
(relation arith-rule2 Rule
  :why "{?1} is a rule of the theory")
(arith-rule2 bin)
(rule bin ()
  :match  ()
  :assert (and (__closed__ fa2)
              (__closed__ fs2)
