;;; A first binary sum, computed by saturation alone: 101 + 111 = 1100,
;;; which is 5 + 7 = 12.
;;;
;;; Ein has no numbers. `bin.ein` beside this file is a theory written in Ein
;;; that does school arithmetic on binary numbers, as `std.arith` does on
;;; decimal ones: the two bits are the names `0` and `1`, what is known of
;;; them is three small tables of facts (`bits.ein`), and the rules are the
;;; wiring.
;;;
;;;   (b2 PREFIX BIT)     a binary number, in reading order: twice the prefix,
;;;                       plus the bit; `z` is zero. 101 is (b2 (b2 (b2 z 1) 0) 1)
;;;   (add2 X Y)          a request fact: X + Y is asked
;;;   (sum-of2 X Y S)     the answer, repeating the operands as written
;;;   (let2 NAME NUMBER)  a named constant; a request may name its operands
;;;
;;; Nothing is guessed: the theory's closing rule, `bin`, closes every
;;; relation, so `ein solve` reports no candidate and one state.
;;;
;;;   ein solve examples/binary_arithmetic/first.ein
;;;
;;; M1f P1f.6 (S1f.6.16): `plans/…/p1f.6_calculator/binary_arithmetic.md` has
;;; the prototype this program was banked from, its counts and its costs.
(import bin :symbols (bin add2 b2 let2 sub2 sum-of2 diff-of2))

(add2 (b2 (b2 (b2 z 1) 0) 1) (b2 (b2 (b2 z 1) 1) 1))

(let2 left  (b2 (b2 (b2 z 1) 1) 0))
(let2 right (b2 (b2 z 1) 1))
(sub2 left right)

(query :goal (sum-of2 ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (sum-of2 (b2 (b2 (b2 z 1) 0) 1) (b2 (b2 (b2 z 1) 1) 1) (b2 (b2 (b2 (b2 z 1) 1) 0) 0))))

(query :goal (diff-of2 left right ?d ?short)
       :goal-text "left - right = {?d}"
       :expect (model (diff-of2 left right (b2 (b2 z 1) 1) z)))
