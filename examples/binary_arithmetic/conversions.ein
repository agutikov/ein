;;; Decimal to binary and back, as requests of `conv.ein`, the first theory
;;; built on the calculator: each conversion is a chain of the two theories'
;;; own operations.
;;;
;;;   (to-bin X)   answered by (bin-of X B): X halved by decimal's division
;;;                until nothing is left, each remainder a bit
;;;   (to-dec B)   answered by (dec-of B X): from the top bit, the number so
;;;                far doubled and the bit added, by one decimal addition
;;;
;;; To binary: 0, 1, 2, 10, 255. To decimal: 0, 1, 10, 1010, 11111111, 100000000, 1111101000.
;;;
;;; The two directions do not cost the same. A halving is a whole decimal
;;; division, where a doubling is one addition: 255 to binary is 826 firings
;;; and back is 76 (the plan page). The numbers here are short for that
;;; reason and one more: every corpus program is solved and its state written
;;; as text, and a circuit's state as text grows with its steps (E-24 of the
;;; phase's `findings.md`). The page has the conversions of 123078 and of
;;; 2^40 + 1.
;;;
;;; Every claim was computed in Python and is checked by `ein test`.
;;;
;;; M1f P1f.6 (S1f.6.16): `plans/…/p1f.6_calculator/binary_arithmetic.md` has
;;; the prototype this program was banked from, its counts and its costs.
(import conv :symbols (conv))

(to-bin z)
(to-bin (n z 1))
(to-bin (n z 2))
(to-bin (n (n z 1) 0))
(to-bin (n (n (n z 2) 5) 5))

(to-dec z)
(to-dec (b2 z 1))
(to-dec (b2 (b2 z 1) 0))
(to-dec (b2 (b2 (b2 (b2 z 1) 0) 1) 0))
(to-dec (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 1) 1) 1))
(to-dec (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 0) 0) 0) 0) 0) 0) 0))
(to-dec (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 0) 1) 0) 0) 0))

(query :goal (bin-of ?x ?b)
       :goal-text "{?x} is {?b} in binary"
       :expect (model (bin-of z z)
                      (bin-of (n z 1) (b2 z 1))
                      (bin-of (n z 2) (b2 (b2 z 1) 0))
                      (bin-of (n (n z 1) 0) (b2 (b2 (b2 (b2 z 1) 0) 1) 0))
                      (bin-of (n (n (n z 2) 5) 5) (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 1) 1) 1))))

(query :goal (dec-of ?b ?x)
       :goal-text "{?b} in binary is {?x}"
       :expect (model (dec-of z z)
                      (dec-of (b2 z 1) (n z 1))
                      (dec-of (b2 (b2 z 1) 0) (n z 2))
                      (dec-of (b2 (b2 (b2 (b2 z 1) 0) 1) 0) (n (n z 1) 0))
                      (dec-of (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 1) 1) 1) (n (n (n z 2) 5) 5))
                      (dec-of (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 0) 0) 0) 0) 0) 0) 0) 0) (n (n (n z 2) 5) 6))
                      (dec-of (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 (b2 z 1) 1) 1) 1) 1) 0) 1) 0) 0) 0) (n (n (n (n z 1) 0) 0) 0))))
