;;; P1.5 demo 6 — one-step lookahead (S1.5.6): ENABLED.
;;;
;;; The ENABLED half of an on/off pair. 06_lookahead_on.ein and
;;; 07_lookahead_off.ein are byte-identical except for the single
;;; `(config …)` line below — diff the two files to see it.
;;;
;;; The puzzle: five colours, five houses, four colours anchored.
;;; Blue is the lone unanchored colour and must take the one free
;;; house, H5. The hypothesis generator emits `(co-located Blue Hk)`
;;; for k = 1..5. Four of them are *doomed*: placing Blue in an
;;; already-occupied house Hk chains, in ONE rule firing against the
;;; already-saturated root KB,
;;;
;;;     (co-located Blue Hk)        -- the hypothesis
;;;   + (co-located Hk Ck)          -- symmetric of the Ck↔Hk anchor
;;;   ⇒ transitive ⇒ (co-located Blue Ck)
;;;
;;; and `(not (co-located Blue Ck))` was already derived by
;;; `sibling-exclusive` (Blue and Ck are both Colours). The lookahead
;;; sees that collision and drops the candidate.
;;;
;;; With the lookahead ON (this file) those four candidates never
;;; fork — the search tree collapses to the lone surviving placement.
;;; With it OFF (07_lookahead_off.ein) each doomed colour forks,
;;; saturates, and dies as its own branch, so the tree is an order of
;;; magnitude larger.
;;;
;;; ~~Same verdict (Solution) and the same binding (?h = H5) either
;;; way — only the node count differs. Measured: ON (06) = 2 tree
;;; nodes; OFF (07) = 82 (80 dead branches).~~ **That was P1.5, and it
;;; is no longer true** (re-measured 2026-08-20, M1a S1a.6.7, in BOTH
;;; implementations, which agree to the digit):
;;;
;;;     ON  (06)  fast: Solution  k=1   67 enterings
;;;               -e:   Ambiguity k=22  5173 enterings
;;;     OFF (07)  fast: Contradiction k=0  11501 enterings
;;;               -e:   Contradiction k=0  11501 enterings
;;;
;;; The lever changes the VERDICT, not just the node count, because
;;; `complete(kb)` (inference/solution.py) asks the hypothesis
;;; generator whether anything is undecided — and the generator's
;;; candidate list is itself lookahead-filtered. A doomed candidate is
;;; *decided* with the lookahead on and *open* with it off, so a KB
;;; whose only survivors are doomed is a solution node in the first
;;; case and no model at all in the second. See
;;; docs/kernel/inference/features.md and plans/followups/
;;; f4_cross_cutting.md Q40.

(config :enable-pre-branch-lookahead true)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric"
  :priority 100)

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive"
  :priority 200)

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "{?a} and {?b} share {?T} — exclusive under {?exclusive-under}."
  :priority 300)

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional"
  :priority 250)

(relation is-a       T T)
(relation co-located T T)

(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a House T)
(is-a Red    Color) (is-a Green Color) (is-a Ivory  Color)
(is-a Yellow Color) (is-a Blue  Color)
(is-a H1 House) (is-a H2 House) (is-a H3 House)
(is-a H4 House) (is-a H5 House)

(co-located Red    H1 :source "(1)")
(co-located Green  H2 :source "(2)")
(co-located Ivory  H3 :source "(3)")
(co-located Yellow H4 :source "(4)")

(query
  :goal (co-located Blue ?h))
