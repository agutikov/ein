;;; A rule that can never fire, refused by its shape: a refusal fixture.
;;;
;;; `self-block` concludes (false) from `(cand ?x)` and `(absent (cand ?x))`
;;; at once. Its two premises are jointly unsatisfiable in any one world,
;;; so it can never fire in a real match: no world both holds a
;;; `(cand ?x)` and lacks it, whatever candidate a commitment adds to
;;; it.
;;;
;;; `cand` is a relation the blind enumerator proposes (`promote`
;;; concludes it, and nothing closes it), so `(cand B)` is a candidate
;;; and `cand` a relation a commitment can still extend. A refutation
;;; that rests on an `absent` over such a relation is the shape *forbid*
;;; refuses (Q-M1e2.5): every question about a commitment (`ein solve`,
;;; `ein render lattice`) exits 1 naming `self-block`, and `ein saturate`
;;; still saturates.
;;;
;;; It shows a refusal no witness does: the check reads relations, not
;;; matches, so a rule that can never fire is refused by its shape all
;;; the same. Deleting the rule keeps R, three states — ∅, {(cand B)} and
;;; the maximal state two commitments reach — with ?x = A in every one,
;;; and ?x = B too where `(cand B)` holds, and leaves a file about
;;; nothing.
;;;
;;; The refusal names its repairs: close the relation, if no commitment
;;; is meant to extend it; state a requirement as a decision or an
;;; obligation; or conclude from a stored negative, `(not …)`.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

;; The file sets no `(config …)`: every flag has its default.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(relation ok      T :why "{?1} is ok")
(relation blessed T :why "{?1} is blessed")
(relation cand    T :why "{?1} is a candidate")

(rule promote ()
  :match  (and (ok ?x) (blessed ?x))
  :assert (cand ?x)
  :why    "{?x} is ok and blessed, so it is a candidate")

(rule self-block ()
  :match  (and (cand ?x) (absent (cand ?x)))
  :assert (false)
  :why    "unsatisfiable in any one world")

(ok      A :source "(1)")
(ok      B :source "(2)")
(blessed A :source "(3)")

(query
  :goal (cand ?x))
