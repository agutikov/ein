;;; A rule that can never fire, in a program that is not monotone by its
;;; shape.
;;;
;;; `self-block` concludes (false) from `(cand ?x)` and `(absent (cand ?x))`
;;; at once. Its two premises are jointly unsatisfiable in any one world,
;;; so it can never fire in a real match: no world both holds a
;;; `(cand ?x)` and lacks it, whatever candidate a commitment adds to
;;; it.
;;;
;;; `cand` is a relation the blind enumerator proposes (`promote`
;;; concludes it, and nothing closes it), so `(cand B)` is a candidate
;;; and `cand` a relation a commitment can still extend. A refutation
;;; that rests on an `absent` over such a relation is a site of the
;;; static check, which reads relations, not matches: the program is
;;; flagged though the rule never fires. It loads, every command answers
;;; it with the warning that it is not monotone, and nothing is claimed
;;; of its answer (Q-M1f.564).
;;;
;;; Deleting the rule leaves a monotone program, and a file about
;;; nothing.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

;; The file sets no `(config …)`: every flag has its default.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(relation ok      T :why "{?3} is ok")
(relation blessed T :why "{?3} is blessed")
(relation cand    T :why "{?3} is a candidate")

(rule promote ()
  :match  (and (ok ?x) (blessed ?x))
  :assert (cand ?x)
  :why    "{?x} is ok and blessed, so it is a candidate")

(rule self-block ()
  :match  (and (cand ?x) (absent (cand ?x)))
  :assert (false)
  :why    "unsatisfiable in any one world")

(ok      A :source "(1)")
(ok      B :source "(2)")
(blessed A :source "(3)")

(query
  :goal (cand ?x))
