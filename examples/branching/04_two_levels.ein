;;; Branching demo 4 of 5 — two-level branching on a *genuinely* underspecified
;;; puzzle.
;;;
;;; Three colors, three houses, exactly one anchor (Red↔H1). The
;;; query asks who lives in H3. Blue and Green are free to swap
;;; between H2 and H3; no constraint distinguishes them, so the
;;; puzzle has TWO valid answers:
;;;
;;;   ?c = Blue   ⟺   (Blue at H3, Green at H2)
;;;   ?c = Green  ⟺   (Green at H3, Blue at H2)
;;;
;;; **Two maximal states are the correct answer here, not a defect of
;;; the reasoner.** R holds every alive placement, and its maximal line
;;; is the two full assignments, one per answer:
;;;
;;;   ∅                          root — the goal has no row
;;;   one colour placed          four states, each a placement and its
;;;                              symmetric mirror
;;;   Blue at H3, Green at H2    maximal — ?c = Blue
;;;   Green at H3, Blue at H2    maximal — ?c = Green
;;;
;;; The query's projection classes say the same: over R's 7 states, ?c
;;; is Blue in two, Green in two, and undetermined in three, ∅ among
;;; them; `--single` says **Ambiguity**, R holding more than one state.
;;;
;;; A state is reached by every commitment whose closure it is, so the
;;; symmetric activator on `co-located`, which proposes both directions
;;; of each placement, merges commitments rather than adding states: 9
;;; commitments reach each maximal state, 4 of them minimal.
;;;
;;; Contrast with demos 3 and 5: their maximal line is one state, the
;;; unique answer; two maximal states there would indicate a bug.
;;;
;;; Expected:
;;;   states        7, ∅ among them
;;;   maximal line  2 states
;;;   bindings      ?c=Blue AND ?c=Green   (both shown; both correct)
;;;

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} sym")

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} tr")

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "sib {?T}")

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "fn {?R}")

(relation is-a       T T :why "{?3} is a {?4}")
;; `co-located` here relates a Color to a House. Naming
;; those types in the signature lets hypgen's name-free candidate set
;; exclude the type atoms (`Color`/`House`/`T`) and guess only over
;; the leaf instances — no kernel `is-a` read. (The signature is
;; object-selection metadata, and no type-compatibility filter reads
;; it, so the symmetric `(co-located H1 Red)` direction is unaffected.)
(relation co-located Color House :why "{?3} is co-located with {?4}")

(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a House T)
(is-a Red   Color) (is-a Blue  Color) (is-a Green Color)
(is-a H1    House) (is-a H2    House) (is-a H3    House)

(co-located Red H1 :source "(1)")

(query
  :goal (co-located ?c H3))
