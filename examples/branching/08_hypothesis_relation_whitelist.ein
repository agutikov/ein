;;; Branching demo 8 — the relation list, `:hypothesis-relations`.
;;;
;;; `(solve :hypothesis-relations (…))` names the relations H may hold
;;; candidates of, and every other relation is left out of H — `is-a`
;;; here, whose facts are all given, and a relation a rule propagates,
;;; when this program has no use for guessing it. A `(__closed__ R)`
;;; fact takes one relation out instead, and a relation may not be both
;;; listed and closed.
;;;
;;; This puzzle has `co-located` (the attribute to pin down) and
;;; `next-to` (the house adjacency). `next-to` is propagated by
;;; `(symmetric next-to)`, and nothing closes it, so the blind
;;; enumerator would build `next-to` candidates. But the goal is about
;;; `co-located`, and `(solve :hypothesis-relations (co-located))`
;;; restricts the generator to it: `ein show hyps` lists 38 candidates,
;;; every one of `co-located`. The list is the program's, not a
;;; query's: one program states one lattice.
;;;
;;; Drop the list and the generator also enumerates `next-to` and `is-a`
;;; guesses — wasteful here, since both are given in full.
;;;
;;; The signature is `T T`, so H binds type atoms as objects too: R is 34
;;; states and its maximal line 8; where a state places Blue in a house,
;;; ?h = H3.

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric")

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive")

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "{?a} and {?b} share {?T} — exclusive under {?exclusive-under}.")

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional")

(relation is-a       T T :why "{?1} is a {?2}")
(relation co-located T T :why "{?1} is co-located with {?2}")
(relation next-to    T T :why "{?1} is next to {?2}")

(symmetric         co-located)
(transitive        co-located)
(symmetric         next-to)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a House T)
(is-a Red Color) (is-a Green Color) (is-a Blue Color)
(is-a H1 House) (is-a H2 House) (is-a H3 House)

;; The house adjacency — given as facts, never hypothesised.
(next-to H1 H2)
(next-to H2 H3)

(co-located Red   H1 :source "(1)")
(co-located Green H2 :source "(2)")

(solve
  :hypothesis-relations (co-located))

(query
  :goal (co-located Blue ?h))
