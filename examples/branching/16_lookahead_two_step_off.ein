;;; Refutations of depth one and two, side by side: the second of a pair.
;;;
;;; 15_lookahead_two_step_on.ein and 16_lookahead_two_step_off.ein are the
;;; same program, byte for byte outside their comments, and the witnesses of
;;; regressions branching-15 and branching-16: a maximal alive
;;; commitment that an answer fails to list.
;;;
;;; A refutation that takes two firings is as final as one that takes one:
;;; every route saturates each node to its fixpoint, so the depth of a death
;;; moves nothing in R. With three hypotheses, every run exhausting, and a
;;; solution set derivable in a paragraph, the pair shows it on a program
;;; small enough to check by hand.
;;;
;;; ── The program ────────────────────────────────────────────────────────────
;;;
;;; Three candidates, `(p A)`, `(p B)`, `(p C)`, and two refutations:
;;;
;;;   {(p A), (p B)}  dies in ONE firing   — `pair-fast`
;;;   {(p A), (p C)}  dies in TWO           — `pair-slow-1` then `pair-slow-2`
;;;
;;; and nothing refutes `{(p B), (p C)}`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────────
;;;
;;; A solution is a maximal alive commitment — one with no live child
;;; (`docs/ein/reasoning/02-kb-evolution/06-solution-semantics.md` § 2). Two sets qualify:
;;;
;;;   {(p A)}          — both its children, {A,B} and {A,C}, are dead.
;;;   {(p B), (p C)}   — its only child, {A,B,C}, is dead.
;;;
;;; **k = 2**: two maximal states.
;;;
;;; ── What `ein solve` reports ───────────────────────────────────────────────
;;;
;;; R is five states: ∅ (root, which owes nothing), the three singletons and
;;; {(p B), (p C)}. Its maximal line is {(p A)} and {(p B), (p C)}, the k = 2
;;; derived by hand: `{(p A)}`'s children die in one firing and in two, and
;;; both deaths count. `ein solve --maximal` lists the two.
;;;
;;; `{(p A), (p C)}`'s node derives `(clash)` by `pair-slow-1` and `(false)`
;;; from it by `pair-slow-2` in one saturation, and a node is dead when its
;;; fixpoint holds `(false)`, however many firings that took. `ein oracle`,
;;; which saturates all eight nodes of the cube, lists the same five states.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;; ── The `:expect` ───────────────────────────────────────────────────────────
;;;
;;; The answer is the region R (Q-M1e2.7), every alive state: its two maximal
;;; states are {(p A)} and {(p B), (p C)}, the k = 2 derived by hand above.
;;; The `:expect` lists R, and no lever moves it.
;;;
;;;

;; Neither file sets a `(config …)`: every flag has its default, and no
;; flag changes R, so the one program has one answer, the `:expect`
;; below.

(relation is-a T T :why "{?1} is a {?2}")
(relation cand T   :why "{?1} may be given p")
(relation p    T   :why "{?1} has p")
(relation clash    :why "an (A, C) pairing was proposed")

(is-a A T) (is-a B T) (is-a C T)
(cand A)   (cand B)   (cand C)

;; The generator, written out so the blind rung never runs: the candidates are
;; exactly these three and no model can bind a type as an object.
(hrule guess ()
  :match  (cand ?x)
  :assert (p ?x)
  :why    "guess (p {?x})")

;; A and B are exclusive — ONE firing, which the pre-branch lookahead sees.
(rule pair-fast ()
  :match  (and (p A) (p B))
  :assert (false)
  :why    "A and B cannot both have p")

;; A and C are exclusive too — but in TWO firings, which it cannot.
(rule pair-slow-1 ()
  :match  (and (p A) (p C))
  :assert (clash)
  :why    "A and C together are a clash")

(rule pair-slow-2 ()
  :match  (clash)
  :assert (false)
  :why    "a clash is a contradiction")

(solve :expect (region
                 ;; state 1 of 5 — ∅, root itself · minimal
                 (model)
                 ;; state 2 of 5 — 1 candidate · maximal · from {(p A)}
                 (model (p A))
                 ;; state 3 of 5 — 1 candidate · from {(p B)}
                 (model (p B))
                 ;; state 4 of 5 — 1 candidate · from {(p C)}
                 (model (p C))
                 ;; state 5 of 5 — 2 candidates · maximal · from {(p B), (p C)}
                 (model (p B) (p C))))

(query
  :goal   (p ?x))
