;;; Branching demo 11 — one of a pair with `10_kill_cache_on.ein`.
;;;
;;; 10_kill_cache_on.ein and 11_kill_cache_off.ein are the same program,
;;; byte for byte outside their comments: no flag tells them apart, since
;;; no flag changes R. Demos 06/07 are another such pair.
;;;
;;; Puzzle: 4 attributes x 2 instances over one `co-located` relation
;;; (symmetric + transitive). Three anchors pin everything to the Red
;;; house — Red=Tea, Red=Cat, Red=Pipe — so by per-attribute exclusivity
;;; the other house takes Milk, Dog, Cigar, and the Milk drinker owns the
;;; Dog. The model is unique: R's maximal line is one state, Blue, Milk,
;;; Dog and Cigar together, and every row the query has says ?p = Dog.
;;;
;;; The hrule `guess` proposes 18 candidates, 12 of them dead alone, and
;;; every minimal dead set is one of those 12. The other six are the
;;; pairs among Blue, Milk, Dog and Cigar; any set of them is alive, so R
;;; is a sub-cube of dimension 6, 64 commitments, whose closures are 15
;;; states: ∅ and every alive partial placement of the other house, each
;;; reached by every commitment whose closure it is.
;;;
;;; `ein solve` on this file prints, among its rows:
;;;
;;;   states (k_s)      15
;;;   commitments (k_c) 64
;;;   maximal line      1 state
;;;   sub-cubes         1, of dimension 6
;;;   merged            5 states reached by more than one commitment, with 28 minimal
;;;   N                 12 minimal dead sets
;;;   universe          18 candidates, 12 dead alone
;;;
;;; and over the query, 4 projection classes: the 12 states where the goal
;;; has no row, and three where it binds ?p = Dog, ?x Blue or Cigar or both.
;;; `ein solve --maximal` lists the one maximal state alone.
;;;
;;;
;;;
;;;
;;;
;;;
;;;

;; The file sets no `(config …)`: every flag has its default.
;;
;;

;; A fact beside its stored negation is a contradiction by this module's rules (Q-M1f.557).
(import std.contradiction)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric")

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive")

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "siblings under {?T} are not {?exclusive-under}")

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional")

;; Type-aware candidate generation: propose a `co-located` between an
;; instance of attribute type ?A and one of type ?B. (Blind hypgen would
;; emit type-wrong pairs that never resolve; the hrule keeps generation
;; type-aware — the mini_zebra pattern, demo 05.)
(hrule guess (?A ?B)
  :match  (and (is-a ?a ?A) (is-a ?b ?B))
  :assert (co-located ?a ?b)
  :why    "guess: are {?a} and {?b} co-located?")

(relation is-a       T T :why "{?3} is a {?4}")
(relation co-located T T :why "{?3} is co-located with {?4}")

(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a Drink T) (is-a Pet T) (is-a Smoke T)
(is-a Red  Color) (is-a Blue  Color)
(is-a Tea  Drink) (is-a Milk  Drink)
(is-a Cat  Pet)   (is-a Dog   Pet)
(is-a Pipe Smoke) (is-a Cigar Smoke)

(co-located Red Tea  :source "(1) the Red house drinks Tea")
(co-located Red Cat  :source "(2) the Red house keeps the Cat")
(co-located Red Pipe :source "(3) the Red house smokes a Pipe")

(solve
  :hrules (
    guess (Color Drink) guess (Color Pet) guess (Color Smoke)
    guess (Drink Pet)   guess (Drink Smoke) guess (Pet Smoke)))

(query
  :goal (and (co-located ?x Milk) (co-located ?x ?p) (is-a ?p Pet)))
