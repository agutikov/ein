;;; Ein — branching demo 12: a typed puzzle the blind enumerator solves.
;;;
;;; A no-hrule, NON-`T`-typed puzzle that solves via the blind
;;; hypothesis enumerator, the rung H is built by when a program
;;; declares no `(hrule …)`: its slots are real types, `House` and
;;; `Color`, never `T`.
;;;
;;; Why it exists
;;; -------------
;;; The blind enumerator is untyped (Q-M1e.12): it proposes type-wrong
;;; fillers too, `(color-of Red Blue)`, and here even the names the
;;; positional activators write, `(color-of 0 1)`. `typecheck-arg-0` /
;;; `typecheck-arg-1` are the contradiction rules that kill them, so the
;;; puzzle converges on the blind path all the same: of H's 51
;;; candidates, 47 die alone (`ein show hyps` lists them). The zebra
;;; puzzles are hrule-driven and never take this path; this file is the
;;; witness that a typed puzzle solves on it.
;;;
;;;
;;;
;;; Shape
;;; -----
;;; A 3×3 bijection `color-of : House → Color` with one anchor, H1 Red
;;; (below). That leaves a 2×2 residue the bijection cannot *force*, so
;;; the engine must *guess* a `(color-of H C)` (the blind enumerator's
;;; job), then the bijection machinery propagates: `functional-negative` /
;;; `injective-negative` close the row + column, `domain-elimination`
;;; forces the survivor once a house has a single colour left, and
;;; `functional` / `injective` kill any guess that collides. One guess +
;;; propagation gives a complete consistent model, and the residue has
;;; two: R's maximal line is two states, Blue at H2 and Green at H3, or
;;; the reverse, each reached by 3 commitments, 2 of them minimal.
;;; Uniqueness is NOT the point; *converging on the blind path* is.
;;;
;;; `ein solve` lists R, three states: ∅ and the two maximal ones, H1 Red
;;; in every one; `ein solve --maximal` lists the two.
;;;
;;;
;;;
;;;

;; ── Bijection violation rules (fire `(false)` on collision) ──
;; stdlib pattern-macro sugar — forall/unknown from the std.macro module.
(import std.macro :symbols (forall unknown))

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional: {?a} has both {?b} and {?c}.")

(rule injective (?R)
  :match  (and (?R ?a ?c) (?R ?b ?c) (neq ?a ?b))
  :assert (false)
  :why    "{?R} not injective: {?c} reached from both {?a} and {?b}.")

;; ── Negative-completion companions (assert the row/column nots) ──
(rule functional-negative (?R)
  :match  (and (?R ?a ?b)
               (relation ?R ?A ?B)
               (is-a ?b_other ?B)
               (neq ?b_other ?b))
  :assert (not (?R ?a ?b_other))
  :why    "{?R} functional: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a} {?b_other})).")

(rule injective-negative (?R)
  :match  (and (?R ?a ?b)
               (relation ?R ?A ?B)
               (is-a ?a_other ?A)
               (neq ?a_other ?a))
  :assert (not (?R ?a_other ?b))
  :why    "{?R} injective: ({?R} {?a} {?b}) ⟹ (not ({?R} {?a_other} {?b})).")

(rule derive-functional-negative ()
  :match  (functional ?R)
  :assert (functional-negative ?R)
  :why    "{?R} functional ⟹ functional-negative active.")

(rule derive-injective-negative ()
  :match  (injective ?R)
  :assert (injective-negative ?R)
  :why    "{?R} injective ⟹ injective-negative active.")

;; ── Domain elimination (force the survivor) + no-room-left ──
(rule domain-elimination (?R ?OT ?VT)
  :match  (and (functional ?R 0 1)
               (total      ?R 0)
               (is-a ?a ?OT)
               (is-a ?v ?VT)
               (forall ?v_other
                 (and (is-a ?v_other ?VT) (neq ?v_other ?v))
                 (not (?R ?a ?v_other))))
  :assert (?R ?a ?v)
  :why    "every {?VT} except {?v} excluded for {?a} → ({?R} {?a} {?v})")

(rule no-room-left (?R ?OT ?VT)
  :match  (and (functional ?R 0 1)
               (total      ?R 0)
               (is-a ?a ?OT)
               (forall ?v
                 (is-a ?v ?VT)
                 (not (?R ?a ?v))))
  :assert (false)
  :why    "{?a} has every {?VT} excluded — no value left")

;; ── Closed-world type checks (the post-(b) contradiction rules) ──
(rule typecheck-arg-0 (?R ?Dom)
  :match  (and (?R ?a ?b) (absent (is-a ?a ?Dom)))
  :assert (false)
  :why    "{?R} arg 0 expects {?Dom}; {?a} is not a {?Dom}")

(rule typecheck-arg-1 (?R ?Ran)
  :match  (and (?R ?a ?b) (absent (is-a ?b ?Ran)))
  :assert (false)
  :why    "{?R} arg 1 expects {?Ran}; {?b} is not a {?Ran}")

(relation color-of House Color :why "the colour of {?1} is {?2}")
(relation is-a     T T         :why "{?1} is a {?2}")

;; color-of is a bijection between House and Color.
(functional color-of)          ; violation-rule activator (2-arg)
(injective  color-of)
(functional color-of 0 1)       ; positional projection (domain-elim)
(total      color-of 0)

;; Opt color-of into elimination + the closed-world type checks.
;; `domain-elimination` is what positively *produces* a `color-of`
;; fact, once a house has one colour left. Nothing closes `color-of`:
;; only a `(__closed__ R)` fact closes a relation to the blind
;; enumerator, and this program writes one for `is-a` alone, so the
;; enumerator guesses `color-of`.
(domain-elimination color-of House Color)
(no-room-left       color-of House Color)
(typecheck-arg-0    color-of House)
(typecheck-arg-1    color-of Color)

;; `is-a` is the inheritance forest — fully given, never guessed.
;; Declare it closed so the blind enumerator only ever proposes
;; `color-of` hypotheses (the guessed relation stays open). Without
;; this the enumerator would speculate `(is-a X Y)` pairs and the
;; lattice would blow up: no relation is closed unless the program
;; says so, so the fixture declares it. (`color-of` is intentionally
;; NOT closed.)
(__closed__ is-a)

;; Type + instance hierarchy (3 houses, 3 colours).
(is-a House T) (is-a Color T)
(is-a H1 House) (is-a H2 House) (is-a H3 House)
(is-a Red Color) (is-a Green Color) (is-a Blue Color)

;; One anchor pins H1; that leaves a 2×2 residue (H2,H3 × Green,Blue)
;; that the bijection can't fully *force* without a guess — so the
;; blind enumerator must propose `(color-of H2 …)`, and `solve`
;; branches. Keeping it to a single residual guess keeps the lattice
;; tiny while still exercising the blind path.
(color-of H1 Red :source "(1) H1 is Red")

(query
  :goal (color-of ?h ?c))
