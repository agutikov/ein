;;; Branching demo 7 — one of a pair with `06_lookahead_on.ein`.
;;;
;;; 06_lookahead_on.ein and 07_lookahead_off.ein are the same program, byte
;;; for byte outside their comments, and the witnesses of regressions
;;; branching-06 and branching-07: no flag tells them apart, since no
;;; flag changes R (docs/ein/user/reference/config.md § 2.5).
;;;
;;; The puzzle: five colours, five houses, four colours anchored.
;;; Blue is the lone unanchored colour and must take the one free
;;; house, H5. The hypothesis generator emits `(co-located Blue Hk)`
;;; for k = 1..5. Four of them are *doomed*: placing Blue in an
;;; already-occupied house Hk chains, in ONE rule firing against the
;;; already-saturated root KB,
;;;
;;;     (co-located Blue Hk)        -- the hypothesis
;;;   + (co-located Hk Ck)          -- symmetric of the Ck↔Hk anchor
;;;   ⇒ transitive ⇒ (co-located Blue Ck)
;;;
;;; and `(not (co-located Blue Ck))` was already derived by
;;; `sibling-exclusive` (Blue and Ck are both Colours). Each doomed
;;; candidate dies alone, and how many firings its death takes moves
;;; nothing in R.
;;;
;;; `co-located` relates a Color to a House, `(relation co-located Color
;;; House)`, as `04_two_levels.ein`'s signature does. A name a relation
;;; signature declares is no candidate object, so the blind enumerator
;;; guesses over the ten leaves alone: H is 132 candidates (42 of
;;; co-located, 90 of is-a), 130 of them dead alone, and R is two states
;;; over four commitments, ∅ and the state three commitments reach,
;;; {(co-located Blue H5)} with its mirror: Blue in the one free house,
;;; ?h = H5, as derived above. `ein solve --maximal` lists that one state,
;;; and `--single` says Ambiguity because ∅ is in R too. No `types` row:
;;; nothing H proposes names a type.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

;; With `(relation co-located T T)` the program would be under-specified
;; (Q-M1e.12): it admits `(co-located Blue Color)`, the engine does what the
;; signature says, and the blind enumerator, which is untyped, binds the
;; names on the right of an is-a as objects. On that shape the read-out
;; prints a `types` row under `universe`
;; (`ein solve examples/branching/02_one_dead_one_alive.ein` is one).
;;
;; `ein solve` on this file prints, among its rows:
;;
;;   states (k_s)      2
;;   commitments (k_c) 4
;;   ∅                 in R — root is alive and owes nothing
;;   maximal line      1 state
;;   merged            1 state reached by more than one commitment, with 2 minimal
;;   lattice           monotone (the static check) — R is convex: no hole
;;   universe          132 candidates, 130 dead alone
;;
;; Every candidate but Blue's placement in H5 and its mirror dies alone. R's
;; four commitments are ∅ and the three that reach its second state: the two
;; mirrors of that placement, each minimal, and the two together. The query
;; answers ?h = H5 in that state; in ∅, which places Blue nowhere, the goal
;; has no row.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric")

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive")

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "{?a} and {?b} share {?T} — exclusive under {?exclusive-under}.")

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional")

(relation is-a       T T         :why "{?1} is a {?2}")
(relation co-located Color House :why "{?1} is co-located with {?2}")

(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a House T)
(is-a Red    Color) (is-a Green Color) (is-a Ivory  Color)
(is-a Yellow Color) (is-a Blue  Color)
(is-a H1 House) (is-a H2 House) (is-a H3 House)
(is-a H4 House) (is-a H5 House)

(co-located Red    H1 :source "(1)")
(co-located Green  H2 :source "(2)")
(co-located Ivory  H3 :source "(3)")
(co-located Yellow H4 :source "(4)")

(query
  :goal (co-located Blue ?h))
