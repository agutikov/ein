;;; Branching demo 9 — generation by a hypothesis rule.
;;;
;;; With no hypothesis rule, H comes from the blind combinatorial enumerator.
;;; Here a *hypothesis rule* takes over: `guess` is a rule whose conclusion is
;;; a hypothesis, `(open (?R ?x1 ?x2))`, activated by the fact `(guess
;;; co-located Color House)`. What it concludes under `open` is a
;;; *candidate*, and no saturation stores it: a hypothesis is a speculation,
;;; not an entailment, which a commitment may add and nothing derives.
;;;
;;;
;;; A rule that writes an `open` fact at root takes the blind enumerator's
;;; place, and every candidate comes from the rule: `ein show hyps` says H is
;;; from `hypothesis-rules`, and lists exactly its (Color, House) pairs that
;;; root does not already hold, seven of them.
;;;
;;; This basic hypothesis rule reproduces the enumerator's `co-located`
;;; candidates — the point is the *mechanism*. A smarter hypothesis rule
;;; could exploit puzzle structure the blind enumerator cannot
;;; express (e.g. guess only for the most-constrained object).
;;;
;;; R is ∅ and {(co-located Blue H3)}: ?h = H3 in its one maximal state.

;; A fact beside its stored negation is a contradiction by this module's rules (Q-M1f.557).
(import std.contradiction)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric")

(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive")

(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "{?a} and {?b} share {?T} — exclusive under {?exclusive-under}.")

(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional")

;; ── The hypothesis rule. Every (Color, House) pair is a
;; ── co-located candidate. Saturation never fires a hypothesis rule;
;; ── the hypothesis layer runs it to build H.
(rule guess (?R ?T1 ?T2)
  :match  (and (is-a ?x1 ?T1) (is-a ?x2 ?T2))
  :assert (open (?R ?x1 ?x2))
  :why    "guess: is {?x1} {?R} with {?x2}?")

(relation is-a       T T :why "{?3} is a {?4}")
(relation co-located T T :why "{?3} is co-located with {?4}")

(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a House T)
(is-a Red Color) (is-a Green Color) (is-a Blue Color)
(is-a H1 House) (is-a H2 House) (is-a H3 House)

(co-located Red   H1 :source "(1)")
(co-located Green H2 :source "(2)")

(guess co-located Color House)

(query
  :goal (co-located Blue ?h)
)
