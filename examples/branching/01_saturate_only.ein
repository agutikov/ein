;;; Branching demo 1 of 5 — minimal branching: saturation answers the
;;; query at root, and every candidate the blind enumerator proposes
;;; dies alone, so R is root alone.
;;;
;;; Two colors, two drinks. Both pairings given. The query asks who
;;; drinks Coffee. Symmetric closure on co-located makes the goal
;;; pattern match at root.
;;;
;;; The blind enumerator still proposes candidates for the program's
;;; names: 12 `(is-a X Y)` alternate parents, which `functional` kills,
;;; and 4 `co-located` pairs that contradict the given pairings. Every
;;; one of the 16 dies alone (`ein show hyps` lists them), so R is the
;;; one state ∅, root itself, alive and owing nothing.
;;;
;;; Expected shape: one state, ?c=Blue. `ein solve` says so: its
;;; minimal and maximal line are both ∅, and its universe is 16
;;; candidates, 16 dead alone. `(__closed__ is-a)` would take is-a out
;;; of the enumeration; this file leaves it in, so the deaths show.
;;;

;; A fact beside its stored negation is a contradiction by this module's rules (Q-M1f.557).
(import std.contradiction)

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} is symmetric: {?a} ↔ {?b}.")
(rule transitive (?rel)
  :match  (and (?rel ?a ?b) (?rel ?b ?c) (neq ?a ?c))
  :assert (?rel ?a ?c)
  :why    "{?rel} transitive")
(rule sibling-exclusive (?siblings-via ?exclusive-under)
  :match  (and (?siblings-via ?a ?T) (?siblings-via ?b ?T) (neq ?a ?b))
  :assert (not (?exclusive-under ?a ?b))
  :why    "{?a} and {?b} share {?T} — exclusive under {?exclusive-under}.")
(rule functional (?R)
  :match  (and (?R ?a ?b) (?R ?a ?c) (neq ?b ?c))
  :assert (false)
  :why    "{?R} not functional: {?a} has {?b} and {?c}.")

(relation is-a       T T :why "{?3} is a {?4}")
;; `co-located` relates a Color to a Drink; the typed
;; signature lets hypgen's name-free candidate set exclude the type
;; atoms (`Color`/`Drink`/`T`) so only leaf instances are guessed
;; (no kernel `is-a` read; signature is object-selection metadata).
(relation co-located Color Drink :why "{?3} is co-located with {?4}")
(symmetric         co-located)
(transitive        co-located)
(sibling-exclusive is-a co-located)
(functional        is-a)

(is-a Color T) (is-a Drink T)
(is-a Red    Color) (is-a Blue   Color)
(is-a Tea    Drink) (is-a Coffee Drink)

(co-located Red  Tea    :source "(1)")
(co-located Blue Coffee :source "(2)")

(query
  :goal (co-located ?c Coffee))
