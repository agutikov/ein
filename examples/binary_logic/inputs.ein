;;; Inputs as hypotheses: an input wire has exactly one value, and which one
;;; is for the search to try. The theory the search applications share.
;;;
;;;   (is-a WIRE Input)   written by a program: this wire is an input
;;;   (in WIRE BIT)       a hypothesis: the input is set to the bit
;;;
;;; *Exactly one* is two declarations of `std.algebra` over a typed relation.
;;; `(total-owed in is-a)` says every input owes a value, so a state with an
;;; input unset is not an answer; `(functional in)` says none has two. The
;;; obligation is also what proposes the candidates: two an input, (in w 0)
;;; and (in w 1), and no other fact is ever guessed.
;;;
;;; So R is the input assignments that contradict nothing. A node of the
;;; search is a partial assignment, each input unset, 0 or 1: describing R
;;; over n inputs is some 3^n saturations, which is why the programs here
;;; have three inputs, and why a truth table of many inputs is better written
;;; as test vectors (`adder_against_table.ein`).
;;;
;;; The other encoding, one candidate an input with 0 read by `absent`, is not
;;; here: it is refused at load or gives stale facts (the plan page, § 5.2).
;;;
;;; One name brings it and the circuit theory: (import inputs :symbols
;;; (inputs in is-a total-owed functional in-drives)). The closing rule names
;;; `circuit`'s entry, without which a flat import would leave that theory's
;;; rules behind in silence (E-20 of the phase's `findings.md`).
;;;
;;; M1f P1f.6 (S1f.6.17): `plans/…/p1f.6_calculator/binary_logic.md` § 5.2.
(import circuit :symbols (circuit))
(import std.algebra :symbols (total-owed functional))
(relation is-a Thing Type
  :why "{?1} is a {?2}")
(relation in Input Bit
  :why "the input {?1} is set to {?2}")
(is-a 0 Bit) (is-a 1 Bit)
(total-owed in is-a)     ; every input owes a value: a state with an input unset is not an answer
(functional in)          ; and none has two
(rule in-drives ()
  :match  (in ?w ?v)
  :assert (val ?w ?v)
  :why    "the input {?w} is set to {?v}")
(relation inputs-rule Rule
  :why "{?1} is a rule of the inputs theory")
(inputs-rule inputs)
(rule inputs ()
  :match  ()
  :assert (and (__closed__ is-a) (__closed__ inputs-rule) (inputs-rule in-drives) (circuit-rule circuit))
  :why    "types are written, never guessed")
