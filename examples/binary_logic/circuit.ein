;;; A circuit as a program: wires are names, a gate is a fact, and one rule
;;; carries values from a gate's inputs to its output.
;;;
;;;   (gate INSTANCE FUNCTION IN1 IN2 OUT)   a gate of the circuit; FUNCTION is
;;;                                          one of the sixteen of `gates.ein`
;;;   (val WIRE BIT)                         the wire carries the bit
;;;
;;; Saturation is then simulation: `propagate` fires once for a gate whose
;;; two inputs carry a value, looking the function up in the table. A wire
;;; that carries both bits is a contradiction, `one-value`.
;;;
;;; One name brings the theory: (import circuit :symbols (circuit)). `circuit`
;;; is the closing rule: gates are written and values derived, never guessed.
;;;
;;; M1f P1f.6 (S1f.6.17): `plans/…/p1f.6_calculator/binary_logic.md` § 3.
(import gates :symbols (gate2 inv le bit column-name __closed__))
(relation gate Instance Function Wire Wire Wire
  :why "{?1} is a {?2} gate from {?3} and {?4} to {?5}")
(relation val Wire Bit
  :why "{?1} carries {?2}")
(rule propagate ()
  :match  (and (gate ?g ?f ?a ?b ?o) (val ?a ?x) (val ?b ?y) (gate2 ?f ?x ?y ?z))
  :assert (val ?o ?z)
  :why    "{?g}: {?f} of {?x} and {?y} is {?z}, on {?o}")
(rule one-value ()
  :match  (and (val ?w ?x) (val ?w ?y) (neq ?x ?y))
  :assert (false)
  :why    "the wire {?w} carries both {?x} and {?y}")
(relation circuit-rule Rule
  :why "{?1} is a rule of the circuit theory")
(circuit-rule circuit)
(rule circuit ()
  :match  ()
  :assert (and (__closed__ gate) (__closed__ val) (__closed__ circuit-rule)
               (circuit-rule propagate) (circuit-rule one-value))
  :why    "a circuit is simulated and never guessed")
