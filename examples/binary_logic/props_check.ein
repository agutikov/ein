;;; The check of `props.ein`: the rules of `props_rules.ein` derive, from the
;;; 64 rows of `gates.ein`, exactly the facts `props.ein` writes out.
;;; GENERATED by `examples/binary_logic/gen_gates.py`, with `props.ein`, from
;;; the same columns.
;;;
;;; One query a relation, each with its claim. A claim that names a relation
;;; closes it, so each holds only if the rules derive every listed fact and
;;; no other: Python's count from the columns and Ein's derivation from the
;;; rows agree on all thirty relations and on the sixteen columns.
;;;
;;;   ein test examples/binary_logic/props_check.ein
;;;
;;; Search-free: every relation is closed, so there is no candidate, one
;;; state and one saturation.
;;;
;;; M1f P1f.6 (S1f.6.17): `plans/…/p1f.6_calculator/binary_logic.md`.
(import props_rules :symbols (props-derived))
(query :goal (column ?a ?b ?c ?d ?e)
       :expect (model (column And 0 0 0 1) (column Andn 0 0 1 0) (column Fst 0 0 1 1)
                      (column Nand 1 1 1 0) (column Nfst 1 1 0 0) (column Nor 1 0 0 0)
                      (column Nsnd 1 0 1 0) (column One 1 1 1 1) (column Or 0 1 1 1)
                      (column Orn 1 0 1 1) (column Randn 0 1 0 0) (column Rorn 1 1 0 1)
                      (column Snd 0 1 0 1) (column Xnor 1 0 0 1) (column Xor 0 1 1 0)
                      (column Zero 0 0 0 0)))
(query :goal (swap-of ?a ?b)
       :expect (model (swap-of And And) (swap-of Andn Randn) (swap-of Fst Snd) (swap-of Nand Nand)
                      (swap-of Nfst Nsnd) (swap-of Nor Nor) (swap-of Nsnd Nfst) (swap-of One One)
                      (swap-of Or Or) (swap-of Orn Rorn) (swap-of Randn Andn) (swap-of Rorn Orn)
                      (swap-of Snd Fst) (swap-of Xnor Xnor) (swap-of Xor Xor) (swap-of Zero Zero)))
(query :goal (complement-of ?a ?b)
       :expect (model (complement-of And Nand) (complement-of Andn Rorn) (complement-of Fst Nfst)
                      (complement-of Nand And) (complement-of Nfst Fst) (complement-of Nor Or)
                      (complement-of Nsnd Snd) (complement-of One Zero) (complement-of Or Nor)
                      (complement-of Orn Randn) (complement-of Randn Orn) (complement-of Rorn Andn)
                      (complement-of Snd Nsnd) (complement-of Xnor Xor) (complement-of Xor Xnor)
                      (complement-of Zero One)))
(query :goal (dual-of ?a ?b)
       :expect (model (dual-of And Or) (dual-of Andn Orn) (dual-of Fst Fst) (dual-of Nand Nor)
                      (dual-of Nfst Nfst) (dual-of Nor Nand) (dual-of Nsnd Nsnd) (dual-of One Zero)
                      (dual-of Or And) (dual-of Orn Andn) (dual-of Randn Rorn) (dual-of Rorn Randn)
                      (dual-of Snd Snd) (dual-of Xnor Xor) (dual-of Xor Xnor) (dual-of Zero One)))
(query :goal (left-negated ?a ?b)
       :expect (model (left-negated And Randn) (left-negated Andn Nor) (left-negated Fst Nfst)
                      (left-negated Nand Orn) (left-negated Nfst Fst) (left-negated Nor Andn)
                      (left-negated Nsnd Nsnd) (left-negated One One) (left-negated Or Rorn)
                      (left-negated Orn Nand) (left-negated Randn And) (left-negated Rorn Or)
                      (left-negated Snd Snd) (left-negated Xnor Xor) (left-negated Xor Xnor)
                      (left-negated Zero Zero)))
(query :goal (right-negated ?a ?b)
       :expect (model (right-negated And Andn) (right-negated Andn And) (right-negated Fst Fst)
                      (right-negated Nand Rorn) (right-negated Nfst Nfst) (right-negated Nor Randn)
                      (right-negated Nsnd Snd) (right-negated One One) (right-negated Or Orn)
                      (right-negated Orn Or) (right-negated Randn Nor) (right-negated Rorn Nand)
                      (right-negated Snd Nsnd) (right-negated Xnor Xor) (right-negated Xor Xnor)
                      (right-negated Zero Zero)))
(query :goal (commutative ?a)
       :expect (model (commutative And) (commutative Nand) (commutative Nor) (commutative One)
                      (commutative Or) (commutative Xnor) (commutative Xor) (commutative Zero)))
(query :goal (associative ?a)
       :expect (model (associative And) (associative Fst) (associative One) (associative Or)
                      (associative Snd) (associative Xnor) (associative Xor) (associative Zero)))
(query :goal (idempotent ?a)
       :expect (model (idempotent And) (idempotent Fst) (idempotent Or) (idempotent Snd)))
(query :goal (reads-first ?a)
       :expect (model (reads-first And) (reads-first Andn) (reads-first Fst) (reads-first Nand)
                      (reads-first Nfst) (reads-first Nor) (reads-first Or) (reads-first Orn)
                      (reads-first Randn) (reads-first Rorn) (reads-first Xnor) (reads-first Xor)))
(query :goal (reads-second ?a)
       :expect (model (reads-second And) (reads-second Andn) (reads-second Nand) (reads-second Nor)
                      (reads-second Nsnd) (reads-second Or) (reads-second Orn) (reads-second Randn)
                      (reads-second Rorn) (reads-second Snd) (reads-second Xnor) (reads-second Xor)))
(query :goal (ignores-first ?a)
       :expect (model (ignores-first Nsnd) (ignores-first One) (ignores-first Snd)
                      (ignores-first Zero)))
(query :goal (ignores-second ?a)
       :expect (model (ignores-second Fst) (ignores-second Nfst) (ignores-second One)
                      (ignores-second Zero)))
(query :goal (right-identity-of ?a ?b)
       :expect (model (right-identity-of And 1) (right-identity-of Andn 0)
                      (right-identity-of Fst 0) (right-identity-of Fst 1) (right-identity-of Or 0)
                      (right-identity-of Orn 1) (right-identity-of Xnor 1)
                      (right-identity-of Xor 0)))
(query :goal (left-identity-of ?a ?b)
       :expect (model (left-identity-of And 1) (left-identity-of Or 0) (left-identity-of Randn 0)
                      (left-identity-of Rorn 1) (left-identity-of Snd 0) (left-identity-of Snd 1)
                      (left-identity-of Xnor 1) (left-identity-of Xor 0)))
(query :goal (identity-of ?a ?b)
       :expect (model (identity-of And 1) (identity-of Or 0) (identity-of Xnor 1)
                      (identity-of Xor 0)))
(query :goal (right-absorbing-of ?a ?b)
       :expect (model (right-absorbing-of And 0) (right-absorbing-of One 1)
                      (right-absorbing-of Or 1) (right-absorbing-of Randn 0)
                      (right-absorbing-of Rorn 1) (right-absorbing-of Snd 0)
                      (right-absorbing-of Snd 1) (right-absorbing-of Zero 0)))
(query :goal (left-absorbing-of ?a ?b)
       :expect (model (left-absorbing-of And 0) (left-absorbing-of Andn 0)
                      (left-absorbing-of Fst 0) (left-absorbing-of Fst 1) (left-absorbing-of One 1)
                      (left-absorbing-of Or 1) (left-absorbing-of Orn 1) (left-absorbing-of Zero 0)))
(query :goal (absorbing-of ?a ?b)
       :expect (model (absorbing-of And 0) (absorbing-of One 1) (absorbing-of Or 1)
                      (absorbing-of Zero 0)))
(query :goal (preserves-zero ?a)
       :expect (model (preserves-zero And) (preserves-zero Andn) (preserves-zero Fst)
                      (preserves-zero Or) (preserves-zero Randn) (preserves-zero Snd)
                      (preserves-zero Xor) (preserves-zero Zero)))
(query :goal (preserves-one ?a)
       :expect (model (preserves-one And) (preserves-one Fst) (preserves-one One)
                      (preserves-one Or) (preserves-one Orn) (preserves-one Rorn)
                      (preserves-one Snd) (preserves-one Xnor)))
(query :goal (monotone ?a)
       :expect (model (monotone And) (monotone Fst) (monotone One) (monotone Or) (monotone Snd)
                      (monotone Zero)))
(query :goal (affine ?a)
       :expect (model (affine Fst) (affine Nfst) (affine Nsnd) (affine One) (affine Snd)
                      (affine Xnor) (affine Xor) (affine Zero)))
(query :goal (self-dual ?a)
       :expect (model (self-dual Fst) (self-dual Nfst) (self-dual Nsnd) (self-dual Snd)))
(query :goal (escapes-zero ?a)
       :expect (model (escapes-zero Nand) (escapes-zero Nfst) (escapes-zero Nor)
                      (escapes-zero Nsnd) (escapes-zero One) (escapes-zero Orn) (escapes-zero Rorn)
                      (escapes-zero Xnor)))
(query :goal (escapes-one ?a)
       :expect (model (escapes-one Andn) (escapes-one Nand) (escapes-one Nfst) (escapes-one Nor)
                      (escapes-one Nsnd) (escapes-one Randn) (escapes-one Xor) (escapes-one Zero)))
(query :goal (escapes-monotone ?a)
       :expect (model (escapes-monotone Andn) (escapes-monotone Nand) (escapes-monotone Nfst)
                      (escapes-monotone Nor) (escapes-monotone Nsnd) (escapes-monotone Orn)
                      (escapes-monotone Randn) (escapes-monotone Rorn) (escapes-monotone Xnor)
                      (escapes-monotone Xor)))
(query :goal (escapes-affine ?a)
       :expect (model (escapes-affine And) (escapes-affine Andn) (escapes-affine Nand)
                      (escapes-affine Nor) (escapes-affine Or) (escapes-affine Orn)
                      (escapes-affine Randn) (escapes-affine Rorn)))
(query :goal (escapes-self-dual ?a)
       :expect (model (escapes-self-dual And) (escapes-self-dual Andn) (escapes-self-dual Nand)
                      (escapes-self-dual Nor) (escapes-self-dual One) (escapes-self-dual Or)
                      (escapes-self-dual Orn) (escapes-self-dual Randn) (escapes-self-dual Rorn)
                      (escapes-self-dual Xnor) (escapes-self-dual Xor) (escapes-self-dual Zero)))
(query :goal (complete-alone ?a)
       :expect (model (complete-alone Nand) (complete-alone Nor)))
