;;; Application 3, an unsatisfiable question: sum bit 1 and carry out 1, and
;;; yet not both a and b. No input does it.
;;;
;;; R is empty, and it is empty in the way a search is, not as a refuted
;;; program is. Every total assignment is dead. The partial ones that
;;; contradict nothing are alive, and each owes an input it cannot be given.
;;; So the read-out says *empty: every alive node owes*, not *every node is
;;; dead*, and `ein solve --single` answers `Open`, with *decided: yes*. That
;;; is the word's definition and not what a reader of a satisfiability
;;; question expects: E-23 of the phase's `findings.md`, and the plan page's
;;; sixth question, open.
;;;
;;; The claims are the ones that hold. The region claim lists the owing
;;; frontier, the eleven nodes of two inputs set that are alive (the twelfth,
;;; a = 1 and b = 1, is dead: it makes g1 1). The query's claim, `(false)`,
;;; holds because no state answers it.
;;;
;;; The reasons are in the dump and not in the read-out: `--dump-answer DIR`
;;; writes ten minimal dead sets to `nogoods.json`, each with its core, the
;;; gates, the table rows and the requirement a refutation used.
;;;
;;; Both claims were computed in Python by enumeration.
;;;
;;; M1f P1f.6 (S1f.6.17): `plans/…/p1f.6_calculator/binary_logic.md` § 5.3.
(import require :symbols (requirements require inputs in is-a total-owed functional in-drives))
(import full_adder :symbols (gate))

(is-a a Input) (is-a b Input) (is-a cin Input)
(require sum 1) (require cout 1) (require g1 0)

(solve :expect (region (owing (model (in a 0) (in b 0))
                               (model (in a 0) (in b 1))
                               (model (in a 0) (in cin 0))
                               (model (in a 0) (in cin 1))
                               (model (in a 1) (in b 0))
                               (model (in a 1) (in cin 0))
                               (model (in a 1) (in cin 1))
                               (model (in b 0) (in cin 0))
                               (model (in b 0) (in cin 1))
                               (model (in b 1) (in cin 0))
                               (model (in b 1) (in cin 1)))))

(query :goal (and (in a ?a) (in b ?b) (in cin ?c))
       :goal-text "a = {?a}, b = {?b}, carry in = {?c}"
       :expect (false))
