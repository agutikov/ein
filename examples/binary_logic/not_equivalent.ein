;;; Application 4, two circuits that are not equivalent: the adder's carry out
;;; against a or b. R is where they differ.
;;;
;;; The same miter as `equivalent.ein`. Two states: at a = 0, b = 1,
;;; carry in = 0 and at a = 1, b = 0, carry in = 0 the carry is 0 and a or b
;;; is 1. Each state is a counterexample.
;;;
;;; The claim was computed in Python by enumeration.
;;;
;;; M1f P1f.6 (S1f.6.17): `plans/…/p1f.6_calculator/binary_logic.md` § 5.4.
(import require :symbols (requirements require))
(import full_adder :symbols (gate))
(import inputs :symbols (is-a in))

(is-a a Input) (is-a b Input) (is-a cin Input)
(gate m1 Or a b ob)             ; a or b
(gate miter Xor cout ob diff)   ; 1 where the carry and a or b differ
(require diff 1)

(query :goal (and (in a ?a) (in b ?b) (in cin ?c))
       :goal-text "they differ at a = {?a}, b = {?b}, carry in = {?c}"
       :expect (or (model (in a 0) (in b 1) (in cin 0))
                   (model (in a 1) (in b 0) (in cin 0))))
