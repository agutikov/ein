;;; 14_seats_nothing_proposes — a debt some of whose witnesses nothing can hold.
;;;
;;; 06_friends_tables_everyone_sits.ein made small enough for `ein oracle`: the pair (Ann, Bob)
;;; fits both tables, the duo (Cat, Dan) only the big one, each table has two seats, and everyone
;;; owes a seat (`total-owed`). The hrule proposes a friend only the seats of a table their group
;;; fits, 12 candidates; the obligation proposes beside it every seat that would pay a debt
;;; (Q-M1f.570), so `(sits Cat S1)`, `(sits Cat S2)`, `(sits Dan S1)` and `(sits Dan S2)`, the
;;; seats the hrule's guard leaves out, are candidates too: 16.
;;;
;;; What it was the witness of: the obligation tree may branch a state that owes Cat a seat on
;;; the candidates that pay it alone. With the union, every fact that pays a debt is a candidate.
;;;
;;; R: the pair at one table and the duo at the other, each in either order, 8 states. Four at
;;; two seats is dead.

(import std.algebra :symbols (functional injective total-owed))

(relation is-a   T T          :why "{?3} is a {?4}")
(relation member Friend Group :why "{?3} is a member of {?4}")
(relation at     Seat Table   :why "seat {?3} is at table {?4}")
(relation fits   Group Table  :why "group {?3} fits at table {?4}")
(relation sits   Friend Seat  :why "{?3} sits in seat {?4}")

(is-a Ann Friend) (is-a Bob Friend) (is-a Cat Friend) (is-a Dan Friend)
(is-a S1 Seat) (is-a S2 Seat) (is-a B1 Seat) (is-a B2 Seat)
(is-a Pair Group) (is-a Duo Group)
(is-a Small Table) (is-a Big Table)

(member Ann Pair) (member Bob Pair)
(member Cat Duo)  (member Dan Duo)
(at S1 Small) (at S2 Small)
(at B1 Big)   (at B2 Big)
(fits Pair Small) (fits Pair Big) (fits Duo Big)

(functional sits)
(injective  sits)
(total-owed sits is-a)

(rule together ()
  :match  (and (sits ?a ?s) (sits ?b ?t)
               (member ?a ?g) (member ?b ?g)
               (at ?s ?x) (at ?t ?y) (neq ?x ?y))
  :assert (false)
  :why    "{?a} and {?b} are friends and sit at different tables")

(hrule seat ()
  :match  (and (member ?p ?g) (fits ?g ?t) (at ?s ?t))
  :assert (sits ?p ?s)
  :why    "guess that {?p} sits in seat {?s}, at table {?t}, which {?p}'s group {?g} fits")

(solve
  :hrules (seat)
  :expect (region
            (model (sits Ann B1) (sits Bob B2) (sits Cat S1) (sits Dan S2))
            (model (sits Ann B1) (sits Bob B2) (sits Cat S2) (sits Dan S1))
            (model (sits Ann B2) (sits Bob B1) (sits Cat S1) (sits Dan S2))
            (model (sits Ann B2) (sits Bob B1) (sits Cat S2) (sits Dan S1))
            (model (sits Ann S1) (sits Bob S2) (sits Cat B1) (sits Dan B2))
            (model (sits Ann S1) (sits Bob S2) (sits Cat B2) (sits Dan B1))
            (model (sits Ann S2) (sits Bob S1) (sits Cat B1) (sits Dan B2))
            (model (sits Ann S2) (sits Bob S1) (sits Cat B2) (sits Dan B1))))

(query :goal (sits ?who ?where))
