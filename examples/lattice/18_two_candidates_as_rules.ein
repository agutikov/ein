;;; 18_two_candidates_as_rules — 18_two_candidates.ein's lattice written as rules: every state
;;; a world, the whole lattice in one saturation, and no search.
;;;
;;; A world is a fact naming its commitment, `(w)`, `(w (s a))`, `(w (s a) (s b))`, and
;;; `(in W F)` says that world W holds F. The candidates are written as facts of the program,
;;; `(question (s a))` and `(question (s b))`: the hypotheses the object program's root holds
;;; as `(open (s a))` and `(open (s b))`. A rule that read those `open` facts themselves would
;;; make the program one the static check flags (Q-M1f.569). `split-1` and `split-2` make a
;;; world of each set of candidates, in the order `before` gives, so a set has one name. The
;;; object program's rule is written again under `(in ?w …)` by hand, `clash-in`; its
;;; requirement and what pays it are `paid-in`. Each verdict is then a fact about a world:
;;;
;;;   - `(in W (false))`: W is dead, the object program's minimal dead set;
;;;   - `(owes W)`: W is alive and pays nothing, as the object program's root;
;;;   - `(in-R W)`: W is alive and owes nothing, a state of the object program's R.
;;;
;;; `possible` is a fact inferred from the search: F holds in some state of R. `(solve
;;; :no-search)` makes root the whole lattice, so the answer is root's facts, and the claims
;;; below state them as `ein oracle` answers the object program.
;;;
;;; Not written here: what holds in every state of R, which reads `in-R` under a second
;;; `absent`, one stratum above it.

(relation s        Thing       :why "s holds of {?3}")
(relation question Fact        :why "{?3} is a candidate")
(relation world    World       :why "{?3} is a world")
(relation in       World Fact  :why "{?3} holds {?4}")
(relation paid     World       :why "{?3} pays what is owed")
(relation owes     World       :why "{?3} is alive and owes")
(relation in-R     World       :why "{?3} is alive and owes nothing")
(relation possible Fact        :why "{?3} holds in some state of R")

;; the object program's things; the candidates, and an order on them
(thing a) (thing b)
(question (s a)) (question (s b))
(before (s a) (s b))

;; the worlds: root, and one for each set of candidates
(world (w))
(rule split-1 ()
  :match  (question ?f)
  :assert (and (world (w ?f)) (in (w ?f) ?f))
  :why    "the world that supposes {?f}")
(rule split-2 ()
  :match  (and (question ?f) (question ?g) (before ?f ?g))
  :assert (and (world (w ?f ?g)) (in (w ?f ?g) ?f) (in (w ?f ?g) ?g))
  :why    "the world that supposes {?f} and {?g}")

;; the object program's rule, lifted into a world by hand
(rule clash-in ()
  :match  (and (in ?w (s a)) (in ?w (s b)))
  :assert (in ?w (false))
  :why    "in {?w}: s of a and of b")

;; the requirement and its payment
(rule paid-in ()
  :match  (in ?w (s ?x))
  :assert (paid ?w)
  :why    "{?w} holds s of {?x}")

;; the verdicts, each a fact about a world
(rule owes ()
  :match  (and (world ?w) (absent (paid ?w)) (absent (in ?w (false))))
  :assert (owes ?w)
  :why    "{?w} is alive and pays nothing")
(rule in-R ()
  :match  (and (world ?w) (paid ?w) (absent (in ?w (false))))
  :assert (in-R ?w)
  :why    "{?w} is alive and owes nothing")

;; a fact inferred from the search
(rule possible ()
  :match  (and (in-R ?w) (in ?w ?f))
  :assert (possible ?f)
  :why    "{?f} holds in {?w}, a state of R")

(solve :no-search)

(query :goal (in-R ?w)
  :expect (model (in-R (w (s a))) (in-R (w (s b)))))
(query :goal (in ?w (false))
  :expect (model (in (w (s a) (s b)) (false))))
(query :goal (owes ?w)
  :expect (model (owes (w))))
(query :goal (possible ?f)
  :expect (model (possible (s a)) (possible (s b))))
