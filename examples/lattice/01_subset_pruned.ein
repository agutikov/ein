;;; Lattice fixture — a dead pair, and every superset of it dead with it.
;;;
;;; Demonstrates: once {a, b} is dead, every commitment that holds both is
;;; dead too — dead is upward-closed — so the cube's {a, b, c}, {a, b, d}
;;; and {a, b, c, d} are classified without a saturation of their own: a
;;; route that knows the minimal dead set {a, b} reads their class off it.
;;; Subsumption by a dead set is what makes the pruning combinatorial: one
;;; refuted pair removes every superset, which no per-set forking can
;;; match.
;;;
;;; Four hypothesis candidates: (proposed a), (proposed b),
;;; (proposed c), (proposed d). A single (incompat a b) fact in
;;; root + the incompat-block rule says "if both a and b are
;;; proposed, false". So, the cube layer by layer:
;;;
;;;   Layer 0 — root, ∅, alive.
;;;   Layer 1 — 4 alive singletons.
;;;   Layer 2 — 6 pairs; {a,b} dies (incompat-block fires);
;;;             5 alive pairs.
;;;   Layer 3 — {a,c,d} and {b,c,d} alive; {a,b,c} and {a,b,d}
;;;             hold the dead pair, and are dead.
;;;   Layer 4 — {a,b,c,d}, dead the same way.
;;;
;;; What `ein solve` reports:
;;;
;;;   states (k_s)     12, every node but the four that hold {a, b}
;;;   maximal line     {a, c, d} and {b, c, d}: two maximal states,
;;;                    which `ein solve --maximal` lists. Regression
;;;                    lattice-01-L; the region is Q-M1e2.7.
;;;   components       1; sub-cubes 2, each of dimension 3: the cube
;;;                    below {a, c, d} and the cube below {b, c, d}
;;;   N                1 minimal dead set, {(proposed a), (proposed b)}
;;;   work             13 saturations: root, then 4, 6 and 2; the three
;;;                    dead supersets of {a, b} take none
;;;
;;;
;;; R's states, as `ein solve` lists them: ∅; {a}, {b}, {c}, {d};
;;; {a,c}, {a,d}, {b,c}, {b,d}, {c,d}; and the two maximal ones.
;;;
;;; `ein render lattice` draws the same shape as a node-coloured lattice.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(rule symmetric (?rel)
  :match  (?rel ?a ?b)
  :assert (?rel ?b ?a)
  :why    "{?rel} symmetric: {?a} ↔ {?b}")

(rule incompat-block ()
  :match  (and (incompat ?a ?b)
               (proposed ?a)
               (proposed ?b)
               (neq ?a ?b))
  :assert (false)
  :why    "{?a} and {?b} are jointly forbidden by an incompat fact")

(hrule guess (?R ?T)
  :match  (is-a ?x ?T)
  :assert (?R ?x)
  :why    "guess: is {?x} {?R}?")

(relation is-a     T T :why "{?1} is a {?2}")
(relation proposed T   :why "{?1} is proposed")
(relation incompat T T :why "{?1} and {?2} may not both be proposed")

(symmetric incompat)

(is-a Custom T)
(is-a a      Custom)
(is-a b      Custom)
(is-a c      Custom)
(is-a d      Custom)

(incompat a b :source "(only the {a, b} pair is forbidden)")

(solve
  :hrules (
    guess (proposed Custom)))

(query
  :goal (proposed ?x))
