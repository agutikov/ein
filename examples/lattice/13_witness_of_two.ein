;;; 13_witness_of_two — a debt one candidate pays alone, and two others pay together.
;;;
;;; Ann owes a dish (`total-owed`), and the one fact that pays her is `(fed Ann Soup)`, which no
;;; candidate proposes: it is derived. `takeaway` derives it from one candidate, `(orders Ann)`;
;;; `dinner` derives it from two, `(cooks Bob)` and `(shops Cat)`, neither of which derives it alone.
;;;
;;; What it is the witness of: the claim that **a witness a candidate implies may stand for that
;;; candidate**. The witness of Ann's debt is in the closure of one candidate, `(orders Ann)`, and
;;; of no other single one, so by that claim the alternatives of the debt are `{(orders Ann)}`, and
;;; a route that branched root on them alone would never build `{(cooks Bob), (shops Cat)}`. That
;;; commitment is alive and discharged, a member of R that holds none of them: the claim is false
;;; unless its premise excludes a witness derived by no single candidate, and L5's premise, that
;;; every read of the debt's guard beside its witness is static, does not.
;;;
;;; What the engine does: the obligation proposes what would pay Ann's debt beside the hypothesis
;;; rules (Q-M1f.570), so `(fed Ann Soup)` is a candidate too, supposed outright: the meal with no
;;; one who orders, cooks or shops. R is the eight states below, as describe and the oracle give
;;; it, `{(cooks Bob), (shops Cat)}` merged into the state that also holds the witness.

(import std.algebra :symbols (total-owed))

(relation is-a   T T        :why "{?3} is a {?4}")
(relation fed    Guest Dish :why "{?3} is fed {?4}")
(relation orders Guest      :why "{?3} orders a takeaway")
(relation cooks  Cook       :why "{?3} cooks")
(relation shops  Shopper    :why "{?3} does the shopping")

(is-a Ann Guest)
(is-a Soup Dish)
(is-a Bob Cook)
(is-a Cat Shopper)

(total-owed fed is-a)

(rule takeaway ()
  :match  (orders Ann)
  :assert (fed Ann Soup)
  :why    "Ann orders a takeaway, so she is fed soup")

(rule dinner ()
  :match  (and (cooks Bob) (shops Cat))
  :assert (fed Ann Soup)
  :why    "Bob cooks what Cat bought, so Ann is fed soup")

(rule order ()
  :match  (is-a ?g Guest)
  :assert (open (orders ?g))
  :why    "suppose {?g} orders a takeaway")
(rule cook ()
  :match  (is-a ?c Cook)
  :assert (open (cooks ?c))
  :why    "suppose {?c} cooks")
(rule shop ()
  :match  (is-a ?s Shopper)
  :assert (open (shops ?s))
  :why    "suppose {?s} does the shopping")

(solve
  :expect (region
            (model (fed Ann Soup))
            (model (cooks Bob) (fed Ann Soup))
            (model (fed Ann Soup) (orders Ann))
            (model (fed Ann Soup) (shops Cat))
            (model (cooks Bob) (fed Ann Soup) (orders Ann))
            (model (cooks Bob) (fed Ann Soup) (shops Cat))
            (model (fed Ann Soup) (orders Ann) (shops Cat))
            (model (cooks Bob) (fed Ann Soup) (orders Ann) (shops Cat))))

(query :goal (fed ?who ?what))
