(relation h T)
(relation slot T)
(relation world T)
(relation need T T)

(world W)
(slot A) (slot B) (slot C) (slot D) (slot E)

(need K1 A) (need K1 C)

(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess: (h {?x})?")

(rule imp-A-B ()
  :match  (h A)
  :assert (h B)
  :why    "A brings B"
  :priority 200)

(rule imp-C-D ()
  :match  (h C)
  :assert (h D)
  :why    "C brings D"
  :priority 200)

(rule dead-1 ()
  :match  (and (h A) (h C))
  :assert (false)
  :why    "A C is dead"
  :priority 300)

(rule owe-1 ()
  :match  (and (world ?w) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "from the start: one of A C is required"
  :priority 500)

(query :goal (h ?x))
