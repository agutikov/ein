(relation h T :why "h holds of {?1}")
(relation slot T :why "{?1} is a slot, a candidate for h")
(relation world T :why "{?1} is the world")
(relation need T T :why "h holding of {?2} pays debt {?1}")

(world W)
(slot A) (slot B)

(need K1 B) (need K2 A)

(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess: (h {?x})?")

(rule owe-1 ()
  :match  (and (h A) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "with A: one of B is required")

(rule owe-2 ()
  :match  (and (h B) (absent (and (need K2 ?x) (h ?x))))
  :assert (open h)
  :why    "with B: one of A is required")

(query :goal (h ?x))
