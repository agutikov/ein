(relation h T)
(relation slot T)
(relation world T)
(relation need T T)

(world W)
(slot A) (slot B) (slot C) (slot D) (slot E)

(need K1 A) (need K2 C)

(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess: (h {?x})?")

(rule dead-1 ()
  :match  (and (h A) (h D) (absent (h B)) (absent (h E)))
  :assert (false)
  :why    "A D is dead while B and E are missing"
  :priority 300)

(rule dead-2 ()
  :match  (and (h A) (h C) (h D) (absent (h E)))
  :assert (false)
  :why    "A C D is dead while E is missing"
  :priority 300)

(rule owe-1 ()
  :match  (and (world ?w) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "from the start: one of A is required"
  :priority 500)

(rule owe-2 ()
  :match  (and (h B) (absent (and (need K2 ?x) (h ?x))))
  :assert (open h)
  :why    "with B: one of C is required"
  :priority 500)

(query :goal (h ?x))
