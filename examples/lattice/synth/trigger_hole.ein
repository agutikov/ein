;;; region-spec: {"name":"trigger_hole","about":"A hole made by an obligation, not by an absent (lattice/04's mechanism):\nB triggers a debt only C pays, so {A,B} owes between {A} and {A,B,C}.\nBeside it, a dead node revived — {A,D} dies without E — so the region\nhas a hole of each kind. Root owes A.","candidates":"ABCDE","R":[["A","ABCDE"]],"holes":[["AB","ABDE"],["AD","ABCD"]],"owing":[["","BCDE"],["AB","ABDE"]]}
;;; region-status: oRoooRoRoxoooxoxoRoooRoRoRoooRoR

(relation h T :why "h holds of {?1}")
(relation slot T :why "{?1} is a slot, a candidate for h")
(relation world T :why "{?1} is the world")
(relation need T T :why "h holding of {?2} pays debt {?1}")

(world W)
(slot A) (slot B) (slot C) (slot D) (slot E)

(need K1 A) (need K2 C)

(hrule guess () :match (slot ?x) :assert (h ?x) :why "guess: (h {?x})?")

(rule dead-1 ()
  :match  (and (h A) (h D) (absent (h B)) (absent (h E)))
  :assert (false)
  :why    "A D is dead while B and E are missing")

(rule dead-2 ()
  :match  (and (h A) (h C) (h D) (absent (h E)))
  :assert (false)
  :why    "A C D is dead while E is missing")

(rule owe-1 ()
  :match  (and (world ?w) (absent (and (need K1 ?x) (h ?x))))
  :assert (open h)
  :why    "from the start: one of A is required")

(rule owe-2 ()
  :match  (and (h B) (absent (and (need K2 ?x) (h ?x))))
  :assert (open h)
  :why    "with B: one of C is required")

(query :goal (h ?x))
