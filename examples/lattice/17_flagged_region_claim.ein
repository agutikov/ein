;;; A region claim stated by a program that is not monotone.
;;;
;;; Seating Ann makes her a diner, and a diner owes a meal: an obligation whose
;;; trigger a commitment changes, so the static check flags the program and
;;; its routes are the cube's (route 2), every node a fork of root. Nothing is
;;; claimed of its answer (Q-M1f.564): `ein test FILE` checks the claim below
;;; when asked, and no suite does. The program is 04_obligation_trigger_hole.ein's.

(import std.algebra :symbols (total-owed))
(relation is-a  T T :why "{?3} is a {?4}")
(relation seats Guest Chair :why "{?3} is seated on {?4}")
(relation meal  Diner Food :why "{?3}'s meal is {?4}")
(is-a Ann Guest) (is-a C1 Chair) (is-a Soup Food)
(rule seated-dines ()
  :match  (seats ?g ?c)
  :assert (is-a ?g Diner)
  :why    "{?g} is seated on {?c}, so {?g} is a diner")
(total-owed meal is-a)
(hrule seat () :match (and (is-a ?g Guest) (is-a ?c Chair)) :assert (seats ?g ?c) :why "guess that the guest {?g} is seated on the chair {?c}")
(hrule dine () :match (and (is-a ?g Guest) (is-a ?f Food))  :assert (meal ?g ?f) :why "guess that the guest {?g}'s meal is {?f}")

(solve
  :expect (region
            ;; state 1 — ∅, root itself, on the minimal line
            (model)
            ;; state 2
            (model (meal Ann Soup))
            ;; state 3 — on the maximal line
            (model (meal Ann Soup) (seats Ann C1))))

(query :goal (meal ?g ?f))
