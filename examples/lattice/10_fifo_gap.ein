;;; The FIFO gap, the counter-example of
;;; docs/ein/reasoning/02-kb-evolution/08-monotonicity.md § 8.3 written out and run.
;;;
;;; Two `absent` rules, the reader written first:
;;;
;;;   r2   a ∧ b ∧ absent(q) → p
;;;   r1   a ∧ absent(z)     → q
;;;
;;; The program is stratified (z < q < p: nothing derives z, and q is read by
;;; r2 only under an `absent`), so its perfect model at {a, b} is {a, b, q}.
;;; The engine's boundary admits one parked candidate a round in the
;;; agenda's order (Q-M1f.313), not in stratum order, and r2 is written first:
;;;
;;;   node        built at once (fork from root, = scratch here)   by way of {a}
;;;   ∅           {}                                               —
;;;   {a}         {a, q}                                           —
;;;   {b}         {b}                                              —
;;;   {a, b}      {a, b, p, q} — p stale: q falsifies its guard    {a, b, q}
;;;
;;; Built at once, r2's and r1's candidates wait at the same boundary and r2
;;; goes first; by way of {a}, r1 has already derived q, and r2's guard fails.
;;; So the state at {a, b} depends on the path that built it while the state
;;; function is monotone: {a, b, q} ⊆ sat({a, b}) and sat({a, b, q}) ≠
;;; sat({a, b}), which is cumulativity failing. Every node is in R, so the
;;; status never shows it: the static check flags r2 (an `absent` over q, which
;;; a commitment changes), and the cube calls the program conservative.
;;;
;;; Writing r1 before r2 gives {a, b, q} built at once. `ein solve` on this
;;; file names the gap on its `state` row (a stale fact) and its `paths` row
;;; (path-dependent); node by node, both ways, by
;;;   cargo run --release -p ein-infer --example node_census -- --paths examples/lattice/10_fifo_gap.ein
;;;   cargo run --release -p ein-infer --example node_census -- --cumulative examples/lattice/10_fifo_gap.ein
;;; Every node is built by fork from root, an assumption on a flagged program
;;; (Q-M1e2.2), and the engine claims nothing of its solutions; this file pins the gap.

(relation thing T :why "{?3} is a thing")
(relation a T :why "a holds of {?3}")
(relation b T :why "b holds of {?3}")
(relation p T :why "p holds of {?3}")
(relation q T :why "q holds of {?3}")
(relation z T :why "z holds of {?3}")

(thing one)

(rule guess-a () :match (thing ?x) :assert (open (a ?x)) :why "guess: (a {?x})?")
(rule guess-b () :match (thing ?x) :assert (open (b ?x)) :why "guess: (b {?x})?")

(rule r2 ()
  :match  (and (a ?x) (b ?x) (absent (q ?x)))
  :assert (p ?x)
  :why    "{?x} has a and b and no q")

(rule r1 ()
  :match  (and (a ?x) (absent (z ?x)))
  :assert (q ?x)
  :why    "{?x} has a and no z")

(query :goal (p ?x))
