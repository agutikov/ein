;;; pets — three distinct Pets fire all 6 ordered pairs.
;;;
;;; Ontology (background):
;;;   - `Pet` is a mutually-exclusive attribute type; a household
;;;     holds at most one of these pets.
;;;
;;; Facts (observed):
;;;   - Dog, Cat, Bird are all Pet.
;;;
;;; Question:
;;;   For each ordered pair of distinct Pets, is co-location ruled
;;;   out?  (Yes — 6 firings: 3 × 2 ordered pairs.)
;;;
;;; Expected derivation:
;;;   For every distinct (X, Y) ∈ Pet × Pet:
;;;   (is-a X Pet) + (is-a Y Pet) + (neq X Y)
;;;   ⇒ (not (co-located X Y)).
;;;   Six firings total: (Dog,Cat), (Dog,Bird), (Cat,Dog), (Cat,Bird),
;;;   (Bird,Dog), (Bird,Cat).

(rule type-exclusivity (?R)
  :match  (and (is-a ?a ?T)
               (is-a ?b ?T)
               (neq ?a ?b))
  :assert (not (?R ?a ?b))
  :why    "{?a} and {?b} are distinct members of {?T} — exclusive under {?R}."
  :priority 300)

(relation is-a T T)
(is-a Dog Pet)
(is-a Cat Pet)
(is-a Bird Pet)
(relation co-located T T)
(type-exclusivity co-located)

(query :goal (not (co-located Dog Cat)))
