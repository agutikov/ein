;;; The control of `minimal-line-stated-obligation.ein` (M1f S1f.5.6, the M1e2 no-owner
;;; inventory's F1 control, moved here from
;;; `plans/m1e2_correctness/inventory_2026-11-06/findings/`): the same program with the
;;; `(total-owed likes is-a)` declaration and its import deleted. It states no obligation, so
;;; until S1f.5.6 the clause `the trivial line: no obligation is stated` was true here and the
;;; two files printed the same row; since S1f.5.6 both print `1 state — ∅`, and
;;; `region.minimal.trivial` is true on both, ∅ being in R.
(relation is-a  T T
  :why "{?1} is a {?2}")
(relation likes Person Food
  :why "{?1} likes {?2}")
(is-a Ann Person) (is-a Soup Food)
(likes Ann Soup)
(solve :no-hypothesis (is-a likes))
