;;; The control of `minimal-line-stated-obligation.ein`: the same program with the
;;; `(total-owed likes is-a)` declaration and its import deleted. It states no obligation,
;;; and both files print the minimal-line row `1 state — ∅`, with
;;; `region.minimal.trivial` true on both, ∅ being in R: the row does not turn on whether
;;; the program states an obligation.
;;;
;;;
(relation is-a  T T
  :why "{?3} is a {?4}")
(relation likes Person Food
  :why "{?3} likes {?4}")
(is-a Ann Person) (is-a Soup Food)
(likes Ann Soup)
(solve :no-hypothesis (is-a likes))
