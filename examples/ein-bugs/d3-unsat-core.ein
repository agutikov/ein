;;; A generated program whose refutation rests, through a derived fact, on
;;; an `absent` a commitment can lift: not monotone.
;;; `corpus/fuzz_findings/d3-unsat-core.ein` is the same program, a
;;; frontend-fuzzer seed.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; The engine fuzzer's find (14 forms minimised to 9), kept for the
;;; id-order sweep: a fork resumes root's saturation, so two runs can
;;; narrate different amounts of one derivation
;;; (`corpus/fuzz_findings/d3-unsat-core.md`).
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; `fire-0` concludes (not …) from r1, which `fire-1` derives resting on
;;; (absent (not (r1 o3 ?v1))), a relation a commitment can still extend.
;;; The static check flags the program at `fire-1`'s `absent`: it loads,
;;; every command answers it with the warning that it is not monotone, and
;;; nothing is claimed of its answer (Q-M1f.564). `fire-0` declares `?P`,
;;; which its body never names; the loader accepts that silently.
;;;
;;;

;;; case 6710 (seed 20260820) of the engine fuzzer
(relation r0 T T :why "r0 holds of {?3} and {?4}")
(relation r1 T T :why "r1 holds of {?3} and {?4}")
(relation is-a T T :why "{?3} is a {?4}")
(is-a o2 T)
(is-a o3 T)
(r0 o2 o3)
(rule fire-0 (?P)
  :match  (and (r1 ?v0 ?v1) (r0 ?v1 ?v0))
  :assert (not (r1 ?v0 ?v0)) :why "r1 holds of {?v0} and {?v1} and r0 of {?v1} and {?v0}, so r1 does not hold of {?v0} and {?v0}")
(fire-0 T)
(rule fire-1 ()
  :match  (and (is-a ?v0 T) (r0 ?v0 ?v1) (r1 ?v2 ?v3) (absent (not (r1 o3 ?v1))))
  :assert (r1 ?v2 ?v2) :why "r0 holds of the T {?v0} and {?v1}, r1 of {?v2} and {?v3}, and r1 of o3 and {?v1} is not known false, so r1 holds of {?v2} and {?v2}")
