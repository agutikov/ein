;;; stays there as a frontend-fuzzer seed.
;;;
;;; ── What this program was ──────────────────────────────────────────────
;;;
;;; `utils/fuzz_engine.py`'s find of 2026-08-20 (14 forms minimised to 9).
;;; The walk's `solve -m 2` printed a 4-fact unsat core on the resumed fork
;;; path and 6 under `EIN_FORK_DELTA=0`, and 4 against 6 again at the
;;; id-order sweep's third seed, 15839 (`corpus/fuzz_findings/d3-unsat-core.md`).
;;;
;;; ── Since M1e2 ─────────────────────────────────────────────────────────
;;;
;;; Refused (S1e2.2.5, *forbid* with F2's *via*, ruled 2026-11-04): `fire-0`
;;; concludes (not …) from r1, which `fire-1` derives resting on
;;; (absent (not (r1 o3 ?v1))), a relation a commitment can still extend, so
;;; every question about a commitment exits 1 naming the two rules. The
;;; refusal is the same under every permutation of the interner, which
;;; `id_order_invariance` checks per commit. `fire-0` declares `?P`, which its
;;; body never names; the loader accepts that silently (S1e2.2.12 § Notes).

;;; case 6710 (seed 20260820) — utils/fuzz_engine.py
(relation r0 T T)
(relation r1 T T)
(relation is-a T T)
(is-a o2 T)
(is-a o3 T)
(r0 o2 o3)
(rule fire-0 (?P)
  :match  (and (r1 ?v0 ?v1) (r0 ?v1 ?v0))
  :assert (not (r1 ?v0 ?v0)))
(fire-0 T)
(rule fire-1 ()
  :match  (and (is-a ?v0 T) (r0 ?v0 ?v1) (r1 ?v2 ?v3) (absent (not (r1 o3 ?v1))))
  :assert (r1 ?v2 ?v2))
