;;; A refusal, and a core that moved with interner ids —
;;; regressions `d3-unsat-core-id-order` and `d3-unsat-core/d3-unsat-core`
;;; (`corpus/regressions.toml`). `corpus/fuzz_findings/d3-unsat-core.ein`
;;; is the same program, a frontend-fuzzer seed.
;;;
;;; ── What this program was ──────────────────────────────────────────────
;;;
;;; The engine fuzzer's find (14 forms minimised to 9). The walk's
;;; `solve -m 2` printed a 4-fact unsat core on the resumed fork path and 6
;;; under `EIN_FORK_DELTA=0`, and 4 against 6 again at the id-order
;;; property's third seed, 15839 (`corpus/fuzz_findings/d3-unsat-core.md`).
;;;
;;; ── What it is ─────────────────────────────────────────────────────────
;;;
;;; Refused at load (*forbid*, followed through derived facts, Q-M1e2.5):
;;; `fire-0` concludes (not …) from r1, which `fire-1` derives resting on
;;; (absent (not (r1 o3 ?v1))), a relation a commitment can still extend, so
;;; every question about a commitment exits 1 naming the two rules. The
;;; refusal is the same under every permutation of the interner, which
;;; `id_order_invariance` checks. `fire-0` declares `?P`, which its body
;;; never names; the loader accepts that silently.
;;;

;;; case 6710 (seed 20260820) of the engine fuzzer
(relation r0 T T :why "r0 holds of {?1} and {?2}")
(relation r1 T T :why "r1 holds of {?1} and {?2}")
(relation is-a T T :why "{?1} is a {?2}")
(is-a o2 T)
(is-a o3 T)
(r0 o2 o3)
(rule fire-0 (?P)
  :match  (and (r1 ?v0 ?v1) (r0 ?v1 ?v0))
  :assert (not (r1 ?v0 ?v0)) :why "r1 holds of {?v0} and {?v1} and r0 of {?v1} and {?v0}, so r1 does not hold of {?v0} and {?v0}")
(fire-0 T)
(rule fire-1 ()
  :match  (and (is-a ?v0 T) (r0 ?v0 ?v1) (r1 ?v2 ?v3) (absent (not (r1 o3 ?v1))))
  :assert (r1 ?v2 ?v2) :why "r0 holds of the T {?v0} and {?v1}, r1 of {?v2} and {?v3}, and r1 of o3 and {?v1} is not known false, so r1 holds of {?v2} and {?v2}")
