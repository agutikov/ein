;;; An owed instance whose alternatives each die in TWO firings — **W1**
;;; turning an `Open` into a certified `Contradiction`, at **default
;;; flags**. Register row `W1/owed-two-step` (`corpus/wrong_answers.toml`).
;;;
;;; ── The program ────────────────────────────────────────────────────────────
;;;
;;; `(total-owed likes is-a)`: Ann owes a Food. Both foods taint her and a
;;; taint is a contradiction, two firings deep, so neither alternative can pay.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────────
;;;
;;; A consistent, quiescent state that owes what it cannot pay is **owing**,
;;; not dead (Q-M1e2.7): R is empty, every alive node owing, and root is that
;;; state, `∅ — owes 1`.
;;;
;;; ── What the engine answered ───────────────────────────────────────────────
;;;
;;;   verdict         No solution — the constraints are contradictory
;;;   unsat core (2 facts)   (likes Ann Soup)  (likes Ann Stew)
;;;   exhausted        true
;;;
;;; Both alternatives were entered at layer 1 and died; the layer was empty,
;;; the loop broke, and the dead hypotheses' cores became the program's.
;;;
;;; ── The control ───────────────────────────────────────────────────────────
;;;
;;; `tree-dead.ein` is the same obligation with each alternative refuted in
;;; ONE firing, and answers the same: R empty, `∅ — owes 1` (its name is from
;;; the walk's tree traversal, which it was written for).
;;;
;;;
(import std.algebra :symbols (total-owed))
(relation is-a  T T :why "{?1} is a {?2}")
(relation likes Person Food :why "{?1} likes {?2}")
(relation bad   Person :why "{?1} is bad")
(is-a Ann Person)
(is-a Soup Food)  (is-a Stew Food)
(total-owed likes is-a)
(rule taint () :match (likes ?p ?f) :assert (bad ?p) :why "{?p} likes {?f}, so {?p} is bad")
(rule kill  () :match (bad ?p)      :assert (false) :why "{?p} is bad, which cannot be")
(solve :no-hypothesis (is-a bad))
(query :goal (likes ?who ?what))
