;;; The twin of `kw-or-in-assert.ein`, a control of **W22**: the same program
;;; with `orz` renamed `oorz`, its first letter doubled: a name that starts with
;;; no keyword and sorts where `orz` does. Its answer is the witness's right
;;; one, the name read back (`ein solve FILE` at `35186bc0`, release and debug).
;;;

(relation p Node :why "p holds of {?1}") (relation oorz Node :why "oorz holds of {?1}")
(p a)
(rule r () :match (p ?x) :assert (oorz ?x) :why "p holds of {?x}, so oorz holds of {?x}")
(query :goal (oorz ?y))
