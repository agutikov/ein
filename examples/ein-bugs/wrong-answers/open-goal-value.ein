;;; `open` written as a query goal's argument loads, as a name of the program —
;;; **W71**, regression `goal-value`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; The query's goal `(p open)` asks whether `p` holds of `open`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is the verdict a rule's `:assert` states, `(open)` or `(open ?R)`,
;;; and is written nowhere else (Q-M1f.66):
;;; here it is written as a query goal's argument, so the program is refused at
;;; the parse, at the `open`, and every command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, R is 4 states, and the query is
;;; answered, exit 0 on every command.
;;; The engine refuses it at the parse.
;;;

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(query :goal (p open))
