;;; An obligation a node is told about that root was not (Q-M1e.11). Its
;;; control is `oblig-derived-activator-declared.ein`, which states the
;;; activator.
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `std.algebra`'s `total-owed` over `likes`, stated, and over `drinks`,
;;; whose activator `(total-owed drinks is-a)` the rule `arm` derives from any
;;; `likes` fact: an obligation's activator that only a commitment derives.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; Ann owes a Food and, once she likes one, a Drink. The obligations rung
;;; reads the activator off `arm`'s `:assert` and proposes at root what the
;;; debt it brings would (Q-M1e.11, by the static reading), so H is
;;; `{(drinks Ann Tea), (likes Ann Soup)}`, and the read-out's `later debt`
;;; row says which candidate is there for which activator.
;;;
;;; `total-owed`'s activator relation is one a commitment can change, so the
;;; static check flags the program, the cube answers it, and nothing is
;;; claimed of its answer (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(import std.algebra :symbols (total-owed))
(relation is-a   T T :why "{?3} is a {?4}")
(relation likes  Person Food :why "{?3} likes {?4}")
(relation drinks Person Drink :why "{?3} drinks {?4}")
(is-a Ann Person) (is-a Soup Food) (is-a Tea Drink)
(total-owed likes is-a)
(rule arm () :match (likes ?p ?f) :assert (total-owed drinks is-a) :why "{?p} likes {?f}, which switches on the debt that every Person drinks a Drink")
(solve :no-hypothesis (is-a))
