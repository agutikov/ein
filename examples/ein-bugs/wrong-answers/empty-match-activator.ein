;;; A rule with a parameter whose `:match` is `()` never fired —
;;; regression `empty-match-activator` (`corpus/regressions.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; A rule `r` with one parameter and no premise, concluding `(hit ?x)`, and
;;; its activator `(r a)`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; An empty conjunction is true, so the rule fires once per activator fact,
;;; with only its parameters bound (Q-M1e2.36): root holds `(hit a :rule
;;; r)`, and R's minimal line is root's state.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; The rule loaded and never fired (`ein saturate FILE --dump`): root held no
;;; `hit`, `(hit a)` was a candidate, and R four states, exit 0 (`ein solve
;;; FILE` and `ein oracle FILE` at `ec004a48`, the engine `916d97ac`'s,
;;; release and debug alike).
;;;
;;; ── What the engine answers ────────────────────────────────────────────
;;;
;;; `:match ()` is the empty conjunction, so `r` fires once on its activator:
;;; root holds `(hit a :rule r)`, H is `(p a)`, and R two states, the answer
;;; above by hand. The regression's `now` is that answer; the section above is
;;; the record of the one it replaced.
;;;
;;;

(relation q Node :why "q holds of {?3}") (relation p Node :why "p holds of {?3}") (relation hit Node :why "{?3} is a hit")
(q a)
(rule r (?x) :match () :assert (hit ?x) :why "rule r is activated for {?x} and has no premise, so {?x} is a hit")
(r a)
