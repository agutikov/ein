;;; A control for M1e2 **W17** (`corpus/wrong_answers.toml`, S1e2.2.17,
;;; 2026-11-04): `forbid-chain-1.ein` with no `absent`, which loads.
;;;
;;; `mk` derives `(q a)` from `(p a)` whatever `a`'s `p2`; the chain `q`,
;;; `r2` then concludes `(false)` at a node, as in the witness. Nothing rests
;;; on an `absent`, so `{(p a)}` dies and so does its superset
;;; `{(p a), (p2 a)}`: `dead` is upward-closed here, there is no hole, and
;;; *forbid* has nothing to refuse. R is two states, ∅ and {(p2 a)}, by the
;;; cube (the static check flags `q`'s activator site, and the status is
;;; *monotone here (conservative)*), exit 0 (`ein solve FILE` at
;;; `3efd3f5f`). The fix that refuses the witness reads the same chain here
;;; and must not refuse it, nor move R; since S1e2.2.17 it reads it, and
;;; neither moved.

(relation seed T) (relation p T) (relation p2 T) (relation q T) (relation r2 T)

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x))
(hrule g2 () :match (seed ?x) :assert (p2 ?x))

(rule mk () :match (p ?x) :assert (q ?x))
(rule q  (?n) :match (seed ?n) :assert (r2 ?n))
(rule r2 (?k) :match (seed ?k) :assert (false))
