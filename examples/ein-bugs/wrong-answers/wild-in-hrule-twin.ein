;;; The twin of `wild-in-hrule.ein` — **W20**: the same program with the
;;; wildcard `_` written as `?any`, a variable the hrule reads nowhere else.
;;; The hrule proposes `(tag a)`, and R is `∅` and `{(tag a)}` (`ein solve
;;; FILE`): the answer the witness's `_` was read as meaning, where the
;;; witness itself is refused at the parse (Q-M1e2.22).

(relation holds Node Node :why "{?1} holds {?2}") (relation tag Node :why "{?1} is tagged")
(holds a b)
(hrule h () :match (holds ?x ?any) :assert (tag ?x) :why "{?x} holds {?any}: guess that {?x} is tagged")
