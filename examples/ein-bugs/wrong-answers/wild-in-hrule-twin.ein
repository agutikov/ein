;;; The twin of `wild-in-hrule.ein`: the same program with the
;;; wildcard `_` written as `?any`, a variable the hypothesis rule reads nowhere else.
;;; The hypothesis rule proposes `(tag a)`, and R is `∅` and `{(tag a)}` (`ein solve
;;; FILE`): the answer the witness's `_` was read as meaning, where the
;;; witness itself is refused at the parse (Q-M1e2.22).

(relation holds Node Node :why "{?3} holds {?4}") (relation tag Node :why "{?3} is tagged")
(holds a b)
(rule h () :match (holds ?x ?any) :assert (open (tag ?x)) :why "{?x} holds {?any}: guess that {?x} is tagged")
