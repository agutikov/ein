;;; The control of `rung-unactivated.ein` — regression
;;; `rung-unactivated`'s control (`corpus/regressions.toml`).
;;;
;;; The same program with the import deleted, which it never used: no
;;; obligation rule is loaded, so the blind enumerator builds H, eleven
;;; candidates of `at` and `near` over the program's three names, and R is
;;; the whole cube, 2 048 states. That is the witness's right answer, and
;;; its answer today: a module imported for a name the program does not
;;; write chooses no rung.

(relation at Color House :why "{?3} is at {?4}")
(relation near House House :why "{?3} is near {?4}")
(is-a Red Color) (is-a H1 House) (is-a H2 House)
(at Red H1)
(solve)
