;;; `open` written as a macro call's argument loads, as a name of the program —
;;; M1f **W71**, register row `W71/macro-argument`, filed by S1f.5.23
;;; (T1f.5.23.2, 2026-11-10).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `(pp open)` calls the macro `pp`, whose body `(p ?v)` expands it to `(p
;;; open)`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is the verdict a rule's `:assert` states, `(open)` or `(open ?R)`,
;;; and is written nowhere else (the user's ruling on Q-M1f.66, 2026-11-10):
;;; here it is written as a macro call's argument, so the program is refused at
;;; the parse, at the `open`, and every command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, `r`'s premise expands to `(p
;;; open)`, and R is 22 states, exit 0 on every command.
;;; Refused at the parse since S1f.5.23 (T1f.5.23.3).

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(macro pp (?v) (p ?v) :why "{?v} is a p")
(rule r ()
  :match  (and (a ?x) (pp open))
  :assert (q ?x)
  :why "{?x} is an a, and open is a p, so {?x} is a q")
