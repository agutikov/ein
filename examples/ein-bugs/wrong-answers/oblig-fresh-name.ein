;;; The obligations rung never proposed a domain value a commitment derives —
;;; M1e2 **W14**, register row `W14/oblig-fresh-name`
;;; (`corpus/wrong_answers.toml`), fixed by S1e2.2.15 (2026-11-04). Banked
;;; from S1e2.2.4's residue probe of the same day.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Ann owes a `likes` whose object is a `food` (`owes-food`, an obligation:
;;; its `:assert` is `(open likes)`). At root the only food is Soup, and Ann
;;; may not like Soup (`no-soup`). `special` names `Z` in its `:assert`: once
;;; anyone likes anything, Z is on the menu. `liker-is-person` only types the
;;; blind enumerator's candidates.
;;;
;;; Until S1e2.2.15 the obligations rung built H by running `owes-food`'s
;;; guard with its witness step skipped, over root's KB: `(food ?b)` found
;;; Soup alone, so H was `(likes Ann Soup)`, dead alone. `food` grows by derivation from a
;;; commitment (`special` reads `likes`), so it is in D, the relations a
;;; commitment can change, and the rung's C4 check declined only on a
;;; relation the rung itself proposed.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(likes Ann Z)}` saturates to `(food Z)`, which witnesses Ann's debt: an
;;; alive, discharged state, and the maximal one. With `(food Z)` declared at
;;; root (`oblig-fresh-name-declared.ein`) R is that one state, and so it is
;;; when the rung declines and the blind enumerator, whose objects carry `Z`
;;; since S1e2.2.4, builds H: six `likes` candidates over Ann, Soup and Z,
;;; five dead alone. Monotone: `food` is in D but read only inside the
;;; obligation's `absent`, where growth can only pay.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.15 H was 1 candidate, dead alone, and R was empty: every
;;; alive node owed, `(region (owing (model)))` (`ein solve FILE` at
;;; `338b5892`, 2026-11-04). Since then the rung declines when an
;;; obligation's guard scans a relation in D (here `food`), the blind
;;; enumerator builds H, and this file answers its control's R, which the
;;; `:expect` below states. The register row `W14/oblig-fresh-name` is fixed.

(relation person T)
(relation food   T)
(relation likes  T T)

(person Ann)
(food Soup)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food"
  :priority 500)

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (likes ?p ?f)
  :assert (food Z)
  :why    "once {?p} likes {?f}, Z is on the menu")

(solve
  :no-hypothesis (person food)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts —
  ;; the -declared control's R, which this file answers since S1e2.2.15.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Z)}
            (model (likes Ann Z))))

(query
  :goal   (likes ?p ?f))
