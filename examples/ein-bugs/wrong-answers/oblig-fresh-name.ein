;;; The obligations rung never proposed a domain value a commitment derives —
;;; **W14**, register row `W14/oblig-fresh-name`
;;; (`corpus/wrong_answers.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Ann owes a `likes` whose object is a `food` (`owes-food`, an obligation:
;;; its `:assert` is `(open likes)`). At root the only food is Soup, and Ann
;;; may not like Soup (`no-soup`). `special` names `Z` in its `:assert`: once
;;; anyone likes anything, Z is on the menu. `liker-is-person` only types the
;;; blind enumerator's candidates.
;;;
;;; A rung that builds H by running `owes-food`'s guard with its witness step
;;; skipped, over root's KB, finds Soup alone with `(food ?b)`, so its H is
;;; `(likes Ann Soup)`, dead alone. `food` grows by derivation from a
;;; commitment (`special` reads `likes`), so it is in D, the relations a
;;; commitment can change; a check that declines only on a relation the rung
;;; itself proposes does not see it.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(likes Ann Z)}` saturates to `(food Z)`, which witnesses Ann's debt: an
;;; alive, discharged state, and the maximal one. With `(food Z)` declared at
;;; root (`oblig-fresh-name-declared.ein`) R is that one state, and so it is
;;; when the rung declines and the blind enumerator, whose objects carry `Z`,
;;; builds H: six `likes` candidates over Ann, Soup and Z, five dead alone.
;;; Monotone: `food` is in D but read only inside the obligation's `absent`,
;;; where growth can only pay.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; At `338b5892` (`ein solve FILE`), H was 1 candidate, dead alone, and R was
;;; empty: every alive node owed, `(region (owing (model)))`. The rung
;;; declines when an obligation's guard scans a relation in D (here `food`;
;;; Q-M1e2.10), the blind enumerator builds H, and this file answers its
;;; control's R, which the `:expect` below states. The register row
;;; `W14/oblig-fresh-name` is fixed.
;;;

(relation person T :why "{?1} is a person")
(relation food   T :why "{?1} is a food")
(relation likes  T T :why "{?1} likes {?2}")

(person Ann)
(food Soup)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (likes ?p ?f)
  :assert (food Z)
  :why    "once {?p} likes {?f}, Z is on the menu")

(solve
  :no-hypothesis (person food)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts —
  ;; the -declared control's R, which this file answers too.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Z)}
            (model (likes Ann Z))))

(query
  :goal   (likes ?p ?f))
