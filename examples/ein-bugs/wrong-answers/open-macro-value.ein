;;; a macro's body writes `open` as a value, and loads —
;;; regression `macro-value`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `po`'s body is `(p open)`, so `r`'s premise `(po ?x)` expands to `(p open)`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is a name wherever the kernel does not read it, at the head of a
;;; written fact, a premise or a conclusion, and under an ordinary relation the
;;; head of a fact the kernel does not read (Q-M1f.66, Q-M1f.571): here it is
;;; written as a macro's body, so the program loads, and every command answers.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, and R is 22 states, exit 0 on
;;; every command.
;;; The engine loads it.

(relation a Thing :why "{?3} is an a")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(macro po (?v) (p open) :why "open is a p")
(rule r ()
  :match  (and (a ?x) (po ?x))
  :assert (q ?x)
  :why "{?x} is an a, and open is a p, so {?x} is a q")
