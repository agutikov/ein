;;; `open` written as a trace step's name loads — **W71**, register row
;;; `W71/trace-step`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `(trace (step open …))` is a trace whose one step is named `open`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is the verdict a rule's `:assert` states, `(open)` or `(open ?R)`,
;;; and is written nowhere else (Q-M1f.66):
;;; here it is written as a trace step's name, so the program is refused at the
;;; parse, at the `open`, and every command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, and R is 4 states, exit 0 on
;;; every command.
;;; The engine refuses it at the parse.

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(trace (step open :derives (a k)))
