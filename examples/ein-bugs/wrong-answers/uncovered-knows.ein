;;; `uncovered.ein` plus one fact, `(knows Ann Bob)` — the twin that shows what
;;; **W6**'s certification leaves out. Register row `W6/uncovered`, as a
;;; twin.
;;;
;;; As banked, the engine answered k = 3, `exhausted = true` here as well, and
;;; each of the three states carried `(knows Ann Bob)` and the derived
;;; `(knows Bob Ann)`. Those three are consistent states of `uncovered.ein`
;;; too — a `knows` fact is something its rung never proposes — so the
;;; original file's exhausted `k = 3` was exhaustive over `alive₀`, not over
;;; the program.
;;;
;;; `ein solve` answers R, the same seven states over the four `seats`
;;; candidates as `uncovered.ein`'s, each holding the two `knows` facts, and
;;; every question names `knows` outside the universe, as on `uncovered.ein`
;;; (Q-M1e2.3).
;;;
(import std.algebra :symbols (total-owed surjective-owed))

(relation is-a   T T         :why "{?1} is a {?2}")
(relation seats  Guest Chair :why "{?1} sits on {?2}")
(relation knows  Guest Guest :why "{?1} knows {?2}")

(is-a Ann Guest) (is-a Bob Guest)
(is-a C1 Chair)  (is-a C2 Chair)

;; `seats` is owed from both ends — every guest a chair, every chair a guest.
(total-owed      seats is-a)
(surjective-owed seats is-a)

;; `knows` is owed by nobody, and is NOT closed: this rule positively concludes
;; it, so the closure pass cannot rule it out. Nothing determines whether
;; anyone knows anyone.
(rule knows-is-mutual ()
  :match  (knows ?a ?b)
  :assert (knows ?b ?a)
  :why    "{?a} knows {?b}, so {?b} knows {?a}.")

(query :goal (seats ?g ?c))
(knows Ann Bob)
