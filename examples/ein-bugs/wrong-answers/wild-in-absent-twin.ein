;;; The twin of `wild-in-absent.ein` — **W20**: the same program with the
;;; wildcard `_` written as `?any`, a variable the rule reads nowhere else,
;;; which under `absent` asks after any `holds` fact at all. `z` never
;;; fires, and R is `∅` and `{(hit a)}` (`ein solve FILE`): the answer the
;;; witness's `_` was read as meaning, where the witness itself is refused
;;; at the parse (Q-M1e2.22).

(relation holds Node :why "{?1} holds") (relation hit Node :why "{?1} is hit")
(holds a)
(rule z () :match (absent (holds ?any)) :assert (hit z) :why "nothing holds, so z is hit")
(solve :no-hypothesis (holds))
