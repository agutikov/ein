;;; The control of `dunder-object-closed-by-rule.ein` — **W96**, register row
;;; `W96/closed-by-rule`'s control (`corpus/wrong_answers.toml`).
;;;
;;; The same program with the closure written as a fact, `(__closed__
;;; digit)`, and not derived by a rule. Nothing else differs. A written fact
;;; registers its head as a relation of the program, and a relation is no
;;; object: ten candidates, `(total 0)` to `(total 9)`, and R the whole cube,
;;; 1 024 states, which is the witness's right answer, and since the fix the
;;; witness's answer. One closure stated two ways is one closure.

(relation digit Digit :why "{?1} is a digit")
(digit 0) (digit 1) (digit 2) (digit 3) (digit 4)
(digit 5) (digit 6) (digit 7) (digit 8) (digit 9)
(__closed__ digit)
(relation total Number :why "the total is {?1}")
(query :goal (total ?x))
