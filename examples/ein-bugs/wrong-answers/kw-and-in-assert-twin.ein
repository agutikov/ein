;;; The twin of `kw-and-in-assert.ein`, a control of regression `kw-and-in-assert`: the same program
;;; with `andz` renamed `aandz`, its first letter doubled: a name that starts
;;; with no keyword and sorts where `andz` does. Its answer is the witness's
;;; right one, the name read back (`ein solve FILE` at `35186bc0`, release and
;;; debug).

(relation p Node :why "p holds of {?1}") (relation aandz Node :why "aandz holds of {?1}")
(p a)
(rule r () :match (p ?x) :assert (aandz ?x) :why "p holds of {?x}, so aandz holds of {?x}")
(query :goal (aandz ?y))
