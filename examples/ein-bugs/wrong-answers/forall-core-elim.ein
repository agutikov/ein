;;; A pair one of whose sides is concluded through a `forall`: the core leaves
;;; out the facts the universal read, and names none of the commitment —
;;; regression `forall-core-elim` (`corpus/regressions.toml`);
;;; a derivation through a `forall` rests on each fact it read (Q-M1e2.15).
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; The program states `(not (in a s2))`. `elim` concludes `(in ?x ?t)` when
;;; every other slot excludes `?x`, through `(forall ?s (and (slot ?s) (neq
;;; ?s ?t)) (not (in ?x ?s)))`, the stdlib's elimination shape: root derives
;;; `(in a s1)` from the stated exclusion. Two candidates, `(tag s1)` and
;;; `(tag s2)`; `(tag s1)` excludes `a` from `s1`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; R is ∅ and {(tag s2)}, and N is {(tag s1)}: committed, `(tag s1)` derives
;;; `(not (in a s1))` against root's `(in a s1)`, a pair, and `elim` derives
;;; `(in a s2)` from it against the stated `(not (in a s2))`, a second. Each
;;; pair rests on both its sides, and `elim`'s side on the exclusion its
;;; universal read: the first rests on `(item a) (slot s1) (not (in a s2))`
;;; and `(tag s1)`, the second on `(item a) (slot s2) (not (in a s2))` and
;;; `(tag s1)`. The core is the smaller in the engine's order, `(item a) (not
;;; (in a s2)) (slot s1) (tag s1)`, which names the commitment.
;;;
;;; ── What the engine answered, and what holds now ───────────────────────
;;;
;;; At `a98a94e3`, N's core `(item a) (slot s1)`, by `(given)` and `elim`, the
;;; first pair's positive side without what its universal read (`ein solve FILE
;;; --dump-answer DIR` at `a98a94e3`, release and debug). With a pair's two
;;; sides explained together and nothing more, `(item a) (not (in a s2)) (slot
;;; s2)`: the second pair, its `elim` side again without what it read, and still
;;; no commitment. Now, by Q-M1e2.15, `(item a) (not (in a s2)) (slot s1) (tag
;;; s1)`, in either build.
;;;

(import std.macro :symbols (forall))
;; A fact beside its stored negation is a contradiction by this module's rules (Q-M1f.557).
(import std.contradiction)

(relation item T :why "{?3} is an item") (relation slot T :why "{?3} is a slot") (relation in T T :why "{?3} is in {?4}") (relation tag T :why "{?3} is tagged")

(item a) (slot s1) (slot s2)
(not (in a s2))

(rule g () :match (slot ?s) :assert (open (tag ?s)) :why "guess that the slot {?s} is tagged")

(rule ex () :match (and (item ?x) (tag ?s)) :assert (not (in ?x ?s)) :why "the slot {?s} is tagged, so the item {?x} is not in it")

(rule elim () :match (and (item ?x) (slot ?t)
                         (forall ?s (and (slot ?s) (neq ?s ?t)) (not (in ?x ?s))))
  :assert (in ?x ?t) :why "every slot other than {?t} excludes the item {?x}, so {?x} is in {?t}")
