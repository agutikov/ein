;;; `open` written as a type in a relation's signature loads, as a type —
;;; **W71**, regression `signature-type`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `(relation t open)` declares a relation whose one argument is of the type
;;; `open`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is the verdict a rule's `:assert` states, `(open)` or `(open ?R)`,
;;; and is written nowhere else (Q-M1f.66):
;;; here it is written as a type in a relation's signature, so the program is
;;; refused at the parse, at the `open`, and every command exits 1 (`ein test`:
;;; 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, `t` a relation over the type
;;; `open`; R is 8 states, exit 0 on every command.
;;; The engine refuses it at the parse.
;;;

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(relation t open :why "{?1} is a t")
