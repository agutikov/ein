         (?R ?v168) (?R ?v169) (?R ?v170) (?R ?v171) (?R ?v172) (?R ?v173) (?R ?v174) (?R ?v175)
         (?R ?v176) (?R ?v177) (?R ?v178) (?R ?v179) (?R ?v180) (?R ?v181) (?R ?v182) (?R ?v183)
