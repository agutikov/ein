;;; A rule whose `:match` writes 257 distinct variables, which no activator
;;; activates: every command answers — M1f **W63**, register row `W63/wide-match-never-compiled`
;;; (`corpus/wrong_answers.toml`), filed by S1f.5.21 (T1f.5.21.1,
;;; 2026-11-10).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `wide` has a parameter and the program writes no `(wide …)`, so no
;;; state compiles a plan of it.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; A rule binds at most 256 variables, its parameters among them, so
;;; `wide` is refused at load, whether or not anything activates it: every
;;; command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `864b16ed`, release: every command answered, exit 0. Refused at load
;;; since S1f.5.21 (T1f.5.21.2).

(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(p k)
(rule wide (?R)
  :match (and (?R ?v0) (?R ?v1) (?R ?v2) (?R ?v3) (?R ?v4) (?R ?v5) (?R ?v6) (?R ?v7)
         (?R ?v8) (?R ?v9) (?R ?v10) (?R ?v11) (?R ?v12) (?R ?v13) (?R ?v14) (?R ?v15)
         (?R ?v16) (?R ?v17) (?R ?v18) (?R ?v19) (?R ?v20) (?R ?v21) (?R ?v22) (?R ?v23)
         (?R ?v24) (?R ?v25) (?R ?v26) (?R ?v27) (?R ?v28) (?R ?v29) (?R ?v30) (?R ?v31)
         (?R ?v32) (?R ?v33) (?R ?v34) (?R ?v35) (?R ?v36) (?R ?v37) (?R ?v38) (?R ?v39)
         (?R ?v40) (?R ?v41) (?R ?v42) (?R ?v43) (?R ?v44) (?R ?v45) (?R ?v46) (?R ?v47)
         (?R ?v48) (?R ?v49) (?R ?v50) (?R ?v51) (?R ?v52) (?R ?v53) (?R ?v54) (?R ?v55)
         (?R ?v56) (?R ?v57) (?R ?v58) (?R ?v59) (?R ?v60) (?R ?v61) (?R ?v62) (?R ?v63)
         (?R ?v64) (?R ?v65) (?R ?v66) (?R ?v67) (?R ?v68) (?R ?v69) (?R ?v70) (?R ?v71)
         (?R ?v72) (?R ?v73) (?R ?v74) (?R ?v75) (?R ?v76) (?R ?v77) (?R ?v78) (?R ?v79)
         (?R ?v80) (?R ?v81) (?R ?v82) (?R ?v83) (?R ?v84) (?R ?v85) (?R ?v86) (?R ?v87)
         (?R ?v88) (?R ?v89) (?R ?v90) (?R ?v91) (?R ?v92) (?R ?v93) (?R ?v94) (?R ?v95)
         (?R ?v96) (?R ?v97) (?R ?v98) (?R ?v99) (?R ?v100) (?R ?v101) (?R ?v102) (?R ?v103)
         (?R ?v104) (?R ?v105) (?R ?v106) (?R ?v107) (?R ?v108) (?R ?v109) (?R ?v110) (?R ?v111)
