;;; `open` bound to an obligation's relation parameter loads, and every state
;;; owes it — regression `obligation-parameter`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `owe` is an obligation: `(open ?R)` with `?R` its relation parameter. The
;;; activator `(owe open)` binds `?R` to `open`, so `owe` owes, for `k`, an
;;; `open` fact no state can hold.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is the kernel's relation, of what a state owes and of its hypotheses,
;;; and no obligation owes it: an activator that makes one owe `open` is refused
;;; at load, one line (Q-M1f.66), and every command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, every alive node owes, and R is
;;; empty, *every alive node owes — no commitment pays every debt*, exit 0 on
;;; every command.
;;; The engine refuses it at load.
;;;

(relation a Thing :why "{?3} is an a")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(relation likes Thing Thing :why "{?3} likes {?4}")
(rule owe (?R)
  :match  (and (a ?x) (absent (?R ?x ?y)))
  :assert (open ?R)
  :why "{?x} has no {?R} partner yet — one is still owed")
(owe open)
