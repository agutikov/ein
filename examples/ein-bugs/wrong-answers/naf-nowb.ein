(relation is-a T T :why "{?3} is a {?4}")
(relation p T :why "p holds of {?3}")
(relation q T :why "q holds of {?3}")

(is-a A T)

(rule bad ()
  :match  (and (p ?x) (absent (q ?x)))
  :assert (false)
  :why    "{?x} has p without q")

(query
  :goal   (is-a ?x T))
