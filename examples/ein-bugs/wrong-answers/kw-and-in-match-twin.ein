;;; The twin of `kw-and-in-match.ein` — M1e2 **W22**, banked by S1e2.2.22
;;; (2026-11-05): the same program with `andz` renamed `aandz`, its first
;;; letter doubled: a name that starts with no keyword and sorts where `andz`
;;; does. Its answer is the witness's right one, the name read back (`ein
;;; solve FILE` at `35186bc0`, release and debug).

(relation p Node :why "p holds of {?1}") (relation aandz Node :why "aandz holds of {?1}") (relation hit Node :why "{?1} is a hit")
(p a) (aandz b)
(rule r () :match (aandz ?x) :assert (hit ?x) :why "aandz holds of {?x}, so {?x} is a hit")
