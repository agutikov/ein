;;; The obligations rung never proposed a domain value a commitment derives,
;;; **with no rule constant at all** — M1e2 **W14**, register row
;;; `W14/oblig-derived-domain` (`corpus/wrong_answers.toml`), fixed by
;;; S1e2.2.15 (2026-11-04). Banked from S1e2.2.4's residue probe of the same
;;; day.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `oblig-fresh-name.ein`'s defect where the value that joins the guard's
;;; domain inside a fork is named by a **fact**, `(dish Pie)`, so it is a
;;; name of the program and a candidate object, and nothing about names is
;;; at stake. `special` derives `(food ?d)` for every dish once anyone likes
;;; anything. Until S1e2.2.15 the obligations rung read root's `(food ?b)`
;;; scan, Soup alone, and Ann may not like Soup: H was `(likes Ann Soup)`,
;;; dead alone.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(likes Ann Pie)}` saturates to `(food Pie)`, which witnesses Ann's debt:
;;; R is that one state. With `(food Pie)` declared at root
;;; (`oblig-derived-domain-declared.ein`) the rung finds it; with the rung
;;; declined, the blind enumerator does (six `likes` candidates over Ann, Soup
;;; and Pie, five dead alone).
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.15 H was 1 candidate, dead alone, and R was empty, every
;;; alive node owing (`ein solve FILE` at `338b5892`, 2026-11-04). Since then
;;; the rung declines on a guard that scans a relation in D (`food`), and
;;; this file answers its control's R, which the `:expect` below states. The
;;; register row `W14/oblig-derived-domain` is fixed.

(relation person T :why "{?1} is a person")
(relation food   T :why "{?1} is a food")
(relation dish   T :why "{?1} is a dish")
(relation likes  T T :why "{?1} likes {?2}")

(person Ann)
(food Soup)
(dish Pie)

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (and (likes ?p ?f) (dish ?d))
  :assert (food ?d)
  :why    "once {?p} likes {?f}, the dish {?d} is on the menu")

(solve
  :no-hypothesis (person food dish)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts —
  ;; the -declared control's R, which this file answers since S1e2.2.15.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Pie)}
            (model (likes Ann Pie))))

(query
  :goal   (likes ?p ?f))
