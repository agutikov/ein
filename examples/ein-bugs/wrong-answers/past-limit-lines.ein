;;; The line modes past `--region-limit` (Q-M1e2.19): the smallest program the
;;; static check flags whose cube is past the default limit of 16, so a bare
;;; `ein solve` and its two line modes stop there.
;;;
;;;
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; lattice/17_flagged_region_claim.ein's seating, with fifteen more chairs, each
;;; broken: seating Ann makes her a diner, a diner owes a meal (`total-owed`), and a
;;; seat on a broken chair is dead. 17 candidates, the 16 seats and the one
;;; meal. The obligation's trigger reads `is-a`, which a commitment changes
;;; (`seated-dines`), so the static check flags the program and its routes
;;; are the cube's, every node a fork of root.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; Past the limit a run visits the cube in layer order, 2^16 of its 2^17
;;; nodes. A member met with no member of R met below it is certified
;;; minimal, since every subset was met first; the maximal line needs the
;;; whole cube. A line mode answers from describe's description: it lists
;;; what is certified, says where a line is not known, and counts the members
;;; met (Q-M1e2.19). `ein oracle --region-limit 17` reads the whole cube.
;;;
;;; Nothing is claimed of a flagged program's answer (Q-M1f.564): what is
;;; held of this file is that each line mode says what describe says, a run
;;; against a run.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(import std.algebra :symbols (total-owed))

(relation is-a  T T :why "{?3} is a {?4}")
(relation seats Guest Chair :why "{?3} sits on {?4}")
(relation meal  Diner Food :why "{?3} has {?4} as a meal")

(is-a Ann Guest) (is-a Soup Food)
(is-a C1 Chair)  (is-a C2 Chair)  (is-a C3 Chair)  (is-a C4 Chair)
(is-a C5 Chair)  (is-a C6 Chair)  (is-a C7 Chair)  (is-a C8 Chair)
(is-a C9 Chair)  (is-a C10 Chair) (is-a C11 Chair) (is-a C12 Chair)
(is-a C13 Chair) (is-a C14 Chair) (is-a C15 Chair) (is-a C16 Chair)
(is-a C2 Broken)  (is-a C3 Broken)  (is-a C4 Broken)  (is-a C5 Broken)
(is-a C6 Broken)  (is-a C7 Broken)  (is-a C8 Broken)  (is-a C9 Broken)
(is-a C10 Broken) (is-a C11 Broken) (is-a C12 Broken) (is-a C13 Broken)
(is-a C14 Broken) (is-a C15 Broken) (is-a C16 Broken)

(rule seated-dines ()
  :match  (seats ?g ?c)
  :assert (is-a ?g Diner)
  :why    "{?g} is seated, so {?g} dines")

(rule broken-chair ()
  :match  (and (seats ?g ?c) (is-a ?c Broken))
  :assert (false)
  :why    "{?c} is broken")

(total-owed meal is-a)

(hrule seat () :match (and (is-a ?g Guest) (is-a ?c Chair)) :assert (seats ?g ?c) :why "guess that guest {?g} sits on chair {?c}")
(hrule dine () :match (and (is-a ?g Guest) (is-a ?f Food))  :assert (meal ?g ?f) :why "guess that guest {?g} has food {?f} as a meal")

(query :goal (meal ?g ?f))
