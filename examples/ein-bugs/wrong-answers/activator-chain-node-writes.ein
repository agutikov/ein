;;; A refutation resting on an `absent` over a relation only a plan a node
;;; compiles writes.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `chk` concludes `(false)` from `(p ?y)` while `(x ?y)` is absent. Only
;;; `q2`'s plan writes `x`, and it is compiled from the activator `(q2 a)`,
;;; which `mk2` derives from `(p2 a)`. Root holds neither candidate, so it
;;; compiles no plan of `q2` and derives no `x`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; `x` is a relation a commitment can extend, through the activator a
;;; commitment derives: it is in D⁺, D followed through the rules root has
;;; no plan of, and not in D, whose closure follows the plans root compiled.
;;; So the static check calls `chk`'s read of `x` static and flags the
;;; program for `q2`'s activator site alone.
;;;
;;; Not monotone: the static check flags the program. It loads, every command
;;; answers it with the warning, and nothing is claimed of its answer
;;; (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
(relation seed T :why "{?3} is a seed") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation q2 T :why "q2 holds of {?3}") (relation x T :why "x holds of {?3}")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk2 ()    :match (p2 ?x) :assert (q2 ?x) :why "p2 holds of {?x}, so q2 holds of {?x}, switching rule q2 on for it")
(rule q2  (?n)  :match (seed ?n) :assert (x ?n) :why "q2 holds of the seed {?n}, so x holds of it")
(rule chk ()    :match (and (p ?y) (absent (x ?y))) :assert (false) :why "p holds of {?y} and x does not, which cannot be")
