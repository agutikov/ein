;;; The **control** for [`oblig-fresh-name-two.ein`](oblig-fresh-name-two.ein)
;;; — that file plus one fact, `(food Z)` — M1e2 W14 (S1e2.2.15). Banked
;;; from S1e2.2.4's residue probe of 2026-11-04.
;;;
;;; Until S1e2.2.15 the obligations rung built H here, and with `(food Z)` at
;;; root its `(food ?b)` scan found Z: H was `likes` from Ann and from Bob to
;;; Soup and to Z, and R three states (`ein solve FILE` at `338b5892`,
;;; 2026-11-04). `food` is in D here too, since `special` derives it from a
;;; commitment, and the user ruled on 2026-11-04 that a guard over a relation
;;; in D declines the rung (Q-M1e2.10 (a)): the blind enumerator builds H,
;;; twelve candidates, and R is twelve states, `(likes Ann Bob)` and `(likes
;;; Bob Ann)` free, which the `:expect` below states and its witness answers.

(relation person T :why "{?1} is a person")
(relation food   T :why "{?1} is a food")
(relation likes  T T :why "{?1} likes {?2}")

(person Ann)
(person Bob)
(food Soup)
(food Z)   ; the one addition: Z is a food at root

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (likes ?p ?f)
  :assert (food Z)
  :why    "once {?p} likes {?f}, Z is on the menu")

(solve
  :no-hypothesis (person food)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts.
  :expect (region
            ;; state 1 of 12 — 2 candidates · minimal · from {(likes Ann Z), (likes Bob Soup)}
            (model (likes Ann Z) (likes Bob Soup))
            ;; state 2 of 12 — 2 candidates · minimal · from {(likes Ann Z), (likes Bob Z)}
            (model (likes Ann Z) (likes Bob Z))
            ;; state 3 of 12 — 3 candidates · from {(likes Ann Bob), (likes Ann Z), (likes Bob Soup)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Soup))
            ;; state 4 of 12 — 3 candidates · from {(likes Ann Bob), (likes Ann Z), (likes Bob Z)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Z))
            ;; state 5 of 12 — 3 candidates · from {(likes Ann Z), (likes Bob Ann), (likes Bob Soup)}
            (model (likes Ann Z) (likes Bob Ann) (likes Bob Soup))
            ;; state 6 of 12 — 3 candidates · from {(likes Ann Z), (likes Bob Ann), (likes Bob Z)}
            (model (likes Ann Z) (likes Bob Ann) (likes Bob Z))
            ;; state 7 of 12 — 3 candidates · from {(likes Ann Z), (likes Bob Soup), (likes Bob Z)}
            (model (likes Ann Z) (likes Bob Soup) (likes Bob Z))
            ;; state 8 of 12 — 4 candidates · from {(likes Ann Bob), (likes Ann Z), (likes Bob Ann), (likes Bob Soup)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Ann) (likes Bob Soup))
            ;; state 9 of 12 — 4 candidates · from {(likes Ann Bob), (likes Ann Z), (likes Bob Ann), (likes Bob Z)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Ann) (likes Bob Z))
            ;; state 10 of 12 — 4 candidates · from {(likes Ann Bob), (likes Ann Z), (likes Bob Soup), (likes Bob Z)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Soup) (likes Bob Z))
            ;; state 11 of 12 — 4 candidates · from {(likes Ann Z), (likes Bob Ann), (likes Bob Soup), (likes Bob Z)}
            (model (likes Ann Z) (likes Bob Ann) (likes Bob Soup) (likes Bob Z))
            ;; state 12 of 12 — 5 candidates · maximal · from {(likes Ann Bob), (likes Ann Z), (likes Bob Ann), (likes Bob Soup), (likes Bob Z)}
            (model (likes Ann Bob) (likes Ann Z) (likes Bob Ann) (likes Bob Soup)
                   (likes Bob Z))))

(query
  :goal   (likes ?p ?f))
