;;; W94 — a macro's call that expands to an `(and …)`, written as one conjunct
;;; of a rule's `(and …)` conclusion, stores one fact headed `and`, and none of
;;; the facts the macro names.
;;;
;;; `both` writes `(and (p ?x) (q ?x))`. Called as a rule's whole conclusion it
;;; concludes `(p a)` and `(q a)`; called as one conjunct beside `(r a)`, the
;;; expansion is `(and (r a) (and (p a) (q a)))`, `and-in-and.ein`'s conclusion,
;;; which nobody wrote. Its right answer is that file's: root holds `(r a)`,
;;; `(p a)` and `(q a)`, R is {∅} and both claims hold. Until S1f.6.37 root held
;;; `(r a)` and `(and (p a) (q a))`, both goals had no row and both claims
;;; FAILED, exit 1. E-63 of P1f.6's `findings.md`: S1f.6.16's design met it
;;; placing a macro's call in a closing rule's conclusion.
(relation p Thing :why "p {?1}")
(relation q Thing :why "q {?1}")
(relation r Thing :why "r {?1}")
(macro both (?x) (and (p ?x) (q ?x)) :why "both p and q of {?x}")
(rule nested () :match () :assert (and (r a) (both a)) :why "r of a, and both of a")
(__closed__ p) (__closed__ q) (__closed__ r)
(query :goal (p ?x) :expect (model (p a)))
(query :goal (q ?x) :expect (model (q a)))
