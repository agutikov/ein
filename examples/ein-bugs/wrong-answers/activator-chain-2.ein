;;; A refutation whose activator chain first appears at a node, two links
;;; past D, resting on an `absent` a commitment can fill.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `activator-chain-1.ein` with one link more: `r2`'s plan asserts the
;;; activator `(r3 a)`, and the plan of `r3` it compiles concludes
;;; `(false)`. While `a` has no `p2`, `mk` derives `(q a)` from `(p a)`, and
;;; the chain `q`, `r2`, `r3` runs at a node; root compiles none of the
;;; three.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; The `(false)` rests through three activators on `(absent (p2 a))`, over
;;; a relation a commitment can extend. Neither `r2`'s activator relation
;;; nor `r3`'s is in D; both are in D⁺.
;;;
;;; Not monotone: the static check flags the program. It loads, every command
;;; answers it with the warning, and nothing is claimed of its answer
;;; (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
(relation seed T :why "{?3} is a seed") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation q T :why "q holds of {?3}") (relation r2 T :why "r2 holds of {?3}")
(relation r3 T :why "r3 holds of {?3}")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (and (p ?x) (absent (p2 ?x))) :assert (q ?x) :why "p holds of {?x} and p2 does not, so q holds of {?x}, switching rule q on for it")
(rule q  (?n) :match (seed ?n) :assert (r2 ?n) :why "q holds of the seed {?n}, so r2 holds of it, switching rule r2 on for {?n}")
(rule r2 (?k) :match (seed ?k) :assert (r3 ?k) :why "r2 holds of the seed {?k}, so r3 holds of it, switching rule r3 on for {?k}")
(rule r3 (?m) :match (seed ?m) :assert (false) :why "r3 holds of the seed {?m}, which cannot be")
