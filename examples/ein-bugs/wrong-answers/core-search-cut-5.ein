;;; The witness's shape under the budget — the twin of M1e2 **W23**, register
;;; row `W23/core-search-cut` (`corpus/wrong_answers.toml`), banked by
;;; S1e2.2.23 (2026-11-05) from the inventory of 2026-11-05's F2
;;; (`plans/m1e2_correctness/inventory_2026-11-05/findings/F2_core_cut_5.ein`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `core-search-cut.ein` with five pairs instead of eight: `(A k)` has
;;; 2^5 = 32 environments, under the core search's 64 per fact, and `(B k)`
;;; rests on `(y1 k) … (y5 k)`. Root is dead: no candidate.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; R is empty, every node dead. The search keeps every environment, so it
;;; finds the smallest core, `(y1 k) … (y5 k)`, inside its budget, and no
;;; surface says it was cut.
;;;
;;; ── What the engine answers ────────────────────────────────────────────
;;;
;;; At `e2a3263e`, release and debug: R empty, exit 0, and root's core
;;; `(y1 k) … (y5 k)`, refuted by `clash`, on every surface that prints it.
;;; Since S1e2.2.23 every JSON says `core_status: "within-budget"` beside it,
;;; and no text surface prints anything new, in either build.

(relation x1 T :why "x1 holds of {?1}") (relation y1 T :why "y1 holds of {?1}") (relation p1 T :why "p1 holds of {?1}") (relation x2 T :why "x2 holds of {?1}") (relation y2 T :why "y2 holds of {?1}") (relation p2 T :why "p2 holds of {?1}") (relation x3 T :why "x3 holds of {?1}") (relation y3 T :why "y3 holds of {?1}") (relation p3 T :why "p3 holds of {?1}") (relation x4 T :why "x4 holds of {?1}") (relation y4 T :why "y4 holds of {?1}") (relation p4 T :why "p4 holds of {?1}") (relation x5 T :why "x5 holds of {?1}") (relation y5 T :why "y5 holds of {?1}") (relation p5 T :why "p5 holds of {?1}") (relation A T :why "A holds of {?1}") (relation B T :why "B holds of {?1}")
(x1 k) (y1 k) (x2 k) (y2 k) (x3 k) (y3 k) (x4 k) (y4 k) (x5 k) (y5 k)
(rule lift (?X ?P) :match (?X ?v) :assert (?P ?v) :why "{?X} holds of {?v}, so {?P} holds of {?v}")
(lift x1 p1) (lift y1 p1) (lift x2 p2) (lift y2 p2) (lift x3 p3) (lift y3 p3) (lift x4 p4) (lift y4 p4) (lift x5 p5) (lift y5 p5)
(rule mk-a () :match (and (p1 ?v) (p2 ?v) (p3 ?v) (p4 ?v) (p5 ?v)) :assert (A ?v) :why "p1 to p5 all hold of {?v}, so A holds of {?v}")
(rule mk-b () :match (and (y1 ?v) (y2 ?v) (y3 ?v) (y4 ?v) (y5 ?v)) :assert (B ?v) :why "y1 to y5 all hold of {?v}, so B holds of {?v}")
(rule clash () :match (and (A ?v) (B ?v)) :assert (false) :why "A and B both hold of {?v}, which cannot be")
