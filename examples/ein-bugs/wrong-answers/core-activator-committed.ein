;;; A refutation that rests on an activator which is the commitment itself:
;;; `activator-chain-no-absent.ein`'s mechanism, one step shorter.
;;;
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Two candidates, `(r2 a)` and `(p2 a)`. `(r2 a)` is an activator: the
;;; plan of `r2` it compiles concludes `(false)` from `(seed a)`. Root holds
;;; neither candidate, so it compiles no plan of `r2`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; The refutation rests on `(seed a)`, which the plan matched, and on
;;; `(r2 a)`, the activator the plan was compiled from. A derivation records
;;; the premises its plan matched; a firing records the activator too, and a
;;; core follows an activator a node derives or commits (Q-M1e2.12), so the
;;; commitment is reached and not `(seed a)` alone, which is root's.
;;;
;;; Not monotone: the static check flags the program, and nothing is claimed
;;; of its answer (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation seed T :why "{?3} is a seed") (relation r2 T :why "r2 holds of {?3}, which activates rule r2 for {?3}") (relation p2 T :why "p2 holds of {?3}")

(seed a)

(rule g  () :match (seed ?x) :assert (open (r2 ?x)) :why "guess that r2 holds of the seed {?x}")
(rule g2 () :match (seed ?x) :assert (open (p2 ?x)) :why "guess that p2 holds of the seed {?x}")

(rule r2 (?k) :match (seed ?k) :assert (false) :why "rule r2 is activated for {?k}, a seed, which cannot be")
