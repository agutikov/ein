;;; A refutation whose `absent` is read by a plan only a node compiles.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `mk` derives the activator `(q a)` from `(p a)`, with no `absent`. The
;;; plan of `q` it compiles reads `(absent (p2 ?n))` itself and, while `a`
;;; has no `p2`, asserts the activator `(r2 a)`, whose plan concludes
;;; `(false)`. Root holds neither candidate and compiles no plan of `q` or of
;;; `r2`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; The `(false)` rests through `r2`'s activator on `(absent (p2 a))`, which
;;; `q`'s plan read, over a relation a commitment can extend. Root has no
;;; plan that reads it: the static check's one site is `q`'s activator.
;;;
;;; Not monotone: the static check flags the program. It loads, every command
;;; answers it with the warning, and nothing is claimed of its answer
;;; (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
(relation seed T :why "{?3} is a seed") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation q T :why "q holds of {?3}") (relation r2 T :why "r2 holds of {?3}")

(seed a)

(rule g  () :match (seed ?x) :assert (open (p ?x)) :why "guess that p holds of the seed {?x}")
(rule g2 () :match (seed ?x) :assert (open (p2 ?x)) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (p ?x) :assert (q ?x) :why "p holds of {?x}, so q holds of {?x}, switching rule q on for it")
(rule q  (?n) :match (and (seed ?n) (absent (p2 ?n))) :assert (r2 ?n) :why "q holds of the seed {?n} and p2 does not, so r2 holds of it, switching rule r2 on for {?n}")
(rule r2 (?k) :match (seed ?k) :assert (false) :why "r2 holds of the seed {?k}, which cannot be")
