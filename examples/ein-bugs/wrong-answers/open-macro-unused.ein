;;; a macro's body no rule calls writes `open`, the verdict, and loads —
;;; regression `macro-unused`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `owe`'s body is `(open ?R)`, and no rule calls `owe`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is a name wherever the kernel does not read it, at the head of a
;;; written fact, a premise or a conclusion, and under an ordinary relation the
;;; head of a fact the kernel does not read (Q-M1f.66, Q-M1f.571): here it is
;;; written as a macro's body no rule calls, so the program loads, and every
;;; command answers.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, and R is 4 states, exit 0 on
;;; every command.
;;; The engine loads it.
;;;

(relation a Thing :why "{?3} is an a")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(macro owe (?R) (open ?R) :why "one {?R} is owed")
