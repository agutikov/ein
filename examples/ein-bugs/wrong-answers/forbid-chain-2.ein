;;; *forbid* misses a refutation whose activator chain first appears at a
;;; node, two links past D — M1e2 **W17**, register row `W17/forbid-chain-2`
;;; (`corpus/wrong_answers.toml`), banked by S1e2.2.17 (2026-11-04).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `forbid-chain-1.ein` with one link more: `r2`'s plan asserts the
;;; activator `(r3 a)`, and the plan of `r3` it compiles concludes
;;; `(false)`. While `a` has no `p2`, `mk` derives `(q a)` from `(p a)`, and
;;; the chain `q`, `r2`, `r3` runs at a node; root compiles none of the
;;; three.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(p a)}` dies, its `(false)` resting through three activators on
;;; `(absent (p2 a))`, and `{(p a), (p2 a)}` lives: a dead hole over a
;;; relation a commitment can extend. *forbid* with F2's *via, per
;;; activator*: the program is refused at every command that takes the
;;; universe.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.17 it loaded, as `forbid-chain-1.ein` did: R three states,
;;; the one dead hole {(p a)}, exit 0, in every mode and `ein oracle` (at
;;; `3efd3f5f`). Neither `r2`'s activator relation nor `r3`'s is in D, so
;;; *forbid* read neither, and the status line named no site. Both are in
;;; D⁺ since, and every question about a commitment exits 1: `rule 'r3':
;;; concludes (false) from its activator, which rule 'r2' derives resting on
;;; (absent …) over p2`.

(relation seed T :why "{?1} is a seed") (relation p T :why "p holds of {?1}") (relation p2 T :why "p2 holds of {?1}") (relation q T :why "q holds of {?1}") (relation r2 T :why "r2 holds of {?1}")
(relation r3 T :why "r3 holds of {?1}")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (and (p ?x) (absent (p2 ?x))) :assert (q ?x) :why "p holds of {?x} and p2 does not, so q holds of {?x}, switching rule q on for it")
(rule q  (?n) :match (seed ?n) :assert (r2 ?n) :why "q holds of the seed {?n}, so r2 holds of it, switching rule r2 on for {?n}")
(rule r2 (?k) :match (seed ?k) :assert (r3 ?k) :why "r2 holds of the seed {?k}, so r3 holds of it, switching rule r3 on for {?k}")
(rule r3 (?m) :match (seed ?m) :assert (false) :why "r3 holds of the seed {?m}, which cannot be")
