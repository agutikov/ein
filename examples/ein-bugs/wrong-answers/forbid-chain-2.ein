;;; *forbid* misses a refutation whose activator chain first appears at a
;;; node, two links past D — M1e2 **W17**, register row `W17/forbid-chain-2`
;;; (`corpus/wrong_answers.toml`), banked by S1e2.2.17 (2026-11-04).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `forbid-chain-1.ein` with one link more: `r2`'s plan asserts the
;;; activator `(r3 a)`, and the plan of `r3` it compiles concludes
;;; `(false)`. While `a` has no `p2`, `mk` derives `(q a)` from `(p a)`, and
;;; the chain `q`, `r2`, `r3` runs at a node; root compiles none of the
;;; three.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(p a)}` dies, its `(false)` resting through three activators on
;;; `(absent (p2 a))`, and `{(p a), (p2 a)}` lives: a dead hole over a
;;; relation a commitment can extend. *forbid* with F2's *via, per
;;; activator*: the program is refused at every command that takes the
;;; universe.
;;;
;;; ── What the engine answers ────────────────────────────────────────────
;;;
;;; At `3efd3f5f` it loads, as `forbid-chain-1.ein` does: R three states, the
;;; one dead hole {(p a)}, exit 0, in every mode and `ein oracle`. Neither
;;; `r2`'s activator relation nor `r3`'s is in D, so *forbid* reads neither,
;;; and the status line names no site.

(relation seed T) (relation p T) (relation p2 T) (relation q T) (relation r2 T)
(relation r3 T)

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x))
(hrule g2 () :match (seed ?x) :assert (p2 ?x))

(rule mk () :match (and (p ?x) (absent (p2 ?x))) :assert (q ?x))
(rule q  (?n) :match (seed ?n) :assert (r2 ?n))
(rule r2 (?k) :match (seed ?k) :assert (r3 ?k))
(rule r3 (?m) :match (seed ?m) :assert (false))
