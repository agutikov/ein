;;; A macro whose body writes `(not ?a)`, called with a conjunction under an
;;; `absent`: the stored negation of no fact is matched, and the rule fires —
;;; M1f **W67**, register row `W67/macro-not-conjunction`,
;;; filed by S1f.5.24 (T1f.5.24.2, 2026-11-10).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `neg`'s body is `(not ?a)`, so `(neg (and (p ?x) (q ?x)))` expands to
;;; `(not (and (p ?x) (q ?x)))`, which the grammar refuses where a rule writes
;;; it: `not` is the stored negation of one fact, and a conjunction is no fact.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; The expansion writes a malformed `not`, so `r` is refused at load: every
;;; command exits 1 (`ein test`: 2) (Q-M1f.67, Q-M1f.80).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `dbfd7862`, release: every command answered, exit 0. The matcher read
;;; `(not (and …))` as a pattern no fact can match, so the `absent` held and `r`
;;; fired at root, deriving `(p k)` (`ein saturate --dump`).
;;; Refused at load since S1f.5.24 (T1f.5.24.3).

(relation a Thing :why "{?1} is an a")
(relation s Thing :why "{?1} is an s")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(macro neg (?a) (not ?a) :why "the negation of {?a} is stored")
(rule r ()
  :match  (and (a ?x) (absent (neg (and (p ?x) (q ?x)))))
  :assert (p ?x)
  :why "{?x} is an a, and no negation of p and q is stored of it, so p")
