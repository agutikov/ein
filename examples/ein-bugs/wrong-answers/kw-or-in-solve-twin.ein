;;; The twin of `kw-or-in-solve.ein` — M1e2 **W22**, banked by S1e2.2.22
;;; (2026-11-05): the same program with `orz` renamed `oorz`, its first letter
;;; doubled: a name that starts with no keyword and sorts where `orz` does.
;;; Its answer is the witness's right one, the name read back (`ein solve
;;; FILE` at `35186bc0`, release and debug).

(relation p Node) (relation oorz Node)
(p a) (oorz a)
(solve :expect (region (model (oorz a) (p a))))
