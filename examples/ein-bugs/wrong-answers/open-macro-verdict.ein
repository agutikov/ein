;;; a macro's body writes `open`, the verdict, and a rule's `:assert` calls it:
;;; an obligation through a macro loads — regression
;;; `macro-verdict`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `owe`'s body is `(open ?R)`, so `r`'s `:assert (owe likes)` expands to
;;; `(open likes)`, the verdict, written in a macro and not in the rule.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `open` is a name wherever the kernel does not read it, at the head of a
;;; written fact, a premise or a conclusion, and under an ordinary relation the
;;; head of a fact the kernel does not read (Q-M1f.66, Q-M1f.571): here it is
;;; written as a macro's body, so the program loads, and every command answers.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f62e34e1`, release: the program loads, `r` is an obligation, every alive
;;; node owes a `likes` partner for `k`, and R is empty, exit 0 on every
;;; command.
;;; The engine loads it.

(relation a Thing :why "{?3} is an a")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(relation likes Thing Thing :why "{?3} likes {?4}")
(macro owe (?R) (open ?R) :why "one {?R} is owed")
(rule r ()
  :match  (and (a ?x) (absent (likes ?x ?y)))
  :assert (owe likes)
  :why "{?x} likes nothing yet — one such is still owed")
