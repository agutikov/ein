;;; `alive-set-fresh-name.ein` without its `spawn` rule — an unrecorded survivor at layer 0
;;; under `lookahead false`, and the proof that the banked file's refutation is
;;; not the fresh name's alone. Regression `fresh-name-nospawn`
;;; (`corpus/regressions.toml`).
;;;
;;; Below this header the program is `../alive-set-fresh-name.ein` with the
;;; `spawn` rule deleted: no rule asserts a fresh name, so the alive-set
;;; invariant holds and Q-M1e.21 has nothing to say about this file.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────────
;;;
;;; Every `q` the rung proposes points at A or at B and is refuted in one
;;; firing. Root is consistent and every hypothesis dies with it, so root is
;;; the one solution (Q-M1e.6, clause 3): **`Solution`, k = 1, a model with no
;;; `q` fact.**
;;;
;;; ── What the walk said ─────────────────────────────────────────────────────
;;;
;;;   verdict         No solution — the constraints are contradictory
;;;   unsat core (2 facts)   (q A B)  (q B A)
;;;   exhausted        true
;;;
;;; — the banked file's answer then, with no fresh name in sight. With the
;;; lookahead off each singleton was entered and died at layer 1, and `phase2`
;;; broke on the empty layer without asking whether root was now complete. Now
;;; the answer is the region, R = {∅}, root itself, which `:expect` states. The
;;; banked file's candidates are seeded with `spawn`'s `Z`; with no `spawn`
;;; here, nothing seeds them.
;;;
;;;
;;;

;; The walk's `lookahead false` was a `(config …)` flag, which no route reads:
;; Ein has no such flag, and a program that sets it is refused at load.
;;

(relation p T T :why "p holds of {?3} and {?4}")
(relation q T T :why "q holds of {?3} and {?4}")

(p A B)

(rule no-a ()
  :match  (q ?x A)
  :assert (false)
  :why    "nothing may reach A")

(rule no-b ()
  :match  (q ?x B)
  :assert (false)
  :why    "nothing may reach B")

(solve
  :no-hypothesis (p)
  ;; R is root itself, which has no `q` row: an empty goal extent is a claim
  ;; like any other (Q-M1e.13).
  :expect (region
            ;; state 1 of 1 — ∅, root itself · minimal and maximal
            (model)))

(query
  :goal   (q ?x ?y))
