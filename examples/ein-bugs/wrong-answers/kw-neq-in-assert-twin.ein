;;; The twin of `kw-neq-in-assert.ein`, a control of regression `kw-neq-in-assert`: the same program
;;; with `neqw` renamed `nneqw`, its first letter doubled: a name that starts
;;; with no keyword and sorts where `neqw` does. Its answer is the witness's
;;; right one, the name read back (`ein solve FILE` at `35186bc0`, release and
;;; debug).

(relation p Node :why "p holds of {?3}") (relation nneqw Node :why "nneqw holds of {?3}")
(p a)
(rule r () :match (p ?x) :assert (nneqw ?x) :why "p holds of {?x}, so nneqw holds of {?x}")
(query :goal (nneqw ?y))
