;;; The kernel's other dunder among the blind enumerator's objects —
;;; regression `symmetric-by-rule` (`corpus/regressions.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; A relation `near`, written both ways round, that a rule declares
;;; symmetric: `(__symmetric__ near)` derived and never written as a fact.
;;; `near` is scoped out of the hypotheses; beside it is a relation the
;;; program declares and does not close, `total`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; The hypotheses are the facts of `total` over the program's names, `a` and
;;; `b`: two candidates. `__symmetric__` is the kernel's word for *this
;;; relation holds both ways round* and no object. Nothing restricts the two,
;;; so R is the whole cube, four states.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; Three candidates, `(total __symmetric__)` among them, and R eight states,
;;; as `dunder-object-closed-by-rule.ein` did for `__closed__`. The answer is
;;; the one above now.

(relation near Thing Thing :why "{?1} is near {?2}")
(near a b) (near b a)
(rule near-symmetric () :match () :assert (__symmetric__ near)
  :why "near holds both ways round")
(relation total Number :why "the total is {?1}")
(solve :no-hypothesis (near))
(query :goal (total ?x))
