;;; `ein saturate` resolves no file-relative import — regression
;;; `saturate-import` (`corpus/regressions.toml`).
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; A file-relative import of `q` from `saturate-import-mod.ein`, beside this
;;; file, which declares it; one fact over it, `(q m)`, and one rule from it:
;;; R is {∅}, root holding `(q m)` and `(r m)`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; A file-relative `(import …)` resolves against the importing file's own
;;; directory (`syntax.md` § Imports), and the user's rule is one tool,
;;; consistent answers: `ein saturate` loads this program as `ein solve` does,
;;; and answers it, exit 0.
;;;
;;; ── What the engine answered, and what it answers ──────────────────────
;;;
;;; Every command loads a program through one path, against the file's own
;;; directory, so `ein saturate` answers this file, exit 0. The wrong answer:
;;; `ein saturate` loaded it with no base directory and refused this file,
;;; exit 1, with `kb load error: (import saturate-import-mod) — file-relative
;;; import needs a base directory (load from a file path) at None`, while
;;; `ein solve`, `oracle` and `test` answered it.
;;;
;;;

(import saturate-import-mod :symbols (q))

(relation r T :why "{?1} is an r")

(q m)

(rule lift () :match (q ?x) :assert (r ?x) :why "{?x} is a q, so {?x} is an r")

(query :goal (r ?x))
