;;; A refutation whose activator chain first appears at a node, resting on
;;; an `absent` a commitment can fill.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Two candidates, `(p a)` and `(p2 a)`. While `a` has no `p2`, `mk`
;;; derives `(q a)` from `(p a)`. `(q a)` is an activator: the plan of `q`
;;; it compiles asserts `(r2 a)`, another activator, and the plan of `r2`
;;; that one compiles concludes `(false)`. Root holds neither candidate, so
;;; it derives none of this and compiles no plan of `q` or of `r2`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; The `(false)` rests through two activators on `(absent (p2 a))`, and
;;; `p2` is a relation a commitment can extend. `q`'s activator relation is
;;; in D (root's plan of `mk` writes it); `r2`'s is not, since only `q`'s
;;; plan, which root never compiled, writes it: it is in D⁺, D followed
;;; through the rules root has no plan of.
;;;
;;; Not monotone: the static check flags the program. It loads, every command
;;; answers it with the warning, and nothing is claimed of its answer
;;; (Q-M1f.564).
;;;
;;; `activator-chain-0.ein` is the same chain one link shorter, and
;;; `activator-chain-2.ein` one link longer.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
(relation seed T :why "{?3} is a seed") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation q T :why "q holds of {?3}") (relation r2 T :why "r2 holds of {?3}")

(seed a)

(rule g  () :match (seed ?x) :assert (open (p ?x)) :why "guess that p holds of the seed {?x}")
(rule g2 () :match (seed ?x) :assert (open (p2 ?x)) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (and (p ?x) (absent (p2 ?x))) :assert (q ?x) :why "p holds of {?x} and p2 does not, so q holds of {?x}, switching rule q on for it")
(rule q  (?n) :match (seed ?n) :assert (r2 ?n) :why "q holds of the seed {?n}, so r2 holds of it, switching rule r2 on for {?n}")
(rule r2 (?k) :match (seed ?k) :assert (false) :why "r2 holds of the seed {?k}, which cannot be")
