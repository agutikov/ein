;;;
;;; At `f62e34e1`, release: the program loads, `open` an auto-vivified relation
;;; holding `(open x)`; `x` is a name of the program, so H is five candidates
;;; and R 32 states, exit 0 on every command.
;;; The engine refuses it at the parse.
;;;

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(is-a k Thing)
(a k)
(open x)
