;;; A disjunction nested inside a conjunction, in an hrule: `ein saturate`
;;; answers and every solve question stops — M1f **W62**, register row
;;; `W62/nested-or-hrule`, filed by S1f.5.21 (T1f.5.21.1, 2026-11-10).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; An hrule is compiled where the hypothesis layer asks it for candidates,
;;; which a saturation never does.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; An `(or …)` is a whole `:match`, an hrule's as a rule's, so `h` is
;;; refused at load: every command exits 1 (`ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `864b16ed`, release: `ein saturate` answered root's fixpoint, exit 0;
;;; `ein solve` (every mode), `oracle` and `render lattice` stopped, exit 1,
;;; on the compiler's line. Refused at load since S1f.5.21 (T1f.5.21.2).

(relation a Thing :why "{?1} is an a")
(relation p Thing :why "{?1} is a p")
(relation q Thing :why "{?1} is a q")
(a k)
(hrule h ()
  :match  (and (a ?x) (or (p ?x) (q ?x)))
  :assert (p ?x)
  :why "{?x} is an a, and a p or a q, so guess it is a p")
(solve :hrules (h))
