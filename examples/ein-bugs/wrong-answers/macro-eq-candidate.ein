;;; A macro whose body writes `eq` with one argument, called as a hypothesis rule's
;;; conclusion: the hypothesis layer proposes `(eq k)`, and a state holds it —
;;; regression `macro-eq-candidate`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `h`'s `:assert` expands to `(open (eq ?x))`, the `(eq ?x)` that
;;; `macro-eq-conclusion.ein`'s rule's does, as a hypothesis: what the hypothesis
;;; layer proposed, so `(eq k)` was a candidate, H.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; The expansion writes `eq` where a value goes, so `h` is refused at load: every
;;; command exits 1 (`ein test`: 2) (Q-M1f.67, Q-M1f.80).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `dbfd7862`, release: every command answered, exit 0. H was `{(eq k)}`,
;;; and R two states, the second holding `(eq k)` (`ein solve --maximal`): the
;;; conclusion was executed by the hypothesis layer.
;;; The engine refuses it at load.
;;;

(relation a Thing :why "{?3} is an a")
(relation s Thing :why "{?3} is an s")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(macro one (?a) (eq ?a) :why "{?a} equals")
(rule h ()
  :match  (a ?x)
  :assert (open (one ?x))
  :why "{?x} is an a, so guess it equals")
