;;; `stale-naf-fork.ein` with `(config :warn-derived-naf true)` — the twin that
;;; shows the stale fact is *not* contained by the warning that flag turned on.
;;; Regression `stale-naf-fork`, as a twin.
;;;
;;; As banked, below this header the program was `stale-naf-fork.ein` plus the
;;; one `(config …)` line. The engine's answer was the same — `Solution`
;;; k = 1, `{(p one)}` — and the run narrated **no `warn` event of either
;;; category**: the diagnostic named a rule that concludes `(false)` from an
;;; `(absent …)` (`naf-upward-closure.ein`'s shape), and here the `absent` is
;;; in a rule that concludes a positive, and the contradiction is reached by a
;;; different rule reading what it left behind.
;;;
;;; ── Refused: *forbid*, through a derived fact ─────────────────────────────
;;;
;;; As `stale-naf-fork.ein`: `p-and-q-clash` rests on `(absent (q ?x))`
;;; through `p`, which *forbid* counts (Q-M1e2.5), so the program is refused
;;; at load. What this twin shows, that the warning did not see the derived
;;; case, is why the refusal reads derivations. `:warn-derived-naf` is a
;;; retired flag, refused at the parse, so the program below is
;;; `stale-naf-fork.ein`'s; the file stays as the regression's twin, whose
;;; record says what the engine answered with the flag. It is refused at the
;;; same commands as `stale-naf-fork.ein`, with the same line, and
;;; `ein saturate` runs.
;;;
;;;

(relation thing T :why "{?3} is a thing")
(relation p T :why "p holds of {?3}")
(relation q T :why "q holds of {?3}")
(thing one)
(rule derive-p ()
  :match  (and (thing ?x) (absent (q ?x)))
  :assert (p ?x) :why "{?x} is a thing and no q fact holds of it, so p holds of {?x}")
(rule p-and-q-clash ()
  :match  (and (p ?x) (q ?x))
  :assert (false) :why "both p and q hold of {?x}, which cannot be")
(query :goal (q ?x))
