;;; `stale-naf-fork.ein` again, the twin kept beside it.
;;;
;;; The program below is `stale-naf-fork.ein`'s: a rule that concludes a
;;; positive under an `absent`, and a contradiction reached by a different
;;; rule reading what it left behind. No advisory about a rule that
;;; concludes `(false)` from an `(absent …)` names either rule: the
;;; `absent` is in the rule that concludes the positive.
;;;
;;; ── What is said of it ────────────────────────────────────────────────────
;;;
;;; As of `stale-naf-fork.ein`: `p-and-q-clash` rests on `(absent (q ?x))`
;;; through `p`. The static check flags the program; it loads, and nothing
;;; is claimed of its answer (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation thing T :why "{?3} is a thing")
(relation p T :why "p holds of {?3}")
(relation q T :why "q holds of {?3}")
(thing one)
(rule derive-p ()
  :match  (and (thing ?x) (absent (q ?x)))
  :assert (p ?x) :why "{?x} is a thing and no q fact holds of it, so p holds of {?x}")
(rule p-and-q-clash ()
  :match  (and (p ?x) (q ?x))
  :assert (false) :why "both p and q hold of {?x}, which cannot be")
(query :goal (q ?x))
