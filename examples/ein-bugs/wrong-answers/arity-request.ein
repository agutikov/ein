;;; A request to the calculator with one operand where it declares two loads,
;;; and is answered by silence —
;;; M1f **W89**, register row `W89/request` (`corpus/wrong_answers.toml`),
;;; filed by S1f.6.23 (T1f.6.23.2, 2026-11-12); m6c of P1f.6's
;;; `malformed_numbers.md`.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `std.math.decimal-arith` declares `(relation add Operand Operand)`. The request gives
;;; one operand.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `(add (n z 5))` is a form headed by a declared relation with one argument
;;; where the declaration has two types: the program is refused at load, at
;;; the form, one line naming the relation and the two counts, on every
;;; command (exit 1, `ein test`: 2).
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `f9a6fd1d`, release: the program loads, no rule matches `add` with one
;;; argument, nothing is derived, and the goal has no row, exit 0 on every
;;; command, with no word.
;;; Refused at load since S1f.6.23 (T1f.6.23.3).

(import std.math.decimal-arith :symbols (decimal-arith add sum-of))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(add (n z 5))

(query :goal (sum-of ?x ?y ?s) :goal-text "{?x} + {?y} = {?s}")
