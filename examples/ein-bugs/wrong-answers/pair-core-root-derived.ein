;;; A pair contradiction's core names only its positive side, where that side
;;; is a fact root derives — **W21**, regression
;;; `pair-core-root-derived` (`corpus/regressions.toml`):
;;; `pair-core-root-given.ein`'s mechanism, one derivation deeper.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Root derives `(p a)` from `(seed a)` by `mk`. One candidate, `(q a)`:
;;; committed, it derives `(not (p a))` by `neg`, a pair whose positive side
;;; root derives and whose negative side the commitment derives.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; R is {∅}, and N is {(q a)}. The pair rests on `(p a)`, which rests on
;;; `(seed a)`, and on `(not (p a))`, which rests on `(q a)`: the core is
;;; `(q a) (seed a)`, which names the commitment. `(seed a)` alone is
;;; root's, and root is alive.
;;;
;;; ── What the engine answered, and what it answers ──────────────────────
;;;
;;; At `cdcc3994` (`ein solve FILE --dump-answer DIR`, release and debug): R
;;; as above, exit 0; and N's core `(seed a)` alone, refuted by `mk` and
;;; `neg`, on every surface that reports it: the positive side's frontier.
;;; Today N's core is `(q a) (seed a)`, in either build.
;;;

(relation seed T :why "{?1} is a seed") (relation p T :why "p holds of {?1}") (relation q T :why "q holds of {?1}")

(seed a)

(rule mk () :match (seed ?x) :assert (p ?x) :why "{?x} is a seed, so p holds of {?x}")

(hrule g () :match (seed ?x) :assert (q ?x) :why "{?x} is a seed: guess that q holds of {?x}")

(rule neg () :match (q ?x) :assert (not (p ?x)) :why "q holds of {?x}, so p does not hold of {?x}")
