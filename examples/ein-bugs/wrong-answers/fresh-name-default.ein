;;; `alive-set-fresh-name.ein`'s twin, in isolation: a rule's fresh
;;; constant never became a hypothesis. Regression `fresh-name-default`
;;; (`corpus/regressions.toml`), **fixed**.
;;;
;;;
;;; Below this header the program is `../alive-set-fresh-name.ein`'s but its
;;; claim; that file's header is the argument and is not repeated here.
;;;
;;;
;;; ── Why this twin exists ───────────────────────────────────────────────────
;;;
;;; The banked file's `k = 0, exhausted = true` was **confounded**: delete its
;;; `spawn` rule — so no fresh name exists at all — and it still answered
;;; `Contradiction` (`fresh-name-nospawn.ein`), which was an unrecorded survivor at layer 0 under
;;; the file's lookahead-off line, not the fresh name. With the lookahead on, the kill cache
;;; refuted both candidates before layer 1, `alive` was empty, root was
;;; recorded, and what was left was the fresh-name defect alone: `Solution`, k =
;;; 1, over a model with no `q` fact at all. Under the region, before
;;; `02e9fb5f`, both files answered R = {∅}.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────────
;;;
;;; `{(q A Z), (q B Z)}` saturates to a consistent, quiescent state — `spawn`
;;; adds `(p Z Z)`, neither refutation fires — and every further `q` is refuted,
;;; so it is the maximal state, and R is it, ∅ and its two singletons.
;;; `../alive-set-fresh-name-declared.ein` (one fact, `(seen Z)`, more) reaches
;;; it, and so does this file, the blind enumerator's objects being seeded with
;;; every constant a rule's `:assert` names (Q-M1e.21): `ein solve FILE
;;; --maximal` lists `(model (q A Z) (q B Z))`.
;;;
;;;
;;; **No `:expect`**: the regression states the run, and the banked file states
;;; the region.
;;;
;;;

(relation p T T :why "p holds of {?3} and {?4}")
(relation q T T :why "q holds of {?3} and {?4}")

(p A B)

(rule spawn ()
  :match  (q ?a ?b)
  :assert (p ?b Z)
  :why    "committing to (q {?a} {?b}) names Z, which no fact does")

(rule no-a ()
  :match  (q ?x A)
  :assert (false)
  :why    "nothing may reach A")

(rule no-b ()
  :match  (q ?x B)
  :assert (false)
  :why    "nothing may reach B")

(solve
  :no-hypothesis (p))

(query
  :goal   (q ?x ?y))
