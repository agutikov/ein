;;; The twin of `kw-neq-in-goal.ein`, a control of regression `kw-neq-in-goal`: the same program
;;; with `neqw` renamed `nneqw`, its first letter doubled: a name that starts
;;; with no keyword and sorts where `neqw` does. Its answer is the witness's
;;; right one, the name read back (`ein solve FILE` at `35186bc0`, release and
;;; debug).

(relation p Node :why "p holds of {?3}") (relation nneqw Node :why "nneqw holds of {?3}") (relation tag Node :why "{?3} is tagged")
(p a) (nneqw a)
(rule h () :match (p ?x) :assert (open (tag ?x)) :why "p holds of {?x}; guess that {?x} is tagged")
(query :goal (nneqw ?y))
