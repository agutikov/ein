;;; The twin of `kw-neq-in-goal.ein` — M1e2 **W22**, banked by S1e2.2.22
;;; (2026-11-05): the same program with `neqw` renamed `nneqw`, its first
;;; letter doubled: a name that starts with no keyword and sorts where `neqw`
;;; does. Its answer is the witness's right one, the name read back (`ein
;;; solve FILE` at `35186bc0`, release and debug).

(relation p Node :why "p holds of {?1}") (relation nneqw Node :why "nneqw holds of {?1}") (relation tag Node :why "{?1} is tagged")
(p a) (nneqw a)
(hrule h () :match (p ?x) :assert (tag ?x) :why "p holds of {?x}; guess that {?x} is tagged")
(query :goal (nneqw ?y))
