;;; A table imported flat arrives empty, so the rule that looks it up never
;;; fires — **W88**, regression `import-facts-table`
;;; (`corpus/regressions.toml`); the calculator's case.
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `import-facts-table-module.ein`, beside this file, writes two rows of the
;;; full adder's table as facts of `fa`, and the rule `add2`, which answers a
;;; request `(add …)` by looking the table up. This program lists the rule,
;;; asks 9 + 1, and reads the sum. No candidate, so R is {∅}.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; An import brings its module whole (Q-M1f.247): `add2`, the declarations it
;;; names, `add`, `num2`, `fa` and `sum-of`, and the two `fa` rows. The units
;;; column is `(fa 9 1 0 0 1)`, digit 0 and carry 1, and the tens column `(fa 0
;;; 0 1 1 0)`, digit 1: root holds `(sum-of (num2 0 9) (num2 0 1) (num2 1 0))`,
;;; and the goal has that one row.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `7f574423`, release: the rule and the four declarations are kept and the
;;; table dropped, so `add2` never fires and the goal has no row, exit 0, with
;;; no word. Now the answer above by hand.
;;;

(import import-facts-table-module :symbols (add2 add num2 sum-of))

(add (num2 0 9) (num2 0 1))

(solve :hypothesis-relations ())
(query :goal (sum-of ?x ?y ?s) :goal-text "{?x} + {?y} = {?s}")
