;;; A boundary of `pair-core-root-given`: a pair contradiction whose *negative* side is
;;; root's. No regression: the core the engine reports names the
;;; commitment.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; The program states `(not (p a))`. One candidate, `(q a)`: committed, it
;;; derives `(p a)` by `pos`, a pair whose positive side the commitment
;;; derives and whose negative side root states.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; R is {∅}, and N is {(q a)}. The pair rests on `(p a)`, which rests on
;;; `(q a)`, and on `(not (p a))`, stated: the core is `(not (p a)) (q a)`.
;;;
;;; ── What the engine answered, and what it answers ──────────────────────
;;;
;;; At `cdcc3994` (`ein solve FILE --dump-answer DIR`, release and debug): R
;;; as above, exit 0; and N's core `(q a)`, refuted by `(given)` and `pos`:
;;; the positive side's frontier, which here is the commitment's, so the core
;;; named it, and left out the stated `(not (p a))` the pair rests on too.
;;; Today it is `(not (p a)) (q a)`, in either build; it names the commitment
;;; either way, which is why this file is a boundary and not a row.
;;;

(relation p T :why "p holds of {?3}") (relation q T :why "q holds of {?3}") (relation seed T :why "{?3} is a seed")

(seed a)
(not (p a))

(hrule g () :match (seed ?x) :assert (q ?x) :why "{?x} is a seed: guess that q holds of {?x}")

(rule pos () :match (q ?x) :assert (p ?x) :why "q holds of {?x}, so p holds of {?x}")
