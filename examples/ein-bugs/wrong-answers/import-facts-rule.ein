;;; A flat import keeps a library's rule and drops the facts the rule reads —
;;; **W88**, register row `W88/import-facts-rule` (`corpus/wrong_answers.toml`).
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `import-facts-library.ein`, beside this file, states `(is-a Tea Drink)`
;;; and `(is-a Milk Drink)` and holds the rule `liquids`, *a drink is a
;;; liquid*. This program lists the rule alone, and asks what is a liquid. No
;;; candidate, so R is {∅}.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; An import brings its module whole (Q-M1f.247): `liquids`, `is-a`'s
;;; declaration and `is-a`'s facts. The rule fires on each: root holds `(liquid
;;; Tea)` and `(liquid Milk)`, and the goal has two rows.
;;;
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `7f574423`, release: the rule and the declaration are kept and the facts
;;; dropped, so the rule never fires and the goal has no row, exit 0, with no
;;; word. Now the answer above by hand.
;;;

(import import-facts-library :symbols (liquids))

(solve :hypothesis-relations ())
(query :goal (liquid ?x) :goal-text "{?x} is a liquid")
