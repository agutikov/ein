;;; it stands. R is empty. Since nothing is stored, `w` is in no fact, and no
;;; name of the program: H is empty.
;;;
;;; ── What the engine answers ────────────────────────────────────────────
;;;
;;; The fact is stored: root holds `(eq a w)` (`ein saturate FILE --dump`), `w`
;;; is a name of the program, so `(p w)` is a candidate, and R is two states, ∅
;;; and `{(p w)}`, exit 0 (`ein solve FILE` and `ein oracle FILE` at
;;; `dc4c0bdc`, release and debug alike).

(relation p Node :why "{?1} is a node")
(p a)
(eq a w)
