;;; The twin of `kw-relation-fact.ein`, a control of regression `kw-relation-fact`: the same program
;;; with `relationship` renamed `rrelationship`, its first letter doubled: a
;;; name that starts with no keyword and sorts where `relationship` does. Its
;;; answer is the witness's right one, the name read back (`ein solve FILE` at
;;; `35186bc0`, release and debug).
;;;

(relation person Node :why "{?3} is a person") (relation rrelationship Node Node :why "{?3} has an rrelationship with {?4}")
(person alice) (person bob)
(rrelationship alice bob)
