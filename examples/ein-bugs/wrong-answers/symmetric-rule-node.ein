;;; The control of `symmetric-derived-node.ein` — **W98**, regression
;;; `derived-at-node`'s control (`corpus/regressions.toml`).
;;;
;;; The same program with `near` closed under the swap by a rule of its own,
;;; `close-mirror`, once anything is close: the closure `std.algebra`'s
;;; `symmetric` computes and the kernel's native mirror computes for a marked
;;; relation. Nothing else differs. A state that holds `(close a)` or `(close
;;; b)` holds `(near b a)` and is dead by `one-way`; root holds neither and is
;;; alive. R is {∅}, which is the witness's right answer.

(relation near Thing Thing :why "{?1} is near {?2}")
(relation close Thing :why "{?1} is close")
(near a b)
(rule close-mirror () :match (and (close ?z) (near ?x ?y)) :assert (near ?y ?x)
  :why "{?z} is close and {?x} is near {?y}, so {?y} is near {?x}")
(rule one-way () :match (near b a) :assert (false)
  :why "near holds one way only, from a to b")
(solve :no-hypothesis (near))
(query :goal (close ?x))
