;;; A rule's false `eq` conclusion is stored as a fact —
;;; regression `assert-eq-x-w` (`corpus/regressions.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; One fact `(p a)` and a rule concluding `(eq ?x w)` from `(p ?x)`. `w` is a
;;; name of the program, so `(p w)` is a candidate.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; A rule's conclusion of `eq` is checked, never stored, and two different
;;; names are two values, so `(eq a w)` cannot make them one (Q-M1e2.26). At root
;;; the rule concludes `(eq a w)`, which is false, so root is a contradiction:
;;; its core is `(p a)` and `refuted by` names `r`. R is empty.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; The conclusion was stored: root held `(eq a w :rule r)` (`ein saturate
;;; FILE --dump`), and R was two states, ∅ and `{(p w)}`, exit 0 (`ein solve
;;; FILE` and `ein oracle FILE` at `ec004a48`, the engine `916d97ac`'s,
;;; release and debug alike). The engine now gives the answer by hand.
;;;
;;;

(relation p Node :why "p holds of {?1}")
(p a)
(rule r () :match (p ?x) :assert (eq ?x w) :why "p holds of {?x}, so {?x} is w")
