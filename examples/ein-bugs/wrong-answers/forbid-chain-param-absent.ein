;;; *forbid* misses a refutation resting on an `absent` over the relation a
;;; parameter names, in a plan only a node compiles — M1e2 **W17**, register
;;; row `W17/forbid-chain-param-absent` (`corpus/wrong_answers.toml`), found
;;; by S1e2.2.17 (2026-11-04) probing the witness's mechanism.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `mk` derives the activator `(watch p2)` from `(p a)`. The plan of `watch`
;;; it compiles binds `?R` to `p2`: while `a` has no `p2` it asserts
;;; `(y a)`, and `bad` concludes `(false)` from any `y`. Root holds neither
;;; candidate, so it compiles no plan of `watch` and derives no `y`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(p a)}` dies, `bad`'s `(false)` resting through `(y a)` on
;;; `(absent (p2 a))`, and `{(p a), (p2 a)}` lives: a dead hole over a
;;; relation a commitment can extend. *forbid* with F2's *via*: the program
;;; is refused at every command that takes the universe.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.17 it loaded: R three states, the one dead hole {(p a)},
;;; exit 0, in every mode and `ein oracle` (at `3efd3f5f`). *forbid* read
;;; `watch` from its pattern (its activator relation is in D) and would have
;;; refused it were it the refutation (its parameter's relation read under an
;;; `absent`), but it did not follow what `watch` derives into N, so `bad`'s
;;; read of `y` was never tainted. The status line named no site. Since then
;;; an open rule's `absent` over its parameter's relation taints what it
;;; derives, whatever a node binds the parameter to, and every question
;;; about a commitment exits 1: `rule 'bad': concludes (false) from y, which
;;; rule 'watch' derives resting on (absent …) over the relation its
;;; parameter ?R names`.

(relation seed T :why "{?1} is a seed") (relation p T :why "p holds of {?1}") (relation p2 T :why "p2 holds of {?1}") (relation y T :why "y holds of {?1}") (relation watch T :why "the relation {?1} is watched")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk    ()   :match (p ?x) :assert (watch p2) :why "p holds of {?x}, so p2 is watched, switching rule watch on for it")
(rule watch (?R) :match (and (seed ?x) (absent (?R ?x))) :assert (y ?x) :why "{?R} is watched and does not hold of the seed {?x}, so y holds of {?x}")
(rule bad   ()   :match (y ?x) :assert (false) :why "y holds of {?x}, which cannot be")
