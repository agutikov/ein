;;; A refutation whose plan matches no fact, compiled from an activator a
;;; node derives: `activator-chain-no-absent.ein`'s mechanism with a guard
;;; and no pattern.
;;;
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Two candidates, `(p a)` and `(p2 a)`. `mk` derives `(w a)` from `(p a)`.
;;; `(w a)` is an activator: the plan of `w` it compiles has a guard and no
;;; pattern, `(eq a a)`, which holds, so it concludes `(false)` with no
;;; premise. Root holds no `p`, so it compiles no plan of `w`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; The derivation of `(false)` records no premise: the refutation rests on
;;; the activator `(w a)`, which rests on `(p a)`. A firing records the
;;; activator its plan was compiled from, and a core follows one the node
;;; derived (Q-M1e2.12).
;;;
;;; Not monotone: the static check flags the program, and nothing is claimed
;;; of its answer (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation seed T :why "{?3} is a seed") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation w T :why "w holds of {?3}, which activates rule w for {?3}")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (p ?x) :assert (w ?x) :why "p holds of {?x}, so w holds of {?x}")
(rule w (?n) :match (eq ?n a) :assert (false) :why "rule w is activated for {?n}, and {?n} is a, which cannot be")
