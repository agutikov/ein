(relation a Thing :why "{?3} is an a")
(relation p Thing :why "{?3} is a p")
(relation q Thing :why "{?3} is a q")
(is-a k Thing)
(a k)
(rule copy (?R)
  :match  (?R ?x)
  :assert (q ?x)
  :why "{?x} is in {?R}, so it is a q")
(rule start ()
  :match  (a ?x)
  :assert (copy open)
  :why "{?x} is an a, so whatever is in open is a q")
