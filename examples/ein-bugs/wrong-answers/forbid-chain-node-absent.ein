;;; *forbid* misses a refutation whose `absent` is read by a plan only a node
;;; compiles — M1e2 **W17**, register row `W17/forbid-chain-node-absent`
;;; (`corpus/wrong_answers.toml`), found by S1e2.2.17 (2026-11-04) probing
;;; the witness's mechanism.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `mk` derives the activator `(q a)` from `(p a)`, with no `absent`. The
;;; plan of `q` it compiles reads `(absent (p2 ?n))` itself and, while `a`
;;; has no `p2`, asserts the activator `(r2 a)`, whose plan concludes
;;; `(false)`. Root holds neither candidate and compiles no plan of `q` or of
;;; `r2`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `{(p a)}` dies, its `(false)` resting through `r2`'s activator on
;;; `(absent (p2 a))`, which `q`'s plan read, and `{(p a), (p2 a)}` lives: a
;;; dead hole over a relation a commitment can extend. *forbid* with F2's
;;; *via, per activator*: the program is refused at every command that takes
;;; the universe.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.17 it loaded: R three states, the one dead hole {(p a)},
;;; exit 0, in every mode and `ein oracle` (at `3efd3f5f`). *forbid* read `q`
;;; from its pattern (its activator relation is in D), but only for what it
;;; derives from a tainted relation, not for the `absent` it reads itself, so
;;; `(r2 ?n)` was never tainted; and `r2`'s activator relation is not in D,
;;; so `r2` was never read. The status line named no site. Since then an
;;; open rule's own `absent` over a relation in D⁺ taints what it derives,
;;; `r2` is read over D⁺, and every question about a commitment exits 1:
;;; `rule 'r2': concludes (false) from its activator, which rule 'q' derives
;;; resting on (absent …) over p2`.

(relation seed T :why "{?1} is a seed") (relation p T :why "p holds of {?1}") (relation p2 T :why "p2 holds of {?1}") (relation q T :why "q holds of {?1}") (relation r2 T :why "r2 holds of {?1}")

(seed a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk () :match (p ?x) :assert (q ?x) :why "p holds of {?x}, so q holds of {?x}, switching rule q on for it")
(rule q  (?n) :match (and (seed ?n) (absent (p2 ?n))) :assert (r2 ?n) :why "q holds of the seed {?n} and p2 does not, so r2 holds of it, switching rule r2 on for {?n}")
(rule r2 (?k) :match (seed ?k) :assert (false) :why "r2 holds of the seed {?k}, which cannot be")
