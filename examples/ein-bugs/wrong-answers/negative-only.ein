;;; A name written **only inside a nested fact** never became a candidate —
;;; regression `negative-only` (`corpus/regressions.toml`).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; The program of `../alive-set-fresh-name.ein` without its `spawn` rule,
;;; plus the stored negative `(not (q Z A))`. `Z` is written in a fact, but
;;; only inside the nested `(q Z A)`: the KB's names index does not index a
;;; nested fact's arguments (Q40, *the nested fact is interned, not
;;; believed*), and `Z` is in no rule's `:assert`, so an enumerator that takes
;;; its objects from those two places proposes over A and B alone.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; Every constant a fact names, at any depth, is a name of the program and so a
;;; candidate object (`docs/ein/reasoning/02-kb-evolution/06-solution-semantics.md`
;;; § 1.2, Q-M1e2.9). So H is `q` over A, B and Z
;;; without self-edges and without the negated `(q Z A)`: five candidates,
;;; three dead alone. `{(q A Z), (q B Z)}` is consistent and quiescent and is
;;; the maximal state: R is ∅, `{(q A Z)}`, `{(q B Z)}` and both —
;;; `negative-only-declared.ein`'s R, which names `Z` at top level.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; At `b63a8738` (`ein solve FILE`), H was 2 candidates, `(q A B)` and
;;; `(q B A)`, both dead alone, and R was `{∅}`.
;;; The blind enumerator's objects are every name of the program
;;; (`invariant::program_names`), a nested fact's arguments among them, and
;;; this file answers its control's R, which the `:expect` below states. The
;;; regression `negative-only` is fixed.
;;;
;;;

(relation p T T :why "p holds of {?3} and {?4}")
(relation q T T :why "q holds of {?3} and {?4}")

(p A B)
(not (q Z A))

(rule no-a ()
  :match  (q ?x A)
  :assert (false)
  :why    "nothing may reach A")

(rule no-b ()
  :match  (q ?x B)
  :assert (false)
  :why    "nothing may reach B")

(solve
  :no-hypothesis (p)
  ;; `q` is named, so this closes `q`: exactly these positive `q` facts —
  ;; the -declared control's R, which this file answers too.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model)
            ;; state 2 of 4 — 1 candidate · from {(q A Z)}
            (model (q A Z))
            ;; state 3 of 4 — 1 candidate · from {(q B Z)}
            (model (q B Z))
            ;; state 4 of 4 — 2 candidates · maximal · from {(q A Z), (q B Z)}
            (model (q A Z) (q B Z))))

(query
  :goal   (q ?x ?y))
