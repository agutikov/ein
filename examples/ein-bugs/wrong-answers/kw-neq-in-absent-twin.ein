;;; The twin of `kw-neq-in-absent.ein`: the same program
;;; with `neqw` renamed `nneqw`, its first letter doubled: a name that starts
;;; with no keyword and sorts where `neqw` does. The witness answers as this
;;; file does, the name read back. Flagged as the witness is, and nothing is
;;; claimed of its answer (Q-M1f.564).

(relation p Node :why "p holds of {?3}") (relation nneqw Node :why "nneqw holds of {?3}") (relation hit Node :why "{?3} is a hit")
(p a) (nneqw b)
(rule r () :match (and (p ?x) (absent (nneqw ?x))) :assert (hit ?x) :why "p holds of {?x} and nneqw does not, so {?x} is a hit")
