;;; A boundary of M1e2 **W19** (`corpus/wrong_answers.toml`, S1e2.2.19,
;;; 2026-11-04): the activator is one root derives from a fact the program
;;; states.
;;;
;;; `mk0` derives `(r2 a)` from the given `(start a)`, so root compiles the
;;; plan of `r2`, which concludes `(false)` from the commitment `(p a)`. R is
;;; two states, ∅ and {(p2 a)}; N is {(p a)}, and its core is `(p a)` (`ein
;;; solve FILE --dump-answer DIR` at `a41eb76e`). Whether the core also names
;;; what root derived the activator from, `(p a) (start a)`, was Q-M1e2.12:
;;; it does under *every activator* and under *a derived one*, the stage
;;; file's two readings, and not under *one only a node derives*, which the
;;; user ruled on 2026-11-04; S1e2.2.19's fix left this core where it was.

(relation seed T :why "{?1} is a seed") (relation start T :why "start holds of {?1}") (relation p T :why "p holds of {?1}") (relation p2 T :why "p2 holds of {?1}") (relation r2 T :why "r2 holds of {?1}, which activates rule r2 for {?1}")

(seed a)
(start a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk0 () :match (start ?x) :assert (r2 ?x) :why "start holds of {?x}, so r2 holds of {?x}")
(rule r2 (?k) :match (p ?k) :assert (false) :why "rule r2 is activated for {?k} and p holds of it, which cannot be")
