;;; A boundary of `activator-chain-no-absent` (`corpus/regressions.toml`): the activator is one
;;; root derives from a fact the program states.
;;;
;;; `mk0` derives `(r2 a)` from the given `(start a)`, so root compiles the
;;; plan of `r2`, which concludes `(false)` from the commitment `(p a)`. R is
;;; two states, ∅ and {(p2 a)}; N is {(p a)}, and its core is `(p a)` (`ein
;;; solve FILE --dump-answer DIR` at `a41eb76e`, and today). The core does not
;;; also name what root derived the activator from, `(p a) (start a)`: root's
;;; activators, stated or derived, are the program's, and no core follows
;;; them (Q-M1e2.12). Under the readings *every activator* and *a derived
;;; one* it would.
;;;

(relation seed T :why "{?3} is a seed") (relation start T :why "start holds of {?3}") (relation p T :why "p holds of {?3}") (relation p2 T :why "p2 holds of {?3}") (relation r2 T :why "r2 holds of {?3}, which activates rule r2 for {?3}")

(seed a)
(start a)

(hrule g  () :match (seed ?x) :assert (p ?x) :why "guess that p holds of the seed {?x}")
(hrule g2 () :match (seed ?x) :assert (p2 ?x) :why "guess that p2 holds of the seed {?x}")

(rule mk0 () :match (start ?x) :assert (r2 ?x) :why "start holds of {?x}, so r2 holds of {?x}")
(rule r2 (?k) :match (p ?k) :assert (false) :why "rule r2 is activated for {?k} and p holds of it, which cannot be")
