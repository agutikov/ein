;;; A written `(not (false Bob))` is stored — regression
;;; `false-fact-negated`.
;;;
;;;
;;; ── What this program is ──────────────────────────────────────────────────
;;;
;;; Two guests, of whom Ann has paid, and a fact `(not (false Bob))`. No candidate.
;;;
;;; ── The answer, by hand ───────────────────────────────────────────────────
;;;
;;; `false` takes no argument, under a `(not …)` too: refused at the parse, on every
;;; command.
;;;
;;; ── What the engine answered ──────────────────────────────────────────────
;;;
;;; At `52e05fc1`, release: the program loads and stores `(not (false Bob))`;
;;; root is alive and the goal answers `?g = Ann`, exit 0 on every command. Now
;;; refused at load.

(relation paid Guest :why "{?1} has paid")
(is-a Ann Guest) (is-a Bob Guest)
(paid Ann)
(not (false Bob))
(solve :hypothesis-relations ())
(query :goal (paid ?g))
