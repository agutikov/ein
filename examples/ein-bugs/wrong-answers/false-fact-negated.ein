;;; A written `(not (false Bob))` is stored —
;;; M1f **W81**, register row `W81/false-fact-negated`, filed by S1f.7.6 (T1f.7.6.2,
;;; 2026-11-11).
;;;
;;; ── What this program is ──────────────────────────────────────────────────
;;;
;;; Two guests, of whom Ann has paid, and a fact `(not (false Bob))`. No candidate.
;;;
;;; ── The answer, by hand ───────────────────────────────────────────────────
;;;
;;; `false` takes no argument, under a `(not …)` too: refused at the parse, on every
;;; command.
;;;
;;; ── What the engine answered ──────────────────────────────────────────────
;;;
;;; At `52e05fc1`, release: the program loads and stores `(not (false Bob))`; root is alive
;;; and the goal answers `?g = Ann`, exit 0 on every command.
;;; Refused at load since S1f.7.6 (T1f.7.6.3).

(relation paid Guest :why "{?1} has paid")
(is-a Ann Guest) (is-a Bob Guest)
(paid Ann)
(not (false Bob))
(solve :hypothesis-relations ())
(query :goal (paid ?g))
