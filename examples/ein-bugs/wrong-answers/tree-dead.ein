;;; An owed instance whose alternatives each die in ONE firing — the control
;;; for `owed-two-step.ein` (**W1**, regression `owed-two-step`).
;;;
;;; `(total-owed likes is-a)`: Ann owes a Food, and each food is refuted
;;; outright. R is empty (`ein solve FILE`): both candidates are dead alone,
;;; and ∅ owes 1, *likes owes Ann a Food*, which no commitment pays.
;;;
;;; Its twin `owed-two-step.ein` moves each death one firing deeper, and its
;;; R is empty too.
;;;
;;;
;;;
;;;
;;;
;;;
(import std.algebra :symbols (total-owed))
(relation is-a  T T :why "{?1} is a {?2}")
(relation likes Person Food :why "{?1} likes {?2}")
(is-a Ann Person)
(is-a Soup Food)  (is-a Stew Food)
(total-owed likes is-a)
(rule no-soup () :match (likes Ann Soup) :assert (false) :why "Ann may not like Soup")
(rule no-stew () :match (likes Ann Stew) :assert (false) :why "Ann may not like Stew")
(solve :no-hypothesis (is-a))
(query :goal (likes ?who ?what))
