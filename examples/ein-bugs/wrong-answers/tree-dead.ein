;;; An owed instance whose alternatives each die in ONE firing — the control
;;; for `owed-two-step.ein` (M1e2 **W1**, register row `W1/owed-two-step`).
;;;
;;; `(total-owed likes is-a)`: Ann owes a Food, and each food is refuted
;;; outright. The answer by hand is **`Open — owes 1`** (the user's ruling of
;;; 2026-08-25, `tests/stdlib/closure/03_closed_and_owing.ein`), and the engine
;;; says exactly that: the lookahead kills both alternatives before layer 1,
;;; `alive` is empty, and root is recorded as an open state.
;;;
;;; The name is the probe's — it was written for `EIN_TRAVERSAL=tree`, whose
;;; dead branch it exercises; the lattice answers it the same way. Its twin
;;; `owed-two-step.ein` moves each death one firing deeper and the verdict
;;; becomes a certified `Contradiction`.
;;;
;;; Banked from M1e2's probes at S1e2.1.1.
(import std.algebra :symbols (total-owed))
(relation is-a  T T)
(relation likes Person Food)
(is-a Ann Person)
(is-a Soup Food)  (is-a Stew Food)
(total-owed likes is-a)
(rule no-soup () :match (likes Ann Soup) :assert (false) :priority 300)
(rule no-stew () :match (likes Ann Stew) :assert (false) :priority 300)
(query :goal (likes ?who ?what) :no-hypothesis (is-a))
