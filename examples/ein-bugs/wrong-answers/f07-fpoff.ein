;;; A twin of `examples/features/07_unstratifiable.ein`, a flagged program
;;; whose answer the engine claims nothing of.
;;;
;;; Below this header the program is `features/07`'s and nothing else: Ein has
;;; no flag that turns a forced-positive cascade off, and that file's header is
;;; the argument. It says `{p, q}` *"is not a model of this program under any
;;; reading"* — and the state the engine reaches holds both:
;;;
;;;   ∅             root, which derives `(p one)` under `(absent (q one))`.
;;;   {(q one)}     a fork of root: `(p one)`, derived under `(absent (q one))`,
;;;                 survives the commitment that falsifies its guard (the
;;;                 read-out's `stale` row), so the state is `{(p one), (q one)}`.
;;;
;;; Which answer is right is not decided, a node being a fork of root, an
;;; assumption on a flagged program (Q-M1e2.2): under *guards are premises* the
;;; commitment withdraws `(p one)` and the one model is `{(q one)}`; under
;;; *refuse what cannot be stratified* this program — `p ← ¬q, q ← ¬p` — is a
;;; load error; under *append-only* today's answer qualifies.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
(relation thing Thing :why "{?1} is a thing")
(relation p Thing :why "{?1} is p")
(relation q Thing :why "{?1} is q")

(rule derive-p ()
  :match  (and (thing ?x) (absent (q ?x)))
  :assert (p ?x)
  :why    "no q for {?x}, so p")

(rule derive-q ()
  :match  (and (thing ?x) (absent (p ?x)))
  :assert (q ?x)
  :why    "no p for {?x}, so q")

(thing one :source "the only object")
