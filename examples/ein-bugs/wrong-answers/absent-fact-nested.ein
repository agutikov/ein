;;; A value `(absent (paid Bob))` inside a fact is stored —
;;; M1f **W80**, register row `W80/absent-fact-nested`, filed by S1f.7.7 (T1f.7.7.2,
;;; 2026-11-11).
;;;
;;; ── What this program is ──────────────────────────────────────────────────
;;;
;;; Two guests and what Ann says, `(says Ann (absent (paid Bob)))`. No candidate.
;;;
;;; ── The answer, by hand ───────────────────────────────────────────────────
;;;
;;; A value is a name, or a fact a state could hold, and no state holds a fact of
;;; `absent`: refused at the parse, on every command. What Ann says is written
;;; `(says Ann (not (paid Bob)))`.
;;;
;;; ── What the engine answered ──────────────────────────────────────────────
;;;
;;; At `52e05fc1`, release: the program loads and stores `(says Ann (absent (paid Bob)))`,
;;; and the goal answers `?c = (absent (paid Bob))`, exit 0 on every command.
;;; Refused at load since S1f.7.7 (T1f.7.7.3).

(relation paid Guest :why "{?1} has paid")
(is-a Ann Guest) (is-a Bob Guest)
(relation says Guest Claim :why "{?1} says {?2}")
(says Ann (absent (paid Bob)))
(solve :hypothesis-relations ())
(query :goal (says ?g ?c))
