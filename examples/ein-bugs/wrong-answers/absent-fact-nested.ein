;;; A value `(absent (paid Bob))` inside a fact is stored —
;;; regression `absent-fact-nested`.
;;;
;;; ── What this program is ──────────────────────────────────────────────────
;;;
;;; Two guests and what Ann says, `(says Ann (absent (paid Bob)))`. No candidate.
;;;
;;; ── The answer, by hand ───────────────────────────────────────────────────
;;;
;;; Under an ordinary relation `absent` is an ordinary name (Q-M1f.571): the fact
;;; inside `says` is of a relation so called, which the kernel does not read, and
;;; tests no absence. The program loads and stores it, and the goal answers it.
;;;
;;; ── What the engine answered ──────────────────────────────────────────────
;;;
;;; At `52e05fc1`, release: the program loads and stores `(says Ann (absent (paid Bob)))`,
;;; and the goal answers `?c = (absent (paid Bob))`, exit 0 on every command.
;;; The engine loads it.
;;;

(relation paid Guest :why "{?3} has paid")
(is-a Ann Guest) (is-a Bob Guest)
(relation says Guest Claim :why "{?3} says {?4}")
(says Ann (absent (paid Bob)))
(solve :hypothesis-relations ())
(query :goal (says ?g ?c))
