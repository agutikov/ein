;;; The twin of `wild-in-match.ein`: the same program with the
;;; wildcard `_` written as `?any`, a variable the rule reads nowhere else.
;;; `w` fires on `(holds a)`, root holds `(hit w)`, and R is `{(hit w)}` and
;;; `{(hit a), (hit w)}` (`ein solve FILE`): the answer the witness's `_`
;;; was read as meaning, where the witness itself is refused at the parse
;;; (Q-M1e2.22).

(relation holds Node :why "{?1} holds") (relation hit Node :why "{?1} is hit")
(holds a)
(rule w () :match (holds ?any) :assert (hit w) :why "{?any} holds, so w is hit")
