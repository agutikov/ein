;;; The **control** for [`match-only.ein`](match-only.ein) — that file plus
;;; one fact, `(seen Z)` — M1e2 W15 (S1e2.2.14). Banked from S1e2.2.4's
;;; residue probe of 2026-11-04.
;;;
;;; `(seen Z)` is over a relation nothing else mentions and is closed. It
;;; changes no rule, no constraint and no goal: all it does is put `Z` in a
;;; fact at root, where the blind enumerator takes its objects. With it H is
;;; six `q` candidates over A, B and Z, and R is four states, the maximal
;;; `{(q A Z), (q B Z)}`, which the `:expect` below states. That is the right
;;; answer for `match-only.ein` too: its `reach-z` names `Z` in a `:match`,
;;; and a constant anywhere in a rule is a name of the program (Q-M1e2.9 (a),
;;; ruled 2026-11-04).

(relation p T T)
(relation q T T)
(relation good T)
(relation seen T)

(p A B)
(seen Z)   ; the one addition: Z named in a fact

(rule reach-z ()
  :match  (q ?a Z)
  :assert (good ?a)
  :why    "{?a} reaches Z")

(rule no-a ()
  :match  (q ?x A)
  :assert (false)
  :why    "nothing may reach A")

(rule no-b ()
  :match  (q ?x B)
  :assert (false)
  :why    "nothing may reach B")

(solve
  :no-hypothesis (p good seen)
  ;; `q` is named, so this closes `q`: exactly these positive `q` facts.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model)
            ;; state 2 of 4 — 1 candidate · from {(q A Z)}
            (model (q A Z))
            ;; state 3 of 4 — 1 candidate · from {(q B Z)}
            (model (q B Z))
            ;; state 4 of 4 — 2 candidates · maximal · from {(q A Z), (q B Z)}
            (model (q A Z) (q B Z))))

(query
  :goal   (good ?a))
