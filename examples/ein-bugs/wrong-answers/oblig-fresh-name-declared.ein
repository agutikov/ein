;;; The **control** for [`oblig-fresh-name.ein`](oblig-fresh-name.ein) — that
;;; file plus one fact, `(food Z)` — M1e2 W14 (S1e2.2.15). Banked from
;;; S1e2.2.4's residue probe of 2026-11-04.
;;;
;;; With `(food Z)` at root the obligations rung's `(food ?b)` scan finds Z,
;;; so H holds `(likes Ann Z)` beside `(likes Ann Soup)`, and R is one state,
;;; `{(likes Ann Z)}`, which the `:expect` below states. Every state holding a
;;; `likes` fact holds `(food Z)` in both files (`special`), so the two agree
;;; fact for fact on every state but root, which owes in both.

(relation person T)
(relation food   T)
(relation likes  T T)

(person Ann)
(food Soup)
(food Z)   ; the one addition: Z is a food at root

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food"
  :priority 500)

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (likes ?p ?f)
  :assert (food Z)
  :why    "once {?p} likes {?f}, Z is on the menu")

(solve
  :no-hypothesis (person food)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Z)}
            (model (likes Ann Z))))

(query
  :goal   (likes ?p ?f))
