;;; The **control** for [`oblig-fresh-name.ein`](oblig-fresh-name.ein) — that
;;; file plus one fact, `(food Z)` — M1e2 W14 (S1e2.2.15). Banked from
;;; S1e2.2.4's residue probe of 2026-11-04.
;;;
;;; Until S1e2.2.15 the obligations rung built H here, and with `(food Z)` at
;;; root its `(food ?b)` scan found Z: H was `(likes Ann Soup)` and `(likes Ann
;;; Z)`, and R one state, `{(likes Ann Z)}`. Since then the rung declines on a
;;; guard over a relation in D, and `food` is in D here too (`special` derives
;;; it from a commitment, whatever root holds), so the blind enumerator builds
;;; H, six candidates over Ann, Soup and Z, five dead alone; R is the same one
;;; state, which the `:expect` below states. Every state holding a `likes` fact
;;; holds `(food Z)` in both files (`special`), so the two agree fact for fact
;;; on every state but root, which owes in both.

(relation person T)
(relation food   T)
(relation likes  T T)

(person Ann)
(food Soup)
(food Z)   ; the one addition: Z is a food at root

(rule owes-food ()
  :match  (and (person ?a)
               (absent (and (food ?b) (likes ?a ?b))))
  :assert (open likes)
  :why    "{?a} owes a liked food")

(rule no-soup ()
  :match  (likes Ann Soup)
  :assert (false)
  :why    "Ann may not like Soup")

(rule liker-is-person ()
  :match  (and (likes ?p ?f) (absent (person ?p)))
  :assert (false)
  :why    "only a person likes")

(rule special ()
  :match  (likes ?p ?f)
  :assert (food Z)
  :why    "once {?p} likes {?f}, Z is on the menu")

(solve
  :no-hypothesis (person food)
  ;; `likes` is named, so this closes `likes`: exactly these positive facts.
  :expect (region
            ;; state 1 of 1 — 1 candidate · minimal and maximal · from {(likes Ann Z)}
            (model (likes Ann Z))))

(query
  :goal   (likes ?p ?f))
