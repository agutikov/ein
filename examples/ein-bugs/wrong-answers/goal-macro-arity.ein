;;; Refused at load since S1f.7.5 (T1f.7.5.3).

(relation paid Guest :why "{?1} has paid")
(macro settled (?g) (paid ?g) :why "{?g} has settled")
(is-a Ann Guest) (is-a Bob Guest)
(paid Ann)
(solve :hypothesis-relations ())
(query :goal (settled ?g Guest))
