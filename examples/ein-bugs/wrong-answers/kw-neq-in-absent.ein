;;; A name that starts with `neq`, under an `absent`: a reserved word is a
;;; keyword only as a whole token (Q-M1e2.17).
;;;
;;;
;;;
;;; ── What this program is ──────────────────────────────────────────────
;;;
;;; Two facts, `(p a)` and `(neqw b)`, and one rule, `r`, concluding `(hit
;;; ?x)` from `(p ?x)` where `(neqw ?x)` is absent.
;;;
;;; ── What is said of it ────────────────────────────────────────────────
;;;
;;; A keyword is a whole word: `01-grammar.md` § 1, fact 1, excludes a reserved
;;; word from `SYMBOL` only where a word boundary follows it (`neq` is not a
;;; `SYMBOL`; `neq_test` is), so `neqw` is a name like any other, and
;;; `(absent (neqw ?x))` is an `absent` over the relation `neqw`, not over a
;;; guard `(neq w ?x)`. No `(neqw a)` holds, so `r` fires and root holds
;;; `(hit a)`. The program answers as `kw-neq-in-absent-twin.ein` does, the
;;; name read back, which a test holds, a run against a run.
;;;
;;; The blind enumerator proposes `(neqw a)`, which the `absent` reads, so
;;; the program is not monotone: the static check flags it, and nothing is
;;; claimed of its answer (Q-M1f.564).
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation p Node :why "p holds of {?3}") (relation neqw Node :why "neqw holds of {?3}") (relation hit Node :why "{?3} is a hit")
(p a) (neqw b)
(rule r () :match (and (p ?x) (absent (neqw ?x))) :assert (hit ?x) :why "p holds of {?x} and neqw does not, so {?x} is a hit")
