;;; The control for an activator read as none — regressions
;;; `activator-all-int` and `activator-all-nested`
;;; (`corpus/regressions.toml`).
;;;
;;; `activator-all-int.ein` with `(item a)` for `(item 1)`, and nothing
;;; else. Every activator in the chain carries a symbol, so root's plan of
;;; `alarm`, compiled from `(alarm a)`, has an activator as *forbid* reads
;;; one, and its `(false)` rests through two activators on
;;; `(absent (checked ?x))`, over a relation a commitment can extend.
;;;
;;; Refused at load (*forbid*, followed through each activator, Q-M1e2.5):
;;; every question about a commitment exits 1 naming `alarm [activator a]`,
;;; in either build, and `ein saturate` still saturates. The two witnesses
;;; answer the same, each naming its own activator.
;;;

(relation item    T :why "{?1} is an item")
(relation checked T :why "{?1} is checked")
(relation watch   T :why "{?1} is under watch")
(relation alarm   T :why "an alarm is raised for {?1}")

(hrule check () :match (item ?x) :assert (checked ?x) :why "guess that {?x} is checked")

(rule flag () :match (and (item ?x) (absent (checked ?x))) :assert (watch ?x) :why "{?x} is an item not yet checked, so it is put under watch")
(rule watch (?n) :match (item ?n) :assert (alarm ?n) :why "{?n} is an item under watch, so an alarm is raised for {?n}")
(rule alarm (?k) :match (item ?k) :assert (false) :why "an alarm is raised for {?k}, and no alarm may be raised")

(item a)
