;;; The **control** for [`alive-set-fresh-name.ein`](alive-set-fresh-name.ein)
;;; — that file plus **one fact** — M1e S1e.3.3, `ST-M1`.
;;;
;;; The added fact is `(seen Z)`, over a relation nothing else mentions. It
;;; changes no rule, no constraint, no goal and no config; all it does is put
;;; `Z` in a fact at **root**, where the candidates are taken. That was enough
;;; for the blind enumerator to propose `(q A Z)` and `(q B Z)`, whose objects
;;; were the KB's names, and the answer went from the twin's
;;;
;;;   solutions (k)   0     exhausted = true     No solution
;;;
;;; to `Solution k = 1` over exactly that model, in seven enterings — under the
;;; region (M1e2 S1e2.1a.5), from R = {∅} to the four states below.
;;;
;;; One fact was the whole difference, which is what made this pair a
;;; measurement of `ST-M1` rather than an illustration of it: the twin's
;;; refutation was not a property of its constraints — its constraints are
;;; these, to the character.
;;;
;;; **Since M1e2 S1e2.2.4 the pair describes one R.** The user ruled on
;;; 2026-10-16 that a constant a rule names is a name of the program
;;; (Q-M1e.21 (b)), and the blind enumerator's objects are seeded with every
;;; constant a rule's `:assert` names, so the twin's candidates hold `Z`
;;; without a fact. `invariant::seeded` reports `spawn`'s `Z` on the twin and
;;; nothing here, because `(seen Z)` names it; `ein-infer/tests/alive_invariant.rs`
;;; holds the two to one region.
;;;
;;; Read the twin for the mechanism and for why neither file contains an
;;; `(absent …)`.

;; Its `(config :enable-pre-branch-lookahead false)` line went at M1e2 S1e2.1c.5 (2026-11-03),
;; when the user retired the flag: no route reads it, and a program that sets
;; it is refused at load.

(relation p T T)
(relation q T T)
(relation seen T)

(p A B)
(seen Z)

(rule spawn ()
  :match  (q ?a ?b)
  :assert (p ?b Z)
  :why    "committing to (q {?a} {?b}) names Z, which no fact does")

(rule no-a ()
  :match  (q ?x A)
  :assert (false)
  :why    "nothing may reach A")

(rule no-b ()
  :match  (q ?x B)
  :assert (false)
  :why    "nothing may reach B")

(solve
  :no-hypothesis (p seen)
  ;; The model its twin cannot reach. `q` is named, so this closes `q`:
  ;; exactly these two positive `q` facts, both built out of the name the
  ;; other file's rule invents.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model)
            ;; state 2 of 4 — 1 candidate · from {(q A Z)}
            (model (q A Z))
            ;; state 3 of 4 — 1 candidate · from {(q B Z)}
            (model (q B Z))
            ;; state 4 of 4 — 2 candidates · maximal · from {(q A Z), (q B Z)}
            (model (q A Z) (q B Z))))

(query
  :goal   (q ?x ?y))
