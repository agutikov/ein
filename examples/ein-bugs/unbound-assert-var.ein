;;; M1a S1a.6.6 — an unbound variable reaching an `:assert`.
;;;
;;; No corpus file reached this case until the fuzzer wrote one: a rule
;;; whose template reads a variable that the arm it matched through never
;;; bound. Two forms:
;;;
;;; The rule's `:match` is a disjunction whose arms bind **different**
;;; variables, and its `:assert` reads `?v0` and `?v1`. Matching the second
;;; arm binds `?v0` and `?v2`, so `?v1` arrives at the assert template
;;; unbound. The engine detects it and refuses the run, exit 1, with one
;;; stderr line naming the variable and the bindings it did have:
;;;
;;;     KeyError: "unbound var ?v1 in :assert — bindings: {'v0': 'o2', 'v2': 'o1'}"
;;;
;;; Fixed 2026-08-20 in ein.rs, which printed the message alone until then;
;;; `KeyError: "…"` is the same treatment `CompileError` and
;;; `FileNotFoundError` already had — the class, then the message.
;;;
;;; It is an *invariant violation* rather than a rejected input — the matcher
;;; is supposed to guarantee no unbound var reaches a template — which is why
;;; it is loud at run time rather than a load-time diagnostic, and why the
;;; corpus sweep's banked exit code is what pins it.

(r0 o2 o1)

(rule fire-3 ()
  :match  (or (r1 ?v1 ?v3) (r0 ?v0 ?v2))
  :assert (not (r1 ?v0 ?v1)))
