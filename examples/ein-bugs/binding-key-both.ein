;;; Two activators of one rule, an int and a nested fact in one position,
;;; lost a derivation — regression `binding-key-both/binding-key-layout`
;;; (`corpus/regressions.toml`), Q-M1e.16.
;;; `corpus/fuzz_findings/binding-key-layout.ein` is the same program, a
;;; frontend-fuzzer seed.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; Thirteen lines on a rule application's identity
;;; (`docs/ein/reasoning/static-ir/values-and-order.md` § A rule
;;; application's identity). `(note edge 1)` binds `?R` to `edge` and `?f`
;;; to `1`; `(note edge (src Y))` binds `?R` to `edge` and `?f` to `(src Y)`,
;;; a nested fact being a value like any other.
;;; `binding-key-swapped.ein` is this file with the two activator lines
;;; exchanged, and that pair is the test: the order two facts are written
;;; in may not change what is derived. `binding-key-int-only.ein` and
;;; `binding-key-nested-only.ein` keep one activator each.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `(holds 1)` admits the first plan's `(noted ?a 1)` for each edge source
;;; `?a`: `(noted 1 1)` and `(noted 2 1)`. No `(holds (src Y))` is a fact
;;; or a candidate, so the second plan derives nothing. Every state holds
;;; those two `noted` facts and no other, in either activator order.
;;;
;;; ── H, and why it is scoped ────────────────────────────────────────────
;;;
;;; A run of digits is a name (Q-M1e2.24), so `1`, `2` and `3`, the edges'
;;; ends, are candidate objects beside `Y`, a name of the program though it is
;;; written only inside `(src Y)` (Q-M1e2.9). Unscoped, H is 23 candidates
;;; (`ein show hyps` on a copy without the `:no-hypothesis` line), and R
;;; passes the budget. The solve below holds `edge` and `noted` out of the
;;; hypotheses, so H is `(holds 2)` and `(holds Y)` and R is four states, each
;;; with root's two `noted` facts; `ein oracle` gives the same R.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; At `9c3c3fbc` a rule application's identity, `(rule, activator,
;;; values)`, interned only an activator's symbol arguments, and a nested
;;; fact bound no parameter, so both plans had the activator `[edge]` and
;;; their register files, `(?R ?f ?a ?b)` and `(?R ?a ?b ?f)`, were
;;; compared position by position. The nested plan's match `?a = 1, ?b = 2,
;;; ?f = 3` and the int plan's `?f = 1, ?a = 2, ?b = 3` are the same
;;; vector, `(edge 1 2 3)`, so the second was dropped as a repeat of the
;;; first and `(noted 1 3)` was derived in no state (`ein solve FILE
;;; --dump-answer DIR`). A build with debug assertions aborted instead, in
;;; `check_layout`. The identity keys on every argument of the activator,
;;; as the compile cache's key does (Q-M1e.16, Q-M1f.43), so each plan has a
;;; space of its own; and the two plans bind `?f` in their seeds, so their
;;; register layouts are one. The `:expect` below holds in either build.
;;;
;;; ── What `ein solve` reports ───────────────────────────────────────────
;;;
;;; R, four states, every commitment of the two candidates: ∅ (root, which
;;; owes nothing), `{(holds 2)}`, `{(holds Y)}` and both, the last the
;;; maximal line. `ein test FILE` holds the `:expect` on that run, and
;;; `ein oracle FILE`, which saturates all four nodes, lists the same four.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation edge  Node Node :why "there is an edge from {?1} to {?2}")
(relation holds Node :why "{?1} holds")
(relation noted Node Node :why "{?1} is noted with {?2}")

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f) :why "{?R} runs from {?a} to some node and {?f} holds, so {?a} is noted with {?f}")

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge 1)
(note edge (src Y))

(solve
  ;; A run of digits is a name, so `1`, `2` and `3` are candidate objects,
  ;; and unscoped H is 23 candidates whose R passes the budget; `edge` and
  ;;
  ;; `noted` held out, H is `(holds 2)` and `(holds Y)`, the oracle the same.
  :no-hypothesis (edge noted)
  ;; `holds` and `noted` are named, so both are closed: each state lists
  ;; their complete extent, root's facts included.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model (holds 1) (holds 3) (noted 1 1) (noted 2 1))
            ;; state 2 of 4 — 1 candidate · from {(holds 2)}
            (model (holds 1) (holds 2) (holds 3) (noted 1 1) (noted 2 1))
            ;; state 3 of 4 — 1 candidate · from {(holds Y)}
            (model (holds 1) (holds 3) (holds Y) (noted 1 1) (noted 2 1))
            ;; state 4 of 4 — 2 candidates · maximal · from {(holds 2), (holds Y)}
            (model (holds 1) (holds 2) (holds 3) (holds Y) (noted 1 1) (noted 2 1))))
