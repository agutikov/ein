;;; **The goal row a solve printed moved under a permuted interner.**
;;;
;;; A find of the engine fuzzer's `id-order` property, from two seeds; the
;;; note is `corpus/fuzz_findings/d3-goal-row-order.md`. One model satisfies
;;; the goal `(cand ?x)` twice, with `?x = A` and `?x = B`, and the walk's
;;; solve table printed one row: `rows[0]` of an unsorted match, which moved
;;; when the interner assigned ids in another order (an order-sensitive site
;;; `docs/ein/ein.rs/03-design/01-determinism-and-order.md` forbids).
;;;
;;; The region read-out sorts a class's rows and prints them all, so state
;;; 5's class lists `?x = A` and then `?x = B` under any id order. The file
;;; is a corpus program so that `ein-render/tests/id_order_invariance.rs`,
;;; which permutes the id space of corpus programs, checks it; a file under
;;; `corpus/fuzz_findings/` is not one, and
;;; `corpus/fuzz_findings/d3-goal-row-order.ein` stays there as a
;;; frontend-fuzzer seed.
;;;

(relation ok      T :why "{?1} is ok")
(relation blessed T :why "{?1} is blessed")
(relation cand    T :why "{?1} is a candidate")
(rule promote ()
  :match  (and (ok ?x) (blessed ?x))
  :assert (cand ?x) :why "{?x} is ok and blessed, so {?x} is a candidate")
(ok      B)
(blessed A)
(query
  :goal (cand ?x))
