;;; `binding-key-both.ein` with its two activator lines exchanged, and
;;; nothing else — its twin, regression `binding-key-both/binding-key-layout`
;;; (`corpus/regressions.toml`), Q-M1e.16.
;;; `corpus/fuzz_findings/binding-key-layout-swapped.ein` is the same
;;; program, a frontend-fuzzer seed.
;;;
;;; The answer is `binding-key-both.ein`'s, by the same hand derivation: the
;;; order two facts are written in may not change what is derived. Every
;;; state holds `(noted 1 1)` and `(noted 2 1)` and no other `noted` fact:
;;; `(note edge 1)` binds `?f` to `1`, and `(note edge (src Y))` binds it to
;;; `(src Y)`, which no `holds` fact or candidate is.
;;;
;;; At `9c3c3fbc` this order answered right in a release build, because the
;;; nested-fact plan, compiled first and binding no `?f`, derived every
;;; `noted` fact by itself, so the int plan's applications it suppressed
;;; were duplicates; the other order lost `(noted 1 3)`. A build with debug
;;; assertions aborted on both, in `check_layout`. Each plan has a
;;; binding-key space of its own (Q-M1e.16) and the two files answer alike;
;;; the `:expect` below is `binding-key-both.ein`'s, word for word.
;;;
;;; ── H, and why it is scoped ────────────────────────────────────────────
;;;
;;; A run of digits is a name (Q-M1e2.24), so `1`, `2` and `3`, the edges'
;;; ends, are candidate objects beside `Y`, a name of the program though it is
;;; written only inside `(src Y)` (Q-M1e2.9). Unscoped, H is 23 candidates
;;; (`ein show hyps` on a copy without the `:no-hypothesis` line), and R
;;; passes the budget. The solve below holds `edge` and `noted` out of the
;;; hypotheses, so H is `(holds 2)` and `(holds Y)` and R is four states, each
;;; with root's two `noted` facts; `ein oracle` gives the same R.
;;;
;;; ── What `ein solve` reports ───────────────────────────────────────────
;;;
;;; R, four states, every commitment of the two candidates: ∅ (root, which
;;; owes nothing), `{(holds 2)}`, `{(holds Y)}` and both, the last the
;;; maximal line. `ein test FILE` holds the `:expect` on that run, and
;;; `ein oracle FILE`, which saturates all four nodes, lists the same four.
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation edge  Node Node :why "there is an edge from {?3} to {?4}")
(relation holds Node :why "{?3} holds")
(relation noted Node Node :why "{?3} is noted with {?4}")

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f) :why "{?R} runs from {?a} to some node and {?f} holds, so {?a} is noted with {?f}")

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))
(note edge 1)

(solve
  ;; A run of digits is a name, so `1`, `2` and `3` are candidate objects,
  ;; and unscoped H is 23 candidates whose R passes the budget; `edge` and
  ;;
  ;; `noted` held out, H is `(holds 2)` and `(holds Y)`, the oracle the same.
  :no-hypothesis (edge noted)
  ;; `holds` and `noted` are named, so both are closed: each state lists
  ;; their complete extent, root's facts included.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model (holds 1) (holds 3) (noted 1 1) (noted 2 1))
            ;; state 2 of 4 — 1 candidate · from {(holds 2)}
            (model (holds 1) (holds 2) (holds 3) (noted 1 1) (noted 2 1))
            ;; state 3 of 4 — 1 candidate · from {(holds Y)}
            (model (holds 1) (holds 3) (holds Y) (noted 1 1) (noted 2 1))
            ;; state 4 of 4 — 2 candidates · maximal · from {(holds 2), (holds Y)}
            (model (holds 1) (holds 2) (holds 3) (holds Y) (noted 1 1) (noted 2 1))))
