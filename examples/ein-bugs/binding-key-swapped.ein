;;; `binding-key-both.ein` with its two activator lines exchanged, and
;;; nothing else — M1e2 **W7**'s twin, register row `W7/binding-key-layout`
;;; (`corpus/wrong_answers.toml`), Q-M1e.16; fixed by S1e2.2.7 (2026-11-04).
;;; Promoted from `corpus/fuzz_findings/binding-key-layout-swapped.ein`,
;;; which stays there as a frontend-fuzzer seed.
;;;
;;; The answer is `binding-key-both.ein`'s, by the same hand derivation: the
;;; order two facts are written in may not change what is derived. R is two
;;; states, ∅ with `(noted 1 1)`, `(noted 1 3)`, `(noted 2 1)` and `(noted 2
;;; 3)`, and `{(holds Y)}`, which adds `(noted 1 Y)` and `(noted 2 Y)`.
;;;
;;; Until S1e2.2.7 this order answered right in a release build, because the
;;; nested-fact plan, compiled first, derives every `noted` fact by itself,
;;; so the int plan's applications it suppressed were duplicates; the other
;;; order lost `(noted 1 3)`. A build with debug
;;; assertions aborted on both, in `check_layout`. Since S1e2.2.7 each plan
;;; has a binding-key space of its own and the two files answer alike; the
;;; `:expect` below is `binding-key-both.ein`'s, word for word.

(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))
(note edge 1)

(solve
  ;; `holds` and `noted` are named, so both are closed: each state lists
  ;; their complete extent, root's facts included.
  :expect (region
            ;; state 1 of 2 — ∅, root itself · minimal
            (model (holds 1) (holds 3)
                   (noted 1 1) (noted 1 3) (noted 2 1) (noted 2 3))
            ;; state 2 of 2 — 1 candidate · maximal · from {(holds Y)}
            (model (holds 1) (holds 3) (holds Y)
                   (noted 1 1) (noted 1 3) (noted 1 Y)
                   (noted 2 1) (noted 2 3) (noted 2 Y))))
