;;; A search that wrote into the fork it was asked about recorded a state its
;;; own rules refute — register row W9/complete-records-stale-K.
;;;
;; That search's completeness check ran its full filter pipeline on the fork,
;; and its lookahead kill cache wrote `(not h)` into the very KB it then
;; recorded: it recorded `S ∪ K`, where K is what the cache wrote, and had
;; checked the criteria against `S`. Here a rule reads K:
;;
;;   cache on  : k=2, model 1 = {(q A), (not (p A)), (not (p B))} —
;;               re-saturates to Contradiction. `k` was 2 either way, so
;;               nothing in the read-out signalled it
;;   cache off : k=2, models {(q A)} and {(p A),(p B)} — both correct
;;   re-saturated before recording : k=1, {(p A), (p B), (not (q A))} — the
;;               refutable one not recorded, and `{(q A)}` lost with it
;;
;; ── The answer ────────────────────────────────────────────────────────────
;;
;; A node is `sat(root ∪ C)` with nothing a search wrote (Q-M1e2.7), so the
;; cache's negatives are no state's, and the cache-off row is the right one:
;; R has 5 states, maximal `{(q A)}` and `{(p A), (p B)}`, which the
;; `:expect` below states and `ein solve --maximal` lists.
;;
;; ── The `:expect` ─────────────────────────────────────────────────────────
;;
;; The two maximal states populate **different** relations — `{(q A)}` and
;; `{(p A), (p B)}` — so whichever relation is the goal, one of them holds no
;; row of it; a claim states that state as the class `(model)` (Q-M1e.13).
;; The `:expect` is a region claim, every state listed, so it holds of R
;; whatever the query's goal; a search that recorded the refutable state
;; would fail it.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(relation is-a T T :why "{?1} is a {?2}")
(relation marker :why "the marker is present")
(relation p T :why "p holds of {?1}")
(relation q T :why "q holds of {?1}")

(marker)
(is-a A T) (is-a B T)

(hrule guess-q () :match (marker)    :assert (q A) :why "guess that q holds of A")
(hrule guess-p () :match (is-a ?x T) :assert (p ?x) :why "guess that p holds of {?x}")

;; One step from any (p ?x) once (q A) holds, so inside the fork that committed
;; to (q A) every p candidate dies, and a kill cache would store both negatives.
(rule kill-p ()
  :match  (and (q A) (p ?x))
  :assert (false) :why "q holds of A and p of {?x}, which cannot both be")

;; Reads stored negatives only — no `absent`, so no NAF boundary is in the
;; argument. Nothing stores them, so it never fires.
(rule totality ()
  :match  (and (not (p A)) (not (p B)))
  :assert (false) :why "p is false of both A and B, yet something must have p")

(solve :expect (region
                 ;; state 1 of 5 — ∅, root itself · minimal
                 (model)
                 ;; state 2 of 5 — 1 candidate · from {(p A)}
                 (model (p A))
                 ;; state 3 of 5 — 1 candidate · from {(p B)}
                 (model (p B))
                 ;; state 4 of 5 — 1 candidate · maximal · from {(q A)}
                 (model (q A))
                 ;; state 5 of 5 — 2 candidates · maximal · from {(p A), (p B)}
                 (model (p A) (p B))))

(query
  :goal   (p ?x))
