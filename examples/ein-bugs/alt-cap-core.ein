;;; **The `MAX_ALT_JUSTIFICATIONS = 32` cap can enlarge the reported unsat core
;;; — and hand it back the order-dependence the AND/OR search removed.**
;;;
;;; M1e S1e.1.3, answering the review's Q2. This file and
;;; [`alt-cap-core-reordered.ein`](alt-cap-core-reordered.ein) differ in **one
;;; integer** — the `:priority` of `wide`. Same facts, same rules, same
;;; derivations, same verdict:
;;;
;;;   alt-cap-core.ein             unsat core (3)   (p1 Y01) (p2 Y01) (p3 Y01)
;;;   alt-cap-core-reordered.ein   unsat core (2)   (w1 X) (w2 X)
;;;
;;; ── The shape ──────────────────────────────────────────────────────────────
;;;
;;; `(false)` is derivable 33 ways through `narrow` — one premise each, and
;;; that premise `(q Y..)` is itself three givens deep — and **once** through
;;; `wide`, two premises straight from givens. The smallest frontier over the
;;; derivations is therefore `{(w1 X), (w2 X)}`, size 2.
;;;
;;; `Kb::record_justification` keeps at most 32 *alternatives* per fact, sorted
;;; by **premise count**, and refuses an arrival no shorter than the longest
;;; kept. Fire `narrow` first and the list fills with 32 one-premise entries;
;;; `wide` then arrives with two, `2 >= 1`, and is **refused outright**. The
;;; store never holds the derivation with the smaller frontier, so
;;; `explain.rs` cannot choose it — and reports the three-fact chain instead.
;;;
;;; Retention is by premise count, which is **local**. The search minimises
;;; frontier size, which is **transitive**. A one-premise step whose premise
;;; unfolds into a deep chain wins the first metric and loses the second, and
;;; that gap is the whole of it.
;;;
;;; ── Why the order-dependence is the sharper half ───────────────────────────
;;;
;;; `explain.rs`'s module note says the ATMS search exists *because* walking one
;;; justification per fact made the core depend on `:priority` — "flipping two
;;; rules' `:priority` flipped the reported core between `{C, Y}` and
;;; `{A, B, Y}` while `{C, Y}` still existed". The cap re-introduces exactly
;;; that, one level up: the search is order-independent over what the store
;;; **kept**, and what the store keeps depends on the order the rules fired.
;;; `glossary.md`'s "Independent of the order in which the rules fired" is the
;;; sentence this pair qualifies.
;;;
;;; ── Recorded, not repaired ─────────────────────────────────────────────────
;;;
;;; The fix is engine work with its own owner —
;;; [Q-M1e.15](../../plans/m1e_review_processing/open_questions.md).
;;; Corpus-wide the cap is reached by **one** entry —
;;; [`zebra2-bad.ein`](zebra2-bad.ein), where 1 017 of 2 425 alternatives are
;;; refused and the hottest fact would hold **1 049** without the cap — and it
;;; costs that entry nothing: its core is one fact at either cap, and only an
;;; entry that *reaches* the cap can be changed by it. This file is the shape
;;; that makes the promise's limit visible, not a report that a shipped puzzle
;;; is wrong.

(relation p1 T :why "{?1} has p1")
(relation p2 T :why "{?1} has p2")
(relation p3 T :why "{?1} has p3")
(relation q  T :why "{?1} is a witness")
(relation w1 T :why "{?1} has w1")
(relation w2 T :why "{?1} has w2")

;; 33 witnesses, each three givens deep.
(p1 Y01) (p2 Y01) (p3 Y01) (p1 Y02) (p2 Y02) (p3 Y02) (p1 Y03) (p2 Y03) (p3 Y03)
(p1 Y04) (p2 Y04) (p3 Y04) (p1 Y05) (p2 Y05) (p3 Y05) (p1 Y06) (p2 Y06) (p3 Y06)
(p1 Y07) (p2 Y07) (p3 Y07) (p1 Y08) (p2 Y08) (p3 Y08) (p1 Y09) (p2 Y09) (p3 Y09)
(p1 Y10) (p2 Y10) (p3 Y10) (p1 Y11) (p2 Y11) (p3 Y11) (p1 Y12) (p2 Y12) (p3 Y12)
(p1 Y13) (p2 Y13) (p3 Y13) (p1 Y14) (p2 Y14) (p3 Y14) (p1 Y15) (p2 Y15) (p3 Y15)
(p1 Y16) (p2 Y16) (p3 Y16) (p1 Y17) (p2 Y17) (p3 Y17) (p1 Y18) (p2 Y18) (p3 Y18)
(p1 Y19) (p2 Y19) (p3 Y19) (p1 Y20) (p2 Y20) (p3 Y20) (p1 Y21) (p2 Y21) (p3 Y21)
(p1 Y22) (p2 Y22) (p3 Y22) (p1 Y23) (p2 Y23) (p3 Y23) (p1 Y24) (p2 Y24) (p3 Y24)
(p1 Y25) (p2 Y25) (p3 Y25) (p1 Y26) (p2 Y26) (p3 Y26) (p1 Y27) (p2 Y27) (p3 Y27)
(p1 Y28) (p2 Y28) (p3 Y28) (p1 Y29) (p2 Y29) (p3 Y29) (p1 Y30) (p2 Y30) (p3 Y30)
(p1 Y31) (p2 Y31) (p3 Y31) (p1 Y32) (p2 Y32) (p3 Y32) (p1 Y33) (p2 Y33) (p3 Y33)

;; …and one two-given pair, which is the smaller explanation.
(w1 X) (w2 X)

(rule mk-q ()
  :match  (and (p1 ?y) (p2 ?y) (p3 ?y))
  :assert (q ?y)
  :priority 100
  :why    "{?y} has all three")

;; One premise, and that premise is three givens deep. Fires 33 times, which
;; is one primary plus a full list of 32 alternatives.
(rule narrow ()
  :match  (q ?y)
  :assert (false)
  :priority 200
  :why    "{?y} is a witness")

;; Two premises, both givens: the smallest frontier there is.
(rule wide ()
  :match  (and (w1 ?x) (w2 ?x))
  :assert (false)
  :priority 300
  :why    "{?x} has both")

(query :goal (q ?y) :expect (false))
