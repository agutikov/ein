;;; The *other* arm of `query-goal-free-head.ein`.
;;;
;;; Same broken goal, `(?R …)` with a head variable that nothing can bind —
;;; but the puzzle is **contradictory**, so its answer, root dead and R
;;; empty, never needs the goal. A goal checked only on the path that renders
;;; a model let this file exit 0 where its sibling exited 1. The loader holds
;;; a query's `:goal` to what a rule's `:match` is held to (Q-M1f.72),
;;; whatever the answer, so this file is refused at load as its sibling is,
;;; one `kb load error` line naming `(?R a b)`, exit 1: the refusal does not
;;; wait on the verdict, which is what this file pins.
;;;
;;;
;;;

(is-a a T)

(rule boom ()
  :match  (is-a ?x T)
  :assert (false) :why "{?x} is a T, which nothing may be")

(query
  :goal (?R a b))
