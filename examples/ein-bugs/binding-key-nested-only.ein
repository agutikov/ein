;;; W7's family, the nested-fact activator alone — M1e2 S1e2.2.7, register
;;; row `W7/binding-key-layout` (`corpus/wrong_answers.toml`), Q-M1e.16.
;;;
;;; `defined_behaviour.md` § 3.2's program with `(note edge 1)` deleted. One
;;; activator compiles one plan, so the binding key has no second register
;;; layout to compare against, and this file answers the same in either
;;; build and under either key: it is a control, as
;;; `binding-key-int-only.ein` is for the other activator, and it is the one
;;; whose `noted` facts the pair must reach. `binding-key-both.ein` and
;;; `binding-key-swapped.ein` keep both activators, in the two orders, and
;;; that pair is the test. It is `corpus/fuzz_findings/binding-key-layout.ein`
;;; and its `-swapped` twin, promoted here by the commit that fixes W7, the
;;; one after this file was banked: a build with debug assertions aborted on
;;; both until then, and every in-process corpus sweep is such a build.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; A nested fact binds no parameter, so `(note edge (src Y))` binds `?R` to
;;; `edge` and leaves `?f` to `(holds ?f)`: the rule derives `(noted ?a ?f)`
;;; for every edge source `?a` (1, 2) and every `?f` that holds. At root that
;;; is `(noted 1 1)`, `(noted 1 3)`, `(noted 2 1)` and `(noted 2 3)`. `Y`,
;;; written only inside `(src Y)`, is a name of the program (Q-M1e2.9 (a),
;;; ruled 2026-11-04), so H is the one candidate `(holds Y)`, and R is two
;;; states: ∅, and `{(holds Y)}`, which adds `(noted 1 Y)` and `(noted 2 Y)`.
;;; The `:expect` below states both.

(relation edge  Node Node)
(relation holds Node)
(relation noted Node Node)

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f))

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))

(solve
  ;; `holds` and `noted` are named, so both are closed: each state lists
  ;; their complete extent, root's facts included.
  :expect (region
            ;; state 1 of 2 — ∅, root itself · minimal
            (model (holds 1) (holds 3)
                   (noted 1 1) (noted 1 3) (noted 2 1) (noted 2 3))
            ;; state 2 of 2 — 1 candidate · maximal · from {(holds Y)}
            (model (holds 1) (holds 3) (holds Y)
                   (noted 1 1) (noted 1 3) (noted 1 Y)
                   (noted 2 1) (noted 2 3) (noted 2 Y))))
