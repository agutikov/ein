;;; W7's family, the nested-fact activator alone — regression
;;; `binding-key-both/binding-key-layout` (`corpus/regressions.toml`), Q-M1e.16.
;;;
;;; `binding-key-both.ein`'s program with `(note edge 1)` deleted. One
;;; activator compiles one plan, so the binding key has no second register
;;; layout to compare against, and this file answers the same in either
;;; build and under either key: it is a control, as
;;; `binding-key-int-only.ein` is for the other activator.
;;; `binding-key-both.ein` and `binding-key-swapped.ein` keep both
;;; activators, in the two orders, and that pair is the test, as
;;; `corpus/fuzz_findings/binding-key-layout.ein` and its `-swapped` twin
;;; are the fuzzer's.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; An activator binds a parameter to a nested fact as to a name (W33,
;;; regression `activator-nested-value`): `(note edge (src Y))` binds
;;; `?R` to `edge` and `?f` to `(src Y)`, and no `(holds (src Y))` is a fact
;;; or a candidate, so the rule derives nothing and no state holds a `noted`
;;; fact, which the query at the end states.
;;;
;;; ── H, and why it is scoped ────────────────────────────────────────────
;;;
;;; A run of digits is a name (Q-M1e2.24), so `1`, `2` and `3`, the edges'
;;; ends, are candidate objects beside `Y`, a name of the program though it is
;;; written only inside `(src Y)` (Q-M1e2.9). Unscoped, H is 24 candidates
;;; (`ein show hyps` on a copy without the `:no-hypothesis` line), and R
;;; passes the budget. The solve below holds `edge` and `noted` out of the
;;; hypotheses, so H is `(holds 2)` and `(holds Y)` and R is four states, none
;;; with a `noted` fact; `ein oracle` gives the same R.
;;;
;;; ── What the engine answered ───────────────────────────────────────────
;;;
;;; Where a nested fact bound no parameter, `?f` was left to `(holds ?f)`,
;;; and the rule derived `(noted ?a ?f)` for every edge source and every `?f`
;;; that holds: `(noted 1 1)`, `(noted 1 3)`, `(noted 2 1)` and `(noted 2 3)`
;;; at root, W33's wrong answer.
;;;
;;; ── What `ein solve` reports ───────────────────────────────────────────
;;;
;;; R, four states, every commitment of the two candidates: ∅ (root, which
;;; owes nothing), `{(holds 2)}`, `{(holds Y)}` and both, the last the
;;; maximal line. `ein test FILE` holds the `:expect` and the query's on
;;; that run, and
;;; `ein oracle FILE`, which saturates all four nodes, lists the same four.
;;;
;;;
;;;

(relation edge  Node Node :why "there is an edge from {?1} to {?2}")
(relation holds Node :why "{?1} holds")
(relation noted Node Node :why "{?1} is noted with {?2}")

(rule note (?R ?f)
  :match  (and (?R ?a ?b) (holds ?f))
  :assert (noted ?a ?f) :why "{?R} runs from {?a} to some node and {?f} holds, so {?a} is noted with {?f}")

(edge 1 2) (edge 2 3)
(holds 1)  (holds 3)

(note edge (src Y))

(solve
  ;; A run of digits is a name, so `1`, `2` and `3` are candidate objects,
  ;; and unscoped H is 24 candidates whose R passes the budget; `edge` and
  ;;
  ;; `noted` held out, H is `(holds 2)` and `(holds Y)`, the oracle the same.
  :no-hypothesis (edge noted)
  ;; `holds` is named, so it is closed: each state lists its complete
  ;; extent, root's facts included. No state holds a `noted` fact, which a
  ;; model cannot say (a relation no model names is not closed), so the
  ;; query below says it.
  :expect (region
            ;; state 1 of 4 — ∅, root itself · minimal
            (model (holds 1) (holds 3))
            ;; state 2 of 4 — 1 candidate · from {(holds 2)}
            (model (holds 1) (holds 2) (holds 3))
            ;; state 3 of 4 — 1 candidate · from {(holds Y)}
            (model (holds 1) (holds 3) (holds Y))
            ;; state 4 of 4 — 2 candidates · maximal · from {(holds 2), (holds Y)}
            (model (holds 1) (holds 2) (holds 3) (holds Y))))

;; Its goal closes `noted`: one class over all of R, with no row, where an
;; unbound `?f` would derive four at root.
(query :goal (noted ?a ?f) :expect (model))
