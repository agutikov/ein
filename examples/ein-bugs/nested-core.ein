;;; **An unsat core that holds a nested fact.**
;;;
;;; The unsat core contains a given negative fact, `(not (p A))`, whose
;;; argument is a fact. A read-out that printed it as a struct repr,
;;; `(not Fact(relation_name='p', args=('A',)))`, is the wrong spelling this
;;; file witnesses; the region read-out prints a core as s-expressions:
;;;
;;;   unsat core        (not (p A))
;;;   unsat core        (q A)
;;;   refuted by        boom
;;;
;;; It is the only program known to print a nested fact in a core, so it pins
;;; the spelling: `ein-cli/tests/read_out.rs` asserts the line, and
;;; `corpus_shapes.md5`'s read-out digests hold the block.
;;;
;;;

;; A fact beside its stored negation is a contradiction by this module's rules (Q-M1f.557).
(import std.contradiction)

(relation p T :why "p holds of {?3}")
(relation q T :why "q holds of {?3}")
(not (p A))
(q A)
(rule boom () :match (and (not (p ?x)) (q ?x)) :assert (false) :why "p is false of {?x} and q holds of {?x}, which cannot both be")
