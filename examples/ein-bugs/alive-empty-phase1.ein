;;; The alive-∅ record site at PHASE 1 — a state a search that wrote negatives
;;; into root called a model and its own rules refute. Regressions
;;; alive-empty-phase1-K and alive-empty-phase1.
;;
;; `phase1` checked `has_contradiction(root)` at solve.rs:1091, then called
;; `compute_alive` — which writes the lookahead kill cache INTO ROOT
;; (hypgen.rs `write_negated`) — and then recorded root under the comment
;; "Empty alive and no contradiction ⇒ root is itself a complete, consistent
;; model". **The check ran before the write.**
;;
;; Zero enterings, zero layers, one saturation, and the state it recorded as
;; the model was one in which `totality` matched and had not fired: feed that
;; model back in as a program and that engine answered `Contradiction`. Once
;; it re-saturated before recording, it answered `Contradiction` on this
;; file, and with its kill cache off it answered a solution, root keeping no
;; negatives for `totality` to read.
;;
;; ── R is {∅} ──────────────────────────────────────────────────────────────
;;
;; That `Contradiction` read the kill cache's negatives as root's. A node is
;; `sat(root ∪ C)` with nothing a search wrote (Q-M1e2.7): root stores no
;; `(not (p A))`, `totality` never fires, root is alive and discharged, and
;; R is {∅}, which the `:expect` below states. So the `unsat core (0 facts)`
;; that engine printed belonged to no answer of this program. `ein solve`
;; lists the one state, root itself, minimal and maximal.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;; ── The `:expect` ──────────────────────────────────────────────────────────
;;
;; The `:expect` states R: one state, root itself, which holds no `p` fact.
;; The query's goal is on `p`, the question the file is about, and has an
;; empty extent there; an answer with an empty goal extent is a claim like
;; any other (Q-M1e.13).
;;

(relation is-a T T :why "{?1} is a {?2}")
(relation p T :why "p holds of {?1}")

(is-a A T) (is-a B T)

;; One candidate per object — reads only `is-a`, so no negative of `p` is
;; a fact this generator conditions on.
(hrule guess () :match (is-a ?x T) :assert (p ?x) :why "guess that p holds of {?x}")

;; One step from any (p ?x), so a one-step lookahead kills every candidate;
;; a kill cache would write (not (p A)) / (not (p B)) into root.
(rule no-p () :match (p ?x) :assert (false) :why "p holds of {?x}, and p may hold of nothing")

;; Totality, on stored negatives alone — no `absent`, so no NAF boundary is in
;; the argument. Nothing stores `(not (p A))` or `(not (p B))`: each
;; candidate's node dies, and root is not told so, so it never fires.
(rule totality ()
  :match  (and (not (p A)) (not (p B)))
  :assert (false) :why "p is false of both A and B, yet something must have p")

(solve :expect (region
                 ;; state 1 of 1 — ∅, root itself · minimal and maximal
                 (model)))

(query
  :goal   (p ?x))
