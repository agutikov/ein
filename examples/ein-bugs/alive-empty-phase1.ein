;;; The alive-∅ record site at PHASE 1 — a state the engine calls a model and
;;; its own rules refute. Recorded, not repaired (M1e D1, banked 2026-08-28).
;;
;; `phase1` checks `has_contradiction(root)` at solve.rs:1091, then calls
;; `compute_alive` at :1098 — which writes the lookahead kill cache INTO ROOT
;; (hypgen.rs `write_negated`) — and then records root at :1118 under the
;; comment "Empty alive and no contradiction ⇒ root is itself a complete,
;; consistent model". The check ran before the write.
;;
;; Zero enterings, zero layers, one saturation. The state recorded as the
;; model is one in which `totality` matches and has not fired — feed the model
;; back in as a program and this engine answers `Contradiction`.
;;
;; `-K` is the discriminator: with the kill cache off, root keeps no negatives,
;; `totality` has nothing to read, and the recorded state is a solution. So a
;; performance lever decides whether the recorded model is refutable, and
;; nothing in the read-out says so.
;;
;; ── Why the goal is `is-a` and not `p` ────────────────────────────────────
;;
;; Because `:expect` cannot say what this file's answer is. The model contains
;; **no `p` fact at all**, and an expectation must name the goal's relations —
;; `:expect does not name p, which the query's :goal asks about` — so a claim
;; about a model with an empty goal extent does not load. The goal is moved to
;; a relation the model does populate so the file can state today's answer at
;; all, and the limitation is filed as Q-M1e.13.
;;
;; The claim below therefore holds **today** and is expected to break: when the
;; record sites re-saturate before recording (Q-M1e.7's ruling selects that
;; fix), this file answers `Contradiction` and the claim fails. That is the
;; point of banking it — the same route `tests/stdlib/closure/02|03` took.

(relation is-a T T)
(relation p T)

(is-a A T) (is-a B T)

;; One candidate per object — reads only `is-a`, so the kill cache it triggers
;; is not a fact this generator conditions on.
(hrule guess () :match (is-a ?x T) :assert (p ?x))

;; One step from any (p ?x), so the pre-branch lookahead kills every candidate
;; and the cache writes (not (p A)) / (not (p B)) into root.
(rule no-p () :match (p ?x) :assert (false) :priority 300)

;; Totality, on stored negatives alone — no `absent`, so no NAF boundary is in
;; the argument. Dormant while root is saturated; refuting once the cache has
;; written. Root is not re-saturated, so it never fires.
(rule totality ()
  :match  (and (not (p A)) (not (p B)))
  :assert (false)
  :priority 400)

(query
  :goal   (is-a ?x T)
  :expect (model (is-a A T) (is-a B T)))
