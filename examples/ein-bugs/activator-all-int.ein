;;; An activator whose every argument is a name of digits, in a chain of
;;; activators that ends in a refutation: a program that is not monotone.
;;; `1` is a name (Q-M1e2.24).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `check` proposes `(checked 1)`, the one candidate. While `1` is not
;;; checked, `flag` asserts the activator `(watch 1)`; `watch` asserts the
;;; activator `(alarm 1)`; and `alarm` concludes `(false)`. Root decides
;;; nothing about `checked`, so its fixpoint has all three, and `(false)`.
;;;
;;; ── What is said of it ─────────────────────────────────────────────────
;;;
;;; `alarm`'s `(false)` rests on its activator, which `watch` derives from
;;; its own activator, which `flag` derives under `(absent (checked ?x))`,
;;; and `checked` is a relation a commitment can extend. `flag`'s `absent`
;;; is a site of the static check and each activator another, so the
;;; program is flagged: it loads, every command answers it with the warning
;;; that it is not monotone, and nothing is claimed of its answer
;;; (Q-M1f.564). A plan has an activator when its rule has parameters,
;;; whatever the activator's arguments are, and `Plan::activator_args`
;;; keeps every argument, so the sites name `[activator 1]`.
;;;
;;; `activator-all-symbol.ein` is the same program with `(item a)`, and
;;; `activator-all-nested.ein` the same with a nested fact.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(relation item    T :why "{?3} is an item")
(relation checked T :why "{?3} is checked")
(relation watch   T :why "{?3} is under watch")
(relation alarm   T :why "an alarm is raised for {?3}")

(rule check () :match (item ?x) :assert (open (checked ?x)) :why "guess that {?x} is checked")

(rule flag () :match (and (item ?x) (absent (checked ?x))) :assert (watch ?x) :why "{?x} is an item not yet checked, so it is put under watch")
(rule watch (?n) :match (item ?n) :assert (alarm ?n) :why "{?n} is an item under watch, so an alarm is raised for {?n}")
(rule alarm (?k) :match (item ?k) :assert (false) :why "an alarm is raised for {?k}, and no alarm may be raised")

(item 1)
