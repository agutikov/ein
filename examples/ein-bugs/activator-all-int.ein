;;; An activator whose every argument is not a symbol read as no activator
;;; to *forbid* — regression
;;; `activator-all-int` (`corpus/regressions.toml`). Its argument `1`
;;; was an int then; Ein has no numbers, and `1` is a name (Q-M1e2.24).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `check` proposes `(checked 1)`, the one candidate. While `1` is not
;;; checked, `flag` asserts the activator `(watch 1)`; `watch` asserts the
;;; activator `(alarm 1)`; and `alarm` concludes `(false)`. Root decides
;;; nothing about `checked`, so its fixpoint has all three, and `(false)`.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; `alarm`'s `(false)` rests on its activator, which `watch` derives from
;;; its own activator, which `flag` derives under `(absent (checked ?x))`,
;;; and `checked` is a relation a commitment can extend. That is *forbid*,
;;; followed through each activator (Q-M1e2.5): the program is refused,
;;; as `activator-all-symbol.ein`, the same program with `(item a)`, is.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; At `6a775f3d`, R empty, every node dead, exit 0 (`ein solve FILE`, and
;;; under every mode, `ein oracle` and a debug build alike).
;;; *forbid* asked whether a plan has an activator as
;;; `!activator_args.is_empty()`, and `Plan::activator_args` kept an
;;; activator's symbol arguments only, so root's plan of `alarm`, compiled
;;; from `(alarm 1)`, read as a rule with no activator and its cause was
;;; never looked for. `watch`'s plan was missed the same way, but `watch`'s
;;; activator relation is one a commitment can change, so *forbid* reads
;;; that rule from its pattern too and found what it derives; `alarm`'s is
;;; not, which is why the chain takes three rules (with two the pattern
;;; reading refused an int activator as well). *forbid* reads whether the
;;; plan's rule has parameters, and every question about a commitment exits
;;; 1 naming `alarm [activator 1]`, as on the control, where `ein saturate`
;;; still saturates.
;;; `activator-all-nested.ein` is the same shape with a nested fact.

(relation item    T :why "{?1} is an item")
(relation checked T :why "{?1} is checked")
(relation watch   T :why "{?1} is under watch")
(relation alarm   T :why "an alarm is raised for {?1}")

(hrule check () :match (item ?x) :assert (checked ?x) :why "guess that {?x} is checked")

(rule flag () :match (and (item ?x) (absent (checked ?x))) :assert (watch ?x) :why "{?x} is an item not yet checked, so it is put under watch")
(rule watch (?n) :match (item ?n) :assert (alarm ?n) :why "{?n} is an item under watch, so an alarm is raised for {?n}")
(rule alarm (?k) :match (item ?k) :assert (false) :why "an alarm is raised for {?k}, and no alarm may be raised")

(item 1)
