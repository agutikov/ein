;;; The alive-∅ record site BETWEEN LAYERS: a search that wrote negatives
;;; into root recorded as a model a state its own rules refute, at stock
;;; config with no flags. Regression alive-empty-interlayer.
;;
;; `phase2` recomputed `alive` after a layer, found it empty, and recorded root
;; — which by then held this layer's singleton writeback `(not (p Z))` and the
;; kill cache's `(not (p A))` / `(not (p B))`, all written after root's last
;; saturation. `totality` matched that state and had not fired.
;;
;; Three enterings, one layer. The recorded state was
;; `(is-a A T) (is-a B T) (is-a Z T) (not (p A)) (not (p B)) (not (p Z))`; feed
;; it back as a program and that engine answered `Contradiction` on it, as
;; it did on this file once it re-saturated before recording. The trigger
;; was the singleton writeback, not the kill cache, so turning the cache off
;; did not repair it; `alive-empty-phase1.ein` is the other site.
;;
;; ── The answer ────────────────────────────────────────────────────────────
;;
;; That `Contradiction` read the search's own negatives as the state's. A
;; node is `sat(root ∪ C)` with nothing a search wrote (Q-M1e2.7), so no
;; `(not (p Z))` is ever stored and `mutex` never fires. And `totality`
;; concludes `(false)` from `(absent (p A))` over `p`, which the hrule
;; proposes: a refutation resting on an `absent` a commitment can still
;; fill (*forbid*, Q-M1e2.5), so the program is refused at load. Every
;; question about a commitment exits 1 naming `totality` over `p`;
;; `ein saturate` still saturates. A refused program has no R to check a
;; claim against, so the file states none.
;;
;; Deleting `totality` leaves a program the static check calls monotone,
;; whose R is 4 states, maximal `{(p A), (p B)}`: the regression's
;; alternative answer.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(relation is-a T T :why "{?3} is a {?4}")
(relation p T :why "p holds of {?3}")
(relation bad T :why "{?3} is bad")

(is-a A T) (is-a B T) (is-a Z T)

(hrule guess () :match (is-a ?x T) :assert (p ?x) :why "guess (p {?x})")

;; (p Z) dies in TWO steps, `taint` then `kill`, so a one-step lookahead
;; cannot see it and it survived into the search's layer as an entering. Z
;; sorts last, so its entering was the layer's last and the two survivors
;; were entered against a root that had not grown yet.
(rule taint () :match (p Z)   :assert (bad Z) :why "p holds of Z, so Z is bad")
(rule kill  () :match (bad Z) :assert (false) :why "Z is bad, which cannot be")

;; Once (not (p Z)) is stored, nothing may have p — ONE step from any
;; (p ?x), which is what emptied `alive` on the search's recompute.
(rule mutex ()
  :match  (and (not (p Z)) (p ?x))
  :assert (false) :why "p is false of Z, so it may hold of nothing, yet it holds of {?x}")

;; Totality as a saturation refutation: something must have p. It reads
;; `(absent (p A))` over `p`, which the hrule proposes, and that is the
;; shape *forbid* refuses.
(rule totality ()
  :match  (and (not (p Z)) (absent (p A)) (absent (p B)))
  :assert (false) :why "p is false of Z and holds of neither A nor B, yet something must have p")

(query
  :goal   (p ?x))
