;;; A refutation that reads an `absent` over a relation the hypothesis rule proposes,
;;; beside stored negations nothing writes: a program that is not monotone.
;;
;; `taint` and `kill` make `(p Z)` dead in two steps. `mutex` would refute
;; any `p` once `(not (p Z))` is stored, and `totality` says that something
;; must have `p`: it concludes `(false)` from `(not (p Z))` with
;; `(absent (p A))` and `(absent (p B))`.
;;
;; ── What is said of it ────────────────────────────────────────────────────
;;
;; A node is `sat(root ∪ C)` with nothing a search wrote (Q-M1e2.7), so no
;; `(not (p Z))` is ever stored, and neither `mutex` nor `totality` fires.
;; But `totality` reads `(absent (p A))` over `p`, which the hypothesis rule proposes:
;; a refutation resting on an `absent` a commitment can still fill. That is
;; a site of the static check, so the program is flagged: it loads, every
;; command answers it with the warning that it is not monotone, and nothing
;; is claimed of its answer (Q-M1f.564). The file states no claim.
;;
;; Deleting `totality` leaves a program the static check calls monotone.
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;
;;

(relation is-a T T :why "{?3} is a {?4}")
(relation p T :why "p holds of {?3}")
(relation bad T :why "{?3} is bad")

(is-a A T) (is-a B T) (is-a Z T)

(rule guess () :match (is-a ?x T) :assert (open (p ?x)) :why "guess (p {?x})")

;; (p Z) dies in TWO steps, `taint` then `kill`, so a one-step lookahead
;; cannot see it and it survived into the search's layer as an entering. Z
;; sorts last, so its entering was the layer's last and the two survivors
;; were entered against a root that had not grown yet.
(rule taint () :match (p Z)   :assert (bad Z) :why "p holds of Z, so Z is bad")
(rule kill  () :match (bad Z) :assert (false) :why "Z is bad, which cannot be")

;; Once (not (p Z)) is stored, nothing may have p — ONE step from any
;; (p ?x), which is what emptied `alive` on the search's recompute.
(rule mutex ()
  :match  (and (not (p Z)) (p ?x))
  :assert (false) :why "p is false of Z, so it may hold of nothing, yet it holds of {?x}")

;; Totality as a saturation refutation: something must have p. It reads
;; `(absent (p A))` over `p`, which the hypothesis rule proposes, and that is what
;; makes the program non-monotone.
(rule totality ()
  :match  (and (not (p Z)) (absent (p A)) (absent (p B)))
  :assert (false) :why "p is false of Z and holds of neither A nor B, yet something must have p")

(query
  :goal   (p ?x))
