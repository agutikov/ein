;;; An activator whose every argument is a nested fact reads as no activator
;;; to *forbid* — M1e2 **W16**'s second shape, register row
;;; `W16/activator-all-nested` (`corpus/wrong_answers.toml`), banked and
;;; fixed by S1e2.2.16 (2026-11-04).
;;;
;;; `activator-all-int.ein` with `(item (box a))` for `(item 1)`, and
;;; nothing else: `flag` asserts `(watch (box a))` and `watch` asserts
;;; `(alarm (box a))`. A nested fact binds no parameter, so each plan
;;; matches `(item ?n)` over every item, which here is the one.
;;;
;;; ── The answer, by hand ────────────────────────────────────────────────
;;;
;;; As `activator-all-int.ein`'s: `alarm`'s `(false)` rests, through two
;;; activators, on `(absent (checked ?x))`, and `checked` is a relation a
;;; commitment can extend, so *forbid* refuses the program, as it does
;;; `activator-all-symbol.ein`.
;;;
;;; ── What the engine answered, and why it does not any more ─────────────
;;;
;;; Until S1e2.2.16, R empty, every node dead, exit 0 (`ein solve FILE` at
;;; `6a775f3d`, in either build): `Plan::activator_args` keeps symbols only,
;;; so root's plan of `alarm` read as having no activator, as the int one
;;; did. Since then *forbid* reads whether the plan's rule has parameters,
;;; and the program is refused, as the control is.

(relation item    T :why "{?1} is an item")
(relation checked T :why "{?1} is checked")
(relation watch   T :why "{?1} is under watch")
(relation alarm   T :why "an alarm is raised for {?1}")

(hrule check () :match (item ?x) :assert (checked ?x) :why "guess that {?x} is checked")

(rule flag () :match (and (item ?x) (absent (checked ?x))) :assert (watch ?x) :why "{?x} is an item not yet checked, so it is put under watch")
(rule watch (?n) :match (item ?n) :assert (alarm ?n) :why "{?n} is an item under watch, so an alarm is raised for {?n}")
(rule alarm (?k) :match (item ?k) :assert (false) :why "an alarm is raised for {?k}, and no alarm may be raised")

(item (box a))
