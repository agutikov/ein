;;; A RUN OF DIGITS in a goal binding.
;;;
;;; Found by the engine fuzzer in its first two minutes and minimised to
;;; these two forms. A goal binding is the *stored* argument, and it must
;;; reach `--json-summary` as written. A run of digits is a name
;;; (Q-M1e2.24), and every name is a JSON *string* in the summary's rows
;;; (Q-M1f.340), so that `(p 007)` and `(p 7)`, two names, stay two there:
;;;
;;;     "rows": [{"x": "o3", "y": "8"}, {"x": "o4", "y": "-7"},
;;;              {"x": "o5", "y": "99999999999999999999999"}]
;;;
;;; stdout is the same however the summary writes a binding, which is why no
;;; stdout golden would see it. The name is carried as written, at any
;;; width: no clamping to a machine integer, and
;;; `99999999999999999999999` round-trips.
;;;
;;; This file is the regression: `solve --json-summary` must agree.
;;;
;;;
;;;
;;;
;;;
;;;
;;;
;;;

(r1 o3 8)
(r1 o4 -7)
(r1 o5 99999999999999999999999)

(query :goal (r1 ?x ?y))
