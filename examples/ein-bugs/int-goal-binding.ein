;;; M1a S1a.6.6 — an INTEGER in a goal binding.
;;;
;;; Found by the engine fuzzer (`utils/fuzz_engine.py`) in its first two
;;; minutes and minimised to these two forms. A goal binding is the *stored*
;;; argument, and an int argument must reach `--json-summary` as a number:
;;;
;;;     "y": 8       ← right: the stored arg is an INT, so the summary
;;;                    writes a NUMBER
;;;     "y": "8"     ← what every binding was while it went through `sexpr_value`
;;;
;;; stdout is the same either way, which is why no stdout golden saw it: no
;;; corpus puzzle binds a query variable to an int.
;;; The IR's INT is unbounded, so the fix carries arbitrary precision
;;; (`Json::BigInt`) rather than clamping to i64 — `-2` and
;;; `99999999999999999999999` both round-trip.
;;;
;;; Fixed 2026-08-20 in ein.rs (`ein-render/src/dump/answer.rs::binding_value`).
;;; This file is the regression: `solve --json-summary` must agree.

(r1 o3 8)
(r1 o4 -7)
(r1 o5 99999999999999999999999)

(query :goal (r1 ?x ?y))
