;;; Fractions, computed by saturation alone: 1/2 + 1/3 = 5/6, 1/2 divided by
;;; -3/4 = -4/6, which is -2/3 in lowest terms, and 2/4 is 1/2, lowest
;;; terms on request.
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `std.math.rat` is the third theory of the calculator, over `std.math.int` (`int.ein`
;;; beside this file) and `std.math.decimal-arith` (`add.ein`): a rational is an integer
;;; over a natural number that is not zero. **An answer is not reduced**: the
;;; numerator is simplified and the denominator has no high zero, and a common
;;; factor of the two stays; `rat-simplify` is the one request that answers in
;;; lowest terms (Q-M1f.183: a rational need not be reduced each time, and
;;; a program asks for lowest terms where it wants them).
;;;
;;;   (rat Z D)              a rational: the integer Z over the number D.
;;;                          1/2 is (rat (int (n z 1) z) (n z 2)), and -3/4
;;;                          is (rat (int z (n z 3)) (n z 4))
;;;   (rat-add X Y)          a request fact; (rat-sum-of X Y S) answers it
;;;   (rat-sub X Y)          answered by (rat-diff-of X Y S)
;;;   (rat-mul X Y)          answered by (rat-product-of X Y S)
;;;   (rat-div X Y)          answered by (rat-quot-of X Y S): one rational,
;;;                          exact, and no remainder
;;;   (rat-cmp X Y)          answered by (rat-cmp-of X Y O), O lt, eq or gt
;;;   (rat-neg X)            answered by (rat-neg-of X S)
;;;   (rat-simplify X)       answered by (rat-simple-of X S), X in lowest
;;;                          terms
;;;   (let NAME (rat Z D))   a named rational; a request may name its operands
;;;
;;; ── What happens ───────────────────────────────────────────────────────
;;;
;;; Nothing is guessed. A sum is the cross products over the product of the
;;; denominators, and nothing is divided:
;;;
;;;   1/2 + 1/3:   1 x 3 + 1 x 2 = 5, over 2 x 3 = 6: 5/6
;;;   1/2 / -3/4:  1/2 x -4/3 = -4/6, the factor 2 left where it is
;;;
;;; Lowest terms is asked for: `rat-simplify` finds the greatest common
;;; divisor by `std.math.gcd`, Euclid's chain, each step a division of
;;; `std.math.decimal-arith`, and divides both terms by it.
;;;
;;;   -4/6:        gcd(4, 6): 4 = 0 x 6 + 4;  6 = 1 x 4 + 2;  4 = 2 x 2 + 0
;;;                so 2, and -4/6 is -2/3
;;;
;;; A comparison is the cheapest of them: the cross products are compared,
;;; and nothing is divided.
;;;
;;; ── The program's own rules ────────────────────────────────────────────
;;;
;;; A recipe for four takes 3/4 of a cup of flour, and the cook is baking
;;; for six: `scale` is 6/4, written as it is said and not in lowest terms,
;;; and the flour needed is 18/16 as computed. The rule `enough` asks whether
;;; that is more than the cup the cook has, which `rat-cmp` answers by value,
;;; `go-shopping` reads the answer, and `shopping-list` asks the amount in
;;; lowest terms, 9/8, as a cook would say it. `quotient-in-lowest-terms`
;;; asks the same of the quotient.
;;;
;;; `ein solve examples/arith/rat.ein --trace T.md` writes every step as a
;;; sentence.

(import std.math.rat :symbols (rat-arith rat-add rat rat-sub rat-div rat-simplify rat-mul
                          rat-product-of rat-cmp rat-cmp-of rat-sum-of rat-diff-of rat-quot-of
                          rat-simple-of))
(import std.math.int :symbols (int))
(import std.math.decimal-arith :symbols (let))
(import std.math.decimal :symbols (n))
(import std.math.arith :symbols (z))

(relation short-of Name Rational
  :why "there is not enough {?3}: {?4} is needed")
(__closed__ short-of)

(rat-add (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3)))
(rat-sub (rat (int (n z 1) z) (n z 3)) (rat (int (n z 1) z) (n z 2)))
(rat-div (rat (int (n z 1) z) (n z 2)) (rat (int z (n z 3)) (n z 4)))
(rat-simplify (rat (int (n z 2) z) (n z 4)))

(let flour (rat (int (n z 3) z) (n z 4)))
(let scale (rat (int (n z 6) z) (n z 4)))
(let cup   (rat (int (n z 1) z) (n z 1)))
(rat-mul flour scale)

(rule enough ()
  :match  (rat-product-of flour scale ?needed)
  :assert (rat-cmp ?needed cup)
  :why    "{?needed} of a cup is needed: is that more than the cup there is?")

(rule go-shopping ()
  :match  (rat-cmp-of ?needed cup gt)
  :assert (short-of flour ?needed)
  :why    "{?needed} is more than a cup")

(rule shopping-list ()
  :match  (short-of flour ?needed)
  :assert (rat-simplify ?needed)
  :why    "{?needed} of a cup is needed: in lowest terms, as a cook says it")

(rule quotient-in-lowest-terms ()
  :match  (rat-quot-of ?x ?y ?q)
  :assert (rat-simplify ?q)
  :why    "{?x} divided by {?y} is {?q}: in lowest terms?")

(solve :expect (region (model)))

(query :goal (rat-sum-of ?x ?y ?s)
       :goal-text "{?x} + {?y} = {?s}"
       :expect (model (rat-sum-of (rat (int (n z 1) z) (n z 2)) (rat (int (n z 1) z) (n z 3))
                                  (rat (int (n z 5) z) (n z 6)))))

(query :goal (rat-diff-of ?x ?y ?s)
       :goal-text "{?x} - {?y} = {?s}"
       :expect (model (rat-diff-of (rat (int (n z 1) z) (n z 3)) (rat (int (n z 1) z) (n z 2))
                                   (rat (int z (n z 1)) (n z 6)))))

(query :goal (rat-quot-of ?x ?y ?s)
       :goal-text "{?x} divided by {?y} = {?s}"
       :expect (model (rat-quot-of (rat (int (n z 1) z) (n z 2)) (rat (int z (n z 3)) (n z 4))
                                   (rat (int z (n z 4)) (n z 6)))))

(query :goal (rat-simple-of ?x ?s)
       :goal-text "{?x} is {?s}"
       :expect (model (rat-simple-of (rat (int (n z 2) z) (n z 4)) (rat (int (n z 1) z) (n z 2)))
                      (rat-simple-of (rat (int z (n z 4)) (n z 6)) (rat (int z (n z 2)) (n z 3)))
                      (rat-simple-of (rat (int (n (n z 1) 8) z) (n (n z 1) 6)) (rat (int (n z 9) z) (n z 8)))))

(query :goal (rat-product-of ?x ?y ?s)
       :goal-text "{?x} x {?y} = {?s}"
       :expect (model (rat-product-of flour scale (rat (int (n (n z 1) 8) z) (n (n z 1) 6)))))

(query :goal (short-of ?what ?needed)
       :goal-text "there is not enough {?what}: {?needed} is needed"
       :expect (model (short-of flour (rat (int (n (n z 1) 8) z) (n (n z 1) 6)))))
