;;; Long division, computed by saturation alone: 127645 divided by 25 is
;;; 5105, remainder 20; and a chain, (123 x 456) divided by 25.
;;; M1f P1f.6 (S1f.6.6).
;;;
;;; ── What this program is ───────────────────────────────────────────────
;;;
;;; `std.math.decimal-arith` is school arithmetic written in Ein over the digit tables of
;;; `std.math.digits` (`add.ein` beside this file is the introduction).
;;;
;;;   (div X Y)             a request fact: X divided by Y is asked
;;;   (quot-of X Y Q R)     the answer: the quotient and the remainder,
;;;                         X = Q x Y + R, and R less than Y
;;;
;;; ── What happens ───────────────────────────────────────────────────────
;;;
;;; School long division. First the divisor's multiples, 25, 50, 75, … 225,
;;; each a row of multiplication. Then the dividend's digits from the top,
;;; one step a digit: the digit is brought down beside what is left over,
;;; and the quotient's digit is found by halving the range 0 to 10. A trial
;;; subtracts a multiple; it fits, or it is short:
;;;
;;;   bring down    number    trials                              digit   left
;;;   1                  1    5 no, 2 no, 1 no                        0      1
;;;   2                 12    5 no, 2 no, 1 no                        0     12
;;;   7                127    5 fits, 7 no, 6 no                      5      2
;;;   6                 26    5 no, 2 no, 1 fits                      1      1
;;;   4                 14    5 no, 2 no, 1 no                        0     14
;;;   5                145    5 fits, 7 no, 6 no                      5     20
;;;
;;; Nothing is guessed: a trial is a subtraction, and the tables decide it.
;;; `ein solve examples/arith/div.ein --trace T.md` writes every step as a
;;; sentence; this division takes 220 of them.
;;;
;;; ── The chain ──────────────────────────────────────────────────────────
;;;
;;; A request is a fact, so a rule may derive one from another answer.
;;; `then-divide` matches the product of 123 and 456 and asks for it to be
;;; divided by 25: 56088 divided by 25 is 2243, remainder 13. The program
;;; never writes 56088.
;;;
;;; ── Division by zero ───────────────────────────────────────────────────
;;;
;;; This program has none. One that has is a contradiction, and
;;; `div_by_zero.ein` beside this file shows what Ein says of it.

(import std.math.decimal-arith :symbols (decimal-arith div n mul product-of quot-of))

(div (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) (n (n z 2) 5))

(mul (n (n (n z 1) 2) 3) (n (n (n z 4) 5) 6))

(rule then-divide ()
  :match  (product-of (n (n (n z 1) 2) 3) (n (n (n z 4) 5) 6) ?p)
  :assert (div ?p (n (n z 2) 5))
  :why    "the product is {?p}: now divide it by 25")

(query :goal (quot-of ?x ?y ?q ?r)
       :goal-text "{?x} divided by {?y} = {?q}, remainder {?r}"
       :expect (model (quot-of (n (n (n (n (n (n z 1) 2) 7) 6) 4) 5) (n (n z 2) 5)
                               (n (n (n (n z 5) 1) 0) 5) (n (n z 2) 0))
                      (quot-of (n (n (n (n (n z 5) 6) 0) 8) 8) (n (n z 2) 5)
                               (n (n (n (n z 2) 2) 4) 3) (n (n z 1) 3))))
