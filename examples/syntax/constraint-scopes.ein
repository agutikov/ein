;;; Syntax probe — constraint-scopes.
;;;
;;; The property markers the constraint view groups by:
;;; bijective, symmetric, includes, slot-partition and square-unique.
;;;
;;; One of the eighteen node-kind fixtures S1a.10.2 moved out of
;;; `ein-render/tests/dot_parity.rs`, where they were rendered under all
;;; eight parse views and diffed against ein.py. As corpus entries they are
;;; digested by `corpus_shapes.md5` instead — every view, every op, no
;;; second engine. They exist because no *puzzle* contains these shapes.

(relation next-to House House)
(relation right-of House House)
(bijective next-to)
(symmetric next-to)
(includes right-of next-to)
(slot-partition next-to instance type Attribute House)
(square-unique right-of House)
