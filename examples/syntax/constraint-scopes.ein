;;; Syntax probe — constraint-scopes.
;;;
;;; The property markers the constraint view groups by:
;;; bijective, symmetric, includes, slot-partition and square-unique.
;;;
;;; One of the eighteen node-kind fixtures. As corpus entries they are
;;; rendered under every parse view and every op, and each rendering is
;;; digested by `corpus_shapes.md5`, so a change to how any of these
;;; shapes is drawn moves a digest. They exist because no *puzzle*
;;; contains these shapes.

(relation next-to House House)
(relation right-of House House)
(bijective next-to)
(symmetric next-to)
(includes right-of next-to)
(slot-partition next-to instance type Attribute House)
(square-unique right-of House)
