;;; Syntax probe — trace-steps.
;;;
;;; A `(trace …)` whose steps chain through step ids, through an
;;; `(and …)` premise, and through the two half-specified shapes.
;;;
;;; One of the eighteen node-kind fixtures. As corpus entries they are
;;; rendered under every parse view and every op, and each rendering is
;;; digested by `corpus_shapes.md5`, so a change to how any of these
;;; shapes is drawn moves a digest. They exist because no *puzzle*
;;; contains these shapes.

(trace (step s1 :rule from-condition :using (c10) :derives (lives-in N H1))
  (step s2 :rule adjacent :using (and s1 c15) :derives (color-loc Blue H2))
  (step s3 :using (s2))
  (step s4 :derives (final X)))
