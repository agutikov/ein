;;; Syntax probe — query-full.
;;;
;;; A `(query …)` with its `:goal` and its `:goal-text`, beside two rules
;;; without parameters that conclude hypotheses of `drinks`: the query asks,
;;; and the hypotheses are the rules'. The goal may name `drinks`, which only
;;; a hypothesis writes: a relation of the program is any atom it writes
;;; first in a tuple, under `open` too (Q-M1f.522).
;;;
;;; One of the eighteen node-kind fixtures. As corpus entries they are
;;; rendered under every parse view and every op, and each rendering is
;;; digested by `corpus_shapes.md5`, so a change to how any of these
;;; shapes is drawn moves a digest. They exist because no *puzzle*
;;; contains these shapes.

(rule h1 () :match (is-a ?h House) :assert (open (drinks Water ?h))
  :why "guess that water is drunk in {?h}")
(rule h2 () :match (is-a ?h House) :assert (open (drinks Tea ?h))
  :why "guess that tea is drunk in {?h}")
(query :goal (drinks Water ?h) :goal-text "who drinks water")
