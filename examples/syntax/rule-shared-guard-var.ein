;;; Syntax probe — rule-shared-guard-var.
;;;
;;; Two `(absent …)` guards sharing a variable that the
;;; positive premises never bind — the disjoint-guard-set shape.
;;;
;;; One of the eighteen node-kind fixtures. As corpus entries they are
;;; rendered under every parse view and every op, and each rendering is
;;; digested by `corpus_shapes.md5`, so a change to how any of these
;;; shapes is drawn moves a digest. They exist because no *puzzle*
;;; contains these shapes.

(relation r T T :why "r holds of {?1} and {?2}")
(rule sh ()
  :match  (and (r ?a ?b) (absent (r ?a ?z)) (absent (r ?b ?z)))
  :assert (r ?b ?a)
  :why    "r holds of {?a} and {?b}, and no r fact starts at {?a} or at {?b}, so r holds of {?b} and {?a}")
