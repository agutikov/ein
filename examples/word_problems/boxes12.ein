;;; Bob has 5 apples, Alice has 7. A box holds 3. How many boxes do they need?
;;; Three numbers and two steps, and the program is the plan: *they* means
;;; together, so 5 + 7 = 12; a box *holds* 3, so 12 / 3 = 4. Nothing is left
;;; over, so the readings of *need* agree: none is proposed, and the problem
;;; is search-free.
(import words :symbols (words))
(import readings :symbols (readings))

(has Bob apples (n z 5) now    :source "Bob has 5 apples,")
(has Alice apples (n z 7) now  :source "Alice has 7.")
(holds boxes apples (n z 3)    :source "A box holds 3.")
(asked (needed boxes apples (together Bob Alice apples now)) :source "How many boxes do they need?")

(solve :hrules (read-need))

(query :goal (and (asked ?q) (value ?q ?n))
       :goal-text "{?q}: {?n}"
       :expect (model (asked (needed boxes apples (together Bob Alice apples now)))
                      (value (needed boxes apples (together Bob Alice apples now)) (n z 4))))
(query :goal (reads-as need ?m)
       :goal-text "need is read as {?m}"
       :expect (model))
(query :goal (model-counts-only)
       :goal-text "this answer holds in a model where things are counted by number alone: a box holds any 3 apples")
