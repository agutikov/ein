;;; Bob has 5 apples. Alice has 4 apples. He gave 2 to Alice.
;;; How many apples does Bob have? How many does Alice have?
;;; How many apples do they have together?
;;; The gap of gap.ein closed by a sentence: 3, 6 and 9.
(import words :symbols (words has gave asked amount together value))
(import std.arith :symbols (n))

(has Bob apples (n z 5) t0            :source "Bob has 5 apples.")
(has Alice apples (n z 4) t0          :source "Alice has 4 apples.")
(gave Bob Alice apples (n z 2) t0 t1  :source "He gave 2 to Alice.")
(asked (amount Bob apples t1)         :source "How many apples does Bob have?")
(asked (amount Alice apples t1)       :source "How many does Alice have?")
(asked (together Bob Alice apples t1) :source "How many apples do they have together?")

(query :goal (and (asked ?q) (value ?q ?n))
       :goal-text "{?q}: {?n}"
       :expect (model (asked (amount Bob apples t1))
                      (asked (amount Alice apples t1))
                      (asked (together Bob Alice apples t1))
                      (value (amount Bob apples t1) (n z 3))
                      (value (amount Alice apples t1) (n z 6))
                      (value (together Bob Alice apples t1) (n z 9))))
