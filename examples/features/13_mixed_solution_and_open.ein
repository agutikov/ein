;;; One state of R beside one that owes — a single choice whose state is
;;; alive and discharged, and its sibling, alive and owing.
;;
;; R is the commitments whose state is alive and discharged
;; (docs/ein/reasoning/02-kb-evolution/06-solution-semantics.md § 2). A node that
;; owes is alive and not in R; a node that is dead is neither. The cube here
;; has four nodes, and each kind is among them:
;;
;;     ∅                              owes 1 — nothing feeds Ann
;;     {(choice Ann)}                 in R   — `feeds` fires, both are fed
;;     {(choice Bob)}                 owes 1 — nothing feeds Ann
;;     {(choice Ann), (choice Bob)}   dead   — `mutex`
;;
;; `ein solve` reports
;;
;;     states (k_s)      1
;;     ∅                 not in R — root owes 1 instance
;;
;; and lists the one state, `{(choice Ann)}`: an owing node is not a state of
;; R, however many of them the search visits on the way.
;;
;; ── Why it is worth a fixture ──────────────────────────────────────────────
;;
;; It is the smallest program in which a state of R and an owing node are
;; siblings, so a read-out that counted every alive node it visited would
;; print two where R holds one. The `:expect` below lists R, and `ein test`
;; holds it; `ein oracle FILE --dump DIR` writes every node of the cube with
;; its status, in `region.json`.
;;
;;
;; ── How the two states are built ───────────────────────────────────────────
;;
;; `total-owed likes is-a` puts the program in the read-out's scope: every
;; `Person` owes a `Food`. `Bob` has one outright. `Ann` gets one only in the
;; branch that chose her.
;;
;; `mutex` makes `{Ann, Bob}` dead, so each single choice is **maximal**
;; rather than a stop on the way to `{Ann, Bob}`: no alive node lies above
;; it.
;;
;;   {(choice Ann)} — `feeds` fires, both people are fed, owes 0 → the model
;;   {(choice Bob)} — nothing feeds Ann, owes 1          → the open state
;;
;; Two alive single choices, one state of R: the owing choice is alive, and
;; it is not in R.

(import std.algebra :symbols (total-owed))

(relation is-a   T T          :why "{?1} is a {?2}")
(relation likes  Person Food  :why "{?1} likes {?2}")
(relation choice Person       :why "{?1} was the one chosen")

(is-a Ann Person) (is-a Bob Person)
(is-a Soup Food)

(likes Bob Soup)

;; The obligation. Without this line the program owes nothing, every alive
;; node is in R — three states — and `--single` says `Ambiguity`.
(total-owed likes is-a)

(hrule pick () :match (is-a ?p Person) :assert (choice ?p) :why "suppose {?p} is the one chosen")

(rule feeds ()
  :match  (choice Ann)
  :assert (likes Ann Soup)
  :why    "the one chosen is fed")

;; Exactly one choice, so a single commitment is already complete.
(rule mutex ()
  :match  (and (choice Ann) (choice Bob))
  :assert (false)
  :why    "Ann and Bob are both chosen, but only one may be")

(solve
  ;; The blind rung would propose `is-a` and `likes` facts of its own; the
  ;; subject here is the partition, not the generator.
  :no-hypothesis (is-a likes)
  :expect (region (model (likes Ann Soup) (likes Bob Soup))))

(query
  :goal   (likes ?who ?what))
