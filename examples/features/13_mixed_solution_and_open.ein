;;; A state of R beside one that owes — a single choice whose state is
;;; alive and discharged, and its sibling, alive and owing.
;;
;; R is the commitments whose state is alive and discharged
;; (docs/ein/reasoning/02-kb-evolution/06-solution-semantics.md § 2). A node that
;; owes is alive and not in R; a node that is dead is neither. The candidates
;; are the two choices the hypothesis rule proposes and `(likes Ann Soup)`, which the
;; obligation proposes beside them (Q-M1f.570). Among the cube's nodes:
;;
;;     ∅                              owes 1 — nothing feeds Ann
;;     {(choice Ann)}                 in R   — `feeds` fires, both are fed
;;     {(choice Bob)}                 owes 1 — nothing feeds Ann
;;     {(likes Ann Soup)}             in R   — Ann is fed outright
;;     {(choice Ann), (choice Bob)}   dead   — `mutex`
;;
;; `ein solve` reports
;;
;;     states (k_s)      3
;;     ∅                 not in R — root owes 1 instance
;;
;; and lists the three states: an owing node is not a state of R, however many
;; of them the search visits on the way.
;;
;; ── Why it is worth a fixture ──────────────────────────────────────────────
;;
;; It is the smallest program in which a state of R and an owing node are
;; siblings, so a read-out that counted every alive node it visited would
;; count `{(choice Bob)}` where R does not. The `:expect` below lists R, and
;; `ein test` holds it; `ein oracle FILE --dump DIR` writes every node of the
;; cube with its status, in `region.json`.
;;
;;
;; ── How the two states are built ───────────────────────────────────────────
;;
;; `total-owed likes is-a` puts the program in the read-out's scope: every
;; `Person` owes a `Food`. `Bob` has one outright. `Ann` gets one only in the
;; branch that chose her.
;;
;; `mutex` makes `{Ann, Bob}` dead, so each single choice is **maximal**
;; rather than a stop on the way to `{Ann, Bob}`: no alive node lies above
;; it.
;;
;;   {(choice Ann)} — `feeds` fires, both people are fed, owes 0 → the model
;;   {(choice Bob)} — nothing feeds Ann, owes 1          → the open state
;;
;; Two alive single choices, one state of R: the owing choice is alive, and
;; it is not in R.

(import std.algebra :symbols (total-owed))

(relation is-a   T T          :why "{?3} is a {?4}")
(relation likes  Person Food  :why "{?3} likes {?4}")
(relation choice Person       :why "{?3} was the one chosen")

(is-a Ann Person) (is-a Bob Person)
(is-a Soup Food)

(likes Bob Soup)

;; The obligation, which proposes what pays Ann's debt.
(total-owed likes is-a)

(rule pick () :match (is-a ?p Person) :assert (open (choice ?p)) :why "suppose {?p} is the one chosen")

(rule feeds ()
  :match  (choice Ann)
  :assert (likes Ann Soup)
  :why    "the one chosen is fed")

;; Exactly one choice, so a single commitment is already complete.
(rule mutex ()
  :match  (and (choice Ann) (choice Bob))
  :assert (false)
  :why    "Ann and Bob are both chosen, but only one may be")

(solve
  ;; Beside the rule's and the obligation's hypotheses the blind enumerator
  ;; does not run, and the list names no relation an `open` fact is of.
  :no-hypothesis (is-a)
  :expect (region
            (model (likes Ann Soup) (likes Bob Soup))
            (model (choice Ann) (likes Ann Soup) (likes Bob Soup))
            (model (choice Bob) (likes Ann Soup) (likes Bob Soup))))

(query
  :goal   (likes ?who ?what))
