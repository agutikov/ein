;;; Ein — feature demo: `eq` and `neq` are relations, asked about in a goal.
;;;
;;; M1f S1f.5.7 (T1f.5.7.2), on the user's ruling of 2026-11-07 (Q-M1e2.26):
;;; `eq` and `neq` are the relations of equality and non-equality. Their facts
;;; are fixed by name identity — `(eq x x)` for every value, `(neq x y)` for
;;; every two different values — computed, never stored, and no fact, rule or
;;; commitment changes them. A query over them is answered, not refused:
;;;
;;;   - a guard whose arguments are bound is a test;
;;;   - `eq` with one side free binds it to the other side, and with both
;;;     free gives every name of the program paired with itself;
;;;   - `neq` with one side free gives every name of the program but the other
;;;     side, and with both free every ordered pair of two different names.
;;;
;;; "The program's names" are the list H's candidates are built from
;;; (Q-M1e2.9 (a)): every constant a fact names at any depth, and every
;;; constant of a rule's `:match` or `:assert`. A name only a query writes, `w`
;;; below, is none of them. Here they are `p` and `Node`, which
;;; `(relation p Node)` stores, and `a`.
;;;
;;; A conjunction means the same in any order of its conjuncts: the guard in
;;; the last query waits for `(p ?y)`, which binds its variable. A claim may
;;; list an `eq` or `neq` fact, and closes it as it closes any relation it
;;; names: a class is the goal's instances, so the claim stays finite.
;;;
;;; ── What the engine prints ────────────────────────────────────────────────
;;;
;;; `ein solve examples/features/16_eq_neq_goal.ein` prints each query's one
;;; class, its rows, and the claim that states it, which holds; `ein test`
;;; exits 0. Until S1f.5.7 the first query held with nothing bound, *the goal
;;; holds: it has no variable*, the second had no row, and no claim naming
;;; `eq` or `neq` loaded.

(relation p Node :why "{?1} is a node")
(p a)

(query :goal (neq w ?y)
  :expect (model (neq w Node) (neq w a) (neq w p)))
(query :goal (eq w ?y)
  :expect (model (eq w w)))
(query :goal (neq a b)
  :expect (model (neq a b)))
(query :goal (eq a b)
  :expect (model))
(query :goal (neq a a)
  :expect (model))
(query :goal (eq ?x ?y)
  :expect (model (eq Node Node) (eq a a) (eq p p)))
(query :goal (neq ?x ?y)
  :expect (model (neq Node a) (neq Node p) (neq a Node) (neq a p) (neq p Node) (neq p a)))
(query :goal (and (p ?y) (neq w ?y))
  :expect (model (neq w a) (p a)))
(query :goal (and (neq a ?y) (p ?y))
  :expect (model))
