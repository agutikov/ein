;; LOAD NEGATIVE — an unknown (solve …) keyword.
;;
;; `(solve …)`'s keywords are an allow-list, as `(query …)`'s are
;; (Q-M1e2.28), so a misspelled lattice keyword cannot load, do nothing and
;; say nothing.
;;
;; Expected (load error): see solve_unknown_keyword.expected.

(relation p Thing Place)
(p A H1)
(solve :no-hypothesys (p))
(query :goal (p A ?h))
