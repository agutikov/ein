;;; A derived activator, where no run derives it: `derived_activator.ein`
;;; without `(item (a b))`, the witness of register row
;;; `W59/derived-activator-never`. The loader refuses it with the same line
;;; as its twin.
;;;
;;; No fact or candidate puts a fact in `item`, so no run derives an
;;; activator binding `?R` to one. The loader refuses it all the same: a
;;; rule *could* derive such an activator, `item` being declared, and a
;;; declared relation's argument is any value, a fact among them
;;; (Q-M1f.1, Q-M1f.41). The line is the one `derived_activator.ein` is
;;; refused with.
(relation box Node :why "{?1} is in the box")
(relation hit Node :why "{?1} is hit")
(relation item Node :why "{?1} is an item")
(box (a b))
(rule r (?R)
  :match (box (?R b))
  :assert (hit z)
  :why "a box holds a {?R} of b")
(rule mk ()
  :match (item ?f)
  :assert (r ?f)
  :why "{?f} is an item, so r is asked of it")
