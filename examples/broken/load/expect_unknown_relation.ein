;; `:expect` closes every relation it names, so a name no declaration and no
;; fact makes a relation would close something that does not exist — and pass,
;; vacuously, for ever.

(relation p Thing Place :why "p holds of {?1} and {?2}")
(p A H1)
(query :goal (p A ?h) :expect (model (p A H1) (nosuch A)))
