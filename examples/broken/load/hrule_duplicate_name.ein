;; …the same guard reached through two hrules.

(hrule g () :match (is-a ?o House) :assert (co-located ?o ?o) :why "guess that the House {?o} is co-located with itself")
(hrule g () :match (is-a ?o House) :assert (co-located ?o ?o) :why "guess, a second time, that the House {?o} is co-located with itself")
(relation is-a T T :why "{?1} is a {?2}")
(relation co-located T T :why "{?1} is co-located with {?2}")
