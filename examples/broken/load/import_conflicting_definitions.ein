;; One short name bound to two full names in one file is refused
;; (Q-M1f.234): in one file it is an error, as in any language with
;; namespaces. The program lists std.closure's `infer-closure` and declares
;; its own, so `infer-closure` would name two declarations; the loader
;; refuses it at the import, naming both full names, and says to write the
;; other by its full name.

(import std.closure :symbols (infer-closure))
(rule infer-closure () :match (foo ?x) :assert (bar ?x) :why "w")
