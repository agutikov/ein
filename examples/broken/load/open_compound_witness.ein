;; Two positive `?R` premises each binding a witness variable — "there must
;; exist a 2-chain". Refused rather than guessed: there is no single slot to
;; branch on, and no corpus entry needs one.

(relation is-a T T :why "{?1} is a {?2}")
(relation r A B :why "r holds of {?1} and {?2}")
(rule bad (?R ?isa)
  :match  (and (relation ?R ?A ?B) (?isa ?a ?A)
               (absent (and (?R ?a ?x) (?R ?x ?b))))
  :assert (open ?R) :why "{?a} is a {?A} that starts no two-step {?R} chain yet — one is still owed")
