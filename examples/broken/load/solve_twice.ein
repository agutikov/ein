;; LOAD NEGATIVE — two (solve …) forms.
;;
;; One program, one lattice, one R. A second `(solve …)` would state a second
;; lattice, and the lattice is stated once, apart from the questions asked of
;; it, so it is refused rather than merged or discarded.
;;
;; Expected (load error): see solve_twice.expected.

(relation p Thing Place :why "p holds of {?1} and {?2}")
(p A H1)
(solve :no-hypothesis (p))
(solve :no-hypothesis (p))
(query :goal (p A ?h))
