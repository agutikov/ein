;; A query's `:over` names which states of R it asks about — `all` (the
;; default), `minimal` or `maximal`, and nothing else. A component, or any
;; other subset, is not a value (docs/ein/user/03-syntax-and-semantics/12-query.md).

(relation p Thing Place :why "p holds of {?3} and {?4}")
(p A H1)
(query :goal (p A ?h) :over best :expect (model (p A H1)))
