digraph region {
  // ein render region — view full
  graph [rankdir=TB, labelloc=t, fontsize=12, nodesep=0.25, ranksep=0.6, newrank=true, label="region · examples/lattice/02_genuine_3set_death.ein\nn = 3 · |R| = 7 of 8 · monotone\nwalk: Ambiguity k = 3 exhausted = true · view full (8 of 8 nodes)"];
  node [fontsize=10, fontname="Helvetica"];
  edge [arrowsize=0.6];
  L0 [shape=plaintext, fontsize=9, label="L0 · 1"];
  L1 [shape=plaintext, fontsize=9, label="L1 · 3"];
  L2 [shape=plaintext, fontsize=9, label="L2 · 3"];
  L3 [shape=plaintext, fontsize=9, label="L3 · 1"];
  L0 -> L1 [style=invis];
  L1 -> L2 [style=invis];
  L2 -> L3 [style=invis];
  m0 [label="∅\nR · min\nroot\nMISSING (min)", shape=box, style="filled,rounded", fillcolor="#a1d99b", color="#e31a1c", penwidth=3, peripheries=2, tooltip="∅ — R\nin sub-cube S1, S2, S3\nwalk: root"];
  m1 [label="(a-prop X)\nR\nentered alive", shape=box, style="filled,rounded", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(a-prop X)} — R\nin sub-cube S1, S2\nwalk: entered alive"];
  m2 [label="(b-prop X)\nR\nentered alive", shape=box, style="filled,rounded", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(b-prop X)} — R\nin sub-cube S1, S3\nwalk: entered alive"];
  m4 [label="(c-prop X)\nR\nentered alive", shape=box, style="filled,rounded", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(c-prop X)} — R\nin sub-cube S2, S3\nwalk: entered alive"];
  m3 [label="(a-prop X)\n(b-prop X)\nR · max\nrecorded model\nSPURIOUS (not min)", shape=octagon, style="filled", fillcolor="#a1d99b", color="#ae017e", penwidth=3, tooltip="{(a-prop X), (b-prop X)} — R\nin sub-cube S1\nwalk: recorded model"];
  m5 [label="(a-prop X)\n(c-prop X)\nR · max\nrecorded model\nSPURIOUS (not min)", shape=octagon, style="filled", fillcolor="#a1d99b", color="#ae017e", penwidth=3, tooltip="{(a-prop X), (c-prop X)} — R\nin sub-cube S2\nwalk: recorded model"];
  m6 [label="(b-prop X)\n(c-prop X)\nR · max\nrecorded model\nSPURIOUS (not min)", shape=octagon, style="filled", fillcolor="#a1d99b", color="#ae017e", penwidth=3, tooltip="{(b-prop X), (c-prop X)} — R\nin sub-cube S3\nwalk: recorded model"];
  m7 [label="(a-prop X)\n(b-prop X)\n(c-prop X)\ndead\nnever generated", shape=ellipse, style="filled", fillcolor="#fcbba1", color="#525252", penwidth=1, tooltip="{(a-prop X), (b-prop X), (c-prop X)} — dead\ncore: (a-prop X) (b-prop X) (c-prop X)\nrefuted by: three-conflict\n1 derived facts are not coordinates (0 over a candidate relation)\nwalk: never generated\n  no join proposed it"];
  { rank=same; L0; m0 }
  { rank=same; L1; m1; m2; m4 }
  { rank=same; L2; m3; m5; m6 }
  { rank=same; L3; m7 }
  m0 -> m1 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (a-prop X) → {(a-prop X)}: R → R"];
  m0 -> m2 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (b-prop X) → {(b-prop X)}: R → R"];
  m0 -> m4 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (c-prop X) → {(c-prop X)}: R → R"];
  m1 -> m3 [color="#238b45", style=solid, penwidth=2, tooltip="{(a-prop X)} + (b-prop X) → {(a-prop X), (b-prop X)}: R → R"];
  m1 -> m5 [color="#238b45", style=solid, penwidth=2, tooltip="{(a-prop X)} + (c-prop X) → {(a-prop X), (c-prop X)}: R → R"];
  m2 -> m3 [color="#238b45", style=solid, penwidth=2, tooltip="{(b-prop X)} + (a-prop X) → {(a-prop X), (b-prop X)}: R → R"];
  m2 -> m6 [color="#238b45", style=solid, penwidth=2, tooltip="{(b-prop X)} + (c-prop X) → {(b-prop X), (c-prop X)}: R → R"];
  m4 -> m5 [color="#238b45", style=solid, penwidth=2, tooltip="{(c-prop X)} + (a-prop X) → {(a-prop X), (c-prop X)}: R → R"];
  m4 -> m6 [color="#238b45", style=solid, penwidth=2, tooltip="{(c-prop X)} + (b-prop X) → {(b-prop X), (c-prop X)}: R → R"];
  m3 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(a-prop X), (b-prop X)} + (c-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  m5 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(a-prop X), (c-prop X)} + (b-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  m6 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(b-prop X), (c-prop X)} + (a-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD ALIGN="LEFT"><B>legend</B> — fill: the cube · shape: the search · border: the lines and the defects</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#a1d99b"> </TD><TD ALIGN="LEFT">R: alive and discharged (one colour per component)</TD></TR><TR><TD BGCOLOR="#fee391"> </TD><TD ALIGN="LEFT">owing: alive, an obligation unwitnessed</TD></TR><TR><TD BGCOLOR="#fcbba1"> </TD><TD ALIGN="LEFT">dead: derives (false); dead+owing is both</TD></TR><TR><TD ALIGN="LEFT"><I>dashed outline</I></TD><TD ALIGN="LEFT">transient: saturation moves it (its sat arrow); it is the state it lands on</TD></TR><TR><TD ALIGN="LEFT"><I>octagon</I></TD><TD ALIGN="LEFT">the run recorded this node's state (model or open)</TD></TR><TR><TD ALIGN="LEFT"><I>rounded box</I></TD><TD ALIGN="LEFT">the search stood here (root, an entering), or reached it by saturation</TD></TR><TR><TD ALIGN="LEFT"><I>ellipse</I></TD><TD ALIGN="LEFT">the search never stood here; why is under the facts</TD></TR><TR><TD ALIGN="LEFT"><I>double border</I></TD><TD ALIGN="LEFT">R's minimal line</TD></TR><TR><TD ALIGN="LEFT"><I>heavy green border</I></TD><TD ALIGN="LEFT">R's maximal line</TD></TR><TR><TD ALIGN="LEFT"><I>purple border</I></TD><TD ALIGN="LEFT">a hole: outside R, between two members</TD></TR><TR><TD ALIGN="LEFT"><I>red border</I></TD><TD ALIGN="LEFT">MISSING: on a line, and no recorded model is its state</TD></TR><TR><TD ALIGN="LEFT"><I>magenta border</I></TD><TD ALIGN="LEFT">SPURIOUS, an unsound exclusion, or the search against the cube</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#238b45"><B>━━</B></FONT> R → R <I>solid</I></TD><TD ALIGN="LEFT">inside R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fd8d3c"><B>━━</B></FONT> R → owing <I>dashed</I></TD><TD ALIGN="LEFT">adding the fact adds a debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> R → dead <I>solid</I></TD><TD ALIGN="LEFT">adding the fact kills</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2171b5"><B>━━</B></FONT> owing → R <I>solid</I></TD><TD ALIGN="LEFT">adding the fact pays the last debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fdae6b"><B>━━</B></FONT> owing → owing <I>solid</I></TD><TD ALIGN="LEFT">still owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> owing → dead <I>dashed</I></TD><TD ALIGN="LEFT">kills an owing node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → R <I>bold</I></TD><TD ALIGN="LEFT">revives a dead node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → owing <I>dashed</I></TD><TD ALIGN="LEFT">revives a dead node, owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bdbdbd"><B>━━</B></FONT> dead → dead <I>solid</I></TD><TD ALIGN="LEFT">dead to dead</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>┈┈</B></FONT> absorbed <I>dotted</I></TD><TD ALIGN="LEFT">adds a fact saturation already derived: no move</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#08519c"><B>━▶</B></FONT> sat</TD><TD ALIGN="LEFT">C ⇒ cl(C): the candidates sat(root + C) holds</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">lines compared: both — which line is the answer is S1e2.1a.3's ruling (a)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal line (1): ∅ — missing ∅; spurious {(a-prop X), (b-prop X)}, {(a-prop X), (c-prop X)}, {(b-prop X),<BR ALIGN="LEFT"/>(c-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maximal line (3): {(a-prop X), (b-prop X)}, {(a-prop X), (c-prop X)}, {(b-prop X), (c-prop X)} — missing none;<BR ALIGN="LEFT"/>spurious none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S1 [∅ … {(a-prop X), (b-prop X)}], dimension 2, free {(a-prop X), (b-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S2 [∅ … {(a-prop X), (c-prop X)}], dimension 2, free {(a-prop X), (c-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S3 [∅ … {(b-prop X), (c-prop X)}], dimension 2, free {(b-prop X), (c-prop X)}<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  { rank=sink; legend; }
  L3 -> legend [style=invis];
}
