digraph region {
  // ein render region — view full
  graph [rankdir=TB, labelloc=t, fontsize=12, nodesep=0.25, ranksep=0.6, newrank=true, label="region · examples/lattice/02_genuine_3set_death.ein\nn = 3 · |R| = 7 of 8 · monotone\nrun: all of R — 7 states reported, exhausted · 8 nodes visited · view full (8 of 8 nodes)"];
  node [fontsize=10, fontname="Helvetica"];
  edge [arrowsize=0.6];
  L0 [shape=plaintext, fontsize=9, label="L0 · 1"];
  L1 [shape=plaintext, fontsize=9, label="L1 · 3"];
  L2 [shape=plaintext, fontsize=9, label="L2 · 3"];
  L3 [shape=plaintext, fontsize=9, label="L3 · 1"];
  L0 -> L1 [style=invis];
  L1 -> L2 [style=invis];
  L2 -> L3 [style=invis];
  m0 [label="∅\nR · min\nstate 1", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=1.5, peripheries=2, tooltip="∅ — R\nin sub-cube S1, S2, S3\nrun: state 1\n  visited, read in-r"];
  m1 [label="(a-prop X)\nR\nstate 2", shape=octagon, style="filled", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(a-prop X)} — R\nin sub-cube S1, S2\nrun: state 2\n  visited, read in-r"];
  m2 [label="(b-prop X)\nR\nstate 3", shape=octagon, style="filled", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(b-prop X)} — R\nin sub-cube S1, S3\nrun: state 3\n  visited, read in-r"];
  m4 [label="(c-prop X)\nR\nstate 4", shape=octagon, style="filled", fillcolor="#a1d99b", color="#525252", penwidth=1, tooltip="{(c-prop X)} — R\nin sub-cube S2, S3\nrun: state 4\n  visited, read in-r"];
  m3 [label="(a-prop X)\n(b-prop X)\nR · max\nstate 5", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=3, tooltip="{(a-prop X), (b-prop X)} — R\nin sub-cube S1\nrun: state 5\n  visited, read in-r"];
  m5 [label="(a-prop X)\n(c-prop X)\nR · max\nstate 6", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=3, tooltip="{(a-prop X), (c-prop X)} — R\nin sub-cube S2\nrun: state 6\n  visited, read in-r"];
  m6 [label="(b-prop X)\n(c-prop X)\nR · max\nstate 7", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=3, tooltip="{(b-prop X), (c-prop X)} — R\nin sub-cube S3\nrun: state 7\n  visited, read in-r"];
  m7 [label="(a-prop X)\n(b-prop X)\n(c-prop X)\ndead\nvisited", shape=box, style="filled,rounded", fillcolor="#fcbba1", color="#525252", penwidth=1, tooltip="{(a-prop X), (b-prop X), (c-prop X)} — dead\ncore: (a-prop X) (b-prop X) (c-prop X)\nrefuted by: three-conflict\n1 derived facts are not coordinates (0 over a candidate relation)\nrun: visited\n  visited, read dead"];
  { rank=same; L0; m0 }
  { rank=same; L1; m1; m2; m4 }
  { rank=same; L2; m3; m5; m6 }
  { rank=same; L3; m7 }
  m0 -> m1 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (a-prop X) → {(a-prop X)}: R → R"];
  m0 -> m2 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (b-prop X) → {(b-prop X)}: R → R"];
  m0 -> m4 [color="#238b45", style=solid, penwidth=2, tooltip="∅ + (c-prop X) → {(c-prop X)}: R → R"];
  m1 -> m3 [color="#238b45", style=solid, penwidth=2, tooltip="{(a-prop X)} + (b-prop X) → {(a-prop X), (b-prop X)}: R → R"];
  m1 -> m5 [color="#238b45", style=solid, penwidth=2, tooltip="{(a-prop X)} + (c-prop X) → {(a-prop X), (c-prop X)}: R → R"];
  m2 -> m3 [color="#238b45", style=solid, penwidth=2, tooltip="{(b-prop X)} + (a-prop X) → {(a-prop X), (b-prop X)}: R → R"];
  m2 -> m6 [color="#238b45", style=solid, penwidth=2, tooltip="{(b-prop X)} + (c-prop X) → {(b-prop X), (c-prop X)}: R → R"];
  m4 -> m5 [color="#238b45", style=solid, penwidth=2, tooltip="{(c-prop X)} + (a-prop X) → {(a-prop X), (c-prop X)}: R → R"];
  m4 -> m6 [color="#238b45", style=solid, penwidth=2, tooltip="{(c-prop X)} + (b-prop X) → {(b-prop X), (c-prop X)}: R → R"];
  m3 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(a-prop X), (b-prop X)} + (c-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  m5 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(a-prop X), (c-prop X)} + (b-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  m6 -> m7 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(b-prop X), (c-prop X)} + (a-prop X) → {(a-prop X), (b-prop X), (c-prop X)}: R → dead"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD ALIGN="LEFT"><B>legend</B> — fill: the cube · shape: the run · border: the lines and the defects</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#a1d99b"> </TD><TD ALIGN="LEFT">R: alive and discharged (one colour per component)</TD></TR><TR><TD BGCOLOR="#fee391"> </TD><TD ALIGN="LEFT">owing: alive, an obligation unwitnessed</TD></TR><TR><TD BGCOLOR="#fcbba1"> </TD><TD ALIGN="LEFT">dead: derives (false); dead+owing is both</TD></TR><TR><TD ALIGN="LEFT"><I>dashed outline</I></TD><TD ALIGN="LEFT">transient: saturation moves it (its sat arrow); it is the state it lands on</TD></TR><TR><TD ALIGN="LEFT"><I>octagon</I></TD><TD ALIGN="LEFT">a state the run reported, or a node of an empty R's owing frontier</TD></TR><TR><TD ALIGN="LEFT"><I>rounded box</I></TD><TD ALIGN="LEFT">a node the run visited</TD></TR><TR><TD ALIGN="LEFT"><I>ellipse</I></TD><TD ALIGN="LEFT">a node the run did not visit; why is under the facts</TD></TR><TR><TD ALIGN="LEFT"><I>double border</I></TD><TD ALIGN="LEFT">R's minimal line</TD></TR><TR><TD ALIGN="LEFT"><I>heavy green border</I></TD><TD ALIGN="LEFT">R's maximal line</TD></TR><TR><TD ALIGN="LEFT"><I>purple border</I></TD><TD ALIGN="LEFT">a hole: outside R, between two members</TD></TR><TR><TD ALIGN="LEFT"><I>red border</I></TD><TD ALIGN="LEFT">MISSING: in the part of R the run asked, no reported state is its state, and the run says it is complete</TD></TR><TR><TD ALIGN="LEFT"><I>orange border</I></TD><TD ALIGN="LEFT">not reached: the same, on a run that stopped (a bound, not a defect)</TD></TR><TR><TD ALIGN="LEFT"><I>magenta border</I></TD><TD ALIGN="LEFT">SPURIOUS (a reported state outside the part asked), the run's reading against the cube's, or an unsound exclusion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#238b45"><B>━━</B></FONT> R → R <I>solid</I></TD><TD ALIGN="LEFT">inside R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fd8d3c"><B>━━</B></FONT> R → owing <I>dashed</I></TD><TD ALIGN="LEFT">adding the fact adds a debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> R → dead <I>solid</I></TD><TD ALIGN="LEFT">adding the fact kills</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2171b5"><B>━━</B></FONT> owing → R <I>solid</I></TD><TD ALIGN="LEFT">adding the fact pays the last debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fdae6b"><B>━━</B></FONT> owing → owing <I>solid</I></TD><TD ALIGN="LEFT">still owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> owing → dead <I>dashed</I></TD><TD ALIGN="LEFT">kills an owing node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → R <I>bold</I></TD><TD ALIGN="LEFT">revives a dead node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → owing <I>dashed</I></TD><TD ALIGN="LEFT">revives a dead node, owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bdbdbd"><B>━━</B></FONT> dead → dead <I>solid</I></TD><TD ALIGN="LEFT">dead to dead</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>┈┈</B></FONT> absorbed <I>dotted</I></TD><TD ALIGN="LEFT">adds a fact saturation already derived: no move</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#08519c"><B>━▶</B></FONT> sat</TD><TD ALIGN="LEFT">C ⇒ cl(C): the candidates sat(root + C) holds</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">compared with R, by state — ruling (a): the answer is R, and a run answers the part of it its question asked<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">missing none; spurious none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal line (1): ∅<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maximal line (3): {(a-prop X), (b-prop X)}, {(a-prop X), (c-prop X)}, {(b-prop X), (c-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S1 [∅ … {(a-prop X), (b-prop X)}], dimension 2, free {(a-prop X), (b-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S2 [∅ … {(a-prop X), (c-prop X)}], dimension 2, free {(a-prop X), (c-prop X)}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S3 [∅ … {(b-prop X), (c-prop X)}], dimension 2, free {(b-prop X), (c-prop X)}<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  { rank=sink; legend; }
  L3 -> legend [style=invis];
}
