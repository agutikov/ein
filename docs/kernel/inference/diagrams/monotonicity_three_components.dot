digraph region {
  // ein render region — view lines
  graph [rankdir=TB, labelloc=t, fontsize=12, nodesep=0.25, ranksep=0.6, newrank=true, label="region · examples/lattice/synth/three_components.ein\nn = 7 · |R| = 13 of 128 · NOT monotone (2 sites)\nrun: all of R — 13 states reported, exhausted · 128 nodes visited · view lines (10 of 128 nodes)"];
  node [fontsize=10, fontname="Helvetica"];
  edge [arrowsize=0.6];
  L0 [shape=plaintext, fontsize=9, label="L0 · 1"];
  L1 [shape=plaintext, fontsize=9, label="L1 · 7\n3 drawn\nhidden: 0 R, 4 owing, 0 dead"];
  L2 [shape=plaintext, fontsize=9, label="L2 · 21\n2 drawn\nhidden: 5 R, 6 owing, 8 dead"];
  L3 [shape=plaintext, fontsize=9, label="L3 · 35\n3 drawn\nhidden: 2 R, 4 owing, 26 dead"];
  L4 [shape=plaintext, fontsize=9, label="L4 · 35\n1 drawn\nhidden: 0 R, 1 owing, 33 dead"];
  L5 [shape=plaintext, fontsize=9, label="L5–L7 · 29\n0 drawn\nhidden: 0 R, 0 owing, 29 dead"];
  L0 -> L1 [style=invis];
  L1 -> L2 [style=invis];
  L2 -> L3 [style=invis];
  L3 -> L4 [style=invis];
  L4 -> L5 [style=invis];
  m0 [label="∅\nowing 1\nvisited", shape=box, style="filled,rounded", fillcolor="#fee391", color="#525252", penwidth=1, tooltip="∅ — owing\nowes: from the start: one of C F G is required\nrun: visited\n  visited, read owing"];
  m4 [label="(h C)\nR · min\nstate 1", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=1.5, peripheries=2, tooltip="{(h C)} — R\nin sub-cube S1\nrun: state 1\n  visited, read in-r"];
  m32 [label="(h F)\nR · min\nstate 2", shape=octagon, style="filled", fillcolor="#9ecae1", color="#006d2c", penwidth=1.5, peripheries=2, tooltip="{(h F)} — R\nin sub-cube S2\nrun: state 2\n  visited, read in-r"];
  m64 [label="(h G)\nR · min\nstate 3", shape=octagon, style="filled", fillcolor="#bcbddc", color="#006d2c", penwidth=1.5, peripheries=2, tooltip="{(h G)} — R\nin sub-cube S4\nrun: state 3\n  visited, read in-r"];
  m33 [label="(h A)\n(h F)\ndead · hole\nvisited", shape=box, style="filled,rounded", fillcolor="#fcbba1", color="#6a3d9a", penwidth=2.5, tooltip="{(h A), (h F)} — dead\ncore: (h A) (h F)\nrefuted by: dead-3\nrests on: (absent (h B))\n1 derived facts are not coordinates (0 over a candidate relation)\nrun: visited\n  visited, read dead"];
  m65 [label="(h A)\n(h G)\ndead · hole\nvisited", shape=box, style="filled,rounded", fillcolor="#fcbba1", color="#6a3d9a", penwidth=2.5, tooltip="{(h A), (h G)} — dead\ncore: (h A) (h G)\nrefuted by: dead-7\nrests on: (absent (h D))\n1 derived facts are not coordinates (0 over a candidate relation)\nrun: visited\n  visited, read dead"];
  m28 [label="(h C)\n(h D)\n(h E)\nR · max\nstate 12", shape=octagon, style="filled", fillcolor="#a1d99b", color="#006d2c", penwidth=3, tooltip="{(h C), (h D), (h E)} — R\nin sub-cube S1\nrun: state 12\n  visited, read in-r"];
  m35 [label="(h A)\n(h B)\n(h F)\nR · max\nstate 9", shape=octagon, style="filled", fillcolor="#9ecae1", color="#006d2c", penwidth=3, tooltip="{(h A), (h B), (h F)} — R\nin sub-cube S3\nrun: state 9\n  visited, read in-r"];
  m67 [label="(h A)\n(h B)\n(h G)\ndead · hole\nvisited", shape=box, style="filled,rounded", fillcolor="#fcbba1", color="#6a3d9a", penwidth=2.5, tooltip="{(h A), (h B), (h G)} — dead\ncore: (h A) (h G)\nrefuted by: dead-7\nrests on: (absent (h D))\n1 derived facts are not coordinates (0 over a candidate relation)\nrun: visited\n  visited, read dead"];
  m75 [label="(h A)\n(h B)\n(h D)\n(h G)\nR · max\nstate 13", shape=octagon, style="filled", fillcolor="#bcbddc", color="#006d2c", penwidth=3, tooltip="{(h A), (h B), (h D), (h G)} — R\nin sub-cube S5\nrun: state 13\n  visited, read in-r"];
  { rank=same; L0; m0 }
  { rank=same; L1; m4; m32; m64 }
  { rank=same; L2; m33; m65 }
  { rank=same; L3; m28; m35; m67 }
  { rank=same; L4; m75 }
  m0 -> m4 [color="#2171b5", style=solid, penwidth=2, tooltip="∅ + (h C) → {(h C)}: owing → R"];
  m0 -> m32 [color="#2171b5", style=solid, penwidth=2, tooltip="∅ + (h F) → {(h F)}: owing → R"];
  m0 -> m64 [color="#2171b5", style=solid, penwidth=2, tooltip="∅ + (h G) → {(h G)}: owing → R"];
  m4 -> m28 [color="#969696", style=dashed, label="+2", fontsize=8, fontcolor="#636363", tooltip="{(h C)} ⊂ {(h C), (h D), (h E)}"];
  m32 -> m33 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h F)} + (h A) → {(h A), (h F)}: R → dead"];
  m64 -> m65 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h G)} + (h A) → {(h A), (h G)}: R → dead"];
  m33 -> m35 [color="#ae017e", style=bold, penwidth=2.5, label="+(h B)", fontcolor="#6a3d9a", fontsize=9, tooltip="{(h A), (h F)} + (h B) → {(h A), (h B), (h F)}: dead → R"];
  m65 -> m67 [color="#bdbdbd", style=solid, penwidth=0.6, tooltip="{(h A), (h G)} + (h B) → {(h A), (h B), (h G)}: dead → dead"];
  m67 -> m75 [color="#ae017e", style=bold, penwidth=2.5, label="+(h D)", fontcolor="#6a3d9a", fontsize=9, tooltip="{(h A), (h B), (h G)} + (h D) → {(h A), (h B), (h D), (h G)}: dead → R"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD ALIGN="LEFT"><B>legend</B> — fill: the cube · shape: the run · border: the lines and the defects</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#a1d99b"> </TD><TD ALIGN="LEFT">R: alive and discharged (one colour per component)</TD></TR><TR><TD BGCOLOR="#fee391"> </TD><TD ALIGN="LEFT">owing: alive, an obligation unwitnessed</TD></TR><TR><TD BGCOLOR="#fcbba1"> </TD><TD ALIGN="LEFT">dead: derives (false); dead+owing is both</TD></TR><TR><TD ALIGN="LEFT"><I>dashed outline</I></TD><TD ALIGN="LEFT">transient: saturation moves it (its sat arrow); it is the state it lands on</TD></TR><TR><TD ALIGN="LEFT"><I>octagon</I></TD><TD ALIGN="LEFT">a state the run reported, or a node of an empty R's owing frontier</TD></TR><TR><TD ALIGN="LEFT"><I>rounded box</I></TD><TD ALIGN="LEFT">a node the run visited</TD></TR><TR><TD ALIGN="LEFT"><I>ellipse</I></TD><TD ALIGN="LEFT">a node the run did not visit; why is under the facts</TD></TR><TR><TD ALIGN="LEFT"><I>double border</I></TD><TD ALIGN="LEFT">R's minimal line</TD></TR><TR><TD ALIGN="LEFT"><I>heavy green border</I></TD><TD ALIGN="LEFT">R's maximal line</TD></TR><TR><TD ALIGN="LEFT"><I>purple border</I></TD><TD ALIGN="LEFT">a hole: outside R, between two members</TD></TR><TR><TD ALIGN="LEFT"><I>red border</I></TD><TD ALIGN="LEFT">MISSING: in the part of R the run asked, no reported state is its state, and the run says it is complete</TD></TR><TR><TD ALIGN="LEFT"><I>orange border</I></TD><TD ALIGN="LEFT">not reached: the same, on a run that stopped (a bound, not a defect)</TD></TR><TR><TD ALIGN="LEFT"><I>magenta border</I></TD><TD ALIGN="LEFT">SPURIOUS (a reported state outside the part asked), the run's reading against the cube's, or an unsound exclusion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#238b45"><B>━━</B></FONT> R → R <I>solid</I></TD><TD ALIGN="LEFT">inside R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fd8d3c"><B>━━</B></FONT> R → owing <I>dashed</I></TD><TD ALIGN="LEFT">adding the fact adds a debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> R → dead <I>solid</I></TD><TD ALIGN="LEFT">adding the fact kills</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2171b5"><B>━━</B></FONT> owing → R <I>solid</I></TD><TD ALIGN="LEFT">adding the fact pays the last debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fdae6b"><B>━━</B></FONT> owing → owing <I>solid</I></TD><TD ALIGN="LEFT">still owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> owing → dead <I>dashed</I></TD><TD ALIGN="LEFT">kills an owing node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → R <I>bold</I></TD><TD ALIGN="LEFT">revives a dead node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → owing <I>dashed</I></TD><TD ALIGN="LEFT">revives a dead node, owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bdbdbd"><B>━━</B></FONT> dead → dead <I>solid</I></TD><TD ALIGN="LEFT">dead to dead</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>┈┈</B></FONT> absorbed <I>dotted</I></TD><TD ALIGN="LEFT">adds a fact saturation already derived: no move</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#08519c"><B>━▶</B></FONT> sat</TD><TD ALIGN="LEFT">C ⇒ cl(C): the candidates sat(root + C) holds</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6a3d9a">+fact</FONT></TD><TD ALIGN="LEFT">a repair edge: the fact that takes a hole back into R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>╌╌</B></FONT> +k</TD><TD ALIGN="LEFT">inclusion across k facts, the nodes between hidden</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">compared with R, by state — ruling (a): the answer is R, and a run answers the part of it its question asked<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">missing none; spurious none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal line (3): {#2}, {#5}, {#6}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maximal line (3): {#2 #3 #4}, {#0 #1 #5}, {#0 #1 #3 #6}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S1 [{#2} … {#2 #3 #4}], dimension 2, free {#3 #4}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S2 [{#5} … {#1 #5}], dimension 1, free {#1}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S3 [{#1 #5} … {#0 #1 #5}], dimension 1, free {#0}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S4 [{#6} … {#1 #3 #6}], dimension 2, free {#1 #3}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S5 [{#3 #6} … {#0 #1 #3 #6}], dimension 2, free {#0 #1}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal hole {#0 #5}: its absent guard (absent (h B))<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal hole {#0 #6}: its absent guard (absent (h D))<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">not monotone — sites: dead-3 · absent · h; dead-7 · absent · h; the lines assume a monotone lattice (P1e2.1b)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#0 (h A)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#1 (h B)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#2 (h C)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#3 (h D)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#4 (h E)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#5 (h F)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#6 (h G)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  { rank=sink; legend; }
  L5 -> legend [style=invis];
}
