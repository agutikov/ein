  m19 -> m27 [color="#238b45", style=solid, penwidth=2, tooltip="{(h A), (h B), (h E)} + (h D) → {(h A), (h B), (h D), (h E)}: R → R"];
  m21 -> m23 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h A), (h C), (h E)} + (h B) → {(h A), (h B), (h C), (h E)}: dead → dead (absorbed: saturation already derived it)"];
  m21 -> m29 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h A), (h C), (h E)} + (h D) → {(h A), (h C), (h D), (h E)}: dead → dead (absorbed: saturation already derived it)"];
  m22 -> m23 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h B), (h C), (h E)} + (h A) → {(h A), (h B), (h C), (h E)}: R → dead"];
  m22 -> m30 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h B), (h C), (h E)} + (h D) → {(h B), (h C), (h D), (h E)}: R → R (absorbed: saturation already derived it)"];
  m25 -> m27 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h A), (h D), (h E)} + (h B) → {(h A), (h B), (h D), (h E)}: R → R (absorbed: saturation already derived it)"];
  m25 -> m29 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h A), (h D), (h E)} + (h C) → {(h A), (h C), (h D), (h E)}: R → dead"];
  m26 -> m27 [color="#2171b5", style=solid, penwidth=2, tooltip="{(h B), (h D), (h E)} + (h A) → {(h A), (h B), (h D), (h E)}: owing → R"];
  m26 -> m30 [color="#2171b5", style=solid, penwidth=2, tooltip="{(h B), (h D), (h E)} + (h C) → {(h B), (h C), (h D), (h E)}: owing → R"];
  m28 -> m29 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h C), (h D), (h E)} + (h A) → {(h A), (h C), (h D), (h E)}: R → dead"];
  m28 -> m30 [color="#238b45", style=solid, penwidth=2, tooltip="{(h C), (h D), (h E)} + (h B) → {(h B), (h C), (h D), (h E)}: R → R"];
  m15 -> m31 [color="#bdbdbd", style=solid, penwidth=0.6, tooltip="{(h A), (h B), (h C), (h D)} + (h E) → {(h A), (h B), (h C), (h D), (h E)}: dead → dead"];
  m23 -> m31 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h A), (h B), (h C), (h E)} + (h D) → {(h A), (h B), (h C), (h D), (h E)}: dead → dead (absorbed: saturation already derived it)"];
  m27 -> m31 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h A), (h B), (h D), (h E)} + (h C) → {(h A), (h B), (h C), (h D), (h E)}: R → dead"];
  m29 -> m31 [color="#969696", style=dotted, arrowhead=none, penwidth=0.8, tooltip="{(h A), (h C), (h D), (h E)} + (h B) → {(h A), (h B), (h C), (h D), (h E)}: dead → dead (absorbed: saturation already derived it)"];
  m30 -> m31 [color="#cb181d", style=solid, penwidth=1.2, tooltip="{(h B), (h C), (h D), (h E)} + (h A) → {(h A), (h B), (h C), (h D), (h E)}: R → dead"];
  m1 -> m3 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h A)}) holds (h B)"];
  m4 -> m12 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h C)}) holds (h D)"];
  m6 -> m14 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h B), (h C)}) holds (h D)"];
  m9 -> m11 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h A), (h D)}) holds (h B)"];
  m17 -> m19 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h A), (h E)}) holds (h B)"];
  m20 -> m28 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h C), (h E)}) holds (h D)"];
  m22 -> m30 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h B), (h C), (h E)}) holds (h D)"];
  m25 -> m27 [color="#08519c", penwidth=2.2, arrowhead=vee, constraint=false, label="sat", fontsize=8, fontcolor="#08519c", tooltip="sat(root + {(h A), (h D), (h E)}) holds (h B)"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD ALIGN="LEFT"><B>legend</B> — fill: the cube · shape: the run · border: the lines and the defects</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#a1d99b"> </TD><TD ALIGN="LEFT">R: alive and discharged (one colour per component)</TD></TR><TR><TD BGCOLOR="#fee391"> </TD><TD ALIGN="LEFT">owing: alive, an obligation unwitnessed</TD></TR><TR><TD BGCOLOR="#fcbba1"> </TD><TD ALIGN="LEFT">dead: derives (false); dead+owing is both</TD></TR><TR><TD ALIGN="LEFT"><I>dashed outline</I></TD><TD ALIGN="LEFT">transient: saturation moves it (its sat arrow); it is the state it lands on</TD></TR><TR><TD ALIGN="LEFT"><I>octagon</I></TD><TD ALIGN="LEFT">a state the run reported, or a node of an empty R's owing frontier</TD></TR><TR><TD ALIGN="LEFT"><I>rounded box</I></TD><TD ALIGN="LEFT">a node the run visited</TD></TR><TR><TD ALIGN="LEFT"><I>ellipse</I></TD><TD ALIGN="LEFT">a node the run did not visit; why is under the facts</TD></TR><TR><TD ALIGN="LEFT"><I>double border</I></TD><TD ALIGN="LEFT">R's minimal line</TD></TR><TR><TD ALIGN="LEFT"><I>heavy green border</I></TD><TD ALIGN="LEFT">R's maximal line</TD></TR><TR><TD ALIGN="LEFT"><I>purple border</I></TD><TD ALIGN="LEFT">a hole: outside R, between two members</TD></TR><TR><TD ALIGN="LEFT"><I>red border</I></TD><TD ALIGN="LEFT">MISSING: in the part of R the run asked, no reported state is its state, and the run says it is complete</TD></TR><TR><TD ALIGN="LEFT"><I>orange border</I></TD><TD ALIGN="LEFT">not reached: the same, on a run that stopped (a bound, not a defect)</TD></TR><TR><TD ALIGN="LEFT"><I>magenta border</I></TD><TD ALIGN="LEFT">SPURIOUS (a reported state outside the part asked), the run's reading against the cube's, or an unsound exclusion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#238b45"><B>━━</B></FONT> R → R <I>solid</I></TD><TD ALIGN="LEFT">inside R</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fd8d3c"><B>━━</B></FONT> R → owing <I>dashed</I></TD><TD ALIGN="LEFT">adding the fact adds a debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> R → dead <I>solid</I></TD><TD ALIGN="LEFT">adding the fact kills</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2171b5"><B>━━</B></FONT> owing → R <I>solid</I></TD><TD ALIGN="LEFT">adding the fact pays the last debt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#fdae6b"><B>━━</B></FONT> owing → owing <I>solid</I></TD><TD ALIGN="LEFT">still owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#cb181d"><B>━━</B></FONT> owing → dead <I>dashed</I></TD><TD ALIGN="LEFT">kills an owing node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → R <I>bold</I></TD><TD ALIGN="LEFT">revives a dead node</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#ae017e"><B>━━</B></FONT> dead → owing <I>dashed</I></TD><TD ALIGN="LEFT">revives a dead node, owing</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bdbdbd"><B>━━</B></FONT> dead → dead <I>solid</I></TD><TD ALIGN="LEFT">dead to dead</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#969696"><B>┈┈</B></FONT> absorbed <I>dotted</I></TD><TD ALIGN="LEFT">adds a fact saturation already derived: no move</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#08519c"><B>━▶</B></FONT> sat</TD><TD ALIGN="LEFT">C ⇒ cl(C): the candidates sat(root + C) holds</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" BALIGN="LEFT">compared with R, by state — ruling (a): the answer is R, and a run answers the part of it its question asked<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">missing none; spurious none<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">minimal line (2): {#0}, {#2}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maximal line (2): {#0 #1 #3 #4}, {#1 #2 #3 #4}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S1 [{#0} … {#0 #1 #3 #4}], dimension 3, free {#1 #3 #4}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">sub-cube S2 [{#2} … {#1 #2 #3 #4}], dimension 3, free {#1 #3 #4}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#0 (h A)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#1 (h B)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#2 (h C)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#3 (h D)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#4 (h E)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  { rank=sink; legend; }
  L5 -> legend [style=invis];
}
