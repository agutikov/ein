digraph rule_parent_is_ancestor_lhs_rhs {
  rankdir=TB;
  label="parent-is-ancestor"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "parent_L" [label="parent", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_parent_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "parent_L" -> "h1_parent_L" [xlabel="1", dir=back, color="#17becf"];
    "h1_parent_L" -> "?a_L" [xlabel="2", color="#17becf"];
    "h1_parent_L" -> "?b_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "ancestor_R" [label="ancestor", shape=box];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h2_ancestor_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "ancestor_R" -> "h2_ancestor_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h2_ancestor_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h2_ancestor_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
