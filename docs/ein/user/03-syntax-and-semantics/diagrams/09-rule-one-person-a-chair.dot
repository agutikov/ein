digraph rule_one_person_a_chair_lhs_rhs {
  rankdir=TB;
  label="one-person-a-chair"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "seat_L" [label="seat", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "h1_seat_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "seat_L" -> "h1_seat_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_seat_L" -> "?p_L" [xlabel="2", color="#ff7f0e"];
    "h1_seat_L" -> "?c_L" [xlabel="3", color="#ff7f0e"];
    "h2_seat_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "seat_L" -> "h2_seat_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h2_seat_L" -> "?q_L" [xlabel="2", color="#ff7f0e"];
    "h2_seat_L" -> "?c_L" [xlabel="3", color="#ff7f0e"];
    "?p_L" -> "?q_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h3_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h3_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
