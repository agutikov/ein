digraph rule_cat_not_in_b2_lhs_rhs {
  rankdir=TB;
  label="cat-not-in-b2"; labelloc=t;
  subgraph cluster_lhs { label="match";
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "in_R" [label="in", shape=box];
    "Cat_R" [label="Cat", shape=box];
    "B2_R" [label="B2", shape=box];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
