digraph rule_total_owed_lhs_rhs {
  rankdir=TB;
  label="total-owed"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "relation_L" [label="relation", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "h1_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "relation_L" -> "h1_relation_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h1_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h1_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h2_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h2_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h2_isa_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "?b_L" [label="?b", shape=diamond];
      "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "?isa_L" -> "h3_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
      "h3_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
      "h3_isa_L" -> "?B_L" [xlabel="3", color="#bcbd22"];
      "h4_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "?R_L" -> "h4_R_L" [xlabel="1", dir=back, color="#1f77b4"];
      "h4_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
      "h4_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "open_R" [label="open", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "h5_open_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "open_R" -> "h5_open_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h5_open_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
  }
}
