    "has-cat_L" [label="has-cat", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "has-dog_L" [label="has-dog", shape=box];
    "h1_has-cat_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
