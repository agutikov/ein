digraph rule_transitive_lhs_rhs {
  rankdir=TB;
  label="transitive"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?rel_L" [label="?rel", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "h1_rel_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_rel_L" -> "?rel_L" [xlabel="1", color="#2ca02c"];
    "h1_rel_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "h1_rel_L" -> "?b_L" [xlabel="3", color="#2ca02c"];
    "h2_rel_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h2_rel_L" -> "?rel_L" [xlabel="1", color="#2ca02c"];
    "h2_rel_L" -> "?b_L" [xlabel="2", color="#2ca02c"];
    "h2_rel_L" -> "?c_L" [xlabel="3", color="#2ca02c"];
    "?a_L" -> "?c_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "?rel_R" [label="?rel", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "h3_rel_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h3_rel_R" -> "?rel_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h3_rel_R" -> "?a_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h3_rel_R" -> "?c_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
