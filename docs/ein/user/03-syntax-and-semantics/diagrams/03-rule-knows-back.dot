digraph rule_knows_back_lhs_rhs {
  rankdir=TB;
  label="knows-back"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "knows_L" [label="knows", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_knows_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "h1_knows_L" -> "knows_L" [xlabel="1", color="#17becf"];
    "h1_knows_L" -> "?a_L" [xlabel="2", color="#17becf"];
    "h1_knows_L" -> "?b_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "knows_R" [label="knows", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "h2_knows_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_knows_R" -> "knows_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_knows_R" -> "?b_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_knows_R" -> "?a_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
