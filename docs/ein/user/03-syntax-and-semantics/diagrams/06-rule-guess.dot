digraph rule_guess_lhs_rhs {
  rankdir=TB;
  label="guess"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "is-a_L" [label="is-a", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "Pet_L" [label="Pet", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "Box_L" [label="Box", shape=box];
    "h1_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "is-a_L" -> "h1_is-a_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_is-a_L" -> "?p_L" [xlabel="2", color="#7f7f7f"];
    "h1_is-a_L" -> "Pet_L" [xlabel="3", color="#7f7f7f"];
    "h2_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "is-a_L" -> "h2_is-a_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h2_is-a_L" -> "?b_L" [xlabel="2", color="#7f7f7f"];
    "h2_is-a_L" -> "Box_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "in_R" [label="in", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h3_in_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "in_R" -> "h3_in_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h3_in_R" -> "?p_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h3_in_R" -> "?b_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
}
