digraph rule_in_a_context {
  rankdir=TB; nodesep=0.45; ranksep=0.7; forcelabels=true;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  "claims"; "knows";
  node [shape=diamond];
  "?who"; "?a"; "?b";
  q [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9", xlabel="q"];
  c [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style="filled,dashed", fillcolor="#d9d9d9", xlabel="c"];
  subgraph cluster_ctx_claims { label="claims ctx"; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
    u [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="u"];
    v [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=dashed, xlabel="v"];
  }
  "claims" -> q [label="1", dir=back];
  q -> "?who" [label="2"];
  q -> u [label="3"];
  "knows" -> u [label="1", dir=back];
  u -> "?a" [label="2"];
  u -> "?b" [label="3"];
  "claims" -> c [label="1", dir=back, style=dashed];
  c -> "?who" [label="2", style=dashed];
  c -> v [label="3", style=dashed];
  "knows" -> v [label="1", dir=back, style=dashed];
  v -> "?b" [label="2", style=dashed];
  v -> "?a" [label="3", style=dashed];
}
