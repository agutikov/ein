digraph open_facts {
  rankdir=TB; nodesep=0.45; ranksep=0.6; forcelabels=true;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  "open"; "seat";
  h  [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, xlabel="g"];
  o1 [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=dashed, xlabel="d"];
  o2 [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=dashed, xlabel="h1"];
  o3 [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=dashed, xlabel="h2"];
  subgraph cluster_ctx_open { label="open ctx"; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
    p1 [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="f1"];
    p2 [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="f2"];
  }
  "open" -> o1 [label="1", dir=back, style=dashed];
  o1 -> "seat" [label="2", style=dashed];
  "open" -> o2 [label="1", dir=back, style=dashed];
  o2 -> p1 [label="2", style=dashed];
  "open" -> o3 [label="1", dir=back, style=dashed];
  o3 -> p2 [label="2", style=dashed];
  "seat" -> h [label="1", dir=back];
  h -> "Ann" [label="2"];
  h -> "C2" [label="3"];
  "seat" -> p1 [label="1", dir=back];
  p1 -> "Bob" [label="2"];
  p1 -> "C1" [label="3"];
  "seat" -> p2 [label="1", dir=back];
  p2 -> "Bob" [label="2"];
  p2 -> "C2" [label="3"];
}
