digraph rule_chores_lhs_rhs {
  rankdir=TB;
  label="chores"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "housemates_L" [label="housemates", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_housemates_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "housemates_L" -> "h1_housemates_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_housemates_L" -> "?a_L" [xlabel="2", color="#7f7f7f"];
    "h1_housemates_L" -> "?b_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "shares-chores_R" [label="shares-chores", shape=box];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h2_shares-chores_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "shares-chores_R" -> "h2_shares-chores_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_shares-chores_R" -> "?a_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_shares-chores_R" -> "?b_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
