digraph rule_chain_lhs_rhs {
  rankdir=TB;
  label="chain"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?r_L" [label="?r", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "h1_r_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "h1_r_L" -> "?r_L" [xlabel="1", color="#ff7f0e"];
    "h1_r_L" -> "?a_L" [xlabel="2", color="#ff7f0e"];
    "h1_r_L" -> "?b_L" [xlabel="3", color="#ff7f0e"];
    "h2_r_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "h2_r_L" -> "?r_L" [xlabel="1", color="#ff7f0e"];
    "h2_r_L" -> "?b_L" [xlabel="2", color="#ff7f0e"];
    "h2_r_L" -> "?c_L" [xlabel="3", color="#ff7f0e"];
    "?a_L" -> "?c_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "?r_R" [label="?r", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "h3_r_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "h3_r_R" -> "?r_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "h3_r_R" -> "?a_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "h3_r_R" -> "?c_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}
