digraph rule_bag_is_ready_lhs_rhs {
  rankdir=TB;
  label="bag-is-ready"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "is-a_L" [label="is-a", shape=box];
    "?bag_L" [label="?bag", shape=diamond];
    "Bag_L" [label="Bag", shape=box];
    "forall_L" [label="forall", shape=box];
    "?i_L" [label="?i", shape=diamond];
    "goes-in_L" [label="goes-in", shape=box];
    "packed_L" [label="packed", shape=box];
    subgraph cluster_ctx_L_0 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(goes-in ?i ?bag)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
      "(packed ?i)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    }
    "h1_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "is-a_L" -> "h1_is-a_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_is-a_L" -> "?bag_L" [xlabel="2", color="#7f7f7f"];
    "h1_is-a_L" -> "Bag_L" [xlabel="3", color="#7f7f7f"];
    "h2_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "forall_L" -> "h2_forall_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h2_forall_L" -> "?i_L" [xlabel="2", color="#1f77b4"];
    "h2_forall_L" -> "(goes-in ?i ?bag)_L" [xlabel="3", color="#1f77b4"];
    "h2_forall_L" -> "(packed ?i)_L" [xlabel="4", color="#1f77b4"];
    "goes-in_L" -> "(goes-in ?i ?bag)_L" [xlabel="1", dir=back, color="#17becf"];
    "(goes-in ?i ?bag)_L" -> "?i_L" [xlabel="2", color="#17becf"];
    "(goes-in ?i ?bag)_L" -> "?bag_L" [xlabel="3", color="#17becf"];
    "packed_L" -> "(packed ?i)_L" [xlabel="1", dir=back, color="#8c564b"];
    "(packed ?i)_L" -> "?i_L" [xlabel="2", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "ready_R" [label="ready", shape=box];
    "?bag_R" [label="?bag", shape=diamond];
    "h3_ready_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "ready_R" -> "h3_ready_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h3_ready_R" -> "?bag_R" [xlabel="2", color="#7f7f7f", style=dashed];
  }
}
