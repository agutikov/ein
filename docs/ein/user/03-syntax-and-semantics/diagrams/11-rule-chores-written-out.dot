digraph rule_chores_lhs_rhs {
  rankdir=TB;
  label="chores"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "lives-in_L" [label="lives-in", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?h_L" [label="?h", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_lives-in_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_lives-in_L" -> "lives-in_L" [xlabel="1", color="#9467bd"];
    "h1_lives-in_L" -> "?a_L" [xlabel="2", color="#9467bd"];
    "h1_lives-in_L" -> "?h_L" [xlabel="3", color="#9467bd"];
    "h2_lives-in_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h2_lives-in_L" -> "lives-in_L" [xlabel="1", color="#9467bd"];
    "h2_lives-in_L" -> "?b_L" [xlabel="2", color="#9467bd"];
    "h2_lives-in_L" -> "?h_L" [xlabel="3", color="#9467bd"];
    "?a_L" -> "?b_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "shares-chores_R" [label="shares-chores", shape=box];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h3_shares-chores_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h3_shares-chores_R" -> "shares-chores_R" [xlabel="1", color="#d62728", style=dashed];
    "h3_shares-chores_R" -> "?a_R" [xlabel="2", color="#d62728", style=dashed];
    "h3_shares-chores_R" -> "?b_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
