digraph rule_one_box_per_pet_lhs_rhs {
  rankdir=TB;
  label="one-box-per-pet"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "in_L" [label="in", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "h1_in_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_in_L" -> "in_L" [xlabel="1", color="#7f7f7f"];
    "h1_in_L" -> "?p_L" [xlabel="2", color="#7f7f7f"];
    "h1_in_L" -> "?b_L" [xlabel="3", color="#7f7f7f"];
    "h2_in_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h2_in_L" -> "in_L" [xlabel="1", color="#7f7f7f"];
    "h2_in_L" -> "?p_L" [xlabel="2", color="#7f7f7f"];
    "h2_in_L" -> "?c_L" [xlabel="3", color="#7f7f7f"];
    "?b_L" -> "?c_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h3_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h3_false_R" -> "false_R" [xlabel="1", color="#2ca02c", style=dashed];
  }
}
