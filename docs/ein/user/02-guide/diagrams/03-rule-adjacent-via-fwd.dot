digraph rule_adjacent_via_fwd_lhs_rhs {
  rankdir=TB;
  label="adjacent-via-fwd"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R1_L" [label="?R1", shape=diamond];
    "?V1_L" [label="?V1", shape=diamond];
    "?h1_L" [label="?h1", shape=diamond];
    "?S_L" [label="?S", shape=diamond];
    "?h2_L" [label="?h2", shape=diamond];
    "h1_R1_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_R1_L" -> "?R1_L" [xlabel="1", color="#bcbd22"];
    "h1_R1_L" -> "?V1_L" [xlabel="2", color="#bcbd22"];
    "h1_R1_L" -> "?h1_L" [xlabel="3", color="#bcbd22"];
    "h2_S_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h2_S_L" -> "?S_L" [xlabel="1", color="#2ca02c"];
    "h2_S_L" -> "?h2_L" [xlabel="2", color="#2ca02c"];
    "h2_S_L" -> "?h1_L" [xlabel="3", color="#2ca02c"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "?h_o_L" [label="?h_o", shape=diamond];
      "h3_S_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
      "h3_S_L" -> "?S_L" [xlabel="1", color="#2ca02c"];
      "h3_S_L" -> "?h_o_L" [xlabel="2", color="#2ca02c"];
      "h3_S_L" -> "?h1_L" [xlabel="3", color="#2ca02c"];
      "?h_o_L" -> "?h2_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    }
  }
  subgraph cluster_rhs { label="assert";
    "?R2_R" [label="?R2", shape=diamond];
    "?V2_R" [label="?V2", shape=diamond];
    "?h2_R" [label="?h2", shape=diamond];
    "h4_R2_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "h4_R2_R" -> "?R2_R" [xlabel="1", color="#bcbd22", style=dashed];
    "h4_R2_R" -> "?V2_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h4_R2_R" -> "?h2_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
