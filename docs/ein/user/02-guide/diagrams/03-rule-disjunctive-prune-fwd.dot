digraph rule_disjunctive_prune_fwd_lhs_rhs {
  rankdir=TB;
  label="disjunctive-prune-fwd"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R1_L" [label="?R1", shape=diamond];
    "?V1_L" [label="?V1", shape=diamond];
    "?h1_L" [label="?h1", shape=diamond];
    "relation_L" [label="relation", shape=box];
    "?R2_L" [label="?R2", shape=diamond];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "is-a_L" [label="is-a", shape=box];
    "?h_other_L" [label="?h_other", shape=diamond];
    "h1_R1_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_R1_L" -> "?R1_L" [xlabel="1", color="#bcbd22"];
    "h1_R1_L" -> "?V1_L" [xlabel="2", color="#bcbd22"];
    "h1_R1_L" -> "?h1_L" [xlabel="3", color="#bcbd22"];
    "h2_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h2_relation_L" -> "relation_L" [xlabel="1", color="#bcbd22"];
    "h2_relation_L" -> "?R2_L" [xlabel="2", color="#bcbd22"];
    "h2_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h2_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h3_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h3_is-a_L" -> "is-a_L" [xlabel="1", color="#7f7f7f"];
    "h3_is-a_L" -> "?h_other_L" [xlabel="2", color="#7f7f7f"];
    "h3_is-a_L" -> "?B_L" [xlabel="3", color="#7f7f7f"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "?S_L" [label="?S", shape=diamond];
      "h4_S_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
      "h4_S_L" -> "?S_L" [xlabel="1", color="#2ca02c"];
      "h4_S_L" -> "?h_other_L" [xlabel="2", color="#2ca02c"];
      "h4_S_L" -> "?h1_L" [xlabel="3", color="#2ca02c"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R2_R" [label="?R2", shape=diamond];
    "?V2_R" [label="?V2", shape=diamond];
    "?h_other_R" [label="?h_other", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R2 ?V2 ?h_other)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h5_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h5_not_R" -> "not_R" [xlabel="1", color="#d62728", style=dashed];
    "h5_not_R" -> "(?R2 ?V2 ?h_other)_R" [xlabel="2", color="#d62728", style=dashed];
    "(?R2 ?V2 ?h_other)_R" -> "?R2_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(?R2 ?V2 ?h_other)_R" -> "?V2_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(?R2 ?V2 ?h_other)_R" -> "?h_other_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
