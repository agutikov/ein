digraph rule_symmetric_lhs_rhs {
  rankdir=TB;
  label="symmetric"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?rel_L" [label="?rel", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_rel_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "?rel_L" -> "h1_rel_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_rel_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "h1_rel_L" -> "?b_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?rel_R" [label="?rel", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "h2_rel_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "?rel_R" -> "h2_rel_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_rel_R" -> "?b_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_rel_R" -> "?a_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
