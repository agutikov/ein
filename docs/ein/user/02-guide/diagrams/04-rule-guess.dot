digraph rule_guess_lhs_rhs {
  rankdir=TB;
  label="guess"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "is-a_L" [label="is-a", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?T1_L" [label="?T1", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?T2_L" [label="?T2", shape=diamond];
    "h1_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_is-a_L" -> "is-a_L" [xlabel="1", color="#7f7f7f"];
    "h1_is-a_L" -> "?a_L" [xlabel="2", color="#7f7f7f"];
    "h1_is-a_L" -> "?T1_L" [xlabel="3", color="#7f7f7f"];
    "h2_is-a_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h2_is-a_L" -> "is-a_L" [xlabel="1", color="#7f7f7f"];
    "h2_is-a_L" -> "?b_L" [xlabel="2", color="#7f7f7f"];
    "h2_is-a_L" -> "?T2_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h3_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h3_R_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h3_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h3_R_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
