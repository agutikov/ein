digraph rule_int_div_start_lhs_rhs {
  rankdir=TB;
  label="int-div-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-of ?k)_L" [shape=octagon, label="int-div-of", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-second (int-div-of ?k) ?p ?n)_L" [shape=octagon, label="int-second", color="#bcbd22", fontcolor="#bcbd22"];
      "(int ?q ?m)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "(int ?q ?m)_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "(int-div-of ?k)_L" [label="1", color="#bcbd22"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "?p_L" [label="2", color="#bcbd22"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "?n_L" [label="3", color="#bcbd22"];
    "(int-div-of ?k)_L" -> "?k_L" [label="1", color="#9467bd"];
    "(int ?q ?m)_L" -> "?q_L" [label="1", color="#17becf"];
    "(int ?q ?m)_L" -> "?m_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-a ?k ?q ?m)_R" [shape=octagon, label="int-div-a", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "h1_int-norm_R" [shape=octagon, label="int-norm", color="#e377c2", fontcolor="#e377c2"];
    "h1_int-norm_R" -> "(int-div-a ?k ?q ?m)_R" [label="1", color="#e377c2", style=dashed];
    "h1_int-norm_R" -> "?p_R" [label="2", color="#e377c2", style=dashed];
    "h1_int-norm_R" -> "?n_R" [label="3", color="#e377c2", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?k_R" [label="1", color="#bcbd22", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?q_R" [label="2", color="#bcbd22", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?m_R" [label="3", color="#bcbd22", style=dashed];
  }
}
