digraph rule_int_div_start_lhs_rhs {
  rankdir=TB;
  label="int-div-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "operand-is_L" [label="operand-is", shape=box];
    "int-second_L" [label="int-second", shape=box];
    "int-div-of_L" [label="int-div-of", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "int_L" [label="int", shape=box];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-of ?k)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-second (int-div-of ?k) ?p ?n)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(int ?q ?m)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_operand-is_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "operand-is_L" -> "h1_operand-is_L" [xlabel="1", dir=back, color="#17becf"];
    "h1_operand-is_L" -> "(int-second (int-div-of ?k) ?p ?n)_L" [xlabel="2", color="#17becf"];
    "h1_operand-is_L" -> "(int ?q ?m)_L" [xlabel="3", color="#17becf"];
    "int-second_L" -> "(int-second (int-div-of ?k) ?p ?n)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "(int-div-of ?k)_L" [xlabel="2", color="#bcbd22"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "?p_L" [xlabel="3", color="#bcbd22"];
    "(int-second (int-div-of ?k) ?p ?n)_L" -> "?n_L" [xlabel="4", color="#bcbd22"];
    "int-div-of_L" -> "(int-div-of ?k)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(int-div-of ?k)_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "int_L" -> "(int ?q ?m)_L" [xlabel="1", dir=back, color="#17becf"];
    "(int ?q ?m)_L" -> "?q_L" [xlabel="2", color="#17becf"];
    "(int ?q ?m)_L" -> "?m_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm-run_R" [label="int-norm-run", shape=box];
    "int-div-a_R" [label="int-div-a", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-a ?k ?q ?m)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_int-norm-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "int-norm-run_R" -> "h2_int-norm-run_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "(int-div-a ?k ?q ?m)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?p_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?n_R" [xlabel="4", color="#d62728", style=dashed];
    "int-div-a_R" -> "(int-div-a ?k ?q ?m)_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?k_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?q_R" [xlabel="3", color="#bcbd22", style=dashed];
    "(int-div-a ?k ?q ?m)_R" -> "?m_R" [xlabel="4", color="#bcbd22", style=dashed];
