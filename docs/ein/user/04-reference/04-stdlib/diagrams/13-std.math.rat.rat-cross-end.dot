digraph rule_rat_cross_end_lhs_rhs {
  rankdir=TB;
  label="rat-cross-end"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "rat-x6_L" [label="rat-x6", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    "?t_L" [label="?t", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x6 ?k ?s)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(rat-x6 ?k ?s)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?t_L" [xlabel="3", color="#e377c2"];
    "(rat-x6 ?k ?s)_L" -> "rat-x6_L" [xlabel="1", color="#17becf"];
    "(rat-x6 ?k ?s)_L" -> "?k_L" [xlabel="2", color="#17becf"];
    "(rat-x6 ?k ?s)_L" -> "?s_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "rat-cross-is_R" [label="rat-cross-is", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
    "h2_rat-cross-is_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_rat-cross-is_R" -> "rat-cross-is_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_rat-cross-is_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_rat-cross-is_R" -> "?s_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_rat-cross-is_R" -> "?t_R" [xlabel="4", color="#17becf", style=dashed];
  }
}
