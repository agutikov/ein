digraph rule_to_dec_begin_lhs_rhs {
  rankdir=TB;
  label="to-dec-begin"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bin-top-first-is_L" [label="bin-top-first-is", shape=box];
    "dec-bits_L" [label="dec-bits", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "?t_L" [label="?t", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bin-top-first-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(dec-bits ?b)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    }
    "h1_bin-top-first-is_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_bin-top-first-is_L" -> "bin-top-first-is_L" [xlabel="1", color="#2ca02c"];
    "h1_bin-top-first-is_L" -> "(dec-bits ?b)_L" [xlabel="2", color="#2ca02c"];
    "h1_bin-top-first-is_L" -> "?t_L" [xlabel="3", color="#2ca02c"];
    "(dec-bits ?b)_L" -> "dec-bits_L" [xlabel="1", color="#8c564b"];
    "(dec-bits ?b)_L" -> "?b_L" [xlabel="2", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "to-dec-go_R" [label="to-dec-go", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
    "z_R" [label="z", shape=box];
    "h2_to-dec-go_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "to-dec-go_R" [xlabel="1", color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "?b_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "?t_R" [xlabel="3", color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "z_R" [xlabel="4", color="#bcbd22", style=dashed];
  }
}
