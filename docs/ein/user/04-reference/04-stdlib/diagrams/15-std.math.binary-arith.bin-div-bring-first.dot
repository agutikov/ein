digraph rule_bin_div_bring_first_lhs_rhs {
  rankdir=TB;
  label="bin-div-bring-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bin-div-step_L" [label="bin-div-step", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "bin-b_L" [label="bin-b", shape=box];
    "1_L" [label="1", shape=box];
    "?rest_L" [label="?rest", shape=diamond];
    "z_L" [label="z", shape=box];
    "?w_L" [label="?w", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bin-div-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-b 1 ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h1_bin-div-step_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_bin-div-step_L" -> "bin-div-step_L" [xlabel="1", color="#9467bd"];
    "h1_bin-div-step_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "h1_bin-div-step_L" -> "?d_L" [xlabel="3", color="#9467bd"];
    "h1_bin-div-step_L" -> "(bin-b 1 ?rest)_L" [xlabel="4", color="#9467bd"];
    "h1_bin-div-step_L" -> "z_L" [xlabel="5", color="#9467bd"];
    "h1_bin-div-step_L" -> "?w_L" [xlabel="6", color="#9467bd"];
    "(bin-b 1 ?rest)_L" -> "bin-b_L" [xlabel="1", color="#7f7f7f"];
    "(bin-b 1 ?rest)_L" -> "1_L" [xlabel="2", color="#7f7f7f"];
    "(bin-b 1 ?rest)_L" -> "?rest_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-sub-run_R" [label="bin-sub-run", shape=box];
    "bin-div-trial_R" [label="bin-div-trial", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "b2_R" [label="b2", shape=box];
    "z_R" [label="z", shape=box];
    "1_R" [label="1", shape=box];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="bin-div-trial, bin-sub-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 z 1)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    subgraph cluster_ctx_R_1 {
      label="bin-sub-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_bin-sub-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "bin-sub-run_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "(b2 z 1)_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "?d_R" [xlabel="4", color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "0_R" [xlabel="5", color="#17becf", style=dashed];
    "h2_bin-sub-run_R" -> "z_R" [xlabel="6", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "bin-div-trial_R" [xlabel="1", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?d_R" [xlabel="3", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?rest_R" [xlabel="4", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?w_R" [xlabel="5", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "(b2 z 1)_R" [xlabel="6", color="#17becf", style=dashed];
    "(b2 z 1)_R" -> "b2_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(b2 z 1)_R" -> "z_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(b2 z 1)_R" -> "1_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
