digraph rule_bin_div_bring_first_lhs_rhs {
  rankdir=TB;
  label="bin-div-bring-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "1_L" [label="1", shape=rectangle];
    "?rest_L" [label="?rest", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    "?w_L" [label="?w", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bin-div-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-b 1 ?rest)_L" [shape=octagon, label="bin-b", color="#7f7f7f", fontcolor="#7f7f7f"];
    }
    "h1_bin-div-step_L" [shape=octagon, label="bin-div-step", color="#9467bd", fontcolor="#9467bd"];
    "h1_bin-div-step_L" -> "?k_L" [label="1", color="#9467bd"];
    "h1_bin-div-step_L" -> "?d_L" [label="2", color="#9467bd"];
    "h1_bin-div-step_L" -> "(bin-b 1 ?rest)_L" [label="3", color="#9467bd"];
    "h1_bin-div-step_L" -> "z_L" [label="4", color="#9467bd"];
    "h1_bin-div-step_L" -> "?w_L" [label="5", color="#9467bd"];
    "(bin-b 1 ?rest)_L" -> "1_L" [label="1", color="#7f7f7f"];
    "(bin-b 1 ?rest)_L" -> "?rest_L" [label="2", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "z_R" [label="z", shape=rectangle];
    "1_R" [label="1", shape=rectangle];
    "0_R" [label="0", shape=rectangle];
    subgraph cluster_ctx_R_0 {
      label="bin-div-trial, bin-sub-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 z 1)_R" [shape=octagon, label="b2", color="#bcbd22", fontcolor="#bcbd22"];
    }
    subgraph cluster_ctx_R_1 {
      label="bin-sub-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" [shape=octagon, label="bin-div-trial", color="#17becf", fontcolor="#17becf"];
    }
    "h2_bin-sub-walk_R" [shape=octagon, label="bin-sub-walk", color="#9467bd", fontcolor="#9467bd"];
    "h2_bin-sub-walk_R" -> "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" [label="1", color="#9467bd", style=dashed];
    "h2_bin-sub-walk_R" -> "(b2 z 1)_R" [label="2", color="#9467bd", style=dashed];
    "h2_bin-sub-walk_R" -> "?d_R" [label="3", color="#9467bd", style=dashed];
    "h2_bin-sub-walk_R" -> "0_R" [label="4", color="#9467bd", style=dashed];
    "h2_bin-sub-walk_R" -> "z_R" [label="5", color="#9467bd", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?k_R" [label="1", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?d_R" [label="2", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?rest_R" [label="3", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "?w_R" [label="4", color="#17becf", style=dashed];
    "(bin-div-trial ?k ?d ?rest ?w (b2 z 1))_R" -> "(b2 z 1)_R" [label="5", color="#17becf", style=dashed];
    "(b2 z 1)_R" -> "z_R" [label="1", color="#bcbd22", style=dashed];
    "(b2 z 1)_R" -> "1_R" [label="2", color="#bcbd22", style=dashed];
  }
}
