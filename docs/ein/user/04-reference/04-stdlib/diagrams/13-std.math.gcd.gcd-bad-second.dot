digraph rule_gcd_bad_second_lhs_rhs {
  rankdir=TB;
  label="gcd-bad-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?request_L" [label="?request", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bad-operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-second ?request ?u)_L" [shape=octagon, label="gcd-second", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(gcd-second ?request ?u)_L" -> "?f_L" [label="bad-operand", color="#1f77b4", fontcolor="#1f77b4"];
    "(gcd-second ?request ?u)_L" -> "?request_L" [label="1", color="#1f77b4"];
    "(gcd-second ?request ?u)_L" -> "?u_L" [label="2", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?request_R" [label="?request", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    "?request_R" -> "?f_R" [label="bad-request", color="#e377c2", fontcolor="#e377c2", style=dashed];
  }
}
