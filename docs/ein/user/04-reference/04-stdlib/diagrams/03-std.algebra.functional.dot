digraph rule_functional_lhs_rhs {
  rankdir=TB;
  label="functional"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R_L" [label="?R", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "h1_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_R_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "h1_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h1_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "h2_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_R_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "h2_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h2_R_L" -> "?c_L" [xlabel="3", color="#1f77b4"];
    "?b_L" -> "?c_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h3_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h3_false_R" -> "false_R" [xlabel="1", color="#2ca02c", style=dashed];
  }
}
