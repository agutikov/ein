digraph rule_gcd_start_lhs_rhs {
  rankdir=TB;
  label="gcd-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "operand-is_L" [label="operand-is", shape=box];
    "gcd-second_L" [label="gcd-second", shape=box];
    "gcd_L" [label="gcd", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-second (gcd ?x ?y) ?u)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_operand-is_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "operand-is_L" -> "h1_operand-is_L" [xlabel="1", dir=back, color="#17becf"];
    "h1_operand-is_L" -> "(gcd-second (gcd ?x ?y) ?u)_L" [xlabel="2", color="#17becf"];
    "h1_operand-is_L" -> "?v_L" [xlabel="3", color="#17becf"];
    "gcd-second_L" -> "(gcd-second (gcd ?x ?y) ?u)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(gcd-second (gcd ?x ?y) ?u)_L" -> "(gcd ?x ?y)_L" [xlabel="2", color="#1f77b4"];
    "(gcd-second (gcd ?x ?y) ?u)_L" -> "?u_L" [xlabel="3", color="#1f77b4"];
    "gcd_L" -> "(gcd ?x ?y)_L" [xlabel="1", dir=back, color="#2ca02c"];
    "(gcd ?x ?y)_L" -> "?x_L" [xlabel="2", color="#2ca02c"];
    "(gcd ?x ?y)_L" -> "?y_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "gcd-call_R" [label="gcd-call", shape=box];
    "gcd_R" [label="gcd", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h2_gcd-call_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "gcd-call_R" -> "h2_gcd-call_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "(gcd ?x ?y)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "?u_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "?v_R" [xlabel="4", color="#2ca02c", style=dashed];
    "gcd_R" -> "(gcd ?x ?y)_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(gcd ?x ?y)_R" -> "?x_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(gcd ?x ?y)_R" -> "?y_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
