digraph rule_gcd_start_lhs_rhs {
  rankdir=TB;
  label="gcd-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_L" [shape=octagon, label="gcd", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-second (gcd ?x ?y) ?u)_L" [shape=octagon, label="gcd-second", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(gcd-second (gcd ?x ?y) ?u)_L" -> "?v_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(gcd-second (gcd ?x ?y) ?u)_L" -> "(gcd ?x ?y)_L" [label="1", color="#1f77b4"];
    "(gcd-second (gcd ?x ?y) ?u)_L" -> "?u_L" [label="2", color="#1f77b4"];
    "(gcd ?x ?y)_L" -> "?x_L" [label="1", color="#2ca02c"];
    "(gcd ?x ?y)_L" -> "?y_L" [label="2", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_R" [shape=octagon, label="gcd", color="#2ca02c", fontcolor="#2ca02c"];
    }
    "h1_gcd-call_R" [shape=octagon, label="gcd-call", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_gcd-call_R" -> "(gcd ?x ?y)_R" [label="1", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "?u_R" [label="2", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "?v_R" [label="3", color="#2ca02c", style=dashed];
    "(gcd ?x ?y)_R" -> "?x_R" [label="1", color="#2ca02c", style=dashed];
    "(gcd ?x ?y)_R" -> "?y_R" [label="2", color="#2ca02c", style=dashed];
  }
}
