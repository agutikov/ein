digraph rule_top_lhs_rhs {
  rankdir=TB;
  label="top"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?Dom_L" [label="?Dom", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?Ran_L" [label="?Ran", shape=diamond];
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h1_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?Dom_L" [xlabel="3", color="#bcbd22"];
    "h2_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h2_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h2_isa_L" -> "?Ran_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h3_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "?R_R" -> "h3_R_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h3_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h3_R_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
