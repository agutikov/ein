digraph rule_bin_div_multiples_lhs_rhs {
  rankdir=TB;
  label="bin-div-multiples"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bin-div-run_L" [label="bin-div-run", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "h1_bin-div-run_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_bin-div-run_L" -> "bin-div-run_L" [xlabel="1", color="#9467bd"];
    "h1_bin-div-run_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "h1_bin-div-run_L" -> "?u_L" [xlabel="3", color="#9467bd"];
    "h1_bin-div-run_L" -> "?v_L" [xlabel="4", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-add-run_R" [label="bin-add-run", shape=box];
    "bin-div-m1_R" [label="bin-div-m1", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "z_R" [label="z", shape=box];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="bin-add-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-div-m1 ?k ?u ?v)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_bin-add-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "bin-add-run_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "(bin-div-m1 ?k ?u ?v)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "z_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "?v_R" [xlabel="4", color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "0_R" [xlabel="5", color="#d62728", style=dashed];
    "h2_bin-add-run_R" -> "z_R" [xlabel="6", color="#d62728", style=dashed];
    "(bin-div-m1 ?k ?u ?v)_R" -> "bin-div-m1_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "(bin-div-m1 ?k ?u ?v)_R" -> "?k_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(bin-div-m1 ?k ?u ?v)_R" -> "?u_R" [xlabel="3", color="#ff7f0e", style=dashed];
    "(bin-div-m1 ?k ?u ?v)_R" -> "?v_R" [xlabel="4", color="#ff7f0e", style=dashed];
  }
}
