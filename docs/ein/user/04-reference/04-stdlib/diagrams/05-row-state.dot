digraph kb {
  rankdir=BT;
  ranksep=0.55;
  node [fontname="Inter", shape=box];
  "House" -> "Attribute" [xlabel="type", color="#8c564b", fontcolor="#8c564b", style=solid];
  "Colour" -> "Attribute" [xlabel="type", color="#8c564b", fontcolor="#8c564b", style=solid];
  "H1" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "H2" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "H3" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "Red" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "Green" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "Blue" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid];
  "H2" -> "H1" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid];
  "H3" -> "H2" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid];
  "Green" -> "Red" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid];
  "Blue" -> "H1" [xlabel="co-loc", color="#1f77b4", fontcolor="#1f77b4", style=solid];
  "H1" -> "Blue" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
  "Green" -> "H3" [xlabel="co-loc by std.slots.slot-elimination", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
  "H3" -> "Green" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
  "Red" -> "H2" [xlabel="co-loc by std.slots.slot-elimination", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
  "H2" -> "Red" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
}
