digraph kb {
  rankdir=TB;
  ranksep=0.55;
  node [fontname="Inter", shape=box];
  "House" -> "Attribute" [xlabel="type", color="#8c564b", fontcolor="#8c564b", style=solid, constraint=false];
  "Colour" -> "Attribute" [xlabel="type", color="#8c564b", fontcolor="#8c564b", style=solid, constraint=false];
  "H1" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "H2" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "H3" -> "House" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "Red" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "Green" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "Blue" -> "Colour" [xlabel="instance", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "H2" -> "H1" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "H3" -> "H2" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "Green" -> "Red" [xlabel="right-of", color="#d62728", fontcolor="#d62728", style=solid, constraint=false];
  "Blue" -> "H1" [xlabel="co-loc", color="#1f77b4", fontcolor="#1f77b4", style=solid, constraint=false];
  "H1" -> "Blue" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed, constraint=false];
  "Green" -> "H3" [xlabel="co-loc by std.slots.slot-elimination", color="#1f77b4", fontcolor="#1f77b4", style=dashed, constraint=false];
  "H3" -> "Green" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed, constraint=false];
  "Red" -> "H2" [xlabel="co-loc by std.slots.slot-elimination", color="#1f77b4", fontcolor="#1f77b4", style=dashed, constraint=false];
  "H2" -> "Red" [xlabel="co-loc by symmetric", color="#1f77b4", fontcolor="#1f77b4", style=dashed, constraint=false];
  "layer 0" [style=invis, label="", width=0, height=0, fixedsize=true];
  { rank=same; "layer 0"; "House"; "Attribute"; "Colour"; "H1"; "H2"; "H3"; "Red"; "Green"; "Blue"; }
}
