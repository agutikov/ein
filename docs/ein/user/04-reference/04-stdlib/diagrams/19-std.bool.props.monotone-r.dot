digraph rule_monotone_r_lhs_rhs {
  rankdir=TB;
  label="monotone-r"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "column_L" [label="column", shape=box];
    "?f_L" [label="?f", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "le_L" [label="le", shape=box];
    "h1_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "h1_column_L" -> "column_L" [xlabel="1", color="#d62728"];
    "h1_column_L" -> "?f_L" [xlabel="2", color="#d62728"];
    "h1_column_L" -> "?a_L" [xlabel="3", color="#d62728"];
    "h1_column_L" -> "?b_L" [xlabel="4", color="#d62728"];
    "h1_column_L" -> "?c_L" [xlabel="5", color="#d62728"];
    "h1_column_L" -> "?d_L" [xlabel="6", color="#d62728"];
    "h2_le_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_le_L" -> "le_L" [xlabel="1", color="#1f77b4"];
    "h2_le_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h2_le_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "h3_le_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h3_le_L" -> "le_L" [xlabel="1", color="#1f77b4"];
    "h3_le_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h3_le_L" -> "?c_L" [xlabel="3", color="#1f77b4"];
    "h4_le_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h4_le_L" -> "le_L" [xlabel="1", color="#1f77b4"];
    "h4_le_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
    "h4_le_L" -> "?d_L" [xlabel="3", color="#1f77b4"];
    "h5_le_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h5_le_L" -> "le_L" [xlabel="1", color="#1f77b4"];
    "h5_le_L" -> "?c_L" [xlabel="2", color="#1f77b4"];
    "h5_le_L" -> "?d_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "monotone_R" [label="monotone", shape=box];
    "?f_R" [label="?f", shape=diamond];
    "h6_monotone_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h6_monotone_R" -> "monotone_R" [xlabel="1", color="#d62728", style=dashed];
    "h6_monotone_R" -> "?f_R" [xlabel="2", color="#d62728", style=dashed];
  }
}
