digraph rule_div_fits_lhs_rhs {
  rankdir=TB;
  label="div-fits"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "div-trial_L" [label="div-trial", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?ms_L" [label="?ms", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "?w_L" [label="?w", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?lo_L" [label="?lo", shape=diamond];
    "?hi_L" [label="?hi", shape=diamond];
    "?left_L" [label="?left", shape=diamond];
    "?j_L" [label="?j", shape=diamond];
    "?t_L" [label="?t", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?t_L" [xlabel="3", color="#e377c2"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "div-trial_L" [xlabel="1", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?ms_L" [xlabel="3", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?rest_L" [xlabel="4", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?w_L" [xlabel="5", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?u_L" [xlabel="6", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?lo_L" [xlabel="7", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?hi_L" [xlabel="8", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?left_L" [xlabel="9", color="#9467bd"];
    "(div-trial ?k ?ms ?rest ?w ?u ?lo ?hi ?left ?j)_L" -> "?j_L" [xlabel="10", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "div-choose_R" [label="div-choose", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?ms_R" [label="?ms", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?j_R" [label="?j", shape=diamond];
    "?hi_R" [label="?hi", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
    "h2_div-choose_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "div-choose_R" [xlabel="1", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?k_R" [xlabel="2", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?ms_R" [xlabel="3", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?rest_R" [xlabel="4", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?w_R" [xlabel="5", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?u_R" [xlabel="6", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?j_R" [xlabel="7", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?hi_R" [xlabel="8", color="#8c564b", style=dashed];
    "h2_div-choose_R" -> "?t_R" [xlabel="9", color="#8c564b", style=dashed];
