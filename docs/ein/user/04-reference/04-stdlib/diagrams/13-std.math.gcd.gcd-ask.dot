digraph rule_gcd_ask_lhs_rhs {
  rankdir=TB;
  label="gcd-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="gcd", color="#2ca02c", fontcolor="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_R" [shape=octagon, label="gcd", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-first (gcd ?x ?y) ?y)_R" [shape=octagon, label="gcd-first", color="#e377c2", fontcolor="#e377c2"];
    }
    "(gcd-first (gcd ?x ?y) ?y)_R" -> "?x_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(gcd-first (gcd ?x ?y) ?y)_R" -> "(gcd ?x ?y)_R" [label="1", color="#e377c2", style=dashed];
    "(gcd-first (gcd ?x ?y) ?y)_R" -> "?y_R" [label="2", color="#e377c2", style=dashed];
    "(gcd ?x ?y)_R" -> "?x_R" [label="1", color="#2ca02c", style=dashed];
    "(gcd ?x ?y)_R" -> "?y_R" [label="2", color="#2ca02c", style=dashed];
  }
}
