digraph rule_cmp_ask_second_lhs_rhs {
  rankdir=TB;
  label="cmp-ask-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?OPERAND-IS ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?CMP-FIRST ?x ?y)_L" [shape=octagon, label="?CMP-FIRST", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "(?CMP-FIRST ?x ?y)_L" -> "?u_L" [label="?OPERAND-IS", color="#bcbd22", fontcolor="#bcbd22"];
    "(?CMP-FIRST ?x ?y)_L" -> "?x_L" [label="1", color="#bcbd22"];
    "(?CMP-FIRST ?x ?y)_L" -> "?y_L" [label="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?CMP-SECOND ?x ?y ?u)_R" [shape=octagon, label="?CMP-SECOND", color="#8c564b", fontcolor="#8c564b"];
    }
    "(?CMP-SECOND ?x ?y ?u)_R" -> "?y_R" [label="?OPERAND", color="#d62728", fontcolor="#d62728", style=dashed];
    "(?CMP-SECOND ?x ?y ?u)_R" -> "?x_R" [label="1", color="#8c564b", style=dashed];
    "(?CMP-SECOND ?x ?y ?u)_R" -> "?y_R" [label="2", color="#8c564b", style=dashed];
    "(?CMP-SECOND ?x ?y ?u)_R" -> "?u_R" [label="3", color="#8c564b", style=dashed];
  }
}
