    }
    "(int-second ?k ?p ?n)_R" -> "?y_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(int-second ?k ?p ?n)_R" -> "?k_R" [label="1", color="#bcbd22", style=dashed];
    "(int-second ?k ?p ?n)_R" -> "?p_R" [label="2", color="#bcbd22", style=dashed];
    "(int-second ?k ?p ?n)_R" -> "?n_R" [label="3", color="#bcbd22", style=dashed];
