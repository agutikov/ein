    "(int-first ?k ?y)_L" -> "(int ?p ?n)_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(int-first ?k ?y)_L" -> "?k_L" [label="1", color="#ff7f0e"];
    "(int-first ?k ?y)_L" -> "?y_L" [label="2", color="#ff7f0e"];
    "(int ?p ?n)_L" -> "?p_L" [label="1", color="#17becf"];
