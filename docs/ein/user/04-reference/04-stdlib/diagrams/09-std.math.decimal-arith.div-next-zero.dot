digraph rule_div_next_zero_lhs_rhs {
  rankdir=TB;
  label="div-next-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "div-digit_L" [label="div-digit", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?ms_L" [label="?ms", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "n_L" [label="n", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "0_L" [label="0", shape=box];
    "?t_L" [label="?t", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="div-digit ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?c)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_div-digit_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_div-digit_L" -> "div-digit_L" [xlabel="1", color="#9467bd"];
    "h1_div-digit_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "h1_div-digit_L" -> "?ms_L" [xlabel="3", color="#9467bd"];
    "h1_div-digit_L" -> "?rest_L" [xlabel="4", color="#9467bd"];
    "h1_div-digit_L" -> "(n ?p ?c)_L" [xlabel="5", color="#9467bd"];
    "h1_div-digit_L" -> "0_L" [xlabel="6", color="#9467bd"];
    "h1_div-digit_L" -> "?t_L" [xlabel="7", color="#9467bd"];
    "(n ?p ?c)_L" -> "n_L" [xlabel="1", color="#9467bd"];
    "(n ?p ?c)_L" -> "?p_L" [xlabel="2", color="#9467bd"];
    "(n ?p ?c)_L" -> "?c_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "div-step_R" [label="div-step", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?ms_R" [label="?ms", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
    "n_R" [label="n", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="div-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n (n ?p ?c) 0)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_R_1 {
      label="n ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?c)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_div-step_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_div-step_R" -> "div-step_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_div-step_R" -> "?k_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_div-step_R" -> "?ms_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_div-step_R" -> "?rest_R" [xlabel="4", color="#d62728", style=dashed];
    "h2_div-step_R" -> "?t_R" [xlabel="5", color="#d62728", style=dashed];
    "h2_div-step_R" -> "(n (n ?p ?c) 0)_R" [xlabel="6", color="#d62728", style=dashed];
    "(n (n ?p ?c) 0)_R" -> "n_R" [xlabel="1", color="#9467bd", style=dashed];
    "(n (n ?p ?c) 0)_R" -> "(n ?p ?c)_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n (n ?p ?c) 0)_R" -> "0_R" [xlabel="3", color="#9467bd", style=dashed];
    "(n ?p ?c)_R" -> "n_R" [xlabel="1", color="#9467bd", style=dashed];
    "(n ?p ?c)_R" -> "?p_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n ?p ?c)_R" -> "?c_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
