digraph rule_gcd_call_check_x_lhs_rhs {
  rankdir=TB;
  label="gcd-call-check-x"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-call_L" [label="gcd-call", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "n_L" [label="n", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_gcd-call_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "gcd-call_L" -> "h1_gcd-call_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_gcd-call_L" -> "?k_L" [xlabel="2", color="#2ca02c"];
    "h1_gcd-call_L" -> "(n ?p ?a)_L" [xlabel="3", color="#2ca02c"];
    "h1_gcd-call_L" -> "?y_L" [xlabel="4", color="#2ca02c"];
    "n_L" -> "(n ?p ?a)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(n ?p ?a)_L" -> "?p_L" [xlabel="2", color="#9467bd"];
    "(n ?p ?a)_L" -> "?a_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "check_R" [label="check", shape=box];
    "n_R" [label="n", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "check_R" -> "h2_check_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_check_R" -> "(n ?p ?a)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_check_R" -> "(n ?p ?a)_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "n_R" -> "(n ?p ?a)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(n ?p ?a)_R" -> "?p_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n ?p ?a)_R" -> "?a_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
