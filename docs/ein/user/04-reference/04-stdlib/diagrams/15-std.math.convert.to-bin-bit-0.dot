    "?x_R" [label="?x", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "bin-b_R" [label="bin-b", shape=box];
    "0_R" [label="0", shape=box];
    "?acc_R" [label="?acc", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="to-bin-go ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-b 0 ?acc)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_to-bin-go_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
