    "0_L" [label="0", shape=rectangle];
    "1_L" [label="1", shape=rectangle];
    "h1_gate2_L" [shape=octagon, label="gate2", color="#7f7f7f", fontcolor="#7f7f7f"];
    "h1_gate2_L" -> "?f_L" [label="1", color="#7f7f7f"];
    "h1_gate2_L" -> "0_L" [label="2", color="#7f7f7f"];
