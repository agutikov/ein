digraph rule_int_div_euclid_ask_lhs_rhs {
  rankdir=TB;
  label="int-div-euclid-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="int-div-euclid", color="#e377c2", fontcolor="#e377c2"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-div-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-euclid ?x ?y)_R" [shape=octagon, label="int-div-euclid", color="#e377c2", fontcolor="#e377c2"];
    }
    subgraph cluster_ctx_R_1 {
      label="int-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-of (int-div-euclid ?x ?y))_R" [shape=octagon, label="int-div-of", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_R_2 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-first (int-div-of (int-div-euclid ?x ?y)) ?y)_R" [shape=octagon, label="int-first", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    "(int-first (int-div-of (int-div-euclid ?x ?y)) ?y)_R" -> "?x_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(int-first (int-div-of (int-div-euclid ?x ?y)) ?y)_R" -> "(int-div-of (int-div-euclid ?x ?y))_R" [label="1", color="#ff7f0e", style=dashed];
    "(int-first (int-div-of (int-div-euclid ?x ?y)) ?y)_R" -> "?y_R" [label="2", color="#ff7f0e", style=dashed];
    "(int-div-of (int-div-euclid ?x ?y))_R" -> "(int-div-euclid ?x ?y)_R" [label="1", color="#9467bd", style=dashed];
    "(int-div-euclid ?x ?y)_R" -> "?x_R" [label="1", color="#e377c2", style=dashed];
    "(int-div-euclid ?x ?y)_R" -> "?y_R" [label="2", color="#e377c2", style=dashed];
  }
}
