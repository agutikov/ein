digraph rule_rat_div_pos_lhs_rhs {
  rankdir=TB;
  label="rat-div-pos"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?e_L" [label="?e", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="int ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?a ?b)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-div-by ?k ?p ?n ?d ?e)_L" [shape=octagon, label="rat-div-by", color="#9467bd", fontcolor="#9467bd"];
      "(int (n ?a ?b) z)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "(int (n ?a ?b) z)_L" [label="int-done", color="#1f77b4", fontcolor="#1f77b4"];
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "?k_L" [label="1", color="#9467bd"];
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "?p_L" [label="2", color="#9467bd"];
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "?n_L" [label="3", color="#9467bd"];
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "?d_L" [label="4", color="#9467bd"];
    "(rat-div-by ?k ?p ?n ?d ?e)_L" -> "?e_L" [label="5", color="#9467bd"];
    "(int (n ?a ?b) z)_L" -> "(n ?a ?b)_L" [label="1", color="#17becf"];
    "(int (n ?a ?b) z)_L" -> "z_L" [label="2", color="#17becf"];
    "(n ?a ?b)_L" -> "?a_L" [label="1", color="#9467bd"];
    "(n ?a ?b)_L" -> "?b_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    "z_R" [label="z", shape=rectangle];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="rat-mul-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?a ?b)_R" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "h1_rat-mul-call_R" [shape=octagon, label="rat-mul-call", color="#8c564b", fontcolor="#8c564b"];
    "h1_rat-mul-call_R" -> "?k_R" [label="1", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "?p_R" [label="2", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "?n_R" [label="3", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "?d_R" [label="4", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "?e_R" [label="5", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "z_R" [label="6", color="#8c564b", style=dashed];
    "h1_rat-mul-call_R" -> "(n ?a ?b)_R" [label="7", color="#8c564b", style=dashed];
    "(n ?a ?b)_R" -> "?a_R" [label="1", color="#9467bd", style=dashed];
    "(n ?a ?b)_R" -> "?b_R" [label="2", color="#9467bd", style=dashed];
  }
}
