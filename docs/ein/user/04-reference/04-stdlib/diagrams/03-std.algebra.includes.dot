digraph rule_includes_lhs_rhs {
  rankdir=TB;
  label="includes"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_p_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "h1_p_L" -> "?p_L" [xlabel="1", color="#17becf"];
    "h1_p_L" -> "?a_L" [xlabel="2", color="#17becf"];
    "h1_p_L" -> "?b_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?q_R" [label="?q", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h2_q_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "h2_q_R" -> "?q_R" [xlabel="1", color="#bcbd22", style=dashed];
    "h2_q_R" -> "?a_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h2_q_R" -> "?b_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
