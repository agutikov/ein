digraph rule_lcm_product_lhs_rhs {
  rankdir=TB;
  label="lcm-product"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-done_L" [label="gcd-done", shape=box];
    "lcm-g_L" [label="lcm-g", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "n_L" [label="n", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(lcm-g ?x ?y ?u ?v)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "(n ?p ?d)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_gcd-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_gcd-done_L" -> "gcd-done_L" [xlabel="1", color="#7f7f7f"];
    "h1_gcd-done_L" -> "(lcm-g ?x ?y ?u ?v)_L" [xlabel="2", color="#7f7f7f"];
    "h1_gcd-done_L" -> "(n ?p ?d)_L" [xlabel="3", color="#7f7f7f"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "lcm-g_L" [xlabel="1", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?x_L" [xlabel="2", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?u_L" [xlabel="4", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?v_L" [xlabel="5", color="#1f77b4"];
    "(n ?p ?d)_L" -> "n_L" [xlabel="1", color="#9467bd"];
    "(n ?p ?d)_L" -> "?p_L" [xlabel="2", color="#9467bd"];
    "(n ?p ?d)_L" -> "?d_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "mul-call_R" [label="mul-call", shape=box];
    "lcm-p_R" [label="lcm-p", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "n_R" [label="n", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="lcm-p ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_R_1 {
      label="mul-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(lcm-p ?x ?y (n ?p ?d))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_mul-call_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_mul-call_R" -> "mul-call_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_mul-call_R" -> "(lcm-p ?x ?y (n ?p ?d))_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_mul-call_R" -> "?u_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h2_mul-call_R" -> "?v_R" [xlabel="4", color="#2ca02c", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "lcm-p_R" [xlabel="1", color="#9467bd", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "?x_R" [xlabel="2", color="#9467bd", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "?y_R" [xlabel="3", color="#9467bd", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "(n ?p ?d)_R" [xlabel="4", color="#9467bd", style=dashed];
    "(n ?p ?d)_R" -> "n_R" [xlabel="1", color="#9467bd", style=dashed];
    "(n ?p ?d)_R" -> "?p_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n ?p ?d)_R" -> "?d_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
