digraph rule_lcm_product_lhs_rhs {
  rankdir=TB;
  label="lcm-product"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(lcm-g ?x ?y ?u ?v)_L" [shape=octagon, label="lcm-g", color="#1f77b4", fontcolor="#1f77b4"];
      "(n ?p ?d)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "(lcm-g ?x ?y ?u ?v)_L" -> "(n ?p ?d)_L" [label="gcd-done", color="#7f7f7f", fontcolor="#7f7f7f"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?x_L" [label="1", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?y_L" [label="2", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?u_L" [label="3", color="#1f77b4"];
    "(lcm-g ?x ?y ?u ?v)_L" -> "?v_L" [label="4", color="#1f77b4"];
    "(n ?p ?d)_L" -> "?p_L" [label="1", color="#9467bd"];
    "(n ?p ?d)_L" -> "?d_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="lcm-p ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?d)_R" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_R_1 {
      label="mul-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(lcm-p ?x ?y (n ?p ?d))_R" [shape=octagon, label="lcm-p", color="#9467bd", fontcolor="#9467bd"];
    }
    "h1_mul-call_R" [shape=octagon, label="mul-call", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_mul-call_R" -> "(lcm-p ?x ?y (n ?p ?d))_R" [label="1", color="#2ca02c", style=dashed];
    "h1_mul-call_R" -> "?u_R" [label="2", color="#2ca02c", style=dashed];
    "h1_mul-call_R" -> "?v_R" [label="3", color="#2ca02c", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "?x_R" [label="1", color="#9467bd", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "?y_R" [label="2", color="#9467bd", style=dashed];
    "(lcm-p ?x ?y (n ?p ?d))_R" -> "(n ?p ?d)_R" [label="3", color="#9467bd", style=dashed];
    "(n ?p ?d)_R" -> "?p_R" [label="1", color="#9467bd", style=dashed];
    "(n ?p ?d)_R" -> "?d_R" [label="2", color="#9467bd", style=dashed];
  }
}
