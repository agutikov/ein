digraph rule_int_simplify_start_lhs_rhs {
  rankdir=TB;
  label="int-simplify-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-simplify ?x)_L" [shape=octagon, label="int-simplify", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-only (int-simplify ?x))_L" [shape=octagon, label="int-only", color="#9467bd", fontcolor="#9467bd"];
      "(int ?p ?n)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(int-only (int-simplify ?x))_L" -> "(int ?p ?n)_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(int-only (int-simplify ?x))_L" -> "(int-simplify ?x)_L" [label="1", color="#9467bd"];
    "(int-simplify ?x)_L" -> "?x_L" [label="1", color="#2ca02c"];
    "(int ?p ?n)_L" -> "?p_L" [label="1", color="#17becf"];
    "(int ?p ?n)_L" -> "?n_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-simplify ?x)_R" [shape=octagon, label="int-simplify", color="#2ca02c", fontcolor="#2ca02c"];
    }
    "h1_int-norm_R" [shape=octagon, label="int-norm", color="#e377c2", fontcolor="#e377c2"];
    "h1_int-norm_R" -> "(int-simplify ?x)_R" [label="1", color="#e377c2", style=dashed];
    "h1_int-norm_R" -> "?p_R" [label="2", color="#e377c2", style=dashed];
    "h1_int-norm_R" -> "?n_R" [label="3", color="#e377c2", style=dashed];
    "(int-simplify ?x)_R" -> "?x_R" [label="1", color="#2ca02c", style=dashed];
  }
}
