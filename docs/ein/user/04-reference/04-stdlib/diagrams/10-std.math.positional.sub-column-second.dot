    "h2_FS_L" -> "?c_L" [label="2", color="#7f7f7f"];
    "h2_FS_L" -> "?e_L" [label="3", color="#7f7f7f"];
    "h2_FS_L" -> "?s_L" [label="4", color="#7f7f7f"];
    "h2_FS_L" -> "?f_L" [label="5", color="#7f7f7f"];
    "(?N ?q ?c)_L" -> "?q_L" [label="1", color="#7f7f7f"];
    "(?N ?q ?c)_L" -> "?c_L" [label="2", color="#7f7f7f"];
