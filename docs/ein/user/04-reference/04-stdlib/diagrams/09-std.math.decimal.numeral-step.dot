digraph rule_numeral_step_lhs_rhs {
  rankdir=TB;
  label="numeral-step"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?w_L" [label="?w", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p ?a)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "?w_L" -> "(n ?p ?a)_L" [label="check", color="#7f7f7f", fontcolor="#7f7f7f"];
    "h1_nz_L" [shape=octagon, label="nz", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_nz_L" -> "?a_L" [label="1", color="#2ca02c"];
    "(n ?p ?a)_L" -> "?p_L" [label="1", color="#9467bd"];
    "(n ?p ?a)_L" -> "?a_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?w_R" [label="?w", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?w_R" -> "?p_R" [label="check", color="#7f7f7f", fontcolor="#7f7f7f", style=dashed];
  }
}
