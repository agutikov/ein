digraph rule_mul_row_lhs_rhs {
  rankdir=TB;
  label="mul-row"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "mul-step_L" [label="mul-step", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "b_L" [label="b", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "?acc_L" [label="?acc", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="mul-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b ?a ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_mul-step_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_mul-step_L" -> "mul-step_L" [xlabel="1", color="#bcbd22"];
    "h1_mul-step_L" -> "?k_L" [xlabel="2", color="#bcbd22"];
    "h1_mul-step_L" -> "?u_L" [xlabel="3", color="#bcbd22"];
    "h1_mul-step_L" -> "(b ?a ?rest)_L" [xlabel="4", color="#bcbd22"];
    "h1_mul-step_L" -> "?acc_L" [xlabel="5", color="#bcbd22"];
    "(b ?a ?rest)_L" -> "b_L" [xlabel="1", color="#1f77b4"];
    "(b ?a ?rest)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(b ?a ?rest)_L" -> "?rest_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "mul-walk_R" [label="mul-walk", shape=box];
    "mul-row-of_R" [label="mul-row-of", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?acc_R" [label="?acc", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="mul-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(mul-row-of ?k ?u ?rest ?acc)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_mul-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "mul-walk_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "(mul-row-of ?k ?u ?rest ?acc)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "?u_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "?a_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "(mul-row-of ?k ?u ?rest ?acc)_R" -> "mul-row-of_R" [xlabel="1", color="#17becf", style=dashed];
    "(mul-row-of ?k ?u ?rest ?acc)_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "(mul-row-of ?k ?u ?rest ?acc)_R" -> "?u_R" [xlabel="3", color="#17becf", style=dashed];
    "(mul-row-of ?k ?u ?rest ?acc)_R" -> "?rest_R" [xlabel="4", color="#17becf", style=dashed];
    "(mul-row-of ?k ?u ?rest ?acc)_R" -> "?acc_R" [xlabel="5", color="#17becf", style=dashed];
  }
}
