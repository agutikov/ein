digraph rule_div_multiple_5_lhs_rhs {
  rankdir=TB;
  label="div-multiple-5"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "div-m4_L" [label="div-m4", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?m1_L" [label="?m1", shape=diamond];
    "?m2_L" [label="?m2", shape=diamond];
    "?m3_L" [label="?m3", shape=diamond];
    "?m4_L" [label="?m4", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "done_L" -> "h1_done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_done_L" -> "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?m4_L" [xlabel="3", color="#e377c2"];
    "div-m4_L" -> "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" -> "?k_L" [xlabel="2", color="#7f7f7f"];
    "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" -> "?u_L" [xlabel="3", color="#7f7f7f"];
    "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" -> "?m1_L" [xlabel="4", color="#7f7f7f"];
    "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" -> "?m2_L" [xlabel="5", color="#7f7f7f"];
    "(div-m4 ?k ?u ?m1 ?m2 ?m3)_L" -> "?m3_L" [xlabel="6", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "mul-walk_R" [label="mul-walk", shape=box];
    "div-m5_R" [label="div-m5", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?m1_R" [label="?m1", shape=diamond];
    "?m2_R" [label="?m2", shape=diamond];
    "?m3_R" [label="?m3", shape=diamond];
    "?m4_R" [label="?m4", shape=diamond];
    "5_R" [label="5", shape=box];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="mul-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_mul-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "mul-walk_R" -> "h2_mul-walk_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "?m1_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "5_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "div-m5_R" -> "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" -> "?u_R" [xlabel="3", color="#17becf", style=dashed];
