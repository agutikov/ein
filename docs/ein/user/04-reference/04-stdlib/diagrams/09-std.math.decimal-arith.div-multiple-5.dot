    "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" -> "?m2_R" [xlabel="5", color="#17becf", style=dashed];
    "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" -> "?m3_R" [xlabel="6", color="#17becf", style=dashed];
    "(div-m5 ?k ?u ?m1 ?m2 ?m3 ?m4)_R" -> "?m4_R" [xlabel="7", color="#17becf", style=dashed];
  }
