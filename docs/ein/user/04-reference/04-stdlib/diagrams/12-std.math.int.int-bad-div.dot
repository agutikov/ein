digraph rule_int_bad_div_lhs_rhs {
  rankdir=TB;
  label="int-bad-div"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bad-request_L" [label="bad-request", shape=box];
    "int-div-of_L" [label="int-div-of", shape=box];
    "?request_L" [label="?request", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bad-request ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-of ?request)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_bad-request_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_bad-request_L" -> "bad-request_L" [xlabel="1", color="#e377c2"];
    "h1_bad-request_L" -> "(int-div-of ?request)_L" [xlabel="2", color="#e377c2"];
    "h1_bad-request_L" -> "?f_L" [xlabel="3", color="#e377c2"];
    "(int-div-of ?request)_L" -> "int-div-of_L" [xlabel="1", color="#9467bd"];
