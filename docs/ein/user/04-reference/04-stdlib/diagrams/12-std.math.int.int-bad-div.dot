  }
  subgraph cluster_rhs { label="assert";
    "bad-request_R" [label="bad-request", shape=box];
    "?request_R" [label="?request", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    "h2_bad-request_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "h2_bad-request_R" -> "bad-request_R" [xlabel="1", color="#e377c2", style=dashed];
    "h2_bad-request_R" -> "?request_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_bad-request_R" -> "?f_R" [xlabel="3", color="#e377c2", style=dashed];
  }
}
