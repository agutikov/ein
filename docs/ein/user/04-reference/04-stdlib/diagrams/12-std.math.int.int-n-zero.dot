digraph rule_int_n_zero_lhs_rhs {
  rankdir=TB;
  label="int-n-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-check_L" [label="int-check", shape=box];
    "int_L" [label="int", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "0_L" [label="0", shape=box];
    subgraph cluster_ctx_L_0 {
      label="int-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p 0)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_int-check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "int-check_L" -> "h1_int-check_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_int-check_L" -> "(int ?p 0)_L" [xlabel="2", color="#2ca02c"];
    "int_L" -> "(int ?p 0)_L" [xlabel="1", dir=back, color="#17becf"];
    "(int ?p 0)_L" -> "?p_L" [xlabel="2", color="#17becf"];
    "(int ?p 0)_L" -> "0_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "not-integer_R" [label="not-integer", shape=box];
    "int_R" [label="int", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="not-integer ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p 0)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_not-integer_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "not-integer_R" -> "h2_not-integer_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_not-integer_R" -> "(int ?p 0)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_not-integer_R" -> "0_R" [xlabel="3", color="#2ca02c", style=dashed];
    "int_R" -> "(int ?p 0)_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "(int ?p 0)_R" -> "?p_R" [xlabel="2", color="#17becf", style=dashed];
    "(int ?p 0)_R" -> "0_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
