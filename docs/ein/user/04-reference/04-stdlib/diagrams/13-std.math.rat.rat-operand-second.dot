digraph rule_rat_operand_second_lhs_rhs {
  rankdir=TB;
  label="rat-operand-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-first ?k ?y)_L" [shape=octagon, label="rat-first", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "h1_rat-operand-is_L" [shape=octagon, label="rat-operand-is", color="#1f77b4", fontcolor="#1f77b4"];
    "h1_rat-operand-is_L" -> "(rat-first ?k ?y)_L" [label="1", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?p_L" [label="2", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?n_L" [label="3", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?d_L" [label="4", color="#1f77b4"];
    "(rat-first ?k ?y)_L" -> "?k_L" [label="1", color="#bcbd22"];
    "(rat-first ?k ?y)_L" -> "?y_L" [label="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-second ?k ?p ?n ?d))_R" [shape=octagon, label="rat-of", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-second ?k ?p ?n ?d)_R" [shape=octagon, label="rat-second", color="#8c564b", fontcolor="#8c564b"];
    }
    "(rat-of (rat-second ?k ?p ?n ?d))_R" -> "?y_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(rat-of (rat-second ?k ?p ?n ?d))_R" -> "(rat-second ?k ?p ?n ?d)_R" [label="1", color="#2ca02c", style=dashed];
    "(rat-second ?k ?p ?n ?d)_R" -> "?k_R" [label="1", color="#8c564b", style=dashed];
    "(rat-second ?k ?p ?n ?d)_R" -> "?p_R" [label="2", color="#8c564b", style=dashed];
    "(rat-second ?k ?p ?n ?d)_R" -> "?n_R" [label="3", color="#8c564b", style=dashed];
    "(rat-second ?k ?p ?n ?d)_R" -> "?d_R" [label="4", color="#8c564b", style=dashed];
  }
}
