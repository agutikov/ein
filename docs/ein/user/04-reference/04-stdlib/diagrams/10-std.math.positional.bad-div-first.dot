digraph rule_bad_div_first_lhs_rhs {
  rankdir=TB;
  label="bad-div-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?BAD-OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-FIRST ?x ?y)_L" [shape=octagon, label="?DIV-FIRST", color="#9467bd", fontcolor="#9467bd"];
    }
    "(?DIV-FIRST ?x ?y)_L" -> "?f_L" [label="?BAD-OPERAND", color="#17becf", fontcolor="#17becf"];
    "(?DIV-FIRST ?x ?y)_L" -> "?x_L" [label="1", color="#9467bd"];
    "(?DIV-FIRST ?x ?y)_L" -> "?y_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?BAD-REQUEST ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV ?x ?y)_R" [shape=octagon, label="?DIV", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    "(?DIV ?x ?y)_R" -> "?f_R" [label="?BAD-REQUEST", color="#d62728", fontcolor="#d62728", style=dashed];
    "(?DIV ?x ?y)_R" -> "?x_R" [label="1", color="#ff7f0e", style=dashed];
    "(?DIV ?x ?y)_R" -> "?y_R" [label="2", color="#ff7f0e", style=dashed];
  }
}
