digraph rule_bijective_setup_lhs_rhs {
  rankdir=TB;
  label="bijective-setup"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bijective_L" [label="bijective", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "bijection-hierarchy_L" [label="bijection-hierarchy", shape=box];
    "?isa_L" [label="?isa", shape=diamond];
    "h1_bijective_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "bijective_L" -> "h1_bijective_L" [xlabel="1", dir=back, color="#17becf"];
    "h1_bijective_L" -> "?R_L" [xlabel="2", color="#17becf"];
    "h2_bijection-hierarchy_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    "bijection-hierarchy_L" -> "h2_bijection-hierarchy_L" [xlabel="1", dir=back, color="#8c564b"];
    "h2_bijection-hierarchy_L" -> "?isa_L" [xlabel="2", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "total_R" [label="total", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?isa_R" [label="?isa", shape=diamond];
    "surjective_R" [label="surjective", shape=box];
    "total-owed_R" [label="total-owed", shape=box];
    "surjective-owed_R" [label="surjective-owed", shape=box];
    "domain-elimination_R" [label="domain-elimination", shape=box];
    "range-elimination_R" [label="range-elimination", shape=box];
    "functional-negative_R" [label="functional-negative", shape=box];
    "injective-negative_R" [label="injective-negative", shape=box];
    "h3_total_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "total_R" -> "h3_total_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h3_total_R" -> "?R_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h3_total_R" -> "?isa_R" [xlabel="3", color="#1f77b4", style=dashed];
    "h4_surjective_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "surjective_R" -> "h4_surjective_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h4_surjective_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h4_surjective_R" -> "?isa_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h5_total-owed_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "total-owed_R" -> "h5_total-owed_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h5_total-owed_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h5_total-owed_R" -> "?isa_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h6_surjective-owed_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "surjective-owed_R" -> "h6_surjective-owed_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h6_surjective-owed_R" -> "?R_R" [xlabel="2", color="#17becf", style=dashed];
    "h6_surjective-owed_R" -> "?isa_R" [xlabel="3", color="#17becf", style=dashed];
    "h7_domain-elimination_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "domain-elimination_R" -> "h7_domain-elimination_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h7_domain-elimination_R" -> "?R_R" [xlabel="2", color="#17becf", style=dashed];
    "h7_domain-elimination_R" -> "?isa_R" [xlabel="3", color="#17becf", style=dashed];
    "h8_range-elimination_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "range-elimination_R" -> "h8_range-elimination_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h8_range-elimination_R" -> "?R_R" [xlabel="2", color="#d62728", style=dashed];
    "h8_range-elimination_R" -> "?isa_R" [xlabel="3", color="#d62728", style=dashed];
    "h9_functional-negative_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "functional-negative_R" -> "h9_functional-negative_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "h9_functional-negative_R" -> "?R_R" [xlabel="2", color="#8c564b", style=dashed];
    "h9_functional-negative_R" -> "?isa_R" [xlabel="3", color="#8c564b", style=dashed];
    "h10_injective-negative_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "injective-negative_R" -> "h10_injective-negative_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h10_injective-negative_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h10_injective-negative_R" -> "?isa_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
