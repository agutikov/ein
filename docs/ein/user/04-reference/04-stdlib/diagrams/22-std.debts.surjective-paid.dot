    "h3_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h4_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "?R_L" -> "h4_R_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h4_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h4_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
