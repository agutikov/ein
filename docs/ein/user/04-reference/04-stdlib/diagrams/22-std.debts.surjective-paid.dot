    "?b_R" [label="?b", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="debt-paid ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(surjective-owed-of ?R ?isa ?A ?B ?b)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h5_debt-paid_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "debt-paid_R" -> "h5_debt-paid_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "h5_debt-paid_R" -> "?R_R" [xlabel="2", color="#8c564b", style=dashed];
    "h5_debt-paid_R" -> "(surjective-owed-of ?R ?isa ?A ?B ?b)_R" [xlabel="3", color="#8c564b", style=dashed];
    "surjective-owed-of_R" -> "(surjective-owed-of ?R ?isa ?A ?B ?b)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(surjective-owed-of ?R ?isa ?A ?B ?b)_R" -> "?R_R" [xlabel="2", color="#9467bd", style=dashed];
