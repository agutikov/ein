digraph rule_rat_sub_answer_lhs_rhs {
  rankdir=TB;
  label="rat-sub-answer"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-done_L" [label="rat-done", shape=box];
    "rat-sub_L" [label="rat-sub", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-sub ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h1_rat-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "rat-done_L" -> "h1_rat-done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_rat-done_L" -> "(rat-sub ?x ?y)_L" [xlabel="2", color="#e377c2"];
    "h1_rat-done_L" -> "?s_L" [xlabel="3", color="#e377c2"];
    "rat-sub_L" -> "(rat-sub ?x ?y)_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "(rat-sub ?x ?y)_L" -> "?x_L" [xlabel="2", color="#7f7f7f"];
    "(rat-sub ?x ?y)_L" -> "?y_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "rat-diff-of_R" [label="rat-diff-of", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "h2_rat-diff-of_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "rat-diff-of_R" -> "h2_rat-diff-of_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "h2_rat-diff-of_R" -> "?x_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h2_rat-diff-of_R" -> "?y_R" [xlabel="3", color="#bcbd22", style=dashed];
    "h2_rat-diff-of_R" -> "?s_R" [xlabel="4", color="#bcbd22", style=dashed];
  }
}
