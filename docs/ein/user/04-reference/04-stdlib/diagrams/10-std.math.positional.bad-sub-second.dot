digraph rule_bad_sub_second_lhs_rhs {
  rankdir=TB;
  label="bad-sub-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?BAD-OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB-SECOND ?x ?y ?u)_L" [shape=octagon, label="?SUB-SECOND", color="#9467bd", fontcolor="#9467bd"];
    }
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?f_L" [label="?BAD-OPERAND", color="#17becf", fontcolor="#17becf"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?x_L" [label="1", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?y_L" [label="2", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?u_L" [label="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?BAD-REQUEST ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB ?x ?y)_R" [shape=octagon, label="?SUB", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(?SUB ?x ?y)_R" -> "?f_R" [label="?BAD-REQUEST", color="#d62728", fontcolor="#d62728", style=dashed];
    "(?SUB ?x ?y)_R" -> "?x_R" [label="1", color="#1f77b4", style=dashed];
    "(?SUB ?x ?y)_R" -> "?y_R" [label="2", color="#1f77b4", style=dashed];
  }
}
