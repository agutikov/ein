    "?SUB_R" -> "(?SUB ?x ?y)_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "(?SUB ?x ?y)_R" -> "?x_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?SUB ?x ?y)_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
