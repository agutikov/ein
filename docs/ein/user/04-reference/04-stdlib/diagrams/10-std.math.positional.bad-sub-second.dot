    "?SUB-SECOND_L" -> "(?SUB-SECOND ?x ?y ?u)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?x_L" [xlabel="2", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?y_L" [xlabel="3", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?u_L" [xlabel="4", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?BAD-REQUEST_R" [label="?BAD-REQUEST", shape=diamond];
    "?SUB_R" [label="?SUB", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?BAD-REQUEST ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h2_BAD-REQUEST_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
