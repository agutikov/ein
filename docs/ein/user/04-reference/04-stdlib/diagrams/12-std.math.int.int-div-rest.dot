digraph rule_int_div_rest_lhs_rhs {
  rankdir=TB;
  label="int-div-rest"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "int-div-q_L" [label="int-div-q", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-q ?k ?s ?b ?r)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(int-div-q ?k ?s ?b ?r)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?q_L" [xlabel="3", color="#e377c2"];
    "(int-div-q ?k ?s ?b ?r)_L" -> "int-div-q_L" [xlabel="1", color="#1f77b4"];
    "(int-div-q ?k ?s ?b ?r)_L" -> "?k_L" [xlabel="2", color="#1f77b4"];
    "(int-div-q ?k ?s ?b ?r)_L" -> "?s_L" [xlabel="3", color="#1f77b4"];
    "(int-div-q ?k ?s ?b ?r)_L" -> "?b_L" [xlabel="4", color="#1f77b4"];
    "(int-div-q ?k ?s ?b ?r)_L" -> "?r_L" [xlabel="5", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "sub-run_R" [label="sub-run", shape=box];
    "int-div-r_R" [label="int-div-r", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?r_R" [label="?r", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="sub-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-r ?k ?s ?q)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_sub-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "sub-run_R" [xlabel="1", color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "(int-div-r ?k ?s ?q)_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "?b_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "?r_R" [xlabel="4", color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "0_R" [xlabel="5", color="#e377c2", style=dashed];
    "h2_sub-run_R" -> "z_R" [xlabel="6", color="#e377c2", style=dashed];
    "(int-div-r ?k ?s ?q)_R" -> "int-div-r_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "(int-div-r ?k ?s ?q)_R" -> "?k_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(int-div-r ?k ?s ?q)_R" -> "?s_R" [xlabel="3", color="#ff7f0e", style=dashed];
    "(int-div-r ?k ?s ?q)_R" -> "?q_R" [xlabel="4", color="#ff7f0e", style=dashed];
  }
}
