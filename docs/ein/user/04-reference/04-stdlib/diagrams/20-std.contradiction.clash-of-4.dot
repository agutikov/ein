digraph rule_clash_of_4_lhs_rhs {
  rankdir=TB;
  label="clash-of-4"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "relation_L" [label="relation", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?C_L" [label="?C", shape=diamond];
    "?D_L" [label="?D", shape=diamond];
    "h1_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "relation_L" -> "h1_relation_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h1_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h1_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h1_relation_L" -> "?C_L" [xlabel="5", color="#bcbd22"];
    "h1_relation_L" -> "?D_L" [xlabel="6", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "clash-4_R" [label="clash-4", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "h2_clash-4_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "clash-4_R" -> "h2_clash-4_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_clash-4_R" -> "?R_R" [xlabel="2", color="#7f7f7f", style=dashed];
  }
}
