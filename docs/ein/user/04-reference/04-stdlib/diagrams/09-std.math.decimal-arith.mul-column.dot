    "h1_mul-walk_L" -> "(n ?p ?a)_L" [xlabel="3", color="#7f7f7f"];
    "h1_mul-walk_L" -> "?m_L" [xlabel="4", color="#7f7f7f"];
    "h1_mul-walk_L" -> "?e_L" [xlabel="5", color="#7f7f7f"];
    "h1_mul-walk_L" -> "?acc_L" [xlabel="6", color="#7f7f7f"];
    "h2_md_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h2_md_L" -> "md_L" [xlabel="1", color="#bcbd22"];
    "h2_md_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h2_md_L" -> "?m_L" [xlabel="3", color="#bcbd22"];
    "h2_md_L" -> "?e_L" [xlabel="4", color="#bcbd22"];
    "h2_md_L" -> "?s_L" [xlabel="5", color="#bcbd22"];
    "h2_md_L" -> "?f_L" [xlabel="6", color="#bcbd22"];
