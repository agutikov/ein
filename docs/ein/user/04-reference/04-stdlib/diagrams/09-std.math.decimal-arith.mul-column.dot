    "(n ?p ?a)_L" -> "?p_L" [xlabel="2", color="#9467bd"];
    "(n ?p ?a)_L" -> "?a_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "mul-walk_R" [label="mul-walk", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    "b_R" [label="b", shape=box];
    "?s_R" [label="?s", shape=diamond];
    "?acc_R" [label="?acc", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="mul-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b ?s ?acc)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h3_mul-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "mul-walk_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "?k_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "?p_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "?m_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "?f_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h3_mul-walk_R" -> "(b ?s ?acc)_R" [xlabel="6", color="#7f7f7f", style=dashed];
