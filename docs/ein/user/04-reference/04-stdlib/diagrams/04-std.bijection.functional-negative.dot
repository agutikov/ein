digraph rule_functional_negative_lhs_rhs {
  rankdir=TB;
  label="functional-negative"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R_L" [label="?R", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "relation_L" [label="relation", shape=box];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?b_other_L" [label="?b_other", shape=diamond];
    "h1_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_R_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "h1_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h1_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "h2_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h2_relation_L" -> "relation_L" [xlabel="1", color="#bcbd22"];
    "h2_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h2_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h2_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h3_isa_L" -> "?b_other_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?B_L" [xlabel="3", color="#bcbd22"];
    "?b_other_L" -> "?b_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_other_R" [label="?b_other", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?b_other)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h4_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h4_not_R" -> "not_R" [xlabel="1", color="#d62728", style=dashed];
    "h4_not_R" -> "(?R ?a ?b_other)_R" [xlabel="2", color="#d62728", style=dashed];
    "(?R ?a ?b_other)_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "(?R ?a ?b_other)_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?R ?a ?b_other)_R" -> "?b_other_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
