digraph rule_rat_operand_lhs_rhs {
  rankdir=TB;
  label="rat-operand"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?i_L" [label="?i", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i ?d)_L" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "?k_L" -> "(rat ?i ?d)_L" [label="operand", color="#2ca02c", fontcolor="#2ca02c"];
    "(rat ?i ?d)_L" -> "?i_L" [label="1", color="#d62728"];
    "(rat ?i ?d)_L" -> "?d_L" [label="2", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?i_R" [label="?i", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i ?d)_R" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "?k_R" -> "(rat ?i ?d)_R" [label="operand-is", color="#17becf", fontcolor="#17becf", style=dashed];
    "(rat ?i ?d)_R" -> "?i_R" [label="1", color="#d62728", style=dashed];
    "(rat ?i ?d)_R" -> "?d_R" [label="2", color="#d62728", style=dashed];
  }
}
