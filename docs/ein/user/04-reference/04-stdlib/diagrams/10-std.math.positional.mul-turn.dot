digraph rule_mul_turn_lhs_rhs {
  rankdir=TB;
  label="mul-turn"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?MUL-RUN_L" [label="?MUL-RUN", shape=diamond];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "h1_MUL-RUN_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "?MUL-RUN_L" -> "h1_MUL-RUN_L" [xlabel="1", dir=back, color="#9467bd"];
    "h1_MUL-RUN_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "h1_MUL-RUN_L" -> "?u_L" [xlabel="3", color="#9467bd"];
    "h1_MUL-RUN_L" -> "?v_L" [xlabel="4", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?TOP-FIRST_R" [label="?TOP-FIRST", shape=diamond];
    "?MUL-DIGITS_R" [label="?MUL-DIGITS", shape=diamond];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="?TOP-FIRST ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?MUL-DIGITS ?k ?u)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_TOP-FIRST_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "?TOP-FIRST_R" -> "h2_TOP-FIRST_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h2_TOP-FIRST_R" -> "(?MUL-DIGITS ?k ?u)_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_TOP-FIRST_R" -> "?v_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_TOP-FIRST_R" -> "z_R" [xlabel="4", color="#e377c2", style=dashed];
    "?MUL-DIGITS_R" -> "(?MUL-DIGITS ?k ?u)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(?MUL-DIGITS ?k ?u)_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "(?MUL-DIGITS ?k ?u)_R" -> "?u_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
