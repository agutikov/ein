digraph rule_div_bring_first_lhs_rhs {
  rankdir=TB;
  label="div-bring-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "div-step_L" [label="div-step", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?ms_L" [label="?ms", shape=diamond];
    "b_L" [label="b", shape=box];
    "?a_L" [label="?a", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "z_L" [label="z", shape=box];
    "?w_L" [label="?w", shape=diamond];
    "nz_L" [label="nz", shape=box];
    subgraph cluster_ctx_L_0 {
      label="div-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b ?a ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_div-step_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "div-step_L" -> "h1_div-step_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_div-step_L" -> "?k_L" [xlabel="2", color="#d62728"];
    "h1_div-step_L" -> "?ms_L" [xlabel="3", color="#d62728"];
    "h1_div-step_L" -> "(b ?a ?rest)_L" [xlabel="4", color="#d62728"];
    "h1_div-step_L" -> "z_L" [xlabel="5", color="#d62728"];
    "h1_div-step_L" -> "?w_L" [xlabel="6", color="#d62728"];
    "h2_nz_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "nz_L" -> "h2_nz_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h2_nz_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "b_L" -> "(b ?a ?rest)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(b ?a ?rest)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(b ?a ?rest)_L" -> "?rest_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "div-choose_R" [label="div-choose", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?ms_R" [label="?ms", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "n_R" [label="n", shape=box];
    "z_R" [label="z", shape=box];
    "?a_R" [label="?a", shape=diamond];
    "0_R" [label="0", shape=box];
    "10_R" [label="10", shape=box];
    subgraph cluster_ctx_R_0 {
      label="div-choose ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n z ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h3_div-choose_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "div-choose_R" -> "h3_div-choose_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "?k_R" [xlabel="2", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "?ms_R" [xlabel="3", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "?rest_R" [xlabel="4", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "?w_R" [xlabel="5", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "(n z ?a)_R" [xlabel="6", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "0_R" [xlabel="7", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "10_R" [xlabel="8", color="#8c564b", style=dashed];
    "h3_div-choose_R" -> "(n z ?a)_R" [xlabel="9", color="#8c564b", style=dashed];
    "n_R" -> "(n z ?a)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(n z ?a)_R" -> "z_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n z ?a)_R" -> "?a_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
