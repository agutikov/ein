digraph rule_int_div_by_zero_lhs_rhs {
  rankdir=TB;
  label="int-div-by-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-b ?k ?a)_L" [shape=octagon, label="int-div-b", color="#17becf", fontcolor="#17becf"];
      "(int z z)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(int-div-b ?k ?a)_L" -> "(int z z)_L" [label="int-done", color="#1f77b4", fontcolor="#1f77b4"];
    "(int-div-b ?k ?a)_L" -> "?k_L" [label="1", color="#17becf"];
    "(int-div-b ?k ?a)_L" -> "?a_L" [label="2", color="#17becf"];
    "(int z z)_L" -> "z_L" [label="1", color="#17becf"];
    "(int z z)_L" -> "z_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "h1_division-by-zero_R" [shape=octagon, label="division-by-zero", color="#e377c2", fontcolor="#e377c2"];
    "h1_division-by-zero_R" -> "?k_R" [label="1", color="#e377c2", style=dashed];
  }
}
