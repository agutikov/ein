digraph rule_bin_mul_zero_lhs_rhs {
  rankdir=TB;
  label="bin-mul-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bin-mul-step_L" [label="bin-mul-step", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "bin-b_L" [label="bin-b", shape=box];
    "0_L" [label="0", shape=box];
    "?rest_L" [label="?rest", shape=diamond];
    "b2_L" [label="b2", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bin-mul-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-b 0 ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(b2 ?p ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_bin-mul-step_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_bin-mul-step_L" -> "bin-mul-step_L" [xlabel="1", color="#7f7f7f"];
    "h1_bin-mul-step_L" -> "?k_L" [xlabel="2", color="#7f7f7f"];
    "h1_bin-mul-step_L" -> "?u_L" [xlabel="3", color="#7f7f7f"];
    "h1_bin-mul-step_L" -> "(bin-b 0 ?rest)_L" [xlabel="4", color="#7f7f7f"];
    "h1_bin-mul-step_L" -> "(b2 ?p ?a)_L" [xlabel="5", color="#7f7f7f"];
    "(bin-b 0 ?rest)_L" -> "bin-b_L" [xlabel="1", color="#7f7f7f"];
    "(bin-b 0 ?rest)_L" -> "0_L" [xlabel="2", color="#7f7f7f"];
    "(bin-b 0 ?rest)_L" -> "?rest_L" [xlabel="3", color="#7f7f7f"];
    "(b2 ?p ?a)_L" -> "b2_L" [xlabel="1", color="#bcbd22"];
    "(b2 ?p ?a)_L" -> "?p_L" [xlabel="2", color="#bcbd22"];
    "(b2 ?p ?a)_L" -> "?a_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-mul-step_R" [label="bin-mul-step", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "b2_R" [label="b2", shape=box];
    "?p_R" [label="?p", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="b2 ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 ?p ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    subgraph cluster_ctx_R_1 {
      label="bin-mul-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 (b2 ?p ?a) 0)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_bin-mul-step_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h2_bin-mul-step_R" -> "bin-mul-step_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h2_bin-mul-step_R" -> "?k_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_bin-mul-step_R" -> "?u_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_bin-mul-step_R" -> "?rest_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_bin-mul-step_R" -> "(b2 (b2 ?p ?a) 0)_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "(b2 (b2 ?p ?a) 0)_R" -> "b2_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(b2 (b2 ?p ?a) 0)_R" -> "(b2 ?p ?a)_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(b2 (b2 ?p ?a) 0)_R" -> "0_R" [xlabel="3", color="#bcbd22", style=dashed];
    "(b2 ?p ?a)_R" -> "b2_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(b2 ?p ?a)_R" -> "?p_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(b2 ?p ?a)_R" -> "?a_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
