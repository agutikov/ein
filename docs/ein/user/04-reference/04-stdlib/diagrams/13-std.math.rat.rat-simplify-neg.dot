    "rat-low_L" [label="rat-low", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "int_L" [label="int", shape=box];
    "z_L" [label="z", shape=box];
    "n_L" [label="n", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-low ?k ?d)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
      "(int z (n ?b ?c))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_int-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "int-done_L" -> "h1_int-done_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_int-done_L" -> "(rat-low ?k ?d)_L" [xlabel="2", color="#1f77b4"];
    "h1_int-done_L" -> "(int z (n ?b ?c))_L" [xlabel="3", color="#1f77b4"];
    "rat-low_L" -> "(rat-low ?k ?d)_L" [xlabel="1", dir=back, color="#2ca02c"];
    "(rat-low ?k ?d)_L" -> "?k_L" [xlabel="2", color="#2ca02c"];
    "(rat-low ?k ?d)_L" -> "?d_L" [xlabel="3", color="#2ca02c"];
    "int_L" -> "(int z (n ?b ?c))_L" [xlabel="1", dir=back, color="#17becf"];
    "(int z (n ?b ?c))_L" -> "z_L" [xlabel="2", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "(n ?b ?c)_L" [xlabel="3", color="#17becf"];
    "n_L" -> "(n ?b ?c)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(n ?b ?c)_L" -> "?b_L" [xlabel="2", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "gcd-call_R" [label="gcd-call", shape=box];
    "rat-g_R" [label="rat-g", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "neg_R" [label="neg", shape=box];
    "n_R" [label="n", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-g ?k neg (n ?b ?c) ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_R_1 {
      label="gcd-call, rat-g ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_gcd-call_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "gcd-call_R" -> "h2_gcd-call_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "(rat-g ?k neg (n ?b ?c) ?d)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "(n ?b ?c)_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h2_gcd-call_R" -> "?d_R" [xlabel="4", color="#2ca02c", style=dashed];
