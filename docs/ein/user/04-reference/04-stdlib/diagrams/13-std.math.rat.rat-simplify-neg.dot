digraph rule_rat_simplify_neg_lhs_rhs {
  rankdir=TB;
  label="rat-simplify-neg"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-low ?k ?d)_L" [shape=octagon, label="rat-low", color="#2ca02c", fontcolor="#2ca02c"];
      "(int z (n ?b ?c))_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(rat-low ?k ?d)_L" -> "(int z (n ?b ?c))_L" [label="int-done", color="#1f77b4", fontcolor="#1f77b4"];
    "(rat-low ?k ?d)_L" -> "?k_L" [label="1", color="#2ca02c"];
    "(rat-low ?k ?d)_L" -> "?d_L" [label="2", color="#2ca02c"];
    "(int z (n ?b ?c))_L" -> "z_L" [label="1", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "(n ?b ?c)_L" [label="2", color="#17becf"];
    "(n ?b ?c)_L" -> "?b_L" [label="1", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "neg_R" [label="neg", shape=rectangle];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-g ?k neg (n ?b ?c) ?d)_R" [shape=octagon, label="rat-g", color="#1f77b4", fontcolor="#1f77b4"];
    }
    subgraph cluster_ctx_R_1 {
      label="gcd-call, rat-g ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_R" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "h1_gcd-call_R" [shape=octagon, label="gcd-call", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_gcd-call_R" -> "(rat-g ?k neg (n ?b ?c) ?d)_R" [label="1", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "(n ?b ?c)_R" [label="2", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "?d_R" [label="3", color="#2ca02c", style=dashed];
    "(rat-g ?k neg (n ?b ?c) ?d)_R" -> "?k_R" [label="1", color="#1f77b4", style=dashed];
    "(rat-g ?k neg (n ?b ?c) ?d)_R" -> "neg_R" [label="2", color="#1f77b4", style=dashed];
    "(rat-g ?k neg (n ?b ?c) ?d)_R" -> "(n ?b ?c)_R" [label="3", color="#1f77b4", style=dashed];
    "(rat-g ?k neg (n ?b ?c) ?d)_R" -> "?d_R" [label="4", color="#1f77b4", style=dashed];
    "(n ?b ?c)_R" -> "?b_R" [label="1", color="#9467bd", style=dashed];
    "(n ?b ?c)_R" -> "?c_R" [label="2", color="#9467bd", style=dashed];
  }
}
