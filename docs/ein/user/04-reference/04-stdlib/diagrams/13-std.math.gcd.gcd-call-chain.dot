digraph rule_gcd_call_chain_lhs_rhs {
  rankdir=TB;
  label="gcd-call-chain"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "gcd-norm-of_L" [label="gcd-norm-of", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-norm-of ?k ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(gcd-norm-of ?k ?a)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?b_L" [xlabel="3", color="#e377c2"];
    "(gcd-norm-of ?k ?a)_L" -> "gcd-norm-of_L" [xlabel="1", color="#7f7f7f"];
    "(gcd-norm-of ?k ?a)_L" -> "?k_L" [xlabel="2", color="#7f7f7f"];
    "(gcd-norm-of ?k ?a)_L" -> "?a_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "gcd-chain_R" [label="gcd-chain", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h2_gcd-chain_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "gcd-chain_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?k_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?a_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?b_R" [xlabel="4", color="#7f7f7f", style=dashed];
  }
}
