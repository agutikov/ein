digraph rule_to_dec_double_lhs_rhs {
  rankdir=TB;
  label="to-dec-double"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "to-dec-go_L" [label="to-dec-go", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "bin-b_L" [label="bin-b", shape=box];
    "?bit_L" [label="?bit", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "?acc_L" [label="?acc", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="to-dec-go ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bin-b ?bit ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h1_to-dec-go_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_to-dec-go_L" -> "to-dec-go_L" [xlabel="1", color="#bcbd22"];
    "h1_to-dec-go_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h1_to-dec-go_L" -> "(bin-b ?bit ?rest)_L" [xlabel="3", color="#bcbd22"];
    "h1_to-dec-go_L" -> "?acc_L" [xlabel="4", color="#bcbd22"];
    "(bin-b ?bit ?rest)_L" -> "bin-b_L" [xlabel="1", color="#7f7f7f"];
    "(bin-b ?bit ?rest)_L" -> "?bit_L" [xlabel="2", color="#7f7f7f"];
    "(bin-b ?bit ?rest)_L" -> "?rest_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "add-walk_R" [label="add-walk", shape=box];
    "doubling_R" [label="doubling", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?acc_R" [label="?acc", shape=diamond];
    "?bit_R" [label="?bit", shape=diamond];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(doubling ?b ?rest)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_add-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_add-walk_R" -> "add-walk_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "(doubling ?b ?rest)_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "?acc_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "?acc_R" [xlabel="4", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "?bit_R" [xlabel="5", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "z_R" [xlabel="6", color="#17becf", style=dashed];
    "(doubling ?b ?rest)_R" -> "doubling_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(doubling ?b ?rest)_R" -> "?b_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(doubling ?b ?rest)_R" -> "?rest_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
