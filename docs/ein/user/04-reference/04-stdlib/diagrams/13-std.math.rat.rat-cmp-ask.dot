digraph rule_rat_cmp_ask_lhs_rhs {
  rankdir=TB;
  label="rat-cmp-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="rat-cmp", color="#1f77b4", fontcolor="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-first (rat-cmp ?x ?y) ?y))_R" [shape=octagon, label="rat-of", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-cmp ?x ?y)_R" [shape=octagon, label="rat-cmp", color="#1f77b4", fontcolor="#1f77b4"];
    }
    subgraph cluster_ctx_R_2 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-first (rat-cmp ?x ?y) ?y)_R" [shape=octagon, label="rat-first", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "(rat-of (rat-first (rat-cmp ?x ?y) ?y))_R" -> "?x_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(rat-of (rat-first (rat-cmp ?x ?y) ?y))_R" -> "(rat-first (rat-cmp ?x ?y) ?y)_R" [label="1", color="#2ca02c", style=dashed];
    "(rat-first (rat-cmp ?x ?y) ?y)_R" -> "(rat-cmp ?x ?y)_R" [label="1", color="#bcbd22", style=dashed];
    "(rat-first (rat-cmp ?x ?y) ?y)_R" -> "?y_R" [label="2", color="#bcbd22", style=dashed];
    "(rat-cmp ?x ?y)_R" -> "?x_R" [label="1", color="#1f77b4", style=dashed];
    "(rat-cmp ?x ?y)_R" -> "?y_R" [label="2", color="#1f77b4", style=dashed];
  }
}
