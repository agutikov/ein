digraph rule_strip_top_lhs_rhs {
  rankdir=TB;
  label="strip-top"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?STRIP_L" [label="?STRIP", shape=diamond];
    "?k_L" [label="?k", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    "?NZ_L" [label="?NZ", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?STRIP ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?B ?a ?r)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_STRIP_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "?STRIP_L" -> "h1_STRIP_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_STRIP_L" -> "?k_L" [xlabel="2", color="#ff7f0e"];
    "h1_STRIP_L" -> "(?B ?a ?r)_L" [xlabel="3", color="#ff7f0e"];
    "h2_NZ_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "?NZ_L" -> "h2_NZ_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h2_NZ_L" -> "?a_L" [xlabel="2", color="#ff7f0e"];
    "?B_L" -> "(?B ?a ?r)_L" [xlabel="1", dir=back, color="#2ca02c"];
    "(?B ?a ?r)_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "(?B ?a ?r)_L" -> "?r_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?TURN_R" [label="?TURN", shape=diamond];
    "?k_R" [label="?k", shape=diamond];
    "?B_R" [label="?B", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?r_R" [label="?r", shape=diamond];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="?TURN ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?B ?a ?r)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h3_TURN_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "?TURN_R" -> "h3_TURN_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "h3_TURN_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h3_TURN_R" -> "(?B ?a ?r)_R" [xlabel="3", color="#9467bd", style=dashed];
    "h3_TURN_R" -> "z_R" [xlabel="4", color="#9467bd", style=dashed];
    "?B_R" -> "(?B ?a ?r)_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(?B ?a ?r)_R" -> "?a_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(?B ?a ?r)_R" -> "?r_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
