digraph rule_one_value_lhs_rhs {
  rankdir=TB;
  label="one-value"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "val_L" [label="val", shape=box];
    "?w_L" [label="?w", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_val_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "val_L" -> "h1_val_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_val_L" -> "?w_L" [xlabel="2", color="#1f77b4"];
    "h1_val_L" -> "?x_L" [xlabel="3", color="#1f77b4"];
    "h2_val_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "val_L" -> "h2_val_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h2_val_L" -> "?w_L" [xlabel="2", color="#1f77b4"];
    "h2_val_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
    "?x_L" -> "?y_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h3_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h3_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
