digraph rule_bin_numeral_bit_lhs_rhs {
  rankdir=TB;
  label="bin-numeral-bit"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?w_L" [label="?w", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "0_L" [label="0", shape=rectangle];
    "1_L" [label="1", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="bin-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 ?p ?a)_L" [shape=octagon, label="b2", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "?w_L" -> "(b2 ?p ?a)_L" [label="bin-check", color="#1f77b4", fontcolor="#1f77b4"];
    "?a_L" -> "0_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    "?a_L" -> "1_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    "(b2 ?p ?a)_L" -> "?p_L" [label="1", color="#bcbd22"];
    "(b2 ?p ?a)_L" -> "?a_L" [label="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?p_R" [label="?p", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not-binary ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 ?p ?a)_R" [shape=octagon, label="b2", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "(b2 ?p ?a)_R" -> "?a_R" [label="not-binary", color="#bcbd22", fontcolor="#bcbd22", style=dashed];
    "(b2 ?p ?a)_R" -> "?p_R" [label="1", color="#bcbd22", style=dashed];
    "(b2 ?p ?a)_R" -> "?a_R" [label="2", color="#bcbd22", style=dashed];
  }
}
