      label="not-decimal ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n 0 ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_not-decimal_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
