digraph rule_gcd_call_first_lhs_rhs {
  rankdir=TB;
  label="gcd-call-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-run_L" [label="gcd-run", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_gcd-run_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "gcd-run_L" -> "h1_gcd-run_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_gcd-run_L" -> "?k_L" [xlabel="2", color="#bcbd22"];
    "h1_gcd-run_L" -> "?x_L" [xlabel="3", color="#bcbd22"];
    "h1_gcd-run_L" -> "?y_L" [xlabel="4", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "add-run_R" [label="add-run", shape=box];
    "gcd-norm_R" [label="gcd-norm", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "z_R" [label="z", shape=box];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-norm ?k ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h2_add-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "add-run_R" -> "h2_add-run_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "(gcd-norm ?k ?y)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?x_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "gcd-norm_R" -> "(gcd-norm ?k ?y)_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "(gcd-norm ?k ?y)_R" -> "?k_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(gcd-norm ?k ?y)_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
