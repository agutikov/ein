digraph rule_gcd_call_first_lhs_rhs {
  rankdir=TB;
  label="gcd-call-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-call_L" [label="gcd-call", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_gcd-call_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_gcd-call_L" -> "gcd-call_L" [xlabel="1", color="#2ca02c"];
    "h1_gcd-call_L" -> "?k_L" [xlabel="2", color="#2ca02c"];
    "h1_gcd-call_L" -> "?x_L" [xlabel="3", color="#2ca02c"];
    "h1_gcd-call_L" -> "?y_L" [xlabel="4", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "add-walk_R" [label="add-walk", shape=box];
    "gcd-norm_R" [label="gcd-norm", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "z_R" [label="z", shape=box];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-norm ?k ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h2_add-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_add-walk_R" -> "add-walk_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "(gcd-norm ?k ?y)_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "?x_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "z_R" [xlabel="4", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "0_R" [xlabel="5", color="#17becf", style=dashed];
    "h2_add-walk_R" -> "z_R" [xlabel="6", color="#17becf", style=dashed];
    "(gcd-norm ?k ?y)_R" -> "gcd-norm_R" [xlabel="1", color="#1f77b4", style=dashed];
    "(gcd-norm ?k ?y)_R" -> "?k_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(gcd-norm ?k ?y)_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
