digraph rule_gcd_step_lhs_rhs {
  rankdir=TB;
  label="gcd-step"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-chain ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "h1_gcd-chain_L" [shape=octagon, label="gcd-chain", color="#7f7f7f", fontcolor="#7f7f7f"];
    "h1_gcd-chain_L" -> "?k_L" [label="1", color="#7f7f7f"];
    "h1_gcd-chain_L" -> "?a_L" [label="2", color="#7f7f7f"];
    "h1_gcd-chain_L" -> "(n ?b ?c)_L" [label="3", color="#7f7f7f"];
    "(n ?b ?c)_L" -> "?b_L" [label="1", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="div-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-rem ?k (n ?b ?c))_R" [shape=octagon, label="gcd-rem", color="#d62728", fontcolor="#d62728"];
    }
    subgraph cluster_ctx_R_1 {
      label="div-call, gcd-rem ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_R" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "h2_div-call_R" [shape=octagon, label="div-call", color="#bcbd22", fontcolor="#bcbd22"];
    "h2_div-call_R" -> "(gcd-rem ?k (n ?b ?c))_R" [label="1", color="#bcbd22", style=dashed];
    "h2_div-call_R" -> "?a_R" [label="2", color="#bcbd22", style=dashed];
    "h2_div-call_R" -> "(n ?b ?c)_R" [label="3", color="#bcbd22", style=dashed];
    "(gcd-rem ?k (n ?b ?c))_R" -> "?k_R" [label="1", color="#d62728", style=dashed];
    "(gcd-rem ?k (n ?b ?c))_R" -> "(n ?b ?c)_R" [label="2", color="#d62728", style=dashed];
    "(n ?b ?c)_R" -> "?b_R" [label="1", color="#9467bd", style=dashed];
    "(n ?b ?c)_R" -> "?c_R" [label="2", color="#9467bd", style=dashed];
  }
}
