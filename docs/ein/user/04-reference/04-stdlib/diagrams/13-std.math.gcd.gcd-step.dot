digraph rule_gcd_step_lhs_rhs {
  rankdir=TB;
  label="gcd-step"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-chain_L" [label="gcd-chain", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "n_L" [label="n", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-chain ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_gcd-chain_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "gcd-chain_L" -> "h1_gcd-chain_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_gcd-chain_L" -> "?k_L" [xlabel="2", color="#7f7f7f"];
    "h1_gcd-chain_L" -> "?a_L" [xlabel="3", color="#7f7f7f"];
    "h1_gcd-chain_L" -> "(n ?b ?c)_L" [xlabel="4", color="#7f7f7f"];
    "n_L" -> "(n ?b ?c)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(n ?b ?c)_L" -> "?b_L" [xlabel="2", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "div-run_R" [label="div-run", shape=box];
    "gcd-rem_R" [label="gcd-rem", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "n_R" [label="n", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="div-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-rem ?k (n ?b ?c))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_R_1 {
      label="div-run, gcd-rem ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_div-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "div-run_R" -> "h2_div-run_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h2_div-run_R" -> "(gcd-rem ?k (n ?b ?c))_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_div-run_R" -> "?a_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_div-run_R" -> "(n ?b ?c)_R" [xlabel="4", color="#e377c2", style=dashed];
    "gcd-rem_R" -> "(gcd-rem ?k (n ?b ?c))_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "(gcd-rem ?k (n ?b ?c))_R" -> "?k_R" [xlabel="2", color="#d62728", style=dashed];
    "(gcd-rem ?k (n ?b ?c))_R" -> "(n ?b ?c)_R" [xlabel="3", color="#d62728", style=dashed];
    "n_R" -> "(n ?b ?c)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(n ?b ?c)_R" -> "?b_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n ?b ?c)_R" -> "?c_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
