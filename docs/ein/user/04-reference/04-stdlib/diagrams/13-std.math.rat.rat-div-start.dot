digraph rule_rat_div_start_lhs_rhs {
  rankdir=TB;
  label="rat-div-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    "?e_L" [label="?e", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" [shape=octagon, label="rat-second", color="#8c564b", fontcolor="#8c564b"];
    }
    subgraph cluster_ctx_L_1 {
      label="rat-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-div ?x ?y)_L" [shape=octagon, label="rat-div", color="#d62728", fontcolor="#d62728"];
    }
    "h1_rat-operand-is_L" [shape=octagon, label="rat-operand-is", color="#1f77b4", fontcolor="#1f77b4"];
    "h1_rat-operand-is_L" -> "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" [label="1", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?q_L" [label="2", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?m_L" [label="3", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?e_L" [label="4", color="#1f77b4"];
    "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" -> "(rat-div ?x ?y)_L" [label="1", color="#8c564b"];
    "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" -> "?p_L" [label="2", color="#8c564b"];
    "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" -> "?n_L" [label="3", color="#8c564b"];
    "(rat-second (rat-div ?x ?y) ?p ?n ?d)_L" -> "?d_L" [label="4", color="#8c564b"];
    "(rat-div ?x ?y)_L" -> "?x_L" [label="1", color="#d62728"];
    "(rat-div ?x ?y)_L" -> "?y_L" [label="2", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" [shape=octagon, label="rat-div-by", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-div-by ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-div ?x ?y)_R" [shape=octagon, label="rat-div", color="#d62728", fontcolor="#d62728"];
    }
    "h2_int-norm_R" [shape=octagon, label="int-norm", color="#e377c2", fontcolor="#e377c2"];
    "h2_int-norm_R" -> "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" [label="1", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?q_R" [label="2", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?m_R" [label="3", color="#e377c2", style=dashed];
    "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" -> "(rat-div ?x ?y)_R" [label="1", color="#9467bd", style=dashed];
    "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" -> "?p_R" [label="2", color="#9467bd", style=dashed];
    "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" -> "?n_R" [label="3", color="#9467bd", style=dashed];
    "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" -> "?d_R" [label="4", color="#9467bd", style=dashed];
    "(rat-div-by (rat-div ?x ?y) ?p ?n ?d ?e)_R" -> "?e_R" [label="5", color="#9467bd", style=dashed];
    "(rat-div ?x ?y)_R" -> "?x_R" [label="1", color="#d62728", style=dashed];
    "(rat-div ?x ?y)_R" -> "?y_R" [label="2", color="#d62728", style=dashed];
  }
}
