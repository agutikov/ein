digraph rule_gcd_ask_second_lhs_rhs {
  rankdir=TB;
  label="gcd-ask-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?r_L" [label="?r", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-first ?r ?y)_L" [shape=octagon, label="gcd-first", color="#e377c2", fontcolor="#e377c2"];
    }
    "(gcd-first ?r ?y)_L" -> "?u_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(gcd-first ?r ?y)_L" -> "?r_L" [label="1", color="#e377c2"];
    "(gcd-first ?r ?y)_L" -> "?y_L" [label="2", color="#e377c2"];
  }
  subgraph cluster_rhs { label="assert";
    "?r_R" [label="?r", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-second ?r ?u)_R" [shape=octagon, label="gcd-second", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(gcd-second ?r ?u)_R" -> "?y_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(gcd-second ?r ?u)_R" -> "?r_R" [label="1", color="#1f77b4", style=dashed];
    "(gcd-second ?r ?u)_R" -> "?u_R" [label="2", color="#1f77b4", style=dashed];
  }
}
