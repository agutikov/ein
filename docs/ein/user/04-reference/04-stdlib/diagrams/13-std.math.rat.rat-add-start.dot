    "(rat-second (rat-add ?x ?y) ?p ?n ?d)_L" -> "?p_L" [label="2", color="#8c564b"];
    "(rat-second (rat-add ?x ?y) ?p ?n ?d)_L" -> "?n_L" [label="3", color="#8c564b"];
    "(rat-second (rat-add ?x ?y) ?p ?n ?d)_L" -> "?d_L" [label="4", color="#8c564b"];
