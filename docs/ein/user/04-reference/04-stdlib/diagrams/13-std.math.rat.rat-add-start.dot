    "(rat-add ?x ?y)_L" -> "?y_L" [label="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
