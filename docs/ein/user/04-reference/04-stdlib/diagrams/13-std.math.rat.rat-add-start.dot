    "?n_R" [label="?n", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="rat-cross ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-sum-num (rat-add ?x ?y) ?d ?e)_R" [shape=octagon, label="rat-sum-num", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-sum-num ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-add ?x ?y)_R" [shape=octagon, label="rat-add", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "h2_rat-cross_R" [shape=octagon, label="rat-cross", color="#d62728", fontcolor="#d62728"];
    "h2_rat-cross_R" -> "(rat-sum-num (rat-add ?x ?y) ?d ?e)_R" [label="1", color="#d62728", style=dashed];
