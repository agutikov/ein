digraph rule_rat_norm_numerator_lhs_rhs {
  rankdir=TB;
  label="rat-norm-numerator"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-norm_L" [label="rat-norm", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "h1_rat-norm_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "rat-norm_L" -> "h1_rat-norm_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_rat-norm_L" -> "?k_L" [xlabel="2", color="#bcbd22"];
    "h1_rat-norm_L" -> "?p_L" [xlabel="3", color="#bcbd22"];
    "h1_rat-norm_L" -> "?n_L" [xlabel="4", color="#bcbd22"];
    "h1_rat-norm_L" -> "?d_L" [xlabel="5", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm_R" [label="int-norm", shape=box];
    "rat-num_R" [label="rat-num", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-num ?k ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    }
    "h2_int-norm_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "int-norm_R" -> "h2_int-norm_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "(rat-num ?k ?d)_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?p_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?n_R" [xlabel="4", color="#e377c2", style=dashed];
    "rat-num_R" -> "(rat-num ?k ?d)_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "(rat-num ?k ?d)_R" -> "?k_R" [xlabel="2", color="#8c564b", style=dashed];
    "(rat-num ?k ?d)_R" -> "?d_R" [xlabel="3", color="#8c564b", style=dashed];
  }
}
