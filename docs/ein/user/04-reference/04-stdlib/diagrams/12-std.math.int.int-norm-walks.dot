    "h1_int-norm_L" -> "?k_L" [xlabel="2", color="#e377c2"];
    "h1_int-norm_L" -> "?p_L" [xlabel="3", color="#e377c2"];
    "h1_int-norm_L" -> "?n_L" [xlabel="4", color="#e377c2"];
  }
  subgraph cluster_rhs { label="assert";
    "sub-walk_R" [label="sub-walk", shape=box];
    "int-plus_R" [label="int-plus", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    "int-minus_R" [label="int-minus", shape=box];
    subgraph cluster_ctx_R_0 {
      label="sub-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-plus ?k)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
      "(int-minus ?k)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_sub-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "sub-walk_R" [xlabel="1", color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "(int-plus ?k)_R" [xlabel="2", color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "?p_R" [xlabel="3", color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "?n_R" [xlabel="4", color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "0_R" [xlabel="5", color="#8c564b", style=dashed];
    "h2_sub-walk_R" -> "z_R" [xlabel="6", color="#8c564b", style=dashed];
    "h3_sub-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "sub-walk_R" [xlabel="1", color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "(int-minus ?k)_R" [xlabel="2", color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "?n_R" [xlabel="3", color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "?p_R" [xlabel="4", color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "0_R" [xlabel="5", color="#8c564b", style=dashed];
    "h3_sub-walk_R" -> "z_R" [xlabel="6", color="#8c564b", style=dashed];
    "(int-plus ?k)_R" -> "int-plus_R" [xlabel="1", color="#9467bd", style=dashed];
    "(int-plus ?k)_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "(int-minus ?k)_R" -> "int-minus_R" [xlabel="1", color="#9467bd", style=dashed];
    "(int-minus ?k)_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
  }
