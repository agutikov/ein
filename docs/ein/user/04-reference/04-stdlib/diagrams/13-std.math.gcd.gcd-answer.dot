digraph rule_gcd_answer_lhs_rhs {
  rankdir=TB;
  label="gcd-answer"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gcd-done_L" [label="gcd-done", shape=box];
    "gcd_L" [label="gcd", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?g_L" [label="?g", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_gcd-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_gcd-done_L" -> "gcd-done_L" [xlabel="1", color="#7f7f7f"];
    "h1_gcd-done_L" -> "(gcd ?x ?y)_L" [xlabel="2", color="#7f7f7f"];
    "h1_gcd-done_L" -> "?g_L" [xlabel="3", color="#7f7f7f"];
    "(gcd ?x ?y)_L" -> "gcd_L" [xlabel="1", color="#2ca02c"];
    "(gcd ?x ?y)_L" -> "?x_L" [xlabel="2", color="#2ca02c"];
    "(gcd ?x ?y)_L" -> "?y_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "gcd-of_R" [label="gcd-of", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?g_R" [label="?g", shape=diamond];
    "h2_gcd-of_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "h2_gcd-of_R" -> "gcd-of_R" [xlabel="1", color="#17becf", style=dashed];
    "h2_gcd-of_R" -> "?x_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_gcd-of_R" -> "?y_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_gcd-of_R" -> "?g_R" [xlabel="4", color="#17becf", style=dashed];
  }
}
