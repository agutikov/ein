  subgraph cluster_rhs { label="assert";
    "?PRODUCT-OF_R" [label="?PRODUCT-OF", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "h2_PRODUCT-OF_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "h2_PRODUCT-OF_R" -> "?PRODUCT-OF_R" [xlabel="1", color="#e377c2", style=dashed];
    "h2_PRODUCT-OF_R" -> "?x_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_PRODUCT-OF_R" -> "?y_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_PRODUCT-OF_R" -> "?p_R" [xlabel="4", color="#e377c2", style=dashed];
  }
