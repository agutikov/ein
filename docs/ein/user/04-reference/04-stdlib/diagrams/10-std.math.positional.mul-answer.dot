    }
    "h1_DONE_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_DONE_L" -> "?DONE_L" [xlabel="1", color="#9467bd"];
    "h1_DONE_L" -> "(?PRODUCT ?x ?y)_L" [xlabel="2", color="#9467bd"];
    "h1_DONE_L" -> "?p_L" [xlabel="3", color="#9467bd"];
    "(?PRODUCT ?x ?y)_L" -> "?PRODUCT_L" [xlabel="1", color="#bcbd22"];
