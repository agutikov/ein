digraph rule_sub_start_lhs_rhs {
  rankdir=TB;
  label="sub-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?OPERAND-IS_L" [label="?OPERAND-IS", shape=diamond];
    "?SUB-SECOND_L" [label="?SUB-SECOND", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?OPERAND-IS ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB-SECOND ?x ?y ?u)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_OPERAND-IS_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?OPERAND-IS_L" -> "h1_OPERAND-IS_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_OPERAND-IS_L" -> "(?SUB-SECOND ?x ?y ?u)_L" [xlabel="2", color="#bcbd22"];
    "h1_OPERAND-IS_L" -> "?v_L" [xlabel="3", color="#bcbd22"];
    "?SUB-SECOND_L" -> "(?SUB-SECOND ?x ?y ?u)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?x_L" [xlabel="2", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?y_L" [xlabel="3", color="#9467bd"];
    "(?SUB-SECOND ?x ?y ?u)_L" -> "?u_L" [xlabel="4", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?SUB-RUN_R" [label="?SUB-RUN", shape=diamond];
    "?DIFFERENCE_R" [label="?DIFFERENCE", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    "?SHORTFALL_R" [label="?SHORTFALL", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?SUB-RUN ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIFFERENCE ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
      "(?SHORTFALL ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_SUB-RUN_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "?SUB-RUN_R" -> "h2_SUB-RUN_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h2_SUB-RUN_R" -> "(?DIFFERENCE ?x ?y)_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_SUB-RUN_R" -> "?u_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_SUB-RUN_R" -> "?v_R" [xlabel="4", color="#17becf", style=dashed];
    "h2_SUB-RUN_R" -> "0_R" [xlabel="5", color="#17becf", style=dashed];
    "h2_SUB-RUN_R" -> "z_R" [xlabel="6", color="#17becf", style=dashed];
    "h3_SUB-RUN_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "?SUB-RUN_R" -> "h3_SUB-RUN_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h3_SUB-RUN_R" -> "(?SHORTFALL ?x ?y)_R" [xlabel="2", color="#17becf", style=dashed];
    "h3_SUB-RUN_R" -> "?v_R" [xlabel="3", color="#17becf", style=dashed];
    "h3_SUB-RUN_R" -> "?u_R" [xlabel="4", color="#17becf", style=dashed];
    "h3_SUB-RUN_R" -> "0_R" [xlabel="5", color="#17becf", style=dashed];
    "h3_SUB-RUN_R" -> "z_R" [xlabel="6", color="#17becf", style=dashed];
    "?DIFFERENCE_R" -> "(?DIFFERENCE ?x ?y)_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "(?DIFFERENCE ?x ?y)_R" -> "?x_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(?DIFFERENCE ?x ?y)_R" -> "?y_R" [xlabel="3", color="#ff7f0e", style=dashed];
    "?SHORTFALL_R" -> "(?SHORTFALL ?x ?y)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(?SHORTFALL ?x ?y)_R" -> "?x_R" [xlabel="2", color="#9467bd", style=dashed];
    "(?SHORTFALL ?x ?y)_R" -> "?y_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
