digraph rule_clash_0_lhs_rhs {
  rankdir=TB;
  label="clash-0"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R_L" [label="?R", shape=diamond];
    "not_L" [label="not", shape=box];
    "(?R)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_not_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "not_L" -> "h1_not_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_not_L" -> "(?R)_L" [xlabel="2", color="#d62728"];
    "?R_L" -> "(?R)_L" [xlabel="1", dir=back, color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h2_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h2_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
