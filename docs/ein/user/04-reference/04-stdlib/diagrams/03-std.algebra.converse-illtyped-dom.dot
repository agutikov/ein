digraph rule_converse_illtyped_dom_lhs_rhs {
  rankdir=TB;
  label="converse-illtyped-dom"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "converse_L" [label="converse", shape=box];
    "?R1_L" [label="?R1", shape=diamond];
    "?R2_L" [label="?R2", shape=diamond];
    "relation_L" [label="relation", shape=box];
    "?D1_L" [label="?D1", shape=diamond];
    "?Rn1_L" [label="?Rn1", shape=diamond];
    "?D2_L" [label="?D2", shape=diamond];
    "?Rn2_L" [label="?Rn2", shape=diamond];
    "?isR*_L" [label="?isR*", shape=diamond];
    "h1_converse_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_converse_L" -> "converse_L" [xlabel="1", color="#2ca02c"];
    "h1_converse_L" -> "?R1_L" [xlabel="2", color="#2ca02c"];
    "h1_converse_L" -> "?R2_L" [xlabel="3", color="#2ca02c"];
    "h2_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h2_relation_L" -> "relation_L" [xlabel="1", color="#bcbd22"];
    "h2_relation_L" -> "?R1_L" [xlabel="2", color="#bcbd22"];
    "h2_relation_L" -> "?D1_L" [xlabel="3", color="#bcbd22"];
    "h2_relation_L" -> "?Rn1_L" [xlabel="4", color="#bcbd22"];
    "h3_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_relation_L" -> "relation_L" [xlabel="1", color="#bcbd22"];
    "h3_relation_L" -> "?R2_L" [xlabel="2", color="#bcbd22"];
    "h3_relation_L" -> "?D2_L" [xlabel="3", color="#bcbd22"];
    "h3_relation_L" -> "?Rn2_L" [xlabel="4", color="#bcbd22"];
    "?Rn1_L" -> "?D2_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "h4_isR*_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "h4_isR*_L" -> "?isR*_L" [xlabel="1", color="#1f77b4"];
      "h4_isR*_L" -> "?Rn1_L" [xlabel="2", color="#1f77b4"];
      "h4_isR*_L" -> "?D2_L" [xlabel="3", color="#1f77b4"];
    }
    subgraph cluster_absent_L_1 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "h5_isR*_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "h5_isR*_L" -> "?isR*_L" [xlabel="1", color="#1f77b4"];
      "h5_isR*_L" -> "?D2_L" [xlabel="2", color="#1f77b4"];
      "h5_isR*_L" -> "?Rn1_L" [xlabel="3", color="#1f77b4"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h6_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h6_false_R" -> "false_R" [xlabel="1", color="#2ca02c", style=dashed];
  }
}
