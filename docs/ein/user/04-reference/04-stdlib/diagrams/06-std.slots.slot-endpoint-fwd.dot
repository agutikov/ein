digraph rule_slot_endpoint_fwd_lhs_rhs {
  rankdir=TB;
  label="slot-endpoint-fwd"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?S_L" [label="?S", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?p1_L" [label="?p1", shape=diamond];
    "?PT_L" [label="?PT", shape=diamond];
    "h1_S_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "?S_L" -> "h1_S_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_S_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "h1_S_L" -> "?b_L" [xlabel="3", color="#2ca02c"];
    "h2_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h2_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_isa_L" -> "?p1_L" [xlabel="2", color="#bcbd22"];
    "h2_isa_L" -> "?PT_L" [xlabel="3", color="#bcbd22"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "?p2_L" [label="?p2", shape=diamond];
      "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "?isa_L" -> "h3_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
      "h3_isa_L" -> "?p2_L" [xlabel="2", color="#bcbd22"];
      "h3_isa_L" -> "?PT_L" [xlabel="3", color="#bcbd22"];
      "h4_S_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
      "?S_L" -> "h4_S_L" [xlabel="1", dir=back, color="#2ca02c"];
      "h4_S_L" -> "?p2_L" [xlabel="2", color="#2ca02c"];
      "h4_S_L" -> "?p1_L" [xlabel="3", color="#2ca02c"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?p1_R" [label="?p1", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?b ?p1)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h5_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "not_R" -> "h5_not_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h5_not_R" -> "(?R ?b ?p1)_R" [xlabel="2", color="#d62728", style=dashed];
    "?R_R" -> "(?R ?b ?p1)_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "(?R ?b ?p1)_R" -> "?b_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?R ?b ?p1)_R" -> "?p1_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
