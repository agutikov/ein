digraph rule_let_to_name_lhs_rhs {
  rankdir=TB;
  label="let-to-name"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?LET_L" [label="?LET", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "?NAMED_L" [label="?NAMED", shape=diamond];
    "h1_LET_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_LET_L" -> "?LET_L" [xlabel="1", color="#7f7f7f"];
    "h1_LET_L" -> "?x_L" [xlabel="2", color="#7f7f7f"];
    "h1_LET_L" -> "?v_L" [xlabel="3", color="#7f7f7f"];
    "h2_NAMED_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h2_NAMED_L" -> "?NAMED_L" [xlabel="1", color="#bcbd22"];
    "h2_NAMED_L" -> "?v_L" [xlabel="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?MALFORMED_R" [label="?MALFORMED", shape=diamond];
    "?LET_R" [label="?LET", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?MALFORMED ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?LET ?x ?v)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h3_MALFORMED_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "h3_MALFORMED_R" -> "?MALFORMED_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "h3_MALFORMED_R" -> "(?LET ?x ?v)_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(?LET ?x ?v)_R" -> "?LET_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "(?LET ?x ?v)_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "(?LET ?x ?v)_R" -> "?v_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
}
