digraph rule_int_mul_start_lhs_rhs {
  rankdir=TB;
  label="int-mul-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-second ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-mul ?x ?y)_L" [shape=octagon, label="int-mul", color="#e377c2", fontcolor="#e377c2"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-second (int-mul ?x ?y) ?p ?n)_L" [shape=octagon, label="int-second", color="#bcbd22", fontcolor="#bcbd22"];
      "(int ?q ?m)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(int-second (int-mul ?x ?y) ?p ?n)_L" -> "(int ?q ?m)_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(int-second (int-mul ?x ?y) ?p ?n)_L" -> "(int-mul ?x ?y)_L" [label="1", color="#bcbd22"];
    "(int-second (int-mul ?x ?y) ?p ?n)_L" -> "?p_L" [label="2", color="#bcbd22"];
    "(int-second (int-mul ?x ?y) ?p ?n)_L" -> "?n_L" [label="3", color="#bcbd22"];
    "(int-mul ?x ?y)_L" -> "?x_L" [label="1", color="#e377c2"];
    "(int-mul ?x ?y)_L" -> "?y_L" [label="2", color="#e377c2"];
    "(int ?q ?m)_L" -> "?q_L" [label="1", color="#17becf"];
    "(int ?q ?m)_L" -> "?m_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-mul-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-mul ?x ?y)_R" [shape=octagon, label="int-mul", color="#e377c2", fontcolor="#e377c2"];
    }
    "h1_int-mul-call_R" [shape=octagon, label="int-mul-call", color="#e377c2", fontcolor="#e377c2"];
    "h1_int-mul-call_R" -> "(int-mul ?x ?y)_R" [label="1", color="#e377c2", style=dashed];
    "h1_int-mul-call_R" -> "?p_R" [label="2", color="#e377c2", style=dashed];
    "h1_int-mul-call_R" -> "?n_R" [label="3", color="#e377c2", style=dashed];
    "h1_int-mul-call_R" -> "?q_R" [label="4", color="#e377c2", style=dashed];
    "h1_int-mul-call_R" -> "?m_R" [label="5", color="#e377c2", style=dashed];
    "(int-mul ?x ?y)_R" -> "?x_R" [label="1", color="#e377c2", style=dashed];
    "(int-mul ?x ?y)_R" -> "?y_R" [label="2", color="#e377c2", style=dashed];
  }
}
