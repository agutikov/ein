digraph rule_int_div_divisor_lhs_rhs {
  rankdir=TB;
  label="int-div-divisor"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-done_L" [label="int-done", shape=box];
    "int-div-a_L" [label="int-div-a", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-a ?k ?q ?m)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_int-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_int-done_L" -> "int-done_L" [xlabel="1", color="#1f77b4"];
    "h1_int-done_L" -> "(int-div-a ?k ?q ?m)_L" [xlabel="2", color="#1f77b4"];
    "h1_int-done_L" -> "?a_L" [xlabel="3", color="#1f77b4"];
    "(int-div-a ?k ?q ?m)_L" -> "int-div-a_L" [xlabel="1", color="#bcbd22"];
    "(int-div-a ?k ?q ?m)_L" -> "?k_L" [xlabel="2", color="#bcbd22"];
    "(int-div-a ?k ?q ?m)_L" -> "?q_L" [xlabel="3", color="#bcbd22"];
    "(int-div-a ?k ?q ?m)_L" -> "?m_L" [xlabel="4", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm_R" [label="int-norm", shape=box];
    "int-div-b_R" [label="int-div-b", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-b ?k ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_int-norm_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "int-norm_R" [xlabel="1", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "(int-div-b ?k ?a)_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?q_R" [xlabel="3", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?m_R" [xlabel="4", color="#e377c2", style=dashed];
    "(int-div-b ?k ?a)_R" -> "int-div-b_R" [xlabel="1", color="#17becf", style=dashed];
    "(int-div-b ?k ?a)_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "(int-div-b ?k ?a)_R" -> "?a_R" [xlabel="3", color="#17becf", style=dashed];
  }
