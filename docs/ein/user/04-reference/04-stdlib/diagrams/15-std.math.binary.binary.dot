digraph rule_binary_lhs_rhs {
  rankdir=TB;
  label="binary"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "h1_#empty_L" [shape=octagon, label="#empty", color="#17becf", fontcolor="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-nz_R" [label="bin-nz", shape=rectangle];
    "b2_R" [label="b2", shape=rectangle];
    "bin-named_R" [label="bin-named", shape=rectangle];
    "bin-check_R" [label="bin-check", shape=rectangle];
    "bin-valid_R" [label="bin-valid", shape=rectangle];
    "not-binary_R" [label="not-binary", shape=rectangle];
    "binary-rule_R" [label="binary-rule", shape=rectangle];
    "z_R" [label="z", shape=rectangle];
    "arith_R" [label="arith", shape=rectangle];
    "bin-numeral-step_R" [label="bin-numeral-step", shape=rectangle];
    "bin-numeral-step-zero_R" [label="bin-numeral-step-zero", shape=rectangle];
    "bin-numeral-valid_R" [label="bin-numeral-valid", shape=rectangle];
    "bin-numeral-bit_R" [label="bin-numeral-bit", shape=rectangle];
    "bin-numeral-prefix-bit_R" [label="bin-numeral-prefix-bit", shape=rectangle];
    "bin-numeral-prefix-zero_R" [label="bin-numeral-prefix-zero", shape=rectangle];
    "bin-numeral-prefix-named_R" [label="bin-numeral-prefix-named", shape=rectangle];
    "not-binary-is-false_R" [label="not-binary-is-false", shape=rectangle];
    "h2___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h2___closed___R" -> "bin-nz_R" [label="1", color="#e377c2", style=dashed];
    "h3___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h3___closed___R" -> "b2_R" [label="1", color="#e377c2", style=dashed];
    "h4___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h4___closed___R" -> "bin-named_R" [label="1", color="#e377c2", style=dashed];
    "h5___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h5___closed___R" -> "bin-check_R" [label="1", color="#e377c2", style=dashed];
    "h6___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h6___closed___R" -> "bin-valid_R" [label="1", color="#e377c2", style=dashed];
    "h7___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h7___closed___R" -> "not-binary_R" [label="1", color="#e377c2", style=dashed];
    "h8___closed___R" [shape=octagon, label="__closed__", color="#e377c2", fontcolor="#e377c2"];
    "h8___closed___R" -> "binary-rule_R" [label="1", color="#e377c2", style=dashed];
    "h9_bin-valid_R" [shape=octagon, label="bin-valid", color="#8c564b", fontcolor="#8c564b"];
    "h9_bin-valid_R" -> "z_R" [label="1", color="#8c564b", style=dashed];
    "h10_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h10_binary-rule_R" -> "arith_R" [label="1", color="#ff7f0e", style=dashed];
    "h11_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h11_binary-rule_R" -> "bin-numeral-step_R" [label="1", color="#ff7f0e", style=dashed];
    "h12_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h12_binary-rule_R" -> "bin-numeral-step-zero_R" [label="1", color="#ff7f0e", style=dashed];
    "h13_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h13_binary-rule_R" -> "bin-numeral-valid_R" [label="1", color="#ff7f0e", style=dashed];
    "h14_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h14_binary-rule_R" -> "bin-numeral-bit_R" [label="1", color="#ff7f0e", style=dashed];
    "h15_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h15_binary-rule_R" -> "bin-numeral-prefix-bit_R" [label="1", color="#ff7f0e", style=dashed];
    "h16_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h16_binary-rule_R" -> "bin-numeral-prefix-zero_R" [label="1", color="#ff7f0e", style=dashed];
    "h17_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h17_binary-rule_R" -> "bin-numeral-prefix-named_R" [label="1", color="#ff7f0e", style=dashed];
    "h18_binary-rule_R" [shape=octagon, label="binary-rule", color="#ff7f0e", fontcolor="#ff7f0e"];
    "h18_binary-rule_R" -> "not-binary-is-false_R" [label="1", color="#ff7f0e", style=dashed];
  }
}
