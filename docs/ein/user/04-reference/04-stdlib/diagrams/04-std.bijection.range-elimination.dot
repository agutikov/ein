digraph rule_range_elimination_lhs_rhs {
  rankdir=TB;
  label="range-elimination"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "injective_L" [label="injective", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "surjective_L" [label="surjective", shape=box];
    "relation_L" [label="relation", shape=box];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?a_other_L" [label="?a_other", shape=diamond];
    "and_L" [label="and", shape=box];
    "neq_L" [label="neq", shape=box];
    "not_L" [label="not", shape=box];
    subgraph cluster_ctx_L_0 {
      label="and ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?a_other ?A)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(neq ?a_other ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_L_1 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(and (?isa ?a_other ?A) (neq ?a_other ?a))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(not (?R ?a_other ?b))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_2 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a_other ?b)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_injective_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "injective_L" -> "h1_injective_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_injective_L" -> "?R_L" [xlabel="2", color="#ff7f0e"];
    "h2_surjective_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "surjective_L" -> "h2_surjective_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h2_surjective_L" -> "?R_L" [xlabel="2", color="#2ca02c"];
    "h3_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "relation_L" -> "h3_relation_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h3_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h3_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h3_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h4_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h4_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h4_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h4_isa_L" -> "?B_L" [xlabel="3", color="#bcbd22"];
    "h5_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h5_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h5_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h5_isa_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h6_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "forall_L" -> "h6_forall_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h6_forall_L" -> "?a_other_L" [xlabel="2", color="#1f77b4"];
    "h6_forall_L" -> "(and (?isa ?a_other ?A) (neq ?a_other ?a))_L" [xlabel="3", color="#1f77b4"];
    "h6_forall_L" -> "(not (?R ?a_other ?b))_L" [xlabel="4", color="#1f77b4"];
    "and_L" -> "(and (?isa ?a_other ?A) (neq ?a_other ?a))_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "(and (?isa ?a_other ?A) (neq ?a_other ?a))_L" -> "(?isa ?a_other ?A)_L" [xlabel="2", color="#7f7f7f"];
    "(and (?isa ?a_other ?A) (neq ?a_other ?a))_L" -> "(neq ?a_other ?a)_L" [xlabel="3", color="#7f7f7f"];
    "?isa_L" -> "(?isa ?a_other ?A)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(?isa ?a_other ?A)_L" -> "?a_other_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?a_other ?A)_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "neq_L" -> "(neq ?a_other ?a)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(neq ?a_other ?a)_L" -> "?a_other_L" [xlabel="2", color="#1f77b4"];
    "(neq ?a_other ?a)_L" -> "?a_L" [xlabel="3", color="#1f77b4"];
    "not_L" -> "(not (?R ?a_other ?b))_L" [xlabel="1", dir=back, color="#d62728"];
    "(not (?R ?a_other ?b))_L" -> "(?R ?a_other ?b)_L" [xlabel="2", color="#d62728"];
    "?R_L" -> "(?R ?a_other ?b)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(?R ?a_other ?b)_L" -> "?a_other_L" [xlabel="2", color="#1f77b4"];
    "(?R ?a_other ?b)_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h7_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "?R_R" -> "h7_R_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h7_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h7_R_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
