digraph rule_right_neg_lhs_rhs {
  rankdir=TB;
  label="right-neg"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "column_L" [label="column", shape=box];
    "?f_L" [label="?f", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?g_L" [label="?g", shape=diamond];
    "h1_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "column_L" -> "h1_column_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_column_L" -> "?f_L" [xlabel="2", color="#d62728"];
    "h1_column_L" -> "?a_L" [xlabel="3", color="#d62728"];
    "h1_column_L" -> "?b_L" [xlabel="4", color="#d62728"];
    "h1_column_L" -> "?c_L" [xlabel="5", color="#d62728"];
    "h1_column_L" -> "?d_L" [xlabel="6", color="#d62728"];
    "h2_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "column_L" -> "h2_column_L" [xlabel="1", dir=back, color="#d62728"];
    "h2_column_L" -> "?g_L" [xlabel="2", color="#d62728"];
    "h2_column_L" -> "?b_L" [xlabel="3", color="#d62728"];
    "h2_column_L" -> "?a_L" [xlabel="4", color="#d62728"];
    "h2_column_L" -> "?d_L" [xlabel="5", color="#d62728"];
    "h2_column_L" -> "?c_L" [xlabel="6", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "right-negated_R" [label="right-negated", shape=box];
    "?f_R" [label="?f", shape=diamond];
    "?g_R" [label="?g", shape=diamond];
    "h3_right-negated_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "right-negated_R" -> "h3_right-negated_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h3_right-negated_R" -> "?f_R" [xlabel="2", color="#e377c2", style=dashed];
    "h3_right-negated_R" -> "?g_R" [xlabel="3", color="#e377c2", style=dashed];
  }
}
