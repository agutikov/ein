digraph rule_rat_simplify_start_lhs_rhs {
  rankdir=TB;
  label="rat-simplify-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-operand-is_L" [label="rat-operand-is", shape=box];
    "rat-only_L" [label="rat-only", shape=box];
    "rat-simplify_L" [label="rat-simplify", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-simplify ?x)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    subgraph cluster_ctx_L_1 {
      label="rat-operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-only (rat-simplify ?x))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_rat-operand-is_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_rat-operand-is_L" -> "rat-operand-is_L" [xlabel="1", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "(rat-only (rat-simplify ?x))_L" [xlabel="2", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?p_L" [xlabel="3", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?n_L" [xlabel="4", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?d_L" [xlabel="5", color="#1f77b4"];
    "(rat-only (rat-simplify ?x))_L" -> "rat-only_L" [xlabel="1", color="#2ca02c"];
    "(rat-only (rat-simplify ?x))_L" -> "(rat-simplify ?x)_L" [xlabel="2", color="#2ca02c"];
    "(rat-simplify ?x)_L" -> "rat-simplify_L" [xlabel="1", color="#7f7f7f"];
    "(rat-simplify ?x)_L" -> "?x_L" [xlabel="2", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm-run_R" [label="int-norm-run", shape=box];
    "rat-low_R" [label="rat-low", shape=box];
    "rat-simplify_R" [label="rat-simplify", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-low (rat-simplify ?x) ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-low ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-simplify ?x)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_int-norm-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "int-norm-run_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "(rat-low (rat-simplify ?x) ?d)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?p_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?n_R" [xlabel="4", color="#d62728", style=dashed];
    "(rat-low (rat-simplify ?x) ?d)_R" -> "rat-low_R" [xlabel="1", color="#2ca02c", style=dashed];
    "(rat-low (rat-simplify ?x) ?d)_R" -> "(rat-simplify ?x)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(rat-low (rat-simplify ?x) ?d)_R" -> "?d_R" [xlabel="3", color="#2ca02c", style=dashed];
    "(rat-simplify ?x)_R" -> "rat-simplify_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "(rat-simplify ?x)_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
  }
}
