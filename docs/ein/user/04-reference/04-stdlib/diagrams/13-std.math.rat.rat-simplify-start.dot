digraph rule_rat_simplify_start_lhs_rhs {
  rankdir=TB;
  label="rat-simplify-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-simplify ?x)_L" [shape=octagon, label="rat-simplify", color="#7f7f7f", fontcolor="#7f7f7f"];
    }
    subgraph cluster_ctx_L_1 {
      label="rat-operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-only (rat-simplify ?x))_L" [shape=octagon, label="rat-only", color="#2ca02c", fontcolor="#2ca02c"];
    }
    "h1_rat-operand-is_L" [shape=octagon, label="rat-operand-is", color="#1f77b4", fontcolor="#1f77b4"];
    "h1_rat-operand-is_L" -> "(rat-only (rat-simplify ?x))_L" [label="1", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?p_L" [label="2", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?n_L" [label="3", color="#1f77b4"];
    "h1_rat-operand-is_L" -> "?d_L" [label="4", color="#1f77b4"];
    "(rat-only (rat-simplify ?x))_L" -> "(rat-simplify ?x)_L" [label="1", color="#2ca02c"];
    "(rat-simplify ?x)_L" -> "?x_L" [label="1", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-low (rat-simplify ?x) ?d)_R" [shape=octagon, label="rat-low", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-low ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-simplify ?x)_R" [shape=octagon, label="rat-simplify", color="#7f7f7f", fontcolor="#7f7f7f"];
    }
    "h2_int-norm_R" [shape=octagon, label="int-norm", color="#e377c2", fontcolor="#e377c2"];
    "h2_int-norm_R" -> "(rat-low (rat-simplify ?x) ?d)_R" [label="1", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?p_R" [label="2", color="#e377c2", style=dashed];
    "h2_int-norm_R" -> "?n_R" [label="3", color="#e377c2", style=dashed];
    "(rat-low (rat-simplify ?x) ?d)_R" -> "(rat-simplify ?x)_R" [label="1", color="#2ca02c", style=dashed];
    "(rat-low (rat-simplify ?x) ?d)_R" -> "?d_R" [label="2", color="#2ca02c", style=dashed];
    "(rat-simplify ?x)_R" -> "?x_R" [label="1", color="#7f7f7f", style=dashed];
  }
}
