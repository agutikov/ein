    "h2_bijective_L" -> "?R_L" [xlabel="2", color="#17becf"];
    "h3_typecheck-hierarchy_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "typecheck-hierarchy_L" -> "h3_typecheck-hierarchy_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h3_typecheck-hierarchy_L" -> "?isa_L" [xlabel="2", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "typecheck-arg-0_R" [label="typecheck-arg-0", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?isa_R" [label="?isa", shape=diamond];
    "?A_R" [label="?A", shape=diamond];
    "typecheck-arg-1_R" [label="typecheck-arg-1", shape=box];
    "?B_R" [label="?B", shape=diamond];
    "h4_typecheck-arg-0_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "typecheck-arg-0_R" -> "h4_typecheck-arg-0_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h4_typecheck-arg-0_R" -> "?R_R" [xlabel="2", color="#17becf", style=dashed];
    "h4_typecheck-arg-0_R" -> "?isa_R" [xlabel="3", color="#17becf", style=dashed];
    "h4_typecheck-arg-0_R" -> "?A_R" [xlabel="4", color="#17becf", style=dashed];
    "h5_typecheck-arg-1_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "typecheck-arg-1_R" -> "h5_typecheck-arg-1_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h5_typecheck-arg-1_R" -> "?R_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h5_typecheck-arg-1_R" -> "?isa_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h5_typecheck-arg-1_R" -> "?B_R" [xlabel="4", color="#7f7f7f", style=dashed];
  }
