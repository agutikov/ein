digraph rule_domain_elimination_lhs_rhs {
  rankdir=TB;
  label="domain-elimination"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "functional_L" [label="functional", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "0_L" [label="0", shape=box];
    "1_L" [label="1", shape=box];
    "total_L" [label="total", shape=box];
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?OT_L" [label="?OT", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "?VT_L" [label="?VT", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?v_other_L" [label="?v_other", shape=diamond];
    "and_L" [label="and", shape=box];
    "neq_L" [label="neq", shape=box];
    "not_L" [label="not", shape=box];
    subgraph cluster_ctx_L_0 {
      label="and ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?v_other ?VT)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(neq ?v_other ?v)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_L_1 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(and (?isa ?v_other ?VT) (neq ?v_other ?v))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(not (?R ?a ?v_other))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_2 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?v_other)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_functional_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_functional_L" -> "functional_L" [xlabel="1", color="#bcbd22"];
    "h1_functional_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h1_functional_L" -> "0_L" [xlabel="3", color="#bcbd22"];
    "h1_functional_L" -> "1_L" [xlabel="4", color="#bcbd22"];
    "h2_total_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_total_L" -> "total_L" [xlabel="1", color="#1f77b4"];
    "h2_total_L" -> "?R_L" [xlabel="2", color="#1f77b4"];
    "h2_total_L" -> "0_L" [xlabel="3", color="#1f77b4"];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h3_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?OT_L" [xlabel="3", color="#bcbd22"];
    "h4_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h4_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h4_isa_L" -> "?v_L" [xlabel="2", color="#bcbd22"];
    "h4_isa_L" -> "?VT_L" [xlabel="3", color="#bcbd22"];
    "h5_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h5_forall_L" -> "forall_L" [xlabel="1", color="#1f77b4"];
    "h5_forall_L" -> "?v_other_L" [xlabel="2", color="#1f77b4"];
    "h5_forall_L" -> "(and (?isa ?v_other ?VT) (neq ?v_other ?v))_L" [xlabel="3", color="#1f77b4"];
    "h5_forall_L" -> "(not (?R ?a ?v_other))_L" [xlabel="4", color="#1f77b4"];
    "(and (?isa ?v_other ?VT) (neq ?v_other ?v))_L" -> "and_L" [xlabel="1", color="#7f7f7f"];
    "(and (?isa ?v_other ?VT) (neq ?v_other ?v))_L" -> "(?isa ?v_other ?VT)_L" [xlabel="2", color="#7f7f7f"];
    "(and (?isa ?v_other ?VT) (neq ?v_other ?v))_L" -> "(neq ?v_other ?v)_L" [xlabel="3", color="#7f7f7f"];
    "(?isa ?v_other ?VT)_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "(?isa ?v_other ?VT)_L" -> "?v_other_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?v_other ?VT)_L" -> "?VT_L" [xlabel="3", color="#bcbd22"];
    "(neq ?v_other ?v)_L" -> "neq_L" [xlabel="1", color="#1f77b4"];
    "(neq ?v_other ?v)_L" -> "?v_other_L" [xlabel="2", color="#1f77b4"];
    "(neq ?v_other ?v)_L" -> "?v_L" [xlabel="3", color="#1f77b4"];
    "(not (?R ?a ?v_other))_L" -> "not_L" [xlabel="1", color="#d62728"];
    "(not (?R ?a ?v_other))_L" -> "(?R ?a ?v_other)_L" [xlabel="2", color="#d62728"];
    "(?R ?a ?v_other)_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "(?R ?a ?v_other)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(?R ?a ?v_other)_L" -> "?v_other_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "h6_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h6_R_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h6_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h6_R_R" -> "?v_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
