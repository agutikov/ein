digraph rule_rat_z_zero_lhs_rhs {
  rankdir=TB;
  label="rat-z-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "0_L" [label="0", shape=rectangle];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="written ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat 0 ?d)_L" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "h1_written_L" [shape=octagon, label="written", color="#d62728", fontcolor="#d62728"];
    "h1_written_L" -> "(rat 0 ?d)_L" [label="1", color="#d62728"];
    "(rat 0 ?d)_L" -> "0_L" [label="1", color="#d62728"];
    "(rat 0 ?d)_L" -> "?d_L" [label="2", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "0_R" [label="0", shape=rectangle];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not-rational ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat 0 ?d)_R" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "(rat 0 ?d)_R" -> "0_R" [label="not-rational", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
    "(rat 0 ?d)_R" -> "0_R" [label="1", color="#d62728", style=dashed];
    "(rat 0 ?d)_R" -> "?d_R" [label="2", color="#d62728", style=dashed];
  }
}
