digraph rule_slot_negative_lhs_rhs {
  rankdir=TB;
  label="slot-negative"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R_L" [label="?R", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "not_L" [label="not", shape=box];
    "?i_L" [label="?i", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?b ?i)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "?R_L" -> "h1_R_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h1_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "h2_not_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "not_L" -> "h2_not_L" [xlabel="1", dir=back, color="#d62728"];
    "h2_not_L" -> "(?R ?b ?i)_L" [xlabel="2", color="#d62728"];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h3_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h3_isa_L" -> "?i_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "?R_L" -> "(?R ?b ?i)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(?R ?b ?i)_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
    "(?R ?b ?i)_L" -> "?i_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?i_R" [label="?i", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?i)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h4_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "not_R" -> "h4_not_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h4_not_R" -> "(?R ?a ?i)_R" [xlabel="2", color="#d62728", style=dashed];
    "?R_R" -> "(?R ?a ?i)_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "(?R ?a ?i)_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?R ?a ?i)_R" -> "?i_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
