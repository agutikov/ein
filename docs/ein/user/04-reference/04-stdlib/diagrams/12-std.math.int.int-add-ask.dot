digraph rule_int_add_ask_lhs_rhs {
  rankdir=TB;
  label="int-add-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-add_L" [label="int-add", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_int-add_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
