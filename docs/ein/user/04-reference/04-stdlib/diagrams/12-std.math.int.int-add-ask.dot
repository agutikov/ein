digraph rule_int_add_ask_lhs_rhs {
  rankdir=TB;
  label="int-add-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="int-add", color="#ff7f0e", fontcolor="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-add ?x ?y)_R" [shape=octagon, label="int-add", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    subgraph cluster_ctx_R_1 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-first (int-add ?x ?y) ?y)_R" [shape=octagon, label="int-first", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    "(int-first (int-add ?x ?y) ?y)_R" -> "?x_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(int-first (int-add ?x ?y) ?y)_R" -> "(int-add ?x ?y)_R" [label="1", color="#ff7f0e", style=dashed];
    "(int-first (int-add ?x ?y) ?y)_R" -> "?y_R" [label="2", color="#ff7f0e", style=dashed];
    "(int-add ?x ?y)_R" -> "?x_R" [label="1", color="#ff7f0e", style=dashed];
    "(int-add ?x ?y)_R" -> "?y_R" [label="2", color="#ff7f0e", style=dashed];
  }
}
