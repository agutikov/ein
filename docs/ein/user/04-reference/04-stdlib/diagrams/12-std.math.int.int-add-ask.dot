    "int-first_R" [label="int-first", shape=box];
    "int-add_R" [label="int-add", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-add ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    subgraph cluster_ctx_R_1 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-first (int-add ?x ?y) ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_operand_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_operand_R" -> "operand_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "(int-first (int-add ?x ?y) ?y)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "?x_R" [xlabel="3", color="#2ca02c", style=dashed];
    "(int-first (int-add ?x ?y) ?y)_R" -> "int-first_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "(int-first (int-add ?x ?y) ?y)_R" -> "(int-add ?x ?y)_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(int-first (int-add ?x ?y) ?y)_R" -> "?y_R" [xlabel="3", color="#ff7f0e", style=dashed];
    "(int-add ?x ?y)_R" -> "int-add_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "(int-add ?x ?y)_R" -> "?x_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(int-add ?x ?y)_R" -> "?y_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
