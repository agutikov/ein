digraph rule_rat_d_zero_lhs_rhs {
  rankdir=TB;
  label="rat-d-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?i_L" [label="?i", shape=diamond];
    "0_L" [label="0", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="written ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i 0)_L" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "h1_written_L" [shape=octagon, label="written", color="#d62728", fontcolor="#d62728"];
    "h1_written_L" -> "(rat ?i 0)_L" [label="1", color="#d62728"];
    "(rat ?i 0)_L" -> "?i_L" [label="1", color="#d62728"];
    "(rat ?i 0)_L" -> "0_L" [label="2", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "?i_R" [label="?i", shape=diamond];
    "0_R" [label="0", shape=rectangle];
    subgraph cluster_ctx_R_0 {
      label="not-rational ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i 0)_R" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "(rat ?i 0)_R" -> "0_R" [label="not-rational", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
    "(rat ?i 0)_R" -> "?i_R" [label="1", color="#d62728", style=dashed];
    "(rat ?i 0)_R" -> "0_R" [label="2", color="#d62728", style=dashed];
  }
}
