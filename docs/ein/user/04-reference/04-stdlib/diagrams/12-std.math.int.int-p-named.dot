digraph rule_int_p_named_lhs_rhs {
  rankdir=TB;
  label="int-p-named"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-check_L" [label="int-check", shape=box];
    "int_L" [label="int", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "named_L" [label="named", shape=box];
    subgraph cluster_ctx_L_0 {
      label="int-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?x ?n)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_int-check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "int-check_L" -> "h1_int-check_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_int-check_L" -> "(int ?x ?n)_L" [xlabel="2", color="#2ca02c"];
    "h2_named_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "named_L" -> "h2_named_L" [xlabel="1", dir=back, color="#d62728"];
    "h2_named_L" -> "?x_L" [xlabel="2", color="#d62728"];
    "int_L" -> "(int ?x ?n)_L" [xlabel="1", dir=back, color="#17becf"];
    "(int ?x ?n)_L" -> "?x_L" [xlabel="2", color="#17becf"];
    "(int ?x ?n)_L" -> "?n_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "not-integer_R" [label="not-integer", shape=box];
    "int_R" [label="int", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not-integer ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?x ?n)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h3_not-integer_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "not-integer_R" -> "h3_not-integer_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h3_not-integer_R" -> "(int ?x ?n)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h3_not-integer_R" -> "?x_R" [xlabel="3", color="#2ca02c", style=dashed];
    "int_R" -> "(int ?x ?n)_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "(int ?x ?n)_R" -> "?x_R" [xlabel="2", color="#17becf", style=dashed];
    "(int ?x ?n)_R" -> "?n_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
