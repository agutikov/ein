digraph rule_to_bin_ask_lhs_rhs {
  rankdir=TB;
  label="to-bin-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "to-bin_L" [label="to-bin", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "h1_to-bin_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "to-bin_L" -> "h1_to-bin_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_to-bin_L" -> "?x_L" [xlabel="2", color="#e377c2"];
  }
  subgraph cluster_rhs { label="assert";
    "check_R" [label="check", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "to-bin-go_R" [label="to-bin-go", shape=box];
    "z_R" [label="z", shape=box];
    "h2_check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "check_R" -> "h2_check_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_check_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_check_R" -> "?x_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h3_to-bin-go_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "to-bin-go_R" -> "h3_to-bin-go_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h3_to-bin-go_R" -> "?x_R" [xlabel="2", color="#17becf", style=dashed];
    "h3_to-bin-go_R" -> "?x_R" [xlabel="3", color="#17becf", style=dashed];
    "h3_to-bin-go_R" -> "z_R" [xlabel="4", color="#17becf", style=dashed];
  }
}
