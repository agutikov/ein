digraph rule_slot_fill_lhs_rhs {
  rankdir=TB;
  label="slot-fill"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?i_L" [label="?i", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    "?sub_L" [label="?sub", shape=diamond];
    "?Tv_L" [label="?Tv", shape=diamond];
    "?super_L" [label="?super", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?v_other_L" [label="?v_other", shape=diamond];
    "and_L" [label="and", shape=box];
    "neq_L" [label="neq", shape=box];
    "not_L" [label="not", shape=box];
    "?R_L" [label="?R", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="and ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?v_other ?Tv)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(neq ?v_other ?v)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_L_1 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(and (?isa ?v_other ?Tv) (neq ?v_other ?v))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(not (?R ?i ?v_other))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_2 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?i ?v_other)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h1_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_isa_L" -> "?i_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "h2_sub_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "?sub_L" -> "h2_sub_L" [xlabel="1", dir=back, color="#9467bd"];
    "h2_sub_L" -> "?Tv_L" [xlabel="2", color="#9467bd"];
    "h2_sub_L" -> "?super_L" [xlabel="3", color="#9467bd"];
    "?Tv_L" -> "?index_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h3_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h3_isa_L" -> "?v_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?Tv_L" [xlabel="3", color="#bcbd22"];
    "h4_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "forall_L" -> "h4_forall_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h4_forall_L" -> "?v_other_L" [xlabel="2", color="#1f77b4"];
    "h4_forall_L" -> "(and (?isa ?v_other ?Tv) (neq ?v_other ?v))_L" [xlabel="3", color="#1f77b4"];
    "h4_forall_L" -> "(not (?R ?i ?v_other))_L" [xlabel="4", color="#1f77b4"];
    "and_L" -> "(and (?isa ?v_other ?Tv) (neq ?v_other ?v))_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "(and (?isa ?v_other ?Tv) (neq ?v_other ?v))_L" -> "(?isa ?v_other ?Tv)_L" [xlabel="2", color="#7f7f7f"];
    "(and (?isa ?v_other ?Tv) (neq ?v_other ?v))_L" -> "(neq ?v_other ?v)_L" [xlabel="3", color="#7f7f7f"];
    "?isa_L" -> "(?isa ?v_other ?Tv)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(?isa ?v_other ?Tv)_L" -> "?v_other_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?v_other ?Tv)_L" -> "?Tv_L" [xlabel="3", color="#bcbd22"];
    "neq_L" -> "(neq ?v_other ?v)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(neq ?v_other ?v)_L" -> "?v_other_L" [xlabel="2", color="#1f77b4"];
    "(neq ?v_other ?v)_L" -> "?v_L" [xlabel="3", color="#1f77b4"];
    "not_L" -> "(not (?R ?i ?v_other))_L" [xlabel="1", dir=back, color="#d62728"];
    "(not (?R ?i ?v_other))_L" -> "(?R ?i ?v_other)_L" [xlabel="2", color="#d62728"];
    "?R_L" -> "(?R ?i ?v_other)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(?R ?i ?v_other)_L" -> "?i_L" [xlabel="2", color="#1f77b4"];
    "(?R ?i ?v_other)_L" -> "?v_other_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?i_R" [label="?i", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "h5_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "?R_R" -> "h5_R_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h5_R_R" -> "?i_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h5_R_R" -> "?v_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
