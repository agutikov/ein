digraph rule_bijective_properties_lhs_rhs {
  rankdir=TB;
  label="bijective-properties"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bijective_L" [label="bijective", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "h1_bijective_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "h1_bijective_L" -> "bijective_L" [xlabel="1", color="#17becf"];
    "h1_bijective_L" -> "?R_L" [xlabel="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "functional_R" [label="functional", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "injective_R" [label="injective", shape=box];
    "total_R" [label="total", shape=box];
    "surjective_R" [label="surjective", shape=box];
    "h2_functional_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "h2_functional_R" -> "functional_R" [xlabel="1", color="#bcbd22", style=dashed];
    "h2_functional_R" -> "?R_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h3_injective_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "h3_injective_R" -> "injective_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "h3_injective_R" -> "?R_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "h4_total_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h4_total_R" -> "total_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h4_total_R" -> "?R_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h5_surjective_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h5_surjective_R" -> "surjective_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h5_surjective_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
  }
}
