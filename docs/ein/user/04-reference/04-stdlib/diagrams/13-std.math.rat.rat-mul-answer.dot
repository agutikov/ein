    "rat-product-of_R" -> "h2_rat-product-of_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "h2_rat-product-of_R" -> "?x_R" [xlabel="2", color="#8c564b", style=dashed];
    "h2_rat-product-of_R" -> "?y_R" [xlabel="3", color="#8c564b", style=dashed];
