digraph rule_sub_ask_lhs_rhs {
  rankdir=TB;
  label="sub-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?SUB_L" [label="?SUB", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_SUB_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_SUB_L" -> "?SUB_L" [xlabel="1", color="#1f77b4"];
    "h1_SUB_L" -> "?x_L" [xlabel="2", color="#1f77b4"];
    "h1_SUB_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?OPERAND_R" [label="?OPERAND", shape=diamond];
    "?SUB-FIRST_R" [label="?SUB-FIRST", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB-FIRST ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h2_OPERAND_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?OPERAND_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "(?SUB-FIRST ?x ?y)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?x_R" [xlabel="3", color="#d62728", style=dashed];
    "(?SUB-FIRST ?x ?y)_R" -> "?SUB-FIRST_R" [xlabel="1", color="#1f77b4", style=dashed];
    "(?SUB-FIRST ?x ?y)_R" -> "?x_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?SUB-FIRST ?x ?y)_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
