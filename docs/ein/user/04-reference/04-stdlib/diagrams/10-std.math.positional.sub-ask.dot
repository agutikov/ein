digraph rule_sub_ask_lhs_rhs {
  rankdir=TB;
  label="sub-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="?SUB", color="#1f77b4", fontcolor="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?SUB-FIRST ?x ?y)_R" [shape=octagon, label="?SUB-FIRST", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(?SUB-FIRST ?x ?y)_R" -> "?x_R" [label="?OPERAND", color="#d62728", fontcolor="#d62728", style=dashed];
    "(?SUB-FIRST ?x ?y)_R" -> "?x_R" [label="1", color="#1f77b4", style=dashed];
    "(?SUB-FIRST ?x ?y)_R" -> "?y_R" [label="2", color="#1f77b4", style=dashed];
  }
}
