digraph rule_gcd_next_lhs_rhs {
  rankdir=TB;
  label="gcd-next"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "div-done_L" [label="div-done", shape=box];
    "gcd-rem_L" [label="gcd-rem", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="div-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-rem ?k ?b)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h1_div-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    "div-done_L" -> "h1_div-done_L" [xlabel="1", dir=back, color="#8c564b"];
    "h1_div-done_L" -> "(gcd-rem ?k ?b)_L" [xlabel="2", color="#8c564b"];
    "h1_div-done_L" -> "?q_L" [xlabel="3", color="#8c564b"];
    "h1_div-done_L" -> "?r_L" [xlabel="4", color="#8c564b"];
    "gcd-rem_L" -> "(gcd-rem ?k ?b)_L" [xlabel="1", dir=back, color="#d62728"];
    "(gcd-rem ?k ?b)_L" -> "?k_L" [xlabel="2", color="#d62728"];
    "(gcd-rem ?k ?b)_L" -> "?b_L" [xlabel="3", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "gcd-chain_R" [label="gcd-chain", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?r_R" [label="?r", shape=diamond];
    "h2_gcd-chain_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "gcd-chain_R" -> "h2_gcd-chain_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?k_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?b_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_gcd-chain_R" -> "?r_R" [xlabel="4", color="#7f7f7f", style=dashed];
  }
}
