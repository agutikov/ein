digraph rule_int_neg_start_lhs_rhs {
  rankdir=TB;
  label="int-neg-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "operand-is_L" [label="operand-is", shape=box];
    "int-only_L" [label="int-only", shape=box];
    "int-neg_L" [label="int-neg", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "int_L" [label="int", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-neg ?x)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-only (int-neg ?x))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
      "(int ?p ?n)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_operand-is_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "operand-is_L" -> "h1_operand-is_L" [xlabel="1", dir=back, color="#17becf"];
    "h1_operand-is_L" -> "(int-only (int-neg ?x))_L" [xlabel="2", color="#17becf"];
    "h1_operand-is_L" -> "(int ?p ?n)_L" [xlabel="3", color="#17becf"];
    "int-only_L" -> "(int-only (int-neg ?x))_L" [xlabel="1", dir=back, color="#9467bd"];
    "(int-only (int-neg ?x))_L" -> "(int-neg ?x)_L" [xlabel="2", color="#9467bd"];
    "int-neg_L" -> "(int-neg ?x)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(int-neg ?x)_L" -> "?x_L" [xlabel="2", color="#9467bd"];
    "int_L" -> "(int ?p ?n)_L" [xlabel="1", dir=back, color="#17becf"];
    "(int ?p ?n)_L" -> "?p_L" [xlabel="2", color="#17becf"];
    "(int ?p ?n)_L" -> "?n_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm-run_R" [label="int-norm-run", shape=box];
    "int-neg_R" [label="int-neg", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-norm-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-neg ?x)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_int-norm-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "int-norm-run_R" -> "h2_int-norm-run_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "(int-neg ?x)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?n_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?p_R" [xlabel="4", color="#d62728", style=dashed];
    "int-neg_R" -> "(int-neg ?x)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(int-neg ?x)_R" -> "?x_R" [xlabel="2", color="#9467bd", style=dashed];
  }
}
