digraph rule_int_operand_check_lhs_rhs {
  rankdir=TB;
  label="int-operand-check"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="operand-is ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p ?n)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "?k_L" -> "(int ?p ?n)_L" [label="operand-is", color="#17becf", fontcolor="#17becf"];
    "(int ?p ?n)_L" -> "?p_L" [label="1", color="#17becf"];
    "(int ?p ?n)_L" -> "?n_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p ?n)_R" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "h1_int-check_R" [shape=octagon, label="int-check", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_int-check_R" -> "(int ?p ?n)_R" [label="1", color="#2ca02c", style=dashed];
    "(int ?p ?n)_R" -> "?p_R" [label="1", color="#17becf", style=dashed];
    "(int ?p ?n)_R" -> "?n_R" [label="2", color="#17becf", style=dashed];
  }
}
