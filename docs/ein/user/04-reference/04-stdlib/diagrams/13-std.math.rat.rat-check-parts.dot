digraph rule_rat_check_parts_lhs_rhs {
  rankdir=TB;
  label="rat-check-parts"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?i_L" [label="?i", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i ?d)_L" [shape=octagon, label="rat", color="#d62728", fontcolor="#d62728"];
    }
    "h1_rat-check_L" [shape=octagon, label="rat-check", color="#e377c2", fontcolor="#e377c2"];
    "h1_rat-check_L" -> "(rat ?i ?d)_L" [label="1", color="#e377c2"];
    "(rat ?i ?d)_L" -> "?i_L" [label="1", color="#d62728"];
    "(rat ?i ?d)_L" -> "?d_L" [label="2", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "?i_R" [label="?i", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "h2_int-check_R" [shape=octagon, label="int-check", color="#2ca02c", fontcolor="#2ca02c"];
    "h2_int-check_R" -> "?i_R" [label="1", color="#2ca02c", style=dashed];
    "?d_R" -> "?d_R" [label="check", color="#7f7f7f", fontcolor="#7f7f7f", style=dashed];
  }
}
