digraph rule_rat_check_parts_lhs_rhs {
  rankdir=TB;
  label="rat-check-parts"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-check_L" [label="rat-check", shape=box];
    "rat_L" [label="rat", shape=box];
    "?i_L" [label="?i", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i ?d)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h1_rat-check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_rat-check_L" -> "rat-check_L" [xlabel="1", color="#e377c2"];
    "h1_rat-check_L" -> "(rat ?i ?d)_L" [xlabel="2", color="#e377c2"];
    "(rat ?i ?d)_L" -> "rat_L" [xlabel="1", color="#d62728"];
    "(rat ?i ?d)_L" -> "?i_L" [xlabel="2", color="#d62728"];
    "(rat ?i ?d)_L" -> "?d_L" [xlabel="3", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "int-check_R" [label="int-check", shape=box];
    "?i_R" [label="?i", shape=diamond];
    "check_R" [label="check", shape=box];
    "?d_R" [label="?d", shape=diamond];
    "h2_int-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_int-check_R" -> "int-check_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_int-check_R" -> "?i_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h3_check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h3_check_R" -> "check_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h3_check_R" -> "?d_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h3_check_R" -> "?d_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
