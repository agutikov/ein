digraph rule_slot_exclusive_lhs_rhs {
  rankdir=TB;
  label="slot-exclusive"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?T_L" [label="?T", shape=diamond];
    "?sub_L" [label="?sub", shape=diamond];
    "?super_L" [label="?super", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?T_L" [xlabel="3", color="#bcbd22"];
    "h2_sub_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h2_sub_L" -> "?sub_L" [xlabel="1", color="#9467bd"];
    "h2_sub_L" -> "?T_L" [xlabel="2", color="#9467bd"];
    "h2_sub_L" -> "?super_L" [xlabel="3", color="#9467bd"];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h3_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?T_L" [xlabel="3", color="#bcbd22"];
    "?a_L" -> "?b_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?b)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h4_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h4_not_R" -> "not_R" [xlabel="1", color="#d62728", style=dashed];
    "h4_not_R" -> "(?R ?a ?b)_R" [xlabel="2", color="#d62728", style=dashed];
    "(?R ?a ?b)_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "(?R ?a ?b)_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(?R ?a ?b)_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
