digraph rule_rat_cross_minus_lhs_rhs {
  rankdir=TB;
  label="rat-cross-minus"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "rat-x5_L" [label="rat-x5", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x5 ?k ?s ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(rat-x5 ?k ?s ?a)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?b_L" [xlabel="3", color="#e377c2"];
    "(rat-x5 ?k ?s ?a)_L" -> "rat-x5_L" [xlabel="1", color="#2ca02c"];
    "(rat-x5 ?k ?s ?a)_L" -> "?k_L" [xlabel="2", color="#2ca02c"];
    "(rat-x5 ?k ?s ?a)_L" -> "?s_L" [xlabel="3", color="#2ca02c"];
    "(rat-x5 ?k ?s ?a)_L" -> "?a_L" [xlabel="4", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "add-run_R" [label="add-run", shape=box];
    "rat-x6_R" [label="rat-x6", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x6 ?k ?s)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_add-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "add-run_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "(rat-x6 ?k ?s)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?a_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?b_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "(rat-x6 ?k ?s)_R" -> "rat-x6_R" [xlabel="1", color="#17becf", style=dashed];
    "(rat-x6 ?k ?s)_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "(rat-x6 ?k ?s)_R" -> "?s_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
