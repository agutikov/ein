digraph rule_int_cmp_sides_lhs_rhs {
  rankdir=TB;
  label="int-cmp-sides"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "int-cmp-r_L" [label="int-cmp-r", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?l_L" [label="?l", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-cmp-r ?k ?l)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(int-cmp-r ?k ?l)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?r_L" [xlabel="3", color="#e377c2"];
    "(int-cmp-r ?k ?l)_L" -> "int-cmp-r_L" [xlabel="1", color="#ff7f0e"];
    "(int-cmp-r ?k ?l)_L" -> "?k_L" [xlabel="2", color="#ff7f0e"];
    "(int-cmp-r ?k ?l)_L" -> "?l_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "cmp-run_R" [label="cmp-run", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?l_R" [label="?l", shape=diamond];
    "?r_R" [label="?r", shape=diamond];
    "eq_R" [label="eq", shape=box];
    "h2_cmp-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "h2_cmp-run_R" -> "cmp-run_R" [xlabel="1", color="#9467bd", style=dashed];
    "h2_cmp-run_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h2_cmp-run_R" -> "?l_R" [xlabel="3", color="#9467bd", style=dashed];
    "h2_cmp-run_R" -> "?r_R" [xlabel="4", color="#9467bd", style=dashed];
    "h2_cmp-run_R" -> "eq_R" [xlabel="5", color="#9467bd", style=dashed];
  }
}
