digraph rule_int_norm_minus_lhs_rhs {
  rankdir=TB;
  label="int-norm-minus"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-minus ?k)_L" [shape=octagon, label="int-minus", color="#9467bd", fontcolor="#9467bd"];
    }
    "(int-minus ?k)_L" -> "?r_L" [label="done", color="#e377c2", fontcolor="#e377c2"];
    "(int-minus ?k)_L" -> "?k_L" [label="1", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "z_R" [label="z", shape=rectangle];
    "?r_R" [label="?r", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int z ?r)_R" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "?k_R" -> "(int z ?r)_R" [label="int-done", color="#1f77b4", fontcolor="#1f77b4", style=dashed];
    "(int z ?r)_R" -> "z_R" [label="1", color="#17becf", style=dashed];
    "(int z ?r)_R" -> "?r_R" [label="2", color="#17becf", style=dashed];
  }
}
