digraph rule_int_norm_minus_lhs_rhs {
  rankdir=TB;
  label="int-norm-minus"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "int-minus_L" [label="int-minus", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-minus ?k)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_done_L" -> "done_L" [xlabel="1", color="#e377c2"];
    "h1_done_L" -> "(int-minus ?k)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?r_L" [xlabel="3", color="#e377c2"];
    "(int-minus ?k)_L" -> "int-minus_L" [xlabel="1", color="#9467bd"];
    "(int-minus ?k)_L" -> "?k_L" [xlabel="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "int-done_R" [label="int-done", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "int_R" [label="int", shape=box];
    "z_R" [label="z", shape=box];
    "?r_R" [label="?r", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int z ?r)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_int-done_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h2_int-done_R" -> "int-done_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h2_int-done_R" -> "?k_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h2_int-done_R" -> "(int z ?r)_R" [xlabel="3", color="#1f77b4", style=dashed];
    "(int z ?r)_R" -> "int_R" [xlabel="1", color="#17becf", style=dashed];
    "(int z ?r)_R" -> "z_R" [xlabel="2", color="#17becf", style=dashed];
    "(int z ?r)_R" -> "?r_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
