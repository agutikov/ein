digraph rule_undeclared_is_false_lhs_rhs {
  rankdir=TB;
  label="undeclared-is-false"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?UNDECLARED_L" [label="?UNDECLARED", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?request_L" [label="?request", shape=diamond];
    "h1_UNDECLARED_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "?UNDECLARED_L" -> "h1_UNDECLARED_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_UNDECLARED_L" -> "?x_L" [xlabel="2", color="#d62728"];
    "h1_UNDECLARED_L" -> "?request_L" [xlabel="3", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h2_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h2_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
