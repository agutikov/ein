digraph rule_int_add_answer_lhs_rhs {
  rankdir=TB;
  label="int-add-answer"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-done_L" [label="int-done", shape=box];
    "int-add_L" [label="int-add", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-add ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h1_int-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "int-done_L" -> "h1_int-done_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_int-done_L" -> "(int-add ?x ?y)_L" [xlabel="2", color="#1f77b4"];
    "h1_int-done_L" -> "?s_L" [xlabel="3", color="#1f77b4"];
    "int-add_L" -> "(int-add ?x ?y)_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "(int-add ?x ?y)_L" -> "?x_L" [xlabel="2", color="#ff7f0e"];
    "(int-add ?x ?y)_L" -> "?y_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "int-sum-of_R" [label="int-sum-of", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "h2_int-sum-of_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "int-sum-of_R" -> "h2_int-sum-of_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h2_int-sum-of_R" -> "?x_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_int-sum-of_R" -> "?y_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_int-sum-of_R" -> "?s_R" [xlabel="4", color="#17becf", style=dashed];
  }
}
