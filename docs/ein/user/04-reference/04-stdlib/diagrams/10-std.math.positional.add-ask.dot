digraph rule_add_ask_lhs_rhs {
  rankdir=TB;
  label="add-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?ADD_L" [label="?ADD", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_ADD_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_ADD_L" -> "?ADD_L" [xlabel="1", color="#2ca02c"];
    "h1_ADD_L" -> "?x_L" [xlabel="2", color="#2ca02c"];
    "h1_ADD_L" -> "?y_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?OPERAND_R" [label="?OPERAND", shape=diamond];
    "?ADD-FIRST_R" [label="?ADD-FIRST", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?ADD-FIRST ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    }
    "h2_OPERAND_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?OPERAND_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "(?ADD-FIRST ?x ?y)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?x_R" [xlabel="3", color="#d62728", style=dashed];
    "(?ADD-FIRST ?x ?y)_R" -> "?ADD-FIRST_R" [xlabel="1", color="#e377c2", style=dashed];
    "(?ADD-FIRST ?x ?y)_R" -> "?x_R" [xlabel="2", color="#e377c2", style=dashed];
    "(?ADD-FIRST ?x ?y)_R" -> "?y_R" [xlabel="3", color="#e377c2", style=dashed];
  }
}
