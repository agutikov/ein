digraph rule_add_ask_lhs_rhs {
  rankdir=TB;
  label="add-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?x_L" -> "?y_L" [label="?ADD", color="#2ca02c", fontcolor="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?ADD-FIRST ?x ?y)_R" [shape=octagon, label="?ADD-FIRST", color="#e377c2", fontcolor="#e377c2"];
    }
    "(?ADD-FIRST ?x ?y)_R" -> "?x_R" [label="?OPERAND", color="#d62728", fontcolor="#d62728", style=dashed];
    "(?ADD-FIRST ?x ?y)_R" -> "?x_R" [label="1", color="#e377c2", style=dashed];
    "(?ADD-FIRST ?x ?y)_R" -> "?y_R" [label="2", color="#e377c2", style=dashed];
  }
}
