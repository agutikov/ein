digraph rule_room_due_lhs_rhs {
  rankdir=TB;
  label="room-due"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?Ta_L" [label="?Ta", shape=diamond];
    "?sub_L" [label="?sub", shape=diamond];
    "?super_L" [label="?super", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h1_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?Ta_L" [xlabel="3", color="#bcbd22"];
    "h2_sub_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "?sub_L" -> "h2_sub_L" [xlabel="1", dir=back, color="#9467bd"];
    "h2_sub_L" -> "?Ta_L" [xlabel="2", color="#9467bd"];
    "h2_sub_L" -> "?super_L" [xlabel="3", color="#9467bd"];
    "?Ta_L" -> "?index_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "debt-due_R" [label="debt-due", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "slot-owed-room-of_R" [label="slot-owed-room-of", shape=box];
    "?isa_R" [label="?isa", shape=diamond];
    "?sub_R" [label="?sub", shape=diamond];
    "?super_R" [label="?super", shape=diamond];
    "?index_R" [label="?index", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?Ta_R" [label="?Ta", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="debt-due ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h3_debt-due_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "debt-due_R" -> "h3_debt-due_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h3_debt-due_R" -> "?R_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h3_debt-due_R" -> "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "slot-owed-room-of_R" -> "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?isa_R" [xlabel="3", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?sub_R" [xlabel="4", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?super_R" [xlabel="5", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?index_R" [xlabel="6", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?a_R" [xlabel="7", color="#2ca02c", style=dashed];
    "(slot-owed-room-of ?R ?isa ?sub ?super ?index ?a ?Ta)_R" -> "?Ta_R" [xlabel="8", color="#2ca02c", style=dashed];
  }
}
