digraph rule_rat_cross_runs_lhs_rhs {
  rankdir=TB;
  label="rat-cross-runs"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-cross_L" [label="rat-cross", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    "?e_L" [label="?e", shape=diamond];
    "h1_rat-cross_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "rat-cross_L" -> "h1_rat-cross_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_rat-cross_L" -> "?k_L" [xlabel="2", color="#d62728"];
    "h1_rat-cross_L" -> "?p_L" [xlabel="3", color="#d62728"];
    "h1_rat-cross_L" -> "?n_L" [xlabel="4", color="#d62728"];
    "h1_rat-cross_L" -> "?d_L" [xlabel="5", color="#d62728"];
    "h1_rat-cross_L" -> "?q_L" [xlabel="6", color="#d62728"];
    "h1_rat-cross_L" -> "?m_L" [xlabel="7", color="#d62728"];
    "h1_rat-cross_L" -> "?e_L" [xlabel="8", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "rat-cross-run_R" [label="rat-cross-run", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    "rat-check_R" [label="rat-check", shape=box];
    "rat_R" [label="rat", shape=box];
    "int_R" [label="int", shape=box];
    subgraph cluster_ctx_R_0 {
      label="rat ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p ?n)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
      "(int ?q ?m)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat (int ?p ?n) ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
      "(rat (int ?q ?m) ?e)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h2_rat-cross-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "rat-cross-run_R" -> "h2_rat-cross-run_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?k_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?p_R" [xlabel="3", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?n_R" [xlabel="4", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?d_R" [xlabel="5", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?q_R" [xlabel="6", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?m_R" [xlabel="7", color="#2ca02c", style=dashed];
    "h2_rat-cross-run_R" -> "?e_R" [xlabel="8", color="#2ca02c", style=dashed];
    "h3_rat-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "rat-check_R" -> "h3_rat-check_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h3_rat-check_R" -> "(rat (int ?p ?n) ?d)_R" [xlabel="2", color="#e377c2", style=dashed];
    "h4_rat-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "rat-check_R" -> "h4_rat-check_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h4_rat-check_R" -> "(rat (int ?q ?m) ?e)_R" [xlabel="2", color="#e377c2", style=dashed];
    "rat_R" -> "(rat (int ?p ?n) ?d)_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "(rat (int ?p ?n) ?d)_R" -> "(int ?p ?n)_R" [xlabel="2", color="#d62728", style=dashed];
    "(rat (int ?p ?n) ?d)_R" -> "?d_R" [xlabel="3", color="#d62728", style=dashed];
    "int_R" -> "(int ?p ?n)_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "(int ?p ?n)_R" -> "?p_R" [xlabel="2", color="#17becf", style=dashed];
    "(int ?p ?n)_R" -> "?n_R" [xlabel="3", color="#17becf", style=dashed];
    "rat_R" -> "(rat (int ?q ?m) ?e)_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "(rat (int ?q ?m) ?e)_R" -> "(int ?q ?m)_R" [xlabel="2", color="#d62728", style=dashed];
    "(rat (int ?q ?m) ?e)_R" -> "?e_R" [xlabel="3", color="#d62728", style=dashed];
    "int_R" -> "(int ?q ?m)_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "(int ?q ?m)_R" -> "?q_R" [xlabel="2", color="#17becf", style=dashed];
    "(int ?q ?m)_R" -> "?m_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
