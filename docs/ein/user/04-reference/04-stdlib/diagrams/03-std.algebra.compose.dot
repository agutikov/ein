digraph rule_compose_lhs_rhs {
  rankdir=TB;
  label="compose"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R1_L" [label="?R1", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?R2_L" [label="?R2", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "h1_R1_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?R1_L" -> "h1_R1_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_R1_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_R1_L" -> "?b_L" [xlabel="3", color="#bcbd22"];
    "h2_R2_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?R2_L" -> "h2_R2_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_R2_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h2_R2_L" -> "?c_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?R3_R" [label="?R3", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "h3_R3_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "?R3_R" -> "h3_R3_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "h3_R3_R" -> "?a_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "h3_R3_R" -> "?c_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}
