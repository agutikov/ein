digraph rule_complete_via_expansion_lhs_rhs {
  rankdir=TB;
  label="complete-via-expansion"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "group_L" [label="group", shape=box];
    "?g_L" [label="?g", shape=diamond];
    "h1_group_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "group_L" -> "h1_group_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_group_L" -> "?g_L" [xlabel="2", color="#ff7f0e"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "member_L" [label="member", shape=box];
      "?y_L" [label="?y", shape=diamond];
      "h2_member_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
      "member_L" -> "h2_member_L" [xlabel="1", dir=back, color="#ff7f0e"];
      "h2_member_L" -> "?y_L" [xlabel="2", color="#ff7f0e"];
      "h2_member_L" -> "?g_L" [xlabel="3", color="#ff7f0e"];
      subgraph cluster_absent_L_0_0 {
        label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
        "marked_L" [label="marked", shape=box];
        "h3_marked_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
        "marked_L" -> "h3_marked_L" [xlabel="1", dir=back, color="#2ca02c"];
        "h3_marked_L" -> "?y_L" [xlabel="2", color="#2ca02c"];
      }
    }
  }
  subgraph cluster_rhs { label="assert";
    "complete-raw_R" [label="complete-raw", shape=box];
    "?g_R" [label="?g", shape=diamond];
    "h4_complete-raw_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "complete-raw_R" -> "h4_complete-raw_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "h4_complete-raw_R" -> "?g_R" [xlabel="2", color="#9467bd", style=dashed];
  }
}
