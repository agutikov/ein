digraph rule_int_sub_answer_lhs_rhs {
  rankdir=TB;
  label="int-sub-answer"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-done_L" [label="int-done", shape=box];
    "int-sub_L" [label="int-sub", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-sub ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    }
    "h1_int-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "int-done_L" -> "h1_int-done_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_int-done_L" -> "(int-sub ?x ?y)_L" [xlabel="2", color="#1f77b4"];
    "h1_int-done_L" -> "?s_L" [xlabel="3", color="#1f77b4"];
    "int-sub_L" -> "(int-sub ?x ?y)_L" [xlabel="1", dir=back, color="#8c564b"];
    "(int-sub ?x ?y)_L" -> "?x_L" [xlabel="2", color="#8c564b"];
    "(int-sub ?x ?y)_L" -> "?y_L" [xlabel="3", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "int-diff-of_R" [label="int-diff-of", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "h2_int-diff-of_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "int-diff-of_R" -> "h2_int-diff-of_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h2_int-diff-of_R" -> "?x_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h2_int-diff-of_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
    "h2_int-diff-of_R" -> "?s_R" [xlabel="4", color="#1f77b4", style=dashed];
  }
}
