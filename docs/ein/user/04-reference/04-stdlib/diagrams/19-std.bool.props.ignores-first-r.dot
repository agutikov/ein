  subgraph cluster_lhs { label="match";
    "column_L" [label="column", shape=box];
    "?f_L" [label="?f", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "h1_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "h1_column_L" -> "column_L" [xlabel="1", color="#d62728"];
    "h1_column_L" -> "?f_L" [xlabel="2", color="#d62728"];
    "h1_column_L" -> "?a_L" [xlabel="3", color="#d62728"];
    "h1_column_L" -> "?b_L" [xlabel="4", color="#d62728"];
    "h1_column_L" -> "?a_L" [xlabel="5", color="#d62728"];
    "h1_column_L" -> "?b_L" [xlabel="6", color="#d62728"];
