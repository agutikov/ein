    "?DIV-CALL_R" [label="?DIV-CALL", shape=diamond];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="division-by-zero ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-CALL ?k ?u ?v)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
