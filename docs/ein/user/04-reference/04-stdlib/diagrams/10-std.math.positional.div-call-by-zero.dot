digraph rule_div_call_by_zero_lhs_rhs {
  rankdir=TB;
  label="div-call-by-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="?DONE ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-M1 ?k ?u ?v)_L" [shape=octagon, label="?DIV-M1", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "(?DIV-M1 ?k ?u ?v)_L" -> "z_L" [label="?DONE", color="#9467bd", fontcolor="#9467bd"];
    "(?DIV-M1 ?k ?u ?v)_L" -> "?k_L" [label="1", color="#bcbd22"];
    "(?DIV-M1 ?k ?u ?v)_L" -> "?u_L" [label="2", color="#bcbd22"];
    "(?DIV-M1 ?k ?u ?v)_L" -> "?v_L" [label="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="division-by-zero ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-CALL ?k ?u ?v)_R" [shape=octagon, label="?DIV-CALL", color="#e377c2", fontcolor="#e377c2"];
    }
    "h1_division-by-zero_R" [shape=octagon, label="division-by-zero", color="#e377c2", fontcolor="#e377c2"];
    "h1_division-by-zero_R" -> "(?DIV-CALL ?k ?u ?v)_R" [label="1", color="#e377c2", style=dashed];
    "(?DIV-CALL ?k ?u ?v)_R" -> "?k_R" [label="1", color="#e377c2", style=dashed];
    "(?DIV-CALL ?k ?u ?v)_R" -> "?u_R" [label="2", color="#e377c2", style=dashed];
    "(?DIV-CALL ?k ?u ?v)_R" -> "?v_R" [label="3", color="#e377c2", style=dashed];
  }
}
