digraph rule_rat_bad_first_lhs_rhs {
  rankdir=TB;
  label="rat-bad-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?request_L" [label="?request", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bad-operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-first ?request ?y))_L" [shape=octagon, label="rat-of", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_L_1 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-first ?request ?y)_L" [shape=octagon, label="rat-first", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "(rat-of (rat-first ?request ?y))_L" -> "?f_L" [label="bad-operand", color="#1f77b4", fontcolor="#1f77b4"];
    "(rat-of (rat-first ?request ?y))_L" -> "(rat-first ?request ?y)_L" [label="1", color="#2ca02c"];
    "(rat-first ?request ?y)_L" -> "?request_L" [label="1", color="#bcbd22"];
    "(rat-first ?request ?y)_L" -> "?y_L" [label="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "?request_R" [label="?request", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    "?request_R" -> "?f_R" [label="bad-request", color="#e377c2", fontcolor="#e377c2", style=dashed];
  }
}
