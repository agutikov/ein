digraph rule_rat_bad_second_lhs_rhs {
  rankdir=TB;
  label="rat-bad-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?request_L" [label="?request", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="bad-operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-second ?request ?p ?n ?d))_L" [shape=octagon, label="rat-of", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_L_1 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-second ?request ?p ?n ?d)_L" [shape=octagon, label="rat-second", color="#8c564b", fontcolor="#8c564b"];
    }
    "(rat-of (rat-second ?request ?p ?n ?d))_L" -> "?f_L" [label="bad-operand", color="#1f77b4", fontcolor="#1f77b4"];
    "(rat-of (rat-second ?request ?p ?n ?d))_L" -> "(rat-second ?request ?p ?n ?d)_L" [label="1", color="#2ca02c"];
    "(rat-second ?request ?p ?n ?d)_L" -> "?request_L" [label="1", color="#8c564b"];
    "(rat-second ?request ?p ?n ?d)_L" -> "?p_L" [label="2", color="#8c564b"];
    "(rat-second ?request ?p ?n ?d)_L" -> "?n_L" [label="3", color="#8c564b"];
    "(rat-second ?request ?p ?n ?d)_L" -> "?d_L" [label="4", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "?request_R" [label="?request", shape=diamond];
    "?f_R" [label="?f", shape=diamond];
    "?request_R" -> "?f_R" [label="bad-request", color="#e377c2", fontcolor="#e377c2", style=dashed];
  }
}
