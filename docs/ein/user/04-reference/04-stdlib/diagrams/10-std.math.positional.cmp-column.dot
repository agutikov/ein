    "(?N ?p ?a)_L" -> "?a_L" [xlabel="3", color="#7f7f7f"];
    "(?N ?q ?c)_L" -> "?N_L" [xlabel="1", color="#7f7f7f"];
    "(?N ?q ?c)_L" -> "?q_L" [xlabel="2", color="#7f7f7f"];
    "(?N ?q ?c)_L" -> "?c_L" [xlabel="3", color="#7f7f7f"];
