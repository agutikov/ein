    "?d_R" [label="?d", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    subgraph cluster_ctx_R_0 {
