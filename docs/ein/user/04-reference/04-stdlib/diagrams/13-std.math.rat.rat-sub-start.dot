    "(rat-sub ?x ?y)_L" -> "?x_L" [xlabel="2", color="#7f7f7f"];
    "(rat-sub ?x ?y)_L" -> "?y_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "rat-cross-run_R" [label="rat-cross-run", shape=box];
    "rat-sum-num_R" [label="rat-sum-num", shape=box];
