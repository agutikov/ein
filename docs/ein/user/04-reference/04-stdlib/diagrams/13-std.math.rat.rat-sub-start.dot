    "h1_rat-operand-is_L" -> "?e_L" [xlabel="5", color="#1f77b4"];
    "(rat-second (rat-sub ?x ?y) ?p ?n ?d)_L" -> "rat-second_L" [xlabel="1", color="#8c564b"];
    "(rat-second (rat-sub ?x ?y) ?p ?n ?d)_L" -> "(rat-sub ?x ?y)_L" [xlabel="2", color="#8c564b"];
    "(rat-second (rat-sub ?x ?y) ?p ?n ?d)_L" -> "?p_L" [xlabel="3", color="#8c564b"];
    "(rat-second (rat-sub ?x ?y) ?p ?n ?d)_L" -> "?n_L" [xlabel="4", color="#8c564b"];
    "(rat-second (rat-sub ?x ?y) ?p ?n ?d)_L" -> "?d_L" [xlabel="5", color="#8c564b"];
