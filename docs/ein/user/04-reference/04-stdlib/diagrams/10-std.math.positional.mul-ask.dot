digraph rule_mul_ask_lhs_rhs {
  rankdir=TB;
  label="mul-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?MUL_L" [label="?MUL", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_MUL_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    "?MUL_L" -> "h1_MUL_L" [xlabel="1", dir=back, color="#8c564b"];
    "h1_MUL_L" -> "?x_L" [xlabel="2", color="#8c564b"];
    "h1_MUL_L" -> "?y_L" [xlabel="3", color="#8c564b"];
  }
  subgraph cluster_rhs { label="assert";
    "?OPERAND_R" [label="?OPERAND", shape=diamond];
    "?MUL-FIRST_R" [label="?MUL-FIRST", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?MUL-FIRST ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_OPERAND_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "?OPERAND_R" -> "h2_OPERAND_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "(?MUL-FIRST ?x ?y)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?x_R" [xlabel="3", color="#d62728", style=dashed];
    "?MUL-FIRST_R" -> "(?MUL-FIRST ?x ?y)_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "(?MUL-FIRST ?x ?y)_R" -> "?x_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(?MUL-FIRST ?x ?y)_R" -> "?y_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}
