    "h2_rat-neg-of_R" -> "rat-neg-of_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_rat-neg-of_R" -> "?x_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_rat-neg-of_R" -> "?s_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
