    }
    "h1_rat-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_rat-done_L" -> "rat-done_L" [xlabel="1", color="#e377c2"];
    "h1_rat-done_L" -> "(rat-neg ?x)_L" [xlabel="2", color="#e377c2"];
    "h1_rat-done_L" -> "?s_L" [xlabel="3", color="#e377c2"];
    "(rat-neg ?x)_L" -> "rat-neg_L" [xlabel="1", color="#2ca02c"];
