digraph rule_rat_neg_ask_lhs_rhs {
  rankdir=TB;
  label="rat-neg-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-neg_L" [label="rat-neg", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "h1_rat-neg_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "rat-neg_L" -> "h1_rat-neg_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_rat-neg_L" -> "?x_L" [xlabel="2", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "operand_R" [label="operand", shape=box];
    "rat-of_R" [label="rat-of", shape=box];
    "rat-only_R" [label="rat-only", shape=box];
    "rat-neg_R" [label="rat-neg", shape=box];
    "?x_R" [label="?x", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-only (rat-neg ?x)))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-only (rat-neg ?x))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    subgraph cluster_ctx_R_2 {
      label="rat-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-neg ?x)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h2_operand_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "operand_R" -> "h2_operand_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_operand_R" -> "(rat-of (rat-only (rat-neg ?x)))_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "?x_R" [xlabel="3", color="#2ca02c", style=dashed];
    "rat-of_R" -> "(rat-of (rat-only (rat-neg ?x)))_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(rat-of (rat-only (rat-neg ?x)))_R" -> "(rat-only (rat-neg ?x))_R" [xlabel="2", color="#2ca02c", style=dashed];
    "rat-only_R" -> "(rat-only (rat-neg ?x))_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(rat-only (rat-neg ?x))_R" -> "(rat-neg ?x)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "rat-neg_R" -> "(rat-neg ?x)_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(rat-neg ?x)_R" -> "?x_R" [xlabel="2", color="#2ca02c", style=dashed];
  }
}
