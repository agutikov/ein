digraph rule_rat_neg_ask_lhs_rhs {
  rankdir=TB;
  label="rat-neg-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "h1_rat-neg_L" [shape=octagon, label="rat-neg", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_rat-neg_L" -> "?x_L" [label="1", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-only (rat-neg ?x)))_R" [shape=octagon, label="rat-of", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-only (rat-neg ?x))_R" [shape=octagon, label="rat-only", color="#2ca02c", fontcolor="#2ca02c"];
    }
    subgraph cluster_ctx_R_2 {
      label="rat-only ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-neg ?x)_R" [shape=octagon, label="rat-neg", color="#2ca02c", fontcolor="#2ca02c"];
    }
    "(rat-of (rat-only (rat-neg ?x)))_R" -> "?x_R" [label="operand", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(rat-of (rat-only (rat-neg ?x)))_R" -> "(rat-only (rat-neg ?x))_R" [label="1", color="#2ca02c", style=dashed];
    "(rat-only (rat-neg ?x))_R" -> "(rat-neg ?x)_R" [label="1", color="#2ca02c", style=dashed];
    "(rat-neg ?x)_R" -> "?x_R" [label="1", color="#2ca02c", style=dashed];
  }
}
