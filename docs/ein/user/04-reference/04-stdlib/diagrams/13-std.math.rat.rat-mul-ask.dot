digraph rule_rat_mul_ask_lhs_rhs {
  rankdir=TB;
  label="rat-mul-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-mul_L" [label="rat-mul", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_rat-mul_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "h1_rat-mul_L" -> "rat-mul_L" [xlabel="1", color="#17becf"];
    "h1_rat-mul_L" -> "?x_L" [xlabel="2", color="#17becf"];
    "h1_rat-mul_L" -> "?y_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "operand_R" [label="operand", shape=box];
    "rat-of_R" [label="rat-of", shape=box];
    "rat-first_R" [label="rat-first", shape=box];
    "rat-mul_R" [label="rat-mul", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-of (rat-first (rat-mul ?x ?y) ?y))_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    subgraph cluster_ctx_R_1 {
      label="rat-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-mul ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    subgraph cluster_ctx_R_2 {
      label="rat-of ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-first (rat-mul ?x ?y) ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_operand_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_operand_R" -> "operand_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "(rat-of (rat-first (rat-mul ?x ?y) ?y))_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "?x_R" [xlabel="3", color="#2ca02c", style=dashed];
    "(rat-of (rat-first (rat-mul ?x ?y) ?y))_R" -> "rat-of_R" [xlabel="1", color="#2ca02c", style=dashed];
    "(rat-of (rat-first (rat-mul ?x ?y) ?y))_R" -> "(rat-first (rat-mul ?x ?y) ?y)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(rat-first (rat-mul ?x ?y) ?y)_R" -> "rat-first_R" [xlabel="1", color="#bcbd22", style=dashed];
    "(rat-first (rat-mul ?x ?y) ?y)_R" -> "(rat-mul ?x ?y)_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(rat-first (rat-mul ?x ?y) ?y)_R" -> "?y_R" [xlabel="3", color="#bcbd22", style=dashed];
    "(rat-mul ?x ?y)_R" -> "rat-mul_R" [xlabel="1", color="#17becf", style=dashed];
    "(rat-mul ?x ?y)_R" -> "?x_R" [xlabel="2", color="#17becf", style=dashed];
    "(rat-mul ?x ?y)_R" -> "?y_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
