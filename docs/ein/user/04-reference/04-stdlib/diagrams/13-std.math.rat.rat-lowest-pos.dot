  }
  subgraph cluster_rhs { label="assert";
    "rat-done_R" [label="rat-done", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "rat_R" [label="rat", shape=box];
    "int_R" [label="int", shape=box];
    "?q_R" [label="?q", shape=diamond];
