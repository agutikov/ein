digraph rule_rat_simplify_pos_lhs_rhs {
  rankdir=TB;
  label="rat-simplify-pos"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-low ?k ?d)_L" [shape=octagon, label="rat-low", color="#2ca02c", fontcolor="#2ca02c"];
      "(int ?a z)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(rat-low ?k ?d)_L" -> "(int ?a z)_L" [label="int-done", color="#1f77b4", fontcolor="#1f77b4"];
    "(rat-low ?k ?d)_L" -> "?k_L" [label="1", color="#2ca02c"];
    "(rat-low ?k ?d)_L" -> "?d_L" [label="2", color="#2ca02c"];
    "(int ?a z)_L" -> "?a_L" [label="1", color="#17becf"];
    "(int ?a z)_L" -> "z_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "pos_R" [label="pos", shape=rectangle];
    "?a_R" [label="?a", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-g ?k pos ?a ?d)_R" [shape=octagon, label="rat-g", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "h1_gcd-call_R" [shape=octagon, label="gcd-call", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_gcd-call_R" -> "(rat-g ?k pos ?a ?d)_R" [label="1", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "?a_R" [label="2", color="#2ca02c", style=dashed];
    "h1_gcd-call_R" -> "?d_R" [label="3", color="#2ca02c", style=dashed];
    "(rat-g ?k pos ?a ?d)_R" -> "?k_R" [label="1", color="#1f77b4", style=dashed];
    "(rat-g ?k pos ?a ?d)_R" -> "pos_R" [label="2", color="#1f77b4", style=dashed];
    "(rat-g ?k pos ?a ?d)_R" -> "?a_R" [label="3", color="#1f77b4", style=dashed];
    "(rat-g ?k pos ?a ?d)_R" -> "?d_R" [label="4", color="#1f77b4", style=dashed];
  }
}
