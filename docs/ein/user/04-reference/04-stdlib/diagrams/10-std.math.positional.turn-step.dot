digraph rule_turn_step_lhs_rhs {
  rankdir=TB;
  label="turn-step"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?TURN_L" [label="?TURN", shape=diamond];
    "?k_L" [label="?k", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?r_L" [label="?r", shape=diamond];
    "?acc_L" [label="?acc", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?TURN ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?B ?a ?r)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_TURN_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_TURN_L" -> "?TURN_L" [xlabel="1", color="#9467bd"];
    "h1_TURN_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "h1_TURN_L" -> "(?B ?a ?r)_L" [xlabel="3", color="#9467bd"];
    "h1_TURN_L" -> "?acc_L" [xlabel="4", color="#9467bd"];
    "(?B ?a ?r)_L" -> "?B_L" [xlabel="1", color="#2ca02c"];
    "(?B ?a ?r)_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "(?B ?a ?r)_L" -> "?r_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "?TURN_R" [label="?TURN", shape=diamond];
    "?k_R" [label="?k", shape=diamond];
    "?r_R" [label="?r", shape=diamond];
    "?N_R" [label="?N", shape=diamond];
    "?acc_R" [label="?acc", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?TURN ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?N ?acc ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_TURN_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "h2_TURN_R" -> "?TURN_R" [xlabel="1", color="#9467bd", style=dashed];
    "h2_TURN_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h2_TURN_R" -> "?r_R" [xlabel="3", color="#9467bd", style=dashed];
    "h2_TURN_R" -> "(?N ?acc ?a)_R" [xlabel="4", color="#9467bd", style=dashed];
    "(?N ?acc ?a)_R" -> "?N_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "(?N ?acc ?a)_R" -> "?acc_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "(?N ?acc ?a)_R" -> "?a_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
}
