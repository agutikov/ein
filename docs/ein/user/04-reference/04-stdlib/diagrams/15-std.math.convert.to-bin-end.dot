digraph rule_to_bin_end_lhs_rhs {
  rankdir=TB;
  label="to-bin-end"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "to-bin-go_L" [label="to-bin-go", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "z_L" [label="z", shape=box];
    "?acc_L" [label="?acc", shape=diamond];
    "h1_to-bin-go_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    "h1_to-bin-go_L" -> "to-bin-go_L" [xlabel="1", color="#17becf"];
    "h1_to-bin-go_L" -> "?x_L" [xlabel="2", color="#17becf"];
    "h1_to-bin-go_L" -> "z_L" [xlabel="3", color="#17becf"];
    "h1_to-bin-go_L" -> "?acc_L" [xlabel="4", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-strip_R" [label="bin-strip", shape=box];
    "bits_R" [label="bits", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?acc_R" [label="?acc", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="bin-strip ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(bits ?x)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_bin-strip_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_bin-strip_R" -> "bin-strip_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_bin-strip_R" -> "(bits ?x)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_bin-strip_R" -> "?acc_R" [xlabel="3", color="#2ca02c", style=dashed];
    "(bits ?x)_R" -> "bits_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "(bits ?x)_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
  }
}
