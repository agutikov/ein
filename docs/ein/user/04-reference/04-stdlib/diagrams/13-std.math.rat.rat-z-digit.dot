digraph rule_rat_z_digit_lhs_rhs {
  rankdir=TB;
  label="rat-z-digit"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-check_L" [label="rat-check", shape=box];
    "rat_L" [label="rat", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "nz_L" [label="nz", shape=box];
    subgraph cluster_ctx_L_0 {
      label="rat-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?x ?d)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h1_rat-check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "rat-check_L" -> "h1_rat-check_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_rat-check_L" -> "(rat ?x ?d)_L" [xlabel="2", color="#e377c2"];
    "h2_nz_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "nz_L" -> "h2_nz_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h2_nz_L" -> "?x_L" [xlabel="2", color="#2ca02c"];
    "rat_L" -> "(rat ?x ?d)_L" [xlabel="1", dir=back, color="#d62728"];
    "(rat ?x ?d)_L" -> "?x_L" [xlabel="2", color="#d62728"];
    "(rat ?x ?d)_L" -> "?d_L" [xlabel="3", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "not-rational_R" [label="not-rational", shape=box];
    "rat_R" [label="rat", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not-rational ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?x ?d)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h3_not-rational_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "not-rational_R" -> "h3_not-rational_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h3_not-rational_R" -> "(rat ?x ?d)_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h3_not-rational_R" -> "?x_R" [xlabel="3", color="#1f77b4", style=dashed];
    "rat_R" -> "(rat ?x ?d)_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "(rat ?x ?d)_R" -> "?x_R" [xlabel="2", color="#d62728", style=dashed];
    "(rat ?x ?d)_R" -> "?d_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
