digraph rule_sub_answer_lhs_rhs {
  rankdir=TB;
  label="sub-answer"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?DONE_L" [label="?DONE", shape=diamond];
    "?DIFFERENCE_L" [label="?DIFFERENCE", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?DONE ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIFFERENCE ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h1_DONE_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_DONE_L" -> "?DONE_L" [xlabel="1", color="#9467bd"];
    "h1_DONE_L" -> "(?DIFFERENCE ?x ?y)_L" [xlabel="2", color="#9467bd"];
    "h1_DONE_L" -> "?d_L" [xlabel="3", color="#9467bd"];
    "(?DIFFERENCE ?x ?y)_L" -> "?DIFFERENCE_L" [xlabel="1", color="#ff7f0e"];
    "(?DIFFERENCE ?x ?y)_L" -> "?x_L" [xlabel="2", color="#ff7f0e"];
    "(?DIFFERENCE ?x ?y)_L" -> "?y_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "?DIFF-OF_R" [label="?DIFF-OF", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "z_R" [label="z", shape=box];
    "h2_DIFF-OF_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "h2_DIFF-OF_R" -> "?DIFF-OF_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "h2_DIFF-OF_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_DIFF-OF_R" -> "?y_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_DIFF-OF_R" -> "?d_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_DIFF-OF_R" -> "z_R" [xlabel="5", color="#7f7f7f", style=dashed];
  }
}
