digraph rule_cmp_ask_lhs_rhs {
  rankdir=TB;
  label="cmp-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?CMP_L" [label="?CMP", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_CMP_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "?CMP_L" -> "h1_CMP_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_CMP_L" -> "?x_L" [xlabel="2", color="#ff7f0e"];
    "h1_CMP_L" -> "?y_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "?OPERAND_R" [label="?OPERAND", shape=diamond];
    "?CMP-FIRST_R" [label="?CMP-FIRST", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?CMP-FIRST ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_OPERAND_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "?OPERAND_R" -> "h2_OPERAND_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "(?CMP-FIRST ?x ?y)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?x_R" [xlabel="3", color="#d62728", style=dashed];
    "?CMP-FIRST_R" -> "(?CMP-FIRST ?x ?y)_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "(?CMP-FIRST ?x ?y)_R" -> "?x_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(?CMP-FIRST ?x ?y)_R" -> "?y_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
