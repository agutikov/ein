digraph rule_to9_check_lhs_rhs {
  rankdir=TB;
  label="to9-check"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "h1_to9_L" [shape=octagon, label="to9", color="#9467bd", fontcolor="#9467bd"];
    "h1_to9_L" -> "?x_L" [label="1", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?x_R" -> "?x_R" [label="check", color="#7f7f7f", fontcolor="#7f7f7f", style=dashed];
  }
}
