digraph rule_symmetric_is_self_converse_lhs_rhs {
  rankdir=TB;
  label="symmetric-is-self-converse"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "symmetric_L" [label="symmetric", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "h1_symmetric_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_symmetric_L" -> "symmetric_L" [xlabel="1", color="#7f7f7f"];
    "h1_symmetric_L" -> "?R_L" [xlabel="2", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "converse_R" [label="converse", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "h2_converse_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h2_converse_R" -> "converse_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h2_converse_R" -> "?R_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_converse_R" -> "?R_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
