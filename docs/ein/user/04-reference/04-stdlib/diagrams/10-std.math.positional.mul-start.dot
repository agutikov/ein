digraph rule_mul_start_lhs_rhs {
  rankdir=TB;
  label="mul-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?OPERAND-IS ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?MUL-SECOND ?x ?y ?u)_L" [shape=octagon, label="?MUL-SECOND", color="#9467bd", fontcolor="#9467bd"];
    }
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?v_L" [label="?OPERAND-IS", color="#bcbd22", fontcolor="#bcbd22"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?x_L" [label="1", color="#9467bd"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?y_L" [label="2", color="#9467bd"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?u_L" [label="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?MUL-CALL ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?PRODUCT ?x ?y)_R" [shape=octagon, label="?PRODUCT", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "h1_MUL-CALL_R" [shape=octagon, label="?MUL-CALL", color="#bcbd22", fontcolor="#bcbd22"];
    "h1_MUL-CALL_R" -> "(?PRODUCT ?x ?y)_R" [label="1", color="#bcbd22", style=dashed];
    "h1_MUL-CALL_R" -> "?u_R" [label="2", color="#bcbd22", style=dashed];
    "h1_MUL-CALL_R" -> "?v_R" [label="3", color="#bcbd22", style=dashed];
    "(?PRODUCT ?x ?y)_R" -> "?x_R" [label="1", color="#bcbd22", style=dashed];
    "(?PRODUCT ?x ?y)_R" -> "?y_R" [label="2", color="#bcbd22", style=dashed];
  }
}
