digraph rule_mul_start_lhs_rhs {
  rankdir=TB;
  label="mul-start"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?OPERAND-IS_L" [label="?OPERAND-IS", shape=diamond];
    "?MUL-SECOND_L" [label="?MUL-SECOND", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="?OPERAND-IS ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?MUL-SECOND ?x ?y ?u)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_OPERAND-IS_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?OPERAND-IS_L" -> "h1_OPERAND-IS_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_OPERAND-IS_L" -> "(?MUL-SECOND ?x ?y ?u)_L" [xlabel="2", color="#bcbd22"];
    "h1_OPERAND-IS_L" -> "?v_L" [xlabel="3", color="#bcbd22"];
    "?MUL-SECOND_L" -> "(?MUL-SECOND ?x ?y ?u)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?x_L" [xlabel="2", color="#9467bd"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?y_L" [xlabel="3", color="#9467bd"];
    "(?MUL-SECOND ?x ?y ?u)_L" -> "?u_L" [xlabel="4", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?MUL-RUN_R" [label="?MUL-RUN", shape=diamond];
    "?PRODUCT_R" [label="?PRODUCT", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?MUL-RUN ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?PRODUCT ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_MUL-RUN_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "?MUL-RUN_R" -> "h2_MUL-RUN_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "h2_MUL-RUN_R" -> "(?PRODUCT ?x ?y)_R" [xlabel="2", color="#9467bd", style=dashed];
    "h2_MUL-RUN_R" -> "?u_R" [xlabel="3", color="#9467bd", style=dashed];
    "h2_MUL-RUN_R" -> "?v_R" [xlabel="4", color="#9467bd", style=dashed];
    "?PRODUCT_R" -> "(?PRODUCT ?x ?y)_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "(?PRODUCT ?x ?y)_R" -> "?x_R" [xlabel="2", color="#bcbd22", style=dashed];
    "(?PRODUCT ?x ?y)_R" -> "?y_R" [xlabel="3", color="#bcbd22", style=dashed];
  }
}
