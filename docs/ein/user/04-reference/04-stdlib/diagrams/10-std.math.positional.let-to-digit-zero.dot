digraph rule_let_to_digit_zero_lhs_rhs {
  rankdir=TB;
  label="let-to-digit-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?LET_L" [label="?LET", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "0_L" [label="0", shape=box];
    "h1_LET_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h1_LET_L" -> "?LET_L" [xlabel="1", color="#7f7f7f"];
    "h1_LET_L" -> "?x_L" [xlabel="2", color="#7f7f7f"];
    "h1_LET_L" -> "0_L" [xlabel="3", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "?MALFORMED_R" [label="?MALFORMED", shape=diamond];
    "?LET_R" [label="?LET", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="?MALFORMED ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?LET ?x 0)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_MALFORMED_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "h2_MALFORMED_R" -> "?MALFORMED_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "h2_MALFORMED_R" -> "(?LET ?x 0)_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(?LET ?x 0)_R" -> "?LET_R" [xlabel="1", color="#7f7f7f", style=dashed];
    "(?LET ?x 0)_R" -> "?x_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "(?LET ?x 0)_R" -> "0_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
}
