digraph rule_rat_norm_done_lhs_rhs {
  rankdir=TB;
  label="rat-norm-done"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "rat-den-norm_L" [label="rat-den-norm", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?i_L" [label="?i", shape=diamond];
    "?e_L" [label="?e", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-den-norm ?k ?i)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "done_L" -> "h1_done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_done_L" -> "(rat-den-norm ?k ?i)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?e_L" [xlabel="3", color="#e377c2"];
    "rat-den-norm_L" -> "(rat-den-norm ?k ?i)_L" [xlabel="1", dir=back, color="#17becf"];
    "(rat-den-norm ?k ?i)_L" -> "?k_L" [xlabel="2", color="#17becf"];
    "(rat-den-norm ?k ?i)_L" -> "?i_L" [xlabel="3", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "rat-done_R" [label="rat-done", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "rat_R" [label="rat", shape=box];
    "?i_R" [label="?i", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="rat-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat ?i ?e)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h2_rat-done_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "rat-done_R" -> "h2_rat-done_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h2_rat-done_R" -> "?k_R" [xlabel="2", color="#e377c2", style=dashed];
    "h2_rat-done_R" -> "(rat ?i ?e)_R" [xlabel="3", color="#e377c2", style=dashed];
    "rat_R" -> "(rat ?i ?e)_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "(rat ?i ?e)_R" -> "?i_R" [xlabel="2", color="#d62728", style=dashed];
    "(rat ?i ?e)_R" -> "?e_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
