digraph rule_clash_of_0_lhs_rhs {
  rankdir=TB;
  label="clash-of-0"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "relation_L" [label="relation", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "h1_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "relation_L" -> "h1_relation_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "clash-0_R" [label="clash-0", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "h2_clash-0_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "clash-0_R" -> "h2_clash-0_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h2_clash-0_R" -> "?R_R" [xlabel="2", color="#17becf", style=dashed];
  }
}
