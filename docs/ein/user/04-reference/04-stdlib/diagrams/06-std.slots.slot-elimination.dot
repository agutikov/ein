digraph rule_slot_elimination_lhs_rhs {
  rankdir=TB;
  label="slot-elimination"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?Ta_L" [label="?Ta", shape=diamond];
    "?sub_L" [label="?sub", shape=diamond];
    "?super_L" [label="?super", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    "?i_L" [label="?i", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?i_other_L" [label="?i_other", shape=diamond];
    "and_L" [label="and", shape=box];
    "neq_L" [label="neq", shape=box];
    "not_L" [label="not", shape=box];
    "?R_L" [label="?R", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="and ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?i_other ?index)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(neq ?i_other ?i)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_L_1 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(and (?isa ?i_other ?index) (neq ?i_other ?i))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(not (?R ?a ?i_other))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_2 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?i_other)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?Ta_L" [xlabel="3", color="#bcbd22"];
    "h2_sub_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h2_sub_L" -> "?sub_L" [xlabel="1", color="#9467bd"];
    "h2_sub_L" -> "?Ta_L" [xlabel="2", color="#9467bd"];
    "h2_sub_L" -> "?super_L" [xlabel="3", color="#9467bd"];
    "?Ta_L" -> "?index_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h3_isa_L" -> "?i_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "h4_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h4_forall_L" -> "forall_L" [xlabel="1", color="#1f77b4"];
    "h4_forall_L" -> "?i_other_L" [xlabel="2", color="#1f77b4"];
    "h4_forall_L" -> "(and (?isa ?i_other ?index) (neq ?i_other ?i))_L" [xlabel="3", color="#1f77b4"];
    "h4_forall_L" -> "(not (?R ?a ?i_other))_L" [xlabel="4", color="#1f77b4"];
    "(and (?isa ?i_other ?index) (neq ?i_other ?i))_L" -> "and_L" [xlabel="1", color="#7f7f7f"];
    "(and (?isa ?i_other ?index) (neq ?i_other ?i))_L" -> "(?isa ?i_other ?index)_L" [xlabel="2", color="#7f7f7f"];
    "(and (?isa ?i_other ?index) (neq ?i_other ?i))_L" -> "(neq ?i_other ?i)_L" [xlabel="3", color="#7f7f7f"];
    "(?isa ?i_other ?index)_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "(?isa ?i_other ?index)_L" -> "?i_other_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?i_other ?index)_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "(neq ?i_other ?i)_L" -> "neq_L" [xlabel="1", color="#1f77b4"];
    "(neq ?i_other ?i)_L" -> "?i_other_L" [xlabel="2", color="#1f77b4"];
    "(neq ?i_other ?i)_L" -> "?i_L" [xlabel="3", color="#1f77b4"];
    "(not (?R ?a ?i_other))_L" -> "not_L" [xlabel="1", color="#d62728"];
    "(not (?R ?a ?i_other))_L" -> "(?R ?a ?i_other)_L" [xlabel="2", color="#d62728"];
    "(?R ?a ?i_other)_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "(?R ?a ?i_other)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(?R ?a ?i_other)_L" -> "?i_other_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?i_R" [label="?i", shape=diamond];
    "h5_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h5_R_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h5_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h5_R_R" -> "?i_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
