digraph rule_to_dec_next_lhs_rhs {
  rankdir=TB;
  label="to-dec-next"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "doubling_L" [label="doubling", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(doubling ?b ?rest)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "done_L" -> "h1_done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_done_L" -> "(doubling ?b ?rest)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?s_L" [xlabel="3", color="#e377c2"];
    "doubling_L" -> "(doubling ?b ?rest)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(doubling ?b ?rest)_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "(doubling ?b ?rest)_L" -> "?rest_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "to-dec-go_R" [label="to-dec-go", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "h2_to-dec-go_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22", style=dashed];
    "to-dec-go_R" -> "h2_to-dec-go_R" [xlabel="1", dir=back, color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "?b_R" [xlabel="2", color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "?rest_R" [xlabel="3", color="#bcbd22", style=dashed];
    "h2_to-dec-go_R" -> "?s_R" [xlabel="4", color="#bcbd22", style=dashed];
  }
}
