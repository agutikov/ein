digraph rule_int_div_pn_lhs_rhs {
  rankdir=TB;
  label="int-div-pn"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "z_L" [label="z", shape=rectangle];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="int-div-b ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?a z)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    subgraph cluster_ctx_L_2 {
      label="int-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-b ?k (int ?a z))_L" [shape=octagon, label="int-div-b", color="#17becf", fontcolor="#17becf"];
      "(int z (n ?b ?c))_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "(int-div-b ?k (int ?a z))_L" -> "(int z (n ?b ?c))_L" [label="int-done", color="#1f77b4", fontcolor="#1f77b4"];
    "(int-div-b ?k (int ?a z))_L" -> "?k_L" [label="1", color="#17becf"];
    "(int-div-b ?k (int ?a z))_L" -> "(int ?a z)_L" [label="2", color="#17becf"];
    "(int ?a z)_L" -> "?a_L" [label="1", color="#17becf"];
    "(int ?a z)_L" -> "z_L" [label="2", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "z_L" [label="1", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "(n ?b ?c)_L" [label="2", color="#17becf"];
    "(n ?b ?c)_L" -> "?b_L" [label="1", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [label="2", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "pos_R" [label="pos", shape=rectangle];
    "neg_R" [label="neg", shape=rectangle];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="div-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-div-m ?k pos neg (n ?b ?c))_R" [shape=octagon, label="int-div-m", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    subgraph cluster_ctx_R_1 {
      label="div-call, int-div-m ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?b ?c)_R" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "h1_div-call_R" [shape=octagon, label="div-call", color="#bcbd22", fontcolor="#bcbd22"];
    "h1_div-call_R" -> "(int-div-m ?k pos neg (n ?b ?c))_R" [label="1", color="#bcbd22", style=dashed];
    "h1_div-call_R" -> "?a_R" [label="2", color="#bcbd22", style=dashed];
    "h1_div-call_R" -> "(n ?b ?c)_R" [label="3", color="#bcbd22", style=dashed];
    "(int-div-m ?k pos neg (n ?b ?c))_R" -> "?k_R" [label="1", color="#ff7f0e", style=dashed];
    "(int-div-m ?k pos neg (n ?b ?c))_R" -> "pos_R" [label="2", color="#ff7f0e", style=dashed];
    "(int-div-m ?k pos neg (n ?b ?c))_R" -> "neg_R" [label="3", color="#ff7f0e", style=dashed];
    "(int-div-m ?k pos neg (n ?b ?c))_R" -> "(n ?b ?c)_R" [label="4", color="#ff7f0e", style=dashed];
    "(n ?b ?c)_R" -> "?b_R" [label="1", color="#9467bd", style=dashed];
    "(n ?b ?c)_R" -> "?c_R" [label="2", color="#9467bd", style=dashed];
  }
}
