      "(int z (n ?b ?c))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h1_int-done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_int-done_L" -> "int-done_L" [xlabel="1", color="#1f77b4"];
    "h1_int-done_L" -> "(int-div-b ?k (int ?a z))_L" [xlabel="2", color="#1f77b4"];
    "h1_int-done_L" -> "(int z (n ?b ?c))_L" [xlabel="3", color="#1f77b4"];
    "(int-div-b ?k (int ?a z))_L" -> "int-div-b_L" [xlabel="1", color="#17becf"];
    "(int-div-b ?k (int ?a z))_L" -> "?k_L" [xlabel="2", color="#17becf"];
    "(int-div-b ?k (int ?a z))_L" -> "(int ?a z)_L" [xlabel="3", color="#17becf"];
    "(int ?a z)_L" -> "int_L" [xlabel="1", color="#17becf"];
    "(int ?a z)_L" -> "?a_L" [xlabel="2", color="#17becf"];
    "(int ?a z)_L" -> "z_L" [xlabel="3", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "int_L" [xlabel="1", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "z_L" [xlabel="2", color="#17becf"];
    "(int z (n ?b ?c))_L" -> "(n ?b ?c)_L" [xlabel="3", color="#17becf"];
    "(n ?b ?c)_L" -> "n_L" [xlabel="1", color="#9467bd"];
    "(n ?b ?c)_L" -> "?b_L" [xlabel="2", color="#9467bd"];
    "(n ?b ?c)_L" -> "?c_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "div-run_R" [label="div-run", shape=box];
    "int-div-m_R" [label="int-div-m", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "pos_R" [label="pos", shape=box];
    "neg_R" [label="neg", shape=box];
    "n_R" [label="n", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "?c_R" [label="?c", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
