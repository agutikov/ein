digraph rule_lcm_ask_lhs_rhs {
  rankdir=TB;
  label="lcm-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "lcm_L" [label="lcm", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_lcm_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "lcm_L" -> "h1_lcm_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_lcm_L" -> "?x_L" [xlabel="2", color="#1f77b4"];
    "h1_lcm_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "operand_R" [label="operand", shape=box];
    "gcd-first_R" [label="gcd-first", shape=box];
    "lcm_R" [label="lcm", shape=box];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="gcd-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(lcm ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_R_1 {
      label="operand ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-first (lcm ?x ?y) ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    }
    "h2_operand_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "operand_R" -> "h2_operand_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h2_operand_R" -> "(gcd-first (lcm ?x ?y) ?y)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h2_operand_R" -> "?x_R" [xlabel="3", color="#2ca02c", style=dashed];
    "gcd-first_R" -> "(gcd-first (lcm ?x ?y) ?y)_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "(gcd-first (lcm ?x ?y) ?y)_R" -> "(lcm ?x ?y)_R" [xlabel="2", color="#e377c2", style=dashed];
    "(gcd-first (lcm ?x ?y) ?y)_R" -> "?y_R" [xlabel="3", color="#e377c2", style=dashed];
    "lcm_R" -> "(lcm ?x ?y)_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "(lcm ?x ?y)_R" -> "?x_R" [xlabel="2", color="#1f77b4", style=dashed];
    "(lcm ?x ?y)_R" -> "?y_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
