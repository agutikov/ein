digraph rule_slot_no_room_lhs_rhs {
  rankdir=TB;
  label="slot-no-room"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?Ta_L" [label="?Ta", shape=diamond];
    "?sub_L" [label="?sub", shape=diamond];
    "?super_L" [label="?super", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?i_L" [label="?i", shape=diamond];
    "not_L" [label="not", shape=box];
    "?R_L" [label="?R", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?i ?index)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(not (?R ?a ?i))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_1 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?i)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h1_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?Ta_L" [xlabel="3", color="#bcbd22"];
    "h2_sub_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "?sub_L" -> "h2_sub_L" [xlabel="1", dir=back, color="#9467bd"];
    "h2_sub_L" -> "?Ta_L" [xlabel="2", color="#9467bd"];
    "h2_sub_L" -> "?super_L" [xlabel="3", color="#9467bd"];
    "?Ta_L" -> "?index_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    "h3_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "forall_L" -> "h3_forall_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h3_forall_L" -> "?i_L" [xlabel="2", color="#1f77b4"];
    "h3_forall_L" -> "(?isa ?i ?index)_L" [xlabel="3", color="#1f77b4"];
    "h3_forall_L" -> "(not (?R ?a ?i))_L" [xlabel="4", color="#1f77b4"];
    "?isa_L" -> "(?isa ?i ?index)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(?isa ?i ?index)_L" -> "?i_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?i ?index)_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "not_L" -> "(not (?R ?a ?i))_L" [xlabel="1", dir=back, color="#d62728"];
    "(not (?R ?a ?i))_L" -> "(?R ?a ?i)_L" [xlabel="2", color="#d62728"];
    "?R_L" -> "(?R ?a ?i)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(?R ?a ?i)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(?R ?a ?i)_L" -> "?i_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h4_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h4_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
