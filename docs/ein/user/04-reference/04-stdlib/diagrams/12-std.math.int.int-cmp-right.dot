digraph rule_int_cmp_right_lhs_rhs {
  rankdir=TB;
  label="int-cmp-right"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "int-cmp-l_L" [label="int-cmp-l", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?q_L" [label="?q", shape=diamond];
    "?l_L" [label="?l", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-cmp-l ?k ?n ?q)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "done_L" -> "h1_done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_done_L" -> "(int-cmp-l ?k ?n ?q)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?l_L" [xlabel="3", color="#e377c2"];
    "int-cmp-l_L" -> "(int-cmp-l ?k ?n ?q)_L" [xlabel="1", dir=back, color="#d62728"];
    "(int-cmp-l ?k ?n ?q)_L" -> "?k_L" [xlabel="2", color="#d62728"];
    "(int-cmp-l ?k ?n ?q)_L" -> "?n_L" [xlabel="3", color="#d62728"];
    "(int-cmp-l ?k ?n ?q)_L" -> "?q_L" [xlabel="4", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "add-run_R" [label="add-run", shape=box];
    "int-cmp-r_R" [label="int-cmp-r", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?l_R" [label="?l", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?q_R" [label="?q", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int-cmp-r ?k ?l)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_add-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "add-run_R" -> "h2_add-run_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "(int-cmp-r ?k ?l)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?n_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?q_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "int-cmp-r_R" -> "(int-cmp-r ?k ?l)_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "(int-cmp-r ?k ?l)_R" -> "?k_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(int-cmp-r ?k ?l)_R" -> "?l_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}
