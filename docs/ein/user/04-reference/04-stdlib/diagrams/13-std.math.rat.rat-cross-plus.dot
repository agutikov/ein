digraph rule_rat_cross_plus_lhs_rhs {
  rankdir=TB;
  label="rat-cross-plus"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?m_L" [label="?m", shape=diamond];
    "?e_L" [label="?e", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" [shape=octagon, label="rat-x2", color="#7f7f7f", fontcolor="#7f7f7f"];
    }
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?b_L" [label="done", color="#e377c2", fontcolor="#e377c2"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?k_L" [label="1", color="#7f7f7f"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?n_L" [label="2", color="#7f7f7f"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?d_L" [label="3", color="#7f7f7f"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?m_L" [label="4", color="#7f7f7f"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?e_L" [label="5", color="#7f7f7f"];
    "(rat-x2 ?k ?n ?d ?m ?e ?a)_L" -> "?a_L" [label="6", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?m_R" [label="?m", shape=diamond];
    "?e_R" [label="?e", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "0_R" [label="0", shape=rectangle];
    "z_R" [label="z", shape=rectangle];
    subgraph cluster_ctx_R_0 {
      label="add-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x3 ?k ?n ?d ?m ?e)_R" [shape=octagon, label="rat-x3", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "h1_add-walk_R" [shape=octagon, label="add-walk", color="#17becf", fontcolor="#17becf"];
    "h1_add-walk_R" -> "(rat-x3 ?k ?n ?d ?m ?e)_R" [label="1", color="#17becf", style=dashed];
    "h1_add-walk_R" -> "?a_R" [label="2", color="#17becf", style=dashed];
    "h1_add-walk_R" -> "?b_R" [label="3", color="#17becf", style=dashed];
    "h1_add-walk_R" -> "0_R" [label="4", color="#17becf", style=dashed];
    "h1_add-walk_R" -> "z_R" [label="5", color="#17becf", style=dashed];
    "(rat-x3 ?k ?n ?d ?m ?e)_R" -> "?k_R" [label="1", color="#1f77b4", style=dashed];
    "(rat-x3 ?k ?n ?d ?m ?e)_R" -> "?n_R" [label="2", color="#1f77b4", style=dashed];
    "(rat-x3 ?k ?n ?d ?m ?e)_R" -> "?d_R" [label="3", color="#1f77b4", style=dashed];
    "(rat-x3 ?k ?n ?d ?m ?e)_R" -> "?m_R" [label="4", color="#1f77b4", style=dashed];
    "(rat-x3 ?k ?n ?d ?m ?e)_R" -> "?e_R" [label="5", color="#1f77b4", style=dashed];
  }
