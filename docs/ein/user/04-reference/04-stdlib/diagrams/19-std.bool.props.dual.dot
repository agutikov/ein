digraph rule_dual_lhs_rhs {
  rankdir=TB;
  label="dual"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "column_L" [label="column", shape=box];
    "?f_L" [label="?f", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "inv_L" [label="inv", shape=box];
    "?a1_L" [label="?a1", shape=diamond];
    "?b1_L" [label="?b1", shape=diamond];
    "?c1_L" [label="?c1", shape=diamond];
    "?d1_L" [label="?d1", shape=diamond];
    "?g_L" [label="?g", shape=diamond];
    "h1_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "column_L" -> "h1_column_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_column_L" -> "?f_L" [xlabel="2", color="#d62728"];
    "h1_column_L" -> "?a_L" [xlabel="3", color="#d62728"];
    "h1_column_L" -> "?b_L" [xlabel="4", color="#d62728"];
    "h1_column_L" -> "?c_L" [xlabel="5", color="#d62728"];
    "h1_column_L" -> "?d_L" [xlabel="6", color="#d62728"];
    "h2_inv_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "inv_L" -> "h2_inv_L" [xlabel="1", dir=back, color="#9467bd"];
    "h2_inv_L" -> "?a_L" [xlabel="2", color="#9467bd"];
    "h2_inv_L" -> "?a1_L" [xlabel="3", color="#9467bd"];
    "h3_inv_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "inv_L" -> "h3_inv_L" [xlabel="1", dir=back, color="#9467bd"];
    "h3_inv_L" -> "?b_L" [xlabel="2", color="#9467bd"];
    "h3_inv_L" -> "?b1_L" [xlabel="3", color="#9467bd"];
    "h4_inv_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "inv_L" -> "h4_inv_L" [xlabel="1", dir=back, color="#9467bd"];
    "h4_inv_L" -> "?c_L" [xlabel="2", color="#9467bd"];
    "h4_inv_L" -> "?c1_L" [xlabel="3", color="#9467bd"];
    "h5_inv_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "inv_L" -> "h5_inv_L" [xlabel="1", dir=back, color="#9467bd"];
    "h5_inv_L" -> "?d_L" [xlabel="2", color="#9467bd"];
    "h5_inv_L" -> "?d1_L" [xlabel="3", color="#9467bd"];
    "h6_column_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "column_L" -> "h6_column_L" [xlabel="1", dir=back, color="#d62728"];
    "h6_column_L" -> "?g_L" [xlabel="2", color="#d62728"];
    "h6_column_L" -> "?d1_L" [xlabel="3", color="#d62728"];
    "h6_column_L" -> "?c1_L" [xlabel="4", color="#d62728"];
    "h6_column_L" -> "?b1_L" [xlabel="5", color="#d62728"];
    "h6_column_L" -> "?a1_L" [xlabel="6", color="#d62728"];
  }
  subgraph cluster_rhs { label="assert";
    "dual-of_R" [label="dual-of", shape=box];
    "?f_R" [label="?f", shape=diamond];
    "?g_R" [label="?g", shape=diamond];
    "h7_dual-of_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "dual-of_R" -> "h7_dual-of_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "h7_dual-of_R" -> "?f_R" [xlabel="2", color="#2ca02c", style=dashed];
    "h7_dual-of_R" -> "?g_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
