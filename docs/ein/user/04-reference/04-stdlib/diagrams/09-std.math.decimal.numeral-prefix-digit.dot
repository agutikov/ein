digraph rule_numeral_prefix_digit_lhs_rhs {
  rankdir=TB;
  label="numeral-prefix-digit"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "check_L" [label="check", shape=box];
    "?w_L" [label="?w", shape=diamond];
    "n_L" [label="n", shape=box];
    "?m_L" [label="?m", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "nz_L" [label="nz", shape=box];
    subgraph cluster_ctx_L_0 {
      label="check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?m ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "check_L" -> "h1_check_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_check_L" -> "?w_L" [xlabel="2", color="#7f7f7f"];
    "h1_check_L" -> "(n ?m ?a)_L" [xlabel="3", color="#7f7f7f"];
    "h2_nz_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "nz_L" -> "h2_nz_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h2_nz_L" -> "?m_L" [xlabel="2", color="#2ca02c"];
    "n_L" -> "(n ?m ?a)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(n ?m ?a)_L" -> "?m_L" [xlabel="2", color="#9467bd"];
    "(n ?m ?a)_L" -> "?a_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "not-decimal_R" [label="not-decimal", shape=box];
    "n_R" [label="n", shape=box];
    "?m_R" [label="?m", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not-decimal ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?m ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h3_not-decimal_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "not-decimal_R" -> "h3_not-decimal_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h3_not-decimal_R" -> "(n ?m ?a)_R" [xlabel="2", color="#d62728", style=dashed];
    "h3_not-decimal_R" -> "?m_R" [xlabel="3", color="#d62728", style=dashed];
    "n_R" -> "(n ?m ?a)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(n ?m ?a)_R" -> "?m_R" [xlabel="2", color="#9467bd", style=dashed];
    "(n ?m ?a)_R" -> "?a_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
