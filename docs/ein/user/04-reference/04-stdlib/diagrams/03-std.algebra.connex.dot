digraph rule_connex_lhs_rhs {
  rankdir=TB;
  label="connex"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?Dom_L" [label="?Dom", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?R_L" [label="?R", shape=diamond];
    "h1_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h1_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h1_isa_L" -> "?Dom_L" [xlabel="3", color="#bcbd22"];
    "h2_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "?isa_L" -> "h2_isa_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h2_isa_L" -> "?Dom_L" [xlabel="3", color="#bcbd22"];
    "?a_L" -> "?b_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "h3_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "?R_L" -> "h3_R_L" [xlabel="1", dir=back, color="#1f77b4"];
      "h3_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
      "h3_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    }
    subgraph cluster_absent_L_1 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "h4_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
      "?R_L" -> "h4_R_L" [xlabel="1", dir=back, color="#1f77b4"];
      "h4_R_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
      "h4_R_L" -> "?a_L" [xlabel="3", color="#1f77b4"];
    }
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h5_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "false_R" -> "h5_false_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
  }
}
