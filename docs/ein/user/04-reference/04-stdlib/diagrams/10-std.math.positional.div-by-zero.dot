digraph rule_div_by_zero_lhs_rhs {
  rankdir=TB;
  label="div-by-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?DONE_L" [label="?DONE", shape=diamond];
    "?DIV-M1_L" [label="?DIV-M1", shape=diamond];
    "?QUOTIENT_L" [label="?QUOTIENT", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "z_L" [label="z", shape=box];
    subgraph cluster_ctx_L_0 {
      label="?DIV-M1 ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?QUOTIENT ?x ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    subgraph cluster_ctx_L_1 {
      label="?DONE ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_DONE_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    "h1_DONE_L" -> "?DONE_L" [xlabel="1", color="#9467bd"];
    "h1_DONE_L" -> "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" [xlabel="2", color="#9467bd"];
    "h1_DONE_L" -> "z_L" [xlabel="3", color="#9467bd"];
    "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" -> "?DIV-M1_L" [xlabel="1", color="#bcbd22"];
    "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" -> "(?QUOTIENT ?x ?y)_L" [xlabel="2", color="#bcbd22"];
    "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" -> "?u_L" [xlabel="3", color="#bcbd22"];
    "(?DIV-M1 (?QUOTIENT ?x ?y) ?u ?v)_L" -> "?v_L" [xlabel="4", color="#bcbd22"];
    "(?QUOTIENT ?x ?y)_L" -> "?QUOTIENT_L" [xlabel="1", color="#9467bd"];
    "(?QUOTIENT ?x ?y)_L" -> "?x_L" [xlabel="2", color="#9467bd"];
    "(?QUOTIENT ?x ?y)_L" -> "?y_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "division-by-zero_R" [label="division-by-zero", shape=box];
    "?DIV_R" [label="?DIV", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="division-by-zero ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    }
    "h2_division-by-zero_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "h2_division-by-zero_R" -> "division-by-zero_R" [xlabel="1", color="#e377c2", style=dashed];
    "h2_division-by-zero_R" -> "(?DIV ?x ?y)_R" [xlabel="2", color="#e377c2", style=dashed];
    "(?DIV ?x ?y)_R" -> "?DIV_R" [xlabel="1", color="#ff7f0e", style=dashed];
    "(?DIV ?x ?y)_R" -> "?x_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "(?DIV ?x ?y)_R" -> "?y_R" [xlabel="3", color="#ff7f0e", style=dashed];
  }
}
