    "h2_gate2_L" -> "?b_L" [xlabel="5", color="#7f7f7f"];
    "h3_gate2_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "gate2_L" -> "h3_gate2_L" [xlabel="1", dir=back, color="#7f7f7f"];
