digraph rule_rat_zero_first_lhs_rhs {
  rankdir=TB;
  label="rat-zero-first"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "rat-zero-den_L" [label="rat-zero-den", shape=box];
    "rat-first_L" [label="rat-first", shape=box];
    "?request_L" [label="?request", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="rat-zero-den ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-first ?request ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_rat-zero-den_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "rat-zero-den_L" -> "h1_rat-zero-den_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_rat-zero-den_L" -> "(rat-first ?request ?y)_L" [xlabel="2", color="#bcbd22"];
    "rat-first_L" -> "(rat-first ?request ?y)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(rat-first ?request ?y)_L" -> "?request_L" [xlabel="2", color="#bcbd22"];
    "(rat-first ?request ?y)_L" -> "?y_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "division-by-zero_R" [label="division-by-zero", shape=box];
    "?request_R" [label="?request", shape=diamond];
    "h2_division-by-zero_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2", style=dashed];
    "division-by-zero_R" -> "h2_division-by-zero_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "h2_division-by-zero_R" -> "?request_R" [xlabel="2", color="#e377c2", style=dashed];
  }
}
