digraph rule_to_dec_ask_lhs_rhs {
  rankdir=TB;
  label="to-dec-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "to-dec_L" [label="to-dec", shape=box];
    "?b_L" [label="?b", shape=diamond];
    "h1_to-dec_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "to-dec_L" -> "h1_to-dec_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_to-dec_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-check_R" [label="bin-check", shape=box];
    "?b_R" [label="?b", shape=diamond];
    "bin-top-first_R" [label="bin-top-first", shape=box];
    "dec-bits_R" [label="dec-bits", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="bin-top-first ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(dec-bits ?b)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    }
    "h2_bin-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "bin-check_R" -> "h2_bin-check_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h2_bin-check_R" -> "?b_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h2_bin-check_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
    "h3_bin-top-first_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "bin-top-first_R" -> "h3_bin-top-first_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "h3_bin-top-first_R" -> "(dec-bits ?b)_R" [xlabel="2", color="#ff7f0e", style=dashed];
    "h3_bin-top-first_R" -> "?b_R" [xlabel="3", color="#ff7f0e", style=dashed];
    "h3_bin-top-first_R" -> "z_R" [xlabel="4", color="#ff7f0e", style=dashed];
    "dec-bits_R" -> "(dec-bits ?b)_R" [xlabel="1", dir=back, color="#8c564b", style=dashed];
    "(dec-bits ?b)_R" -> "?b_R" [xlabel="2", color="#8c564b", style=dashed];
  }
}
