      label="mul-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-x1 ?k ?n ?d ?q ?m ?e)_R" [shape=octagon, label="rat-x1", color="#17becf", fontcolor="#17becf"];
    }
    "h2_mul-call_R" [shape=octagon, label="mul-call", color="#2ca02c", fontcolor="#2ca02c"];
    "h2_mul-call_R" -> "(rat-x1 ?k ?n ?d ?q ?m ?e)_R" [label="1", color="#2ca02c", style=dashed];
