digraph rule_int_norm_runs_lhs_rhs {
  rankdir=TB;
  label="int-norm-runs"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "int-norm_L" [label="int-norm", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    "h1_int-norm_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "h1_int-norm_L" -> "int-norm_L" [xlabel="1", color="#e377c2"];
    "h1_int-norm_L" -> "?k_L" [xlabel="2", color="#e377c2"];
    "h1_int-norm_L" -> "?p_L" [xlabel="3", color="#e377c2"];
    "h1_int-norm_L" -> "?n_L" [xlabel="4", color="#e377c2"];
  }
  subgraph cluster_rhs { label="assert";
    "int-norm-run_R" [label="int-norm-run", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "int-check_R" [label="int-check", shape=box];
    "int_R" [label="int", shape=box];
    subgraph cluster_ctx_R_0 {
      label="int-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p ?n)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf"];
    }
    "h2_int-norm-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "int-norm-run_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?k_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?p_R" [xlabel="3", color="#d62728", style=dashed];
    "h2_int-norm-run_R" -> "?n_R" [xlabel="4", color="#d62728", style=dashed];
    "h3_int-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h3_int-check_R" -> "int-check_R" [xlabel="1", color="#2ca02c", style=dashed];
    "h3_int-check_R" -> "(int ?p ?n)_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(int ?p ?n)_R" -> "int_R" [xlabel="1", color="#17becf", style=dashed];
    "(int ?p ?n)_R" -> "?p_R" [xlabel="2", color="#17becf", style=dashed];
    "(int ?p ?n)_R" -> "?n_R" [xlabel="3", color="#17becf", style=dashed];
  }
}
