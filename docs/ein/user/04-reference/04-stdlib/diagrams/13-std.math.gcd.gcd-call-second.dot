digraph rule_gcd_call_second_lhs_rhs {
  rankdir=TB;
  label="gcd-call-second"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "done_L" [label="done", shape=box];
    "gcd-norm_L" [label="gcd-norm", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-norm ?k ?y)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_done_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    "done_L" -> "h1_done_L" [xlabel="1", dir=back, color="#e377c2"];
    "h1_done_L" -> "(gcd-norm ?k ?y)_L" [xlabel="2", color="#e377c2"];
    "h1_done_L" -> "?a_L" [xlabel="3", color="#e377c2"];
    "gcd-norm_L" -> "(gcd-norm ?k ?y)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(gcd-norm ?k ?y)_L" -> "?k_L" [xlabel="2", color="#1f77b4"];
    "(gcd-norm ?k ?y)_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "add-run_R" [label="add-run", shape=box];
    "gcd-norm-of_R" [label="gcd-norm-of", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "z_R" [label="z", shape=box];
    "0_R" [label="0", shape=box];
    subgraph cluster_ctx_R_0 {
      label="add-run ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(gcd-norm-of ?k ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    }
    "h2_add-run_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "add-run_R" -> "h2_add-run_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "(gcd-norm-of ?k ?a)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "?y_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_add-run_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "gcd-norm-of_R" -> "(gcd-norm-of ?k ?a)_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "(gcd-norm-of ?k ?a)_R" -> "?k_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "(gcd-norm-of ?k ?a)_R" -> "?a_R" [xlabel="3", color="#7f7f7f", style=dashed];
  }
}
