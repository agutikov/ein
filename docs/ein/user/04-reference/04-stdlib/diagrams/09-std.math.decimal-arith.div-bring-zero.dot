    "b_L" -> "(b 0 ?rest)_L" [xlabel="1", dir=back, color="#1f77b4"];
    "(b 0 ?rest)_L" -> "0_L" [xlabel="2", color="#1f77b4"];
    "(b 0 ?rest)_L" -> "?rest_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "div-digit_R" [label="div-digit", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?ms_R" [label="?ms", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    "h2_div-digit_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "div-digit_R" -> "h2_div-digit_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "?ms_R" [xlabel="3", color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "?rest_R" [xlabel="4", color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "?w_R" [xlabel="5", color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "0_R" [xlabel="6", color="#9467bd", style=dashed];
    "h2_div-digit_R" -> "z_R" [xlabel="7", color="#9467bd", style=dashed];
  }
