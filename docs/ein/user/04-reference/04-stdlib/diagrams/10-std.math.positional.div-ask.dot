digraph rule_div_ask_lhs_rhs {
  rankdir=TB;
  label="div-ask"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?DIV_L" [label="?DIV", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "h1_DIV_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "?DIV_L" -> "h1_DIV_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h1_DIV_L" -> "?x_L" [xlabel="2", color="#ff7f0e"];
    "h1_DIV_L" -> "?y_L" [xlabel="3", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "?OPERAND_R" [label="?OPERAND", shape=diamond];
    "?DIV-FIRST_R" [label="?DIV-FIRST", shape=diamond];
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="?OPERAND ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?DIV-FIRST ?x ?y)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_OPERAND_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "?OPERAND_R" -> "h2_OPERAND_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "(?DIV-FIRST ?x ?y)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_OPERAND_R" -> "?x_R" [xlabel="3", color="#d62728", style=dashed];
    "?DIV-FIRST_R" -> "(?DIV-FIRST ?x ?y)_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "(?DIV-FIRST ?x ?y)_R" -> "?x_R" [xlabel="2", color="#9467bd", style=dashed];
    "(?DIV-FIRST ?x ?y)_R" -> "?y_R" [xlabel="3", color="#9467bd", style=dashed];
  }
}
