digraph rule_slot_locate_lhs_rhs {
  rankdir=TB;
  label="slot-locate"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?R_L" [label="?R", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?i_L" [label="?i", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?index_L" [label="?index", shape=diamond];
    "h1_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h1_R_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "h1_R_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h1_R_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "h2_R_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_R_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "h2_R_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
    "h2_R_L" -> "?i_L" [xlabel="3", color="#1f77b4"];
    "h3_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h3_isa_L" -> "?i_L" [xlabel="2", color="#bcbd22"];
    "h3_isa_L" -> "?index_L" [xlabel="3", color="#bcbd22"];
    "?a_L" -> "?i_L" [label="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?i_R" [label="?i", shape=diamond];
    "h4_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h4_R_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h4_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h4_R_R" -> "?i_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
