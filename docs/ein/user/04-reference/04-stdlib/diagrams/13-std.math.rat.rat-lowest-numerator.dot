digraph rule_rat_lowest_numerator_lhs_rhs {
  rankdir=TB;
  label="rat-lowest-numerator"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?k_L" [label="?k", shape=diamond];
    "?s_L" [label="?s", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?g_L" [label="?g", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="gcd-done ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-g ?k ?s ?a ?d)_L" [shape=octagon, label="rat-g", color="#1f77b4", fontcolor="#1f77b4"];
    }
    "(rat-g ?k ?s ?a ?d)_L" -> "?g_L" [label="gcd-done", color="#7f7f7f", fontcolor="#7f7f7f"];
    "(rat-g ?k ?s ?a ?d)_L" -> "?k_L" [label="1", color="#1f77b4"];
    "(rat-g ?k ?s ?a ?d)_L" -> "?s_L" [label="2", color="#1f77b4"];
    "(rat-g ?k ?s ?a ?d)_L" -> "?a_L" [label="3", color="#1f77b4"];
    "(rat-g ?k ?s ?a ?d)_L" -> "?d_L" [label="4", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?k_R" [label="?k", shape=diamond];
    "?s_R" [label="?s", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?g_R" [label="?g", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="div-call ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(rat-q-num ?k ?s ?d ?g)_R" [shape=octagon, label="rat-q-num", color="#bcbd22", fontcolor="#bcbd22"];
    }
    "h1_div-call_R" [shape=octagon, label="div-call", color="#bcbd22", fontcolor="#bcbd22"];
    "h1_div-call_R" -> "(rat-q-num ?k ?s ?d ?g)_R" [label="1", color="#bcbd22", style=dashed];
    "h1_div-call_R" -> "?a_R" [label="2", color="#bcbd22", style=dashed];
    "h1_div-call_R" -> "?g_R" [label="3", color="#bcbd22", style=dashed];
    "(rat-q-num ?k ?s ?d ?g)_R" -> "?k_R" [label="1", color="#bcbd22", style=dashed];
    "(rat-q-num ?k ?s ?d ?g)_R" -> "?s_R" [label="2", color="#bcbd22", style=dashed];
    "(rat-q-num ?k ?s ?d ?g)_R" -> "?d_R" [label="3", color="#bcbd22", style=dashed];
    "(rat-q-num ?k ?s ?d ?g)_R" -> "?g_R" [label="4", color="#bcbd22", style=dashed];
  }
}
