    "?w_R" [label="?w", shape=diamond];
    "1_R" [label="1", shape=box];
    subgraph cluster_ctx_R_0 {
      label="bin-div-step ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 ?w 1)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h2_bin-div-step_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "h2_bin-div-step_R" -> "bin-div-step_R" [xlabel="1", color="#9467bd", style=dashed];
    "h2_bin-div-step_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h2_bin-div-step_R" -> "?d_R" [xlabel="3", color="#9467bd", style=dashed];
