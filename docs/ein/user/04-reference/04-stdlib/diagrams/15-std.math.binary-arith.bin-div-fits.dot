    "(bin-div-trial ?k ?d ?rest ?w ?u)_L" -> "?rest_L" [xlabel="4", color="#17becf"];
    "(bin-div-trial ?k ?d ?rest ?w ?u)_L" -> "?w_L" [xlabel="5", color="#17becf"];
    "(bin-div-trial ?k ?d ?rest ?w ?u)_L" -> "?u_L" [xlabel="6", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-div-step_R" [label="bin-div-step", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?d_R" [label="?d", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
