    "?MUL-DIGITS_L" -> "(?MUL-DIGITS ?k ?u)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(?MUL-DIGITS ?k ?u)_L" -> "?k_L" [xlabel="2", color="#9467bd"];
    "(?MUL-DIGITS ?k ?u)_L" -> "?u_L" [xlabel="3", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "?MUL-STEP_R" [label="?MUL-STEP", shape=diamond];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?t_R" [label="?t", shape=diamond];
    "z_R" [label="z", shape=box];
    "h2_MUL-STEP_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#17becf", style=dashed];
    "?MUL-STEP_R" -> "h2_MUL-STEP_R" [xlabel="1", dir=back, color="#17becf", style=dashed];
    "h2_MUL-STEP_R" -> "?k_R" [xlabel="2", color="#17becf", style=dashed];
    "h2_MUL-STEP_R" -> "?u_R" [xlabel="3", color="#17becf", style=dashed];
    "h2_MUL-STEP_R" -> "?t_R" [xlabel="4", color="#17becf", style=dashed];
    "h2_MUL-STEP_R" -> "z_R" [xlabel="5", color="#17becf", style=dashed];
