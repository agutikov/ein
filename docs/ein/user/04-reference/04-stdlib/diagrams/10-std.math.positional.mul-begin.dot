      label="?TOP-FIRST-IS ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?MUL-DIGITS ?k ?u)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_TOP-FIRST-IS_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "?TOP-FIRST-IS_L" -> "h1_TOP-FIRST-IS_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h1_TOP-FIRST-IS_L" -> "(?MUL-DIGITS ?k ?u)_L" [xlabel="2", color="#2ca02c"];
