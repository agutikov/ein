      "(n ?p ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h2_not-decimal_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "h2_not-decimal_R" -> "not-decimal_R" [xlabel="1", color="#d62728", style=dashed];
    "h2_not-decimal_R" -> "(n ?p ?a)_R" [xlabel="2", color="#d62728", style=dashed];
    "h2_not-decimal_R" -> "?a_R" [xlabel="3", color="#d62728", style=dashed];
    "(n ?p ?a)_R" -> "n_R" [xlabel="1", color="#9467bd", style=dashed];
    "(n ?p ?a)_R" -> "?p_R" [xlabel="2", color="#9467bd", style=dashed];
