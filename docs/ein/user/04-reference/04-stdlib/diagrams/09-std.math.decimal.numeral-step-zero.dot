digraph rule_numeral_step_zero_lhs_rhs {
  rankdir=TB;
  label="numeral-step-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "check_L" [label="check", shape=box];
    "?w_L" [label="?w", shape=diamond];
    "n_L" [label="n", shape=box];
    "?p_L" [label="?p", shape=diamond];
