digraph rule_numeral_step_zero_lhs_rhs {
  rankdir=TB;
  label="numeral-step-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?w_L" [label="?w", shape=diamond];
    "?p_L" [label="?p", shape=diamond];
    "0_L" [label="0", shape=rectangle];
    subgraph cluster_ctx_L_0 {
      label="check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p 0)_L" [shape=octagon, label="n", color="#9467bd", fontcolor="#9467bd"];
    }
    "?w_L" -> "(n ?p 0)_L" [label="check", color="#7f7f7f", fontcolor="#7f7f7f"];
    "(n ?p 0)_L" -> "?p_L" [label="1", color="#9467bd"];
    "(n ?p 0)_L" -> "0_L" [label="2", color="#9467bd"];
