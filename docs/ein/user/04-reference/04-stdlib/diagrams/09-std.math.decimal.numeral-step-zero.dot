    subgraph cluster_ctx_L_0 {
      label="check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(n ?p 0)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd"];
    }
    "h1_check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "check_L" -> "h1_check_L" [xlabel="1", dir=back, color="#7f7f7f"];
    "h1_check_L" -> "?w_L" [xlabel="2", color="#7f7f7f"];
    "h1_check_L" -> "(n ?p 0)_L" [xlabel="3", color="#7f7f7f"];
    "n_L" -> "(n ?p 0)_L" [xlabel="1", dir=back, color="#9467bd"];
    "(n ?p 0)_L" -> "?p_L" [xlabel="2", color="#9467bd"];
    "(n ?p 0)_L" -> "0_L" [xlabel="3", color="#9467bd"];
