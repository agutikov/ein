    "h1_div-choose_L" -> "?u_L" [xlabel="6", color="#8c564b"];
    "h1_div-choose_L" -> "?lo_L" [xlabel="7", color="#8c564b"];
    "h1_div-choose_L" -> "?hi_L" [xlabel="8", color="#8c564b"];
    "h1_div-choose_L" -> "?left_L" [xlabel="9", color="#8c564b"];
    "h2_adj_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "adj_L" -> "h2_adj_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h2_adj_L" -> "?lo_L" [xlabel="2", color="#bcbd22"];
    "h2_adj_L" -> "?hi_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "div-digit_R" [label="div-digit", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?ms_R" [label="?ms", shape=diamond];
    "?rest_R" [label="?rest", shape=diamond];
    "?w_R" [label="?w", shape=diamond];
    "?lo_R" [label="?lo", shape=diamond];
    "?left_R" [label="?left", shape=diamond];
    "h3_div-digit_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#9467bd", style=dashed];
    "div-digit_R" -> "h3_div-digit_R" [xlabel="1", dir=back, color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?k_R" [xlabel="2", color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?ms_R" [xlabel="3", color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?rest_R" [xlabel="4", color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?w_R" [xlabel="5", color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?lo_R" [xlabel="6", color="#9467bd", style=dashed];
    "h3_div-digit_R" -> "?left_R" [xlabel="7", color="#9467bd", style=dashed];
  }
