digraph rule_div_digit_found_lhs_rhs {
  rankdir=TB;
  label="div-digit-found"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "div-choose_L" [label="div-choose", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?ms_L" [label="?ms", shape=diamond];
    "?rest_L" [label="?rest", shape=diamond];
    "?w_L" [label="?w", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?lo_L" [label="?lo", shape=diamond];
    "?hi_L" [label="?hi", shape=diamond];
    "?left_L" [label="?left", shape=diamond];
    "adj_L" [label="adj", shape=box];
    "h1_div-choose_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    "div-choose_L" -> "h1_div-choose_L" [xlabel="1", dir=back, color="#8c564b"];
    "h1_div-choose_L" -> "?k_L" [xlabel="2", color="#8c564b"];
    "h1_div-choose_L" -> "?ms_L" [xlabel="3", color="#8c564b"];
