digraph rule_symmetric_negative_lhs_rhs {
  rankdir=TB;
  label="symmetric-negative"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "not_L" [label="not", shape=box];
    "?rel_L" [label="?rel", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?rel ?a ?b)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h1_not_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "not_L" -> "h1_not_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_not_L" -> "(?rel ?a ?b)_L" [xlabel="2", color="#d62728"];
    "?rel_L" -> "(?rel ?a ?b)_L" [xlabel="1", dir=back, color="#2ca02c"];
    "(?rel ?a ?b)_L" -> "?a_L" [xlabel="2", color="#2ca02c"];
    "(?rel ?a ?b)_L" -> "?b_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "not_R" [label="not", shape=box];
    "?rel_R" [label="?rel", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    subgraph cluster_ctx_R_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?rel ?b ?a)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    }
    "h2_not_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "not_R" -> "h2_not_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h2_not_R" -> "(?rel ?b ?a)_R" [xlabel="2", color="#d62728", style=dashed];
    "?rel_R" -> "(?rel ?b ?a)_R" [xlabel="1", dir=back, color="#2ca02c", style=dashed];
    "(?rel ?b ?a)_R" -> "?b_R" [xlabel="2", color="#2ca02c", style=dashed];
    "(?rel ?b ?a)_R" -> "?a_R" [xlabel="3", color="#2ca02c", style=dashed];
  }
}
