digraph rule_int_check_parts_lhs_rhs {
  rankdir=TB;
  label="int-check-parts"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?p_L" [label="?p", shape=diamond];
    "?n_L" [label="?n", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="int-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(int ?p ?n)_L" [shape=octagon, label="int", color="#17becf", fontcolor="#17becf"];
    }
    "h1_int-check_L" [shape=octagon, label="int-check", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_int-check_L" -> "(int ?p ?n)_L" [label="1", color="#2ca02c"];
    "(int ?p ?n)_L" -> "?p_L" [label="1", color="#17becf"];
    "(int ?p ?n)_L" -> "?n_L" [label="2", color="#17becf"];
  }
  subgraph cluster_rhs { label="assert";
    "?p_R" [label="?p", shape=diamond];
    "?n_R" [label="?n", shape=diamond];
    "?p_R" -> "?p_R" [label="check", color="#7f7f7f", fontcolor="#7f7f7f", style=dashed];
    "?n_R" -> "?n_R" [label="check", color="#7f7f7f", fontcolor="#7f7f7f", style=dashed];
  }
}
