digraph rule_propagate_lhs_rhs {
  rankdir=TB;
  label="propagate"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "gate_L" [label="gate", shape=box];
    "?g_L" [label="?g", shape=diamond];
    "?f_L" [label="?f", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "?o_L" [label="?o", shape=diamond];
    "val_L" [label="val", shape=box];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    "gate2_L" [label="gate2", shape=box];
    "?z_L" [label="?z", shape=diamond];
    "h1_gate_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "h1_gate_L" -> "gate_L" [xlabel="1", color="#2ca02c"];
    "h1_gate_L" -> "?g_L" [xlabel="2", color="#2ca02c"];
    "h1_gate_L" -> "?f_L" [xlabel="3", color="#2ca02c"];
    "h1_gate_L" -> "?a_L" [xlabel="4", color="#2ca02c"];
    "h1_gate_L" -> "?b_L" [xlabel="5", color="#2ca02c"];
    "h1_gate_L" -> "?o_L" [xlabel="6", color="#2ca02c"];
    "h2_val_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_val_L" -> "val_L" [xlabel="1", color="#1f77b4"];
    "h2_val_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "h2_val_L" -> "?x_L" [xlabel="3", color="#1f77b4"];
    "h3_val_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h3_val_L" -> "val_L" [xlabel="1", color="#1f77b4"];
    "h3_val_L" -> "?b_L" [xlabel="2", color="#1f77b4"];
    "h3_val_L" -> "?y_L" [xlabel="3", color="#1f77b4"];
    "h4_gate2_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
    "h4_gate2_L" -> "gate2_L" [xlabel="1", color="#7f7f7f"];
    "h4_gate2_L" -> "?f_L" [xlabel="2", color="#7f7f7f"];
    "h4_gate2_L" -> "?x_L" [xlabel="3", color="#7f7f7f"];
    "h4_gate2_L" -> "?y_L" [xlabel="4", color="#7f7f7f"];
    "h4_gate2_L" -> "?z_L" [xlabel="5", color="#7f7f7f"];
  }
  subgraph cluster_rhs { label="assert";
    "val_R" [label="val", shape=box];
    "?o_R" [label="?o", shape=diamond];
    "?z_R" [label="?z", shape=diamond];
    "h5_val_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h5_val_R" -> "val_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h5_val_R" -> "?o_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h5_val_R" -> "?z_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
