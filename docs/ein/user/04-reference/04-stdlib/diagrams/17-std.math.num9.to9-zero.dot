digraph rule_to9_zero_lhs_rhs {
  rankdir=TB;
  label="to9-zero"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "z_L" [label="z", shape=rectangle];
    "h1_to9_L" [shape=octagon, label="to9", color="#9467bd", fontcolor="#9467bd"];
    "h1_to9_L" -> "z_L" [label="1", color="#9467bd"];
  }
  subgraph cluster_rhs { label="assert";
    "z_R" [label="z", shape=rectangle];
    "0_R" [label="0", shape=rectangle];
    subgraph cluster_ctx_R_0 {
      label="as9 ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(num9 0 0 0 0 0 0 0 0 0)_R" [shape=octagon, label="num9", color="#d62728", fontcolor="#d62728"];
    }
    "z_R" -> "(num9 0 0 0 0 0 0 0 0 0)_R" [label="as9", color="#2ca02c", fontcolor="#2ca02c", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="1", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="2", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="3", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="4", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="5", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="6", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="7", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="8", color="#d62728", style=dashed];
    "(num9 0 0 0 0 0 0 0 0 0)_R" -> "0_R" [label="9", color="#d62728", style=dashed];
  }
}
