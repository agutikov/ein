    "?R_L" [label="?R", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(not (?R))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
      "(?R)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_not_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    "not_L" -> "h1_not_L" [xlabel="1", dir=back, color="#d62728"];
    "h1_not_L" -> "(not (?R))_L" [xlabel="2", color="#d62728"];
    "not_L" -> "(not (?R))_L" [xlabel="1", dir=back, color="#d62728"];
    "(not (?R))_L" -> "(?R)_L" [xlabel="2", color="#d62728"];
