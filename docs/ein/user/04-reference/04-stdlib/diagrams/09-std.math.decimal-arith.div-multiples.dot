digraph rule_div_multiples_lhs_rhs {
  rankdir=TB;
  label="div-multiples"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "div-call_L" [label="div-call", shape=box];
    "?k_L" [label="?k", shape=diamond];
    "?u_L" [label="?u", shape=diamond];
    "?v_L" [label="?v", shape=diamond];
    "h1_div-call_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "div-call_L" -> "h1_div-call_L" [xlabel="1", dir=back, color="#bcbd22"];
    "h1_div-call_L" -> "?k_L" [xlabel="2", color="#bcbd22"];
    "h1_div-call_L" -> "?u_L" [xlabel="3", color="#bcbd22"];
    "h1_div-call_L" -> "?v_L" [xlabel="4", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "mul-walk_R" [label="mul-walk", shape=box];
    "div-m1_R" [label="div-m1", shape=box];
    "?k_R" [label="?k", shape=diamond];
    "?u_R" [label="?u", shape=diamond];
    "?v_R" [label="?v", shape=diamond];
    "1_R" [label="1", shape=box];
    "0_R" [label="0", shape=box];
    "z_R" [label="z", shape=box];
    subgraph cluster_ctx_R_0 {
      label="mul-walk ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(div-m1 ?k ?u ?v)_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#e377c2"];
    }
    "h2_mul-walk_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "mul-walk_R" -> "h2_mul-walk_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "(div-m1 ?k ?u ?v)_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "?v_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "1_R" [xlabel="4", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "0_R" [xlabel="5", color="#7f7f7f", style=dashed];
    "h2_mul-walk_R" -> "z_R" [xlabel="6", color="#7f7f7f", style=dashed];
    "div-m1_R" -> "(div-m1 ?k ?u ?v)_R" [xlabel="1", dir=back, color="#e377c2", style=dashed];
    "(div-m1 ?k ?u ?v)_R" -> "?k_R" [xlabel="2", color="#e377c2", style=dashed];
    "(div-m1 ?k ?u ?v)_R" -> "?u_R" [xlabel="3", color="#e377c2", style=dashed];
    "(div-m1 ?k ?u ?v)_R" -> "?v_R" [xlabel="4", color="#e377c2", style=dashed];
  }
}
