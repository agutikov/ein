digraph rule_debts_of_total_lhs_rhs {
  rankdir=TB;
  label="debts-of-total"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "debts-of-owed_L" [label="debts-of-owed", shape=box];
    "total-owed_L" [label="total-owed", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "h1_debts-of-owed_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e"];
    "debts-of-owed_L" -> "h1_debts-of-owed_L" [xlabel="1", dir=back, color="#ff7f0e"];
    "h2_total-owed_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c"];
    "total-owed_L" -> "h2_total-owed_L" [xlabel="1", dir=back, color="#2ca02c"];
    "h2_total-owed_L" -> "?R_L" [xlabel="2", color="#2ca02c"];
    "h2_total-owed_L" -> "?isa_L" [xlabel="3", color="#2ca02c"];
  }
  subgraph cluster_rhs { label="assert";
    "total-due_R" [label="total-due", shape=box];
    "?R_R" [label="?R", shape=diamond];
    "?isa_R" [label="?isa", shape=diamond];
    "total-paid_R" [label="total-paid", shape=box];
    "h3_total-due_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f", style=dashed];
    "total-due_R" -> "h3_total-due_R" [xlabel="1", dir=back, color="#7f7f7f", style=dashed];
    "h3_total-due_R" -> "?R_R" [xlabel="2", color="#7f7f7f", style=dashed];
    "h3_total-due_R" -> "?isa_R" [xlabel="3", color="#7f7f7f", style=dashed];
    "h4_total-paid_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728", style=dashed];
    "total-paid_R" -> "h4_total-paid_R" [xlabel="1", dir=back, color="#d62728", style=dashed];
    "h4_total-paid_R" -> "?R_R" [xlabel="2", color="#d62728", style=dashed];
    "h4_total-paid_R" -> "?isa_R" [xlabel="3", color="#d62728", style=dashed];
  }
}
