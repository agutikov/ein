digraph rule_bin_numeral_step_lhs_rhs {
  rankdir=TB;
  label="bin-numeral-step"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "bin-check_L" [label="bin-check", shape=box];
    "?w_L" [label="?w", shape=diamond];
    "b2_L" [label="b2", shape=box];
    "?p_L" [label="?p", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "bin-nz_L" [label="bin-nz", shape=box];
    subgraph cluster_ctx_L_0 {
      label="bin-check ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(b2 ?p ?a)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    }
    "h1_bin-check_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "bin-check_L" -> "h1_bin-check_L" [xlabel="1", dir=back, color="#1f77b4"];
    "h1_bin-check_L" -> "?w_L" [xlabel="2", color="#1f77b4"];
    "h1_bin-check_L" -> "(b2 ?p ?a)_L" [xlabel="3", color="#1f77b4"];
    "h2_bin-nz_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#8c564b"];
    "bin-nz_L" -> "h2_bin-nz_L" [xlabel="1", dir=back, color="#8c564b"];
    "h2_bin-nz_L" -> "?a_L" [xlabel="2", color="#8c564b"];
    "b2_L" -> "(b2 ?p ?a)_L" [xlabel="1", dir=back, color="#bcbd22"];
    "(b2 ?p ?a)_L" -> "?p_L" [xlabel="2", color="#bcbd22"];
    "(b2 ?p ?a)_L" -> "?a_L" [xlabel="3", color="#bcbd22"];
  }
  subgraph cluster_rhs { label="assert";
    "bin-check_R" [label="bin-check", shape=box];
    "?w_R" [label="?w", shape=diamond];
    "?p_R" [label="?p", shape=diamond];
    "h3_bin-check_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "bin-check_R" -> "h3_bin-check_R" [xlabel="1", dir=back, color="#1f77b4", style=dashed];
    "h3_bin-check_R" -> "?w_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h3_bin-check_R" -> "?p_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
