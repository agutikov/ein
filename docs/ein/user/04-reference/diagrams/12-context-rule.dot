digraph rule_believe_the_reliable_lhs_rhs {
  rankdir=TB;
  label="believe-the-reliable"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?p_L" [label="?p", shape=diamond];
    "?x_L" [label="?x", shape=diamond];
    "?y_L" [label="?y", shape=diamond];
    subgraph cluster_ctx_L_0 {
      label="claims ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(owns ?x ?y)_L" [shape=octagon, label="owns", color="#ff7f0e", fontcolor="#ff7f0e"];
    }
    "h1_reliable_L" [shape=octagon, label="reliable", color="#2ca02c", fontcolor="#2ca02c"];
    "h1_reliable_L" -> "?p_L" [label="1", color="#2ca02c"];
    "?p_L" -> "(owns ?x ?y)_L" [label="claims", color="#bcbd22", fontcolor="#bcbd22"];
    "(owns ?x ?y)_L" -> "?x_L" [label="1", color="#ff7f0e"];
    "(owns ?x ?y)_L" -> "?y_L" [label="2", color="#ff7f0e"];
  }
  subgraph cluster_rhs { label="assert";
    "?x_R" [label="?x", shape=diamond];
    "?y_R" [label="?y", shape=diamond];
    "?x_R" -> "?y_R" [label="owns", color="#ff7f0e", fontcolor="#ff7f0e", style=dashed];
  }
}
