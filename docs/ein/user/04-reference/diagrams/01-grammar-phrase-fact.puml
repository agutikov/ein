@startebnf
Fact = "(" , FactHead , FactArgs , FactClauses , ")" | "(" , "false" , FactClauses , ")" ;
OpenFact = "(" , "open" , OpenFactArg , FactClauses , ")" ;
OpenFactArg = Name | OpenedFact | NegFact ;
OpenedFact = "(" , OrdinaryHead , FactArgs , ")" | "(" , "false" , ")" ;
NotFact =
    "(" , "not" , NestedFact , FactClauses , ")"
  | "(" , "not" , NegFact , FactClauses , ")"
  | "(" , "not" , EqFact , FactClauses , ")" ;
NegFact = "(" , "not" , NestedFact , ")" | "(" , "not" , NegFact , ")" ;
NestedFact = "(" , ValueHead , FactArgs , ")" | "(" , "false" , ")" ;
EqFact = "(" , "eq" , FactArgs , ")" ;
FactArg = Name | NestedFact | NegFact ;
FactArgs = { FactArg } ;
FactClause = ":source" , Text | ":rule" , Name | ":using" , "(" , NestedFacts , ")" ;
FactClauses = { FactClause } ;
NestedFacts = { NestedFact }- ;
@endebnf
