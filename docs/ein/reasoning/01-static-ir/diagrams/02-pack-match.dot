digraph pack_match {
  rankdir=TB; nodesep=0.45; ranksep=0.8; forcelabels=true;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  "think"; "Alice"; "=";
  subgraph cluster_rule { label="the rule: its premise q, its conclusion c"; labelloc=b; fontname="Helvetica"; fontsize=10; style=rounded; color="#888888";
    node [shape=diamond];
    "?a"; "?b";
    c [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style="filled,dashed", fillcolor="#d9d9d9", xlabel="c"];
    subgraph cluster_rule_ctx { label="think ctx"; labelloc=t; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
      q [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9", xlabel="q"];
    }
  }
  subgraph cluster_kb { label="the knowledge base"; labelloc=b; fontname="Helvetica"; fontsize=10; style=rounded; color="#888888";
    node [shape=box];
    "+"; "5"; "2";
    e [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9", xlabel="e"];
    subgraph cluster_kb_ctx { label="= ctx"; labelloc=t; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
      s [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="s"];
    }
  }
  "think" -> c [label="1", dir=back, style=dashed];
  "Alice" -> c [label="2", dir=back, style=dashed];
  c -> q [label="3", style=dashed];
  "=" -> q [label="1", dir=back];
  q -> "?a" [label="2"];
  q -> "?b" [label="3"];
  "=" -> e [label="1", dir=back];
  e -> "5" [label="2"];
  e -> s [label="3"];
  s -> "+" [label="1"];
  s -> "2" [label="2"];
  s -> "2" [label="3"];
  edge [style=dotted, color="#1f77b4", fontcolor="#1f77b4", constraint=false, arrowhead=vee];
  q -> e [label="m"];
  "?a" -> "5" [label="m"];
  "?b" -> s [label="m"];
}
