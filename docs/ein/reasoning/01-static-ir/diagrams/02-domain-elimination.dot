digraph rule_domain_elimination_lhs_rhs {
  rankdir=TB;
  label="domain-elimination"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "functional_L" [label="functional", shape=box];
    "?R_L" [label="?R", shape=diamond];
    "total_L" [label="total", shape=box];
    "relation_L" [label="relation", shape=box];
    "?A_L" [label="?A", shape=diamond];
    "?B_L" [label="?B", shape=diamond];
    "?isa_L" [label="?isa", shape=diamond];
    "?a_L" [label="?a", shape=diamond];
    "?b_L" [label="?b", shape=diamond];
    "forall_L" [label="forall", shape=box];
    "?b_other_L" [label="?b_other", shape=diamond];
    "and_L" [label="and", shape=box];
    "neq_L" [label="neq", shape=box];
    "not_L" [label="not", shape=box];
    subgraph cluster_ctx_L_0 {
      label="and ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?isa ?b_other ?B)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
      "(neq ?b_other ?b)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    subgraph cluster_ctx_L_1 {
      label="forall ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(and (?isa ?b_other ?B) (neq ?b_other ?b))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#7f7f7f"];
      "(not (?R ?a ?b_other))_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#d62728"];
    }
    subgraph cluster_ctx_L_2 {
      label="not ctx"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "(?R ?a ?b_other)_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    }
    "h1_functional_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h1_functional_L" -> "functional_L" [xlabel="1", color="#bcbd22"];
    "h1_functional_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h2_total_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h2_total_L" -> "total_L" [xlabel="1", color="#1f77b4"];
    "h2_total_L" -> "?R_L" [xlabel="2", color="#1f77b4"];
    "h3_relation_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h3_relation_L" -> "relation_L" [xlabel="1", color="#bcbd22"];
    "h3_relation_L" -> "?R_L" [xlabel="2", color="#bcbd22"];
    "h3_relation_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h3_relation_L" -> "?B_L" [xlabel="4", color="#bcbd22"];
    "h4_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h4_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h4_isa_L" -> "?a_L" [xlabel="2", color="#bcbd22"];
    "h4_isa_L" -> "?A_L" [xlabel="3", color="#bcbd22"];
    "h5_isa_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#bcbd22"];
    "h5_isa_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "h5_isa_L" -> "?b_L" [xlabel="2", color="#bcbd22"];
    "h5_isa_L" -> "?B_L" [xlabel="3", color="#bcbd22"];
    "h6_forall_L" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4"];
    "h6_forall_L" -> "forall_L" [xlabel="1", color="#1f77b4"];
    "h6_forall_L" -> "?b_other_L" [xlabel="2", color="#1f77b4"];
    "h6_forall_L" -> "(and (?isa ?b_other ?B) (neq ?b_other ?b))_L" [xlabel="3", color="#1f77b4"];
    "h6_forall_L" -> "(not (?R ?a ?b_other))_L" [xlabel="4", color="#1f77b4"];
    "(and (?isa ?b_other ?B) (neq ?b_other ?b))_L" -> "and_L" [xlabel="1", color="#7f7f7f"];
    "(and (?isa ?b_other ?B) (neq ?b_other ?b))_L" -> "(?isa ?b_other ?B)_L" [xlabel="2", color="#7f7f7f"];
    "(and (?isa ?b_other ?B) (neq ?b_other ?b))_L" -> "(neq ?b_other ?b)_L" [xlabel="3", color="#7f7f7f"];
    "(?isa ?b_other ?B)_L" -> "?isa_L" [xlabel="1", color="#bcbd22"];
    "(?isa ?b_other ?B)_L" -> "?b_other_L" [xlabel="2", color="#bcbd22"];
    "(?isa ?b_other ?B)_L" -> "?B_L" [xlabel="3", color="#bcbd22"];
    "(neq ?b_other ?b)_L" -> "neq_L" [xlabel="1", color="#1f77b4"];
    "(neq ?b_other ?b)_L" -> "?b_other_L" [xlabel="2", color="#1f77b4"];
    "(neq ?b_other ?b)_L" -> "?b_L" [xlabel="3", color="#1f77b4"];
    "(not (?R ?a ?b_other))_L" -> "not_L" [xlabel="1", color="#d62728"];
    "(not (?R ?a ?b_other))_L" -> "(?R ?a ?b_other)_L" [xlabel="2", color="#d62728"];
    "(?R ?a ?b_other)_L" -> "?R_L" [xlabel="1", color="#1f77b4"];
    "(?R ?a ?b_other)_L" -> "?a_L" [xlabel="2", color="#1f77b4"];
    "(?R ?a ?b_other)_L" -> "?b_other_L" [xlabel="3", color="#1f77b4"];
  }
  subgraph cluster_rhs { label="assert";
    "?R_R" [label="?R", shape=diamond];
    "?a_R" [label="?a", shape=diamond];
    "?b_R" [label="?b", shape=diamond];
    "h7_R_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#1f77b4", style=dashed];
    "h7_R_R" -> "?R_R" [xlabel="1", color="#1f77b4", style=dashed];
    "h7_R_R" -> "?a_R" [xlabel="2", color="#1f77b4", style=dashed];
    "h7_R_R" -> "?b_R" [xlabel="3", color="#1f77b4", style=dashed];
  }
}
