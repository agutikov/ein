    "?h_R" [label="?h", shape=diamond];
    "h3_vacant_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#ff7f0e", style=dashed];
    "vacant_R" -> "h3_vacant_R" [xlabel="1", dir=back, color="#ff7f0e", style=dashed];
    "h3_vacant_R" -> "?h_R" [xlabel="2", color="#ff7f0e", style=dashed];
  }
}
