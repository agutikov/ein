    "h1_is-a_L" -> "?h_L" [xlabel="2", color="#7f7f7f"];
    "h1_is-a_L" -> "House_L" [xlabel="3", color="#7f7f7f"];
    subgraph cluster_absent_L_0 {
      label="absent (∄)"; style="dashed,rounded"; color="#888888"; fontcolor="#888888";
      "lives-in_L" [label="lives-in", shape=box];
