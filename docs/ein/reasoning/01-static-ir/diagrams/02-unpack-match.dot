digraph unpack_match {
  rankdir=TB; nodesep=0.45; ranksep=0.8; forcelabels=true;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  "think"; "Alice"; "=";
  subgraph cluster_rule { label="the rule: its premise q; its conclusion is u, under an arrow of q"; labelloc=b; fontname="Helvetica"; fontsize=10; style=rounded; color="#888888";
    node [shape=diamond];
    "?a"; "?b";
    q [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9", xlabel="q"];
    subgraph cluster_rule_ctx { label="think ctx"; labelloc=t; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
      u [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style="filled,dashed", fillcolor="#d9d9d9", xlabel="u"];
    }
  }
  subgraph cluster_kb { label="the knowledge base"; labelloc=b; fontname="Helvetica"; fontsize=10; style=rounded; color="#888888";
    node [shape=box];
    "+"; "5"; "2";
    t [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=filled, fillcolor="#d9d9d9", xlabel="t"];
    subgraph cluster_kb_ctx_think { label="think ctx"; labelloc=t; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
      e [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="e"];
    }
    subgraph cluster_kb_ctx_eq { label="= ctx"; labelloc=t; labeljust=l; fontname="Helvetica"; fontsize=10; fontcolor="#888888"; style="dashed,rounded"; color="#888888";
      s [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, style=solid, xlabel="s"];
    }
  }
  "think" -> q [label="1", dir=back];
  "Alice" -> q [label="2", dir=back];
  q -> u [label="3"];
  "=" -> u [label="1", dir=back];
  u -> "?a" [label="2"];
  u -> "?b" [label="3"];
  "think" -> t [label="1", dir=back];
  "Alice" -> t [label="2", dir=back];
  t -> e [label="3"];
  "=" -> e [label="1", dir=back];
  e -> "5" [label="2"];
  e -> s [label="3"];
  s -> "+" [label="1"];
  s -> "2" [label="2"];
  s -> "2" [label="3"];
  edge [style=dotted, color="#1f77b4", fontcolor="#1f77b4", constraint=false, arrowhead=vee];
  q -> t [label="m"];
  u -> e [label="m"];
  "?a" -> "5" [label="m"];
  "?b" -> s [label="m"];
}
