digraph one_relation {
  rankdir=TB; nodesep=0.4; ranksep=0.6;
  node [shape=box, fontname="Helvetica", fontsize=11, height=0.3];
  edge [fontname="Helvetica", fontsize=10];
  { rank=min; "transitive"; "relation"; }
  "left-of";
  { rank=max; "House-1"; "House-2"; "House-3"; "House"; }
  node [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true];
  p [xlabel="p"]; d1 [xlabel="d1"];
  f3 [xlabel="f3"]; f4 [xlabel="f4"];
  g [xlabel="g", color="#888888", fontcolor="#888888"];
  { rank=same; p; d1; }
  { rank=same; f3 -> f4 -> g [style=invis]; }
  p -> "transitive" [label="1"];
  p -> "left-of" [label="2"];
  d1 -> "relation" [label="1"];
  d1 -> "left-of" [label="2"];
  d1 -> "House" [label="3"];
  d1 -> "House" [label="4"];
  "left-of" -> f3 [label="1", dir=back, color="#1f77b4", fontcolor="#1f77b4", penwidth=2];
  f3 -> "House-1" [label="2"];
  f3 -> "House-2" [label="3"];
  "left-of" -> f4 [label="1", dir=back, color="#1f77b4", fontcolor="#1f77b4", penwidth=2];
  f4 -> "House-2" [label="2"];
  f4 -> "House-3" [label="3"];
  "left-of" -> g [label="1", dir=back, color="#1f77b4", fontcolor="#1f77b4", penwidth=2];
  g -> "House-1" [label="2", color="#888888", fontcolor="#888888"];
  g -> "House-3" [label="3", color="#888888", fontcolor="#888888"];
}
