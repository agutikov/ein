digraph kb {
  rankdir=TB;
  ranksep=0.55;
  node [fontname="Inter", shape=box];
  "1" -> "2" [xlabel="edge", color="#8c564b", fontcolor="#8c564b", style=solid, constraint=false];
  "2" -> "3" [xlabel="edge", color="#8c564b", fontcolor="#8c564b", style=solid, constraint=false];
  "1" -> "1" [xlabel="holds", color="#bcbd22", fontcolor="#bcbd22", style=solid, constraint=false];
  "3" -> "3" [xlabel="holds", color="#bcbd22", fontcolor="#bcbd22", style=solid, constraint=false];
  "1" -> "1" [xlabel="noted by note", color="#8c564b", fontcolor="#8c564b", style=dashed, constraint=false];
  "2" -> "1" [xlabel="noted by note", color="#8c564b", fontcolor="#8c564b", style=dashed, constraint=false];
  "layer 0" [style=invis, label="", width=0, height=0, fixedsize=true];
  { rank=same; "layer 0"; "1"; "2"; "3"; }
}
