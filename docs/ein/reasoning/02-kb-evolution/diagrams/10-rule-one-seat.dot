digraph rule_one_seat_lhs_rhs {
  rankdir=TB;
  label="one-seat"; labelloc=t;
  subgraph cluster_lhs { label="match";
    "?g_L" [label="?g", shape=diamond];
    "?c_L" [label="?c", shape=diamond];
    "?d_L" [label="?d", shape=diamond];
    "?g_L" -> "?c_L" [label="seats", color="#ff7f0e", fontcolor="#ff7f0e"];
    "?g_L" -> "?d_L" [label="seats", color="#ff7f0e", fontcolor="#ff7f0e"];
    "?c_L" -> "?d_L" [xlabel="≠", dir=none, style=dotted, color="#555555", fontcolor="#555555", constraint=false];
  }
  subgraph cluster_rhs { label="assert";
    "false_R" [label="false", shape=box];
    "h1_false_R" [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, color="#2ca02c", style=dashed];
    "h1_false_R" -> "false_R" [xlabel="1", color="#2ca02c", style=dashed];
  }
}
