digraph kb {
  rankdir=TB;
  ranksep=0.55;
  node [fontname="Inter", shape=box];
  "Norwegian" -> "Person" [xlabel="is-a", color="#7f7f7f", fontcolor="#7f7f7f", style=solid, constraint=false];
  "House-1" -> "House" [xlabel="is-a", color="#7f7f7f", fontcolor="#7f7f7f", style=solid, constraint=false];
