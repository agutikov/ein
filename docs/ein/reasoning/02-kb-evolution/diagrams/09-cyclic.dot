digraph cyclic {
  rankdir=LR;
  node [fontname="Inter", shape=box];
  ab [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true, peripheries=2];
  ba [shape=octagon, label="", width=0.3, height=0.3, fixedsize=true];
  s1 [label="symmetric\nprimary", style="rounded,bold", color="#e377c2", fontcolor="#e377c2"];
  s2 [label="symmetric\nalternative", style="rounded,bold,dashed", color="#17becf", fontcolor="#17becf"];
  ab -> "r" [xlabel="1"];
  ab -> "a" [xlabel="2"];
  ab -> "b" [xlabel="3"];
  ba -> "r" [xlabel="1"];
  ba -> "b" [xlabel="2"];
  ba -> "a" [xlabel="3"];
  ab -> s1 [color="#e377c2"];
  s1 -> ba [color="#e377c2", style=bold];
  ba -> s2 [color="#17becf"];
  s2 -> ab [color="#17becf", style="bold,dashed"];
}
