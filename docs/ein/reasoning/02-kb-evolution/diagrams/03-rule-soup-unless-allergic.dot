  }
  subgraph cluster_rhs { label="assert";
    "?g_R" [label="?g", shape=diamond];
    "Soup_R" [label="Soup", shape=box];
    "?g_R" -> "Soup_R" [label="meal", color="#ff7f0e", fontcolor="#ff7f0e", style=dashed];
  }
