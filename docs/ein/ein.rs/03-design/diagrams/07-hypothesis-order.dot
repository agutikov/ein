digraph h {
  rankdir=LR;
  node [shape=box, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  root  [shape=cylinder, label="root's fixpoint"];
  gen   [shape=diamond, label="hypgen::\ngenerate_with"];
  r1    [label="hypothesis_rules.rs\nthe matches of the rules\nthat conclude (open F),\nand the program's (open F)"];
  r2    [label="oblgen.rs\nwhat pays root's debts,\nand a commitment's"];
  r3    [label="the blind enumerator\nrelations x slots x objects"];
  scope [shape=note, label=":hypothesis-relations\n:no-hypothesis\n(__closed__ R)"];
  filt  [label="the filters, in order\nnegated_fact\nfact_already_exists\nseen_in_call"];
  sort  [label="region::prepare\nsort by order_key,\ndeduplicate: the union"];
  H     [shape=cylinder, label="H: Vec<Candidate>\nbit i of every node mask"];

  root -> gen;
  gen -> r1 [label="every rule\nthat matches"];
  gen -> r2 [label="an obligation is\nactivated at root"];
  gen -> r3 [label="neither wrote, and no\nobligation is activated"];
  scope -> r3 [style=dotted];
  r1 -> filt; r2 -> filt; r3 -> filt;
  filt -> sort [label="emitted"];
  sort -> H;
}
